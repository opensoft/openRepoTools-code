    return os.path.exists("/.dockerenv") or os.path.exists("/run/.containerenv")


def _render_workstation() -> str | None:
    """The name `record_mirror_state` files a divergence's finder under,
    `found_by_ws`, taken as `lanes-edit.sh`'s `lanes_workstation_pair` takes
    it (ecd1bce :935-944; SHOULD-3 of lane 3's review of T322):
    `LANES_WORKSTATION`, as the writer that forked the renderer has it; else,
    outside a container, this host's short name, `hostname -s`'s, the host
    name cut at its first dot; else None, filed as NULL, which `found_by_ws`'s
    CHECK allows: a container's own host name is its id, a name no reader
    can match (Amendment 11, R-A11-14), and `_render_record` says so on
    stderr. Nothing is asked of `lanes-edit.sh`, whose helper environment
    would give a child `LANES_NO_FETCH` (D12)."""
    seam = os.environ.get("LANES_WORKSTATION", "")
    if seam:
        return seam
    if _render_in_container():
        return None
    name = os.uname().nodename
    return name.split(".", 1)[0] or name or "unknown"


def _render_one_line(text: str, limit: int = 500) -> str:
    """`text` as one printable line for `mirror_state.last_error`: control
    characters become spaces, URLs keep no user part, and it is cut at
    `limit` characters."""
    flat = " ".join(_redact_url(re.sub(r"[\x00-\x1f\x7f]", " ", text)).split())
    return flat if len(flat) <= limit else flat[:limit - 3] + "..."


def render_register_seq(checkout: str, tip: str, skip=frozenset(),
                        deadline: float | None = None) -> tuple[int, str]:
    """`m` and its commit `R`: the first non-empty `Register-Seq` on `tip`'s
    first-parent line, by form C in pages (Y:2843-2847): `git log
    --first-parent -n 200 --skip <s>
    --format='%H%x00%(trailers:key=Register-Seq,valueonly)'`, never with
    `--grep`, `deadline` (a `time.monotonic()` instant) bounding the whole
    walk. A commit in `skip`, the resolved strays, does not count: its
    `Register-Seq` is passed over (Y:2848-2850; lane 3's T117 ruling 5).

    THE SHAPE OF LANE 1'S `mirror_register_seq` (T117), with the skip set
    that ruling gives it and the tip as a sha: it returns `(m, R)`, and
    raises `StoreUnusable` of kind `unread` (git failed, or the deadline
    passed) or `no-seq` (no commit that counts carries one, or the newest
    that does carries one that is not a seq). Within one commit the first
    value is taken, as the guard's form C takes it."""
    start = 0
    while True:
        left = _render_left(deadline)
        out_of_time = (f"the walk of origin {RENDER_BRANCH}'s first-parent line for a "
                       f"{REGISTER_SEQ_KEY} ran out of time after {start} commits "
                       f"(LANES_GIT_TIMEOUT)")
        if left is not None and left <= 0:
            raise StoreUnusable("unread", out_of_time)
        run = render_git(checkout, *_RENDER_WALK_PINS, "log", "--first-parent",
                         "-n", str(RENDER_PAGE), "--skip", str(start),
                         f"--format=%H%x00%(trailers:key={REGISTER_SEQ_KEY},valueonly)",
                         tip, "--", env=_render_env(), timeout=left)
        if run.timed_out:
            raise StoreUnusable("unread", out_of_time)
        if run.rc != 0:
            raise StoreUnusable("unread", f"`git log` of {tip} exited {run.rc}: "
                                f"{run.last_line()}")
        commits, commit, passed_over = 0, "", False
        for line in run.out.split("\n"):
            if "\x00" in line:
                commits += 1
                commit, _, line = line.partition("\x00")
                passed_over = commit in skip
            value = line.strip()
            if not commit or not value or passed_over:
                continue
            if not re.fullmatch(r"[0-9]+", value) or int(value) > 2 ** 63 - 1:
                raise StoreUnusable("no-seq", f"commit {commit}, the newest on origin "
                                    f"{RENDER_BRANCH}'s first-parent line to carry a "
                                    f"{REGISTER_SEQ_KEY} that counts, carries {value!r}, "
                                    f"which is not a seq")
            return int(value), commit
        if commits < RENDER_PAGE:
            raise StoreUnusable("no-seq", f"no commit on origin {RENDER_BRANCH}'s first-parent "
                                f"line carries a {REGISTER_SEQ_KEY} that counts "
                                f"({start + commits} read, {len(skip)} resolved strays "
                                f"passed over)")
        start += commits


def render_seq_of(checkout: str, commit: str) -> str:
    """FORM C ON ONE COMMIT, with the walk's pins and environment: the first
    non-empty `Register-Seq` value `git log -n 1` reads from `commit`, as
    `render_register_seq` takes one, or "" where it reads none. The build
    reads each commit it makes back with it (SHOULD-2 of lane 3's review of
    T322). Raises `RenderBuildFailed` where git fails or `LANES_GIT_TIMEOUT`
    runs out."""
    out = _render_git_ok(render_git(checkout, *_RENDER_WALK_PINS, "log", "-n", "1",
                                    f"--format=%(trailers:key={REGISTER_SEQ_KEY},valueonly)",
                                    commit, "--", env=_render_env(), timeout=git_timeout_s()),
                         f"form C's `git log` of {commit}")
    return next((line.strip() for line in out.split("\n") if line.strip()), "")


def render_strays_after(checkout: str, after: str, tip: str, skip=frozenset()) -> str | None:
    """The divergence's git half (Y:2928-2930): the oldest commit on `tip`'s
    first-parent line after `after` (`R`) that changes a render-set path and
    is no resolved stray, or None. A commit after `R` carries no
    `Register-Seq` that counts, so none of them is a render commit. Each
    commit is read against its first parent, a merge included, with no
    rename detection, so a rename shows both its paths; the render set is
    filtered in code (`register_render_path`). Raises `StoreUnusable`
    (`unread`) where git fails or `LANES_GIT_TIMEOUT` runs out. It has form
    C's pins: git re-encodes all of `--format`'s output to a checkout's own
    `i18n.logOutputEncoding`, and no `%H` would then be read (NIT-1)."""
    run = render_git(checkout, *_RENDER_WALK_PINS, "log", "--first-parent",
                     "--diff-merges=first-parent", "--no-renames", "--raw", "--no-abbrev",
                     "-z", "--format=%H", f"{after}..{tip}", "--",
                     env=_render_env(), timeout=git_timeout_s())
    if run.timed_out or run.rc != 0:
        raise StoreUnusable("unread", f"the commits after {after} on origin {RENDER_BRANCH} "
                            f"could not be listed: " + (f"timed out after {git_timeout_s()} s"
                                                        if run.timed_out else
                                                        f"exited {run.rc}: {run.last_line()}"))
    found, commit, path_next = None, "", False
    for token in run.out.split("\x00"):
        if path_next:
            path_next = False
            if commit and commit not in skip and register_render_path(token):
                found = commit          # the output runs newest first: keep the oldest
            continue
        token = token.lstrip("\n")
        if token.startswith(":"):
            path_next = True            # a raw line: its path is the next token
        elif SHA_RE.match(token):
            commit = token
    return found


def render_tree_set(checkout: str, commit: str) -> dict:
    """The render set in `commit`'s tree, `{path: (mode, type, object)}`:
    the whole tree listed, and filtered in code, since git 2.43's `ls-tree`
    refuses `:(exclude)` (Y:5775)."""
    run = render_git(checkout, "ls-tree", "-r", "-z", "--full-tree", commit,
                     env=_render_env(), timeout=git_timeout_s())
    if run.timed_out or run.rc != 0:
        raise RenderBuildFailed(f"`git ls-tree` of {commit} " + (
            f"timed out after {git_timeout_s()} s" if run.timed_out
            else f"exited {run.rc}: {run.last_line()}"))
    entries = {}
    for record in run.out.split("\x00"):
        meta, tab, path = record.partition("\t")
        fields = meta.split()
        if tab and len(fields) == 3 and register_render_path(path):
            entries[path] = tuple(fields)
    return entries


def render_blob_sha(data: bytes) -> str:
    """The blob id git gives `data`, as `hash-object --no-filters` does."""
    return hashlib.sha1(b"blob %d\x00" % len(data) + data).hexdigest()


def render_image_set(images: dict) -> dict:
    """The images as tree entries: every image is a `100644` blob (F29)."""
    return {path: ("100644", "blob", render_blob_sha(data)) for path, data in images.items()}


def render_message(message: str, k: int) -> str:
    """D15'S MESSAGE (contract section 1, "The message"): the journal entry's
    message byte for byte, with `Register-Seq: <k>` in its final trailer
    block. Composed here; `git interpret-trailers` is never run.

    - Its blank lines at the end are dropped, a line of only spaces and
      tabs counting as blank, as git reads paragraphs and as lane 1's
      refusal of a message reads them. Never `str.strip()` with no
      argument: it also takes NBSP, FF, VT, U+2028, U+001C to U+001F and
      NEL as blank, which git does not, so a message holding such a line
      would end every pass in `build-failed` at its seq (render re-review
      SHOULD-A).
    - Where the message has two paragraphs or more, and every line of the
      last is `Token: value` with a token of letters, digits and `-`, the
      trailer is that paragraph's last line.
    - Otherwise (a subject alone, which git reads as the title, or a body
      ending in prose) it is a new last paragraph after one blank line.
    - The message ends with one LF.
    So a message that ends with at most one LF is kept whole at the start of
    the commit's. A message with no text is refused (`RenderRefused`)."""
    lines = message.split("\n")
    while lines and not lines[-1].strip(" \t"):
        lines.pop()
    if not lines:
        raise RenderRefused(f"seq {k}'s message holds no text, so no trailer block can follow "
                            f"a title")
    paragraphs, current = [], []
    for line in lines:
        if line.strip(" \t"):
            current.append(line)
        elif current:
            paragraphs.append(current)
            current = []
    paragraphs.append(current)
    block = (len(paragraphs) >= 2
             and all(_RENDER_TRAILER_LINE_RE.fullmatch(line) for line in paragraphs[-1]))
    return "\n".join(lines) + ("\n" if block else "\n\n") + f"{REGISTER_SEQ_KEY}: {k}\n"


def _render_ident(author: str, epoch: int, k: int) -> dict:
    """D15's identity: the journal's author as author and committer, both
    dated by the entry's commit UTC, `@<epoch> +0000` (F29)."""
    match = _RENDER_AUTHOR_RE.fullmatch(author or "")
    if not match:
        raise RenderRefused(f"seq {k}'s author {author!r} is not `Name <email>`")
    name, email = match.group(1), match.group(2)
    date = f"@{epoch} +0000"
    return {"GIT_AUTHOR_NAME": name, "GIT_AUTHOR_EMAIL": email, "GIT_AUTHOR_DATE": date,
            "GIT_COMMITTER_NAME": name, "GIT_COMMITTER_EMAIL": email,
            "GIT_COMMITTER_DATE": date}


def _render_read_head(store) -> tuple:
    """THE PASS'S FIRST READ, one request in one snapshot, D9's `render`
    row: the schema window, `h` and the switch in one read, the resolved
    strays, and the mirror state's two columns. Returns `(h, mode, skip,
    diverged_sha, last_error)`. Raises `RenderRefused` where the answer
    cannot be read or the schema is outside this client's window."""
    answers = store._query_many([
        "SELECT version, writers_from, readers_from FROM schema_version WHERE id = 1",
        "SELECT h.seq, s.mode FROM register_head h, register_switch s "
        "WHERE h.id = 1 AND s.id = 1",
        "SELECT j.git_commit FROM journal j WHERE j.kind IN ('stray-import', 'stray-revert') "
        "AND j.git_commit IS NOT NULL ORDER BY j.seq",
        "SELECT mir.diverged_sha, mir.last_error FROM mirror_state mir WHERE mir.id = 1",
    ], snapshot=True, row="render")
    if len(answers) != 4:
        raise RenderRefused(f"psql answered {len(answers)} of the pass's 4 reads")
    version_rows, head_rows, stray_rows, mirror_rows = answers
    if len(version_rows) != 1 or len(version_rows[0]) != 3:
        raise RenderRefused("the register's schema_version row could not be read")
    refusal = register_version_refusal(*(_render_int(v, "schema_version")
                                         for v in version_rows[0]), write=True)
    if refusal:
        raise RenderRefused(refusal)
    if len(head_rows) != 1 or len(head_rows[0]) != 2 or head_rows[0][1] not in ("files",
                                                                                "primary"):
        raise RenderRefused("the register's head and switch could not be read")
    head, mode = _render_int(head_rows[0][0], "register_head.seq"), head_rows[0][1]
    skip = frozenset(row[0] for row in stray_rows if row and row[0] and SHA_RE.match(row[0]))
    diverged, last_error = (mirror_rows[0] + [None, None])[:2] if mirror_rows else (None, None)
    return head, mode, skip, diverged, last_error


def _render_read_entries(store, m: int, upto: int) -> list:
    """THE ENTRIES AFTER `m`, `m+1 .. upto`, one request in one snapshot:
    `(seq, kind, operator, author, message, utc)`, the commit UTC in whole
    seconds since the epoch. `operator` is `journal.operator` (D24; never
    judged by an entry's edits or its number)."""
    answers = store._query_many([
        f"SELECT j.seq, j.kind, j.operator, j.author, j.message, "
        f"CAST(date_part('epoch', j.utc) AS bigint) FROM journal j "
        f"WHERE j.seq > {int(m)} AND j.seq <= {int(upto)} ORDER BY j.seq",
    ], snapshot=True, row="render")
    rows = answers[0] if len(answers) == 1 else None
    if rows is None or len(rows) != upto - m or any(len(row) != 6 for row in rows):
        raise RenderRefused(f"the journal's entries from seq {m + 1} to seq {upto} were not "
                            f"all read")
    entries = []
    for want, row in enumerate(rows, m + 1):
        seq = _render_int(row[0], "journal.seq")
        if seq != want or row[2] not in ("t", "f") or row[3] is None or row[4] is None:
            raise RenderRefused(f"the journal's entry at seq {want} could not be read")
        entries.append((seq, row[1], row[2] == "t", row[3], row[4],
                        _render_int(row[5], "journal.utc")))
    return entries


def render_images_span(store, first: int, last: int) -> tuple:
    """The render set's images at each seq `first .. last`, `{k: {path:
    bytes}}`, and the journal's `(seq, kind)` rows read, from ONE T301 read
    (`register_render_read(store, last)`, D9's `render` row) and T301's
    image builder: the images at `first` by a full replay from the latest
    import, and each later seq brought forward from the one before,
    `start=(k-1, register_cache_state(...))`, whose proof is over every
    image at `k`; a miss there replays in full. Raises
    `RenderRefused`, `PsqlFailed` or `StoreUnusable`, as T301's read does."""
    import bisect
    journal, edits, files = register_render_read(store, last)
    j_seqs = [row[0] for row in journal]
    e_seqs = [row[0] for row in edits]
    f_seqs = [row[0] for row in files]
    images = {}
    for k in range(first, last + 1):
        if k - 1 in images:
            state = register_cache_state(images[k - 1])
            if state is not None:
                try:
                    images[k] = register_images(
                        journal[bisect.bisect_left(j_seqs, k):bisect.bisect_right(j_seqs, k)],
                        edits[bisect.bisect_left(e_seqs, k):bisect.bisect_right(e_seqs, k)],
                        files[:bisect.bisect_right(f_seqs, k)], start=(k - 1, state))
                    continue
                except RenderRefused:
                    pass        # a miss: the full replay below
        images[k] = register_images(journal[:bisect.bisect_right(j_seqs, k)],
                                    edits[:bisect.bisect_right(e_seqs, k)],
                                    files[:bisect.bisect_right(f_seqs, k)])
    return images, [(seq, kind) for seq, kind in journal]


def _render_record(store, diverged: str | None, error: str | None) -> None:
    """`record_mirror_state` (D16), one request with D9's `render` row:
    `diverged` is a stray's sha or None, `error` the pass's why or None,
    which clears `last_error`. A record that fails is said, and the pass
    ends as it would have. A divergence filed with no finder, in a container
    with no `LANES_WORKSTATION`, is said (SHOULD-3 of lane 3's review of
    T322)."""
    text = None if error is None else _render_one_line(error)
    finder = _render_workstation()
    if diverged is not None and finder is None:
        note("render: this is a container and LANES_WORKSTATION is not set, so the divergence "
             "is filed with no finder (found_by_ws NULL), never under the container's own id "
             "(Amendment 11, R-A11-14). The launcher exports LANES_WORKSTATION")
    try:
        store.request([f'SELECT "{store.schema}".record_mirror_state('
                       f'{_pg_quote(finder)}, {_pg_quote(diverged)}, '
                       f'{_pg_quote(text)})'], "render")
    except (StoreUnusable, ValueError) as exc:
        note(f"render: the mirror state could not be recorded ({exc}); status will not show "
             f"this pass's end")


def _render_git_ok(run: GitRun, what: str) -> str:
    if run.timed_out or run.rc != 0:
        raise RenderBuildFailed(f"{what} " + (f"timed out after {git_timeout_s()} s"
                                              if run.timed_out else
                                              f"exited {run.rc}: {run.last_line()}"))
    return run.out


def _render_clear(path: str) -> None:
    """Remove what `path` names, a file, a symbolic link (never followed) or
    a whole directory; nothing where it is absent. Raises `OSError`."""
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        return
    if stat.S_ISDIR(info.st_mode):
        shutil.rmtree(path)
    else:
        os.unlink(path)


def render_build(checkout: str, git_dir: str, parent: str, parent_set: dict, seqs: list,
                 images: dict, entries: dict) -> str:
    """BUILD `seqs` on `parent` (Y:2855-2862; contract section 1), and return
    the last commit. Under the lock, `lanes-render.index`, its `.lock` and
    the build's directory `lanes-render.tmp` are cleared first: a renderer
    killed inside `read-tree` or `update-index` leaves that `.lock`, and one
    killed inside the build leaves that directory. Then, for each `k`:

    - `read-tree <parent>` into the private index (`GIT_INDEX_FILE`);
    - the blobs that differ from the parent's render set written with
      `hash-object -w --no-filters`, and staged with `update-index
      --cacheinfo`, each as `100644`; the render-set paths the images lack
      removed with `--force-remove`: the render set is then exactly the
      images at `k`, whatever the parent held;
    - `write-tree`, then `commit-tree --no-gpg-sign -p <parent>`, with D15's
      message, author, committer and dates;
    - FORM C ON THE NEW COMMIT (`render_seq_of`), which must read `k`
      (SHOULD-2 of lane 3's review of T322): a journal message whose
      trailers git reads otherwise, one with a scissors line or with a
      `Register-Seq` already in its final trailer block, would leave a commit
      at which the next pass finds a false divergence.

    The blobs and the message pass through 0600 files in the 0700 directory
    `<git-dir>/lanes-render.tmp`, byte for byte, since `render_git` gives git
    no stdin; the directory is removed when the build ends (NIT-4 of lane
    3's review of T322). Each blob id git writes is checked against
    `render_blob_sha`'s. A failure, a file there that cannot be made or
    written included, raises `RenderBuildFailed`, and nothing is pushed;
    what it leaves is unreferenced objects."""
    index = os.path.join(git_dir, RENDER_INDEX_NAME)
    work = os.path.join(git_dir, RENDER_WORK_NAME)
    try:
        for stale in (index, index + ".lock", work):
            _render_clear(stale)
    except OSError as exc:
        raise RenderBuildFailed(f"the build's files left in {git_dir} could not be cleared: "
                                f"{exc.strerror or exc}") from exc
    top = _render_git_ok(render_git(checkout, "rev-parse", "--show-toplevel",
                                    env=_render_env(), timeout=git_timeout_s()),
                         "`git rev-parse --show-toplevel`").strip()
    if not top:
        raise RenderBuildFailed(f"{checkout} has no working tree to stage paths from")
    staging = _render_env(GIT_INDEX_FILE=index)
    try:
        os.mkdir(work, 0o700)
    except OSError as exc:
        raise RenderBuildFailed(f"the build's directory {work} could not be made: "
                                f"{exc.strerror or exc}") from exc
    try:
        tip, current = parent, parent_set
        for k in seqs:
            want = render_image_set(images[k])
            changed = sorted(path for path in want if current.get(path) != want[path])
            removed = sorted(path for path in current if path not in want)
            _render_git_ok(render_git(top, *_RENDER_BUILD_PINS, "read-tree", tip, env=staging,
                                      timeout=git_timeout_s()), f"seq {k}'s `git read-tree`")
            fresh = sorted({want[path][2] for path in changed})
            if fresh:
                files = []
                for number, sha in enumerate(fresh):
                    data = next(images[k][p] for p in changed if want[p][2] == sha)
                    blob = os.path.join(work, f"blob-{number}")
                    fd = os.open(blob, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
                    with os.fdopen(fd, "wb") as handle:
                        handle.write(data)
                    files.append(blob)
                written = _render_git_ok(render_git(
                    top, *_RENDER_BUILD_PINS, "hash-object", "-w", "--no-filters", "--", *files,
                    env=staging, timeout=git_timeout_s()),
                    f"seq {k}'s `git hash-object -w`").split()
                if written != fresh:
                    raise RenderBuildFailed(f"seq {k}'s blobs were written as {written}, not "
                                            f"{fresh}")
            if changed or removed:
                args = ["update-index", "--add", "--replace"]
                for path in changed:
                    args += ["--cacheinfo", f"100644,{want[path][2]},{path}"]
                if removed:
                    args += ["--force-remove", "--", *removed]
                _render_git_ok(render_git(top, *_RENDER_BUILD_PINS, *args, env=staging,
                                          timeout=git_timeout_s()),
                               f"seq {k}'s `git update-index`")
            tree = _render_git_ok(render_git(top, *_RENDER_BUILD_PINS, "write-tree",
                                             env=staging, timeout=git_timeout_s()),
                                  f"seq {k}'s `git write-tree`").strip()
            _seq, _kind, _operator, author, message, epoch = entries[k]
            text = os.path.join(work, f"message-{k}")
            fd = os.open(text, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "wb") as handle:
                handle.write(render_message(message, k).encode("utf-8"))
            commit = _render_git_ok(render_git(
                top, *_RENDER_BUILD_PINS, "commit-tree", "--no-gpg-sign", "-p", tip, "-F", text,
                tree, env=_render_env(GIT_INDEX_FILE=index, **_render_ident(author, epoch, k)),
                timeout=git_timeout_s()), f"seq {k}'s `git commit-tree`").strip()
            if not SHA_RE.match(tree) or not SHA_RE.match(commit):
                raise RenderBuildFailed(f"seq {k}'s tree or commit id could not be read")
            read = render_seq_of(top, commit)
            if read != str(k):
                raise RenderBuildFailed(
                    f"seq {k}'s commit {commit} reads "
                    + (f"{REGISTER_SEQ_KEY} {read}" if read else f"no {REGISTER_SEQ_KEY}")
                    + f" by form C, not {k}: git reads its journal message's trailers "
                    f"otherwise (such as after a scissors line, or with a {REGISTER_SEQ_KEY} "
                    f"already in its final trailer block), and the next pass would find a "
                    f"divergence at it")
            tip, current = commit, want
        return tip
    except OSError as exc:
        raise RenderBuildFailed(f"a file in the build's directory {work} could not be "
                                f"written: {exc.strerror or exc}") from exc
    finally:
        shutil.rmtree(work, ignore_errors=True)


def render_pass(checkout: str, cfg: dict, *, store=None) -> RenderPass:
    """S2'S PASS in `checkout`, under its render lock (T322; S2's "A pass";
    D15; D16; FR-044; contracts/render-commit.md): fetch, read the head,
    find `m`, check for a divergence, take `t`, build `m+1 .. t` and push
    through `render_push`, six attempts in all. `store` is the register,
    `render_store(cfg)` where it is not given. Returns a `RenderPass`; a
    refused configuration, from `render_store` or `render_push`, raises
    `Refusal` (2) after it is recorded where it can be. Section comment
    above has the steps."""
    store = render_store(cfg) if store is None else store

    def stop(outcome: str, detail: str, *, diverged: str | None = None,
             record: bool = True, **fields) -> RenderPass:
        if record:
            _render_record(store, diverged, detail)
        note(f"render: {outcome}: {detail}")
        return RenderPass(outcome, detail, **fields)

    # 1. THE FETCH.
    fetched = render_git(checkout, "-c", "gc.auto=0", "-c", "maintenance.auto=false", "fetch",
                         "--no-tags", "--no-write-fetch-head", "--no-recurse-submodules", "-q",
                         "origin", f"+refs/heads/{RENDER_BRANCH}:refs/remotes/origin/"
                         f"{RENDER_BRANCH}", env=_render_env(), timeout=git_timeout_s())
    if fetched.rc != 0:
        return stop("fetch-failed", f"the fetch of origin {RENDER_BRANCH} " + (
            f"timed out after {git_timeout_s()} s" if fetched.timed_out
            else f"exited {fetched.rc}: {fetched.last_line()}") + "; nothing was pushed")
    resolved = render_git(checkout, "rev-parse", "--verify", "-q",
                          f"refs/remotes/origin/{RENDER_BRANCH}^{{commit}}", env=_render_env())
    tip = resolved.out.strip()
    if resolved.rc != 0 or not SHA_RE.match(tip):
        return stop("fetch-failed", f"origin has no {RENDER_BRANCH} after the fetch; nothing "
                    f"was pushed")

    # 2. THE HEAD, THE SWITCH AND THE RESOLVED STRAYS, in one read.
    try:
        head, mode, skip, _diverged, last_error = _render_read_head(store)
    except RenderRefused as exc:
        return stop("read-failed", f"the register's head could not be read: {exc}")
    except StoreUnusable as exc:
        return stop("read-failed", f"the register could not be read: {exc.detail}",
                    record=False)

    # 3. FIND `m`.
    try:
        m, carrier = render_register_seq(checkout, tip, skip, _render_deadline())
    except StoreUnusable as exc:
        return stop("walk-failed", f"{exc.detail}; nothing was pushed")

    def above_head(found: int, at: str):
        """R2's N6 at `found`, `at` its commit: a `Register-Seq` above the
        journal's head while the switch is at `primary`."""
        if found > head:
            return stop("diverged", f"diverged at {at}: it carries {REGISTER_SEQ_KEY} {found}, "
                        f"above the journal's head {head} while the switch is at primary "
                        f"(R2's N6); nothing was pushed", diverged=at, found=found)
        return None

    def diverged_from(found: int, at: str, origin_tip: str):
        """The git half of the check at `found`, `at` its commit: R2's N6
        and the strays after it. Reached at `primary` alone."""
        ended = above_head(found, at)
        if ended:
            return ended
        try:
            stray = render_strays_after(checkout, at, origin_tip, skip)
        except StoreUnusable as exc:
            return stop("walk-failed", f"{exc.detail}; nothing was pushed", found=found)
        if stray:
            return stop("diverged", f"diverged at {stray}: it changes the render set after "
                        f"{at}, which carries {REGISTER_SEQ_KEY} {found}, and is no render "
                        f"commit; nothing was pushed", diverged=stray, found=found)
        return None

    def clean(outcome: str, detail: str, **fields) -> RenderPass:
        """An end that is no failure clears a `last_error` an earlier pass left."""
        if last_error is not None:
            _render_record(store, None, None)
        say(f"{PROG} render: {detail}")
        return RenderPass(outcome, detail, **fields)

    # AT `files` THE PASS RENDERS NOTHING AND RECORDS NO DIVERGENCE, since
    # nothing at `files` can clear one (lane 3's ruling on T322's open point
    # 2). That covers (ii')'s marker-first window, `t <= h < m` (Y:2850).
    if mode != "primary":
        return clean("at-files", f"the switch is at {mode}, where nothing is rendered and no "
                     f"divergence is recorded: origin carries {REGISTER_SEQ_KEY} {m}, and the "
                     f"journal's head is {head}", found=m, reached=m)

    # 4. THE DIVERGENCE CHECK'S GIT HALF. After it, `m <= h`.
    ended = diverged_from(m, carrier, tip)
    if ended:
        return ended

    # 5. THE TARGET, from the entries after `m`.
    upto = min(head, m + RENDER_BATCH)
    try:
        entries = _render_read_entries(store, m, upto) if upto > m else []
    except RenderRefused as exc:
        return stop("read-failed", f"{exc}; nothing was pushed")
    except StoreUnusable as exc:
        return stop("read-failed", f"the register could not be read: {exc.detail}",
                    record=False)
    operators = [seq for seq, _kind, operator, *_rest in entries if operator]
    target = min(upto, operators[0] - 1) if operators else upto

    # 4. THE DIVERGENCE CHECK'S IMAGE HALF: the render set at `R` must be the
    # images at `m`. Then the images up to `t`, from the same read.
    try:
        images, read_kinds = render_images_span(store, m, max(m, target))
    except RenderRefused as exc:
        return stop("read-failed", f"the journal could not be rendered: {exc}; nothing was "
                    f"pushed", found=m)
    except StoreUnusable as exc:
        return stop("read-failed", f"the register could not be read: {exc.detail}",
                    record=False, found=m)
    if [row for row in read_kinds if m < row[0] <= target] != [
            (seq, kind) for seq, kind, *_rest in entries if seq <= target]:
        return stop("read-failed", f"the journal's entries {m + 1} to {target} changed between "
                    f"the pass's reads; nothing was pushed", found=m)
    try:
        at_carrier = render_tree_set(checkout, carrier)
    except RenderBuildFailed as exc:
        return stop("walk-failed", f"{exc}; nothing was pushed", found=m)
    if at_carrier != render_image_set(images[m]):
        return stop("diverged", f"diverged at {carrier}: its render set is not the images at "
                    f"seq {m}, the {REGISTER_SEQ_KEY} it carries; nothing was pushed",
                    diverged=carrier, found=m)

    if target <= m:
        if m >= head:
            return clean("nothing-missing", f"origin carries {REGISTER_SEQ_KEY} {m}, the "
                         f"journal's head; nothing to render", found=m, reached=m, target=m)
        return clean("operator-next", f"seq {m + 1} is an operator entry, which its own command "
                     f"pushes (F2); nothing rendered past {REGISTER_SEQ_KEY} {m}", found=m,
                     reached=m, target=target)

    # 6. BUILD AND PUSH, six attempts in all.
    try:
        git_dir = render_git_dir(checkout)
    except Refusal as exc:
        return stop("build-failed", f"{exc}; nothing was pushed", found=m, target=target)
    by_seq = {entry[0]: entry for entry in entries}
    base, base_m, base_set = tip, m, None
    attempts = 0
    while True:
        attempts += 1
        try:
            if base_set is None:
                base_set = render_tree_set(checkout, base)
            built = render_build(checkout, git_dir, base, base_set,
                                 list(range(base_m + 1, target + 1)), images, by_seq)
        except RenderBuildFailed as exc:
            return stop("build-failed", f"{exc}; nothing was pushed", found=m, target=target)
        except RenderRefused as exc:
            return stop("read-failed", f"{exc}; nothing was pushed", found=m, target=target)
        try:
            pushed = render_push(checkout, built, cfg.get("render_key") or "")
        except Refusal as exc:
            _render_record(store, None, f"REFUSED: {exc}")
            raise
        if pushed.outcome == "pushed":
            return clean("rendered", f"rendered seqs {base_m + 1} to {target} onto origin "
                         f"{RENDER_BRANCH} at {built} ({attempts} push attempt"
                         f"{'s' if attempts > 1 else ''})", found=m, reached=target,
                         target=target, tip=built)
        if pushed.outcome != "rejected":
            return stop("push-failed", f"{pushed.detail}; seqs {base_m + 1} to {target} are not "
                        f"on origin", found=m, target=target, tip=built)
        # A LOST RACE: the read-back's fetch was the refetch. Origin carrying
        # `t` or more counts as pushed; otherwise rebuild on its new tip.
        base = pushed.origin_tip
        try:
            now_m, now_carrier = render_register_seq(checkout, base, skip, _render_deadline())
        except StoreUnusable as exc:
            return stop("walk-failed", f"after a rejected push: {exc.detail}", found=m,
                        target=target)
        # N6 FIRST (NIT-6 of lane 3's review of T322): a forged trailer that
        # lands during the race is a divergence, never counted as pushed.
        ended = above_head(now_m, now_carrier)
        if ended:
            return ended
        if now_m >= target:
            return clean("rendered", f"origin {RENDER_BRANCH} at {base} already carries "
                         f"{REGISTER_SEQ_KEY} {now_m}, at or past seq {target}, after "
                         f"{attempts} push attempt{'s' if attempts > 1 else ''}: counted as "
                         f"pushed", found=m, reached=now_m, target=target, tip=base)
        if attempts >= RENDER_PUSH_ATTEMPTS:
            return stop("six-rejections", f"{RENDER_PUSH_ATTEMPTS} push attempts were rejected, "
                        f"the last {pushed.detail}; origin carries {REGISTER_SEQ_KEY} {now_m}, "
                        f"below seq {target}, and the next render resumes", found=m,
                        reached=now_m, target=target)
        if now_m < m:
            return stop("walk-failed", f"after a rejected push, origin's last "
                        f"{REGISTER_SEQ_KEY} went back from {m} to {now_m} at {now_carrier}; "
                        f"nothing more was pushed", found=m, target=target)
        ended = diverged_from(now_m, now_carrier, base)
        if ended:
            return ended
        if now_m != base_m or now_carrier != carrier:
            try:
                if render_tree_set(checkout, now_carrier) != render_image_set(images[now_m]):
                    return stop("diverged", f"diverged at {now_carrier}: its render set is not "
                                f"the images at seq {now_m}; nothing more was pushed",
                                diverged=now_carrier, found=m)
            except RenderBuildFailed as exc:
                return stop("walk-failed", f"{exc}; nothing more was pushed", found=m)
        base_m, carrier, base_set = now_m, now_carrier, None


# F15, THE PROGRESS BOUND (feature 007's T323; FR-046; PC-3, as research.md
# takes it): a renderer makes another pass only after a pass that moved
# origin's last `Register-Seq` past where that pass found it, or once for
# each rerun mark it finds after it releases. Every other end of a pass is a
# stop condition, and ends it with nothing on any HEAD: nothing missing; an
# operator seq next; the switch at `files`; `diverged at`; a fetch,
# authentication or six-rejection failure (with a walk or build that
# failed); a failed journal read. After RENDER_PASS_CAP passes it hands over:
# it releases the lock and re-forks itself once, detached, if its last pass
# made progress OR it finds a rerun mark after the release (MUST-1 of lane
# 3's review of T323: T321's handshake promises every write a pass after
# it), so the last write of a burst is rendered though no write follows, and
# no process lives unbounded under a steady stream.

#: PC-3: the passes one renderer process makes before it hands over.
RENDER_PASS_CAP = 16


def _render_self_argv(checkout: str) -> list:
    """The re-fork's command: this file, by the interpreter running it, as
    `render --checkout <c>`."""
    return [sys.executable, os.path.realpath(__file__), "render", "--checkout", checkout]


def render_refork(checkout: str) -> bool:
    """THE HANDOVER'S RE-FORK, detached as the writer's fork is (contract
    section 3.7): a session of its own, stdin, stdout and stderr on
    /dev/null, no descriptor but those, and `_render_child_env()`'s
    environment, so no `GIT_*` but `GIT_TERMINAL_PROMPT` and no
    `LANES_NO_FETCH` reaches it: it is no git call, and `render_git_env`'s
    pins are for git calls. It is never waited for. Returns whether it
    started; one that cannot be started is said, and the next fork renders
    what it would have."""
    try:
        subprocess.Popen(_render_self_argv(checkout), stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         env=_render_child_env(), close_fds=True, start_new_session=True)
    except OSError as exc:
        note(f"render: the handover's re-fork could not be started ({exc}); the next render "
             f"renders what is left")
        return False
    return True


def _render_holding(lock: RenderLock, checkout: str, cfg: dict) -> int:
    """The holder's side of the handshake, bounded by F15 (T323). Each turn
    clears the rerun mark, the pass's first act (S2), and runs a pass.

    - A PASS THAT MADE PROGRESS is followed by another, the lock still held.
    - ANY OTHER END is a stop: the holder releases, looks for a mark once
      more, and takes the lock back for it, one more pass for each mark it
      finds after a release. A mark left after the clear, by a fork that
      found the lock held, is rendered by this process, and never left with
      nobody due to read it.
    - AFTER RENDER_PASS_CAP PASSES it releases and ends, re-forking itself
      once, detached, if its last pass made progress OR, after the release,
      it finds a rerun mark (MUST-1 of lane 3's review of T323): the mark's
      write is promised a pass after it (T321), and the re-fork, or a fork
      that takes the lock before it, clears the mark and renders it.
    Returns the last pass's exit."""
    rc = 0
    passes = 0
    while True:
        try:
            lock.clear_rerun()
        except OSError as exc:
            note(f"render: the rerun mark {lock.rerun} cannot be removed "
                 f"({exc.strerror or exc}); nothing rendered")
            return 1
        result = render_pass(checkout, cfg)
        rc = result.rc
        passes += 1
        if passes >= RENDER_PASS_CAP:
            lock.release()
            # THE HANDSHAKE'S SECOND HALF holds at the cap too: the mark is
            # looked for after the release, never before it.
            marked = lock.has_rerun()
            if result.progressed or marked:
                started = render_refork(checkout)
                why = "its last pass made progress" if result.progressed else "a rerun mark"
                note(f"render: {passes} passes, the cap: the lock is released and the renderer "
                     f"{'re-forked' if started else 'not re-forked'} to go on, for {why}")
            else:
                note(f"render: {passes} passes, the cap, the last with no progress and no rerun "
                     f"mark: the lock is released, and nothing is re-forked")
            return rc
        if result.progressed:
            continue
        lock.release()
        # THE HANDSHAKE'S SECOND HALF: after the release, never before it.
        try:
            again = lock.has_rerun() and lock.acquire()
        except OSError as exc:
            note(f"render: the render lock {lock.path} cannot be taken back for a rerun mark "
                 f"({exc.strerror or exc}); the next render renders it")
            return rc or 1
        if not again:
            return rc


def cmd_render_checkout(args: list) -> int:
    """`lanes-index render --checkout <c>` (contract section 3.7; T321): the
    renderer that a primary write forks, detached, in the writing lane's
    checkout `<c>`. One render at a time per checkout, and no fork waits.

    Exits, the holder's being its last pass's (`RenderPass.rc`; T322, T323):
    - 0: rendered, nothing missing, an operator entry next, or the switch at
      `files`; or another render holds the lock and renders again for this
      one;
    - 1: a stop that is recorded with the mirror state (`diverged at`, a
      failed fetch, walk, build or push, six rejected pushes), a render lock
      or rerun mark that cannot be used, or a `StoreUnusable` no pass caught;
    - 2: a refused configuration (Q6(c)'s refusal of `mode=primary`
      included, at load, before any answer: C13; a push `render_push`
      refuses), or a `<c>` that is no git checkout;
    - 64: usage;
    - 69: the register could not be read, or its rows do not replay
      (Y:3527: the render ends, and the lag stays)."""
    want = f"render --checkout <c> - see {PROG} --help"
    checkout = None
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-h", "--help"):
            say(USAGE)
            return 0
        if arg == "--checkout" or arg.startswith("--checkout="):
            value = arg.split("=", 1)[1] if "=" in arg else (args[i + 1] if i + 1 < len(args)
                                                            else "")
            if not value:
                note(f"--checkout needs the lane's checkout: {want}")
                return 64
            if checkout is not None:
                note(f"--checkout is given twice: {want}")
                return 64
            checkout = value
            i += 1 if "=" in arg else 2
            continue
        note(f"unknown argument '{arg}' for render --checkout: {want}")
        return 64
    if checkout is None:
        note(f"render needs --checkout <c>: {want}")
        return 64
    # D12 AND Y:5776: `LANES_NO_FETCH` is never consulted, and no inherited
    # `GIT_*` reaches `load_config`, `source_of` or any child (SHOULD-2 of lane
    # 3's review of T321): both are gone before anything here reads a
    # repository or starts a child.
    for name in [key for key in os.environ if key.startswith("GIT_") or key == "LANES_NO_FETCH"]:
        os.environ.pop(name, None)
    cfg = load_config()
    checkout = os.path.abspath(checkout)
    lock = RenderLock(render_git_dir(checkout))
    try:
        held = lock.acquire()
        if not held:
            # THE HANDSHAKE'S FIRST HALF: the mark, then ONE more try. If that
            # fails too, somebody holds the lock now, after the mark was
            # written, and the holder looks for marks after it lets go.
            lock.mark_rerun()
            held = lock.acquire()
    except OSError as exc:
        lock.release()
        note(f"render --checkout {checkout}: the render lock {lock.path} cannot be taken: "
             f"{exc.strerror or exc}")
        return 1
    if not held:
        say(f"{PROG} render: another render holds {lock.path}; it renders again before it "
            f"is done")
        return 0
    try:
        return _render_holding(lock, checkout, cfg)
    finally:
        lock.release()


def _render_checkout_main(args: list) -> int:
    try:
        return cmd_render_checkout(args)
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return 2
    except StoreUnusable as exc:
        note(f"{exc.kind}: {exc.detail}")
        return 1


# ========================== S2's two ways out of a divergence (group C, T324)
#
# `render --revert <sha>` AND `import --single <sha>` (feature 007's T324: S2's
# "The two ways out of a divergence", Y:2979-3004; D16; FR-047; §1.3's kinds
# table, Y:1543-1544). Each runs on a person's word, from the operator lane's
# checkout with `LANES_LANE=` that lane (AT-6's fixture), only while the switch
# is `primary`, as ONE journal entry made through `register commit`'s own
# attempt directory, so it keeps a writer's commit bounds and its exits (D9's
# rows, Y:3582-3583):
#
# 1. THE OPERATOR'S INPUTS, as lane 1's loader (T115) reads them: the
#    configuration, the lane, the workstation, the checkout (never W) and the
#    author, each a refusal (2) where it cannot be had, all in the environment
#    this process inherited. Only then, as `render --checkout` does (D12), no
#    inherited `GIT_*` and no `LANES_NO_FETCH` reaches anything after that,
#    and every git call this process starts carries F29's pins
#    (`render_git_env`).
# 2. THE GIT HALF, as T322's pass recognises a divergence: `render_readback`'s
#    fetch of origin `main`, on which `<sha>` must be; the pass's first read
#    (`_render_read_head`: the head `h`, the switch, the resolved strays and
#    the recorded `diverged_sha`); and `m` and its commit `R` by form C past
#    the resolved strays. `<sha>` must be the recorded divergence, or `R`
#    where `m` is above `h` (R2's N6), or the oldest stray after `R`
#    (`render_strays_after`): a way out never resolves a commit the renderer
#    would not stop at, since a resolved commit's `Register-Seq` no longer
#    counts. A `<sha>` already resolved is refused, but for a rerun that finds
#    its own entry. Each attempt makes this check again inside its turn, after
#    its snapshot and before its commit call, so of two ways out on one `<sha>`
#    run at once only one can journal: the other's check finds the first's
#    entry, or its commit call loses its turn to it (40001 or LR001, Y:1558)
#    and its next attempt's check finds it (lane 3's call on its review's
#    open point 2).
# 3. ATTEMPTS, under D7's deadline (`rollback_deadline_s`), each one writer's
#    attempt: `register snapshot --write-id ... --tree <attempt>/tree
#    --checkout <c>` run in this process, its stdout the attempt's `snapshot`;
#    the attempt's files; `read_attempt_dir`; the entry by
#    `register_commit_entry` with the stray's kind and `<sha>` as its
#    `git_commit`; and one commit call. A lost turn, or a call in doubt, takes a
#    fresh snapshot under the same write id, which finds the entry where it
#    committed. Once any commit call was in doubt, an end but 0 waits for F3's
#    lookup (`register_lookup`), as a writer's does (D8): found is 0, absent
#    the code the last attempt earned, and no answer 3, naming the write id
#    and the rerun, `LANES_WRITE_ID=<id> LANES_WRITE_GENERATION=<g>`.
# 4. THE RENDER THAT FOLLOWS, in this process, in the operator lane's
#    checkout, through `render --checkout`'s lock, pass and push (T321 to
#    T323), with the renderer's rows. The way out exits 0 once its entry
#    stands; the render's own end is the renderer's, recorded for `status`.
#
# The entry is `stray-revert` (no edits; its `journal_files` name the stray's
# render-set paths at SQL's head, Y:1544) or `stray-import` (the stray's line
# edits on the render set, Y:1543). Either clears `diverged at` inside
# `commit_write` and names `<sha>` in `git_commit`, which makes it a resolved
# stray for every later pass (Y:2894-2896).

#: Each way out's command line, the flag that names the stray, and its verb
#: in the journal, by the entry's kind.
STRAY_FORMS = {"stray-revert": ("render --revert", "--revert", "render-revert"),
               "stray-import": ("import --single", "--single", "import-single")}

_STRAY_USAGE = f"""\
{PROG} render --revert <sha>   journal the revert of a stray commit, then render
{PROG} import --single <sha>   load a stray commit's line edits as one write, then render

S2's two ways out of a divergence (D16), each on a person's word. <sha> is the
stray commit's full sha: the one `{PROG} status` prints as `diverged at <sha>`,
or the one the renderer would stop at now. Each journals ONE entry through
register commit's commit call, while the switch reads primary, which records
the stray as resolved and clears `diverged at`; then it renders in the
operator lane's checkout. The revert's entry has no edits, so its render puts
SQL's state back over the stray. The single-write import loads the stray's
line edits on the render set, and refuses where they no longer apply to SQL's
images; the revert is then the way out, and the runbook prefers it (PC-4).

Run it as the operator lane, with LANES_LANE=<lane>, in that lane's checkout:
LANES_REPO, else the one `lanes-edit.sh lane-checkout <lane>` names, never W.
An end in doubt prints its rerun, LANES_WRITE_ID=<id>
LANES_WRITE_GENERATION=<generation> before the same command, which writes the
entry once or finds it (D8).

Exit: 0 the entry stands, committed or found by a rerun · 2 refused, nothing
written · 3 in doubt: run the printed rerun · 64 usage · 69 the register
cannot be read, or refused · 75 register busy at D7's deadline, nothing
written."""


class _StrayUsage(Exception):
    """A way out's command line that is not its one form: 64, before anything
    is read."""


class _StrayEnd(Exception):
    """An end of a way out but 0 that is not a refusal of its own: its code and
    its line."""

    def __init__(self, code: int, message: str):
        super().__init__(message)
        self.code = code


def _stray_args(args: list[str], flag: str) -> str | None:
    """`render --revert <sha>` or `import --single <sha>`'s argv after the
    subcommand: `flag` once, as `flag <sha>` or `flag=<sha>`, with the stray's
    full sha, 40 hex digits, read in lower case, and nothing else. None for
    `-h` or `--help` anywhere; `_StrayUsage` for anything else."""
    if any(arg in ("-h", "--help") for arg in args):
        return None
    sha = None
    i = 0
    while i < len(args):
        arg = args[i]
        name, eq, value = arg.partition("=")
        if name != flag:
            raise _StrayUsage(f"unknown argument '{arg}'")
        if not eq:
            value = args[i + 1] if i + 1 < len(args) else ""
            i += 1
        i += 1
        if sha is not None:
            raise _StrayUsage(f"{flag} is given twice")
        if not re.fullmatch(r"[0-9A-Fa-f]{40}", value):
            raise _StrayUsage(f"{flag} takes the stray commit's full sha, 40 hex digits")
        sha = value.lower()
    if sha is None:
        raise _StrayUsage(f"{flag} <sha> is needed")
    return sha


def cmd_render_revert(args: list[str]) -> int:
    """`lanes-index render --revert <sha>`: S2's renderer's revert (above)."""
    return _stray_command(args, "stray-revert")


def cmd_import_single(args: list[str]) -> int:
    """`lanes-index import --single <sha>`: S2's single-write import (above),
    lane 3's U7."""
    return _stray_command(args, "stray-import")


def _stray_command(args: list[str], kind: str) -> int:
    """A way out's exits, by the contract's constants (exit-codes.md §3.5 and
    §5: 3 for its commit call in doubt; 69 for its other calls, or 3 where an
    earlier commit call of the same entry was in doubt; and `register
    commit`'s 0, 2, 69 and 75)."""
    form, flag, _verb = STRAY_FORMS[kind]
    try:
        sha = _stray_args(args, flag)
    except _StrayUsage as exc:
        note(f"{form}: {exc} - see {PROG} {form} --help")
        return EXIT_USAGE
    if sha is None:
        say(_STRAY_USAGE)
        return EXIT_OK
    try:
        return _stray_way_out(kind, sha)
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return EXIT_REFUSED
    except _StrayEnd as exc:
        note(str(exc))
        return exc.code
    except StoreUnusable as exc:
        note(f"{form}: the register could not be read ({exc.kind}: {exc.detail}); nothing was "
             f"written")
        return EXIT_UNAVAILABLE


def _stray_rerun(form: str) -> tuple | None:
    """D8'S RERUN: `LANES_WRITE_ID` and `LANES_WRITE_GENERATION`, as an end in
    doubt prints them, `(write id, generation)` in lower case; None where
    `LANES_WRITE_ID` is unset, empty or `new`. Anything else is refused (2):
    the snapshot would read it as another write's id."""
    write_id = os.environ.get("LANES_WRITE_ID", "")
    if write_id in ("", "new"):
        return None
    generation = os.environ.get("LANES_WRITE_GENERATION", "")
    if not (_SNAPSHOT_UUID_RE.fullmatch(write_id.lower())
            and _SNAPSHOT_UUID_RE.fullmatch(generation.lower())):
        raise Refusal(f"{form}: LANES_WRITE_ID and LANES_WRITE_GENERATION are a rerun's "
                      f"identity, two UUIDs, as an end in doubt prints them (D8); nothing was "
                      f"written")
    return write_id.lower(), generation.lower()


def _stray_recognised(form: str, root: str, store, sha: str, rerun: bool,
                      tip: str | None = None) -> tuple:
    """STEP 2, THE GIT HALF (section comment above): `(resolved, tip)`.
    `resolved` is whether `sha` is resolved already, which only a rerun may
    meet, since its own entry may have resolved it; otherwise `sha` is the
    divergence the renderer recorded or finds now, or a `Refusal` (2) says why
    it is not. The switch not at `primary`, and a register that cannot be
    read, are `_StrayEnd` (69), as a writer's snapshot ends on them. `tip` is
    origin's tip, which `render_readback`'s fetch finds and proves `sha` on.
    An attempt's check inside its turn passes the tip the first check
    fetched, and makes no fetch: its commit call must end before the
    snapshot's `not_after`, the database clock plus the commit row's timer and
    2 s (F3), and a fetch is bounded only by `LANES_GIT_TIMEOUT`."""
    nothing = "nothing was written"
    if tip is None:
        answered, carried, tip, why = render_readback(root, sha)
        if not answered:
            if tip:
                raise Refusal(f"{form}: {sha} is not a commit {root} holds after its fetch of "
                              f"origin {RENDER_BRANCH} ({why}); {nothing}")
            raise Refusal(f"{form}: {why}, so {sha} cannot be checked against origin; a read "
                          f"that cannot answer refuses; {nothing}")
        if not carried:
            raise Refusal(f"{form}: {sha} is not on origin {RENDER_BRANCH}, whose tip is {tip}: "
                          f"a stray is a commit origin carries (S2); {nothing}")
    try:
        head, mode, skip, diverged, _last_error = _render_read_head(store)
    except RenderRefused as exc:
        raise _StrayEnd(EXIT_UNAVAILABLE, f"{form}: the register's head could not be read: "
                        f"{exc}; {nothing}")
    if mode != "primary":
        raise _StrayEnd(EXIT_UNAVAILABLE, f"{form}: the switch reads {mode}: a way out of a "
                        f"divergence runs only while it reads primary (S2; §1.3's kinds table), "
                        f"and at files no divergence is recorded or rendered; {nothing}")
    if sha in skip:
        if rerun:
            return True, tip
        raise Refusal(f"{form}: {sha} is resolved already: a stray-import or stray-revert entry "
                      f"names it, so no pass counts or stops at it (Y:2894-2896); {nothing}")
    try:
        m, carrier = render_register_seq(root, tip, skip, _render_deadline())
    except StoreUnusable as exc:
        raise Refusal(f"{form}: origin {RENDER_BRANCH}'s last {REGISTER_SEQ_KEY} could not be "
                      f"found ({exc.detail}); a read that cannot answer refuses; {nothing}")
    if sha == diverged:
        return False, tip
    if m > head:
        if sha == carrier:
            return False, tip
        found = (f"{carrier}, which carries {REGISTER_SEQ_KEY} {m} above the journal's head "
                 f"{head} (R2's N6)")
    else:
        try:
            stray = render_strays_after(root, carrier, tip, skip)
        except StoreUnusable as exc:
            raise Refusal(f"{form}: the commits after {carrier} could not be read "
                          f"({exc.detail}); a read that cannot answer refuses; {nothing}")
        if sha == stray:
            return False, tip
        found = (f"{stray}, the oldest commit after {carrier} that changes the render set"
                 if stray else f"no commit after {carrier}, which carries {REGISTER_SEQ_KEY} {m}, "
                 f"that changes the render set")
    raise Refusal(f"{form}: {sha} is not the divergence: the register records "
                  f"{diverged or 'none'}, and the renderer's check finds {found}. A way out "
                  f"names the stray `{PROG} status` prints as diverged at, or the one the "
                  f"renderer would stop at now (S2); {nothing}")


def _stray_parent(form: str, root: str, sha: str) -> str:
    """`sha`'s first parent, which the stray's changes are read against, as the
    pass reads each commit after `R` (`--diff-merges=first-parent`). A commit
    with none is refused (2)."""
    run = render_git(root, "rev-parse", "--verify", "-q", f"{sha}^1^{{commit}}",
                     env=_render_env(), timeout=git_timeout_s())
    parent = run.out.strip()
    if run.rc != 0 or not SHA_RE.match(parent):
        raise Refusal(f"{form}: {sha} has no first parent to read its changes against; nothing "
                      f"was written")
    return parent


def _stray_write(attempt: str, name: str, data: bytes) -> None:
    """One file of the attempt directory, `name` under `attempt`, made 0600
    and new (`O_EXCL`), its folders made where they are missing."""
    path = os.path.join(attempt, *name.split("/"))
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as handle:
        handle.write(data)


def _stray_snapshot(attempt: str, ident: dict, rerun: tuple | None,
                    root: str) -> tuple[int, dict | None, float]:
    """ONE WRITER'S SNAPSHOT (D9's snapshot row, Y:3583), `register snapshot`
    itself, run in this process with its stdout the attempt's `snapshot` file:
    `--write-id new` for a first attempt, or the write's id and generation
    once it has them, with the lane, the verb and `args_sha256`, and the
    scratch tree `--tree <attempt>/tree --checkout <c>`. Returns its exit,
    its keys (`register_attempt_snapshot`), and the `time.monotonic()`
    instant it ended, which F3's lookup counts the clock's age from."""
    import contextlib     # used here alone, so the module's imports stay as they were
    argv = (["--write-id", "new"] if rerun is None
            else ["--write-id", rerun[0], "--generation", rerun[1]])
    argv += ["--lane", ident["lane"], "--verb", ident["verb"], "--args-sha256",
             ident["args_sha256"], "--tree", os.path.join(attempt, "tree"), "--checkout", root]
    path = os.path.join(attempt, "snapshot")
    with open(path, "w", encoding="utf-8", newline="") as handle, \
            contextlib.redirect_stdout(handle):
        code = cmd_register_snapshot(argv)
    ended = time.monotonic()
    if code != EXIT_OK:
        return code, None, ended
    with open(path, encoding="utf-8") as handle:
        return code, register_attempt_snapshot(handle.read()), ended


def _stray_way_out(kind: str, sha: str) -> int:
    """A way out, steps 1 to 4 (section comment above). `kind` is the entry's,
    `stray-revert` or `stray-import`."""
    form, _flag, verb = STRAY_FORMS[kind]
    nothing = "nothing was written"
    # 1. THE OPERATOR'S INPUTS, read as T115's `import` reads them, in the
    # environment this process inherited: the author above all, which
    # `git var GIT_AUTHOR_IDENT` may take from `GIT_AUTHOR_NAME` and
    # `GIT_AUTHOR_EMAIL` alone (lane 3's review of T324, MUST-1; T271's
    # estate names its operator so).
    cfg = load_config()
    lane = _import_lane(who=form, nothing=nothing)
    workstation = _import_workstation(who=form, nothing=nothing)
    if not _REGISTER_WORD_RE.fullmatch(workstation):
        raise Refusal(f"{form}: this workstation's name {workstation!r} holds white space, and "
                      f"an entry's workstation is one word, as `register commit "
                      f"--workstation` takes it; {nothing}")
    root = _import_checkout(lane, who=form, nothing=nothing)
    author = _import_author(root, who=form, nothing=nothing)
    # THEN D12 AND F29, as `render --checkout` has them, before the git half
    # and every call after it: `render_git_env()` is this environment with
    # every `GIT_*` and `LANES_NO_FETCH` taken out and F29's pins put in.
    pinned = render_git_env()
    os.environ.clear()
    os.environ.update(pinned)
    rerun = _stray_rerun(form)
    store = PostgresStore(cfg, "register_writer")
    shipped = register_shipped_repos_text()
    # F10's digest of what makes this write itself: the lane, the verb and the
    # stray, so a rerun's snapshot and F3's lookup know its entry.
    args_sha256 = hashlib.sha256("\x00".join((lane, verb, sha)).encode("utf-8")).hexdigest()
    ident = {"write_id": None, "generation": None, "lane": lane, "verb": verb,
             "args_sha256": args_sha256, "workstation": workstation}
    # 2. THE GIT HALF, then what the entry carries, by its kind. Each attempt
    # checks the git half again, inside its turn, at this check's tip
    # (`_stray_attempts`).
    _resolved, tip = _stray_recognised(form, root, store, sha, rerun is not None)
    parent = _stray_parent(form, root, sha)
    plan = (_stray_revert_plan(form, root, sha, parent) if kind == "stray-revert"
            else _stray_single_plan(form, root, sha, parent))
    message = (f"LANES({lane}@{workstation}): {form} of the stray commit {sha} — "
               + plan["what"] + " (D16, S2)")
    # 3. THE ATTEMPTS.
    code, seq = _stray_attempts(form, kind, sha, store=store, root=root, tip=tip,
                                ident=ident, rerun=rerun, plan=plan, message=message,
                                author=author, shipped=shipped)
    if code != EXIT_OK:
        return code
    # 4. THE RENDER THAT FOLLOWS.
    say(f"{form}: " + (f"seq {seq}" if seq is not None else "its entry")
        + f" {plan['done']} {sha} and records it resolved, which clears diverged at (D16); "
        f"rendering in {root}")
    sys.stdout.flush()
    rendered = _render_checkout_main(["--checkout", root])
    if rendered != EXIT_OK:
        note(f"{form}: the render ended {rendered}, and the entry stands: `{PROG} status` shows "
             f"what the renderer recorded and the lag, and the next write's render or "
             f"`{PROG} reconcile` renders what is left")
    return EXIT_OK


def _stray_revert_plan(form: str, root: str, sha: str, parent: str) -> dict:
    """WHAT `render --revert`'s ENTRY CARRIES (Y:1544): no edits, so its
    attempt directory changes nothing; and one `journal_files` row for each
    render-set path the stray changed against its first parent, SQL's at the
    head, present with its digest and final newline or absent: the paths the
    renderer restores. The paths are read with T322's `render_tree_set`."""
    try:
        before, after = render_tree_set(root, parent), render_tree_set(root, sha)
    except RenderBuildFailed as exc:
        raise Refusal(f"{form}: {sha}'s render set could not be read ({exc}); nothing was "
                      f"written")
    paths = sorted((path for path in set(before) | set(after)
                    if before.get(path) != after.get(path)), key=lambda p: p.encode("utf-8"))

    def finish(entry: dict, view: RegisterView) -> None:
        rows = []
        for path in paths:
            view.before(path)       # read through the view, so LR004's re-read compares it
            data = view.tree_bytes(path)
            lines = None if data is None else register_image_lines(data)
            if data is not None and lines is None:
                raise RegisterAttemptRefused(f"tree/'s {path} is not UTF-8")
            rows.append({"path": path, "present": data is not None,
                         "sha256": None if data is None else hashlib.sha256(data).hexdigest(),
                         "final_newline": None if lines is None else lines[1]})
        entry["files"] = rows

    return {"attempt": lambda attempt, ident, n: _stray_revert_attempt(attempt, ident),
            "finish": finish, "paths": paths,
            "what": "SQL's state is rendered back over it",
            "done": "journals the revert of"}


def _stray_revert_attempt(attempt: str, ident: dict) -> dict:
    """THE REVERT'S ONE CALL TO `register commit`'s ATTEMPT READ, with its
    change set EMPTY ON PURPOSE, made explicit here and nowhere else: "an entry
    with no edits" (Y:2989-2991; B14 tasks:1526), so a 0-byte `changes.tsv`
    and `files` and no `images/`, which `read_attempt_dir` reads as no change.
    It needs no marker: T112's refusal of an empty change set is the CLI's
    `register commit` arm's alone, which this in-process entry never passes
    through (lane 3, #165 6808937880, batch e Q88, ruling lane 4's question
    88, #165 6808439918). Returns `read_attempt_dir`'s attempt."""
    _stray_write(attempt, "changes.tsv", b"")
    _stray_write(attempt, "files", b"")
    return read_attempt_dir(attempt, ident, None)


def _stray_single_plan(form: str, root: str, sha: str, parent: str) -> dict:
    """WHAT `import --single`'s ENTRY CARRIES (Y:1543; B14 tasks:1527): the
    stray's line edits on the render set, as one write.

    - LANE 1'S LOADER READS BOTH COMMITS (`_import_source`, T115), from
      origin's objects in the operator lane's checkout: the stray and its first
      parent, each on origin, each render-set file UTF-8 with no CR and no
      NUL, under a path with no control character, or a refusal (2) that
      names `import --single` and its way out, `render --revert <sha>`
      (NIT-4 of lane 3's review of T324). Each render-set path whose bytes
      differ between them is one of the stray's changes.
    - AT EACH ATTEMPT, each change is applied to SQL's image at the head, as
      the scratch tree holds it (`_stray_apply`), and the attempt directory
      carries the images that leaves; `register commit` then derives the
      entry's edits and rows from them as for any write, step 6's derived
      deletes included (ERR-48). Where SQL's image is the parent's, those
      edits are the stray's own (AT-6: "Its line edits equal the stray
      commit's diff"); a line inserted before a file's end rewrites every
      later line, ERR-48's recorded limitation.
    - WHERE ONE NO LONGER APPLIES, it is refused (2), nothing sent, naming
      `render --revert <sha>` as the way out (PC-4)."""
    way_out = f"its way out is `{PROG} render --revert {sha}` (PC-4); nothing was written"
    before = _import_source(root, parent, fetch=False, who=form, nothing=way_out)["data"]
    after = _import_source(root, sha, fetch=False, who=form, nothing=way_out)["data"]
    paths = sorted((path for path in set(before) | set(after)
                    if before.get(path) != after.get(path)), key=lambda p: p.encode("utf-8"))

    def attempt(directory: str, ident: dict, n: int) -> dict:
        tree = os.path.join(directory, "tree")
        changes: dict = {}
        images: dict = {}
        for path in paths:
            where = os.path.join(tree, *path.split("/"))
            sql = None
            if os.path.isfile(where) and not os.path.islink(where):
                with open(where, "rb") as handle:
                    sql = handle.read()
            status, data = _stray_apply(form, sha, n, path, before.get(path), after.get(path),
                                        sql)
            changes[path] = (status,
                             _REGISTER_ZERO_BLOB if sql is None else _register_blob_id(sql),
                             _REGISTER_ZERO_BLOB if data is None else _register_blob_id(data))
            if data is not None:
                images[path] = data
        _stray_write(directory, "changes.tsv",
                     "".join(f"{status}\t{path}\t{base}\t{new}\n"
                             for path, (status, base, new) in changes.items()).encode("utf-8"))
        for path, data in images.items():
            _stray_write(directory, "images/" + path, data)
        _stray_write(directory, "files", register_files_rows(changes, images))
        return read_attempt_dir(directory, ident, None)

    return {"attempt": attempt, "finish": lambda entry, view: None, "paths": paths,
            "what": "its line edits on the render set, loaded as one write",
            "done": f"loads, as one write, the line edits on {len(paths)} render-set "
                    f"path{'' if len(paths) == 1 else 's'} of"}


def _stray_apply(form: str, sha: str, n: int, path: str, base: bytes | None,
                 new: bytes | None, sql: bytes | None) -> tuple:
    """ONE OF THE STRAY'S CHANGES, APPLIED TO SQL'S IMAGE AT `n`, as
    `commit_write`'s step 6 applies an entry's edits: `(status, bytes)`, the
    status as `changes.tsv` takes it and the image it leaves, None where the
    path goes. `base` and `new` are the path's bytes at the stray's first
    parent and at the stray, None where absent; `sql` is SQL's. The edits are
    `register_line_edits(base, new)`, as `register commit` would derive them
    from those two images, and each is applied by the render line's own
    replay of step 6, `_register_apply_edit` (lane 3's review of T324,
    SHOULD-1): each `replace` or `delete` at its line, in the image the edits
    before it left, must find there the text the parent had; each `append`
    goes at that image's end, as step 6 takes an append with no line number
    (design:1837-1839 at `6e534355`), so where appends are the stray's only
    edits of the file (a log line, a row added at the end), SQL's file
    having grown since the stray's parent refuses nothing (lane 3's call on
    the review's open point 1). WHERE THE STRAY'S EDITS OF THE FILE MIX A
    `replace` OR `delete` WITH APPENDS, and SQL's file has more lines than
    the stray's parent's, the appends would land after lines the stray never
    saw, reordering the file (ERR-48's rewrite of every later line), so it
    no longer applies (lane 3's call on the fix round's observation); where
    SQL's file has not grown, mixed edits apply as the rest. A final newline
    the stray changes must be the parent's in SQL's image; a path the stray
    adds must be absent from SQL; and one it removes must be the parent's,
    byte for byte, since a `remove` takes every line. Anything else no longer
    applies, a `Refusal` (2) naming the edit and the revert (L2-8)."""
    where = f"{form}: {sha}'s line edits no longer apply to SQL's images at seq {n} (S2; FR-047)"
    way_out = f"its way out is `{PROG} render --revert {sha}` (PC-4); nothing was written"
    if base is None:
        if sql is not None:
            raise Refusal(f"{where}: it adds {path}, which SQL holds; {way_out}")
        return "A", new
    if new is None:
        if sql != base:
            raise Refusal(f"{where}: it removes {path}, which SQL "
                          + ("does not hold" if sql is None else
                             "holds other than the stray's parent did, so lines it never "
                             "removed would go")
                          + f"; {way_out}")
        return "D", None
    if sql is None:
        raise Refusal(f"{where}: it edits {path}, which SQL does not hold; {way_out}")
    old, edited, held = (register_image_lines(data) for data in (base, new, sql))
    if old is None or edited is None or held is None:
        raise Refusal(f"{where}: {path} is not UTF-8 on one side; {way_out}")
    state = {path: [list(held[0]), held[1]]}
    ops, _written = register_line_edits(old[0], edited[0])
    appends = [number for number, op in enumerate(ops, 1) if op[0] == "append"]
    if appends and len(appends) < len(ops) and len(held[0]) > len(old[0]):
        number = appends[0]
        raise Refusal(f"{where}: its edit {number} of {path} is an append at line "
                      f"{ops[number - 1][1]}, among edits that replace or delete lines of it, "
                      f"and SQL's {path} has grown past the stray's parent's end ({len(held[0])} "
                      f"lines, the parent's {len(old[0])}), so its appends would land after "
                      f"lines the stray never saw; {way_out}")
    for number, (op, line_no, text, replacement) in enumerate(ops, 1):
        try:
            _register_apply_edit(
                state, f"edit {number}", op, path, None if op == "append" else line_no,
                None if text is None else hashlib.sha256(text.encode("utf-8")).hexdigest(),
                replacement, None)
        except RenderRefused:
            # Only a `replace` or a `delete` whose line is not the parent's
            # reaches here: `register_line_edits` gives every op its text.
            raise Refusal(f"{where}: its edit {number} of {path} is a {op} at line {line_no}, "
                          f"and SQL's line there is not the one the stray's parent held; "
                          f"{way_out}") from None
    lines, final_newline = state[path]
    if old[1] != edited[1]:
        if final_newline != old[1]:
            raise Refusal(f"{where}: it changes whether {path} ends with a newline, and SQL's "
                          f"{path} does not end as the stray's parent did; {way_out}")
        final_newline = edited[1]
    return "M", register_image_bytes(lines, final_newline)


def _stray_attempts(form: str, kind: str, sha: str, *, store, root: str, tip: str,
                    ident: dict, rerun: tuple | None, plan: dict, message: str, author: str,
                    shipped: str | None) -> tuple:
    """STEP 3, THE ATTEMPTS (section comment above): `(code, seq)`, the seq
    the entry stands at where the code is 0 and it is known. Each attempt's
    files are in a directory of their own, removed with the rest when the
    attempts end. Each attempt whose snapshot does not find this write checks
    the git half again (`_stray_recognised`, at `tip`, the first check's
    origin tip, with no fetch) before anything else, so its commit call is
    made only where, at or after its snapshot's head, `sha` is still the
    divergence and no other entry has resolved it."""
    import tempfile     # used here alone, so the module's imports stay as they were
    limit = rollback_deadline_s()
    deadline = time.monotonic() + limit
    doubt, not_after, clock = False, 0, None
    work = tempfile.mkdtemp(prefix="lanes-index-stray-")
    try:
        number = 0
        while True:
            number += 1
            attempt = os.path.join(work, str(number))
            os.mkdir(attempt, 0o700)
            seq = None
            try:
                code, snap, ended = _stray_snapshot(attempt, ident, rerun, root)
                if code != EXIT_OK:
                    note(f"{form}: attempt {number}'s snapshot ended {code}"
                         + ("; an earlier commit call was in doubt" if doubt
                            else "; nothing was written"))
                    break
                rerun = (snap["write_id"], snap["generation"])
                ident.update(write_id=rerun[0], generation=rerun[1])
                clock = ((int(snap["clock"]), 0), ended)
                if snap.get("found"):
                    seq = int(snap["found"])
                    say(f"already {seq}")
                    note(f"{form}: write {rerun[0]} is in the journal at seq {seq}, committed by "
                         f"an earlier attempt or run")
                    return EXIT_OK, seq
                # THE GIT HALF AGAIN, IN THIS ATTEMPT'S TURN (lane 3's call on
                # its review's open point 2): read after the snapshot and before
                # the commit call, whose base is the snapshot's head, so an
                # entry that resolved `sha` first is seen here or makes the
                # call lose its turn, and the next attempt sees it.
                if _stray_recognised(form, root, store, sha, True, tip)[0]:
                    raise Refusal(f"{form}: {sha} is resolved already, and write {rerun[0]} is "
                                  f"not in the journal: another entry resolved it "
                                  f"(Y:2894-2896); nothing was written")
                _stray_write(attempt, "msg", message.encode("utf-8"))
                _stray_write(attempt, "author", (author + "\n").encode("utf-8"))
                _stray_write(attempt, "not_after", (snap["not_after"] + "\n").encode("ascii"))
                # THE CHANGE SET, BY THE ENTRY'S KIND, AND `read_attempt_dir`.
                att = plan["attempt"](attempt, ident, int(snap["n"]))
                entry, view = _register_build_entry(att, ident, shipped, kind=kind,
                                                    git_commit=sha)
                plan["finish"](entry, view)
                not_after = max(not_after, att["not_after"])
                code, seq, err, failure = _register_commit_call(store, att, ident, entry)
                if err is not None and err.sqlstate == "LR004":
                    code = _register_commit_lr004(store, att, ident, entry, view, err)
                elif code == EXIT_IN_DOUBT:
                    note(f"{form}: the commit call of write {rerun[0]} "
                         f"{register_psql_end(failure)}, so whether it committed is not known")
                else:
                    code = _register_commit_end(store, ident, entry, code, seq, err, failure)
                    if kind == "stray-import" and err is not None and err.sqlstate in (
                            "LR005", "LR010"):
                        # A STRAY THE REGISTER'S RULES REFUSE, a revived pair of
                        # live claims among them (`one-live-claim`, with its
                        # `held-by=` line above), cannot be loaded as one write
                        # (lane 3, #165 6778890211; T107's `edge-two-live`).
                        note(f"{form}: {sha} is not loaded; its way out is `{PROG} render "
                             f"--revert {sha}` (S2; PC-4)")
            except Refusal as exc:
                note(f"REFUSED: {exc}")
                code = EXIT_REFUSED
            except _StrayEnd as exc:
                # The git half's re-check, ended 69: after a doubt it still
                # waits for F3's lookup below (exit-codes §3.5's 69 row).
                note(str(exc))
                code = exc.code
            except (StoreUnusable, OSError, KeyError, ValueError) as exc:
                note(f"{form}: attempt {number} could not be made ({exc}); nothing was sent")
                code = EXIT_UNAVAILABLE
            if code == EXIT_IN_DOUBT:
                doubt = True
            if code == EXIT_OK:
                return EXIT_OK, seq
            if code in (EXIT_BUSY, EXIT_IN_DOUBT) and time.monotonic() < deadline:
                note(f"{form}: attempt {number} ended {code}; a fresh snapshot under write "
                     f"{rerun[0]} follows, within D7's {limit} s")
                continue
            break
    finally:
        shutil.rmtree(work, ignore_errors=True)
    if doubt:
        code, seq = _stray_after_doubt(form, store, ident, not_after, clock, code)
        if code == EXIT_OK:
            return EXIT_OK, seq
    if code == EXIT_IN_DOUBT:
        note(f"{form}: write {ident['write_id']} stays in doubt: whether its entry committed is "
             f"not known. Run it again under the same id, which writes it once or finds it "
             f"(D8): LANES_WRITE_ID={ident['write_id']} "
             f"LANES_WRITE_GENERATION={ident['generation']} {PROG} {form} {sha}")
    return code, None


def _stray_after_doubt(form: str, store, ident: dict, not_after: int, clock: tuple,
                       code: int) -> tuple:
    """F3'S LOOKUP AFTER A DOUBT (D8; Y:5272-5300), before any end but 0:
    `(code, seq)`. Found is 0, with the lookup's lines; absent, with the head
    row's lock held past every call's `not_after`, is the code the last
    attempt earned, and 75, a lost turn with nothing written, where that
    attempt was itself the one in doubt (LR008's reading, Y:5294); LR007 is 2;
    and no answer is 3."""
    (db_clock, age), started = clock
    kind, answer, failure, err, ends = register_lookup(store, ident, not_after,
                                                       (db_clock, age), started)
    if kind == "found":
        _register_lookup_end(ident, kind, answer, failure, err, ends)
        note(f"{form}: the lookup finds write {ident['write_id']} at seq {answer[0]}: its entry "
             f"committed")
        return EXIT_OK, answer[0]
    if kind == "absent":
        note(f"{form}: the lookup finds write {ident['write_id']} absent, with the head row's "
             f"lock held past its not_after, so no call of it can still commit; nothing was "
             f"written")
        return (EXIT_BUSY if code == EXIT_IN_DOUBT else code), None
    return _register_lookup_end(ident, kind, answer, failure, err, ends), None


# ================================================================ the acts

def resolve_source(requested: str | None, root: str) -> str:
    source = source_of(root)
    if requested and requested != source:
        if is_inventory(requested):
            raise Refusal(f"{requested} is this workstation's worktree inventory, which "
                          f"`sync`/`reconcile --source inventory` write and `export "
                          f"--worktrees` reads; this is the register's path")
        if requested.startswith("ledger:"):
            raise Refusal(f"{requested} is the managed ledger's half, which T058 of the 001 "
                          f"feature writes (Amendment 14(g) act 4); this indexer writes the "
                          f"register half only")
        raise Refusal(f"this workstation's register is {source}, not {requested}")
    return source


def diff_records(store, source: str, records: dict, verify_content: bool) -> tuple:
    """The upserts and deletes that take the stored source to `records`.

    `sync` compares DIGESTS: an upsert bearing the stored digest changes
    nothing. `reconcile` recomputes each stored row's digest from its CONTENT,
    so a row somebody changed by hand - which still carries its old digest - is
    found and put right."""
    upserts, deletes, kept = {}, {}, {}
    for table in REGISTER_TABLES:
        cols = TABLE_COLUMNS[table]
        stored = {r["record_id"]: r for r in store.rows(table, source,
                                                         cols + ["digest"])}
        for rec in records[table].values():
            rec["digest"] = digest_of(table, rec)
        for rec_id, rec in records[table].items():
            old = stored.get(rec_id)
            if old is not None:
                have = digest_of(table, old) if verify_content else old["digest"]
                if have == rec["digest"] and (not verify_content or old["digest"] == rec["digest"]):
                    kept[table] = kept.get(table, 0) + 1
                    continue
            upserts.setdefault(table, {})[rec_id] = rec
        gone = [rec_id for rec_id in stored if rec_id not in records[table]]
        if gone:
            deletes[table] = gone
    return upserts, deletes, kept


def has_unknown_owner(store, source: str) -> bool:
    return any(r["owner"] == "unknown" for r in store.rows("lanes", source, ["owner"]))


def stored_lanes_of(store, source: str) -> dict:
    return {r["record_id"]: r for r in store.rows("lanes", source,
                                                   ["lane", "owner", "row_text"])}


def run_index(mode: str, requested: str | None, dry_run: bool) -> int:
    cfg = load_config()
    root = workspace_root()
    source = resolve_source(requested, root)
    tip = tip_of(root)
    store = open_store(cfg, "writer")
    if dry_run:
        try:
            store.open_read()
        except StoreUnusable as exc:
            if exc.kind not in ("missing", "wiped"):
                raise
            store = None
    else:
        store.open_write()
    old = store.provenance(source) if store is not None else None
    label = f"{source} at register@{tip[:12]} ({cfg['store']})"
    if old and old.get("commit_sha"):
        prev = old["commit_sha"]
        if not has_commit(root, prev):
            say(f"{PROG} {mode}: the index holds register@{prev[:12]}, which this checkout has "
                f"not fetched - another workstation is ahead of it; nothing written")
            write_status(source, last_attempt_utc=utc_now(), last_result="behind (unknown commit)")
            return 0
        # NOT WHILE AN OWNER IS `unknown` (Codex on #164): an `unknown` may be a
        # read that failed, and asking again is how it clears - so a sync at
        # the same commit goes the long way round, asks only those, and writes
        # nothing where nothing has changed.
        if prev == tip and mode == "sync" and not has_unknown_owner(store, source):
            say(f"{PROG} sync: {label} - the index is at the tip; nothing to write")
            write_status(source, last_attempt_utc=utc_now(), last_sync_utc=utc_now(),
                         last_result="current", last_error="")
            return 0
        if not is_ancestor(root, prev, tip):
            behind = is_ancestor(root, tip, prev)
            why = ("this checkout is BEHIND the index" if behind else
                   "the two have diverged - a register history rewritten under the index is "
                   "rebuilt by wiping the index and reconciling")
            say(f"{PROG} {mode}: register@{tip[:12]} does not descend from the indexed "
                f"register@{prev[:12]}: {why}. The provenance only moves forward "
                f"(Amendment 14(d)); nothing written")
            write_status(source, last_attempt_utc=utc_now(),
                         last_result="not a descendant; nothing written")
            return 0 if behind else 1
    snap = read_snapshot(root, tip)
    records = build_records(snap)
    if store is None:
        fill_owners(records, None)
        upserts = {t: dict(r) for t, r in records.items() if r}
        for table, recs in upserts.items():
            for rec in recs.values():
                rec["digest"] = digest_of(table, rec)
        deletes, kept = {}, {}
    else:
        stored = None if mode == "reconcile" else stored_lanes_of(store, source)
        fill_owners(records, stored)
        upserts, deletes, kept = diff_records(store, source, records,
                                              verify_content=(mode == "reconcile"))
    # THE OWNERS ARE ASKED OF `origin/<branch>` AS IT STANDS, and the rows were
    # read at ONE commit (Copilot round 1 on #164): `managed-projection` reads
    # the ref, not a sha. So the ref is asked again once every owner is in, and
    # a ref that moved meanwhile writes NOTHING - not rows of one commit beside
    # owners of another - and the caller starts over at the new tip.
    if not dry_run and tip_of(root) != tip:
        raise SourceMoved(f"origin/{branch()} moved from {tip[:12]} while the owners were "
                          f"read; nothing was written from that read")
    n_up = sum(len(v) for v in upserts.values())
    n_del = sum(len(v) for v in deletes.values())
    if mode == "reconcile":
        say(f"{PROG} reconcile: {label}{' - DRY RUN' if dry_run else ''}")
        for table in REGISTER_TABLES:
            say(f"  {table:<20} {kept.get(table, 0):>6} kept  {len(upserts.get(table, {})):>6} "
                f"upserted  {len(deletes.get(table, [])):>6} removed")
    if dry_run:
        say(f"  total: {n_up} to upsert, {n_del} to remove - nothing written (--dry-run)")
        return 0
    if old and old.get("commit_sha") == tip and not upserts and not deletes:
        if mode == "sync":
            say(f"{PROG} sync: {label} - the index is at the tip; nothing to write")
        else:
            say("  total: nothing differs; nothing written")
        write_status(source, last_attempt_utc=utc_now(), last_sync_utc=utc_now(),
                     last_result="current", last_error="")
        return 0
    store.apply(source, old, tip, upserts, deletes)
    write_status(source, last_attempt_utc=utc_now(), last_sync_utc=utc_now(),
                 last_result=f"{n_up} upserted, {n_del} removed at {tip[:12]}", last_error="")
    if mode == "sync":
        say(f"{PROG} sync: {label} - {n_up} upserted, {n_del} removed")
    else:
        say(f"  total: {n_up} upserted, {n_del} removed")
    return 0


# ======================================== the inventory (opensoft/openRepoTools#161)
#
# THIS WORKSTATION'S #97 WORKTREE INVENTORY, AS A SECOND SOURCE. Amendment 14(e)
# left "#97's lifecycle snapshots and worktree inventories, local to one
# workstation by design" to a later word; #161 is it. The source is
# `inventory:<Workstation>` - one per workstation, because the sidecars are on
# that workstation's disk and nowhere else - and its rows are what
# `lanes-edit.sh worktrees --all` prints, which is the inventory read through
# the helper that writes it. Nothing here parses a sidecar, a snapshot or an
# ownership marker, and nothing here lists a directory.

def _helper_run(args: list, timeout: float, what: str) -> subprocess.CompletedProcess:
    helper = lanes_edit_path()
    if not helper:
        raise StoreUnusable("unread", f"no lanes-edit.sh beside this file or on PATH, so {what} "
                            f"cannot be read")
    try:
        return subprocess.run([helper, *args], capture_output=True, encoding="utf-8",
                              errors="replace", check=False, env=helper_env(),
                              stdin=subprocess.DEVNULL, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise StoreUnusable("unread", f"`lanes-edit.sh {' '.join(args)}` did not answer within "
                            f"{int(timeout)} s")
    except OSError as exc:
        raise StoreUnusable("unread", f"`lanes-edit.sh {' '.join(args)}` could not be run: {exc}")


@functools.lru_cache(maxsize=None)
def this_workstation() -> tuple[str, str]:
    """`lanes-edit.sh workstation`'s first two columns: the name every row of
    this workstation is filed under, and where it came from.

    ASKED ONCE A PROCESS (the review of #219): the refusal `cmd_sync` makes
    before the lock asks it, and the sync that then takes the lock asked again
    for the same answer - one environment, one name. A read that failed raises,
    and is not kept."""
    proc = _helper_run(["workstation"], 60, "this workstation's name")
    first = (proc.stdout.splitlines() or [""])[0].split("\t")
    if proc.returncode != 0 or not first[0]:
        why = (proc.stderr.strip().splitlines() or ["no answer"])[-1]
        raise StoreUnusable("unread", f"`lanes-edit.sh workstation` exited {proc.returncode}: {why}")
    return first[0], (first[1] if len(first) > 1 else "")


def inventory_source(requested: str | None) -> str:
    """`inventory:<this workstation>`. `--source inventory` is the short name for
    it; another workstation's is refused, as another register is - its sidecars
    are on its own disk. AND A CONTAINER WITH NO NAME FILES NOTHING (Amendment
    11, `R-A11-14`): a source named for a container's own id is a source no
    restart of any workstation will ever find again."""
    name, how = this_workstation()
    if how == "container-unset":
        raise Refusal("this container has no LANES_WORKSTATION, so its inventory would be "
                      f"filed under the container's own id `{name}` - a source no restart of "
                      "any workstation finds again (Amendment 11, R-A11-14). Export "
                      "LANES_WORKSTATION, as the launcher does")
    source = f"{INVENTORY_PREFIX}{name}"
    if requested and requested not in ("inventory", source):
        raise Refusal(f"this workstation's inventory is {source}, not {requested}: an "
                      f"inventory is synced by the workstation whose disk holds it")
    return source


def _int_or_none(value: str):
    return int(value) if value.isdigit() else None


def tree_record(fields: list) -> dict:
    """One `TREE` line of `lanes-edit.sh worktrees`, as the `worktrees` row it
    is. An empty field is NULL: a count the inventory recorded as `unknown`, a
    base or a last commit that could not be read, a lane with no snapshot."""
    text = [f if f != "" else None for f in fields]
    return {"workstation": text[1], "lane": fields[2], "owner": text[3], "path": fields[4],
            "branch": text[5], "base": text[6], "lifecycle": text[7],
            "generation": _int_or_none(fields[8]), "operation": text[9],
            "writer_live": _int_or_none(fields[10]), "last_seen_utc": text[11],
            "last_commit": text[12], "dirty_count": _int_or_none(fields[13]),
            "unpushed_count": _int_or_none(fields[14]), "pr_number": None, "pr_state": None,
            "_provenance": text[15]}


def tree_line(row: dict, provenance) -> str:
    """The `TREE` line a stored row came from - the inverse of `tree_record`, so
    that `lanes --index --worktrees` and `lanes --worktrees` print the same
    bytes wherever the index is current."""
    def text(value) -> str:
        return "" if value is None else str(value)
    return US.join(["TREE"] + [text(row.get(c)) for c in (
        "workstation", "lane", "owner", "path", "branch", "base", "lifecycle", "generation",
        "operation", "writer_live", "last_seen_utc", "last_commit", "dirty_count",
        "unpushed_count")] + [text(provenance)])


#: THE BRANCH OF A LANE'S UNREAD MARKER (opensoft/openRepoTools#173): a
#: `worktrees` row with no path and a branch `unreadable inventory (<why>)`,
#: saying the lane's inventory could not be read at the last
#: sync, and why. A MARKER IS ITS KEY, `unread_key(<lane>)` - `<lane>:` and a
#: US - and nothing else decides it (the review of #219 and its delta check):
#: no tree's key can carry a US after the colon but its own `<US><n>`, while a
#: hand-made sidecar's branch can read like this one, and so can the row an
#: older helper printed for a sidecar with no `path:`, which has an EMPTY path.
#: (The helper no longer prints that row: the id of such a record stands where
#: its path would be, and the lane is `UNREAD` beside it, #302.)
UNREAD_BRANCH = "unreadable inventory"


def is_unread_marker(row: dict) -> bool:
    return row.get("record_id") == unread_key(row.get("lane") or "")


def unread_key(lane: str) -> str:
    return f"{lane}:{US}unread"


def unread_record(workstation: str, lane: str, why: str) -> dict:
    """The marker row of a lane whose inventory could not be read."""
    record = {col: None for col in TABLE_COLUMNS["worktrees"]}
    record.update(workstation=workstation, lane=lane, path="",
                  branch=f"{UNREAD_BRANCH} ({why})", _provenance=None)
    return record


def unread_line(row: dict) -> str:
    """The `UNREAD` line a marker row came from - `UNREAD <workstation> <lane>
    <why>`, as `lanes-edit.sh worktrees` prints it, so that `lanes --index
    --worktrees` says NOT READ wherever the source read said it."""
    why = row.get("branch") or ""
    if why.startswith(f"{UNREAD_BRANCH} (") and why.endswith(")"):
        why = why[len(UNREAD_BRANCH) + 2:-1]
    return US.join(["UNREAD", row.get("workstation") or "", row.get("lane") or "", why])


def inventory_digest(record: dict) -> str:
    """The register's digest, and the row's provenance with it: two
    observations of one tree filed under two generations are two versions."""
    content = ["worktrees"] + [record.get(col) for col in TABLE_COLUMNS["worktrees"]] + \
        [record.get("_provenance")]
    blob = json.dumps(content, ensure_ascii=False, separators=(",", ":"), sort_keys=False)
    return hashlib.sha256(blob.encode("utf-8")).hexdigest()


def lane_generation(lane: str) -> tuple:
    """`(generation, None)` of a lane's lifecycle snapshot, asked of `lanes-edit.sh
    lane-state` - 0 where the lane has no snapshot or no control root here - or
    `(None, why)` where its generation could not be read.

    THE REASON IS THE HELPER'S OWN FIRST SENTENCE (opensoft/openRepoTools#290,
    review r3 of #289's NIT-A). `lane-state` is 10 where the snapshot is there
    and could not be read, and where the lane's object log could not be read,
    so where the snapshot is kept is not known; the hold says which, in its
    words. It said "its lifecycle snapshot could not be read" for both - and
    a helper older than #290 said 8 for the second, which is read as 0 here
    still: the hold that makes is a hold, for the reason it gives."""
    proc = _helper_run(["lane-state", lane], 120, f"lane {lane}'s lifecycle snapshot")
    if proc.returncode in (1, 8):
        return 0, None
    if proc.returncode != 0:
        # `die`'S OWN `(exit <n>)` LINE IS NOT THE REASON (the review of #290,
        # N3). The helper runs in this process's environment, and with
        # `LANES_DEBUG` set `die` writes that line after the sentence, last.
        lines = proc.stderr.strip().splitlines()
        if lines and re.fullmatch(r"lanes-edit: \(exit [0-9]+\)", lines[-1].strip()):
            lines.pop()
        said = (lines or [""])[-1]
        if said.startswith("lanes-edit: "):
            said = said[len("lanes-edit: "):]
        said = said.split(". ", 1)[0].rstrip(".")
        return None, (f"its lifecycle generation could not be read - "
                      f"{said or 'lane-state said nothing more'} "
                      f"(lane-state exited {proc.returncode})")
    fields = dict(line.split("\t", 1) for line in proc.stdout.splitlines() if "\t" in line)
    if fields.get("state") == "UNKNOWN-SCHEMA":
        return None, f"its lifecycle snapshot records schema {fields.get('schema')}"
    gen = fields.get("generation", "")
    return (int(gen) if gen.isdigit() else 0), None


def collect_inventory() -> tuple[dict, dict]:
    """Every tree the inventory names, keyed `<lane>:<path>` (a second tree of
    one lane with the same path `<lane>:<path><US><n>`), and every lane whose
    inventory could not be read - whose rows are KEPT, never taken
    for a lane with no trees (Amendment 7(d)).

    A READ WHOSE LANE LISTING WAS NOT WHOLE IS NO ANSWER AT ALL
    (opensoft/openRepoTools#173 item c1). The helper lists the lanes out of the
    register, the archive and the object logs, and where one of those reads
    failed it says so in a `PARTIAL <workstation> <why>` line beside the rows it
    did reach. A lane it could not name is not a lane with no trees, and which
    lanes those are is exactly what the read does not know - so nothing is
    written from it, as nothing is from a listing that could not be read at
    all: the index stays at the last whole read, which `synced <UTC>` dates. An
    indexer older than this line refuses it too, as a line it does not read."""
    proc = _helper_run(["worktrees", "--all"], 600, "the worktree inventory")
    if proc.returncode == 8:
        return {}, {}
    if proc.returncode != 0:
        why = (proc.stderr.strip().splitlines() or ["no answer"])[-1]
        raise StoreUnusable("unread", f"`lanes-edit.sh worktrees --all` exited "
                            f"{proc.returncode}: {why}")
    trees, unread = {}, {}
    for line in proc.stdout.split("\n"):
        if not line:
            continue
        fields = line.split(US)
        if fields[0] == "PARTIAL" and len(fields) >= 3:
            raise StoreUnusable("unread", f"the lane listing `lanes-edit.sh worktrees --all` "
                                f"reads the inventory through was not whole - {fields[2]} - so "
                                f"a lane it could not name would read as a lane with no "
                                f"worktrees and its rows would be removed (R22, Amendment 7(d))")
        if fields[0] == "UNREAD" and len(fields) >= 4:
            unread[fields[2]] = fields[3]
            continue
        if fields[0] != "TREE" or len(fields) != 16:
            raise StoreUnusable("unread", f"`lanes-edit.sh worktrees` printed a line this "
                                f"indexer does not read ({len(fields)} fields): {line[:120]!r} - "
                                f"is the helper on PATH another version?")
        record = tree_record(fields)
        # TWO TREES OF ONE LANE WITH ONE PATH ARE TWO ROWS (the review of #219):
        # it was found for two sidecars with no `path:`, each a tree whose path
        # was EMPTY, and a second one replaced the first here. The helper no
        # longer lists such a tree (its lane is `UNREAD`, #302), but a record
        # that is not whole can still name the path of a whole one. A later
        # one is keyed with its place among them, after a US, which no path in a
        # US-separated line can carry. The read is sorted, so a place holds
        # while those trees keep their order; a change that reorders them - a
        # renamed branch, say - moves both keys, and that sync upserts both.
        key = f"{record['lane']}:{record['path']}"
        if key in trees:
            n = 2
            while f"{key}{US}{n}" in trees:
                n += 1
            key = f"{key}{US}{n}"
        trees[key] = record
    return trees, unread


def _github_repo(path: str) -> str:
    if not os.path.isdir(path):
        return ""
    proc = subprocess.run(["git", "-C", path, "remote", "get-url", "origin"], capture_output=True,
                          encoding="utf-8", errors="replace", check=False,
                          stdin=subprocess.DEVNULL)
    url = proc.stdout.strip()
    if proc.returncode != 0 or "github.com" not in url:
        return ""
    repo = _norm_repo(url)
    return repo if re.match(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", repo) else ""


def pr_of(path: str, branch_name: str):
    """`(number, state)` of the newest pull request whose head is this branch,
    asked of `gh` - BEST EFFORT, and `(None, None)` wherever it does not answer.
    The one network read of this source, and only of it."""
    repo = _github_repo(path)
    if not repo:
        return None, None
    env = dict(os.environ)
    env["GH_PROMPT_DISABLED"] = "1"
    try:
        proc = subprocess.run(["gh", "pr", "list", "--repo", repo, "--head", branch_name,
                               "--state", "all", "--json", "number,state", "--limit", "1"],
                              capture_output=True, encoding="utf-8", errors="replace",
                              check=False, env=env, stdin=subprocess.DEVNULL, timeout=20)
        found = json.loads(proc.stdout) if proc.returncode == 0 else []
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return None, None
    if not isinstance(found, list) or not found or not isinstance(found[0], dict):
        return None, None
    number = found[0].get("number")
    state = found[0].get("state")
    return (number if isinstance(number, int) else None,
            state if isinstance(state, str) and state else None)


def fill_prs(trees: dict, stored: dict, mode: str, held: dict | None = None) -> int:
    """`pr_number`/`pr_state` for every tree on a branch. A `sync` carries a
    stored answer over for a tree whose branch and last commit have not moved
    where that answer is final (MERGED, CLOSED) or `gh` is not to be asked;
    `reconcile` asks again. Returns how many were asked."""
    use_gh = os.environ.get("LANES_NO_GITHUB", "") != "1" and bool(shutil.which("gh"))
    ask = []
    for rec_id, rec in trees.items():
        name = rec.get("branch") or ""
        if not name or " " in name or name in ("unknown", "HEAD") or rec["lane"] in (held or {}):
            continue
        old = stored.get(rec_id)
        if mode == "sync" and old is not None and old.get("branch") == rec["branch"] \
                and old.get("last_commit") == rec["last_commit"] \
                and (old.get("pr_state") in ("MERGED", "CLOSED") or not use_gh):
            rec["pr_number"], rec["pr_state"] = old.get("pr_number"), old.get("pr_state")
            continue
        if use_gh:
            ask.append(rec_id)
    if ask:
        with ThreadPoolExecutor(max_workers=max(1, min(8, len(ask)))) as pool:
            answers = list(pool.map(lambda rid: pr_of(trees[rid]["path"], trees[rid]["branch"]),
                                    ask))
        for rec_id, (number, state) in zip(ask, answers):
            trees[rec_id]["pr_number"], trees[rec_id]["pr_state"] = number, state
    return len(ask)


def run_inventory(mode: str, requested: str | None, dry_run: bool) -> int:
    cfg = load_config()
    source = inventory_source(requested)
    store = open_store(cfg, "writer")
    if dry_run:
        try:
            store.open_read()
        except StoreUnusable as exc:
            if exc.kind not in ("missing", "wiped"):
                raise
            store = None
    else:
        store.open_write()
    old = store.provenance(source) if store is not None else None
    trees, unread = collect_inventory()
    label = f"{source} ({cfg['store']})"
    cols = TABLE_COLUMNS["worktrees"]
    stored = {} if store is None else {
        r["record_id"]: r for r in store.rows("worktrees", source, cols + ["digest", "provenance"])}

    # THE PROVENANCE MOVES ONLY FORWARD, PER LANE (14(d)). A lane's lifecycle
    # generation is monotonic by `set-lane-state`'s own fence, so a read BELOW
    # the generation a lane's rows were written at is a snapshot that was moved
    # aside or replaced - and a `sync` writes nothing for that lane rather than
    # roll its rows back. `reconcile` is the act that takes the source as it now
    # stands, and it says so. A lane whose inventory could not be read keeps its
    # rows in either: a read that failed is never an answer. (A read whose LANE
    # LISTING was not whole never gets this far: `collect_inventory` refuses it,
    # in either act, because which lanes it could not name is what it does not
    # know - #173 item c1.)
    held: dict = {}
    for lane, why in unread.items():
        held[lane] = f"its inventory could not be read ({why})"
    read_gen: dict = {}
    for rec in trees.values():
        read_gen[rec["lane"]] = max(read_gen.get(rec["lane"], 0), rec["generation"] or 0)
    stored_gen: dict = {}
    for row in stored.values():
        stored_gen[row["lane"]] = max(stored_gen.get(row["lane"], 0), row["generation"] or 0)
    # A LANE WHOSE ROWS WOULD ALL LEAVE IS FENCED TOO (Copilot round 2 on #171).
    # It names no tree now, so it carries no generation in the read; its
    # snapshot is asked for - only for these lanes, which are few - so that one
    # moved aside and begun again without trees is held for `reconcile` like
    # any other lane that went back, rather than emptied by a `sync`.
    for lane in sorted(set(stored_gen) - set(read_gen) - set(held)):
        if not stored_gen[lane]:
            continue
        gen, why = lane_generation(lane)
        if why:
            held[lane] = why
        else:
            read_gen[lane] = gen
    taken: list = []
    for lane, gen in sorted(read_gen.items()):
        if lane in held or gen >= stored_gen.get(lane, 0):
            continue
        if mode == "sync":
            held[lane] = (f"its lifecycle generation reads {gen} and its rows were written at "
                          f"{stored_gen[lane]}; the provenance only moves forward, so nothing "
                          f"is written for it - `{PROG} reconcile --source inventory` takes "
                          f"the lane as it now stands")
        else:
            taken.append(f"  lane {lane}: its lifecycle generation went back from "
                         f"{stored_gen[lane]} to {gen} (a snapshot moved aside or replaced); "
                         f"reconcile takes it as it now stands")

    # THE UNREAD STATE IS KEPT AS WELL AS THE ROWS (opensoft/openRepoTools#173,
    # Copilot's third review of #171). A lane held because its inventory could
    # not be read gets ONE marker row, which `export --worktrees` writes back as
    # the source's own `UNREAD` line. Without it a FIRST sync that could not
    # read a lane committed usable provenance with nothing for it, and the
    # index answered "no worktree is inventoried" where the source says NOT
    # READ; and rows held over from an earlier sync read as freshly read - so
    # the marker says they are kept. It leaves with the first sync that reads
    # its lane, a lane held for its generation included: that lane was read.
    workstation = source[len(INVENTORY_PREFIX):]
    markers: dict = {}
    for lane, why in unread.items():
        rows_kept = sum(1 for row in stored.values()
                        if row["lane"] == lane and not is_unread_marker(row))
        if rows_kept:
            why = (f"{why} - the {rows_kept} row(s) listed for it are kept from the last sync "
                   f"that read it")
        markers[unread_key(lane)] = unread_record(workstation, lane, why)

    fill_prs(trees, stored, mode, held)
    upserts, deletes, kept = {}, [], 0
    for rec_id, rec in list(trees.items()) + list(markers.items()):
        rec["digest"] = inventory_digest(rec)
        if rec["lane"] in held and rec_id not in markers:
            continue
        row = stored.get(rec_id)
        if row is not None:
            if mode == "reconcile":
                as_written = {c: row.get(c) for c in cols}
                as_written["_provenance"] = row.get("provenance")
                same = inventory_digest(as_written) == rec["digest"] == row.get("digest")
            else:
                same = row.get("digest") == rec["digest"]
            if same:
                kept += 1
                continue
        upserts[rec_id] = rec
    for rec_id, row in stored.items():
        if rec_id in trees or rec_id in markers:
            continue
        if row["lane"] not in held or is_unread_marker(row):
            deletes.append(rec_id)
    after = {rid: rec["digest"] for rid, rec in trees.items() if rec["lane"] not in held}
    after.update({rid: row["digest"] for rid, row in stored.items()
                  if row["lane"] in held and not is_unread_marker(row)})
    after.update({rid: rec["digest"] for rid, rec in markers.items()})
    fingerprint = hashlib.sha256("\n".join(
        f"{rid}\t{digest}" for rid, digest in sorted(after.items())).encode("utf-8")).hexdigest()

    n_up, n_del = len(upserts), len(deletes)
    if mode == "reconcile":
        say(f"{PROG} reconcile: {label}{' - DRY RUN' if dry_run else ''}")
        say(f"  {'worktrees':<20} {kept:>6} kept  {n_up:>6} upserted  {n_del:>6} removed")
        for line in taken:
            say(line)
    for lane, why in sorted(held.items()):
        say(f"  lane {lane}: its rows are kept as they are - {why}")
    if dry_run:
        say(f"  total: {n_up} to upsert, {n_del} to remove - nothing written (--dry-run)")
        return 0
    # NOTHING TO WRITE ONLY WHERE THE SOURCE'S OWN ROW AGREES TOO (Copilot
    # round 1 on #171): a fingerprint changed by hand, with every row right, is
    # put right here rather than left disagreeing with the table it names.
    if old is not None and not upserts and not deletes and old.get("commit_sha") == fingerprint:
        if mode == "sync":
            say(f"{PROG} sync: {label} - the index is current; nothing to write")
        else:
            say("  total: nothing differs; nothing written")
        write_status(source, last_attempt_utc=utc_now(), last_sync_utc=utc_now(),
                     last_result="current", last_error="")
        return 0
    try:
        generation = int((old or {}).get("generation") or 0) + 1
    except (TypeError, ValueError):
        generation = 1
    store.apply(source, old, fingerprint, {"worktrees": upserts} if upserts else {},
                {"worktrees": deletes} if deletes else {}, generation=generation)
    write_status(source, last_attempt_utc=utc_now(), last_sync_utc=utc_now(),
                 last_result=f"{n_up} upserted, {n_del} removed at sync {generation}",
                 last_error="")
    if mode == "sync":
        say(f"{PROG} sync: {label} - {n_up} upserted, {n_del} removed")
    else:
        say(f"  total: {n_up} upserted, {n_del} removed")
    return 0


def is_inventory(requested: str | None) -> bool:
    return bool(requested) and (requested == "inventory" or requested.startswith(INVENTORY_PREFIX))


def _sync_once(kind: str, requested: str | None) -> int:
    if kind == "inventory":
        # A REFUSAL HERE IS ANSWERED HERE: a register sync that took the
        # inventory's mark must not lose the marks behind it to an exception.
        try:
            return _guarded(lambda: run_inventory("sync", requested, False), requested, kind)
        except Refusal as exc:
            note(f"REFUSED: {exc}")
            return 2
    return _guarded(lambda: run_index("sync", requested, False), requested, kind)


def cmd_sync(requested: str | None) -> int:
    if os.environ.get("LANES_INDEX", "") == "off":
        say(f"{PROG} sync: LANES_INDEX=off - nothing indexed")
        return 0
    kind = "inventory" if is_inventory(requested) else "register"
    # ON PRIMARY, THE REGISTER'S SYNC DOES NOTHING AND SAYS SO (T117; Y:4854),
    # before the lock: no `psql`, no lock file, no status written.
    if kind == "register" and register_primary_config() is not None:
        return sync_register_on_primary(requested)
    asked = {kind: requested}
    # A SOURCE IS REFUSED BEFORE THE LOCK IS ASKED FOR (opensoft/openRepoTools#173,
    # Copilot's fourth review of #171). Behind a held lock this sync only
    # leaves a mark of its KIND, and the holder syncs THIS workstation's source
    # for it - so `--source inventory:Raven` on Eagle, `--source inventory` in
    # a container with no name, or another register, exited 0 there instead of
    # 2. A refusal leaves through `main`; a helper that cannot answer is the
    # sync's own to say and record, as it was.
    try:
        if kind == "inventory":
            inventory_source(requested)
        elif requested:
            resolve_source(requested, workspace_root())
    except StoreUnusable:
        pass
    lock = SyncLock()
    # THE HANDSHAKE, BOTH HALVES (Codex on #164). A sync that finds the lock
    # held leaves its mark and then tries ONCE MORE: if that fails, somebody
    # holds the lock NOW, after the mark was written, and the holder looks for
    # marks after it lets go. The holder, for its part, looks again AFTER it
    # releases - a mark written between its last look and its release is
    # found there, and it takes the lock back for it. No mark is left with
    # nobody due to read it. AND THE MARK NAMES ITS SOURCE (#161): the holder
    # syncs every source a mark names, its own included, before it lets go.
    if not lock.acquire(0):
        lock.mark_rerun(kind)
        if not lock.acquire(0):
            say(f"{PROG} sync: another sync holds {lock.path}; it will sync again before "
                f"it is done")
            return 0
    rc = 0
    try:
        rounds = 0
        due = [kind]
        while True:
            for marked in lock.take_reruns():
                if marked not in due:
                    due.append(marked)
            if not due:
                lock.release()
                if not lock.has_rerun() or not lock.acquire(0):
                    return rc
                continue
            current = due[0]
            rounds += 1
            result = _sync_once(current, asked.get(current))
            if result == MOVED and rounds < 5:
                continue
            due.pop(0)
            if result == MOVED:
                say(f"{PROG} sync: origin/{branch()} kept moving through {rounds} reads; "
                    f"nothing written - the next write's nudge syncs it")
                result = 0
            # A FAILED SOURCE DOES NOT DROP THE OTHERS (Copilot round 1 on #171):
            # their marks were taken off the disk with this one's, so the loop
            # drains them all and the exit is the first failure.
            if result != 0 and rc == 0:
                rc = result
            if rounds >= 8:
                # THE CAP HANDS BACK WHAT IT DID NOT RUN (Copilot round 2 on
                # #171): a source whose mark this loop took off the disk and
                # never synced is marked again, for the next sync, exactly as a
                # mark this loop never took is left for it.
                for pending in due:
                    lock.mark_rerun(pending)
                return rc
    finally:
        lock.release()


def cmd_reconcile(requested: str | None, dry_run: bool) -> int:
    if os.environ.get("LANES_INDEX", "") == "off" and not dry_run:
        say(f"{PROG} reconcile: LANES_INDEX=off - nothing indexed")
        return 0
    kind = "inventory" if is_inventory(requested) else "register"
    # ON PRIMARY, THE REGISTER'S RECONCILE IS THE MIRROR'S READ-ONLY CHECK
    # AGAINST SQL (T117; Y:4854): no lock, and nothing written.
    if kind == "register":
        primary = register_primary_config()
        if primary is not None:
            return reconcile_register(primary, None if requested == "register" else requested,
                                      dry_run)
    lock = SyncLock()
    if not dry_run and not lock.acquire(60):
        note(f"another sync has held {lock.path} for 60 s; nothing written")
        return 1
    try:
        if kind == "inventory":
            return _guarded(lambda: run_inventory("reconcile", requested, dry_run), requested,
                            kind)
        for _attempt in range(3):
            rc = _guarded(lambda: run_index("reconcile", requested, dry_run), requested)
            if rc != MOVED:
                return rc
        note(f"origin/{branch()} kept moving through three reads; nothing written")
        return 1
    finally:
        lock.release()


#: `_guarded`'s answer for a read the source moved under: not an exit code
#: anybody sees, a signal to the two drivers above to read again.
MOVED = -1


def _guarded(act, requested, kind: str = "register") -> int:
    try:
        return act()
    except SourceMoved as exc:
        note(str(exc))
        return MOVED
    except CasLost as exc:
        note(str(exc))
        _record_error(requested, str(exc), kind)
        return 1
    except StoreUnusable as exc:
        note(f"{exc.kind}: {exc.detail} - nothing written")
        _record_error(requested, f"{exc.kind}: {exc.detail}", kind)
        return 1


def _record_error(requested, message: str, kind: str = "register") -> None:
    if kind == "inventory":
        try:
            source = inventory_source(requested)
        except (StoreUnusable, Refusal):
            source = requested if requested and requested != "inventory" else "inventory:?"
        write_status(source, last_attempt_utc=utc_now(), last_error=f"{utc_now()} {message}")
        return
    try:
        source = requested or source_of(workspace_root())
    except StoreUnusable:
        source = requested or "register:?"
    write_status(source, last_attempt_utc=utc_now(), last_error=f"{utc_now()} {message}")


def cmd_status() -> int:
    cfg = load_config()
    store = open_store(cfg, "reader")
    say(f"store: {cfg['store']} {store.where} (configuration: "
        f"{cfg['path'] if cfg['present'] else 'none - the defaults'})")
    rc = 0
    root = ""
    source = ""
    tip = ""
    root_unread = ""
    try:
        root = workspace_root()
        source = source_of(root)
        tip = tip_of(root)
    except StoreUnusable as exc:
        say(f"workspace: {exc.detail}")
        root_unread = exc.detail
        rc = 1
    provs: list = []
    try:
        store.open_read()
        provs = store.all_provenance()
        say(f"schema: {SCHEMA_VERSION}")
    except StoreUnusable as exc:
        say(f"index: {exc.kind} - {exc.detail}")
        rc = 1
    local = read_status()
    sources = [p["source"] for p in provs]
    if source and source not in sources:
        sources.append(source)
    # THIS WORKSTATION'S INVENTORY TOO (#161), indexed or not - its name is the
    # helper's, and a helper that cannot say it costs the line, not the status.
    inv_source = ""
    try:
        inv_source = inventory_source(None)
    except (StoreUnusable, Refusal):
        inv_source = ""
    if inv_source and inv_source not in sources:
        sources.append(inv_source)
    for name in sorted(set(sources) | set(local)):
        prov = next((p for p in provs if p["source"] == name), None)
        say(f"source {name}")
        if name.startswith(INVENTORY_PREFIX):
            if prov is None:
                say("  provenance:  none - this inventory is not indexed (a wiped or "
                    "never-synced index; `lanes-index reconcile --source inventory` builds it)")
            else:
                fp = prov.get("commit_sha") or ""
                say(f"  provenance:  inventory@{fp[:12]} (sync {prov.get('generation')}, indexed "
                    f"{prov['indexed_utc']}, schema {prov['schema_version']})")
                try:
                    wt_rows = store.rows("worktrees", name, ["lane"])
                    count = sum(1 for row in wt_rows if not is_unread_marker(row))
                    # A LANE'S UNREAD MARKER IS NOT A WORKTREE (#173), and is said
                    # as what it is.
                    unread = len(wt_rows) - count
                    say(f"  rows:        {count} worktree(s)" + (
                        f", and {unread} lane(s) whose inventory could not be read at the "
                        f"last sync" if unread else ""))
                except StoreUnusable as exc:
                    say(f"  rows:        unread - {exc.kind}: {exc.detail}")
                    rc = 1
        elif prov is None:
            say("  provenance:  none - this source is not indexed (a wiped or never-synced "
                "index; `lanes-index reconcile` builds it)")
        elif prov.get("commit_sha"):
            say(f"  provenance:  register@{prov['commit_sha'][:12]} (indexed "
                f"{prov['indexed_utc']}, schema {prov['schema_version']})")
        else:
            say(f"  provenance:  generation {prov.get('generation')} (indexed "
                f"{prov['indexed_utc']}, schema {prov['schema_version']})")
        if name == source and tip:
            say(f"  tip:         register@{tip[:12]} (origin/{branch()} in {root})")
            if prov is not None and prov.get("commit_sha"):
                lag = commits_between(root, prov["commit_sha"], tip)
                say(f"  lag:         {'unknown (the indexed commit is not in this checkout)' if lag is None else f'{lag} commit(s)'}")
        entry = local.get(name, {})
        say(f"  last sync:   {entry.get('last_sync_utc') or 'never, from this workstation'}"
            f"{' (' + entry['last_result'] + ')' if entry.get('last_result') else ''}")
        say(f"  last error:  {entry.get('last_error') or 'none'}")
    # THE SQL REGISTER'S BLOCK (T117; Y:4853), where it is configured, in either
    # mode: 69 where it cannot be read, over #160's own exit (Y:3528).
    if cfg["register_url"]:
        if status_register(cfg, root if tip else "", root_unread) != EXIT_OK:
            rc = EXIT_UNAVAILABLE
    return rc


def cmd_export(out_dir: str, requested: str | None, worktrees: bool = False) -> int:
    """The read flags' reader, and nothing else's: the index's image of this
    workstation's register in the shapes `lanes-edit.sh` reads from origin -
    or, with `worktrees` (#161), every inventory source's rows as the `TREE`
    lines `lanes-edit.sh worktrees` prints.

    It writes FILES into `out_dir` and prints nothing a caller parses. On
    success `meta`; on any reason the index cannot answer, `why` - one line,
    which `lanes-edit.sh` prints as `read: sources (index <why>)`."""
    if not os.path.isdir(out_dir):
        note(f"--out {out_dir} is not a directory")
        return 64

    def unusable(kind: str, detail: str) -> int:
        with open(os.path.join(out_dir, "why"), "w", encoding="utf-8") as handle:
            handle.write(f"{kind}: {detail}\n")
        return 3

    try:
        cfg = load_config()
    except Refusal as exc:
        unusable("refused", str(exc))
        return 2
    if worktrees:
        return _export_worktrees(out_dir, cfg, unusable)
    try:
        root = workspace_root()
        source = resolve_source(requested, root)
        store = open_store(cfg, "reader")
        store.open_read()
        # ONE COMMIT'S IMAGE (opensoft/openRepoTools#166 item 1): the provenance
        # and every table in one read snapshot, or a sync committing between two
        # reads writes rows of two commits under a `meta` naming the first.
        prov, (file_rows, lanes, reg_lines, aliases, log_rows) = store.read_image(source, [
            ("source_files", TABLE_COLUMNS["source_files"]),
            ("lanes", ["row_file", "row_ordinal", "row_text"]),
            ("register_lines", ["ordinal", "raw"]),
            ("lane_aliases", ["ordinal", "raw"]),
            ("log_lines", [c for c in TABLE_COLUMNS["log_lines"]
                           if c not in ("payload_fields", "raw")])])
        if prov is None or not prov.get("commit_sha"):
            return unusable("wiped", f"no provenance for {source} in the {cfg['store']} store")
        files = {r["record_id"]: r for r in file_rows}
    except Refusal as exc:
        unusable("refused", str(exc))
        return 2
    except StoreUnusable as exc:
        return unusable(exc.kind, exc.detail)

    def write(name: str, lines: list[str]) -> None:
        with open(os.path.join(out_dir, name), "w", encoding="utf-8", newline="") as handle:
            for line in lines:
                handle.write(line + "\n")

    register = [(r["row_ordinal"], r["row_text"]) for r in lanes if r["row_file"] == REGISTER_PATH]
    register += [(r["ordinal"], r["raw"]) for r in reg_lines]
    write("register", [text for _o, text in sorted(register, key=lambda x: x[0])])
    if ARCHIVE_PATH in files:
        write("archive", [r["row_text"] for r in sorted(
            (r for r in lanes if r["row_file"] == ARCHIVE_PATH), key=lambda r: r["row_ordinal"])])
    if ALIASES_PATH in files:
        write("aliases", [r["raw"] for r in sorted(aliases, key=lambda r: r["ordinal"])])
    logs = sorted((f for f in files.values() if f["kind"] == "log"), key=lambda f: f["ls_order"])
    write("logs", [f["record_id"] for f in logs])
    by_file: dict = {}
    for row in log_rows:
        by_file.setdefault(row["file"], []).append(row)
    events, warn = [], []
    for f in logs:
        bad = 0
        for row in sorted(by_file.get(f["record_id"], []), key=lambda r: r["ordinal"]):
            if row["unreadable"]:
                bad += 1
                warn.append(f"unreadable: {row['file']}:{row['ordinal']} ({row['unreadable_why']})")
                continue
            events.append(US.join([row["utc"] or "", row["lane"] or "", row["verb"] or "",
                                   row["session"] or "", row["workstation"] or "",
                                   row["object"] or "", row["ref"] or "", row["payload"] or "",
                                   row["free_text"] or "", row["file"] or "",
                                   str(row["ordinal"])]))
        if bad:
            warn.append(f"{bad} unreadable line(s) above — an append-only log is never "
                        f"rewritten, so a line no parser reads is a hold no tool will mention "
                        f"again")
    write("events", events)
    write("warn", warn)
    write("meta", [f"store={cfg['store']}", f"source={source}",
                   f"sha={prov['commit_sha']}", f"indexed_utc={prov['indexed_utc']}"])
    return 0


def _export_worktrees(out_dir: str, cfg: dict, unusable) -> int:
    """EVERY `inventory:<Workstation>` THE STORE HOLDS - this workstation's and
    any other syncing into the same Postgres, which is what the table is for:
    the next account, on either workstation, sees every open worktree in one
    read. `meta` names each source with the time it was synced."""
    try:
        store = open_store(cfg, "reader")
        store.open_read()
        provs = [p for p in store.all_provenance()
                 if str(p["source"]).startswith(INVENTORY_PREFIX)]
        if not provs:
            return unusable("wiped", f"no {INVENTORY_PREFIX}<Workstation> source in the "
                            f"{cfg['store']} store")
        lines = []
        for prov in provs:
            for row in store.rows("worktrees", prov["source"],
                                  TABLE_COLUMNS["worktrees"] + ["provenance"]):
                # A LANE'S UNREAD MARKER (#173) is written back as the `UNREAD`
                # line it was read from.
                lines.append(unread_line(row) if is_unread_marker(row)
                             else tree_line(row, row.get("provenance")))
    except Refusal as exc:
        unusable("refused", str(exc))
        return 2
    except StoreUnusable as exc:
        return unusable(exc.kind, exc.detail)
    # THE BYTE ORDER `LC_ALL=C sort` GIVES the source read, so this
    # workstation's rows are the source read's own stream wherever the index is
    # current; a shared store adds other workstations' rows among them.
    lines.sort(key=lambda line: line.encode("utf-8"))
    with open(os.path.join(out_dir, "worktrees"), "w", encoding="utf-8", newline="") as handle:
        for line in lines:
            handle.write(line + "\n")
    # AND THE LAST ERROR THIS WORKSTATION RECORDED FOR THE SOURCE (N2 of the
    # review of #289): a sync that wrote nothing - a lane listing that was not
    # whole, among others - leaves the table and its `synced` time as they
    # were, and only `status` said why. It is `status`'s `last error`, so a
    # refused `reconcile` is in it too, a `--dry-run` included (NIT-1 of review
    # r2 of #289). A fifth field, which a reader from before it ignores.
    # Another workstation's error is in its own record and not here, so a
    # shared store's other sources never carry one.
    recorded = read_status()
    with open(os.path.join(out_dir, "meta"), "w", encoding="utf-8", newline="") as handle:
        handle.write(f"store={cfg['store']}\n")
        for prov in sorted(provs, key=lambda p: str(p["source"])):
            entry = recorded.get(prov["source"])
            error = entry.get("last_error") if isinstance(entry, dict) else ""
            error = " ".join(str(error or "").split())
            handle.write(f"inventory\t{prov['source']}\t{prov['indexed_utc']}\t"
                         f"{prov.get('generation')}" + (f"\t{error}" if error else "") + "\n")
    return 0


# ================================================== the import (feature 007, T115)
#
# `LANES-INDEX IMPORT --AT <C>` (operations.md §2.2's act 4, step 6, and act 3's
# step 8; §2.3's disaster path; design.md S5's "Import", D22, D24 and §1.3's
# kinds table; FR-049, FR-052, FR-053; L1-A13). The operator lane runs it with
# `LANES_LANE=` its name, through its own checkout (D24, Y:653; F12):
# `LANES_REPO` where the operator names one, as `lanes-edit.sh` honours it,
# else `lanes-edit.sh lane-checkout <lane>`'s `<W>-lanes/<lane>/`, and never
# `W`: a `LANES_REPO` that is `W` is refused (2), and so is one set where `W`
# cannot be read to tell (a read that failed is never an answer; Amendment
# 7(d); #165 6781033556), with that read's error named. It takes origin only
# (Q4(c)(i)): after a fetch (`LANES_NO_FETCH=1` skips it), `C` must be on
# `origin/<branch>`, and only `C`'s objects are read, never a working tree or
# a local commit.
#
# ITS FOUR STEPS. None holds a transaction across a git act (F23): each
# database call is one request, and git runs only between them.
#   1. THE READ, one REPEATABLE READ request under D9's import row (Y:3530):
#      the version window, the switch, which must read `files` with the marker
#      `absent`, the head, the journal's shape and the database's clock.
#   2. THE ENTRY. `C`'s render set, read strictly from origin's objects, and
#      refused where a file cannot be held: not UTF-8, a CR (a line ending the
#      renderer cannot reproduce) or a NUL. Then the import's one `commit_write`
#      entry, derived through T112's helpers and nothing else (ERR-49): every
#      line a `create` or an `append`; `files` with `C`'s digests; `lanes` by
#      `_register_lane_row`; `log_lines` by `_register_log_row`, so the `WORD`
#      lines stay verbatim and flagged (Q4(d)(i)); `register_lines` by
#      `register_slot_rows`, the walk run ONCE over `lanes/LANES.md` in line
#      order (ERR-53); `object_holds` by `_register_last_hold`; `repo_key` in
#      Rule 6's order; a NULL workstation fallback; `owner` sent NULL. A live
#      claim pair already at `C` is marked `exempt` (§1.2). Under
#      `--after-loss` the entry's `root_seq` is `M`'s newest `Register-Seq`,
#      `m` (D22; ops §2.3).
#   3. THE STAGING SCHEMA AND THE PROOF. REGISTER-WRITER can make no schema and
#      no temporary table: the role block revokes ALL on the database from
#      PUBLIC, and grants the writer CONNECT, USAGE, SELECT and EXECUTE on six
#      functions (design §1.4). So the staged tables are the register schema's
#      own, inside ONE SERIALIZABLE transaction that its own request rolls
#      back: `commit_write` loads the entry there, LR010's key check included
#      (lane 3's ruling, #165 6711924759), the same request reads the staged
#      rows, and ROLLBACK ends it. Nobody else ever sees them. The proof, R3's
#      three parts, outside any transaction (`import_proof`):
#        - a blob id per path: T301's scratch render (`register_images` over
#          the staged journal rows, written by `register_write_images`) is
#          hashed by `git hash-object`, never `-w`, and each id, and the set of
#          paths, must equal `C`'s render set's; and `render_file`'s digest of
#          every staged path equals `C`'s;
#        - the counts: each staged table's count equals the rows the entry sent,
#          and the count the files give: `files`, `doc_lines`, #160's
#          `build_records`' `log_lines` (its unreadable ones too) and
#          `register_lines`, and the lanes `row_name` finds a row for;
#        - the same answers for every lane from the files and from SQL. A
#          reader on primary runs today's parser on SQL's images (D17), which
#          the first part proves byte-identical, so its answers are the files'.
#          The structured rows each lane's reads and rules rest on are compared
#          with #160's: every lane's `lanes` row with `build_records`' record,
#          and the `holds` view with #160's `holds` rule over `build_records`'
#          `log_lines`. #160 reads only `LANES-retired.md` of the archive, so
#          a lane whose row is in another archive file is not compared; the
#          summary line counts those (`import_uncompared`; lane 3's ruling,
#          #165 6781033556).
#      Any difference refuses with `EXIT_IMPORT_REFUSED`, 2, naming the first
#      differing path, and nothing is swapped in. `--dry-run`, the rehearsal's
#      (ops act 3, step 8), ends here.
#   4. THE SWAP: the same entry, under the same write id, in one short
#      transaction, the commit call's form (contract §2.3), with nothing but
#      the call inside it. `commit_write`'s step 8 proves every file again
#      against the digests the proof checked, so it commits only the bytes the
#      proof saw. A re-import before a confirmed cutover replaces seq 0 (or the
#      after-loss root `m`); after a rollback it continues at the next seq
#      (§1.3). The switch stays `files` (D24).
# A scratch schema, `register_schema=`, serves the rehearsal: the import
# reads and writes only the schema the configuration names.
#
# ITS ENDS (contracts/exit-codes.md §3.2, §4): 0 proven and swapped in, or
# proven under `--dry-run`; 2 (`EXIT_IMPORT_REFUSED`, T102's code) for a
# failed proof, LR010, a source that is not origin, a switch not at `files`,
# a file it cannot hold, a refused configuration (Q6(c) included) and each of
# its own refusals, with nothing swapped in; 69 for a database that cannot be
# reached or refuses, or a 330 s timer that expires; 64 for usage.

#: PC-10'S CODE FOR THE IMPORT'S REFUSAL (contracts/exit-codes.md §1 and §4;
#: T102): 2, with nothing swapped in.
EXIT_IMPORT_REFUSED = 2

#: THE ONE READ before the staged load, in one REPEATABLE READ snapshot, as
#: REGISTER-WRITER under D9's import row: the version window, the switch, the
#: head, the journal's size, its chained entries and its root's seq, and the
#: database's clock, for `not_after` (F3).
_IMPORT_READS = (
    "SELECT version, writers_from, readers_from FROM schema_version WHERE id = 1",
    "SELECT mode, marker_state, generation, database_label, set_seq FROM register_switch "
    "WHERE id = 1",
    "SELECT seq FROM register_head WHERE id = 1",
    "SELECT count(*), count(*) FILTER (WHERE base_seq IS NOT NULL), "
    "min(seq) FILTER (WHERE base_seq IS NULL) FROM journal",
    "SELECT extract(epoch FROM clock_timestamp())",
)

#: The staged reads after T301's five (`register_render_queries`), in the
#: staging request's order: `render_file`'s digests, the counts, the lanes,
#: the holds, the open slots, and the database's clock, for the swap's
#: `not_after`.
_IMPORT_STAGED_READS = (
    "SELECT path, encode(sha256(render_file(path)), 'hex') FROM files ORDER BY path",
    "SELECT (SELECT count(*) FROM files), (SELECT count(*) FROM doc_lines), "
    "(SELECT count(*) FROM lanes), (SELECT count(*) FROM log_lines), "
    "(SELECT count(*) FROM log_lines WHERE unreadable), (SELECT count(*) FROM register_lines), "
    "(SELECT count(*) FROM register_lines WHERE slot_role IS NOT NULL), "
    "(SELECT count(*) FROM object_holds), (SELECT count(*) FROM object_holds WHERE exempt)",
    "SELECT l.lane_key, l.lane, l.aliases::text, l.home, l.workstation, l.started_utc, "
    "l.handoff_path, l.state_phrase, l.objects_cell, l.session_ids::text, l.last_session, "
    "l.archived, d.path FROM lanes l LEFT JOIN doc_lines d ON d.line_id = l.row_line_id "
    "ORDER BY l.lane_key",
    "SELECT object, lane_key, verb, file, ordinal FROM holds ORDER BY object, lane_key",
    "SELECT slot_kind, count(*) FROM main_slots GROUP BY slot_kind ORDER BY slot_kind",
    "SELECT extract(epoch FROM clock_timestamp())",
)

#: The `lanes` fields part 3 compares with #160's `build_records`, in the
#: staged read's column order after `lane_key`.
_IMPORT_LANE_FIELDS = ("lane", "aliases", "home", "workstation", "started_utc", "handoff_path",
                       "state_phrase", "objects_cell", "session_ids", "last_session",
                       "archived")

#: The counts `_IMPORT_STAGED_READS`' second read gives, in its order.
_IMPORT_COUNTS = ("files", "doc_lines", "lanes", "log_lines", "unreadable", "register_lines",
                  "slots", "object_holds", "exempt")

#: How many differences a refusal lists after the first.
_IMPORT_SHOWN = 20

_IMPORT_USAGE = f"""\
{PROG} import --at <C>               load the register's files at C, prove, then swap in
{PROG} import --at <C> --dry-run     the same load and proof, and nothing swapped in
{PROG} import --at <M> --after-loss  after a loss: the baseline is M's Register-Seq

Loads the SQL register from the workspace repository's files at commit C, as
origin holds them (operations.md §2.2, act 4's step 6), into a staged
transaction it rolls back; proves the staged register renders C's render set
byte for byte, with the same counts and the same answers for every lane (R3's
three-part proof); and only then swaps the same entry in, in one short
transaction. The switch stays files. Run it as the operator lane, with
LANES_LANE=<lane>, from that lane's checkout: LANES_REPO, else the one
`lanes-edit.sh lane-checkout <lane>` names, never W. It fetches origin first
unless LANES_NO_FETCH=1. A scratch register_schema= serves the rehearsal.

  --at <C>       the commit, its full sha, on origin/<branch>
  --dry-run      the rehearsal: everything but the swap
  --after-loss   the disaster path's re-import, after the replacement's
                 bootstrap: the journal's root is M's newest Register-Seq (D22)

Exit: 0 proven and swapped in (or proven, with --dry-run) · 2 refused, nothing
swapped in · 64 usage · 69 the register cannot be reached or refused, or the
call's timer expired."""


class _ImportUsage(Exception):
    """An `import` command line that is not its usage: 64, before anything is
    read."""


class _ImportEnd(Exception):
    """An end of `import` but 0 that is not a refusal of its own: its code,
    its own line, and psql's lines, which go first, verbatim (register-cli
    §2.6)."""

    def __init__(self, code: int, message: str, psql_lines: tuple = (), notes: tuple = ()):
        super().__init__(message)
        self.code = code
        self.psql_lines = psql_lines
        self.notes = notes


def _import_args(args: list[str]) -> dict | None:
    """The import's flags; None for `--help`. `--at` takes the commit's full
    sha, 40 hex digits, read in lower case. `--dry-run` and `--after-loss`
    each stand alone (USAGE: `[--dry-run | --after-loss]`)."""
    opts: dict = {"at": None, "dry_run": False, "after_loss": False}
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-h", "--help"):
            return None
        name, eq, value = arg.partition("=")
        if name == "--at":
            if not eq:
                value = args[i + 1] if i + 1 < len(args) else ""
                i += 1
            if opts["at"] is not None:
                raise _ImportUsage("import: --at is given twice")
            if not re.fullmatch(r"[0-9A-Fa-f]{40}", value):
                raise _ImportUsage("import: --at takes the commit's full sha, 40 hex digits")
            opts["at"] = value.lower()
        elif arg in ("--dry-run", "--after-loss"):
            key = arg[2:].replace("-", "_")
            if opts[key]:
                raise _ImportUsage(f"import: {arg} is given twice")
            opts[key] = True
        else:
            raise _ImportUsage(f"import: unknown argument '{arg}'")
        i += 1
    if opts["at"] is None:
        raise _ImportUsage("import needs --at <C>")
    if opts["dry_run"] and opts["after_loss"]:
        raise _ImportUsage("import: --dry-run and --after-loss are each a form of their own")
    return opts


def cmd_import(args: list[str]) -> int:
    """`lanes-index import` (above): its exits, by the contract's constants."""
    try:
        opts = _import_args(args)
    except _ImportUsage as exc:
        note(f"{exc} - see {PROG} import --help")
        return EXIT_USAGE
    if opts is None:
        say(_IMPORT_USAGE)
        return EXIT_OK
    try:
        return _import(opts)
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return EXIT_IMPORT_REFUSED
    except _ImportEnd as exc:
        for line in exc.psql_lines:
            sys.stderr.write(line + "\n")
        note(str(exc))
        for text in exc.notes:
            note(text)
        return exc.code
    except StoreUnusable as exc:
        note(f"import: {exc.kind}: {exc.detail}; nothing was swapped in")
        return EXIT_UNAVAILABLE


def _import(opts: dict) -> int:
    commit, after_loss, dry_run = opts["at"], opts["after_loss"], opts["dry_run"]
    timing: dict = {}

    def lap(name: str, since: float) -> float:
        now = time.monotonic()
        timing[name] = now - since
        return now

    t0 = time.monotonic()
    # BEFORE ANYTHING CONNECTS: the configuration, whose writer it is, and
    # where it reads (F12; Rule 10; D24).
    cfg = load_config()
    lane = _import_lane()
    workstation = _import_workstation()
    root = _import_checkout(lane)
    author = _import_author(root)
    store = PostgresStore(cfg, "register_writer")
    shipped = register_shipped_repos_text()
    t = lap("setup", t0)

    # 1. THE READ.
    st = _import_read(store)
    read_at = time.monotonic()
    t = lap("read", t)
    if (st["mode"], st["marker"]) != ("files", "absent"):
        raise Refusal(f"import: the switch reads {st['mode']} with the marker {st['marker']}, "
                      f"and an import runs only at files with the marker absent (§1.3's kinds "
                      f"table): after a cutover, the rollback comes first; nothing was "
                      f"swapped in")

    # 2. THE ENTRY: origin's objects alone, then T112's derivation.
    source = _import_source(root, commit, fetch=os.environ.get("LANES_NO_FETCH") != "1")
    m = _import_after_loss_seq(root, commit) if after_loss else None
    if st["chained"]:
        if after_loss:
            raise Refusal(f"import: --after-loss loads a replacement whose journal holds at "
                          f"most an import's root, and this one holds {st['entries']} entries, "
                          f"chained to seq {st['head']}: it is not the re-import route's "
                          f"fresh database (D22; ops §2.3); nothing was swapped in")
        base, seq = st["head"], st["head"] + 1
    else:
        if not after_loss and st["root"] not in (None, 0):
            raise Refusal(f"import: the journal's root is an after-loss import at seq "
                          f"{st['root']}, and a plain re-import would take seq 0, under the "
                          f"Register-Seq that main already carries: re-import with --after-loss "
                          f"(D22); nothing was swapped in")
        base, seq = st["head"], (m if after_loss else 0)
    try:
        records = build_records(read_snapshot(root, commit))
    except StoreUnusable as exc:
        raise Refusal(f"import: {commit[:12]}'s files cannot be read as #160's parser reads "
                      f"them ({exc.detail}); nothing was swapped in")
    t = lap("source", t)
    timer = store.bounds("import")[1]
    entry = import_entry(source, root=root, lane=lane, workstation=workstation, author=author,
                         shipped_repos=shipped, root_seq=m,
                         not_after=_import_not_after(st["clock"], read_at, timer))
    t = lap("derive", t)
    for warning in source["warnings"]:
        sys.stderr.write(warning + "\n")

    # 3. THE STAGING SCHEMA AND THE PROOF.
    from uuid import uuid4
    write_id = str(uuid4())
    staged = _import_stage(store, base, st["generation"], write_id, entry, seq)
    staged_at = time.monotonic()
    t = lap("staged load with LR010's key check", t)
    differences = import_proof(source, staged, entry, records, root)
    t = lap("proof", t)
    if differences:
        first_path, first_why = differences[0]
        more = [f"import: also {path or 'the counts'}: {why}"
                for path, why in differences[1:1 + _IMPORT_SHOWN]]
        if len(differences) > 1 + _IMPORT_SHOWN:
            more.append(f"import: and {len(differences) - 1 - _IMPORT_SHOWN} more")
        raise _ImportEnd(EXIT_IMPORT_REFUSED, f"REFUSED: import: the proof failed at "
                         f"{first_path or 'the counts'}: {first_why}; R3's three-part proof "
                         f"did not hold, so nothing was swapped in (S5)", notes=tuple(more))
    counts = staged["counts"]
    uncompared = import_uncompared(staged, records)
    summary = (f"{len(source['render'])} paths, {counts['doc_lines']} lines, "
               f"{counts['lanes']} lanes ({uncompared} uncompared in part 3"
               + (": their row is in an archive file other than LANES-retired.md, which #160 "
                  "does not read" if uncompared else "")
               + f"), {counts['log_lines']} log lines "
               f"({counts['unreadable']} unreadable, kept verbatim and flagged), "
               f"{counts['register_lines']} register lines ({counts['slots']} with a slot), "
               f"{counts['object_holds']} holds ({counts['exempt']} exempt); "
               f"main_slots open: " + (", ".join(f"{kind} {n}" for kind, n in staged["open"])
                                       or "none"))
    if dry_run:
        say(f"import: dry run: the proof holds at seq {seq}, {commit} (lanes tree "
            f"{source['tree']}): {summary}; nothing was swapped in")
        _import_timing(timing)
        return EXIT_OK

    # 4. THE SWAP.
    entry["not_after"] = _import_not_after(staged["clock"], staged_at, timer)
    got = _import_swap(store, base, st["generation"], write_id, entry)
    lap("swap", t)
    if got != seq:
        raise _ImportEnd(EXIT_UNAVAILABLE, f"import: the swap committed at seq {got}, and the "
                         f"staged load proved seq {seq}: the head moved between them; rerun the "
                         f"import, which replaces it")
    say(f"import: seq {seq} swapped in, {'the after-loss baseline, ' if after_loss else ''}"
        f"{commit} (lanes tree {source['tree']}): {summary}; the switch stays files, and the "
        f"cutover follows on Brett's word")
    _import_timing(timing)
    return EXIT_OK


def _import_timing(timing: dict) -> None:
    """THE IMPORT'S TIME, by step (lane 3's ruling, #165 6711924759: the key
    check's cost is the import's, and the rehearsal measures it): the staged
    load carries LR010's key check inside its `commit_write`, and the swap
    carries it again. REGISTER-WRITER cannot call the check alone."""
    say("import: timing: " + ", ".join(f"{name} {secs * 1000:.0f} ms"
                                       for name, secs in timing.items()))


def _import_not_after(clock: float, read_at: float, timer: float) -> str:
    """`not_after` (F3) for a call starting now: the database's clock as last
    read, plus the seconds since on this host's monotonic clock, plus the
    call's client timer and 2 s (D9's import row; lane 1's v2.6)."""
    now = clock + (time.monotonic() - read_at)
    return _dt.datetime.fromtimestamp(now + timer + 2, _dt.timezone.utc).isoformat()


def _import_lane(*, who: str = "import", nothing: str = "nothing was swapped in") -> str:
    """The operator lane, `LANES_LANE` (F12; Amendment 23's S2, "no lane, no
    write"): the entry's `lane`. Unset, or not a lane's name, is refused (2).
    `who` and `nothing` open and close each refusal: the import's own, or
    S2's two ways out's (T324), which take the operator lane as it does."""
    lane = os.environ.get("LANES_LANE", "").strip()
    if not lane:
        raise Refusal(f"{who}: LANES_LANE is not set: the {who} writes for the operator lane, "
                      f"so it runs with LANES_LANE=<operator lane>, through that lane's checkout "
                      f"(D24; Amendment 23's S2, \"no lane, no write\"); {nothing}")
    if re.search(r"[\s<>@]", lane) or any(ord(ch) < 0x20 or ord(ch) == 0x7F for ch in lane):
        raise Refusal(f"{who}: LANES_LANE is not a lane's name: it holds a space, a control "
                      f"character, '<', '>' or '@'; {nothing}")
    return lane


def _import_workstation(*, who: str = "import", nothing: str = "nothing was swapped in") -> str:
    """This workstation's name (Rule 10), the entry's `workstation`, as the
    cutover reads it: `$LANES_WORKSTATION`, else `lanes-edit.sh workstation`.
    A container with no name, or a name that cannot be read, is refused (2).
    `who` and `nothing` are `_import_lane`'s."""
    name = os.environ.get("LANES_WORKSTATION", "")
    if not name:
        try:
            name, how = this_workstation()
        except StoreUnusable as exc:
            raise Refusal(f"{who}: this workstation's name cannot be read ({exc.detail}); "
                          f"{nothing}")
        if how == "container-unset":
            raise Refusal(f"{who}: this is a container and LANES_WORKSTATION is not set, so the "
                          f"{who}'s entry would be stamped with the container's own id "
                          f"(Amendment 11, R-A11-14); {nothing}")
    if not name.strip() or any(ord(ch) < 0x20 or ord(ch) == 0x7F for ch in name):
        raise Refusal(f"{who}: this workstation's name is empty or holds a control character; "
                      f"{nothing}")
    return name


def _import_checkout(lane: str, *, who: str = "import",
                     nothing: str = "nothing was swapped in") -> str:
    """THE OPERATOR LANE'S CHECKOUT (D24, Y:653): `LANES_REPO` where it is set,
    the operator's override that `lanes-edit.sh` honours too, else the
    checkout `lanes-edit.sh lane-checkout <lane>` names, `<W>-lanes/<lane>/`.
    Returns its top directory. Never `W`: a `LANES_REPO` that is `W` is
    refused (2); so is a `LANES_REPO` set where `W` cannot be read, since a
    read that failed is never an answer (Amendment 7(d); lane 3's ruling,
    opensoft/openRepoTools#165 6781033556): the refusal names that read's
    error. So is a directory that is not a git checkout, or a lane with no
    checkout of its own. With `LANES_REPO` unset the import makes no `W` read
    at all: the checkout is `lanes-edit.sh lane-checkout <lane>`'s
    `<W>-lanes/<lane>/`, which that helper derives from `W` and which is
    never `W`, and a `W` that cannot be read refuses there as a lane with no
    checkout of its own. `who` and `nothing` are `_import_lane`'s."""
    named = os.environ.get("LANES_REPO", "")
    if named:
        where = named
    else:
        try:
            proc = _helper_run(["lane-checkout", lane], 60, f"lane {lane}'s checkout")
        except StoreUnusable as exc:
            raise Refusal(f"{who}: lane {lane}'s checkout cannot be found ({exc.detail}); "
                          f"{nothing}")
        where = proc.stdout.strip()
        if proc.returncode != 0 or not where:
            why = (proc.stderr.strip().splitlines() or ["no answer"])[0].strip()
            raise Refusal(f"{who}: lane {lane} has no checkout of its own (`lanes-edit.sh "
                          f"lane-checkout {lane}` exited {proc.returncode}: {why}). Make it "
                          f"with `lanes-edit.sh lane-checkout {lane} --create`, or name one with "
                          f"LANES_REPO; the {who} never reads W (D24); {nothing}")
    top = git(where, "rev-parse", "--show-toplevel", check=False)
    root = top.stdout.strip()
    if top.returncode != 0 or not root:
        raise Refusal(f"{who}: {where} is not a git checkout, so origin's objects cannot be "
                      f"read through it; {nothing}")
    if named:
        try:
            w = workspace_root()
        except (StoreUnusable, OSError) as exc:
            # A read that failed is never an answer (Amendment 7(d)): "W could
            # not be read" is not "LANES_REPO is not W", so it is refused (2).
            why = exc.detail if isinstance(exc, StoreUnusable) else str(exc)
            raise Refusal(f"{who}: LANES_REPO is set, and W cannot be read to check that it "
                          f"is not W itself ({why}); a read that failed is not an answer "
                          f"(Amendment 7(d)), so the {who} reads nothing through {root}; "
                          f"{nothing}")
        if os.path.realpath(w) == os.path.realpath(root):
            raise Refusal(f"{who}: LANES_REPO names W itself ({root}); the {who} reads "
                          f"origin through the operator lane's own checkout, never W (D24); "
                          f"{nothing}")
    return root


def _import_author(root: str, *, who: str = "import",
                   nothing: str = "nothing was swapped in") -> str:
    """The entry's `author`, `Name <email>`: the identity git would record for
    a commit in the operator lane's checkout, `git var GIT_AUTHOR_IDENT`, less
    its date, as the cutover takes its own. Where git names none, it is
    refused (2), since the journal holds no entry without one. `who` and
    `nothing` are `_import_lane`'s."""
    try:
        proc = subprocess.run(["git", "-C", root, "var", "GIT_AUTHOR_IDENT"],
                              capture_output=True, encoding="utf-8", errors="replace",
                              check=False, stdin=subprocess.DEVNULL, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise Refusal(f"{who}: git could not name the {who}'s author ({exc}); {nothing}")
    match = re.fullmatch(r"([^<>\n]+ <[^<>\n]*>) [0-9]+ [+-][0-9]{4}", proc.stdout.strip())
    if proc.returncode != 0 or not match:
        raise Refusal(f"{who}: git names no author in {root}: set user.name and user.email "
                      f"there; {nothing}")
    return match.group(1)


def _import_source(root: str, commit: str, *, fetch: bool, who: str = "import",
                   nothing: str = "nothing was swapped in") -> dict:
    """`import_source` with every git failure a refusal (2): a fetch that
    fails, or objects that cannot be read, leave origin's `C` unproven.
    `who` and `nothing` are `_import_lane`'s: the import's own, or
    `import --single`'s (T324), whose `nothing` names its way out."""
    try:
        return import_source(root, commit, fetch=fetch, who=who, nothing=nothing)
    except StoreUnusable as exc:
        raise Refusal(f"{who}: origin's {commit[:12]} cannot be read through {root} "
                      f"({exc.detail}); {nothing}")


def _import_git_why(proc) -> str:
    """git's failure as a refusal names it: `exited <code>: <its first line on
    stderr>` (`no message` where it said nothing), with any URL's user and
    password taken out, as `_mirror_git_error` does."""
    err = proc.stderr if isinstance(proc.stderr, str) else proc.stderr.decode("utf-8", "replace")
    lines = [line.strip() for line in err.splitlines() if line.strip()]
    first = re.sub(r"(://)[^/\s@]*@", r"\1", lines[0]) if lines else "no message"
    return f"exited {proc.returncode}: {first}"


def import_source(root: str, commit: str, *, fetch: bool, who: str = "import",
                  nothing: str = "nothing was swapped in") -> dict:
    """ORIGIN'S `C`, AND NOTHING ELSE (Q4(c)(i); S5): the render set at
    `commit` as the checkout `root` holds origin's objects.

    With `fetch`, `git fetch origin <branch>` first (`mirror_fetch`, bounded
    by `LANES_GIT_TIMEOUT`). `commit` must then be a commit there that
    `origin/<branch>` contains, else `Refusal`: a local or unpushed commit is
    no source, and a `git merge-base --is-ancestor` that fails to answer (an
    exit other than 0 and 1, or a 1 with a line on stderr) is refused naming
    git's exit and its first line on stderr, never read as "not on origin".
    The repository must be a sha1 one, whose ids the journal's CHECKs take.

    Each render-set path's bytes must be a file the register can hold, else
    `Refusal` naming the path, and its line where there is one: UTF-8, read
    strictly; no CR, since a line holds none (`doc_lines`' CHECK) and the
    renderer ends each line with LF alone; no NUL; and a path with no control
    character and no U+0085, U+2028 or U+2029 (`_RENDER_CONTROL_RE`), since no
    image can be written for one.

    Returns `commit`; `tree`, `C:lanes`'s id; `blobs`, `{path: blob id}` of
    the render set and `lanes/repos.tsv`; `render`, the render set's paths
    sorted bytewise; `data` and `texts`, each path's bytes and text; `lines`,
    each path's `(lines, final_newline)` by `register_doc_lines`; and
    `warnings`, `parse_log`'s `unreadable:` lines for the logs (Q4(d)(i)'s
    warning). `who` and `nothing` open and close each refusal, as
    `_import_source` passes them."""
    if fetch:
        mirror_fetch(root, mirror_git_timeout())
    if not has_commit(root, commit):
        raise Refusal(f"{who}: {commit} is not a commit that {root} holds, so it is not "
                      f"origin's (Q4(c)(i)): fetch, or name origin/{branch()}'s; {nothing}")
    tip = tip_of(root)
    # `git merge-base --is-ancestor`: 0 an ancestor, and 1 with nothing on
    # stderr not one. Any other exit, or a 1 that says something (git 2.43
    # answers 1 with `error: Could not read <id>` for an object it cannot
    # open), is git failing to answer, which is not "not an ancestor" (the nit
    # of lane 3's ruling, #165 6781033556): the refusal names git's exit and
    # its first line on stderr.
    ancestry = git(root, "merge-base", "--is-ancestor", commit, tip, check=False)
    if ancestry.returncode != 0 and (ancestry.returncode != 1 or ancestry.stderr.strip()):
        raise Refusal(f"{who}: git could not tell whether {commit} is on origin/{branch()} "
                      f"(its tip is {tip}): `git merge-base --is-ancestor` {_import_git_why(ancestry)}"
                      f"; {nothing}")
    if ancestry.returncode != 0:
        raise Refusal(f"{who}: {commit} is not on origin/{branch()} (its tip is {tip}): the "
                      f"{who} takes origin's commits only, never a local one (Q4(c)(i)); "
                      f"{nothing}")
    tree = git(root, "rev-parse", "--verify", "-q", f"{commit}:lanes", check=False).stdout.strip()
    if not SHA_RE.match(tree):
        raise Refusal(f"{who}: {commit} has no lanes tree, or it is not a sha1 id; "
                      f"{nothing}")
    blobs: dict = {}
    proc = git(root, "ls-tree", "-r", "-z", commit, "--", LANES_DIR)
    for item in proc.stdout.split("\0"):
        if not item:
            continue
        meta, _, path = item.partition("\t")
        _mode, kind, obj = meta.split()
        if kind == "blob" and (register_render_path(path) or path == REGISTER_REPOS_PATH):
            blobs[path] = obj
    render = sorted((p for p in blobs if register_render_path(p)), key=lambda p: p.encode("utf-8"))
    if REGISTER_PATH not in blobs:
        raise Refusal(f"{who}: {commit} carries no {REGISTER_PATH}; {nothing}")
    if REGISTER_REPOS_PATH in blobs and not SHA_RE.match(blobs[REGISTER_REPOS_PATH]):
        raise Refusal(f"{who}: {REGISTER_REPOS_PATH}'s id at {commit[:12]} is not a sha1 id; "
                      f"{nothing}")
    contents = cat_blobs(root, [blobs[p] for p in render])
    data, texts, lines, warnings = {}, {}, {}, []
    for path in render:
        if _RENDER_CONTROL_RE.search(path):
            raise Refusal(f"{who}: {path!r} holds a control character or a line separator in "
                          f"its name, so no image can be written for it; {nothing}")
        raw = contents.get(blobs[path])
        if raw is None:
            raise Refusal(f"{who}: {path}'s blob {blobs[path]} cannot be read in {root}; "
                          f"{nothing}")
        try:
            text = raw.decode("utf-8")
        except UnicodeDecodeError as exc:
            raise Refusal(f"{who}: {path} is not UTF-8 at byte {exc.start}, so the register "
                          f"cannot hold it byte for byte; {nothing}")
        for char, what in (("\r", "a carriage return (CR): a line ending the renderer cannot "
                                  "reproduce, since it ends each line with LF alone"),
                           ("\x00", "a NUL, which a line cannot hold")):
            at = text.find(char)
            if at >= 0:
                raise Refusal(f"{who}: {path} line {text.count(chr(10), 0, at) + 1} holds "
                              f"{what}; {nothing}")
        data[path], texts[path] = raw, text
        lines[path] = register_doc_lines(text)
        if path.startswith(LOG_PREFIX):
            warnings += parse_log(path, text)[1]
    return {"commit": commit, "tree": tree, "blobs": blobs, "render": render, "data": data,
            "texts": texts, "lines": lines, "warnings": warnings}


def _import_after_loss_seq(root: str, commit: str) -> int:
    """`m` for `--after-loss` (D22; ops §2.3): the newest `Register-Seq` on
    `M`'s first-parent line, `M` the commit imported, read by
    `mirror_register_seq` from `M`, with no skip set, since the journal that
    named the resolved strays is lost. None found is refused (2): a register
    never cut over has no mirror seq to continue from."""
    timeout = mirror_git_timeout()
    try:
        m, _carrier = mirror_register_seq(
            root, None if timeout is None else time.monotonic() + timeout, tip=commit)
    except StoreUnusable as exc:
        raise Refusal(f"import: --after-loss takes {commit[:12]}'s newest Register-Seq as its "
                      f"baseline (D22), and it cannot be read ({exc.detail}); nothing was "
                      f"swapped in")
    return m


def register_import_exempt(holds: list) -> int:
    """`object_holds.exempt` for an import (§1.2: "set only by an import, on a
    pair already at C"): each live claim on an object that more than one lane
    holds live at `C` is marked exempt, so `one_live_claim` does not refuse
    the history it was not there to see, while a later claim over any live
    imported claim is still caught. A claim is live, as `one_live_claim`
    reads it, where its verb is CLAIMED or TAKEOVER and no other lane's last
    line on the object is a TAKEOVER (`superseded_by`). `holds` are
    `_register_last_hold`'s rows, changed in place. Returns how many it
    marked."""
    by_object: dict = {}
    for row in holds:
        by_object.setdefault(row["object"], []).append(row)
    marked = 0
    for rows in by_object.values():
        live = [row for row in rows if row["verb"] in _REGISTER_CLAIM_VERBS
                and not any(other["lane_key"] != row["lane_key"] and other["verb"] == "TAKEOVER"
                            for other in rows)]
        if len(live) > 1:
            for row in live:
                row["exempt"] = True
                marked += 1
    return marked


def import_entry(source: dict, *, root: str, lane: str, workstation: str, author: str,
                 not_after: str, shipped_repos: str | None, root_seq: int | None = None) -> dict:
    """THE IMPORT'S ENTRY, as `commit_write` takes it (its head comment;
    §1.3's kinds table, `import`), derived from `import_source`'s answer
    through T112's helpers and nothing else (lane 3's reading 7, #165
    6755386771; ERR-49):

    - `journal`: kind and verb `import`, the operator `lane`, this
      `workstation`, `author`, the message, `git_commit` `C`, `git_tree` the
      id of `C:lanes`, and `repos_blob` `C`'s `lanes/repos.tsv`'s id;
    - `root_seq`, under `--after-loss` only: `m` (D22);
    - `not_after` (F3);
    - `edits`: per render-set path, bytewise, a `create` and one `append` per
      line, so the journal alone renders any seq from the import on;
    - `files`: each path present, with the sha256 of `C`'s bytes and its
      `final_newline`;
    - `lanes`: `_register_lane_row` of every lane a row in `lanes/LANES.md`
      or `lanes/archive/` names, with `owner` NULL;
    - `log_lines`: `_register_log_row` of every log line, the unreadable
      ones kept and flagged (Q4(d)(i));
    - `register_lines`: `register_slot_rows`, the walk, run ONCE over
      `lanes/LANES.md` in line order with a NULL workstation fallback
      (ERR-53; Y:1273);
    - `object_holds`: `_register_last_hold` of every (object, lane) a
      readable log line names, never a `lane:` object, `repo_key` and D19's
      spellings over Rule 6's table, the shipped `repos.tsv` and then `C`'s;
      and `register_import_exempt`'s marks.
    It carries no delete: the import clears every data table first (§1.3)."""
    att = {"tree": root, "tree_blobs": dict(source["blobs"]), "changes": {}, "renames": {},
           "images": {}}
    view = RegisterView(att, {})
    table = register_repo_table(shipped_repos, view.before(REGISTER_REPOS_PATH))
    edits: list = []
    files: list = []
    log_rows: list = []
    pairs: dict = {}
    keys: set = set()
    for path in source["render"]:
        lines, final_newline = source["lines"][path]
        edits.append({"ord": len(edits) + 1, "op": "create", "path": path, "line_no": None,
                      "old_sha256": None, "new_text": None, "to_path": None})
        for line_no, text in enumerate(lines, 1):
            edits.append({"ord": len(edits) + 1, "op": "append", "path": path,
                          "line_no": line_no, "old_sha256": None, "new_text": text,
                          "to_path": None})
        files.append({"path": path, "present": True,
                      "sha256": hashlib.sha256(source["data"][path]).hexdigest(),
                      "final_newline": final_newline})
        if path == REGISTER_PATH or path.startswith(REGISTER_ARCHIVE_PREFIX):
            keys.update(_register_lower(name) for name in map(row_name, lines) if name)
        if path.startswith(LOG_PREFIX) and path != REGISTER_LOG_README:
            for line_no, text in enumerate(lines, 1):
                row = _register_log_row(path, line_no, text)
                if row is None:
                    continue
                log_rows.append(row)
                if not row["unreadable"] and register_hold_object(row["object"]):
                    pairs[(row["object"], _register_lower(file_lane(path)))] = None
    slot_rows = list(register_slot_rows(source["lines"][REGISTER_PATH][0], table, None).values())
    aliases = _register_lane_aliases(view.before(ALIASES_PATH))
    lane_rows = [row for row in (_register_lane_row(view, "before", key, aliases)
                                 for key in sorted(keys)) if row is not None]
    hold_rows = [row for row in (_register_last_hold(view, obj, key, table)
                                 for obj, key in sorted(pairs)) if row is not None]
    register_import_exempt(hold_rows)
    commit, tree = source["commit"], source["tree"]
    if root_seq is None:
        what = f"import — the register's files at {commit[:12]}, lanes tree {tree[:12]} (S5)"
    else:
        what = (f"after-loss import — the register's files at {commit[:12]}, its baseline "
                f"the mirror's Register-Seq {root_seq} (D22)")
    entry = {"journal": {"kind": "import", "verb": "import", "lane": lane,
                         "workstation": workstation, "author": author,
                         "message": f"LANES({lane}@{workstation}): {what}",
                         "git_commit": commit, "git_tree": tree,
                         "repos_blob": source["blobs"].get(REGISTER_REPOS_PATH)},
             "not_after": not_after, "edits": edits, "files": files, "lanes": lane_rows,
             "log_lines": log_rows, "register_lines": slot_rows, "object_holds": hold_rows}
    if root_seq is not None:
        entry["root_seq"] = root_seq
    return entry


def _import_end(exc: PsqlFailed, what: str, *, swap: bool) -> _ImportEnd:
    """A call that did not answer, as the import's end (contracts/exit-codes.md
    §3.2): a refusal of the register's own, LR010's key check, a switch not
    at `files` (LR002) or an entry that did not prove (LR004), is 2, nothing
    swapped in; any other SQLSTATE, a call never sent or one that did not
    answer, 69. After the swap's call, one that did not answer leaves it
    unknown whether the swap committed: a rerun reads the register again and
    replaces it."""
    code, lines = _cutover_psql_lines(exc)
    if not exc.ran:
        return _ImportEnd(EXIT_UNAVAILABLE, f"import: the {what} was not sent ({exc.detail}); "
                          f"nothing was swapped in", lines)
    if exc.psql_exit == 3 and code in ("LR002", "LR004", "LR010"):
        return _ImportEnd(EXIT_IMPORT_REFUSED, f"import: REFUSED: the {what} refused the entry "
                          f"({code}, above); nothing was swapped in", lines)
    if exc.psql_exit == 3 and code:
        return _ImportEnd(EXIT_UNAVAILABLE, f"import: the database refused the {what} ({code}, "
                          f"above); nothing was swapped in", lines)
    if swap:
        end = ("whether the swap committed is not known: a rerun reads the register again, and "
               "a re-import replaces it")
    elif what == "staged load":
        end = "the staged load is rolled back with its session, so nothing was swapped in"
    else:
        end = "nothing was swapped in"
    if exc.timer_expired:
        return _ImportEnd(EXIT_UNAVAILABLE, f"import: the {what}'s timer expired (D9, Y:3530); "
                          f"{end}", lines)
    return _ImportEnd(EXIT_UNAVAILABLE, f"import: the {what} ended with psql's exit "
                      f"{exc.psql_exit} ({exc.detail}); {end}", lines)


def _import_read(store) -> dict:
    """THE ONE READ (`_IMPORT_READS`), parsed, with the writers' version window
    checked (§1.5). Every failure is 69, with nothing swapped in."""
    try:
        res = store._query_many(list(_IMPORT_READS), snapshot=True, row="import")
    except PsqlFailed as exc:
        raise _import_end(exc, "read of the register", swap=False)
    try:
        if len(res) != len(_IMPORT_READS):
            raise ValueError(len(res))
        (version,), (switch,), (head,), (journal,), (clock,) = res
        st = {"version": int(version[0]), "writers_from": int(version[1]),
              "readers_from": int(version[2]), "mode": switch[0], "marker": switch[1],
              "generation": switch[2], "label": switch[3], "set_seq": int(switch[4]),
              "head": int(head[0]), "entries": int(journal[0]), "chained": int(journal[1]) > 0,
              "root": None if journal[2] is None else int(journal[2]), "clock": float(clock[0])}
        if not UUID_FULL_RE.match(st["generation"] or ""):
            raise ValueError("the switch's generation")
    except (ValueError, TypeError, IndexError):
        raise _ImportEnd(EXIT_UNAVAILABLE, "import: the register's answer to its read is not in "
                         "the shape this build reads; nothing was swapped in")
    why = register_version_refusal(st["version"], st["writers_from"], st["readers_from"],
                                   write=True)
    if why:
        raise _ImportEnd(EXIT_UNAVAILABLE, f"import: {why}; nothing was swapped in")
    return st


def _import_call(store, base: int, generation: str, write_id: str, entry: dict) -> str:
    """The `commit_write` call of the import's entry, in the commit's form
    (contract §2.3), its function named in the configured schema."""
    payload = json.dumps(entry, ensure_ascii=True, sort_keys=True, separators=(",", ":"))
    return (f"SELECT {store.schema}.commit_write({int(base)}, {_pg_quote(write_id)}, "
            f"{REGISTER_SCHEMA_VERSION}, {_pg_quote(generation)}, {_pg_quote(payload)}::jsonb)")


def _import_stage(store, base: int, generation: str, write_id: str, entry: dict,
                  seq: int) -> dict:
    """THE STAGED LOAD (step 3): ONE request under D9's import row, `SET
    search_path`, `BEGIN ISOLATION LEVEL SERIALIZABLE`, the `commit_write`
    call, T301's five render reads at `seq` (`register_render_queries`) and
    `_IMPORT_STAGED_READS`, each answered as COPY rows behind the marker, and
    `ROLLBACK`. Nothing it loads outlives the request.

    Returns, typed: `journal`, `edits` and `files`, for `register_images`;
    `digests`, `{path: render_file's sha256}`; `counts`, by `_IMPORT_COUNTS`;
    `lanes`, the staged `lanes` rows by `lane_key`; `holds`, the staged
    `holds` view's `(object, lane_key, verb, file, ordinal)`; `open`,
    `main_slots`' open takes by slot kind; and `clock`. A call that does not
    answer is `_import_end`'s; an answer it cannot read is 69."""
    reads = register_render_queries(seq) + list(_IMPORT_STAGED_READS)
    parts = [f'SET search_path TO "{store.schema}"', "BEGIN ISOLATION LEVEL SERIALIZABLE",
             _import_call(store, base, generation, write_id, entry), REGISTER_MARKER_COPY]
    for query in reads:
        parts += [f"COPY ({query}) TO STDOUT", REGISTER_MARKER_COPY]
    parts.append("ROLLBACK")
    try:
        out = store.request(parts, "import")
    except PsqlFailed as exc:
        raise _import_end(exc, "staged load", swap=False)
    marker = "\x1eLANES-INDEX-NEXT"
    answers, current = [], []
    for line in out.split("\n"):
        if line == marker:
            answers.append(current)
            current = []
        elif line != "":
            current.append([_pg_unescape(field) for field in line.split("\t")])
    try:
        if len(answers) != 1 + len(reads) or current:
            raise ValueError(f"{len(answers)} answers")
        got = int(answers[0][0][0])
        if got != seq:
            raise ValueError(f"the staged load took seq {got}, not {seq}")
        head, latest = (int(v) for v in answers[2][0])
        if (head, latest) != (seq, seq):
            raise ValueError(f"the staged head is {head} and its latest import {latest}")
        staged = {"journal": _render_rows(answers[3], "journal"),
                  "edits": _render_rows(answers[4], "journal_edits"),
                  "files": _render_rows(answers[5], "journal_files"),
                  "digests": {path: digest for path, digest in answers[6]}}
        staged["counts"] = dict(zip(_IMPORT_COUNTS, (int(v) for v in answers[7][0])))
        if len(staged["counts"]) != len(_IMPORT_COUNTS):
            raise ValueError("the counts")
        lanes = {}
        for row in answers[8]:
            fields = dict(zip(("lane_key",) + _IMPORT_LANE_FIELDS + ("path",), row))
            for key in ("aliases", "session_ids"):
                fields[key] = None if fields[key] is None else json.loads(fields[key])
            fields["archived"] = fields["archived"] == "t"
            lanes[fields["lane_key"]] = fields
        staged["lanes"] = lanes
        staged["holds"] = {(o, k, v, f, int(n)) for o, k, v, f, n in answers[9]}
        staged["open"] = [(kind, int(n)) for kind, n in answers[10]]
        staged["clock"] = float(answers[11][0][0])
    except RenderRefused as exc:
        raise _ImportEnd(EXIT_UNAVAILABLE, f"import: the staged load's answer cannot be read "
                         f"({exc}); nothing was swapped in")
    except (ValueError, TypeError, IndexError, KeyError) as exc:
        raise _ImportEnd(EXIT_UNAVAILABLE, f"import: the staged load's answer is not in the "
                         f"shape this build reads ({exc}); nothing was swapped in")
    return staged


def _import_swap(store, base: int, generation: str, write_id: str, entry: dict) -> int:
    """THE SWAP (step 4): one request under D9's import row, `BEGIN ISOLATION
    LEVEL SERIALIZABLE`, the same `commit_write` call the staged load made,
    and `COMMIT`. Returns the seq it committed."""
    call = _import_call(store, base, generation, write_id, entry)
    try:
        out = store.request(["BEGIN ISOLATION LEVEL SERIALIZABLE", call, "COMMIT"], "import")
    except PsqlFailed as exc:
        raise _import_end(exc, "swap", swap=True)
    answer = [line.strip() for line in out.splitlines() if line.strip()]
    if len(answer) != 1 or not answer[0].isdigit():
        raise _ImportEnd(EXIT_UNAVAILABLE, "import: the swap's transaction committed, but psql's "
                         "answer does not read as its seq: a rerun reads the register again")
    return int(answer[0])


def _import_files_holds(records: dict) -> set:
    """#160'S `holds`, the files' side of part 3: its PostgreSQL view as `ddl`
    states it, over `build_records`' `log_lines` - each lane's last readable
    line on an object, the lane compared in lower case and "last" by the file
    bytewise, then the line; never a `lane:` object; held while its verb is
    open, unless another lane's last line on the object is a TAKEOVER. As
    `(object, lane in lower case, verb, file, ordinal)`."""
    last: dict = {}
    for rec in records["log_lines"].values():
        obj = rec.get("object")
        if rec.get("unreadable") or obj is None or obj.startswith("lane:"):
            continue
        key = (obj, _register_lower(rec["lane"]))
        here = (rec["file"].encode("utf-8"), rec["ordinal"])
        if key not in last or here > (last[key]["file"].encode("utf-8"), last[key]["ordinal"]):
            last[key] = rec
    takeovers: dict = {}
    for (obj, lk), rec in last.items():
        if rec["verb"] == "TAKEOVER":
            takeovers.setdefault(obj, set()).add(lk)
    return {(obj, lk, rec["verb"], rec["file"], rec["ordinal"]) for (obj, lk), rec in last.items()
            if rec["verb"] in OPEN_VERBS and not (takeovers.get(obj, set()) - {lk})}


def _import_files_lanes(records: dict) -> dict:
    """#160's `lanes` records that name a row, by the lane's name in lower case,
    the first of each: what part 3 compares each staged `lanes` row with."""
    files_lanes: dict = {}
    for rec in records["lanes"].values():
        if rec.get("row_file") is not None:
            files_lanes.setdefault(_register_lower(rec["lane"]), rec)
    return files_lanes


def import_uncompared(staged: dict, records: dict) -> int:
    """HOW MANY STAGED `lanes` ROWS PART 3 DID NOT COMPARE (lane 3's ruling,
    opensoft/openRepoTools#165 6781033556, item 3: its count goes in the
    summary line). #160 reads only `lanes/archive/LANES-retired.md` of the
    archive, so a lane whose row sits in any other archive file has no record
    of #160's to compare with: `import_proof` skips it, and this counts the
    rows it skips, by the rule it skips them by."""
    files_lanes = _import_files_lanes(records)
    return sum(1 for key, row in staged["lanes"].items()
               if key not in files_lanes and row["path"] not in (REGISTER_PATH, ARCHIVE_PATH))


def import_proof(source: dict, staged: dict, entry: dict, records: dict,
                 root: str) -> list[tuple[str, str]]:
    """R3'S THREE-PART PROOF of the staged load (design.md S5; ops act 4's
    step 6), outside any transaction. Returns the differences as `(path,
    why)`, sorted by path bytewise, with "" for a difference of no one path;
    none where the proof holds.

    1. A BLOB ID PER PATH, BYTE-IDENTICAL: T301's scratch render of the staged
       journal (`register_images`, whose own proof checks each image against
       its `journal_files` digest), written into a scratch tree by
       `register_write_images`, hashed by `git hash-object --no-filters` in
       `root`, never with `-w`; each id equals `C`'s, and the path sets are
       equal. And `render_file`'s digest of every staged path equals the
       sha256 of `C`'s bytes.
    2. THE COUNTS: each staged table's count equals the rows `entry` sent, and
       the count the files give: the render set's paths and lines; #160's
       `build_records`' `log_lines`, its unreadable ones, and its
       `register_lines`; and the lanes a row names, by `row_name`.
    3. EVERY LANE'S ANSWERS: each staged `lanes` row equals `build_records`'
       first record with a row for that lane, field by field, where #160
       reads the file the row is in (`lanes/LANES.md`, and of the archive
       `LANES-retired.md` alone); and the staged `holds` view equals #160's
       `holds` over the files (`_import_files_holds`). A lane whose row is in
       another archive file has no record of #160's and is not compared:
       `import_uncompared` counts those, for the summary line."""
    import tempfile     # used here alone, so the module's imports stay as they were
    diffs: list = []
    # 1. A blob id per path.
    images: dict | None = None
    try:
        images = register_images(staged["journal"], staged["edits"], staged["files"])
    except RenderRefused as exc:
        diffs.append(("", f"T301's render of the staged journal refused: {exc}"))
    if images is not None:
        scratch = tempfile.mkdtemp(prefix="lanes-index-import-")
        try:
            out_dir = os.path.join(scratch, "render")
            try:
                register_write_images(out_dir, images)
            except (RenderRefused, OSError) as exc:
                raise Refusal(f"import: the scratch render could not be written ({exc}); "
                              f"nothing was swapped in")
            paths = sorted(images, key=lambda p: p.encode("utf-8"))
            proc = subprocess.run(
                ["git", "-C", root, "hash-object", "--no-filters", "--stdin-paths"],
                input="".join(os.path.join(out_dir, *p.split("/")) + "\n" for p in paths),
                capture_output=True, encoding="utf-8", errors="replace", check=False)
            ids = proc.stdout.split()
            if proc.returncode != 0 or len(ids) != len(paths):
                raise Refusal(f"import: git hash-object could not hash the scratch render "
                              f"({_mirror_git_error(proc.stderr.encode('utf-8'))}); nothing was "
                              f"swapped in")
            rendered = dict(zip(paths, ids))
        finally:
            shutil.rmtree(scratch, ignore_errors=True)
        for path in set(rendered) | set(source["render"]):
            want = source["blobs"][path] if path in source["data"] else None
            got = rendered.get(path)
            if want != got:
                diffs.append((path, f"its blob id is {got or 'absent'} from SQL and "
                                    f"{want or 'absent'} at {source['commit'][:12]}"))
    for path in set(staged["digests"]) | set(source["render"]):
        want = (hashlib.sha256(source["data"][path]).hexdigest() if path in source["data"]
                else None)
        got = staged["digests"].get(path)
        if want != got:
            diffs.append((path, f"render_file gives sha256 {got or 'no file'}, and "
                                f"{source['commit'][:12]}'s bytes are {want or 'absent'}"))
    # 2. The counts.
    counts = staged["counts"]
    row_lanes = {_register_lower(name) for path in source["render"]
                 if path == REGISTER_PATH or path.startswith(REGISTER_ARCHIVE_PREFIX)
                 for name in map(row_name, source["lines"][path][0]) if name}
    files_side = {
        "files": len(source["render"]),
        "doc_lines": sum(len(source["lines"][p][0]) for p in source["render"]),
        "lanes": len(row_lanes),
        "log_lines": len(records["log_lines"]),
        "unreadable": sum(1 for rec in records["log_lines"].values() if rec.get("unreadable")),
        "register_lines": len(records["register_lines"]),
    }
    sent = {"lanes": len(entry["lanes"]), "log_lines": len(entry["log_lines"]),
            "register_lines": len(entry["register_lines"]),
            "object_holds": len(entry["object_holds"]),
            "exempt": sum(1 for row in entry["object_holds"] if row["exempt"])}
    for name, want in files_side.items():
        if counts[name] != want:
            diffs.append(("", f"{name}: {counts[name]} staged, {want} from the files"))
    for name, want in sent.items():
        if counts[name] != want:
            diffs.append(("", f"{name}: {counts[name]} staged, {want} sent"))
    # 3. Every lane's answers.
    files_lanes = _import_files_lanes(records)
    for key, row in staged["lanes"].items():
        rec = files_lanes.get(key)
        if rec is None:
            if row["path"] in (REGISTER_PATH, ARCHIVE_PATH):
                diffs.append((row["path"], f"lane {row['lane']}'s row is in SQL, and #160's "
                                           f"parser finds none for it"))
            continue
        want = {"lane": rec["lane"], "aliases": json.loads(rec["aliases"]),
                "home": rec["home"], "workstation": rec["workstation"],
                "started_utc": rec["started_utc"], "handoff_path": rec["handoff_path"],
                "state_phrase": rec["state_phrase"], "objects_cell": rec["objects_cell"],
                "session_ids": json.loads(rec["session_ids"]),
                "last_session": rec["last_session"], "archived": bool(rec["archived"])}
        for field in _IMPORT_LANE_FIELDS:
            if row[field] != want[field]:
                diffs.append((row["path"] or "", f"lane {row['lane']}'s {field} is "
                                                 f"{row[field]!r} from SQL and "
                                                 f"{want[field]!r} from the files"))
    for key, rec in files_lanes.items():
        if key not in staged["lanes"]:
            diffs.append((rec["row_file"], f"lane {rec['lane']}'s row is in the files at line "
                                           f"{rec['row_ordinal']}, and SQL holds no row for it"))
    sql_holds = staged["holds"]
    file_holds = _import_files_holds(records)
    for obj, lk, verb, path, ordinal in sorted(sql_holds ^ file_holds):
        side = "SQL alone" if (obj, lk, verb, path, ordinal) in sql_holds else "the files alone"
        diffs.append((path, f"line {ordinal}: lane {lk}'s {verb} hold on {obj} is in {side}"))
    return sorted(diffs, key=lambda d: (d[0] == "", d[0].encode("utf-8"), d[1]))


# ================================================ the cutover (feature 007, T116)
#
# `LANES-INDEX CUTOVER`, ITS TRANSACTION (operations.md §2.2's act 4, step 7,
# and §2.3's disaster path; design.md S5, D21, D24 and §1.3's kinds table;
# FR-050, FR-052; L1-A14). The operator lane runs it on Brett's cutover word,
# with `LANES_LANE=` its name, from its own checkout (F12). Lane 3's T327 adds
# the git half: the marker's commit on origin's tip, its push, the read-back,
# `record_marker`, and the abort's trigger, which then calls `cutover_abort`
# below. This part is the database half, in three forms:
#   - `cutover --import <C>`, the first: the switch at `files` with the marker
#     `absent`, the entry at the seq after the latest import's, 1 after a
#     first import;
#   - `cutover --import <M> --after-loss`, after a re-import at the mirror's
#     tip: the same, at `m+1`, with the entry's `switch` key, so the
#     transaction also sets the label and a new generation (F10, F18);
#   - `cutover --after-loss`, after a restore: from `primary` with the marker
#     `present`, its base the head `b`, at `b+1`. The transaction records what
#     it replaces in `restore_prior`, for the abort, and refuses with LR004
#     (N4) unless the label differs from the switch's. Either after-loss form
#     that meets the switch at `primary` is sent this way, so a host not yet
#     re-pointed is refused by the transaction (ops:379).
# Each sends ONE commit call, `commit_write` with a `cutover` entry, in the
# commit's form (register-cli §2.3), under D9's cutover row. It sets the
# switch to `primary` with the marker `adding` and writes the operator entry
# that makes `lanes/STORE` hold D21's fields. The only git it runs is the
# author's lookup, between the read and the commit call, each a call and a
# transaction of its own, so no transaction is held across git (F23).
#
# THE LABEL (N4; V2's S-2; ops:379) is `register_label=`'s alone: `lanes/STORE`'s
# `database=` in every form, and the entry's `database_label` in the
# after-loss forms. A file with no `register_label=` is refused (2) before
# anything connects. At `files`, at a first cutover and after a re-import, a
# label that is not the switch's is refused (2) after the one read, before
# the commit call is sent.
#
# WHILE `RENDER_GIT_HALF` IS FALSE (Y:4872) it runs only against a scratch
# schema, a `register_schema=` other than `lanes_register`, and exits 2 on
# `lanes_register` before anything connects.
#
# EXIT 0 IN THIS BUILD: the entry committed; or a rerun found this cutover's
# own entry standing; or the register is already cut over at the same import
# with the same label. Nothing is pushed, so the marker stays `adding` and
# every write refuses (LR002) until T327's read-back calls `record_marker`.
# The restore form's render of every seq the mirror lacks up to `b` (ops:382)
# is the renderer's git half, which this build does not have: on a scratch
# schema it renders nothing and says so, and with the constant set it refuses.
#
# ITS ENDS (contracts/exit-codes.md §3.2): 0; 2 for each refusal, an LR004
# from the transaction, and `cutover_abort`'s `EXIT_CUTOVER_ABORTED`; 69 for
# a register it cannot read or that refuses, and for an expired timer, after
# which the switch is unknown and a rerun reads it first; 64 for usage.

#: PC-10'S CODE FOR THE CUTOVER'S ABORT (contracts/exit-codes.md §1 and §4;
#: T102): 2, and only once `switch_to_files` has committed. It shares 2 with
#: the cutover's other refusals; stderr's first line names the abort.
EXIT_CUTOVER_ABORTED = 2

#: `lanes/STORE` (D21): the one path an operator entry writes (D24, F2).
CUTOVER_STORE_PATH = "lanes/STORE"

#: The forms, as the cutover's lines name them.
_CUTOVER_FORMS = {"first": "the first form",
                  "reimport": "the after-loss form, after a re-import",
                  "restore": "the after-loss form, after a restore"}

#: A database's refusal, as psql prints it under `VERBOSITY=verbose`:
#: `ERROR:  <SQLSTATE>: <message>` (register-cli §2.6; Y:2590).
_CUTOVER_ERROR_RE = re.compile(r"^(?:ERROR|FATAL|PANIC):\s+([0-9A-Z]{5}):\s")

#: THE ONE READ before the commit call, in one REPEATABLE READ snapshot, as
#: REGISTER-WRITER under D9's cutover row: the version window, the switch, the
#: head, the latest import, the kind of the entry at the head, whether
#: `lanes/STORE` has a row, and the database's clock, for `not_after` (F3).
_CUTOVER_READS = (
    "SELECT version, writers_from, readers_from FROM schema_version WHERE id = 1",
    "SELECT mode, marker_state, marker_seq, generation, database_label, import_commit, "
    "import_tree, set_seq, restore_prior IS NOT NULL FROM register_switch WHERE id = 1",
    "SELECT seq FROM register_head WHERE id = 1",
    "SELECT seq, git_commit, git_tree FROM journal WHERE kind = 'import' "
    "ORDER BY seq DESC LIMIT 1",
    "SELECT j.kind FROM journal j JOIN register_head h ON h.id = 1 AND j.seq = h.seq",
    "SELECT count(*) FROM files WHERE path = 'lanes/STORE'",
    "SELECT extract(epoch FROM clock_timestamp())",
)

_CUTOVER_USAGE = f"""\
{PROG} cutover --import <C>                 the first cutover, after `import --at <C>`
{PROG} cutover --import <M> --after-loss    after a re-import at the mirror's tip <M>
{PROG} cutover --after-loss                 after a restore, at the backup's head

Sets the SQL register's switch to primary with the marker adding, and writes the
operator entry that makes lanes/STORE name this database, in one transaction
(operations.md §2.2, act 4's step 7, and §2.3). Run it as the operator lane, with
LANES_LANE=<lane>, from that lane's checkout. The label it sends is the one
register_label= names, and nothing else. While this build refuses mode=primary,
it runs only against a scratch schema (register_schema=), for act 3's rehearsal.
The marker's push is lane 3's T327.

  --import <C>   the imported commit, its full sha: the latest import's
  --after-loss   the disaster path's form, after a re-import or a restore

Exit: 0 committed, or found standing · 2 refused, nothing written · 64 usage ·
69 the register cannot be read or refused, or the call's timer expired."""


class _CutoverUsage(Exception):
    """A `cutover` command line that is not its usage: 64, before anything is
    read."""


class _CutoverEnd(Exception):
    """An end of `cutover` but 0 that is not a refusal of its own: its code,
    its own line, and psql's lines, which go first, verbatim (register-cli
    §2.6). `notes` are the run's own notes, which follow psql's lines."""

    def __init__(self, code: int, message: str, psql_lines: tuple = ()):
        super().__init__(message)
        self.code = code
        self.psql_lines = psql_lines
        self.notes: list[str] = []


def _cutover_args(args: list[str]) -> dict | None:
    """The cutover's flags; None for `--help`. `--import` takes the imported
    commit's full sha, 40 hex digits, read in lower case. `--marker-first`,
    (ii′)'s form (operations.md §2.2), is not in this build."""
    opts: dict = {"import": None, "after_loss": False}
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-h", "--help"):
            return None
        name, eq, value = arg.partition("=")
        if name == "--import":
            if not eq:
                value = args[i + 1] if i + 1 < len(args) else ""
                i += 1
            if opts["import"] is not None:
                raise _CutoverUsage("cutover: --import is given twice")
            if not re.fullmatch(r"[0-9A-Fa-f]{40}", value):
                raise _CutoverUsage("cutover: --import takes the imported commit's full sha, "
                                    "40 hex digits")
            opts["import"] = value.lower()
        elif arg == "--after-loss":
            if opts["after_loss"]:
                raise _CutoverUsage("cutover: --after-loss is given twice")
            opts["after_loss"] = True
        elif arg == "--marker-first":
            raise _CutoverUsage("cutover: --marker-first, (ii′)'s form, is not in this build")
        else:
            raise _CutoverUsage(f"cutover: unknown argument '{arg}'")
        i += 1
    if opts["import"] is None and not opts["after_loss"]:
        raise _CutoverUsage("cutover needs --import <C>, --import <M> --after-loss, or "
                            "--after-loss")
    return opts


def cmd_cutover(args: list[str]) -> int:
    """`lanes-index cutover` (above): its exits, by the contract's constants."""
    try:
        opts = _cutover_args(args)
    except _CutoverUsage as exc:
        note(f"{exc} - see {PROG} cutover --help")
        return EXIT_USAGE
    if opts is None:
        say(_CUTOVER_USAGE)
        return EXIT_OK
    try:
        return _cutover(opts)
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return EXIT_REFUSED
    except _CutoverEnd as exc:
        for line in exc.psql_lines:
            sys.stderr.write(line + "\n")
        for text in exc.notes:
            note(text)
        note(str(exc))
        return exc.code
    except StoreUnusable as exc:
        note(f"cutover: {exc.kind}: {exc.detail}; nothing was written")
        return EXIT_UNAVAILABLE


def _cutover(opts: dict) -> int:
    want = opts["import"]
    form = ("reimport" if opts["after_loss"] else "first") if want else "restore"
    # BEFORE ANYTHING CONNECTS: the configuration, its label, and the schema.
    cfg = load_config()
    label = cfg.get("register_label") or ""
    if not label:
        raise Refusal("cutover: lanes-index.conf has no register_label= (S-2)")
    if not RENDER_GIT_HALF and cfg["register_schema"] == REGISTER_TEMPLATE_SCHEMA:
        raise Refusal(
            f"cutover: register_schema={REGISTER_TEMPLATE_SCHEMA} is the register itself, and "
            f"while the renderer's git half is not installed (RENDER_GIT_HALF is False) "
            f"this build cuts over only a scratch schema, for act 3's rehearsal (Y:4872): "
            f"name one with register_schema=")
    store = PostgresStore(cfg, "register_writer")
    st = _cutover_read(store)
    pair = (st["mode"], st["marker"])
    notes: list[str] = []          # this run's own notes, printed after its outcome
    if pair == ("primary", "adding"):
        return _cutover_standing(st, form, want, label)
    if pair == ("files", "removing"):
        raise Refusal(
            f"cutover: a rollback's entry stands at seq {st['marker_seq']} with the marker "
            f"removing: its push and read-back finish the rollback before any cutover "
            f"(operations.md §2.3)")
    if pair == ("primary", "present"):
        if want and st["import_commit"] == want and st["label"] == label:
            say(f"cutover: already cut over: the switch is primary with the marker present "
                f"since seq {st['set_seq']}, database {label}, import {want}; nothing was "
                f"written")
            return EXIT_OK
        if form == "first":
            raise Refusal(
                f"cutover: the register is already cut over: the switch is primary with the "
                f"marker present, database {st['label']}, import {st['import_commit']}. After "
                f"a loss, the after-loss forms take --after-loss (operations.md §2.3)")
        if want:
            notes.append(f"cutover: the switch reads primary with the marker present, so this "
                         f"is the restore form's transaction (ops:379), and --import {want} "
                         f"names no import here")
        notes.append(_cutover_render_to(st["head"]))
        base, commit, tree, sent = st["head"], st["import_commit"], st["import_tree"], "restore"
    elif pair == ("files", "absent"):
        if form == "restore":
            raise Refusal(
                "cutover: the switch reads files with the marker absent, and the restore form "
                "runs only on a restored backup's switch, which reads primary. After a "
                "re-import, run cutover --import <M> --after-loss (operations.md §2.3)")
        if label != st["label"]:
            raise Refusal(f"cutover: register_label={label} is not the switch's label "
                          f"{st['label']}; set register_url= and register_label= together (S-2)")
        imp = st["import"]
        if imp is None:
            raise Refusal("cutover: the journal holds no import, and a cutover follows one: "
                          "run lanes-index import --at <C> first (act 4's step 6)")
        if imp["commit"] != want:
            raise Refusal(f"cutover: the latest import is {imp['commit']}, at seq {imp['seq']}, "
                          f"not {want}: a cutover follows the import it names, so import "
                          f"{want} first, or name {imp['commit']}")
        if st["head"] != imp["seq"]:
            raise Refusal(f"cutover: the head is {st['head']}, past the latest import's seq "
                          f"{imp['seq']}: after a rollback, import again before a cutover "
                          f"(design.md §1.3)")
        base, commit, tree, sent = imp["seq"], imp["commit"], imp["tree"], form
    else:
        raise _CutoverEnd(EXIT_UNAVAILABLE, f"cutover: the switch reads {st['mode']} with the "
                          f"marker {st['marker']}, which this build does not know; nothing "
                          f"was written")
    # BEFORE THE COMMIT CALL: whose entry it is (F12; Rule 10; D15).
    lane, workstation, author = _cutover_lane(), _cutover_workstation(), _cutover_author()
    timer = store.bounds("cutover")[1]
    not_after = _dt.datetime.fromtimestamp(st["clock"] + timer + 2, _dt.timezone.utc).isoformat()
    entry = cutover_entry(sent, lane=lane, workstation=workstation, author=author, label=label,
                          commit=commit, tree=tree, base=base,
                          store_present=st["store_present"], not_after=not_after)
    try:
        seq = _cutover_commit(store, base, st["generation"], entry)
    except _CutoverEnd as exc:
        exc.notes = notes
        raise
    return _cutover_done(seq, sent, label, "committed", notes)


def _cutover_read(store) -> dict:
    """The one read (`_CUTOVER_READS`), parsed, with the writers' version
    window checked (§1.5). Every failure is 69, with nothing written: a
    database that cannot be reached or refuses, a window this client is
    outside, or an answer this build cannot read."""
    try:
        res = store._query_many(list(_CUTOVER_READS), snapshot=True, row="cutover")
    except PsqlFailed as exc:
        _code, lines = _cutover_psql_lines(exc)
        raise _CutoverEnd(EXIT_UNAVAILABLE, f"cutover: the register in schema {store.schema} "
                          f"could not be read ({exc.detail}); nothing was written", lines)
    try:
        if len(res) != len(_CUTOVER_READS):
            raise ValueError(len(res))
        (version,), (switch,), (head,), imports, at_head, (stored,), (clock,) = res
        if len(imports) > 1 or len(at_head) > 1:
            raise ValueError("more than one row")
        st = {"version": int(version[0]), "writers_from": int(version[1]),
              "readers_from": int(version[2]),
              "mode": switch[0], "marker": switch[1],
              "marker_seq": None if switch[2] is None else int(switch[2]),
              "generation": switch[3], "label": switch[4], "import_commit": switch[5],
              "import_tree": switch[6], "set_seq": int(switch[7]),
              "restore_prior": switch[8] == "t", "head": int(head[0]),
              "import": ({"seq": int(imports[0][0]), "commit": imports[0][1],
                          "tree": imports[0][2]} if imports else None),
              "head_kind": at_head[0][0] if at_head else None,
              "store_present": int(stored[0]) > 0, "clock": float(clock[0])}
        if not UUID_FULL_RE.match(st["generation"] or "") or not st["label"]:
            raise ValueError("the switch's generation or label")
    except (ValueError, TypeError, IndexError):
        raise _CutoverEnd(EXIT_UNAVAILABLE, "cutover: the register's answer to its read is not "
                          "in the shape this build reads; nothing was written")
    why = register_version_refusal(st["version"], st["writers_from"], st["readers_from"],
                                   write=True)
    if why:
        raise _CutoverEnd(EXIT_UNAVAILABLE, f"cutover: {why}; nothing was written")
    return st


def _cutover_psql_lines(exc: PsqlFailed) -> tuple[str, tuple]:
    """A database's refusal in `exc`: its SQLSTATE, or "" where none, and the
    lines `cutover` passes on first, verbatim: psql's `ERROR:` line and the
    `DETAIL:` line under it, but never the `LOCATION:` line (register-cli
    §2.6)."""
    lines = (exc.stderr or "").splitlines()
    for i, line in enumerate(lines):
        match = _CUTOVER_ERROR_RE.match(line)
        if match:
            out = [line]
            if i + 1 < len(lines) and lines[i + 1].startswith("DETAIL:"):
                out.append(lines[i + 1])
            return match.group(1), tuple(out)
    return "", ()


def _cutover_standing(st: dict, form: str, want: str | None, label: str) -> int:
    """At `primary` with the marker `adding`, a cutover's entry stands
    unconfirmed. Where it is this cutover's own, a rerun after an expired
    timer finds it and goes on from it (D9, Y:3532; F12): the same label, the
    entry at the head, and the import it names, or `restore_prior` in the
    restore form. Any other is refused (2): its push and read-back, or its
    abort, come first."""
    if form == "restore":
        own = st["restore_prior"]
    elif form == "reimport":
        own = st["restore_prior"] or st["import_commit"] == want
    else:
        own = not st["restore_prior"] and st["import_commit"] == want
    if (own and st["label"] == label and st["marker_seq"] == st["head"]
            and st["head_kind"] == "cutover"):
        return _cutover_done(st["head"], "restore" if st["restore_prior"] else form, label,
                             "stands, committed by an earlier run")
    raise Refusal(f"cutover: a cutover's entry stands unconfirmed at seq {st['marker_seq']}, "
                  f"database {st['label']}, import {st['import_commit']}, and it is not this "
                  f"cutover's: its push and read-back, or its abort, come first (S5)")


def _cutover_render_to(b: int) -> str:
    """THE RESTORE FORM'S RENDER (ops:382): every seq the mirror lacks, up to
    the backup's head `b`, rendered as the rollback renders, before the
    transaction. That is the renderer's git half, which this build does not
    have. While `RENDER_GIT_HALF` is False, so on a scratch schema, it renders
    nothing and returns the note that says so; with the constant set it
    refuses (2), so that no real restore's cutover can skip its render."""
    if RENDER_GIT_HALF:
        raise Refusal(f"cutover: the restore form renders every seq the mirror lacks, up to "
                      f"{b}, before its transaction (ops:382), and this build has no such "
                      f"render; nothing was written")
    return (f"cutover: the restore form first renders every seq the mirror lacks, up to {b} "
            f"(ops:382); that render is the renderer's git half, which this build does not "
            f"have, so nothing was rendered for this scratch schema")


def _cutover_lane() -> str:
    """The operator lane, `LANES_LANE` (F12; Amendment 23's S2, "no lane, no
    write"): the entry's `lane`, the switch's `set_by_lane`, and the lane in
    its message. Unset, or not a lane's name, is refused (2)."""
    lane = os.environ.get("LANES_LANE", "").strip()
    if not lane:
        raise Refusal("cutover: LANES_LANE is not set: the cutover writes for the operator "
                      "lane, so it runs with LANES_LANE=<operator lane>, from that lane's "
                      "checkout (F12; Amendment 23's S2, \"no lane, no write\"); nothing was "
                      "written")
    if re.search(r"[\s<>@]", lane) or any(ord(ch) < 0x20 or ord(ch) == 0x7F for ch in lane):
        raise Refusal("cutover: LANES_LANE is not a lane's name: it holds a space, a control "
                      "character, '<', '>' or '@'; nothing was written")
    return lane


def _cutover_workstation() -> str:
    """This workstation's name (Rule 10): the entry's `workstation`, the
    switch's `set_by_ws` and `lanes/STORE`'s lines' `written_ws`.
    `$LANES_WORKSTATION`, where set, is the name, as `lanes-edit.sh
    workstation` answers first; otherwise that command is asked. A container
    with no name is refused (2), as every writer of the column refuses it
    (R-A11-14)."""
    name = os.environ.get("LANES_WORKSTATION", "")
    if not name:
        try:
            name, how = this_workstation()
        except StoreUnusable as exc:
            raise Refusal(f"cutover: this workstation's name cannot be read ({exc.detail}); "
                          f"nothing was written")
        if how == "container-unset":
            raise Refusal("cutover: this is a container and LANES_WORKSTATION is not set, so "
                          "the switch and the cutover's entry would be stamped with the "
                          "container's own id (Amendment 11, R-A11-14). Run it with "
                          "LANES_WORKSTATION set; nothing was written")
    if not name.strip() or any(ord(ch) < 0x20 or ord(ch) == 0x7F for ch in name):
        raise Refusal("cutover: this workstation's name is empty or holds a control "
                      "character; nothing was written")
    return name


def _cutover_author() -> str:
    """The entry's `author`, `Name <email>`, which T327's marker commit is
    made with (D15, whose rule the operator entries' commits follow): the
    identity git would record for a commit here, `git var
    GIT_AUTHOR_IDENT`, less its date. Where git names none, it is refused
    (2), since the journal holds no entry without one."""
    try:
        proc = subprocess.run(["git", "var", "GIT_AUTHOR_IDENT"], capture_output=True,
                              encoding="utf-8", errors="replace", check=False,
                              stdin=subprocess.DEVNULL, timeout=30, env=git_location_free_env())
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise Refusal(f"cutover: git could not name the author of the marker's commit "
                      f"({exc}); nothing was written")
    match = re.fullmatch(r"([^<>\n]+ <[^<>\n]*>) [0-9]+ [+-][0-9]{4}", proc.stdout.strip())
    if proc.returncode != 0 or not match:
        raise Refusal("cutover: git names no author for the marker's commit here (D15): run "
                      "it in the operator lane's checkout, with user.name and user.email "
                      "set; nothing was written")
    return match.group(1)


def cutover_store_lines(label: str, commit: str, tree: str, utc: str) -> list[str]:
    """`lanes/STORE`'s lines (D21; design.md S5): `store=primary`, `database=`
    the label `register_label=` names, `import=` the imported commit,
    `lanes-tree=` the tree id of its `lanes` tree, and `utc=`. No URL, no
    password and no password file."""
    return ["store=primary", f"database={label}", f"import={commit}", f"lanes-tree={tree}",
            f"utc={utc}"]


def cutover_entry(form: str, *, lane: str, workstation: str, author: str, label: str,
                  commit: str, tree: str, base: int, store_present: bool, not_after: str,
                  utc: str | None = None) -> dict:
    """THE CUTOVER'S ENTRY, as `commit_write` takes it (design.md §1.3's entry
    object; D24): `journal` with kind and verb `cutover`; edits that touch
    `lanes/STORE` alone, `remove` where it has a row (the restore form, which
    replaces its lines whole), then `create` and one `append` per line of
    `cutover_store_lines`; its one `files` row, with the sha256 of those lines,
    each LF-ended, the bytes `render_file` gives back; `not_after` (F3); and,
    in the after-loss forms, `switch` with `after_loss` and the label (N4).
    `form` is `first`, `reimport` or `restore`; `base` names the backup's head
    in the restore form's message."""
    lines = cutover_store_lines(label, commit, tree, utc or utc_now())
    body = ("\n".join(lines) + "\n").encode("utf-8")
    edits = [{"op": "remove", "path": CUTOVER_STORE_PATH}] if store_present else []
    edits.append({"op": "create", "path": CUTOVER_STORE_PATH})
    edits += [{"op": "append", "path": CUTOVER_STORE_PATH, "new_text": line} for line in lines]
    for number, edit in enumerate(edits, 1):
        edit["ord"] = number
    if form == "first":
        what = f"cutover — the register's store is SQL, database {label}, import {commit[:12]}"
    elif form == "reimport":
        what = (f"after-loss cutover — the replacement database {label}, re-imported at "
                f"{commit[:12]}")
    else:
        what = (f"after-loss cutover — the replacement database {label}, restored, from the "
                f"backup's head {base}")
    entry = {"journal": {"kind": "cutover", "verb": "cutover", "lane": lane,
                         "workstation": workstation, "author": author,
                         "message": f"LANES({lane}@{workstation}): {what} (D21, D24)"},
             "not_after": not_after, "edits": edits,
             "files": [{"path": CUTOVER_STORE_PATH, "present": True,
                        "sha256": hashlib.sha256(body).hexdigest(), "final_newline": True}]}
    if form != "first":
        entry["switch"] = {"after_loss": True, "database_label": label}
    return entry


def _cutover_commit(store, base: int, generation: str, entry: dict) -> int:
    """THE TRANSACTION: one commit call, as the contract's commit is sent
    (register-cli §2.3), `commit_write(base, write_id, REGISTER_SCHEMA_VERSION,
    generation, entry)` in one SERIALIZABLE transaction, as one request under
    D9's cutover row (Y:3532). Returns the entry's seq.

    Its ends: an LR004 is 2, nothing written: in the after-loss forms at
    `primary`, N4's label that does not differ from the switch's. Any other
    SQLSTATE is 69, nothing written. A call never sent is 69, nothing
    written. A timer that expired, or a call that ended without an answer, is
    69 with the switch unknown: a rerun reads the switch and the journal
    first, and goes on from its own entry where it finds one."""
    from uuid import uuid4
    payload = json.dumps(entry, ensure_ascii=True, sort_keys=True, separators=(",", ":"))
    call = (f"SELECT {store.schema}.commit_write({int(base)}, {_pg_quote(str(uuid4()))}, "
            f"{REGISTER_SCHEMA_VERSION}, {_pg_quote(generation)}, {_pg_quote(payload)}::jsonb)")
    try:
        out = store.request(["BEGIN ISOLATION LEVEL SERIALIZABLE", call, "COMMIT"], "cutover")
    except PsqlFailed as exc:
        code, lines = _cutover_psql_lines(exc)
        if not exc.ran:
            raise _CutoverEnd(EXIT_UNAVAILABLE, f"cutover: the commit call was not sent "
                              f"({exc.detail}); nothing was written", lines)
        if exc.timer_expired:
            raise _CutoverEnd(EXIT_UNAVAILABLE, "cutover: the commit call's timer expired, so "
                              "whether its transaction committed is not known: the switch is "
                              "unknown, and a rerun reads the switch and the journal first, and "
                              "goes on from its own entry where it finds one (D9, Y:3532)",
                              lines)
        if exc.psql_exit == 3 and code == "LR004":
            raise _CutoverEnd(EXIT_REFUSED, "cutover: REFUSED: the transaction refused the "
                              "entry (LR004, above); nothing was written", lines)
        if exc.psql_exit == 3 and code:
            raise _CutoverEnd(EXIT_UNAVAILABLE, f"cutover: the database refused the transaction "
                              f"({code}, above); nothing was written", lines)
        raise _CutoverEnd(EXIT_UNAVAILABLE, f"cutover: the commit call ended with psql's exit "
                          f"{exc.psql_exit} ({exc.detail}), so whether its transaction "
                          f"committed is not known: a rerun reads the switch and the journal "
                          f"first (D9, Y:3532)", lines)
    answer = [line.strip() for line in out.splitlines() if line.strip()]
    if len(answer) != 1 or not answer[0].isdigit():
        raise _CutoverEnd(EXIT_UNAVAILABLE, "cutover: the transaction committed, but psql's "
                          "answer does not read as its seq: a rerun reads the switch and "
                          "finds its own entry")
    return int(answer[0])


def _cutover_done(seq: int, form: str, label: str, how: str, notes: list | tuple = ()) -> int:
    say(f"cutover: seq {seq} {how}, {_CUTOVER_FORMS[form]}: the switch is primary with the "
        f"marker adding, and lanes/STORE names database {label}")
    for text in notes:
        note(text)
    note("cutover: the marker's push, its read-back and record_marker are lane 3's T327, which "
         "this build does not have: nothing was pushed, and the marker stays adding, so no "
         "write commits, until a read-back is recorded")
    return EXIT_OK


def cutover_abort(store, seq: int, *, lane: str, workstation: str, why: str) -> int:
    """THE CUTOVER'S ABORT, ITS TRANSACTION (design.md S5's step 3; D24;
    contracts/exit-codes.md §4). Lane 3's T327 calls it, only where the tip's
    `lanes` tree has moved since `C` and nothing was pushed, or where a
    read-back proves the marker absent from origin. `why` says which, and
    names the moved tip, for stderr's first line. `store` is the
    configuration's `PostgresStore(cfg, "register_writer")`.

    ONE call under D9's cutover row (Y:3533): `switch_to_files(client, seq,
    lane, workstation)`, which deletes the entry at `seq` and sets the head
    back to `seq - 1`. In the first and re-import forms it sets the switch to
    `files` with the marker `absent`, and keeps the label and generation the
    re-import form's cutover set (D24); in the restore form it puts back the
    switch row and `lanes/STORE` that `restore_prior` holds, and sets nothing
    to `files`. The same request reads the switch it left.

    Returns `EXIT_CUTOVER_ABORTED` once the call has committed. Every other
    end is `EXIT_UNAVAILABLE`, 69: a database that refuses, LR002 among
    them where no unconfirmed cutover stands at `seq`, or a call whose end is
    not known, after which a rerun reads the switch: at `files`, or back at the
    restored generation with the head at `b`, the abort is done; otherwise it
    runs again."""
    sql = ["BEGIN ISOLATION LEVEL SERIALIZABLE",
           f"SELECT {store.schema}.switch_to_files({REGISTER_SCHEMA_VERSION}, {int(seq)}, "
           f"{_pg_quote(lane)}, {_pg_quote(workstation)})",
           f"COPY (SELECT mode, marker_state, set_seq FROM {store.schema}.register_switch "
           f"WHERE id = 1) TO STDOUT",
           "COMMIT"]
    try:
        out = store.request(sql, "cutover")
    except PsqlFailed as exc:
        code, lines = _cutover_psql_lines(exc)
        for line in lines:
            sys.stderr.write(line + "\n")
        if code and exc.psql_exit == 3:
            note(f"cutover: the abort was refused ({code}, above), so seq {seq} stands; "
                 f"nothing was changed")
        elif not exc.ran:
            note(f"cutover: the abort's call was not sent ({exc.detail}), so seq {seq} stands; "
                 f"nothing was changed")
        else:
            note(f"cutover: the abort's call ended without an answer ({exc.detail}), so "
                 f"whether it committed is not known: a rerun reads the switch. At files, or "
                 f"back at the restored generation with the head at {int(seq) - 1}, the abort "
                 f"is done; otherwise it runs again (D9, Y:3533)")
        return EXIT_UNAVAILABLE
    answer = [line for line in out.splitlines() if line.strip()]
    fields = answer[1].split("\t") if len(answer) == 2 else []
    if len(fields) != 3 or not answer[0].strip().isdigit():
        note(f"cutover: ABORTED: {why}. switch_to_files committed, deleting seq {seq}, but "
             f"its answer does not read as the switch it left")
        return EXIT_CUTOVER_ABORTED
    restored = fields[0] == "primary"
    note(f"cutover: ABORTED: {why}. switch_to_files deleted seq {seq} and set the head back "
         f"to {answer[0].strip()}; the switch reads {fields[0]} with the marker {fields[1]}, "
         f"set_seq {fields[2]}"
         + ("; the restored switch is put back whole, and the estate stays stopped until the "
            "cutover runs again" if restored else
            "; import again at the new tip, then run the cutover again"))
    return EXIT_CUTOVER_ABORTED


# ============================================ the rollback (feature 007, T304)
#
# `LANES-INDEX ROLLBACK`, STEPS 0 AND 1 (design.md S5's "Rollback, under
# Q4(b)(iii)", Y:3222-3264, and §1.3's kinds table and divergence gate,
# Y:1542-1550; operations.md §2.3's step 2, ops:329-336; FR-051, FR-052; D24).
# The operator lane runs it on Brett's word, with `LANES_LANE=` its name, from
# a shell or a `CLAUDE_NO_LANE=1` session, in its own checkout (D24). Lane 3's
# T326 adds the git half: step 0's fresh fetch, at `rollback_step_0_git_half`,
# and steps 2 to 4 with `--hold-marker`, at `rollback_steps_2_to_4`.
#
# EACH TRY, as one loop (ops:331; Y:1550):
#   - ONE READ (`_ROLLBACK_READS`), one REPEATABLE READ snapshot as the
#     REGISTER-WRITER under D9's `rollback` row (Y:3529): the version window,
#     the switch, the head `k`, the kind and write id of the entry at the head,
#     `mirror_state`'s divergence, and the database's clock, for `not_after`.
#   - STEP 0'S DATABASE HALF: while `mirror_state.diverged_sha` is set it
#     refuses, 2, with `diverged at <sha>` and S2's two ways out, nothing
#     written (F1). Then T326's git half, right before step 1.
#   - STEP 1, ONE SHORT TRANSACTION, one commit call in the commit's form
#     (register-cli §2.3): `commit_write(k, <new write id>, ...)` with a
#     `rollback` entry, whose one edit removes `lanes/STORE` (D24). Under the
#     head row's lock lane 1's function refuses it with LR012 while a
#     divergence is recorded (read `FOR SHARE`), moves the head from `k` to
#     `k+1`, and sets the switch to `files` with the marker `removing`,
#     `set_seq` and `marker_seq` its own seq. Nothing here adds SQL.
#   - A LOST TURN, 40001, 40P01, 55P03 or LR001, sends it back to the read,
#     with the head read afresh as its `k`, until D7's deadline
#     (`rollback_deadline_s`), where it exits 75 with nothing written and the
#     switch still `primary` (V3's NIT 2). No read starts after the deadline.
#
# ITS START DECLARES THE OUTAGE (D20; ops:334), once step 1 has committed, since
# T121's `--rollback` form needs the switch at `files`: through T121's own
# `outage declare --rollback --mirror-seq <k>`, `_outage_declare`, where the
# configuration's directory can be written, and otherwise, as from a bench's
# read-only mount, by printing that line for Brett to run on each host.
#
# A RERUN that finds the switch at `files`, the marker `removing` and the
# rollback's own entry last, at `set_seq` = `marker_seq` = the head, declares
# first, with `k = set_seq - 1`, and goes on from step 2 (Y:3264; ops:336).
#
# WHILE `RENDER_GIT_HALF` IS FALSE (Y:4872) it runs only against a scratch
# schema, a `register_schema=` other than `lanes_register`, and exits 2 on
# `lanes_register`, unset included, before anything connects.
#
# ITS ENDS (contracts/exit-codes.md §3.2): 0 once step 1 has committed, or a
# rerun found it standing, and the outage is declared or its line printed:
# steps 2 to 4 are T326's, so nothing is rendered or pushed and the marker
# stays `removing`; 2 for each refusal, LR012 among them; 69 where the register
# cannot be read or refuses, the switch and the marker unchanged, and where
# step 1's call ends with no answer, after one re-read of the switch; 75 at
# D7's deadline; 64 for usage.

#: D7'S DEADLINE across step 1's tries, in seconds (Y:455-456; ops:331).
ROLLBACK_DEADLINE_S = 30

#: THE LOST TURNS (Y:1550; ops:331): each sends the rollback back to step 0,
#: with the head read afresh as its `k`.
ROLLBACK_LOST_TURNS = frozenset({"40001", "40P01", "55P03", "LR001"})

#: THE ONE READ of each try, in one REPEATABLE READ snapshot, as
#: REGISTER-WRITER under D9's rollback row.
_ROLLBACK_READS = (
    "SELECT version, writers_from, readers_from FROM schema_version WHERE id = 1",
    "SELECT mode, marker_state, marker_seq, generation, set_seq FROM register_switch "
    "WHERE id = 1",
    "SELECT seq FROM register_head WHERE id = 1",
    "SELECT j.kind, j.write_id FROM journal j JOIN register_head h ON h.id = 1 AND j.seq = h.seq",
    "SELECT diverged_sha, found_utc, found_by_ws FROM mirror_state WHERE id = 1",
    "SELECT extract(epoch FROM clock_timestamp())",
)

_ROLLBACK_USAGE = f"""\
{PROG} rollback        steps 0 and 1 of the rollback to files mode

Refuses while a divergence is recorded (step 0), then, in one short
transaction, sets the SQL register's switch to files with the marker removing
and writes the operator entry that removes lanes/STORE (step 1; operations.md
section 2.3). A lost turn goes back to step 0 with the head read afresh, until
D7's deadline. Its start declares the outage through `outage declare --rollback
--mirror-seq <k>`, or prints that line where the configuration's directory
cannot be written. Run it as the operator lane, with LANES_LANE=<lane>, from a
shell or a CLAUDE_NO_LANE=1 session, in that lane's checkout (D24). While this
build refuses mode=primary, it runs only against a scratch schema
(register_schema=). Step 0's fresh fetch, the render, --hold-marker and the
marker's push are lane 3's T326, which this build does not have.

Exit: 0 step 1 committed, or found standing · 2 refused, nothing written ·
64 usage · 69 the register cannot be read or refused, or a call's timer expired ·
75 register busy at D7's deadline, nothing written."""


class _RollbackUsage(Exception):
    """A `rollback` command line that is not its usage: 64, before anything is
    read."""


class _RollbackEnd(Exception):
    """An end of `rollback` but 0 that is not a refusal of its own: its code,
    its own line, and psql's lines, which go first, verbatim (register-cli
    §2.6)."""

    def __init__(self, code: int, message: str, psql_lines: tuple = ()):
        super().__init__(message)
        self.code = code
        self.psql_lines = psql_lines


class _RollbackLostTurn(Exception):
    """Step 1's call ended in a lost turn (`ROLLBACK_LOST_TURNS`), with nothing
    written: back to step 0."""

    def __init__(self, sqlstate: str, psql_lines: tuple):
        super().__init__(sqlstate)
        self.sqlstate = sqlstate
        self.psql_lines = psql_lines


def rollback_deadline_s() -> int:
    """D7's deadline for this run, in whole seconds: `LANES_REGISTER_DEADLINE_S`
    where it is a positive whole number of at most 18 digits, else 30 (Q73):
    1 to 18 ASCII digits read in base 10, above 0, as lane 4's T415 reads it.
    It is the seam that sets D7's deadline for tests (design.md S1; the test
    plan's AT-D9 `rollback` row sets it to 6). Any other value, `0` included,
    is ignored, and `ROLLBACK_DEADLINE_S`, 30, kept."""
    raw = os.environ.get("LANES_REGISTER_DEADLINE_S", "")
    if re.fullmatch(r"[0-9]{1,18}", raw) and int(raw) > 0:
        return int(raw)
    return ROLLBACK_DEADLINE_S


def _rollback_args(args: list[str]) -> dict | None:
    """The rollback's flags; None for `--help`. `--hold-marker`, step 3's stop
    for the ruleset, is T326's, and not in this build: T326 parses it here, and
    `rollback_steps_2_to_4` reads it from the options this returns."""
    for arg in args:
        if arg in ("-h", "--help"):
            return None
    for arg in args:
        if arg == "--hold-marker":
            raise _RollbackUsage("rollback: --hold-marker, step 3's stop for the ruleset, is "
                                 "lane 3's T326, and not in this build")
        raise _RollbackUsage(f"rollback: unknown argument '{arg}'")
    return {}


def cmd_rollback(args: list[str]) -> int:
    """`lanes-index rollback` (above): its exits, by the contract's constants."""
    try:
        opts = _rollback_args(args)
    except _RollbackUsage as exc:
        note(f"{exc} - see {PROG} rollback --help")
        return EXIT_USAGE
    if opts is None:
        say(_ROLLBACK_USAGE)
        return EXIT_OK
    try:
        return _rollback(opts)
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return EXIT_REFUSED
    except _RollbackEnd as exc:
        for line in exc.psql_lines:
            sys.stderr.write(line + "\n")
        note(str(exc))
        return exc.code
    except StoreUnusable as exc:
        note(f"rollback: {exc.kind}: {exc.detail}; the call was not sent")
        return EXIT_UNAVAILABLE


def _rollback(opts: dict) -> int:
    # BEFORE ANYTHING CONNECTS: the configuration, Q6(c)'s refusal among its
    # refusals (exit-codes.md §2), and the schema (Y:4872).
    cfg = load_config()
    if not RENDER_GIT_HALF and cfg["register_schema"] == REGISTER_TEMPLATE_SCHEMA:
        raise Refusal(
            f"rollback: register_schema={REGISTER_TEMPLATE_SCHEMA} is the register itself, and "
            f"while the renderer's git half is not installed (RENDER_GIT_HALF is False) "
            f"this build rolls back only a scratch schema (Y:4872): name one with "
            f"register_schema=; nothing was written")
    from uuid import uuid4
    store = PostgresStore(cfg, "register_writer")
    limit = rollback_deadline_s()
    deadline = time.monotonic() + limit
    ident: dict = {}
    tries = 0
    while True:
        st = _rollback_read(store, "nothing was written, and the switch and the marker are "
                                   "unchanged")
        # WHOSE ENTRY IT IS (F12; Rule 10; D15), read once, after the first read and
        # before the rerun path, so that T326's writes on a rerun have it too.
        if not ident:
            ident = {"lane": _rollback_lane(), "workstation": _rollback_workstation(),
                     "author": _rollback_author()}
        pair = (st["mode"], st["marker"])
        if pair == ("files", "removing"):
            if _rollback_own_entry(st):
                say(f"rollback: seq {st['head']}, this rollback's entry, stands: the switch "
                    f"reads files with the marker removing, so this rerun declares first and "
                    f"goes on from step 2 (operations.md §2.3)")
                return _rollback_after_step_1(cfg, store, opts, ident, st["head"] - 1,
                                              st["head"])
            raise _RollbackEnd(EXIT_UNAVAILABLE, f"rollback: the switch reads files with the "
                               f"marker removing at set_seq {st['set_seq']}, but the head "
                               f"{st['head']} is not a rollback's entry at that seq, which "
                               f"this build does not know; nothing was written")
        if pair == ("primary", "adding"):
            raise Refusal(f"rollback: a cutover's entry stands unconfirmed at seq "
                          f"{st['marker_seq']}, the marker adding: its push and read-back "
                          f"(T327), or its abort, come first; nothing was written")
        if pair == ("files", "absent"):
            raise Refusal("rollback: the switch reads files with the marker absent: the "
                          "register's store is files already, and there is nothing to roll "
                          "back; nothing was written")
        if pair != ("primary", "present"):
            raise _RollbackEnd(EXIT_UNAVAILABLE, f"rollback: the switch reads {st['mode']} with "
                               f"the marker {st['marker']}, which this build does not know; "
                               f"nothing was written")
        k = st["head"]
        # STEP 0, ITS DATABASE HALF (F1; Y:3227-3228).
        if st["diverged_sha"]:
            raise Refusal(
                f"rollback: diverged at {st['diverged_sha']}, found {st['found_utc']} by "
                f"{st['found_by_ws']} (mirror_state): a diverged mirror can never be proved "
                f"current, so the rollback does not start (F1; S5's step 0). Resolve it first "
                f"by one of S2's two ways out, `{PROG} import --single <sha>` or `{PROG} render "
                f"--revert <sha>`, while the switch reads primary; nothing was written")
        # STEP 0, ITS GIT HALF: T326's.
        rollback_step_0_git_half(cfg, store, k, ident["lane"])
        # STEP 1.
        tries += 1
        write_id = str(uuid4())
        timer = store.bounds("rollback")[1]
        # T326: not_after counts from this read, before the git half; a slow fetch ends LR008, 69.
        not_after = _dt.datetime.fromtimestamp(st["clock"] + timer + 2,
                                               _dt.timezone.utc).isoformat()
        entry = rollback_entry(k, not_after=not_after, **ident)
        try:
            seq = _rollback_step_1(store, k, st["generation"], write_id, entry)
        except _RollbackLostTurn as lost:
            if time.monotonic() >= deadline:
                raise _RollbackEnd(
                    EXIT_BUSY, f"rollback: register busy: {tries} tries in "
                    f"{limit} s, each a lost turn, the last {lost.sqlstate} on "
                    f"head {k} (D7); nothing was written, and the switch still reads primary; "
                    f"a rerun starts again at step 0", lost.psql_lines)
            for line in lost.psql_lines:
                sys.stderr.write(line + "\n")
            note(f"rollback: step 1 on head {k} lost its turn ({lost.sqlstate}), with nothing "
                 f"written: back to step 0, with the head read afresh")
            continue
        if seq is None:
            # NO ANSWER: the switch is unknown, so it is read again before step 2.
            again = _rollback_read(store, "whether step 1 committed is not known, and a rerun "
                                          "reads the switch first (D9, Y:3529)")
            if (again["mode"], again["marker"]) == ("files", "removing") and \
                    _rollback_own_entry(again) and again["head_write_id"] == write_id:
                seq = again["head"]
                note(f"rollback: step 1's call ended with no answer, and the switch read again "
                     f"finds its entry at seq {seq}")
            else:
                raise _RollbackEnd(
                    EXIT_UNAVAILABLE, f"rollback: step 1's call ended with no answer, and the "
                    f"switch read again is {again['mode']} with the marker {again['marker']} at "
                    f"head {again['head']}, not this rollback's entry, so whether its "
                    f"transaction commits is not known: it may still run on the server. A "
                    f"rerun reads the switch first, and goes on from this rollback's entry "
                    f"where it finds one (D9, Y:3529)")
        else:
            say(f"rollback: seq {seq} committed: the switch reads files with the marker "
                f"removing, the head moved from {k} to {seq}, and the operator entry removes "
                f"{CUTOVER_STORE_PATH} (S5's step 1; D24)")
        return _rollback_after_step_1(cfg, store, opts, ident, k, seq)


def _rollback_read(store, failed: str) -> dict:
    """One try's read (`_ROLLBACK_READS`), parsed, with the writers' version
    window checked (§1.5). Every failure is 69, and `failed` says what it
    leaves: a database that cannot be reached or refuses, a window this
    client is outside, or an answer this build cannot read."""
    try:
        res = store._query_many(list(_ROLLBACK_READS), snapshot=True, row="rollback")
    except PsqlFailed as exc:
        err = register_definitive_error(exc)
        lines = (err.error_line,) + ((err.detail_line,) if err.detail_line else ()) if err else ()
        raise _RollbackEnd(EXIT_UNAVAILABLE, f"rollback: the register in schema {store.schema} "
                           f"could not be read (its call {register_psql_end(exc)}); {failed}",
                           lines)
    try:
        if len(res) != len(_ROLLBACK_READS):
            raise ValueError(len(res))
        (version,), (switch,), (head,), at_head, (mirror,), (clock,) = res
        if len(at_head) > 1:
            raise ValueError("more than one row")
        st = {"version": int(version[0]), "writers_from": int(version[1]),
              "readers_from": int(version[2]), "mode": switch[0], "marker": switch[1],
              "marker_seq": None if switch[2] is None else int(switch[2]),
              "generation": switch[3], "set_seq": int(switch[4]), "head": int(head[0]),
              "head_kind": at_head[0][0] if at_head else None,
              "head_write_id": at_head[0][1] if at_head else None,
              "diverged_sha": mirror[0], "found_utc": mirror[1], "found_by_ws": mirror[2],
              "clock": float(clock[0])}
        if not UUID_FULL_RE.match(st["generation"] or ""):
            raise ValueError("the switch's generation")
    except (ValueError, TypeError, IndexError):
        raise _RollbackEnd(EXIT_UNAVAILABLE, f"rollback: the register's answer to its read is "
                           f"not in the shape this build reads; {failed}")
    why = register_version_refusal(st["version"], st["writers_from"], st["readers_from"],
                                   write=True)
    if why:
        raise _RollbackEnd(EXIT_UNAVAILABLE, f"rollback: {why}; {failed}")
    return st


def _rollback_own_entry(st: dict) -> bool:
    """Whether the head is the rollback's own entry, as step 1 leaves it: a
    `rollback` entry at the head, which is the switch's `set_seq` and its
    `marker_seq` (§1.3's kinds table)."""
    return (st["head_kind"] == "rollback" and st["set_seq"] == st["head"]
            and st["marker_seq"] == st["head"])


def _rollback_lane() -> str:
    """The operator lane, `LANES_LANE` (D24; F12; Amendment 23's S2, "no
    lane, no write"): the entry's `lane` and the switch's `set_by_lane`.
    Unset, or not a lane's name, is refused (2)."""
    lane = os.environ.get("LANES_LANE", "").strip()
    if not lane:
        raise Refusal("rollback: LANES_LANE is not set: the rollback writes for the operator "
                      "lane, so it runs with LANES_LANE=<operator lane>, in that lane's "
                      "checkout (D24; Amendment 23's S2, \"no lane, no write\"); nothing was "
                      "written")
    if re.search(r"[\s<>@]", lane) or any(ord(ch) < 0x20 or ord(ch) == 0x7F for ch in lane):
        raise Refusal("rollback: LANES_LANE is not a lane's name: it holds a space, a control "
                      "character, '<', '>' or '@'; nothing was written")
    return lane


def _rollback_workstation() -> str:
    """This workstation's name (Rule 10), the entry's `workstation` and the
    switch's `set_by_ws`, as the cutover reads it: `$LANES_WORKSTATION`, else
    `lanes-edit.sh workstation`. A container with no name, or a name that
    cannot be read, is refused (2) (R-A11-14)."""
    name = os.environ.get("LANES_WORKSTATION", "")
    if not name:
        try:
            name, how = this_workstation()
        except StoreUnusable as exc:
            raise Refusal(f"rollback: this workstation's name cannot be read ({exc.detail}); "
                          f"nothing was written")
        if how == "container-unset":
            raise Refusal("rollback: this is a container and LANES_WORKSTATION is not set, so "
                          "the switch and the rollback's entry would be stamped with the "
                          "container's own id (Amendment 11, R-A11-14). Run it with "
                          "LANES_WORKSTATION set; nothing was written")
    if not name.strip() or any(ord(ch) < 0x20 or ord(ch) == 0x7F for ch in name):
        raise Refusal("rollback: this workstation's name is empty or holds a control "
                      "character; nothing was written")
    return name


def _rollback_author() -> str:
    """The entry's `author`, `Name <email>`, which T326's commit removing
    `lanes/STORE` is made with (D15): `git var GIT_AUTHOR_IDENT` here, less its
    date, as the cutover reads its own. Where git names none, it is refused
    (2), since the journal holds no entry without one."""
    try:
        proc = subprocess.run(["git", "var", "GIT_AUTHOR_IDENT"], capture_output=True,
                              encoding="utf-8", errors="replace", check=False,
                              stdin=subprocess.DEVNULL, timeout=30, env=git_location_free_env())
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise Refusal(f"rollback: git could not name the author of the entry ({exc}); nothing "
                      f"was written")
    match = re.fullmatch(r"([^<>\n]+ <[^<>\n]*>) [0-9]+ [+-][0-9]{4}", proc.stdout.strip())
    if proc.returncode != 0 or not match:
        raise Refusal("rollback: git names no author here (D15): run it in the operator lane's "
                      "checkout, with user.name and user.email set; nothing was written")
    return match.group(1)


def rollback_entry(k: int, *, lane: str, workstation: str, author: str, not_after: str) -> dict:
    """THE ROLLBACK'S ENTRY, as `commit_write` takes it (design.md §1.3's entry
    object and kinds table; D24): `journal` with kind and verb `rollback`; one
    edit, the `remove` of `lanes/STORE`; its one `files` row, not present;
    `not_after` (F3). `k` is the head the try read, for its message."""
    what = (f"rollback — the register's store is files again: {CUTOVER_STORE_PATH} removed "
            f"after seq {k}")
    return {"journal": {"kind": "rollback", "verb": "rollback", "lane": lane,
                        "workstation": workstation, "author": author,
                        "message": f"LANES({lane}@{workstation}): {what} (D24, S5)"},
            "not_after": not_after,
            "edits": [{"ord": 1, "op": "remove", "path": CUTOVER_STORE_PATH}],
            "files": [{"path": CUTOVER_STORE_PATH, "present": False}]}


def _rollback_step_1(store, k: int, generation: str, write_id: str, entry: dict) -> int | None:
    """STEP 1: one commit call, `commit_write(k, write_id, REGISTER_SCHEMA_VERSION,
    generation, entry)` in one SERIALIZABLE transaction, as one request under
    D9's rollback row (Y:3529). Returns the entry's seq, or None where the call
    was sent and ended with no answer, so whether it committed is not known.

    A lost turn (`ROLLBACK_LOST_TURNS`) is `_RollbackLostTurn`. An LR012 is 2:
    a divergence recorded meanwhile. Any other SQLSTATE is 69, and so is a call
    never sent, each with nothing written."""
    payload = json.dumps(entry, ensure_ascii=True, sort_keys=True, separators=(",", ":"))
    call = (f"SELECT {store.schema}.commit_write({int(k)}, {_pg_quote(write_id)}, "
            f"{REGISTER_SCHEMA_VERSION}, {_pg_quote(generation)}, {_pg_quote(payload)}::jsonb)")
    try:
        out = store.request(["BEGIN ISOLATION LEVEL SERIALIZABLE", call, "COMMIT"], "rollback")
    except PsqlFailed as exc:
        if not exc.ran:
            raise _RollbackEnd(EXIT_UNAVAILABLE, f"rollback: step 1's call was not sent "
                               f"({exc.detail}); nothing was written, and the switch and the "
                               f"marker are unchanged")
        err = register_definitive_error(exc)
        if err is None:
            note(f"rollback: step 1's call on head {k} {register_psql_end(exc)}")
            return None
        lines = (err.error_line,) + ((err.detail_line,) if err.detail_line else ())
        if err.sqlstate in ROLLBACK_LOST_TURNS:
            raise _RollbackLostTurn(err.sqlstate, lines)
        if err.sqlstate == "LR012":
            raise _RollbackEnd(EXIT_REFUSED, "rollback: REFUSED: the transaction refused the "
                               "rollback's entry (LR012, above): a divergence was recorded "
                               "meanwhile, so the rollback does not go on (F1; S5). Resolve it "
                               f"first by `{PROG} import --single <sha>` or `{PROG} render "
                               "--revert <sha>`; nothing was written", lines)
        raise _RollbackEnd(EXIT_UNAVAILABLE, f"rollback: the database refused step 1's "
                           f"transaction ({err.sqlstate}, above); nothing was written, and the "
                           f"switch and the marker are unchanged", lines)
    answer = [line.strip() for line in out.splitlines() if line.strip()]
    if len(answer) != 1 or not answer[0].isdigit():
        return None
    return int(answer[0])


def rollback_step_0_git_half(cfg: dict, store, k: int, lane: str) -> None:
    """THE SEAM FOR T326: STEP 0'S GIT HALF, right before step 1, on every try
    (Y:3229-3232; ops:331). T326 fetches `origin main` again in the operator
    lane's checkout and checks it as T322 recognises a divergence, a last
    `Register-Seq` above the head `k` included; it records one it finds with
    `record_mirror_state` and refuses with 2, a `Refusal`, nothing written.

    This build has no git half. While `RENDER_GIT_HALF` is False, so on a
    scratch schema, which no mirror renders, it checks nothing; with the
    constant set it refuses (2), so that no rollback of the register itself
    skips its fresh fetch."""
    if RENDER_GIT_HALF:
        raise Refusal(f"rollback: step 0's git half, the fresh fetch of origin {branch()} and "
                      f"its divergence check against head {k}, is lane 3's T326, which this "
                      f"build does not have; nothing was written")


def _rollback_declare(cfg: dict, k: int) -> None:
    """ITS START DECLARES THE OUTAGE (D20; ops:334, :336): T121's `outage
    declare --rollback --mirror-seq <k>`, run in this process, which probes
    the switch at `files` with this rollback's entry at `set_seq` = `k+1`, and
    writes `register-outage` beside the configuration. Where that directory
    cannot be written, as on a bench's read-only mount, or the declaration is
    refused, it prints the line for Brett to run on each host instead; a rerun
    declares again first."""
    line = f"{PROG} outage declare --rollback --mirror-seq {k}"
    directory = os.path.dirname(register_outage_path(cfg))
    if not os.access(directory, os.W_OK | os.X_OK):
        note(f"rollback: {directory} cannot be written from here, as on a bench's read-only "
             f"mount, so the outage is not declared here. Run on each configured "
             f"workstation, from the host (operations.md §2.3):")
        say(line)
        return
    try:
        _outage_declare(_outage_args(["declare", "--rollback", "--mirror-seq", str(k)]))
    except (Refusal, StoreUnusable, _OutageUsage) as exc:
        note(f"rollback: the outage was not declared here ({exc}). Run on each configured "
             f"workstation, from the host, or run the rollback again, which declares first "
             f"(operations.md §2.3):")
        say(line)


def _rollback_after_step_1(cfg: dict, store, opts: dict, ident: dict, k: int, seq: int) -> int:
    """After step 1, or a rerun that found it standing: the declaration, then
    steps 2 to 4."""
    _rollback_declare(cfg, k)
    return rollback_steps_2_to_4(cfg, store, opts, ident, k, seq)


def rollback_steps_2_to_4(cfg: dict, store, opts: dict, ident: dict, k: int, seq: int) -> int:
    """THE SEAM FOR T326: STEPS 2 TO 4 (Y:3245-3256; ops:337-340), from the
    first run once step 1 and the declaration are done, and from a rerun that
    found step 1 standing. `opts` is the parsed command line, where T326's
    `--hold-marker` belongs (`_rollback_args`), and `ident` the operator
    lane's `lane`, `workstation` and `author`, read before the rerun path. T326
    renders to `k` in the operator lane's checkout, stops there under
    `--hold-marker`, and otherwise pushes seq `seq` (`k+1`) with its read-back
    and `record_marker`, holding no database transaction across a git act
    (F23; FR-052).

    This build has neither: it says so and returns 0, as the cutover's T116
    returns 0 before T327's push. The marker stays `removing`, so every SQL
    write refuses until a read-back is recorded."""
    note(f"rollback: step 0's fresh fetch and steps 2 to 4 (the render to seq {k}, "
         f"--hold-marker's stop for the ruleset, and the push of seq {seq} with its read-back "
         f"and record_marker) are lane 3's T326, which this build does not have: nothing was "
         f"rendered or pushed, and the marker stays removing")
    return EXIT_OK


