#: since libpq reads 1 as 2 and 0 as no limit (Y:3810-3811); with none, `c` is
#: 2 on a register path. #160's index paths keep their 5 s (`PostgresStore`).
CONNECT_TIMEOUT_MIN = 2
CONNECT_TIMEOUT_DEFAULT = 2


def _pg_url_decode(text: str, what: str, part: str) -> str:
    """One URL part percent-decoded as libpq decodes it (`conninfo_uri_decode`):
    `%XX` only, so a `+` stays a `+`. A broken escape, a `%00` and bytes that
    are not UTF-8 are refused."""
    out = bytearray()
    i = 0
    while i < len(text):
        if text[i] != "%":
            out += text[i].encode("utf-8")
            i += 1
            continue
        pair = text[i + 1:i + 3]
        if len(pair) != 2 or not all(c in "0123456789abcdefABCDEF" for c in pair):
            raise Refusal(f"{what}: its {part} carries a `%` that is not a `%XX` escape")
        if pair == "00":
            raise Refusal(f"{what}: its {part} carries `%00`, which libpq refuses")
        out.append(int(pair, 16))
        i += 3
    try:
        return out.decode("utf-8")
    except UnicodeDecodeError:
        raise Refusal(f"{what}: its {part} does not decode as UTF-8")


def pg_url_env(url: str, what: str = "the URL") -> dict:
    """THE ONE MAPPING from a configured URL to the `PG*` variables of the
    `psql` child that connects with it (Question 11; SVC-2, design
    Y:3798-3819). No `lanes-index` path puts a connection string in an
    argument list, where `/proc` shows it for the process's life (Y:3491):
    each hands its child the variables this returns, and the service (U5)
    reuses it.

    The URL is libpq's own, read as `conninfo_uri_parse_options` reads it:
    `postgresql://` or `postgres://`, then `[user@]`, then hosts as
    `host[:port]` separated by commas (an IPv6 address in brackets), then
    `[/database]` and `[?name=value&...]`, each part percent-decoded. The hosts
    go to `PGHOST` and their ports to `PGPORT`, each a comma list as libpq
    keeps it, the database to `PGDATABASE`, the user to `PGUSER`, and each of
    `PG_URL_PARAMS` to its twin. Only what the URL names is returned.

    REFUSED, as `Refusal` (2), naming `what` and never printing the URL: a
    connection string of any other form; a password, in the user part or as
    `password=`; a query parameter outside the six, or one named twice; and a
    `connect_timeout` that is not a whole number of at least 2 seconds."""
    text = url.strip()
    prefix = next((p for p in ("postgresql://", "postgres://") if text.startswith(p)), "")
    if not prefix:
        raise Refusal(
            f"{what} is not a `postgresql://` URL. Every `psql` takes its connection "
            f"from `PG*` variables mapped from a URL's parts (SVC-2), never from a "
            f"connection string in its arguments")
    password = (f"{what} carries a password. The secret lives only in the 0600 libpq "
                f"password file, never in a URL a command line or a log can show")
    rest = text[len(prefix):]
    env: dict = {}
    # THE USER: the first `@` before any `/`, where libpq looks for it.
    at, slash = rest.find("@"), rest.find("/")
    if at != -1 and (slash == -1 or at < slash):
        userinfo, rest = rest[:at], rest[at + 1:]
        if ":" in userinfo:
            raise Refusal(password)
        user = _pg_url_decode(userinfo, what, "user")
        if user:
            env["PGUSER"] = user
    # THE HOSTS AND THEIR PORTS, each list joined by commas as libpq joins it.
    hosts, ports, i = [], [], 0
    while True:
        if rest[i:i + 1] == "[":
            end = rest.find("]", i + 1)
            if end in (-1, i + 1):
                raise Refusal(f"{what}: an IPv6 host's brackets are empty or never closed")
            host, i = rest[i + 1:end], end + 1
            if rest[i:i + 1] not in ("", ":", "/", "?", ","):
                raise Refusal(f"{what}: an IPv6 host's `]` is followed by an unexpected "
                              f"character")
        else:
            j = i
            while j < len(rest) and rest[j] not in ":/?,":
                j += 1
            host, i = rest[i:j], j
        port = ""
        if rest[i:i + 1] == ":":
            j = i + 1
            while j < len(rest) and rest[j] not in "/?,":
                j += 1
            port, i = rest[i + 1:j], j
        hosts.append(host)
        ports.append(port)
        if rest[i:i + 1] != ",":
            break
        i += 1
    if ",".join(hosts):
        env["PGHOST"] = _pg_url_decode(",".join(hosts), what, "host")
    if ",".join(ports):
        env["PGPORT"] = _pg_url_decode(",".join(ports), what, "port")
    # THE DATABASE, from the hosts' `/` to the query. An empty one is left
    # unset, as libpq leaves it.
    tail, query = rest[i:], ""
    if tail.startswith("/"):
        database, _mark, query = tail[1:].partition("?")
        if database:
            env["PGDATABASE"] = _pg_url_decode(database, what, "database")
    elif tail.startswith("?"):
        query = tail[1:]
    pieces = query.split("&") if query else []
    if pieces and pieces[-1] == "":
        pieces.pop()  # a trailing `&`, which libpq passes over
    seen = set()
    for piece in pieces:
        if piece.count("=") != 1:
            raise Refusal(f"{what}: a query parameter is not one `name=value`")
        raw_name, raw_value = piece.split("=")
        name = _pg_url_decode(raw_name, what, "query")
        if name == "password":
            raise Refusal(password)
        if name not in PG_URL_PARAMS:
            named = (f"`{name}=`" if re.fullmatch(r"[a-z_]{1,40}", name)
                     else "a name that is not a libpq keyword")
            raise Refusal(
                f"{what} carries the query parameter {named}, which no connection "
                f"carries: only {', '.join(PG_URL_PARAMS)} map to `PG*` variables (SVC-2)")
        if name in seen:
            raise Refusal(f"{what} names `{name}=` twice")
        seen.add(name)
        env[PG_URL_PARAMS[name]] = _pg_url_decode(raw_value, what, f"`{name}=`")
    if "PGCONNECT_TIMEOUT" in env:
        raw = env["PGCONNECT_TIMEOUT"]
        if not re.fullmatch(r"\s*[+-]?[0-9]+\s*", raw):
            raise Refusal(f"{what} carries a `connect_timeout=` that is not a whole number "
                          f"of seconds")
        if int(raw) < CONNECT_TIMEOUT_MIN:
            raise Refusal(
                f"{what} carries `connect_timeout={int(raw)}`, under "
                f"{CONNECT_TIMEOUT_MIN}: it is the workstation's `c` (D9), and libpq reads "
                f"1 as 2 and 0 as no limit")
        env["PGCONNECT_TIMEOUT"] = str(int(raw))
    return env


def _pg_host_stays_local(host: str) -> bool:
    """Whether libpq reaches one of `PGHOST`'s hosts without leaving this
    machine (R09; contract §2.5): a Unix socket - an empty host, which is
    libpq's default socket directory, or a host that decodes to an absolute
    path - or a loopback host, `localhost`, an address in 127.0.0.0/8, or
    ::1. Anything else is a TCP host that is not loopback, a name included,
    whatever it resolves to."""
    import ipaddress  # only the TLS check at load reads addresses

    if host == "" or host.startswith("/") or host.lower() == "localhost":
        return True
    try:
        address = ipaddress.ip_address(host)
    except ValueError:
        return False
    if address.version == 4:
        return address in ipaddress.ip_network("127.0.0.0/8")
    return address == ipaddress.IPv6Address("::1")


def pg_url_refuse_unverified_tls(env: dict, what: str) -> None:
    """THE TLS REFUSAL AT LOAD (FR-011; lane 3's R09 left it to lane 1, and
    lane 1's T104 takes it; contract §2.5). `env` is `pg_url_env`'s mapping of
    one URL. Where any of its hosts is a TCP host that is not loopback, the URL
    must carry `sslmode=verify-full` and an `sslrootcert=` that names an
    existing regular file, the root of the issuer that signs the server's
    certificate: libpq's default, `prefer`, verifies nothing (design Y:2324),
    and `system` is never that root, since no system store holds a private
    one (C7, Y:2324). A socket and a loopback host connect without it, so a
    local cluster and its 127.0.0.1 stand-ins keep working.

    REFUSED, as `Refusal` (2), naming `what` and everything missing, and
    printing no URL, no host and no root file's path."""
    hosts = env.get("PGHOST", "").split(",")
    if all(_pg_host_stays_local(host) for host in hosts):
        return
    missing = []
    if "PGSSLMODE" not in env:
        missing.append("its query carries no `sslmode=`, and libpq's default, `prefer`, "
                       "verifies nothing")
    elif env["PGSSLMODE"] != "verify-full":
        missing.append("its `sslmode=` is not `verify-full`, so the server is not verified "
                       "against its name")
    root = env.get("PGSSLROOTCERT", "")
    if not root:
        missing.append("its query carries no `sslrootcert=` naming the root file")
    elif root == "system":
        missing.append("its `sslrootcert=` is `system`, the system's store, which holds no "
                       "private root (C7)")
    else:
        try:
            regular = stat.S_ISREG(os.stat(root).st_mode)
            why = "" if regular else "it is not a regular file"
        except OSError as exc:
            regular, why = False, exc.strerror or "it cannot be read"
        if not regular:
            missing.append(f"its `sslrootcert=` names no existing regular file ({why})")
    if missing:
        raise Refusal(
            f"{what} names a TCP host that is not loopback, where a connection must "
            f"verify the server (FR-011): it needs `sslmode=verify-full` and an "
            f"`sslrootcert=` that names the root file of the issuer that signs the "
            f"server's certificate, never `system` (design Y:2324), but "
            f"{'; and '.join(missing)}. Only a Unix socket and a loopback host "
            f"(`localhost`, 127.0.0.0/8 or ::1) connect without them")


def _check_register_keys(cfg: dict, path: str) -> None:
    """007'S KEYS, EACH ON ITS OWN (FR-001; contracts/config.md section 4, R7,
    R11, R12 and R16), refused as `Refusal` (2). `register_addresses` and
    `register_rtt_ms` are made whole numbers in `cfg`."""
    # THE MODE (FR-001; Y:4849): `index` or `primary`, and absent is `index`.
    if cfg["mode"] not in ("index", "primary"):
        raise Refusal(f"`mode={cfg['mode']}` in {path}: the mode is `index` or `primary`")
    if not SCHEMA_NAME_RE.fullmatch(cfg["register_schema"]):
        raise Refusal(f"`register_schema={cfg['register_schema']}` in {path} is not a plain "
                      f"lower-case SQL identifier")
    # `N_a` AND THE ROUND TRIP (D9, Y:5877; SVC-6, Y:4005): each a whole number,
    # measured when the workstation joins.
    for key, least, what in (("register_addresses", 1, "`N_a`, the number of addresses "
                              "the register's endpoint resolves to (D9)"),
                             ("register_rtt_ms", 0, "the p90 of the workstation's round "
                              "trips to the register, in whole milliseconds (SVC-6)")):
        if not re.fullmatch(r"[0-9]+", cfg[key]) or int(cfg[key]) < least:
            raise Refusal(f"`{key}={cfg[key]}` in {path} is not a whole number of at least "
                          f"{least}: it is {what}")
        cfg[key] = int(cfg[key])
    for key, what in (("register_passfile", "the libpq password file"),
                      ("render_key", "the renderer's deploy-key file")):
        if cfg[key]:
            _check_private_file(cfg[key], f"{what} (`{key}=`)")


def _check_register_connections(cfg: dict, path: str, named_store: str, mapped: dict) -> None:
    """007'S RULES ACROSS KEYS (FR-001, FR-011; contracts/config.md section 4,
    R8, R9, R10 and R15), refused as `Refusal` (2). `named_store` is `store=`
    as the file wrote it, before its default; `mapped` holds `pg_url_env`'s
    mapping of each URL the file names."""
    # PRIMARY NEEDS THE REGISTER'S OWN DATABASE (FR-001): the register is shared
    # by every workstation, and SQLite is one disk.
    if cfg["mode"] == "primary":
        wrong = []
        if named_store == "sqlite":
            wrong.append("it names `store=sqlite`, and the register, which every "
                         "workstation shares, is never on one disk")
        if not cfg["register_url"]:
            wrong.append("it names no `register_url=`, the REGISTER-WRITER login the "
                         "register's writes connect as")
        if wrong:
            raise Refusal(f"`mode=primary` in {path} is refused: {'; and '.join(wrong)}")
    if not cfg["register_url"]:
        # #160'S FILE (US1): its `reader_url=` may name a TCP host with no TLS,
        # and it loads as it always has.
        return
    # THE REGISTER-WRITER PAIR, by the rule `PostgresStore` applies to `url=`:
    # a read never connects with the writer's credential.
    if not cfg["reader_url"]:
        raise Refusal(
            f"`register_url=` in {path} has no `reader_url=` beside it: the register's "
            f"reads connect only as this engineer's READER login, never with the "
            f"writer's credential (Amendment 14(c))")
    # THE TLS REFUSAL AT LOAD (R09; FR-011), of both URLs.
    pg_url_refuse_unverified_tls(mapped["register_url"], f"`register_url=` in {path}")
    pg_url_refuse_unverified_tls(mapped["reader_url"],
                                 f"`reader_url=` in {path}, beside its `register_url=`,")


def load_config() -> dict:
    """The per-workstation configuration, refused on any of clause (c)'s grounds,
    and on 007's (FR-001, FR-011; contracts/config.md section 4): `mode=` that
    is not `index` or `primary`; `mode=primary` naming `store=sqlite`, or with
    no `register_url=`; `register_url=` with no `reader_url=`; a
    `register_schema=` that is not a plain lower-case SQL identifier; a
    `register_addresses=` or `register_rtt_ms=` that is not a whole number; a
    `register_passfile=` or `render_key=` that is not a private regular file;
    and, where `register_url=` is set, R09's TLS refusal of it and of
    `reader_url=`. A file with no `register_url=` is #160's, and loads as it
    always has.

    While `RENDER_GIT_HALF` is False, `mode=primary` is refused as
    `PrimaryNotBuilt` (Q6(c), FR-003), after the file's own checks and each
    key's, and before the rules across keys, so `mode=primary` with
    `store=sqlite`, with no `register_url=` or with a URL R09 would refuse is
    Q6(c)'s refusal until the constant is set."""
    path, named = config_path()
    cfg = {"path": path, "present": False, "store": "", "url": "", "passfile": "",
           "reader_url": "", "reader_passfile": "", "sqlite": "", "schema": "lanes_index",
           # 007's keys (FR-001; Y:4849): absent `mode=` is `index`, today's behaviour.
           "mode": "index", "register_url": "", "register_passfile": "", "register_label": "",
           "register_schema": "lanes_register", "render_key": "", "register_addresses": "1",
           "register_rtt_ms": "0"}
    if not os.path.lexists(path):
        if named:
            raise Refusal(f"LANES_INDEX_CONFIG names {path}, which does not exist")
    else:
        cfg["present"] = True
        _check_private_file(path, "the configuration")
        # RESOLVED FIRST (Copilot round 1 on #164): a 0600 symlink outside every
        # repository that points at a committed file inside one is that file,
        # and its directory is the one the question is about.
        tree = git_work_tree_of(os.path.dirname(os.path.realpath(path)))
        if tree:
            raise Refusal(
                f"the configuration {path} is inside the git work tree {tree}: "
                f"connection settings are per workstation and never committed "
                f"(Amendment 14(c)). Move it to "
                f"${{XDG_CONFIG_HOME:-$HOME/.config}}/openRepoTools/lanes-index.conf")
        if _under(path, _agents_root()):
            raise Refusal(
                f"the configuration {path} is under {_agents_root()}, which on a "
                f"workstation built from the workspace repository IS that repository "
                f"(Amendment 14(c)). Move it to "
                f"${{XDG_CONFIG_HOME:-$HOME/.config}}/openRepoTools/lanes-index.conf")
        try:
            with open(path, encoding="utf-8") as handle:
                lines = handle.read().splitlines()
        except (OSError, UnicodeDecodeError) as exc:
            raise Refusal(f"the configuration {path} cannot be read: {exc}")
        known = ("store", "url", "passfile", "reader_url", "reader_passfile", "sqlite", "schema",
                 "mode", "register_url", "register_passfile", "register_label",
                 "register_schema", "render_key", "register_addresses", "register_rtt_ms")
        for number, raw in enumerate(lines, 1):
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if "=" not in line:
                raise Refusal(f"{path}:{number} is not `key=value`: {line!r}")
            key, value = (part.strip() for part in line.split("=", 1))
            if key not in known:
                raise Refusal(f"{path}:{number} names `{key}=`, which this indexer does not "
                              f"know (it reads {', '.join(k + '=' for k in known)})")
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            if value.startswith("~/"):
                value = os.path.join(_home(), value[2:])
            cfg[key] = value
    mapped = {}
    for key in ("url", "reader_url", "register_url"):
        if cfg[key] and _url_has_password(cfg[key]):
            raise Refusal(
                f"`{key}=` in {path} carries a password. The secret lives only in the "
                f"0600 libpq password file "
                f"`{'register_passfile' if key == 'register_url' else 'passfile'}=` names "
                f"(Amendment 14(c)), never in a URL a command line or a log can show")
        # MAPPED AT LOAD (Question 11; Y:4970, "`load_config` refuses any other
        # query parameter"): a URL SVC-2's mapping refuses is refused here, before
        # any command runs a `psql`, and never at a first connect.
        if cfg[key]:
            mapped[key] = pg_url_env(cfg[key], f"`{key}=` in {path}")
    named_store = cfg["store"]
    store = cfg["store"] or ("postgres" if cfg["url"] else "sqlite")
    if store not in ("sqlite", "postgres"):
        raise Refusal(f"`store={cfg['store']}` in {path}: the store is `sqlite` or `postgres`")
    if store == "postgres" and not cfg["url"]:
        raise Refusal(f"`store=postgres` in {path} names no `url=`")
    cfg["store"] = store
    if not SCHEMA_NAME_RE.match(cfg["schema"]):
        raise Refusal(f"`schema={cfg['schema']}` in {path} is not a plain lower-case SQL identifier")
    for key in ("passfile", "reader_passfile"):
        if cfg[key]:
            _check_private_file(cfg[key], f"the libpq password file (`{key}=`)")
    _check_register_keys(cfg, path)
    # Q6(c)'S REFUSAL (FR-003; Y:4849, Y:4872), once the file and every key in
    # it has passed on its own, and BEFORE the rules across keys: a `primary`
    # this build cannot serve is refused for that, whatever else the file
    # says. So test 14's refusing state, with `register_url=` on `db.invalid`
    # and no TLS, is 78 from `mode` and `register read`, never R15's 2.
    if cfg["mode"] == "primary" and not RENDER_GIT_HALF:
        raise PrimaryNotBuilt(MODE_PRIMARY_REFUSED_TEXT)
    _check_register_connections(cfg, path, named_store, mapped)
    if store == "sqlite":
        sqlite_path = cfg["sqlite"] or os.path.join(state_dir(), "lanes-index.sqlite")
        sqlite_path = os.path.abspath(sqlite_path)
        tree = git_work_tree_of(os.path.dirname(os.path.realpath(sqlite_path)))
        if tree:
            raise Refusal(
                f"the SQLite store {sqlite_path} would be inside the git work tree {tree}; "
                f"the index lives on local disk and never inside a work tree "
                f"(Amendment 14(c)). Name another path with `sqlite=`")
        cfg["sqlite"] = sqlite_path
    return cfg


def cmd_mode(args: list[str]) -> int:
    """`lanes-index mode` (contract §3.1; D3, Y:2441-2453; F8): this
    workstation's mode, `index` or `primary`, as ONE line on stdout and nothing
    else, exit 0. It reads only the configuration, through `load_config`, and
    opens no database and runs no `psql` (Y:3521).

    With no file at the default path, and `LANES_INDEX_CONFIG` unset or empty,
    it answers `index`, as does a file with no `mode=`. A configuration
    `load_config` refuses exits 2. `mode=primary` while `RENDER_GIT_HALF` is
    False exits `EXIT_CONFIG`, 78, with `MODE_PRIMARY_REFUSED_TEXT` on stderr
    and nothing on stdout. An argument is usage, 64, before anything is
    read. Its caller, `lanes-edit.sh` (lane 4's T409), reads 78 as "exit 69,
    writing nothing", and every other end as files mode with a warning."""
    for arg in args:
        if arg in ("-h", "--help"):
            say(USAGE)
            return EXIT_OK
        note(f"mode takes no argument, and was given '{arg}' - see {PROG} --help")
        return EXIT_USAGE
    try:
        cfg = load_config()
    except PrimaryNotBuilt as exc:
        note(str(exc))
        return EXIT_CONFIG
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return EXIT_REFUSED
    say(cfg["mode"])
    return EXIT_OK


