# =========================================================== configuration

def _home() -> str:
    return os.environ.get("HOME") or os.path.expanduser("~")


def config_path() -> tuple[str, bool]:
    """The configuration's path, and whether a person NAMED it.

    A named file that is not there is a refusal; the default path that is not
    there is the ordinary case, and means SQLite at its default path."""
    named = os.environ.get("LANES_INDEX_CONFIG", "")
    if named:
        return named, True
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(_home(), ".config")
    return os.path.join(base, "openRepoTools", "lanes-index.conf"), False


def state_dir() -> str:
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(_home(), ".local", "state")
    return os.path.join(base, "openRepoTools")


def git_work_tree_of(path: str) -> str:
    """The work tree `path` sits inside, or "" where it is in none.

    Asked of the nearest directory that EXISTS, because a store or a
    configuration not created yet is still a file that would land inside it."""
    probe = os.path.abspath(path)
    while probe and not os.path.isdir(probe):
        parent = os.path.dirname(probe)
        if parent == probe:
            return ""
        probe = parent
    try:
        proc = subprocess.run(["git", "-C", probe, "rev-parse", "--show-toplevel"],
                              capture_output=True, text=True, check=False,
                              stdin=subprocess.DEVNULL)
    except OSError:
        return ""
    if proc.returncode != 0:
        return ""
    return proc.stdout.strip()


def _agents_root() -> str:
    return os.environ.get("AGENT_PROTOCOL_ROOT") or os.path.join(_home(), ".agents")


def _under(path: str, root: str) -> bool:
    try:
        path_r = os.path.realpath(path)
        root_r = os.path.realpath(root)
    except OSError:
        return False
    return path_r == root_r or path_r.startswith(root_r.rstrip(os.sep) + os.sep)


def _url_has_password(url: str) -> bool:
    """A password in a libpq URL or keyword string, however it is spelled.

    `postgresql://user:secret@host/db`, `?password=secret`, and the keyword
    form `password=secret` are each a credential in a file that is not the
    password file - and a URL is what ends up in an argv, a log or a process
    listing."""
    low = url.strip()
    m = re.match(r"^[A-Za-z][A-Za-z0-9+.-]*://([^/?#]*)", low)
    if m:
        userinfo = m.group(1).rpartition("@")
        if userinfo[1] and ":" in userinfo[0]:
            return True
        query = low.split("?", 1)[1] if "?" in low else ""
        for part in re.split(r"[&;]", query):
            if part.split("=", 1)[0].strip().lower() == "password":
                return True
        return False
    return bool(re.search(r"(^|\s)password\s*=", low, re.IGNORECASE))


def _check_private_file(path: str, what: str) -> None:
    try:
        st = os.stat(path)
    except OSError as exc:
        raise Refusal(f"{what} {path} cannot be read: {exc.strerror or exc}")
    if not stat.S_ISREG(st.st_mode):
        raise Refusal(f"{what} {path} is not a regular file")
    if st.st_mode & 0o077:
        raise Refusal(
            f"{what} {path} is mode {oct(st.st_mode & 0o777)[2:]}, so another account "
            f"on this workstation can read it (Amendment 14(c): mode 0600). "
            f"Fix it: chmod 600 {path}")


def load_config() -> dict:
    """The per-workstation configuration, refused on any of clause (c)'s grounds."""
    path, named = config_path()
    cfg = {"path": path, "present": False, "store": "", "url": "", "passfile": "",
           "reader_url": "", "reader_passfile": "", "sqlite": "", "schema": "lanes_index"}
    if not os.path.lexists(path):
        if named:
            raise Refusal(f"LANES_INDEX_CONFIG names {path}, which does not exist")
    else:
        cfg["present"] = True
        _check_private_file(path, "the configuration")
        # RESOLVED FIRST (Copilot round 1 on #164): a 0600 symlink outside every
        # repository that points at a committed file inside one is that file,
        # and its directory is the one the question is about.
        tree = git_work_tree_of(os.path.dirname(os.path.realpath(path)))
        if tree:
            raise Refusal(
                f"the configuration {path} is inside the git work tree {tree}: "
                f"connection settings are per workstation and never committed "
                f"(Amendment 14(c)). Move it to "
                f"${{XDG_CONFIG_HOME:-$HOME/.config}}/openRepoTools/lanes-index.conf")
        if _under(path, _agents_root()):
            raise Refusal(
                f"the configuration {path} is under {_agents_root()}, which on a "
                f"workstation built from the workspace repository IS that repository "
                f"(Amendment 14(c)). Move it to "
                f"${{XDG_CONFIG_HOME:-$HOME/.config}}/openRepoTools/lanes-index.conf")
        try:
            with open(path, encoding="utf-8") as handle:
                lines = handle.read().splitlines()
        except (OSError, UnicodeDecodeError) as exc:
            raise Refusal(f"the configuration {path} cannot be read: {exc}")
        known = ("store", "url", "passfile", "reader_url", "reader_passfile", "sqlite", "schema")
        for number, raw in enumerate(lines, 1):
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if "=" not in line:
                raise Refusal(f"{path}:{number} is not `key=value`: {line!r}")
            key, value = (part.strip() for part in line.split("=", 1))
            if key not in known:
                raise Refusal(f"{path}:{number} names `{key}=`, which this indexer does not "
                              f"know (it reads {', '.join(k + '=' for k in known)})")
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            if value.startswith("~/"):
                value = os.path.join(_home(), value[2:])
            cfg[key] = value
    for key in ("url", "reader_url"):
        if cfg[key] and _url_has_password(cfg[key]):
            raise Refusal(
                f"`{key}=` in {path} carries a password. The secret lives only in the "
                f"0600 libpq password file `passfile=` names (Amendment 14(c)), never in "
                f"a URL a command line or a log can show")
    store = cfg["store"] or ("postgres" if cfg["url"] else "sqlite")
    if store not in ("sqlite", "postgres"):
        raise Refusal(f"`store={cfg['store']}` in {path}: the store is `sqlite` or `postgres`")
    if store == "postgres" and not cfg["url"]:
        raise Refusal(f"`store=postgres` in {path} names no `url=`")
    cfg["store"] = store
    if not SCHEMA_NAME_RE.match(cfg["schema"]):
        raise Refusal(f"`schema={cfg['schema']}` in {path} is not a plain lower-case SQL identifier")
    for key in ("passfile", "reader_passfile"):
        if cfg[key]:
            _check_private_file(cfg[key], f"the libpq password file (`{key}=`)")
    if store == "sqlite":
        sqlite_path = cfg["sqlite"] or os.path.join(state_dir(), "lanes-index.sqlite")
        sqlite_path = os.path.abspath(sqlite_path)
        tree = git_work_tree_of(os.path.dirname(os.path.realpath(sqlite_path)))
        if tree:
            raise Refusal(
                f"the SQLite store {sqlite_path} would be inside the git work tree {tree}; "
                f"the index lives on local disk and never inside a work tree "
                f"(Amendment 14(c)). Name another path with `sqlite=`")
        cfg["sqlite"] = sqlite_path
    return cfg


# =============================================================== the source

def lanes_edit_path() -> str:
    """`$LANES_EDIT`, else the `lanes-edit.sh` beside this file, else PATH -
    the order `lanes` already finds its reader in."""
    named = os.environ.get("LANES_EDIT", "")
    if named:
        return named
    here = os.path.join(os.path.dirname(os.path.realpath(__file__)), "lanes-edit.sh")
    if os.access(here, os.X_OK):
        return here
    return shutil.which("lanes-edit.sh") or ""


def helper_env() -> dict:
    """The environment `lanes-edit.sh` is run in from here: the caller's own,
    with the fetch, GitHub and the index switched off. This process reads what
    landed and reaches no network, and a helper run from inside the indexer
    must never start an indexer."""
    env = dict(os.environ)
    env["LANES_NO_FETCH"] = "1"
    env["LANES_NO_GITHUB"] = "1"
    env["LANES_INDEX"] = "off"
    return env


def workspace_root() -> str:
    helper = lanes_edit_path()
    if not helper:
        raise StoreUnusable("unread", "no lanes-edit.sh beside this file or on PATH, so the "
                            "workspace repository cannot be found (Amendment 9(a))")
    proc = subprocess.run([helper, "workspace-root"], capture_output=True, text=True,
                          check=False, env=helper_env(), stdin=subprocess.DEVNULL)
    root = proc.stdout.strip()
    if proc.returncode != 0 or not root:
        why = (proc.stderr.strip().splitlines() or ["no answer"])[0]
        raise StoreUnusable("unread", f"`lanes-edit.sh workspace-root` exited "
                            f"{proc.returncode}: {why}")
    return root


def _norm_repo(text: str) -> str:
    u = text.strip()
    if u.endswith(".git"):
        u = u[:-4]
    for prefix in ("https://github.com/", "ssh://git@github.com/", "git@github.com:",
                   "http://github.com/"):
        if u.startswith(prefix):
            return u[len(prefix):]
    return u


def source_of(root: str) -> str:
    """`register:<owner/repo>` - the `repository:` this workstation's
    `workspace.yaml` names, which is how every lane helper names the workspace
    (Amendment 9(a)); its checkout's `origin` where that file does not answer."""
    yaml = os.path.join(_agents_root(), "workspace.yaml")
    repo = ""
    try:
        with open(yaml, encoding="utf-8") as handle:
            for raw in handle:
                m = re.match(r"^repository:[ \t]*(.*)$", raw.rstrip("\n"))
                if m:
                    repo = re.sub(r"[ \t]*#.*$", "", m.group(1)).strip().strip("\"'")
                    break
    except OSError:
        repo = ""
    if not repo:
        proc = git(root, "remote", "get-url", "origin", check=False)
        repo = proc.stdout.strip()
    repo = _norm_repo(repo) or os.path.basename(root)
    return f"register:{repo}"


def branch() -> str:
    return os.environ.get("LANES_BRANCH") or "main"


def git(root: str, *args: str, check: bool = True, data: bytes | None = None,
        text: bool = True) -> subprocess.CompletedProcess:
    proc = subprocess.run(["git", "-C", root, *args], capture_output=True,
                          check=False, input=data, text=text if data is None else False,
                          stdin=None if data is not None else subprocess.DEVNULL)
    if check and proc.returncode != 0:
        err = proc.stderr if isinstance(proc.stderr, str) else proc.stderr.decode("utf-8", "replace")
        raise StoreUnusable("unread", f"git {' '.join(args)} failed in {root}: "
                            f"{(err.strip().splitlines() or ['no message'])[-1]}")
    return proc


def tip_of(root: str) -> str:
    proc = git(root, "rev-parse", "--verify", "-q", f"refs/remotes/origin/{branch()}^{{commit}}",
               check=False)
    sha = proc.stdout.strip()
    if proc.returncode != 0 or not SHA_RE.match(sha):
        raise StoreUnusable("unread", f"{root} has no origin/{branch()}: nothing has landed "
                            f"there for the index to follow")
    return sha


def has_commit(root: str, sha: str) -> bool:
    return git(root, "cat-file", "-e", f"{sha}^{{commit}}", check=False).returncode == 0


def is_ancestor(root: str, old: str, new: str) -> bool:
    return git(root, "merge-base", "--is-ancestor", old, new, check=False).returncode == 0


def commits_between(root: str, old: str, new: str) -> int | None:
    if not has_commit(root, old):
        return None
    proc = git(root, "rev-list", "--count", f"{old}..{new}", check=False)
    try:
        return int(proc.stdout.strip())
    except ValueError:
        return None


def _decode(blob: bytes) -> str:
    return blob.decode("utf-8", "replace")


def read_snapshot(root: str, sha: str) -> dict:
    """Every file the index derives from, AS OF ONE COMMIT.

    The log list is `git ls-tree <sha> -- lanes/log/` in ITS order, which is the
    order `lanes-edit.sh`'s own published read walks them in - and that order is
    kept, because a reader built on the index has to produce the same stream."""
    snap = {"sha": sha, "register": None, "aliases": None, "archive": None, "logs": [],
            "blobs": {}}
    wanted = []
    proc = git(root, "ls-tree", "-z", sha, "--", REGISTER_PATH, ALIASES_PATH, ARCHIVE_PATH)
    for entry in proc.stdout.split("\0"):
        if not entry:
            continue
        meta, _, path = entry.partition("\t")
        _mode, kind, obj = meta.split()
        if kind != "blob":
            continue
        wanted.append((path, obj))
    logs = []
    proc = git(root, "ls-tree", "-z", sha, "--", LOG_PREFIX)
    for entry in proc.stdout.split("\0"):
        if not entry:
            continue
        meta, _, path = entry.partition("\t")
        _mode, kind, obj = meta.split()
        if kind != "blob":
            continue
        if path.rsplit("/", 1)[-1] == "README.md":
            continue
        logs.append((path, obj))
        wanted.append((path, obj))
    contents = cat_blobs(root, [obj for _path, obj in wanted])
    for path, obj in wanted:
        text = _decode(contents.get(obj, b""))
        snap["blobs"][path] = obj
        if path == REGISTER_PATH:
            snap["register"] = text
        elif path == ALIASES_PATH:
            snap["aliases"] = text
        elif path == ARCHIVE_PATH:
            snap["archive"] = text
    for order, (path, obj) in enumerate(logs):
        snap["logs"].append((path, _decode(contents.get(obj, b"")), obj, order))
    if snap["register"] is None:
        raise StoreUnusable("unread", f"{sha[:12]} carries no {REGISTER_PATH}")
    return snap


def cat_blobs(root: str, objs: list[str]) -> dict:
    """The bytes of every blob named, in ONE `git cat-file --batch`."""
    out: dict = {}
    unique = list(dict.fromkeys(objs))
    if not unique:
        return out
    proc = git(root, "cat-file", "--batch", data=("\n".join(unique) + "\n").encode(), text=False)
    buf = proc.stdout
    pos = 0
    for obj in unique:
        nl = buf.index(b"\n", pos)
        header = buf[pos:nl].decode("ascii", "replace").split()
        pos = nl + 1
        if len(header) < 3 or header[1] == "missing":
            continue
        size = int(header[2])
        out[obj] = buf[pos:pos + size]
        pos += size + 1
    return out


# ============================================================== the parsers
#
# THE LOG GRAMMAR IS `lanes-edit.sh`'s `LOG_AWK`, PORTED LINE FOR LINE. A
# parser of this file's own that disagreed with that one would make `history
# --index` print a different diary from `history`, which is the one thing the
# read flag promises it does not. Every test, every trim and every reason for
# an unreadable line below is that awk's; `tests/test_lanes_index.py` holds the
# two to one output over the same logs.

def _trim(text: str) -> str:
    return text.strip(" \t")


def file_lane(path: str) -> str:
    base = path.rsplit("/", 1)[-1]
    return re.sub(r"\.[Mm][Dd]$", "", base)


def parse_log_line(line: str):
    """None for a line the grammar skips (a comment or a blank), a dict with
    `bad` for one it cannot read, else the parsed fields."""
    if re.match(r"^[ \t]*#", line) or re.match(r"^[ \t]*$", line):
        return None
    i = line.find(" — ")
    if i < 0:
        return {"bad": 'no " — " after the verb'}
    verb = _trim(line[:i])
    rest = line[i + 3:]
    if " " in verb:
        return {"bad": f'the verb is one token: "{verb}"'}
    if not rest.startswith("lane "):
        return {"bad": 'no "lane <name>" field'}
    rest = rest[5:]
    q = rest.find(",")
    if q < 0:
        return {"bad": 'no "," after the lane'}
    written_lane = _trim(rest[:q])
    rest = _trim(rest[q + 1:])
    if not rest.startswith("session "):
        return {"bad": 'no "session <uuid>@<ws>" field'}
    rest = rest[8:]
    q = rest.find(",")
    if q < 0:
        return {"bad": 'no "," after the session'}
    sess = _trim(rest[:q])
    rest = _trim(rest[q + 1:])
    a = sess.find("@")
    uuid = sess[:a] if a >= 0 else sess
    ws = sess[a + 1:] if a >= 0 else ""
    m = UTC_RE.match(rest)
    if not m:
        return {"bad": "no YYYY-MM-DDTHH:MM[:SS]Z"}
    utc = m.group(0)
    rest = rest[m.end():]
    if not rest.startswith(","):
        return {"bad": 'no "," and object after the UTC'}
    rest = _trim(rest[1:])
    sp = rest.find(" ")
    if sp < 0:
        obj, rest = rest, ""
    else:
        obj, rest = rest[:sp], rest[sp + 1:]
    ref = payload = txt = ""
    if rest != "":
        if rest.startswith("— "):
            txt = _trim(rest[2:])
        else:
            j = rest.find(" — ")
            if j >= 0:
                txt = _trim(rest[j + 3:])
                rest = _trim(rest[:j])
            if rest.startswith("→ "):
                ref, payload = "→", _trim(rest[2:])
            elif rest.startswith("← "):
                ref, payload = "←", _trim(rest[2:])
            else:
                payload = _trim(rest)
    return {"verb": verb, "written_lane": written_lane, "uuid": uuid, "ws": ws, "utc": utc,
            "object": obj, "ref": ref, "payload": payload, "text": txt}


def payload_fields(payload: str) -> dict:
    """`payload_subfield`'s split: `; `-separated sub-fields, the first token
    the name, a quoted value taken whole, and the FIRST of a repeated name wins
    exactly as that reader's `exit` makes it."""
    fields: dict = {}
    if not payload:
        return fields
    for piece in payload.split("; "):
        name, _, value = piece.partition(" ")
        if not name or name in fields:
            continue
        value = _trim(value)
        if value.startswith('"'):
            q = value.find('"', 1)
            if q > 0:
                value = value[1:q]
        fields[name] = value
    return fields


def parse_log(path: str, text: str) -> tuple[list, list]:
    """The log's records - one per line the grammar does not skip, unreadable
    ones INCLUDED - and the warnings `LOG_AWK` prints for it."""
    lane = file_lane(path)
    records, warnings = [], []
    for ordinal, line in enumerate(text.split("\n"), 1):
        parsed = parse_log_line(line)
        if parsed is None:
            continue
        rec = {"lane": lane, "file": path, "ordinal": ordinal, "raw": line}
        if "bad" in parsed:
            rec.update(unreadable=1, unreadable_why=parsed["bad"])
            warnings.append(f"unreadable: {path}:{ordinal} ({parsed['bad']})")
        else:
            obj = parsed["object"]
            if lane and obj.startswith("lane:"):
                obj = "lane:" + lane
            rec.update(unreadable=0, unreadable_why=None, verb=parsed["verb"],
                       written_lane=parsed["written_lane"], session=parsed["uuid"],
                       workstation=parsed["ws"], utc=parsed["utc"], object=obj,
                       ref=parsed["ref"], payload=parsed["payload"],
                       free_text=parsed["text"])
        records.append(rec)
    if warnings:
        warnings.append(f"{len(warnings)} unreadable line(s) above — an append-only log is "
                        f"never rewritten, so a line no parser reads is a hold no tool will "
                        f"mention again")
    return records, warnings


def row_name(line: str) -> str | None:
    """`ROW_AWK`'s rule: a line opening with `|` whose first backticked token
    is the lane. None where the line is not a row by that rule."""
    if not line.startswith("|"):
        return None
    p1 = line.find("`")
    if p1 < 0:
        return None
    rest = line[p1 + 1:]
    p2 = rest.find("`")
    if p2 < 0:
        return None
    return rest[:p2]


def cell_state(row: str) -> str:
    """`LANES_REGISTER_INDEX_AWK`'s `cell_state`: six ` | ` from the left or it
    is not knowable which text is the state cell, and then the last piece."""
    row = row.rstrip(" \t")
    if not row.startswith("|") or not row.endswith("|"):
        return ""
    rest = row[:-1]
    for _ in range(6):
        i = rest.find(" | ")
        if i < 0:
            return ""
        rest = rest[i + 3:]
    if " | " in rest:
        return ""
    return rest


REGISTER_KIND_RE = re.compile(r"^(HOLD RELEASED|HOLD|LANDING|LANDED)[ \t]+(—|-)[ \t]")


def parse_register_line(line: str) -> dict | None:
    """Rule 6's `LANDING`/`LANDED` and Amendment 10's `HOLD`/`HOLD RELEASED`.

    The kind is the line's own first word(s); every other field is read the way
    `RULE6_AWK` reads it, best effort, because a `HOLD` is free text by
    Amendment 10(e) and the raw line is kept beside whatever was found."""
    m = REGISTER_KIND_RE.match(line)
    if not m:
        return None
    fields = {"kind": m.group(1), "lane": None, "repo": None, "pr": None, "tip": None,
              "utc": None, "session": None}
    lm = re.search(r"lane ([A-Za-z0-9._-]+)", line)
    if lm:
        fields["lane"] = lm.group(1)
    pm = re.search(r"PR #([0-9]+)", line) or re.search(r"#([0-9]+)", line)
    if pm:
        fields["pr"] = pm.group(1)
    rm = re.search(r"into ([A-Za-z0-9/._-]+) main", line) or \
        re.search(r"([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+) main\b", line)
    if rm:
        fields["repo"] = rm.group(1)
    um = UTC_RE.search(line)
    if um:
        fields["utc"] = um.group(0)
    sm = re.search(r"session ([^,@ ]+)@", line)
    if sm:
        fields["session"] = sm.group(1)
    tm = re.search(r"→ ([0-9a-f]{7,40})\b", line) or re.search(r" main ([0-9a-f]{7,40})\b", line)
    if tm:
        fields["tip"] = tm.group(1)
    return fields


# ======================================================== the records built

TABLE_COLUMNS = {
    "source_files": ["kind", "lane", "ls_order", "blob_sha", "line_count", "unreadable_count"],
