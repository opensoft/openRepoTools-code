75 register busy, and 78 for Q6(c)'s refusal from `mode` and `register read`;
each subcommand's codes are contracts/exit-codes.md's."""


def main(argv: list[str]) -> int:
    if not argv:
        sys.stderr.write(USAGE + "\n")
        return 64
    if argv[0] in ("-h", "--help", "help"):
        say(USAGE)
        return 0
    if argv[0] == "--version":
        say(f"{PROG} {VERSION} (schema {SCHEMA_VERSION})")
        return 0
    verb, args = argv[0], argv[1:]
    # `ready` (T119), the operator tools' readiness check, to its own parser.
    if verb == "ready":
        return cmd_ready(args)
    # FEATURE 007'S `render --revert <sha>` (T324), S2's renderer's revert: its
    # own parser, which takes no other flag, `--checkout` included.
    if verb == "render" and any(a == "--revert" or a.startswith("--revert=") for a in args):
        return cmd_render_revert(args)
    # FEATURE 007'S `render --checkout <c>` (T321): its own parser, ahead of
    # #160's argument loop. Any other `render` form is not this one's.
    if verb == "render" and any(a == "--checkout" or a.startswith("--checkout=") for a in args):
        return _render_checkout_main(args)
    # 007'S SUBCOMMANDS (opensoft/openRepoTools#165): one dispatch line each,
    # ahead of #160's argument loop, to the subcommand's own parser.
    if verb == "cutover":
        return cmd_cutover(args)
    if verb == "rollback":
        return cmd_rollback(args)
    # `import --single <sha>` (T324), S2's single-write import: its own parser,
    # ahead of T115's, which takes no other flag beside it.
    if verb == "import" and any(a == "--single" or a.startswith("--single=") for a in args):
        return cmd_import_single(args)
    if verb == "import":
        return cmd_import(args)
    if verb == "mode":
        return cmd_mode(args)
    if verb == "outage":
        return cmd_outage(args)
    if verb == "register" and args[:1] == ["snapshot"]:
        return cmd_register_snapshot(args[1:])
    if verb == "register" and args[:1] == ["classify"]:
        return cmd_register_classify(args[1:])
    if verb == "register" and args[:1] == ["read"]:
        return cmd_register_read(args[1:])
    if verb == "render":
        return cmd_render(args)
    if verb == "bootstrap":
        return cmd_bootstrap(args)
    if verb == "set-mode":
        return cmd_set_mode(args)
    if verb == "login":
        return cmd_login(args)
    if verb == "register" and args[:1] == ["commit"]:
        return cmd_register_commit(args[1:])
    if verb == "journal":
        return cmd_journal(args)
    # A SUBCOMMAND THIS BUILD DOES NOT HAVE, one of 007's not built yet among
    # them, is usage before any argument is read: it does nothing and says so,
    # and the 64 is what F8 reads from a `lanes-index` too old to have a verb.
    if verb not in ("sync", "reconcile", "status", "export"):
        note(f"unknown subcommand '{verb}': this build does not have it - see {PROG} --help")
        return EXIT_USAGE
    source = None
    dry_run = False
    worktrees = False
    out_dir = None
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-h", "--help"):
            say(USAGE)
            return 0
        if arg == "--source" or arg.startswith("--source="):
            value = arg.split("=", 1)[1] if "=" in arg else (args[i + 1] if i + 1 < len(args) else "")
            if not value:
                note("--source needs a value: register:<owner/repo>")
                return 64
            source = value
            i += 1 if "=" in arg else 2
            continue
        if (arg == "--out" or arg.startswith("--out=")) and verb == "export":
            value = arg.split("=", 1)[1] if "=" in arg else (args[i + 1] if i + 1 < len(args) else "")
            if not value:
                note("--out needs a directory")
                return 64
            out_dir = value
            i += 1 if "=" in arg else 2
            continue
        if arg == "--dry-run" and verb == "reconcile":
            dry_run = True
            i += 1
            continue
        if arg == "--worktrees" and verb == "export":
            worktrees = True
            i += 1
            continue
        note(f"unknown argument '{arg}' for {verb} - see {PROG} --help")
        return 64
    try:
        if verb == "sync":
            return cmd_sync(source)
        if verb == "reconcile":
            return cmd_reconcile(source, dry_run)
        if verb == "status":
            if source:
                note("status takes no --source; it prints every source the store holds")
                return 64
            return cmd_status()
        if verb == "export":
            if not out_dir:
                note("export needs --out <dir>")
                return 64
            if worktrees and source:
                note("export --worktrees reads every inventory source the store holds; it "
                     "takes no --source")
                return 64
            return cmd_export(out_dir, source, worktrees)
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return 2
    except StoreUnusable as exc:
        note(f"{exc.kind}: {exc.detail}")
        return 1
    note(f"unknown subcommand '{verb}' - see {PROG} --help")
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
