#: THE SCHEMA THIS READER AND WRITER KNOW. A store carrying another number is
#: never written by this file and never read by `export`: an older indexer
#: overwriting a newer schema's rows, or a reader guessing at them, is a second
#: way for the index to be wrong.
SCHEMA_VERSION = 1

US = "\x1f"
LANES_DIR = "lanes/"
REGISTER_PATH = "lanes/LANES.md"
ALIASES_PATH = "lanes/aliases.tsv"
ARCHIVE_PATH = "lanes/archive/LANES-retired.md"
LOG_PREFIX = "lanes/log/"

UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
UUID_FULL_RE = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")
UTC_RE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?Z")
SHA_RE = re.compile(r"^[0-9a-f]{40}$")
SCHEMA_NAME_RE = re.compile(r"^[a-z_][a-z0-9_]{0,62}$")
OPEN_VERBS = ("CLAIMED", "TAKEOVER", "OPENED", "LANDING", "WITHDRAWN")
INVENTORY_PREFIX = "inventory:"


class Refusal(Exception):
    """A refusal: exit 2, nothing read and nothing written."""


class StoreUnusable(Exception):
    """The store cannot answer: missing, unreachable, wiped or another schema.

    `kind` is the first word of the `read: sources (index <why>)` line."""

    def __init__(self, kind: str, detail: str):
        super().__init__(f"{kind}: {detail}")
        self.kind = kind
        self.detail = detail


class CasLost(Exception):
    """The source's provenance moved under this sync: nothing was written."""


class SourceMoved(Exception):
    """`origin/<branch>` moved while this sync read it: nothing was written,
    and the caller reads the new tip whole."""


