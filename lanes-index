#: The variables that move where git finds a repository. A `git -C <dir>` this
#: file runs is asked of `<dir>` and of nowhere else, so none of them reaches
#: it (`git_location_free_env`); `register commit` also drops them from its
#: own process before `tree/` is read.
_REGISTER_GIT_LOCATION = ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_OBJECT_DIRECTORY",
                          "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_COMMON_DIR", "GIT_NAMESPACE",
                          "GIT_CEILING_DIRECTORIES")


def git_location_free_env() -> dict:
    """A copy of this process's environment without any name in
    `_REGISTER_GIT_LOCATION`, for the `env=` of a call that runs git.

    LINE R (opensoft/openRepoTools#165, comment 6775233959): git sets
    `GIT_DIR` for its hooks, so a register command run from one met a `GIT_DIR`
    that made `git -C <dir> rev-parse --show-toplevel` answer `GIT_WORK_TREE`,
    or `<dir>` itself where only `GIT_DIR` was set, for every `<dir>`, and
    `load_config` refused its own configuration with 2. The copy is made per
    call and `os.environ` is left as it is."""
    env = dict(os.environ)
    for name in _REGISTER_GIT_LOCATION:
        env.pop(name, None)
    return env


def git_work_tree_of(path: str) -> str:
    """The work tree `path` sits inside, or "" where it is in none.

    Asked of the nearest directory that EXISTS, because a store or a
    configuration not created yet is still a file that would land inside it.
    Git is run without the variables that move where it finds a repository
    (`git_location_free_env`), so a `GIT_DIR` a hook passed on never answers for `path`."""
    probe = os.path.abspath(path)
    while probe and not os.path.isdir(probe):
        parent = os.path.dirname(probe)
        if parent == probe:
            return ""
        probe = parent
    try:
        proc = subprocess.run(["git", "-C", probe, "rev-parse", "--show-toplevel"],
                              capture_output=True, text=True, check=False,
                              stdin=subprocess.DEVNULL, env=git_location_free_env())
    except OSError:
        return ""
    if proc.returncode != 0:
        return ""
    return proc.stdout.strip()


