def _render_in_container() -> bool:
    """`lanes-edit.sh`'s `lanes_in_container` (ecd1bce :926-932):
    `LANES_IN_CONTAINER` at 1 or 0 forces the answer (its test seam, which
    nothing else sets), and otherwise `/.dockerenv` or `/run/.containerenv`
