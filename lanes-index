    "source_files": ["kind", "lane", "ls_order", "blob_sha", "line_count", "unreadable_count"],
    "lanes": ["lane", "aliases", "home", "workstation", "started_utc", "handoff_path",
              "state_phrase", "objects_cell", "session_ids", "last_session", "archived",
              "owner", "row_file", "row_ordinal", "row_text"],
    "log_lines": ["lane", "file", "ordinal", "verb", "session", "workstation", "utc", "object",
                  "ref", "payload", "payload_fields", "free_text", "written_lane", "unreadable",
                  "unreadable_why", "raw"],
    "register_lines": ["kind", "lane", "repo", "pr", "tip", "utc", "session", "ordinal", "raw"],
    "lane_aliases": ["old_name", "new_name", "utc", "ordinal", "raw"],
    "transcript_pointers": ["lane", "kind", "transcript_id", "agent", "position", "workstation",
                            "estate", "profile_family", "resolved_store", "project_key",
                            "parent_uuid", "size_bytes", "sha256", "sealed_utc"],
    # THE LEDGER HALF'S OWN TABLES, created EMPTY: T058 of the 001 feature
    # writes them under `ledger:<Workstation>` (Amendment 14(g) act 4), and this
    # indexer writes nothing into them.
    "swap_states": ["lane", "parent_uuid", "generation", "state", "observed_utc"],
    "job_summaries": ["lane", "job_id", "result_summary", "observed_utc"],
    # opensoft/openRepoTools#161: each lane's #97 worktree inventory under
    # `inventory:<Workstation>`, keyed by (source, lane, path) - the record id
    # `<lane>:<path>`, `<lane>:<path><US><n>` for a second tree of one lane with
    # the same path, and `<lane>:<US>unread` for a lane's unread marker (#173).
    # Amendment 14(e) left inventories to "a later word's"; #161
    # is that word's issue. Created by schema 1 with these columns before a row
    # was written into it, so no store needed a new version for it. Written by
    # `run_inventory` and by nothing that reads the register.
    "worktrees": ["workstation", "lane", "owner", "path", "branch", "base", "lifecycle",
                  "generation", "operation", "writer_live", "last_seen_utc", "last_commit",
                  "dirty_count", "unpushed_count", "pr_number", "pr_state"],
}

INTEGER_COLUMNS = {"ls_order", "line_count", "unreadable_count", "archived", "row_ordinal",
                   "ordinal", "unreadable", "position", "size_bytes", "generation",
                   "writer_live", "dirty_count", "unpushed_count", "pr_number"}

#: The tables `sync` and `reconcile` write for the REGISTER. The ledger's two
#: are T058's, and `worktrees` is the inventory source's alone.
REGISTER_TABLES = ("source_files", "lanes", "log_lines", "register_lines", "lane_aliases",
                   "transcript_pointers")


def digest_of(table: str, record: dict) -> str:
    content = [table] + [record.get(col) for col in TABLE_COLUMNS[table]]
    blob = json.dumps(content, ensure_ascii=False, separators=(",", ":"), sort_keys=False)
    return hashlib.sha256(blob.encode("utf-8")).hexdigest()


def build_records(snap: dict) -> dict:
    """Every record of the register half at one commit, WITHOUT the owner
    column: the owner is `managed-projection`'s answer, asked separately."""
    out = {table: {} for table in REGISTER_TABLES}

    def put(table: str, record_id: str, record: dict) -> None:
        out[table][record_id] = record

    # ---- the files themselves
    for path, kind in ((REGISTER_PATH, "register"), (ALIASES_PATH, "aliases"),
                       (ARCHIVE_PATH, "archive")):
        text = snap.get(kind)
        if text is None:
            continue
        put("source_files", path, {"kind": kind, "lane": None, "ls_order": None,
                                   "blob_sha": snap["blobs"].get(path),
                                   "line_count": len(text.split("\n")),
                                   "unreadable_count": None})

    # ---- the logs, every line, the unreadable ones kept (7(b))
    facts: dict = {}
    first_log_of: dict = {}
    for path, text, obj, order in snap["logs"]:
        records, _warnings = parse_log(path, text)
        lane = file_lane(path)
        first_log_of.setdefault(lane.lower(), lane)
        unreadable = 0
        for rec in records:
            rec_id = f"{rec['lane']}:{rec['ordinal']}"
            # TWO FILES WHOSE NAMES DIFFER ONLY BY CASE are two logs for one
            # lane - Amendment 15(d)'s hand merge - and each keeps its lines
            # under its own spelling, so neither file's lines replace the other's.
            if rec_id in out["log_lines"]:
                rec_id = f"{rec['file']}:{rec['ordinal']}"
            if rec["unreadable"]:
                unreadable += 1
                row = {col: None for col in TABLE_COLUMNS["log_lines"]}
                row.update(lane=rec["lane"], file=rec["file"], ordinal=rec["ordinal"],
                           unreadable=1, unreadable_why=rec["unreadable_why"], raw=rec["raw"])
            else:
                row = {col: rec.get(col) for col in TABLE_COLUMNS["log_lines"]}
                row["payload_fields"] = json.dumps(payload_fields(rec["payload"]),
                                                   ensure_ascii=False, sort_keys=False)
            put("log_lines", rec_id, row)
            if rec["unreadable"]:
                continue
            f = facts.setdefault(lane.lower(), {"home": None, "sid": None, "paused": []})
            fork = rec["payload"].startswith("fork ")
            if rec["verb"] in ("STARTED", "RESUMED") and not fork:
                hm = re.search(r"home [^ ;]+", rec["payload"])
                if hm:
                    value = hm.group(0)[5:]
                    if value != "unknown":
                        f["home"] = value
            if rec["verb"] in ("PAUSED", "RESUMED") and UUID_FULL_RE.match(rec["session"] or ""):
                f["sid"] = rec["session"].lower()
            if rec["verb"] == "PAUSED":
                pf = payload_fields(rec["payload"])
                if "transcript" in pf:
                    f["paused"].append((rec["file"], rec["ordinal"], pf.get("transcript"),
                                        pf.get("agent")))
        put("source_files", path, {"kind": "log", "lane": lane, "ls_order": order,
                                   "blob_sha": obj, "line_count": len(text.split("\n")),
                                   "unreadable_count": unreadable})

    # ---- the register: its rows and its Rule 6 / Amendment 10 lines
    rows = []
    for ordinal, line in enumerate(snap["register"].split("\n"), 1):
        name = row_name(line)
        if name is not None:
            if name != "":
                rows.append((REGISTER_PATH, ordinal, name, line, 0))
            continue
        fields = parse_register_line(line)
        if fields is not None:
            fields["ordinal"] = ordinal
            fields["raw"] = line
            put("register_lines", str(ordinal), fields)
    if snap.get("archive") is not None:
        for ordinal, line in enumerate(snap["archive"].split("\n"), 1):
            name = row_name(line)
            if name:
                rows.append((ARCHIVE_PATH, ordinal, name, line, 1))

    # ---- Amendment 16(e)'s alias table, every line kept
    alias_map: dict = {}
    if snap.get("aliases") is not None:
        for ordinal, line in enumerate(snap["aliases"].split("\n"), 1):
            if line.strip() == "":
                continue
            parts = line.split("\t")
            old = _trim(parts[0]) if parts else ""
            new = _trim(parts[1]) if len(parts) > 1 else ""
            when = _trim(parts[2]) if len(parts) > 2 else ""
            comment = bool(re.match(r"^[ \t]*#", line))
            put("lane_aliases", str(ordinal), {
                "old_name": None if comment else (old or None),
                "new_name": None if comment else (new or None),
                "utc": None if comment else (when or None), "ordinal": ordinal, "raw": line})
            if not comment and old and new:
                alias_map[old.lower()] = (old, new, ordinal)

    def resolve(name: str) -> str:
        seen = set()
        cur = name
        while cur.lower() in alias_map and cur.lower() not in seen:
            seen.add(cur.lower())
            cur = alias_map[cur.lower()][1]
        return cur

    aliases_of: dict = {}
    for _key, (old, _new, ordinal) in sorted(alias_map.items(), key=lambda kv: kv[1][2]):
        aliases_of.setdefault(resolve(old).lower(), []).append(old)

    # ---- one record per lane: every row, then every log with no row
    used_lower: set = set()
    for row_file, ordinal, name, line, archived in rows:
        rec_id = name
        if rec_id in out["lanes"]:
            rec_id = f"{name}~{'archive' if archived else 'register'}:{ordinal}"
        parts = line.split("|")
        session_cell = parts[2] if len(parts) > 2 else ""
        ids = UUID_RE.findall(session_cell.lower())
        f = facts.get(name.lower(), {})
        state = cell_state(line)
        put("lanes", rec_id, {
            "lane": name,
            "aliases": json.dumps(aliases_of.get(name.lower(), []), ensure_ascii=False),
            "home": f.get("home"),
            "workstation": _trim(parts[3]) if len(parts) > 3 else None,
            "started_utc": _trim(parts[4]) if len(parts) > 4 else None,
            "objects_cell": _trim(parts[5]) if len(parts) > 5 else None,
            "handoff_path": _trim(parts[6]) if len(parts) > 6 else None,
            "state_phrase": _trim(state) if state else None,
            "session_ids": json.dumps(ids),
            "last_session": ids[-1] if ids else f.get("sid"),
            "archived": archived, "owner": None,
            "row_file": row_file, "row_ordinal": ordinal, "row_text": line})
        used_lower.add(name.lower())
        cell_ids = ids
        for position, tid in enumerate(cell_ids, 1):
            put("transcript_pointers", f"{rec_id}:cell:{position}", {
                "lane": name, "kind": "session-cell", "transcript_id": tid, "agent": None,
                "position": position})
    for path, _text, _obj, _order in snap["logs"]:
        lane = file_lane(path)
        key = lane.lower()
        if key in used_lower:
            continue
        used_lower.add(key)
        f = facts.get(key, {})
        put("lanes", lane, {
            "lane": lane,
            "aliases": json.dumps(aliases_of.get(key, []), ensure_ascii=False),
            "home": f.get("home"), "workstation": None, "started_utc": None,
            "objects_cell": None, "handoff_path": None, "state_phrase": None,
            "session_ids": json.dumps([]), "last_session": f.get("sid"),
            "archived": 0, "owner": None, "row_file": None, "row_ordinal": None,
            "row_text": None})
    for key, f in facts.items():
        lane = first_log_of.get(key, key)
        for path, ordinal, tid, agent in f["paused"]:
            # KEYED AS `log_lines` IS (Copilot round 1 on #164): two logs whose
            # names differ only by case are two files, and a PAUSED at the same
            # line of each is two pointers, never one written over the other.
            rec_id = f"{lane}:log:{ordinal}"
            if rec_id in out["transcript_pointers"]:
                rec_id = f"{path}:log:{ordinal}"
            put("transcript_pointers", rec_id, {
                "lane": lane, "kind": "paused", "transcript_id": tid, "agent": agent,
                "position": ordinal})
    for table in ("transcript_pointers",):
        for record in out[table].values():
            for col in TABLE_COLUMNS[table]:
                record.setdefault(col, None)
    return out


# ================================================== the owner column's reader

def managed_projection(lane: str) -> str:
    """`legacy`, `managed <owner>` or `unknown`, AND NOTHING ELSE DECIDES IT.

    #97's own reader answers: `lanes-edit.sh managed-projection <lane>` exits 0
    with the owner, 8 for a legacy lane, anything else for UNKNOWN. This file
    carries no parser of the marker, so a malformed one can never be read here
    as `legacy` (Amendment 14(e)); a reader that could not be run at all is
    UNKNOWN for the same reason."""
    helper = lanes_edit_path()
    if not helper:
        return "unknown"
    try:
        proc = subprocess.run([helper, "managed-projection", lane], capture_output=True,
                              text=True, check=False, env=helper_env(),
                              stdin=subprocess.DEVNULL, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return "unknown"
    if proc.returncode == 0 and proc.stdout.strip():
        return f"managed {proc.stdout.strip().splitlines()[0]}"
    if proc.returncode == 8:
        return "legacy"
    return "unknown"


def fill_owners(records: dict, stored_lanes: dict | None) -> int:
    """Ask `managed-projection` for every lane whose row text is new or changed
    (all of them where `stored_lanes` is None, which is `reconcile`), and carry
    the stored answer over for a row that has not moved. An `unknown` is never
    carried: it may be a read that failed, and asking again is how it clears.
    Returns how many lanes were asked."""
    ask = []
    for rec_id, rec in records["lanes"].items():
        old = (stored_lanes or {}).get(rec_id)
        if stored_lanes is not None and old is not None and old.get("row_text") == rec["row_text"] \
                and old.get("lane") == rec["lane"] and old.get("owner") \
                and old.get("owner") != "unknown":
            rec["owner"] = old["owner"]
        else:
            ask.append(rec_id)
    if ask:
        workers = max(1, min(8, len(ask)))
        with ThreadPoolExecutor(max_workers=workers) as pool:
            answers = list(pool.map(lambda rid: managed_projection(records["lanes"][rid]["lane"]),
                                    ask))
        for rec_id, owner in zip(ask, answers):
            records["lanes"][rec_id]["owner"] = owner
    return len(ask)


# =============================================================== the stores

def ddl(dialect: str, schema: str) -> list[str]:
    q = (lambda name: f'"{schema}".{name}') if dialect == "postgres" else (lambda name: name)
    big = "BIGINT" if dialect == "postgres" else "INTEGER"
    stmts = [
        f"CREATE TABLE IF NOT EXISTS {q('schema_version')} "
        f"(version INTEGER NOT NULL, applied_utc TEXT NOT NULL)",
        f"CREATE TABLE IF NOT EXISTS {q('provenance')} (source TEXT NOT NULL PRIMARY KEY, "
        f"commit_sha TEXT, generation {big}, indexed_utc TEXT NOT NULL, "
        f"schema_version INTEGER NOT NULL)",
    ]
    for table, cols in TABLE_COLUMNS.items():
        defs = ["source TEXT NOT NULL", "record_id TEXT NOT NULL"]
        for col in cols:
            defs.append(f"{col} {big if col in INTEGER_COLUMNS else 'TEXT'}")
        defs += ["digest TEXT NOT NULL", "provenance TEXT", "indexed_utc TEXT NOT NULL",
                 "schema_version INTEGER NOT NULL", "PRIMARY KEY (source, record_id)"]
        stmts.append(f"CREATE TABLE IF NOT EXISTS {q(table)} ({', '.join(defs)})")
    # HOLDS ARE COMPUTED, NEVER STORED (14(e)), and computed AS `holders_of`
    # COMPUTES THEM (Copilot round 2 on #164), which is `who`'s answer:
    #   * a lane's state on an object is its own LAST line on it - the lane
    #     compared case-insensitively (Amendment 15), so two logs one case
    #     apart are one lane - and "last" is the FILE-ORDERED position
    #     (file, then line; PER_LANE_AWK's `file "\034" %09d line`), never
    #     the UTC (R14);
    #   * it holds while that verb is open, UNLESS another lane's own last line
    #     on the object is a TAKEOVER (`superseded_by`, R18, #30).
    # The file comparison is BYTE order, as awk's string comparison is: SQLite's
    # default BINARY collation, and Postgres's "C".
    coll = ' COLLATE "C"' if dialect == "postgres" else ""
    ll = q("log_lines")
    view = (
        f"WITH ev AS (SELECT source, lane, lower(lane) AS lk, object, verb, utc, session, "
        f"file, ordinal FROM {ll} WHERE unreadable = 0 AND object IS NOT NULL "
        f"AND object NOT LIKE 'lane:%'), "
        f"last AS (SELECT e.* FROM ev e WHERE NOT EXISTS (SELECT 1 FROM ev m "
        f"WHERE m.source = e.source AND m.object = e.object AND m.lk = e.lk "
        f"AND (m.file{coll} > e.file{coll} OR (m.file = e.file AND m.ordinal > e.ordinal)))) "
        f"SELECT h.source, h.lane, h.object, h.verb, h.utc, h.session, h.file, h.ordinal "
        f"FROM last h WHERE h.verb IN ({', '.join(repr(v) for v in OPEN_VERBS)}) "
        f"AND NOT EXISTS (SELECT 1 FROM last t WHERE t.source = h.source "
        f"AND t.object = h.object AND t.lk <> h.lk AND t.verb = 'TAKEOVER')")
    stmts.append(f"CREATE INDEX IF NOT EXISTS log_lines_by_object ON {ll} (source, object)")
    if dialect == "postgres":
        stmts.append(f"CREATE OR REPLACE VIEW {q('holds')} AS {view}")
    else:
        stmts.append(f"CREATE VIEW IF NOT EXISTS holds AS {view}")
    stmts.append(
        f"INSERT INTO {q('schema_version')} (version, applied_utc) SELECT {SCHEMA_VERSION}, "
        f"'{utc_now()}' WHERE NOT EXISTS (SELECT 1 FROM {q('schema_version')})")
    return stmts


class SqliteStore:
    dialect = "sqlite"

    def __init__(self, cfg: dict):
        self.path = cfg["sqlite"]
        self.label = "sqlite"
        self.where = self.path
        self.conn = None

    def open_read(self):
        import sqlite3
        if not os.path.exists(self.path):
            raise StoreUnusable("missing", f"{self.path} does not exist")
        try:
            self.conn = sqlite3.connect(f"file:{self.path}?mode=ro", uri=True, timeout=10)
            self.conn.execute("SELECT 1 FROM sqlite_master LIMIT 1").fetchall()
        except sqlite3.Error as exc:
            raise StoreUnusable("unreachable", f"{self.path}: {exc}")
        self._check_schema(writing=False)

    def open_write(self):
        import sqlite3
        os.makedirs(os.path.dirname(self.path), mode=0o700, exist_ok=True)
        try:
            self.conn = sqlite3.connect(self.path, timeout=30, isolation_level=None)
            # EVERY WRITE-OPEN, NOT ONLY THE FIRST (Copilot round 2 on #164): a
            # store whose mode drifted to 0644 is made private again before
            # another row goes into it, or nothing more is written.
            try:
                os.chmod(self.path, 0o600)
            except OSError as exc:
                raise StoreUnusable("unreachable", f"{self.path} cannot be made 0600 "
                                    f"({exc.strerror or exc}); nothing written")
            have = {r[0] for r in self.conn.execute(
                "SELECT name FROM sqlite_master WHERE type IN ('table','view')")}
            if "schema_version" in have:
                self._check_schema(writing=True)
            self.conn.execute("BEGIN IMMEDIATE")
            for stmt in ddl("sqlite", ""):
                self.conn.execute(stmt)
            self.conn.execute("COMMIT")
        except sqlite3.Error as exc:
            raise StoreUnusable("unreachable", f"{self.path}: {exc}")
        self._check_schema(writing=True)

    def _check_schema(self, writing: bool):
        import sqlite3
        try:
            rows = self.conn.execute("SELECT version FROM schema_version").fetchall()
        except sqlite3.Error:
            if writing:
                return
            raise StoreUnusable("wiped", f"{self.path} carries no schema_version table")
        versions = {r[0] for r in rows}
        if not versions:
            if writing:
                return
            raise StoreUnusable("wiped", f"{self.path} carries no schema_version row")
        if versions != {SCHEMA_VERSION}:
            raise StoreUnusable("unknown-schema",
                                f"schema {sorted(versions)} in {self.path}; this "
                                f"{PROG} knows {SCHEMA_VERSION}")

    def provenance(self, source: str) -> dict | None:
        import sqlite3
        try:
            row = self.conn.execute(
                "SELECT commit_sha, generation, indexed_utc, schema_version FROM provenance "
                "WHERE source = ?", (source,)).fetchone()
        except sqlite3.Error as exc:
            raise StoreUnusable("wiped", f"{self.path}: {exc}")
        if row is None:
            return None
        return {"commit_sha": row[0], "generation": row[1], "indexed_utc": row[2],
                "schema_version": row[3]}

    def all_provenance(self) -> list:
        import sqlite3
        try:
            return [{"source": r[0], "commit_sha": r[1], "generation": r[2], "indexed_utc": r[3],
                     "schema_version": r[4]} for r in self.conn.execute(
                         "SELECT source, commit_sha, generation, indexed_utc, schema_version "
                         "FROM provenance ORDER BY source")]
        except sqlite3.Error as exc:
            raise StoreUnusable("wiped", f"{self.path}: {exc}")

    def rows(self, table: str, source: str, columns: list[str]) -> list:
        # A TABLE THAT CANNOT BE READ IS A STORE THAT CANNOT ANSWER, said as the
        # provenance's reads say it (opensoft/openRepoTools#173, Copilot's
        # fourth review of #171): a `worktrees` table dropped or damaged under
        # valid provenance was a traceback, before `status` reached its
        # `rows: unread` line and before `export` could write its `why`.
        import sqlite3
        cols = ", ".join(["record_id"] + columns)
        try:
            return [dict(zip(["record_id"] + columns, r)) for r in self.conn.execute(
                f"SELECT {cols} FROM {table} WHERE source = ?", (source,))]
        except sqlite3.Error as exc:
            raise StoreUnusable("wiped", f"{self.path}: {exc}")

    def read_image(self, source: str, reads: list) -> tuple:
        """`provenance(source)`, then `rows(table, source, columns)` for each
        `(table, columns)` of `reads`, as ONE READ SNAPSHOT (opensoft/openRepoTools#166
        item 1). Each statement was its own snapshot, so a sync committing
        between two of them made an image of two commits under a `meta` naming
        the first. One read transaction holds the SHARED lock in the rollback
        journal - a writer's commit waits the fraction of a second the export
        takes - and in WAL mode it is a snapshot."""
        import sqlite3
        try:
            self.conn.execute("BEGIN")
        except sqlite3.Error as exc:
            raise StoreUnusable("unreachable", f"{self.path}: {exc}")
        try:
            prov = self.provenance(source)
            tables = [self.rows(table, source, columns) for table, columns in reads]
        finally:
            # A read transaction ends however its reads did; nothing was written.
            try:
                self.conn.execute("COMMIT")
            except sqlite3.Error:
                pass
        return prov, tables

    def apply(self, source: str, old: dict | None, new_sha: str, upserts: dict,
              deletes: dict, generation: int | None = None) -> None:
        """The rows and the provenance, ONE transaction, the compare-and-swap
        first. `new_sha` is the register's commit, or the inventory's
        fingerprint of its whole table (#161), and `generation` the inventory's
        sync count; a record carrying `_provenance` is stamped with that rather
        than with `new_sha` - the generation its tree's own record was filed
        under."""
        import sqlite3
        now = utc_now()
        try:
            self.conn.execute("BEGIN IMMEDIATE")
            cur = self.conn.execute("SELECT commit_sha FROM provenance WHERE source = ?",
                                    (source,)).fetchone()
            want = old["commit_sha"] if old else None
            if (cur[0] if cur else None) != want or (cur is None) != (old is None):
                self.conn.execute("ROLLBACK")
                raise CasLost(f"the provenance of {source} moved under this sync "
                              f"(it read {str(want)[:12]}, the store now holds "
                              f"{str(cur[0] if cur else None)[:12]}); nothing was written")
            if cur is None:
                self.conn.execute(
                    "INSERT INTO provenance (source, commit_sha, generation, indexed_utc, "
                    "schema_version) VALUES (?, ?, ?, ?, ?)",
                    (source, new_sha, generation, now, SCHEMA_VERSION))
            else:
                self.conn.execute(
                    "UPDATE provenance SET commit_sha = ?, generation = ?, indexed_utc = ?, "
                    "schema_version = ? WHERE source = ?",
                    (new_sha, generation, now, SCHEMA_VERSION, source))
            for table, ids in deletes.items():
                for rec_id in ids:
                    self.conn.execute(f"DELETE FROM {table} WHERE source = ? AND record_id = ?",
                                      (source, rec_id))
            for table, recs in upserts.items():
                cols = TABLE_COLUMNS[table]
                allc = ["source", "record_id"] + cols + ["digest", "provenance", "indexed_utc",
                                                         "schema_version"]
                sets = ", ".join(f"{c} = excluded.{c}" for c in allc[2:])
                sql = (f"INSERT INTO {table} ({', '.join(allc)}) VALUES "
                       f"({', '.join('?' for _ in allc)}) ON CONFLICT (source, record_id) "
                       f"DO UPDATE SET {sets}")
                self.conn.executemany(sql, [
                    [source, rec_id] + [rec.get(c) for c in cols] +
                    [rec["digest"], rec.get("_provenance", new_sha), now, SCHEMA_VERSION]
                    for rec_id, rec in recs.items()])
            self.conn.execute("COMMIT")
        except sqlite3.Error as exc:
            try:
                self.conn.execute("ROLLBACK")
            except sqlite3.Error:
                pass
            raise StoreUnusable("unreachable", f"{self.path}: {exc}")


def _pg_quote(value) -> str:
    if value is None:
        return "NULL"
    if isinstance(value, int):
        return str(value)
    return "'" + str(value).replace("'", "''") + "'"


def _pg_unescape(field: str):
    """One field of `COPY ... TO STDOUT` in TEXT format: `\\N` is NULL and a
    backslash escapes the rest, exactly as the server wrote it."""
    if field == "\\N":
        return None
    if "\\" not in field:
        return field
    out, i, n = [], 0, len(field)
    simple = {"b": "\b", "f": "\f", "n": "\n", "r": "\r", "t": "\t", "v": "\v", "\\": "\\"}
    while i < n:
        ch = field[i]
        if ch != "\\" or i + 1 >= n:
            out.append(ch)
            i += 1
            continue
        nxt = field[i + 1]
        if nxt in simple:
            out.append(simple[nxt])
            i += 2
        elif nxt in "01234567":
            j = i + 1
            while j < n and j < i + 4 and field[j] in "01234567":
                j += 1
            out.append(chr(int(field[i + 1:j], 8)))
            i = j
        elif nxt == "x":
            j = i + 2
            while j < n and j < i + 4 and field[j] in "0123456789abcdefABCDEF":
                j += 1
            out.append(chr(int(field[i + 2:j], 16)) if j > i + 2 else "x")
            i = j
        else:
            out.append(nxt)
            i += 2
    return "".join(out)


