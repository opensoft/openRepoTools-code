#: `core.commentChar` or `i18n.logOutputEncoding` would hide every trailer.
_RENDER_WALK_PINS = ("-c", "log.showSignature=false", "-c", "trailer.separators=:",
                     "-c", "core.commentChar=#", "-c", "i18n.logOutputEncoding=UTF-8")


class RenderPass:
    """What one pass did. `outcome` is one of:

    - `rendered`: origin's `main` now carries `t` or more, by this pass's
      push or by another renderer's (Y:2885-2886). The one PROGRESS outcome
      (F15): `reached`, origin's last `Register-Seq` after it, is above
      `found`, where the pass found it;
    - `nothing-missing`: `m` is at the head;
    - `operator-next`: `m + 1` is an operator entry, which its command
      pushes (F2);
    - `at-files`: the switch is at `files`, where the pass renders nothing
      and records no divergence, since nothing at `files` can clear one
      (lane 3's ruling on T322's open point 2);
    - `diverged`: `diverged at <sha>` was recorded (D16);
    - `fetch-failed`: the fetch of `origin main` failed or timed out;
    - `walk-failed`: form C ran out of time, found no `Register-Seq`, or
      found one that is not a seq;
    - `build-failed`: a git call of the build failed;
    - `push-failed`: `render_push` answered `failed` or `unconfirmed`;
    - `six-rejections`: six push attempts were rejected, and origin does not
      carry `t`;
    - `read-failed`: the register could not be read, or its rows do not
      replay (D10).

    `rc` is the exit the pass leaves: 0 for the first four, 69 for
    `read-failed` (Y:3527, "the render ends; the lag stays"), and 1 for the
    rest, which end the renderer with what it found recorded."""

    __slots__ = ("outcome", "rc", "found", "reached", "target", "tip", "detail")

    def __init__(self, outcome: str, detail: str, *, found=None, reached=None, target=None,
                 tip: str = ""):
        self.outcome = outcome
        self.rc = (0 if outcome in ("rendered", "nothing-missing", "operator-next", "at-files")
                   else EXIT_UNAVAILABLE if outcome == "read-failed" else 1)
        self.found = found
        self.reached = reached
        self.target = target
        self.tip = tip
        self.detail = detail

    @property
    def progressed(self) -> bool:
        """F15's progress: the pass moved origin's last `Register-Seq` past
        where it found it."""
        return (self.outcome == "rendered" and self.found is not None
                and self.reached is not None and self.reached > self.found)

    def __repr__(self) -> str:
        return (f"RenderPass(outcome={self.outcome!r}, rc={self.rc}, found={self.found!r}, "
                f"reached={self.reached!r}, target={self.target!r}, tip={self.tip!r}, "
                f"detail={self.detail!r})")


