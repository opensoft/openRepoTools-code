# ===================================================== the one push (group C)
#
# ONE PUSH FUNCTION SERVES THE RENDERER, `cutover`, `cutover --after-loss` AND
# `rollback` (feature 007's T320: D23; S2's "The push"; the phase plan's "The
# push URL"; FR-045; `contracts/render-commit.md` section 3).
#
# - THE REFSPEC is `<tip>:refs/heads/main`, never forced, bounded by
#   `LANES_GIT_TIMEOUT` as `lanes-edit.sh`'s `git_net` bounds a push.
# - WITH `render_key=` (Q21(b)(B)) it pushes to an explicit
#   `ssh://git@github.com/<owner>/<repo>.git`, `<owner>/<repo>` being
#   `_norm_repo` of the checkout's own `git remote get-url origin`, which must
#   equal `source_of`'s: so the push names the repository that was fetched. A
#   deploy key authenticates only over SSH, and `git push origin` would use the
#   checkout's HTTPS remote and the lane's own credentials, which the ruleset
#   refuses. A non-GitHub origin is refused with 2.
# - WITHOUT `render_key=` (Q21(b)(A), and the bare-origin fixtures) it pushes to
#   `origin` as it stands.
# - NOTHING IS WRITTEN TO THE CHECKOUT'S CONFIGURATION: no `set-url`, no
#   `pushurl`. A push to a URL moves no `refs/remotes/origin/main`, so the
#   READ-BACK fetches `origin` and checks `merge-base --is-ancestor`.
# - SECURITY-SENSITIVE: the key bypasses the ruleset on the render set and
#   `lanes/STORE`, so its file is named only in the push's own environment, a
#   dict built for that one `git push` and the `ssh` it starts. It is never put
#   in `os.environ`, in git's argument list or in the read-back's environment,
#   so no session, and no other child of this one, inherits it ("A
#   server-side gate protects the rendered paths and `lanes/STORE`").

#: The one branch the render commits and the operator entries' commits go to
#: (contract section 3, Y:2867): `refs/heads/main` on origin, whatever
#: `LANES_BRANCH` says.
RENDER_BRANCH = "main"

#: `<owner>/<repo>` as GitHub spells one: what `_norm_repo` must leave of a
#: GitHub origin before the push may name it.
GITHUB_REPO_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_.-]+$")


def git_timeout_s() -> int | None:
    """`LANES_GIT_TIMEOUT`, read as `lanes-edit.sh`'s `git_net` reads it: the
    budget in whole seconds, 60 where it is unset or empty, and no bound where
    it is 0 or not a whole number."""
    raw = os.environ.get("LANES_GIT_TIMEOUT") or "60"
    if re.fullmatch(r"[0-9]+", raw) and int(raw) > 0:
        return int(raw)
    return None


def _render_child_env() -> dict:
    """The caller's own environment, with every inherited `GIT_*` variable
    removed, so an inherited `GIT_DIR`, `GIT_INDEX_FILE`, `GIT_SSH_COMMAND`,
    `GIT_CONFIG_*` or `GIT_ASKPASS` reaches no child, and with
    `LANES_NO_FETCH` dropped (D12; T321): the renderer never consults it, and
    no child of its inherits it. Nothing here is interactive, so git never
    prompts on a terminal. The re-fork's environment (`render_refork`), and
    the start of `render_git_env`'s."""
    env = {key: value for key, value in os.environ.items()
           if not key.startswith("GIT_") and key != "LANES_NO_FETCH"}
    env["GIT_TERMINAL_PROMPT"] = "0"
    return env


def render_git_env() -> dict:
    """The environment every git call of the renderer and of the push starts
    from (Y:5776): `_render_child_env()`'s, with F29's pin against replaced
    commits, which would move `m` or answer a read-back for a commit origin
    never received, made whole HERE, so T320's read-back (`render_readback`)
    has it too (SHOULD-1 of lane 3's review of T322):
    - `GIT_NO_REPLACE_OBJECTS=1`: no `refs/replace/*`;
    - `GIT_GRAFT_FILE=/dev/null`: no `<git-dir>/info/grafts`, which
      `GIT_NO_REPLACE_OBJECTS` does not cover in git 2.43. Git advises on
      every graft file it opens, `/dev/null` included, so
      `advice.graftFileDeprecated=false` is set beside it, as
      `GIT_CONFIG_COUNT` (git 2.31 or later)."""
    env = _render_child_env()
    env["GIT_NO_REPLACE_OBJECTS"] = "1"
    env["GIT_GRAFT_FILE"] = "/dev/null"
    env["GIT_CONFIG_COUNT"] = "1"
    env["GIT_CONFIG_KEY_0"] = "advice.graftFileDeprecated"
    env["GIT_CONFIG_VALUE_0"] = "false"
    return env


def render_push_env(render_key: str) -> dict:
    """The push's own environment (D23; Y:5799). Without `render_key=` it is
    `render_git_env()`'s. With it, the key is named in `GIT_SSH_COMMAND` with
    `IdentitiesOnly=yes` and `BatchMode=yes`, Y:5799's form, and then
    `-F /dev/null -o ControlMaster=no -o ControlPath=none`: no `~/.ssh/config`
    or `/etc/ssh/ssh_config` can rename the host, add a key or a proxy, or
    share the key's connection through a control master (MUST-2 of lane 3's
    review of T320). `SSH_AUTH_SOCK` is removed, so no agent key is offered
    first, and so are `SSH_ASKPASS`, `SSH_ASKPASS_REQUIRE` and
    `SSH_SK_PROVIDER` (NIT-3); and `GIT_CONFIG_GLOBAL=/dev/null` with
    `GIT_CONFIG_NOSYSTEM=1`, so no global or system `url.*.insteadOf` turns the
    URL back into HTTPS. The dict is this one child's: the key is in no other
    environment."""
    import shlex
    env = render_git_env()
    if render_key:
        for name in ("SSH_AUTH_SOCK", "SSH_ASKPASS", "SSH_ASKPASS_REQUIRE", "SSH_SK_PROVIDER"):
            env.pop(name, None)
        env["GIT_SSH_COMMAND"] = (f"ssh -i {shlex.quote(os.path.abspath(render_key))} "
                                  f"-o IdentitiesOnly=yes -o BatchMode=yes -F /dev/null "
                                  f"-o ControlMaster=no -o ControlPath=none")
        env["GIT_CONFIG_GLOBAL"] = "/dev/null"
        env["GIT_CONFIG_NOSYSTEM"] = "1"
    return env


class GitRun:
    """One bounded git call: its exit status (None where it could not be
    started), its output, and whether its time ran out."""

    __slots__ = ("rc", "out", "err", "timed_out")

    def __init__(self, rc, out: str, err: str, timed_out: bool):
        self.rc = rc
        self.out = out
        self.err = err
        self.timed_out = timed_out

    #: git's boilerplate around the line that says what went wrong, and its
    #: `warning:` lines, which come before a `fatal:` that says it: never the
    #: line kept (SHOULD-3 of lane 3's review of T320; NIT-a of the render
    #: re-review).
    BOILERPLATE = re.compile(r"fatal: Could not read from remote repository\.?"
                             r"|Please make sure you have the correct access rights"
                             r"|and the repository exists\.?|hint:.*|warning:.*|To \S+")

    def last_line(self) -> str:
        """The FIRST USEFUL line of stderr, URLs masked: git's boilerplate (the
        "Could not read from remote repository" lines, `hint:` and `warning:`
        lines and a push's `To <url>` line) is passed over, so "Permission
        denied (publickey)", git's own refusal or the `fatal:` line behind a
        `warning:` is the line kept. Where nothing else is left, the first
        line, git's "fatal: ..." itself."""
        lines = [line.strip() for line in self.err.splitlines() if line.strip()]
        useful = [line for line in lines if not self.BOILERPLATE.fullmatch(line)]
        kept = useful[0] if useful else (lines[0] if lines else "")
        return _redact_url(kept) if kept else "no message"


def _run_bounded(argv: list, env: dict, timeout: float | None) -> GitRun:
    """Run `argv` in a process group of its own, bounded by `timeout` seconds.

    AT THE BOUND THE WHOLE GROUP IS ENDED, as `timeout -k 5` ends `git_net`'s:
    TERM, then KILL five seconds later, so an `ssh` under a hung `git push`
    does not outlive it. An interrupt of this process ends the group too."""
    import signal
    try:
        proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, env=env, start_new_session=True)
    except OSError as exc:
        return GitRun(None, "", f"{argv[0]} could not be run: {exc}", False)
    timed_out = False
    out, err = b"", b""
    try:
        try:
            out, err = proc.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            timed_out = True
            for sig in (signal.SIGTERM, signal.SIGKILL):
                try:
                    os.killpg(proc.pid, sig)
                except OSError:
                    pass
                try:
                    out, err = proc.communicate(timeout=5)
                    break
                except subprocess.TimeoutExpired:
                    continue
            else:
                for pipe in (proc.stdout, proc.stderr):
                    if pipe is not None:
                        pipe.close()
                proc.wait()
    except BaseException:
        if proc.returncode is None:     # NIT-1: never a group whose leader was reaped
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except OSError:
                pass
        proc.wait()
        raise
    return GitRun(proc.returncode, (out or b"").decode("utf-8", "replace"),
                  (err or b"").decode("utf-8", "replace"), timed_out)


def render_git(checkout: str, *args: str, env: dict | None = None,
               timeout: float | None = None) -> GitRun:
    """`git -C <checkout> <args>` in `render_git_env()`, or in `env` where the
    caller built one, bounded by `timeout`."""
    return _run_bounded(["git", "-C", checkout, *args],
                        render_git_env() if env is None else env, timeout)


def _redact_url(text: str) -> str:
    """`text` with the user part of every http(s) URL in it masked: an origin
    such as `https://<user>:<token>@github.com/...` is a credential, and a
    refusal or a recorded failure must not carry it."""
    return re.sub(r"(https?://)[^/@\s]+@", r"\1***@", text)


def render_push_url(checkout: str, render_key: str) -> str:
    """Where the push goes: `origin` without `render_key=`; with it, the
    explicit `ssh://git@github.com/<owner>/<repo>.git` (Y:2868-2871; Y:5798).

    Refused with 2 (`Refusal`), with nothing pushed: an origin that cannot be
    read; an origin that is not a GitHub repository; and an `<owner>/<repo>`
    that is not `source_of`'s (GitHub's names are compared without case)."""
    if not render_key:
        return "origin"
    got = render_git(checkout, "remote", "get-url", "origin")
    url = got.out.strip()
    if got.rc != 0 or not url:
        raise Refusal(f"render_key= is set, and {checkout} has no `origin` to name the "
                      f"repository the push goes to: {got.last_line()}")
    repo = _norm_repo(url)
    bare = url[:-4] if url.endswith(".git") else url
    if repo == bare or not GITHUB_REPO_RE.match(repo) or repo.split("/")[1] in (".", ".."):
        if _redact_url(url) != url:
            # NIT-2: say what is wrong with it: a URL that carries a user
            # part, a credential, masked here.
            raise Refusal(f"render_key= is set, and the origin of {checkout}, "
                          f"{_redact_url(url)}, carries credentials in its URL: the renderer "
                          f"identity is a deploy key, which pushes only to "
                          f"ssh://git@github.com/<owner>/<repo>.git, named from a plain origin "
                          f"URL (D23). Nothing was pushed")
        raise Refusal(f"render_key= is set, and the origin of {checkout}, {_redact_url(url)}, "
                      f"is not a GitHub repository: the renderer identity is a deploy key, "
                      f"which pushes only to ssh://git@github.com/<owner>/<repo>.git (D23). "
                      f"Nothing was pushed")
    source = source_of(checkout)
    if source.lower() != f"register:{repo}".lower():
        raise Refusal(f"render_key= is set, and the origin of {checkout} names {repo}, which is "
                      f"not this workstation's register, {source[len('register:'):]} "
                      f"(source_of): the push must name the repository that was fetched. "
                      f"Nothing was pushed")
    return f"ssh://git@github.com/{repo}.git"


class PushResult:
    """What `render_push` found. `outcome` is one of:

    - `pushed`: the read-back's fetch of origin carries `tip` on `main`. That
      includes a push that timed out but landed, and a `tip` that was already
      there: a second push of the same sha is a no-op (Y:2889-2891).
    - `rejected`: git refused the push as not a fast-forward, and origin's
      `main` does not carry `tip`: a lost race, which moved no ref. The
      read-back's fetch IS the refetch, so `origin_tip` is origin's `main` as
      it now stands. The renderer counts origin carrying `t` or more as pushed,
      and otherwise rebuilds, six push attempts in all (T322).
    - `failed`: the push failed otherwise (authentication, the network, the
      ruleset or a hook on the server), and the read-back proves origin's
      `main` does not carry `tip`.
    - `unconfirmed`: the read-back could not answer (its fetch failed or timed
      out); or the push said it landed, or its time ran out, and origin's
      `main` does not carry it: a server can still apply an update after the
      client is killed (SHOULD-1 of lane 3's review of T320).
      `cutover` and `rollback` exit 3, and their rerun reads origin back
      before it acts (Y:3157-3159); the renderer records it and ends.

    `destination` is `origin` or the SSH URL, which carries no credential;
    `detail` is one line for a record; `origin_tip` is origin's `main` after
    the read-back's fetch, or "" where that fetch failed."""

    __slots__ = ("outcome", "destination", "push_rc", "timed_out", "origin_tip", "detail")

    def __init__(self, outcome: str, destination: str, push_rc, timed_out: bool,
                 origin_tip: str, detail: str):
        self.outcome = outcome
        self.destination = destination
        self.push_rc = push_rc
        self.timed_out = timed_out
        self.origin_tip = origin_tip
        self.detail = detail

    def __repr__(self) -> str:
        return (f"PushResult(outcome={self.outcome!r}, destination={self.destination!r}, "
                f"push_rc={self.push_rc!r}, timed_out={self.timed_out!r}, "
                f"origin_tip={self.origin_tip!r}, detail={self.detail!r})")


def render_readback(checkout: str, tip: str) -> tuple:
    """S4's read-back: fetch `origin main` into `refs/remotes/origin/main`,
    bounded by `LANES_GIT_TIMEOUT`, and ask `merge-base --is-ancestor` whether
    it carries `tip`. Returns (answered, carried, origin's tip, why): where
    the fetch did not answer, `answered` is False and nothing is known. Its
    fetch writes no `FETCH_HEAD`, as the pass's own does not (NIT-7 of lane
    3's review of T322): `lanes-edit.sh` reads that file's age as the
    checkout's own fetch."""
    fetched = render_git(checkout, "-c", "gc.auto=0", "-c", "maintenance.auto=false",
                         "fetch", "--no-tags", "--no-write-fetch-head",
                         "--no-recurse-submodules", "-q", "origin",
                         f"+refs/heads/{RENDER_BRANCH}:refs/remotes/origin/{RENDER_BRANCH}",
                         timeout=git_timeout_s())
    if fetched.rc != 0:
        why = (f"timed out after {git_timeout_s()} s" if fetched.timed_out
               else f"exited {fetched.rc}: {fetched.last_line()}")
        return False, False, "", f"the read-back's fetch of origin {RENDER_BRANCH} {why}"
    head = render_git(checkout, "rev-parse", "--verify", "-q",
                      f"refs/remotes/origin/{RENDER_BRANCH}^{{commit}}")
    origin_tip = head.out.strip()
    if head.rc != 0 or not SHA_RE.match(origin_tip):
        return False, False, "", f"origin has no {RENDER_BRANCH} after the read-back's fetch"
    carried = render_git(checkout, "merge-base", "--is-ancestor", tip, origin_tip)
    if carried.rc not in (0, 1):
        return False, False, origin_tip, (f"merge-base --is-ancestor exited {carried.rc}: "
                                          f"{carried.last_line()}")
    return True, carried.rc == 0, origin_tip, ""


def _render_push_config_check(checkout: str, url: str, env: dict) -> None:
    """MUST-1 of lane 3's review of T320: with `render_key=`, the checkout's
    own configuration (its `.git/config`, a worktree's, and any file an
    `include.path` names), which `GIT_CONFIG_GLOBAL` does not cover, must not
    redirect or widen the deploy key's push. Read in the push's own
    environment, `env`, which the caller hands over without the key's
    `GIT_SSH_COMMAND` (NIT-3 of lane 3's review of T322), before the push,
    each is a `Refusal` (2), nothing pushed:
    - a `url.<base>.insteadOf` or `url.<base>.pushInsteadOf` whose value is a
      prefix of the push URL `url`, which would send the key elsewhere;
    - any key that begins `remote.<url>.`, such as a `pushurl`, which would
      do the same, compared without case;
    - a configuration that cannot be read."""
    def unread(run: GitRun) -> Refusal:
        return Refusal(f"render_key= is set, and the configuration of {checkout} cannot be "
                       f"read (`git config` exited {run.rc}: {run.last_line()}), so it cannot "
                       f"be shown not to redirect the deploy key's push. Nothing was pushed")

    rewrites = render_git(checkout, "config", "-z", "--get-regexp",
                          r"^url\..*\.(push)?insteadof$", env=env, timeout=git_timeout_s())
    if rewrites.rc not in (0, 1) or rewrites.timed_out:
        raise unread(rewrites)
    for record in rewrites.out.split("\x00"):
        key, newline, value = record.partition("\n")
        if newline and url.startswith(value):
            raise Refusal(f"render_key= is set, and the configuration of {checkout} has "
                          f"{_redact_url(key)} = {_redact_url(value)}, which rewrites the push "
                          f"URL {url}: the deploy key's push would go elsewhere. Nothing was "
                          f"pushed")
    listed = render_git(checkout, "config", "-z", "--name-only", "--list", env=env,
                        timeout=git_timeout_s())
    if listed.rc != 0 or listed.timed_out:
        raise unread(listed)
    prefix = f"remote.{url}.".lower()
    for key in listed.out.split("\x00"):
        if key.lower().startswith(prefix):
            raise Refusal(f"render_key= is set, and the configuration of {checkout} has "
                          f"{_redact_url(key)}, which configures the push URL {url} as a "
                          f"remote: the deploy key's push could go elsewhere or take more. "
                          f"Nothing was pushed")


def render_push(checkout: str, tip: str, render_key: str = "") -> PushResult:
    """THE ONE PUSH (T320): push `tip` to origin's `main` from `checkout`, as a
    fast-forward only, then read it back. It writes nothing to the checkout's
    configuration, and moves no HEAD, index or working tree.

    `render_key` is `render_key=`'s path, or "" (Q21(b)(A)). A key file that
    is not a private regular file, and a destination `render_push_url`
    refuses, and with the key a checkout configuration that would redirect
    or widen the push (`_render_push_config_check`), are a `Refusal` (2) with
    nothing pushed. The push never takes tags or submodules along
    (`push.followTags=false`, `push.recurseSubmodules=no`), and is never
    signed (`push.gpgSign=false`, NIT-2 of lane 3's review of T322).
    Everything else is a `PushResult`, which each caller maps to its own
    end."""
    if not SHA_RE.match(tip):
        raise ValueError(f"render_push needs a full commit sha, not {tip!r}")
    if render_key:
        _check_private_file(render_key, "the renderer's deploy-key file (`render_key=`)")
    destination = render_push_url(checkout, render_key)
    env = render_push_env(render_key)
    if render_key:
        _render_push_config_check(checkout, destination,
                                  {key: value for key, value in env.items()
                                   if key != "GIT_SSH_COMMAND"})
    pushed = render_git(checkout, "-c", "push.followTags=false", "-c", "push.recurseSubmodules=no",
                        "-c", "push.gpgSign=false",
                        "push", "--no-verify", "--porcelain", destination,
                        f"{tip}:refs/heads/{RENDER_BRANCH}", env=env, timeout=git_timeout_s())
    # `--porcelain` gives one line per ref, `!` for a ref that was not
    # updated: `[rejected]` is git's own refusal of a push that is not a fast-
    # forward, and `[remote rejected]` the server's, a ruleset or a hook.
    summary = ""
    for line in pushed.out.splitlines():
        fields = line.split("\t")
        if len(fields) >= 3 and fields[0] == "!":
            summary = fields[2].strip()
    if pushed.timed_out:
        how = f"the push timed out after {git_timeout_s()} s"
    elif pushed.rc is None:
        how = f"the push could not be started: {pushed.last_line()}"
    elif pushed.rc == 0:
        how = "the push exited 0"
    else:
        how = f"the push exited {pushed.rc}: {_redact_url(summary) or pushed.last_line()}"
    answered, carried, origin_tip, why = render_readback(checkout, tip)
    if answered and carried:
        outcome = "pushed"
    elif not answered:
        outcome = "unconfirmed"
        how = f"{how}; {why}"
    elif pushed.timed_out or pushed.rc == 0:
        outcome = "unconfirmed"
        how = (f"{how}, and origin's {RENDER_BRANCH} does not carry {tip}"
               + (" yet: the server may still apply it" if pushed.timed_out else ""))
    elif summary.startswith("[rejected]"):
        outcome = "rejected"
    else:
        outcome = "failed"
    return PushResult(outcome, destination, pushed.rc, pushed.timed_out, origin_tip,
                      f"{outcome} to {destination}: {how}")


# ===================================== `render --checkout <c>`'s lock (group C)
#
# ONE RENDER AT A TIME PER CHECKOUT, AND NO FORK WAITS (feature 007's T321:
# D14; S2's first bullet; FR-044; the phase plan's "The render lock").
#
# - THE LOCK is `fcntl.flock(LOCK_EX | LOCK_NB)` on `<git-dir>/lanes-render.lock`
#   of the checkout `<c>`, in `SyncLock`'s form: never the lane's write lock,
#   and never a `mkdir` mutex. The kernel releases a `flock` when its holder
#   dies, even by SIGKILL, where a `mkdir` mutex would stay behind and the
#   checkout would render nothing again ([L4-4]).
# - THE FILE IS OPENED CLOSE-ON-EXEC, so a `git push` that outlives a killed
#   renderer does not keep the lock.
# - BOTH HALVES OF `SyncLock`'s HANDSHAKE (`cmd_sync`): a fork that finds the
#   lock held writes `<git-dir>/lanes-render.rerun`, tries the lock once more,
#   and exits; the holder, after it releases, looks for a mark once more and
#   takes the lock back for it. Without the second half, a write that commits
#   between the holder's last look and its release is never rendered ([L4-3]).
# - `LANES_NO_FETCH` IS NEVER CONSULTED (D12): `render --checkout` drops it
#   from its own environment first, and `render_git_env` from every child's.

RENDER_LOCK_NAME = "lanes-render.lock"
RENDER_RERUN_NAME = "lanes-render.rerun"


class RenderLock:
    """The render lock of one checkout's git directory, and its rerun mark."""

    def __init__(self, git_dir: str):
        self.path = os.path.join(git_dir, RENDER_LOCK_NAME)
        self.rerun = os.path.join(git_dir, RENDER_RERUN_NAME)
        self.fd = None

    def acquire(self) -> bool:
        """Take the lock at once, or answer False: it never waits. The file is
        opened close-on-exec and never through a symbolic link. An error that
        is not "held" (a git directory this account cannot write) raises."""
        import errno
        import fcntl
        if self.fd is not None:
            return True
        fd = os.open(self.path, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError as exc:
            os.close(fd)
            if exc.errno in (errno.EWOULDBLOCK, errno.EAGAIN, errno.EACCES):
                return False
            raise
        self.fd = fd
        return True

    def release(self) -> None:
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None

    def mark_rerun(self) -> None:
        """Leave the mark that asks the holder to render again. A mark that
        cannot be written is said: the write it stands for then waits for the
        next render."""
        try:
            fd = os.open(self.rerun, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_CLOEXEC
                         | os.O_NOFOLLOW, 0o600)
            try:
                os.write(fd, (utc_now() + "\n").encode("ascii"))
            finally:
                os.close(fd)
        except OSError as exc:
            note(f"render: the rerun mark {self.rerun} could not be written "
                 f"({exc.strerror or exc}); the next render renders this write")

    def has_rerun(self) -> bool:
        return os.path.lexists(self.rerun)

    def clear_rerun(self) -> None:
        """Take the mark away. One that cannot be removed raises, since the
        holder would otherwise take the lock back for it for ever."""
        try:
            os.unlink(self.rerun)
        except FileNotFoundError:
            pass


def render_git_dir(checkout: str) -> str:
    """The git directory of `<c>`, the lane's checkout, which holds the lock:
    per checkout, a linked worktree's own. Anything else is refused with 2."""
    got = render_git(checkout, "rev-parse", "--absolute-git-dir")
    git_dir = got.out.strip()
    if got.rc != 0 or not git_dir or not os.path.isdir(git_dir):
        raise Refusal(f"render --checkout {checkout} names no git checkout: {got.last_line()}")
    return git_dir


# ===================================== `render --checkout <c>`'s pass (group C)
#
# THE RENDERER'S PASS (feature 007's T322: S2's "A pass"; D15; D16; FR-044;
# contracts/render-commit.md), run by the holder of `<c>`'s render lock:
#
# 1. FETCH `origin main`, bounded by `LANES_GIT_TIMEOUT`, and take origin's
#    tip AS A SHA: every later git act of the pass reads that sha, never the
#    ref, which the lane's own fetch may move meanwhile. A failed fetch is
#    recorded with the mirror state (D16), and nothing is pushed.
# 2. READ THE REGISTER ONCE (D9's `render` row, one snapshot): the schema
#    window, the head `h` and the switch, and the `git_commit` of every
#    `stray-import` and `stray-revert` entry, the RESOLVED STRAYS. It reads
#    after the fetch, so `h` is at least every seq the fetched origin carries.
# 3. FIND `m` by form C, paged with `--skip`, 200 commits a page, never with
#    `--grep`, the whole walk bounded by `LANES_GIT_TIMEOUT`: the first
#    non-empty `Register-Seq` of a commit that is no resolved stray (lane 3's
#    T117 ruling 5, through the skip set of `render_register_seq`). Run out of
#    time, or no trailer on the whole line: recorded, nothing pushed.
#    AT `files` THE PASS ENDS HERE: it renders nothing and records no
#    divergence, since nothing at `files` can clear one (lane 3's ruling on
#    T322's open point 2). Every later step is at `primary`.
# 4. CHECK FOR A DIVERGENCE, each recorded as `diverged at <sha>` through
#    `record_mirror_state`, nothing pushed: an `m` above `h` at its commit
#    `R` (R2's N6); a commit after `R` that changes a render-set path and is
#    no resolved stray; and a render set at `R` that is not the images at
#    `m`.
# 5. THE TARGET, `t = min(h, m + 64, o - 1)`, `o` the first entry after `m`
#    that `journal.operator` flags (PC-3). Where `m + 1` is one, nothing is
#    rendered (F2): its command owns it.
# 6. BUILD `m+1 .. t` with T301's image builder, under the private index
#    `<git-dir>/lanes-render.index` and `commit-tree --no-gpg-sign`, each
#    message composed here (D15), each commit read back by form C, which must
#    read its `k`, and PUSH through `render_push` (T320): a rejection
#    refetches, N6 is checked again, origin carrying `t` or more counts as
#    pushed, and otherwise the pass rebuilds on origin's new tip, six
#    attempts in all.
#
# IT NEVER TOUCHES A HEAD, AN INDEX OR A WORKING TREE OF THE CHECKOUT. Its git
# calls read objects and refs, write objects, `refs/remotes/origin/main` (the
# fetch, and T320's read-back) and its own `lanes-render.*` files; it writes
# no `FETCH_HEAD`. Every git call starts from `render_git_env()`, which pins
# out replace refs and grafts (F29), with `TZ=UTC` added.

#: Form C's page, in commits (Y:2843).
RENDER_PAGE = 200
#: PC-3: the seqs one pass renders at most, `t <= m + 64`.
RENDER_BATCH = 64
#: Amendment 23 S4 item 5's bound on a writer: six push attempts in all.
RENDER_PUSH_ATTEMPTS = 6
#: The pass's private index, in the checkout's git directory (Y:2855).
RENDER_INDEX_NAME = "lanes-render.index"
#: The build's private directory for the blobs and messages it hands git,
#: beside the index, and cleared with it (NIT-4 of lane 3's review of T322).
RENDER_WORK_NAME = "lanes-render.tmp"
#: The trailer that ties a commit to its seq (contract section 2).
REGISTER_SEQ_KEY = "Register-Seq"
#: A line of a trailer block as F29 names one (Y:5964): `Token: value`, the
#: token of letters, digits and `-`.
_RENDER_TRAILER_LINE_RE = re.compile(r"[A-Za-z0-9-]+: .*")
#: `journal.author`'s form, its CHECK's: a name, one space, an email in `<>`.
_RENDER_AUTHOR_RE = re.compile(r"([^<>]+) <([^<>]*)>")
#: F29's pins for the build's git calls (contract section 1): blob bytes,
#: the encoding header and the signature, with no gc and no split or sparse
