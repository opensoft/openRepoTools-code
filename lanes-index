              "state_phrase", "objects_cell", "session_ids", "last_session", "archived",
              "owner", "row_file", "row_ordinal", "row_text"],
    "log_lines": ["lane", "file", "ordinal", "verb", "session", "workstation", "utc", "object",
                  "ref", "payload", "payload_fields", "free_text", "written_lane", "unreadable",
                  "unreadable_why", "raw"],
    "register_lines": ["kind", "lane", "repo", "pr", "tip", "utc", "session", "ordinal", "raw"],
    "lane_aliases": ["old_name", "new_name", "utc", "ordinal", "raw"],
    "transcript_pointers": ["lane", "kind", "transcript_id", "agent", "position", "workstation",
                            "estate", "profile_family", "resolved_store", "project_key",
                            "parent_uuid", "size_bytes", "sha256", "sealed_utc"],
    # THE LEDGER HALF'S OWN TABLES, created EMPTY: T058 of the 001 feature
    # writes them under `ledger:<Workstation>` (Amendment 14(g) act 4), and this
    # indexer writes nothing into them.
    "swap_states": ["lane", "parent_uuid", "generation", "state", "observed_utc"],
    "job_summaries": ["lane", "job_id", "result_summary", "observed_utc"],
    # opensoft/openRepoTools#161: each lane's #97 worktree inventory under
    # `inventory:<Workstation>`, keyed by (source, lane, path) - the record id
    # `<lane>:<path>`, `<lane>:<path><US><n>` for a second tree of one lane with
    # the same path, and `<lane>:<US>unread` for a lane's unread marker (#173).
    # Amendment 14(e) left inventories to "a later word's"; #161
    # is that word's issue. Created by schema 1 with these columns before a row
    # was written into it, so no store needed a new version for it. Written by
    # `run_inventory` and by nothing that reads the register.
    "worktrees": ["workstation", "lane", "owner", "path", "branch", "base", "lifecycle",
                  "generation", "operation", "writer_live", "last_seen_utc", "last_commit",
                  "dirty_count", "unpushed_count", "pr_number", "pr_state"],
}

INTEGER_COLUMNS = {"ls_order", "line_count", "unreadable_count", "archived", "row_ordinal",
                   "ordinal", "unreadable", "position", "size_bytes", "generation",
                   "writer_live", "dirty_count", "unpushed_count", "pr_number"}

#: The tables `sync` and `reconcile` write for the REGISTER. The ledger's two
#: are T058's, and `worktrees` is the inventory source's alone.
REGISTER_TABLES = ("source_files", "lanes", "log_lines", "register_lines", "lane_aliases",
                   "transcript_pointers")


def digest_of(table: str, record: dict) -> str:
    content = [table] + [record.get(col) for col in TABLE_COLUMNS[table]]
    blob = json.dumps(content, ensure_ascii=False, separators=(",", ":"), sort_keys=False)
    return hashlib.sha256(blob.encode("utf-8")).hexdigest()


def build_records(snap: dict) -> dict:
    """Every record of the register half at one commit, WITHOUT the owner
    column: the owner is `managed-projection`'s answer, asked separately."""
    out = {table: {} for table in REGISTER_TABLES}

    def put(table: str, record_id: str, record: dict) -> None:
        out[table][record_id] = record

    # ---- the files themselves
    for path, kind in ((REGISTER_PATH, "register"), (ALIASES_PATH, "aliases"),
                       (ARCHIVE_PATH, "archive")):
        text = snap.get(kind)
        if text is None:
            continue
        put("source_files", path, {"kind": kind, "lane": None, "ls_order": None,
                                   "blob_sha": snap["blobs"].get(path),
                                   "line_count": len(text.split("\n")),
                                   "unreadable_count": None})

    # ---- the logs, every line, the unreadable ones kept (7(b))
    facts: dict = {}
    first_log_of: dict = {}
    for path, text, obj, order in snap["logs"]:
        records, _warnings = parse_log(path, text)
        lane = file_lane(path)
        first_log_of.setdefault(lane.lower(), lane)
        unreadable = 0
        for rec in records:
            rec_id = f"{rec['lane']}:{rec['ordinal']}"
            # TWO FILES WHOSE NAMES DIFFER ONLY BY CASE are two logs for one
            # lane - Amendment 15(d)'s hand merge - and each keeps its lines
            # under its own spelling, so neither file's lines replace the other's.
            if rec_id in out["log_lines"]:
                rec_id = f"{rec['file']}:{rec['ordinal']}"
            if rec["unreadable"]:
                unreadable += 1
                row = {col: None for col in TABLE_COLUMNS["log_lines"]}
                row.update(lane=rec["lane"], file=rec["file"], ordinal=rec["ordinal"],
                           unreadable=1, unreadable_why=rec["unreadable_why"], raw=rec["raw"])
            else:
                row = {col: rec.get(col) for col in TABLE_COLUMNS["log_lines"]}
                row["payload_fields"] = json.dumps(payload_fields(rec["payload"]),
                                                   ensure_ascii=False, sort_keys=False)
            put("log_lines", rec_id, row)
            if rec["unreadable"]:
                continue
            f = facts.setdefault(lane.lower(), {"home": None, "sid": None, "paused": []})
            fork = rec["payload"].startswith("fork ")
            if rec["verb"] in ("STARTED", "RESUMED") and not fork:
                hm = re.search(r"home [^ ;]+", rec["payload"])
                if hm:
                    value = hm.group(0)[5:]
                    if value != "unknown":
                        f["home"] = value
            if rec["verb"] in ("PAUSED", "RESUMED") and UUID_FULL_RE.match(rec["session"] or ""):
                f["sid"] = rec["session"].lower()
            if rec["verb"] == "PAUSED":
                pf = payload_fields(rec["payload"])
                if "transcript" in pf:
                    f["paused"].append((rec["file"], rec["ordinal"], pf.get("transcript"),
                                        pf.get("agent")))
        put("source_files", path, {"kind": "log", "lane": lane, "ls_order": order,
                                   "blob_sha": obj, "line_count": len(text.split("\n")),
                                   "unreadable_count": unreadable})

    # ---- the register: its rows and its Rule 6 / Amendment 10 lines
    rows = []
    for ordinal, line in enumerate(snap["register"].split("\n"), 1):
        name = row_name(line)
        if name is not None:
            if name != "":
                rows.append((REGISTER_PATH, ordinal, name, line, 0))
            continue
        fields = parse_register_line(line)
        if fields is not None:
            fields["ordinal"] = ordinal
            fields["raw"] = line
            put("register_lines", str(ordinal), fields)
    if snap.get("archive") is not None:
        for ordinal, line in enumerate(snap["archive"].split("\n"), 1):
            name = row_name(line)
            if name:
                rows.append((ARCHIVE_PATH, ordinal, name, line, 1))

    # ---- Amendment 16(e)'s alias table, every line kept
    alias_map: dict = {}
    if snap.get("aliases") is not None:
        for ordinal, line in enumerate(snap["aliases"].split("\n"), 1):
            if line.strip() == "":
                continue
            parts = line.split("\t")
            old = _trim(parts[0]) if parts else ""
            new = _trim(parts[1]) if len(parts) > 1 else ""
            when = _trim(parts[2]) if len(parts) > 2 else ""
            comment = bool(re.match(r"^[ \t]*#", line))
            put("lane_aliases", str(ordinal), {
                "old_name": None if comment else (old or None),
                "new_name": None if comment else (new or None),
                "utc": None if comment else (when or None), "ordinal": ordinal, "raw": line})
            if not comment and old and new:
                alias_map[old.lower()] = (old, new, ordinal)

    def resolve(name: str) -> str:
        seen = set()
        cur = name
        while cur.lower() in alias_map and cur.lower() not in seen:
            seen.add(cur.lower())
            cur = alias_map[cur.lower()][1]
        return cur

    aliases_of: dict = {}
    for _key, (old, _new, ordinal) in sorted(alias_map.items(), key=lambda kv: kv[1][2]):
        aliases_of.setdefault(resolve(old).lower(), []).append(old)

    # ---- one record per lane: every row, then every log with no row
    used_lower: set = set()
    for row_file, ordinal, name, line, archived in rows:
        rec_id = name
        if rec_id in out["lanes"]:
            rec_id = f"{name}~{'archive' if archived else 'register'}:{ordinal}"
        parts = line.split("|")
        session_cell = parts[2] if len(parts) > 2 else ""
        ids = UUID_RE.findall(session_cell.lower())
        f = facts.get(name.lower(), {})
        state = cell_state(line)
        put("lanes", rec_id, {
            "lane": name,
            "aliases": json.dumps(aliases_of.get(name.lower(), []), ensure_ascii=False),
            "home": f.get("home"),
            "workstation": _trim(parts[3]) if len(parts) > 3 else None,
            "started_utc": _trim(parts[4]) if len(parts) > 4 else None,
            "objects_cell": _trim(parts[5]) if len(parts) > 5 else None,
            "handoff_path": _trim(parts[6]) if len(parts) > 6 else None,
            "state_phrase": _trim(state) if state else None,
            "session_ids": json.dumps(ids),
            "last_session": ids[-1] if ids else f.get("sid"),
            "archived": archived, "owner": None,
            "row_file": row_file, "row_ordinal": ordinal, "row_text": line})
        used_lower.add(name.lower())
        cell_ids = ids
        for position, tid in enumerate(cell_ids, 1):
            put("transcript_pointers", f"{rec_id}:cell:{position}", {
                "lane": name, "kind": "session-cell", "transcript_id": tid, "agent": None,
                "position": position})
    for path, _text, _obj, _order in snap["logs"]:
        lane = file_lane(path)
        key = lane.lower()
        if key in used_lower:
            continue
        used_lower.add(key)
        f = facts.get(key, {})
        put("lanes", lane, {
            "lane": lane,
            "aliases": json.dumps(aliases_of.get(key, []), ensure_ascii=False),
            "home": f.get("home"), "workstation": None, "started_utc": None,
            "objects_cell": None, "handoff_path": None, "state_phrase": None,
            "session_ids": json.dumps([]), "last_session": f.get("sid"),
            "archived": 0, "owner": None, "row_file": None, "row_ordinal": None,
            "row_text": None})
    for key, f in facts.items():
        lane = first_log_of.get(key, key)
        for path, ordinal, tid, agent in f["paused"]:
            # KEYED AS `log_lines` IS (Copilot round 1 on #164): two logs whose
            # names differ only by case are two files, and a PAUSED at the same
            # line of each is two pointers, never one written over the other.
            rec_id = f"{lane}:log:{ordinal}"
            if rec_id in out["transcript_pointers"]:
                rec_id = f"{path}:log:{ordinal}"
            put("transcript_pointers", rec_id, {
                "lane": lane, "kind": "paused", "transcript_id": tid, "agent": agent,
                "position": ordinal})
    for table in ("transcript_pointers",):
        for record in out[table].values():
            for col in TABLE_COLUMNS[table]:
                record.setdefault(col, None)
    return out


# ================================================== the owner column's reader

def managed_projection(lane: str) -> str:
    """`legacy`, `managed <owner>` or `unknown`, AND NOTHING ELSE DECIDES IT.

    #97's own reader answers: `lanes-edit.sh managed-projection <lane>` exits 0
    with the owner, 8 for a legacy lane, anything else for UNKNOWN. This file
    carries no parser of the marker, so a malformed one can never be read here
    as `legacy` (Amendment 14(e)); a reader that could not be run at all is
    UNKNOWN for the same reason."""
    helper = lanes_edit_path()
    if not helper:
        return "unknown"
    try:
        proc = subprocess.run([helper, "managed-projection", lane], capture_output=True,
                              text=True, check=False, env=helper_env(),
                              stdin=subprocess.DEVNULL, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return "unknown"
    if proc.returncode == 0 and proc.stdout.strip():
        return f"managed {proc.stdout.strip().splitlines()[0]}"
    if proc.returncode == 8:
        return "legacy"
    return "unknown"


def fill_owners(records: dict, stored_lanes: dict | None) -> int:
    """Ask `managed-projection` for every lane whose row text is new or changed
    (all of them where `stored_lanes` is None, which is `reconcile`), and carry
    the stored answer over for a row that has not moved. An `unknown` is never
    carried: it may be a read that failed, and asking again is how it clears.
    Returns how many lanes were asked."""
    ask = []
    for rec_id, rec in records["lanes"].items():
        old = (stored_lanes or {}).get(rec_id)
        if stored_lanes is not None and old is not None and old.get("row_text") == rec["row_text"] \
                and old.get("lane") == rec["lane"] and old.get("owner") \
                and old.get("owner") != "unknown":
            rec["owner"] = old["owner"]
        else:
            ask.append(rec_id)
    if ask:
        workers = max(1, min(8, len(ask)))
        with ThreadPoolExecutor(max_workers=workers) as pool:
            answers = list(pool.map(lambda rid: managed_projection(records["lanes"][rid]["lane"]),
                                    ask))
        for rec_id, owner in zip(ask, answers):
            records["lanes"][rec_id]["owner"] = owner
    return len(ask)


# =============================================================== the stores

def ddl(dialect: str, schema: str) -> list[str]:
    q = (lambda name: f'"{schema}".{name}') if dialect == "postgres" else (lambda name: name)
    big = "BIGINT" if dialect == "postgres" else "INTEGER"
    stmts = [
        f"CREATE TABLE IF NOT EXISTS {q('schema_version')} "
        f"(version INTEGER NOT NULL, applied_utc TEXT NOT NULL)",
        f"CREATE TABLE IF NOT EXISTS {q('provenance')} (source TEXT NOT NULL PRIMARY KEY, "
        f"commit_sha TEXT, generation {big}, indexed_utc TEXT NOT NULL, "
        f"schema_version INTEGER NOT NULL)",
    ]
    for table, cols in TABLE_COLUMNS.items():
        defs = ["source TEXT NOT NULL", "record_id TEXT NOT NULL"]
        for col in cols:
            defs.append(f"{col} {big if col in INTEGER_COLUMNS else 'TEXT'}")
        defs += ["digest TEXT NOT NULL", "provenance TEXT", "indexed_utc TEXT NOT NULL",
                 "schema_version INTEGER NOT NULL", "PRIMARY KEY (source, record_id)"]
        stmts.append(f"CREATE TABLE IF NOT EXISTS {q(table)} ({', '.join(defs)})")
    # HOLDS ARE COMPUTED, NEVER STORED (14(e)), and computed AS `holders_of`
    # COMPUTES THEM (Copilot round 2 on #164), which is `who`'s answer:
    #   * a lane's state on an object is its own LAST line on it - the lane
    #     compared case-insensitively (Amendment 15), so two logs one case
    #     apart are one lane - and "last" is the FILE-ORDERED position
    #     (file, then line; PER_LANE_AWK's `file "\034" %09d line`), never
    #     the UTC (R14);
    #   * it holds while that verb is open, UNLESS another lane's own last line
    #     on the object is a TAKEOVER (`superseded_by`, R18, #30).
    # The file comparison is BYTE order, as awk's string comparison is: SQLite's
    # default BINARY collation, and Postgres's "C".
    coll = ' COLLATE "C"' if dialect == "postgres" else ""
    ll = q("log_lines")
    view = (
        f"WITH ev AS (SELECT source, lane, lower(lane) AS lk, object, verb, utc, session, "
        f"file, ordinal FROM {ll} WHERE unreadable = 0 AND object IS NOT NULL "
        f"AND object NOT LIKE 'lane:%'), "
        f"last AS (SELECT e.* FROM ev e WHERE NOT EXISTS (SELECT 1 FROM ev m "
        f"WHERE m.source = e.source AND m.object = e.object AND m.lk = e.lk "
        f"AND (m.file{coll} > e.file{coll} OR (m.file = e.file AND m.ordinal > e.ordinal)))) "
        f"SELECT h.source, h.lane, h.object, h.verb, h.utc, h.session, h.file, h.ordinal "
        f"FROM last h WHERE h.verb IN ({', '.join(repr(v) for v in OPEN_VERBS)}) "
        f"AND NOT EXISTS (SELECT 1 FROM last t WHERE t.source = h.source "
        f"AND t.object = h.object AND t.lk <> h.lk AND t.verb = 'TAKEOVER')")
    stmts.append(f"CREATE INDEX IF NOT EXISTS log_lines_by_object ON {ll} (source, object)")
    if dialect == "postgres":
        stmts.append(f"CREATE OR REPLACE VIEW {q('holds')} AS {view}")
    else:
        stmts.append(f"CREATE VIEW IF NOT EXISTS holds AS {view}")
    stmts.append(
        f"INSERT INTO {q('schema_version')} (version, applied_utc) SELECT {SCHEMA_VERSION}, "
        f"'{utc_now()}' WHERE NOT EXISTS (SELECT 1 FROM {q('schema_version')})")
    return stmts


class SqliteStore:
    dialect = "sqlite"

    def __init__(self, cfg: dict):
        self.path = cfg["sqlite"]
        self.label = "sqlite"
        self.where = self.path
        self.conn = None

    def open_read(self):
        import sqlite3
        if not os.path.exists(self.path):
            raise StoreUnusable("missing", f"{self.path} does not exist")
        try:
            self.conn = sqlite3.connect(f"file:{self.path}?mode=ro", uri=True, timeout=10)
            self.conn.execute("SELECT 1 FROM sqlite_master LIMIT 1").fetchall()
        except sqlite3.Error as exc:
            raise StoreUnusable("unreachable", f"{self.path}: {exc}")
        self._check_schema(writing=False)

    def open_write(self):
        import sqlite3
        os.makedirs(os.path.dirname(self.path), mode=0o700, exist_ok=True)
        try:
            self.conn = sqlite3.connect(self.path, timeout=30, isolation_level=None)
            # EVERY WRITE-OPEN, NOT ONLY THE FIRST (Copilot round 2 on #164): a
            # store whose mode drifted to 0644 is made private again before
            # another row goes into it, or nothing more is written.
            try:
                os.chmod(self.path, 0o600)
            except OSError as exc:
                raise StoreUnusable("unreachable", f"{self.path} cannot be made 0600 "
                                    f"({exc.strerror or exc}); nothing written")
            have = {r[0] for r in self.conn.execute(
                "SELECT name FROM sqlite_master WHERE type IN ('table','view')")}
            if "schema_version" in have:
                self._check_schema(writing=True)
            self.conn.execute("BEGIN IMMEDIATE")
            for stmt in ddl("sqlite", ""):
                self.conn.execute(stmt)
            self.conn.execute("COMMIT")
        except sqlite3.Error as exc:
            raise StoreUnusable("unreachable", f"{self.path}: {exc}")
        self._check_schema(writing=True)

    def _check_schema(self, writing: bool):
        import sqlite3
        try:
            rows = self.conn.execute("SELECT version FROM schema_version").fetchall()
        except sqlite3.Error:
            if writing:
                return
            raise StoreUnusable("wiped", f"{self.path} carries no schema_version table")
        versions = {r[0] for r in rows}
        if not versions:
            if writing:
                return
            raise StoreUnusable("wiped", f"{self.path} carries no schema_version row")
        if versions != {SCHEMA_VERSION}:
            raise StoreUnusable("unknown-schema",
                                f"schema {sorted(versions)} in {self.path}; this "
                                f"{PROG} knows {SCHEMA_VERSION}")

    def provenance(self, source: str) -> dict | None:
        import sqlite3
        try:
            row = self.conn.execute(
                "SELECT commit_sha, generation, indexed_utc, schema_version FROM provenance "
                "WHERE source = ?", (source,)).fetchone()
        except sqlite3.Error as exc:
            raise StoreUnusable("wiped", f"{self.path}: {exc}")
        if row is None:
            return None
        return {"commit_sha": row[0], "generation": row[1], "indexed_utc": row[2],
                "schema_version": row[3]}

    def all_provenance(self) -> list:
        import sqlite3
        try:
            return [{"source": r[0], "commit_sha": r[1], "generation": r[2], "indexed_utc": r[3],
                     "schema_version": r[4]} for r in self.conn.execute(
                         "SELECT source, commit_sha, generation, indexed_utc, schema_version "
                         "FROM provenance ORDER BY source")]
        except sqlite3.Error as exc:
            raise StoreUnusable("wiped", f"{self.path}: {exc}")

    def rows(self, table: str, source: str, columns: list[str]) -> list:
        # A TABLE THAT CANNOT BE READ IS A STORE THAT CANNOT ANSWER, said as the
        # provenance's reads say it (opensoft/openRepoTools#173, Copilot's
        # fourth review of #171): a `worktrees` table dropped or damaged under
        # valid provenance was a traceback, before `status` reached its
        # `rows: unread` line and before `export` could write its `why`.
        import sqlite3
        cols = ", ".join(["record_id"] + columns)
        try:
            return [dict(zip(["record_id"] + columns, r)) for r in self.conn.execute(
                f"SELECT {cols} FROM {table} WHERE source = ?", (source,))]
        except sqlite3.Error as exc:
            raise StoreUnusable("wiped", f"{self.path}: {exc}")

    def read_image(self, source: str, reads: list) -> tuple:
        """`provenance(source)`, then `rows(table, source, columns)` for each
        `(table, columns)` of `reads`, as ONE READ SNAPSHOT (opensoft/openRepoTools#166
        item 1). Each statement was its own snapshot, so a sync committing
        between two of them made an image of two commits under a `meta` naming
        the first. One read transaction holds the SHARED lock in the rollback
        journal - a writer's commit waits the fraction of a second the export
        takes - and in WAL mode it is a snapshot."""
        import sqlite3
        try:
            self.conn.execute("BEGIN")
        except sqlite3.Error as exc:
            raise StoreUnusable("unreachable", f"{self.path}: {exc}")
        try:
            prov = self.provenance(source)
            tables = [self.rows(table, source, columns) for table, columns in reads]
        finally:
            # A read transaction ends however its reads did; nothing was written.
            try:
                self.conn.execute("COMMIT")
            except sqlite3.Error:
                pass
        return prov, tables

    def apply(self, source: str, old: dict | None, new_sha: str, upserts: dict,
              deletes: dict, generation: int | None = None) -> None:
        """The rows and the provenance, ONE transaction, the compare-and-swap
        first. `new_sha` is the register's commit, or the inventory's
        fingerprint of its whole table (#161), and `generation` the inventory's
        sync count; a record carrying `_provenance` is stamped with that rather
        than with `new_sha` - the generation its tree's own record was filed
        under."""
        import sqlite3
        now = utc_now()
        try:
            self.conn.execute("BEGIN IMMEDIATE")
            cur = self.conn.execute("SELECT commit_sha FROM provenance WHERE source = ?",
                                    (source,)).fetchone()
            want = old["commit_sha"] if old else None
            if (cur[0] if cur else None) != want or (cur is None) != (old is None):
                self.conn.execute("ROLLBACK")
                raise CasLost(f"the provenance of {source} moved under this sync "
                              f"(it read {str(want)[:12]}, the store now holds "
                              f"{str(cur[0] if cur else None)[:12]}); nothing was written")
            if cur is None:
                self.conn.execute(
                    "INSERT INTO provenance (source, commit_sha, generation, indexed_utc, "
                    "schema_version) VALUES (?, ?, ?, ?, ?)",
                    (source, new_sha, generation, now, SCHEMA_VERSION))
            else:
                self.conn.execute(
                    "UPDATE provenance SET commit_sha = ?, generation = ?, indexed_utc = ?, "
                    "schema_version = ? WHERE source = ?",
                    (new_sha, generation, now, SCHEMA_VERSION, source))
            for table, ids in deletes.items():
                for rec_id in ids:
                    self.conn.execute(f"DELETE FROM {table} WHERE source = ? AND record_id = ?",
                                      (source, rec_id))
            for table, recs in upserts.items():
                cols = TABLE_COLUMNS[table]
                allc = ["source", "record_id"] + cols + ["digest", "provenance", "indexed_utc",
                                                         "schema_version"]
                sets = ", ".join(f"{c} = excluded.{c}" for c in allc[2:])
                sql = (f"INSERT INTO {table} ({', '.join(allc)}) VALUES "
                       f"({', '.join('?' for _ in allc)}) ON CONFLICT (source, record_id) "
                       f"DO UPDATE SET {sets}")
                self.conn.executemany(sql, [
                    [source, rec_id] + [rec.get(c) for c in cols] +
                    [rec["digest"], rec.get("_provenance", new_sha), now, SCHEMA_VERSION]
                    for rec_id, rec in recs.items()])
            self.conn.execute("COMMIT")
        except sqlite3.Error as exc:
            try:
                self.conn.execute("ROLLBACK")
            except sqlite3.Error:
                pass
            raise StoreUnusable("unreachable", f"{self.path}: {exc}")


def _pg_quote(value) -> str:
    if value is None:
        return "NULL"
    if isinstance(value, int):
        return str(value)
    return "'" + str(value).replace("'", "''") + "'"


def _pg_unescape(field: str):
    """One field of `COPY ... TO STDOUT` in TEXT format: `\\N` is NULL and a
    backslash escapes the rest, exactly as the server wrote it."""
    if field == "\\N":
        return None
    if "\\" not in field:
        return field
    out, i, n = [], 0, len(field)
    simple = {"b": "\b", "f": "\f", "n": "\n", "r": "\r", "t": "\t", "v": "\v", "\\": "\\"}
    while i < n:
        ch = field[i]
        if ch != "\\" or i + 1 >= n:
            out.append(ch)
            i += 1
            continue
        nxt = field[i + 1]
        if nxt in simple:
            out.append(simple[nxt])
            i += 2
        elif nxt in "01234567":
            j = i + 1
            while j < n and j < i + 4 and field[j] in "01234567":
                j += 1
            out.append(chr(int(field[i + 1:j], 8)))
            i = j
        elif nxt == "x":
            j = i + 2
            while j < n and j < i + 4 and field[j] in "0123456789abcdefABCDEF":
                j += 1
            out.append(chr(int(field[i + 2:j], 16)) if j > i + 2 else "x")
            i = j
        else:
            out.append(nxt)
            i += 2
    return "".join(out)


class PostgresStore:
    """QA Postgres, reached ONLY through `psql` and ONLY where `url=` is
    configured. Nothing here imports a driver: `psql` is libpq's own client,
    and the password it needs is in the 0600 file `PGPASSFILE` names - never
    in this process's arguments and never in an environment it hands on."""

    dialect = "postgres"

    def __init__(self, cfg: dict, role: str):
        self.schema = cfg["schema"]
        if role == "reader":
            # NEVER THE WRITER'S CREDENTIAL FOR A READ (Copilot round 1 on #164).
            # The writer is the indexer's and no session's (14(c)), and `export`
            # is run by a session typing `--index`: with no `reader_url=` the
            # read is refused, and the read flags answer from the sources.
            if not cfg.get("reader_url"):
                raise Refusal(
                    "the configuration names a Postgres `url=` and no `reader_url=`: the "
                    "reads (`status`, `--index`) connect only as the SELECT-only reader, "
                    "never with the writer's credential (Amendment 14(c))")
            self.url, self.passfile = cfg["reader_url"], cfg.get("reader_passfile") or cfg["passfile"]
        else:
            self.url, self.passfile = cfg["url"], cfg["passfile"]
        self.label = "postgres"
        self.where = re.sub(r"^[A-Za-z][A-Za-z0-9+.-]*://", "", self.url).split("?", 1)[0]
        self.psql = shutil.which("psql") or ""

    def _env(self) -> dict:
        # THE CONFIGURED PASSWORD FILE OR NONE AT ALL (14(c); Copilot on #164):
        # an inherited `PGPASSWORD` or `PGPASSFILE` is dropped, and with no
        # `passfile=` libpq is handed an EMPTY 0600 file of this command's own -
        # never left to find `~/.pgpass` or a file some other environment named.
        env = {k: v for k, v in os.environ.items() if k not in ("PGPASSWORD", "PGPASSFILE")}
        env["PGPASSFILE"] = self.passfile or _no_password_file()
        env.setdefault("PGCONNECT_TIMEOUT", "5")
        env["PGAPPNAME"] = PROG
        return env

    def _run(self, script: str) -> str:
        if not self.psql:
            raise StoreUnusable("unreachable", "`url=` is configured and there is no `psql` on PATH")
        try:
            proc = subprocess.run(
                [self.psql, "--no-psqlrc", "-X", "-q", "-v", "ON_ERROR_STOP=1", "-d", self.url],
                input=script, capture_output=True, text=True, check=False, env=self._env(),
                timeout=300)
        except subprocess.TimeoutExpired:
            raise StoreUnusable("unreachable", "psql did not answer within 300 s")
        except OSError as exc:
            raise StoreUnusable("unreachable", f"psql could not be run: {exc}")
        if proc.returncode != 0:
            err = (proc.stderr.strip().splitlines() or [f"psql exited {proc.returncode}"])
            if "lanes-index: provenance moved" in proc.stderr:
                raise CasLost(err[-1])
            if proc.returncode == 2:
                raise StoreUnusable("unreachable", err[0])
            raise StoreUnusable("unreachable", err[-1])
        return proc.stdout

    def _query_many(self, queries: list[str], snapshot: bool = False) -> list[list[list]]:
        """Several SELECTs in ONE connection, each answered as TEXT-format COPY
        rows; a marker line no COPY row can be (one field, a control
        character) separates them. With `snapshot`, in ONE read-only
        REPEATABLE READ transaction: every SELECT reads the same snapshot."""
        marker = "\x1eLANES-INDEX-NEXT"
        parts = [f"SET search_path TO \"{self.schema}\";"]
        if snapshot:
            parts.append("BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY;")
        for query in queries:
            parts.append(f"COPY ({query}) TO STDOUT;")
            parts.append("\\echo '\\036LANES-INDEX-NEXT'")
        if snapshot:
            parts.append("COMMIT;")
        out = self._run("\n".join(parts) + "\n")
        results, current = [], []
        for line in out.split("\n"):
            if line == marker:
                results.append(current)
                current = []
                continue
            if line == "":
                continue
            current.append([_pg_unescape(f) for f in line.split("\t")])
        return results

    def open_read(self):
        try:
            res = self._query_many([
                f"SELECT version FROM \"{self.schema}\".schema_version"])
        except StoreUnusable as exc:
            if "does not exist" in exc.detail:
                raise StoreUnusable("wiped", exc.detail)
            raise
        versions = {int(r[0]) for r in res[0]} if res else set()
        if not versions:
            raise StoreUnusable("wiped", f"schema {self.schema} carries no schema_version row")
        if versions != {SCHEMA_VERSION}:
            raise StoreUnusable("unknown-schema", f"schema {sorted(versions)} in {self.schema}; "
                                f"this {PROG} knows {SCHEMA_VERSION}")

    def open_write(self):
        # THE VERSION FIRST (Copilot round 2 on #164): the DDL includes a
        # `CREATE OR REPLACE VIEW`, so running it against another schema's
        # store would rewrite that store before `open_read` called it
        # `unknown-schema`. Only an ABSENT schema (`wiped`) is bootstrapped.
        try:
            self.open_read()
            return
        except StoreUnusable as exc:
            if exc.kind != "wiped":
                raise
        script = ["SET standard_conforming_strings = on;", "BEGIN;"]
        script += [s + ";" for s in ddl("postgres", self.schema)]
        script.append("COMMIT;")
        self._run("\n".join(script) + "\n")
        self.open_read()

    def provenance(self, source: str) -> dict | None:
        res = self._query_many([self._provenance_query(source)])
        return self._provenance_of(res[0] if res else [])

    def all_provenance(self) -> list:
        res = self._query_many([
            "SELECT source, commit_sha, generation, indexed_utc, schema_version "
            "FROM provenance ORDER BY source"])
        return [{"source": r[0], "commit_sha": r[1], "generation": r[2], "indexed_utc": r[3],
                 "schema_version": r[4]} for r in (res[0] if res else [])]

    def rows(self, table: str, source: str, columns: list[str]) -> list:
        res = self._query_many([self._rows_query(table, source, columns)])
        return self._rows_of(res[0] if res else [], columns)

    @staticmethod
    def _provenance_query(source: str) -> str:
        return (f"SELECT commit_sha, generation, indexed_utc, schema_version FROM provenance "
                f"WHERE source = {_pg_quote(source)}")

    @staticmethod
    def _provenance_of(answer: list) -> dict | None:
        if not answer:
            return None
        r = answer[0]
        return {"commit_sha": r[0], "generation": r[1], "indexed_utc": r[2],
                "schema_version": r[3]}

    @staticmethod
    def _rows_query(table: str, source: str, columns: list[str]) -> str:
        return (f"SELECT {', '.join(['record_id'] + columns)} FROM {table} "
                f"WHERE source = {_pg_quote(source)}")

    @staticmethod
    def _rows_of(answer: list, columns: list[str]) -> list:
        out = []
        for r in answer:
            rec = dict(zip(["record_id"] + columns, r))
            for col in columns:
                if col in INTEGER_COLUMNS and rec[col] is not None:
                    rec[col] = int(rec[col])
            out.append(rec)
        return out

    def read_image(self, source: str, reads: list) -> tuple:
        """`SqliteStore.read_image`'s answer, ONE `psql` session and one
        REPEATABLE READ READ ONLY transaction (opensoft/openRepoTools#166 item 1):
        each `rows()` was a session of its own, and a snapshot of its own."""
        res = self._query_many([self._provenance_query(source)] +
                               [self._rows_query(table, source, columns)
                                for table, columns in reads], snapshot=True)
        if len(res) != len(reads) + 1:
            raise StoreUnusable("unreachable", f"psql answered {len(res)} of the "
                                f"{len(reads) + 1} reads of one export")
        return self._provenance_of(res[0]), [self._rows_of(answer, columns)
                                             for answer, (_table, columns) in zip(res[1:], reads)]

    def apply(self, source: str, old: dict | None, new_sha: str, upserts: dict,
              deletes: dict, generation: int | None = None) -> None:
        now = utc_now()
        want = old["commit_sha"] if old else None
        lines = ["SET standard_conforming_strings = on;", "BEGIN;",
                 f"SET LOCAL search_path TO \"{self.schema}\";",
                 # THE COMPARE-AND-SWAP, FIRST AND IN THE SAME TRANSACTION AS THE
                 # ROWS: the UPDATE takes the provenance row's lock, so a second
                 # writer reading the same old commit blocks here and then finds
                 # it moved, and its whole transaction goes (Amendment 14(d)).
                 "DO $lanes_index_cas$ DECLARE n integer; BEGIN",
                 f"  INSERT INTO provenance (source, commit_sha, generation, indexed_utc, "
                 f"schema_version) VALUES ({_pg_quote(source)}, NULL, NULL, {_pg_quote(now)}, "
                 f"{SCHEMA_VERSION}) ON CONFLICT (source) DO NOTHING;",
                 f"  UPDATE provenance SET commit_sha = {_pg_quote(new_sha)}, generation = "
                 f"{_pg_quote(generation)}, indexed_utc = "
                 f"{_pg_quote(now)}, schema_version = {SCHEMA_VERSION} WHERE source = "
                 f"{_pg_quote(source)} AND commit_sha IS NOT DISTINCT FROM {_pg_quote(want)};",
                 "  GET DIAGNOSTICS n = ROW_COUNT;",
                 "  IF n <> 1 THEN RAISE EXCEPTION 'lanes-index: provenance moved under this "
                 "sync; nothing was written'; END IF;",
                 "END $lanes_index_cas$;"]
        for table, ids in deletes.items():
            for rec_id in ids:
                lines.append(f"DELETE FROM {table} WHERE source = {_pg_quote(source)} AND "
                             f"record_id = {_pg_quote(rec_id)};")
        for table, recs in upserts.items():
            cols = TABLE_COLUMNS[table]
            allc = ["source", "record_id"] + cols + ["digest", "provenance", "indexed_utc",
                                                     "schema_version"]
            sets = ", ".join(f"{c} = EXCLUDED.{c}" for c in allc[2:])
            for rec_id, rec in recs.items():
                values = [source, rec_id] + [rec.get(c) for c in cols] + \
                    [rec["digest"], rec.get("_provenance", new_sha), now, SCHEMA_VERSION]
                lines.append(f"INSERT INTO {table} ({', '.join(allc)}) VALUES "
                             f"({', '.join(_pg_quote(v) for v in values)}) ON CONFLICT "
                             f"(source, record_id) DO UPDATE SET {sets};")
        lines.append("COMMIT;")
        self._run("\n".join(lines) + "\n")


def _no_password_file() -> str:
    """An empty 0600 file for libpq to read where no `passfile=` is configured
    (a passwordless role: peer, trust or certificate authentication)."""
    path = os.path.join(state_dir(), "lanes-index.nopass")
    try:
        os.makedirs(state_dir(), mode=0o700, exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        os.close(fd)
        os.chmod(path, 0o600)
    except OSError as exc:
        raise StoreUnusable("unreachable", f"{path} could not be made as the empty password "
                            f"file ({exc.strerror or exc}); nothing was sent to Postgres")
    return path


def open_store(cfg: dict, role: str):
    return SqliteStore(cfg) if cfg["store"] == "sqlite" else PostgresStore(cfg, role)


# ===== the SQL register: schema, roles, bootstrap and logins (007)
#
# THE SQL REGISTER'S SCHEMA, WHICH THE BOOTSTRAP ALONE APPLIES (feature 007,
# opensoft/openRepoTools#165; design.md §1.2, §1.3.1 and §1.5). Nothing here is
# a subcommand. `lanes-index bootstrap` calls `apply_register_migrations`
# through Brett's admin connection, after §1.4's CREATE ROLEs and the admin's
# GRANT and before §1.4's other statements. No client role owns anything in
# `lanes_register`, so no writer can apply a migration (§1.5: "Only the
# bootstrap applies them").
#
# FORWARD ONLY (§1.5). Migrations are numbered scripts, each one transaction,
# applied in order from the schema's `version` up to `REGISTER_SCHEMA_VERSION`.
# There is no down-migration: a bad one is followed by a forward fix. Each
# `migrations` row records `script_sha256`, the digest of its script as shipped.
#
# Migration 1 creates the schema. Its `CREATE SCHEMA` fails on a schema that
# already exists, so it never runs twice. Every later script follows §1.5's
# step 3, in one transaction:
#   - `SET LOCAL lock_timeout = '2000ms'`;
#   - `UPDATE register_head SET seq = seq WHERE id = 1`, so every older
#     writer snapshot gets 40001;
#   - a check that `version` is one below its own, else LR003;
#   - its DDL and GRANTs, then the new `version` and floors;
#   - its `migrations` row.
# A 55P03 is retried, never queued.

#: THE REGISTER'S SCHEMA THIS BUILD KNOWS (§1.5), apart from #160's
#: `SCHEMA_VERSION` above. Every copy in a release is one number (lane 2's
#: hygiene test, L2-N6), so it is assigned here and nowhere else.
REGISTER_SCHEMA_VERSION = 1

#: The floors the newest migration sets (§1.5, "The floors"): the oldest client
#: version that may write, and the oldest that may read. By default a migration
#: sets both to its own number, R3a's exact match. One that leaves older
#: clients correct may keep them, and says so in its header.
REGISTER_WRITERS_FROM = 1
REGISTER_READERS_FROM = 1

#: Migration 1, part one: design.md §1.2's SQL block with lane 1's changes
#: (T107, opensoft/openRepoTools#165), which design.md has yet to fold:
#: erratum (c)'s backstop, `row_line_id`'s UNIQUE made DEFERRABLE INITIALLY
#: IMMEDIATE (ERR-48), and idx1's index `object_holds_by_line`, for step 6
#: (lane 3's NIT). Case 6a changes nothing here. It holds the
#: tables, views and indexes in `lanes_register`, and `render_file`,
#: `line_scopes`, `doc_line_scopes`, `entry_new_keys`, `scope_fault` and
#: `scope_checked`. It opens the one transaction (BEGIN), and part two ends it.
_REGISTER_M1_TABLES = r"""BEGIN;                                         -- one transaction (§1.5): SET LOCAL needs one
CREATE SCHEMA lanes_register AUTHORIZATION lanes_register_owner;
SET LOCAL ROLE lanes_register_owner;           -- so the owner owns every table and function
SET LOCAL search_path TO lanes_register, pg_catalog;

CREATE TABLE schema_version (                  -- §1.5: every client checks it first
  id           smallint    PRIMARY KEY DEFAULT 1 CHECK (id = 1),
  version      integer     NOT NULL CHECK (version >= 1),
  writers_from integer     NOT NULL,           -- oldest client version that may write
  readers_from integer     NOT NULL,           -- oldest client version that may read
  applied_utc  timestamptz NOT NULL,
  CHECK (1 <= readers_from AND readers_from <= writers_from AND writers_from <= version));

CREATE TABLE migrations (                      -- forward only: one row per script applied
  version       integer     PRIMARY KEY CHECK (version >= 1),
  script_sha256 text        NOT NULL CHECK (script_sha256 ~ '^[0-9a-f]{64}$'),
  applied_utc   timestamptz NOT NULL DEFAULT date_trunc('second', clock_timestamp()),
  by_lane       text        NOT NULL,
  by_ws         text        NOT NULL CHECK (by_ws <> ''));

CREATE TABLE register_switch (                 -- S1: the database half; lanes/STORE mirrors it (D24)
  id             smallint    PRIMARY KEY DEFAULT 1 CHECK (id = 1),
  mode           text        NOT NULL CHECK (mode IN ('files', 'primary')),
  marker_state   text        NOT NULL CHECK (marker_state IN ('absent', 'adding', 'present', 'removing')),
                                               -- F1, F2, F12: the marker as SQL knows it; adding and
                                               -- removing wait for S4's read-back (record_marker)
  marker_seq     bigint,                       -- the operator entry that last changed the marker
  marker_commit  text        CHECK (marker_commit ~ '^[0-9a-f]{40}$'),  -- the commit the read-back confirmed
  generation     uuid        NOT NULL,         -- F10, F18: the bootstrap's, or an after-loss cutover's
  repository     text        NOT NULL,                       -- owner/name
  database_label text        NOT NULL CHECK (strpos(database_label, '@') = 0), -- never a credential
  import_commit  text        CHECK (import_commit ~ '^[0-9a-f]{40}$'),
  import_tree    text        CHECK (import_tree ~ '^[0-9a-f]{40}$'),           -- C's lanes tree id
  import_seq     bigint,
  set_utc        timestamptz NOT NULL,
  set_seq        bigint      NOT NULL CHECK (set_seq >= -1),  -- the seq of the last change: an operator
                              -- entry's own (a cutover's 1, m+1 or b+1, a rollback's k+1), or an abort's base
  set_by_lane    text        NOT NULL,
  set_by_ws      text        NOT NULL CHECK (set_by_ws <> ''),
  restore_prior  jsonb,                        -- the restore form's cutover: the switch row and
                                               -- lanes/STORE's rows it replaced, for its abort
  CHECK (mode = 'files' OR (import_commit IS NOT NULL AND import_tree IS NOT NULL
                            AND import_seq IS NOT NULL)),
  CHECK ((mode = 'primary') = (marker_state IN ('adding', 'present'))),
  CHECK (marker_state = 'absent' OR marker_seq IS NOT NULL),
  CHECK (marker_state <> 'present' OR marker_commit IS NOT NULL),
  CHECK (restore_prior IS NULL OR marker_state = 'adding'));   -- cleared once confirmed

CREATE TABLE register_head (                   -- S1, S2, S6: its row lock orders every write.
  id  smallint PRIMARY KEY DEFAULT 1 CHECK (id = 1),   -- Never a SEQUENCE or IDENTITY:
  seq bigint   NOT NULL CHECK (seq >= -1));            -- gaps, and not commit order. -1: empty

CREATE TABLE mirror_state (                    -- D16: what the renderer reports; it never gates alone
  id             smallint    PRIMARY KEY DEFAULT 1 CHECK (id = 1),
  diverged_sha   text        CHECK (diverged_sha ~ '^[0-9a-f]{40}$'),   -- a stray commit stopped the renderer,
                                               -- or a last Register-Seq above the head (N6); a rollback
                                               -- entry is refused while it is set (S5, LR012)
  found_utc      timestamptz,
  found_by_ws    text        CHECK (found_by_ws <> ''),
  last_error     text,                         -- the last failed pass, for status
  last_error_utc timestamptz,
  CHECK ((diverged_sha IS NULL) = (found_utc IS NULL)),
  CHECK ((last_error IS NULL) = (last_error_utc IS NULL)));

CREATE TABLE journal (                         -- S2: one entry per write, gapless, commit order
  seq         bigint      PRIMARY KEY CHECK (seq >= 0),         -- = Register-Seq
  base_seq    bigint      UNIQUE REFERENCES journal (seq),      -- one chain, no gap
  write_id    uuid        NOT NULL CONSTRAINT journal_write_id_key UNIQUE,  -- ADV-C3
  utc         timestamptz NOT NULL DEFAULT date_trunc('second', clock_timestamp()), -- S6
  kind        text        NOT NULL CHECK (kind IN ('import', 'cutover', 'write',
                                         'stray-import', 'stray-revert', 'rollback')),
  operator    boolean     GENERATED ALWAYS AS (kind IN ('cutover', 'rollback')) STORED,
                                               -- D24, F2: touches lanes/STORE alone; never rendered;
                                               -- the command that writes it pushes it
  verb        text        NOT NULL,
  lane        text        NOT NULL,            -- 'unknown' where today's subject says it
  workstation text        NOT NULL CHECK (workstation <> ''),   -- Rule 10
  author      text        NOT NULL CHECK (author ~ '^[^<>]+ <[^<>]*>$'
                                          AND strpos(author, E'\n') = 0),
  message     text        NOT NULL CHECK (message <> '' AND strpos(message, E'\r') = 0),
  git_commit  text        CHECK (git_commit ~ '^[0-9a-f]{40}$'),
  git_tree    text        CHECK (git_tree ~ '^[0-9a-f]{40}$'),
  repos_blob  text        CHECK (repos_blob ~ '^[0-9a-f]{40}$'),
  args_sha256 text        CHECK (args_sha256 ~ '^[0-9a-f]{64}$'),  -- F10: the lane, verb and arguments,
                                                                   -- as the pending record's digest
  act_id      text        CHECK (act_id ~ '^[^@[:space:]]+$'),     -- D5, F5: the id of the act that made
                                                                   -- a write (LANES_ACT); NULL: no act
  CHECK (kind <> 'write' OR args_sha256 IS NOT NULL),
  CONSTRAINT journal_act_id_write CHECK (kind = 'write' OR act_id IS NULL),  -- none on another kind
  CHECK (base_seq IS NULL OR base_seq = seq - 1),   -- the one root (journal_one_root) may sit at any seq
  CHECK (utc = date_trunc('second', utc)),     -- whole seconds, as utc_now writes them
  CHECK (kind <> 'import' OR (git_commit IS NOT NULL AND git_tree IS NOT NULL)),
  CHECK (kind NOT IN ('stray-import', 'stray-revert') OR git_commit IS NOT NULL));
CREATE UNIQUE INDEX journal_one_root ON journal ((base_seq IS NULL)) WHERE base_seq IS NULL;  -- one chain, one root

CREATE TABLE journal_edits (                   -- Rule 9(d): a known, finite set of line edits
  seq        bigint  NOT NULL REFERENCES journal (seq),
  ord        integer NOT NULL CHECK (ord >= 1),   -- applied in this order
  op         text    NOT NULL CHECK (op IN ('create', 'append', 'replace', 'delete',
                                            'rename', 'remove')),
  path       text    COLLATE "C" NOT NULL,
  line_no    integer CHECK (line_no >= 1),        -- in the image the earlier edits left
  old_sha256 text    CHECK (old_sha256 ~ '^[0-9a-f]{64}$'),
  new_text   text    CHECK (strpos(new_text, E'\n') = 0 AND strpos(new_text, E'\r') = 0),
  to_path    text    COLLATE "C" CHECK (to_path ~ '^lanes/(archive|log)/[^/]+\.md$'
                                        AND to_path <> 'lanes/log/README.md'),
  PRIMARY KEY (seq, ord),
  CHECK (path ~ '^lanes/(LANES\.md|STORE|aliases\.tsv|archive/[^/]+\.md|log/[^/]+\.md)$'
         AND path <> 'lanes/log/README.md'),      -- Q18 (A): the rendered paths, and lanes/STORE for the operator entries
  CHECK ((op IN ('replace', 'delete')) = (line_no IS NOT NULL AND old_sha256 IS NOT NULL)),
  CHECK ((op IN ('append', 'replace')) = (new_text IS NOT NULL)),
  CHECK ((op = 'rename') = (to_path IS NOT NULL)));

CREATE TABLE journal_files (                   -- S2: each touched file's bytes after the write
  seq     bigint  NOT NULL REFERENCES journal (seq),
  path    text    COLLATE "C" NOT NULL,
  present boolean NOT NULL,                    -- false: removed or renamed away
  sha256  text    CHECK (sha256 ~ '^[0-9a-f]{64}$'),
  final_newline boolean,                       -- files.final_newline after the write
  PRIMARY KEY (seq, path),
  CHECK (present = (sha256 IS NOT NULL) AND present = (final_newline IS NOT NULL)));

CREATE TABLE journal_scopes (                  -- D5, F5: each entry's touched keys (lane 4's scopes),
  seq   bigint NOT NULL REFERENCES journal (seq) ON DELETE CASCADE,  -- derived by steps 5a and 8a,
  scope text   COLLATE "C" NOT NULL                                   -- never sent by a client
        CHECK (scope = lower(scope) AND (scope = '*'                  -- '*': every scope
               OR scope ~ '^(row|bind|objects|alias|archive):[^[:space:]]+$'
               OR scope ~ '^sid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')),
  PRIMARY KEY (scope, seq));                   -- step 3b: one index range per listed scope

CREATE TABLE files (                           -- the rendered files as they stand
  path          text    COLLATE "C" PRIMARY KEY
                CHECK (path ~ '^lanes/(LANES\.md|STORE|aliases\.tsv|archive/[^/]+\.md|log/[^/]+\.md)$'
                       AND path <> 'lanes/log/README.md'),
  final_newline boolean NOT NULL,
  sha256        text    NOT NULL CHECK (sha256 ~ '^[0-9a-f]{64}$'),
  last_seq      bigint  NOT NULL REFERENCES journal (seq));

CREATE TABLE doc_lines (                       -- the truth: a file is its lines in line_no order
  line_id      bigint  GENERATED ALWAYS AS IDENTITY PRIMARY KEY, -- stable; writes are serial under
                                                                  -- the head lock: ascending = append order
  path         text    COLLATE "C" NOT NULL REFERENCES files (path) ON UPDATE CASCADE,
  line_no      integer NOT NULL CHECK (line_no >= 1),
  text         text    NOT NULL CHECK (strpos(text, E'\n') = 0 AND strpos(text, E'\r') = 0),
  written_seq  bigint  NOT NULL REFERENCES journal (seq),
  written_mode text    NOT NULL CHECK (written_mode IN ('files', 'primary')), -- S1: mode last written
  written_ws   text,
  CONSTRAINT doc_lines_pos UNIQUE (path, line_no) DEFERRABLE INITIALLY IMMEDIATE, -- a delete shifts lines
  CHECK (written_mode = 'files' OR coalesce(written_ws, '') <> ''));          -- Rule 10, new writes

-- The structured layer: today's parsers' rows, filled in the same transaction. A constraint
-- that history breaks binds only mode = 'primary' (r3a/REPORT.md:348).
CREATE TABLE lanes (                           -- one row per lane, LANES.md and archive/ together
  lane_key    text    COLLATE "C" PRIMARY KEY,
  lane        text    COLLATE "C" NOT NULL CHECK (lower(lane) = lane_key),   -- Amendment 15
  row_line_id bigint  UNIQUE DEFERRABLE INITIALLY IMMEDIATE    -- ERR-48: checked at the statement's
                      REFERENCES doc_lines (line_id) DEFERRABLE INITIALLY DEFERRED,  -- end, as
                                               -- doc_lines_pos is, so never an ON CONFLICT arbiter
  aliases jsonb, home text, workstation text, started_utc text, handoff_path text,
  state_phrase text, objects_cell text, session_ids jsonb, last_session text,
  archived    boolean NOT NULL,
  owner       text,                            -- a copy; S4 answers from the row's own text
  last_seq    bigint  NOT NULL REFERENCES journal (seq),
  last_mode   text    NOT NULL CHECK (last_mode IN ('files', 'primary')));
CREATE INDEX lanes_by_last_session ON lanes (last_session);    -- binding; the guard's triple

CREATE TABLE log_lines (                       -- every log line; unreadable ones kept (7(b))
  line_id        bigint  PRIMARY KEY REFERENCES doc_lines (line_id) ON DELETE CASCADE
                         DEFERRABLE INITIALLY DEFERRED,
  file           text    COLLATE "C" NOT NULL,
  ordinal        integer NOT NULL,
  lane           text    NOT NULL,
  verb text, session text, workstation text, utc text, utc_ts timestamptz, object text,
  ref text, payload text, payload_fields jsonb, free_text text, written_lane text,
  unreadable     boolean NOT NULL,
  unreadable_why text,
  raw            text    NOT NULL,
  seq            bigint  NOT NULL REFERENCES journal (seq),
  mode           text    NOT NULL CHECK (mode IN ('files', 'primary')),
  CONSTRAINT log_lines_pos UNIQUE (file, ordinal) DEFERRABLE INITIALLY IMMEDIATE, -- shifts too
  CHECK (unreadable = (unreadable_why IS NOT NULL)),
  CHECK (mode = 'files' OR (NOT unreadable AND coalesce(workstation, '') <> ''   -- no CHECK on
         AND utc ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'     -- verb: WORD
         AND utc_ts IS NOT NULL)));                                             -- (S6, 7(b))
CREATE INDEX log_lines_by_object ON log_lines (object) WHERE NOT unreadable;

CREATE TABLE object_holds (                    -- each lane's LAST line per object, file order
  object        text    NOT NULL,
  lane_key      text    COLLATE "C" NOT NULL,
  lane          text    NOT NULL,
  verb          text    NOT NULL,
  utc_ts        timestamptz,
  file          text    COLLATE "C" NOT NULL,
  ordinal       integer NOT NULL,
  superseded_by text,                          -- another lane whose last line on it is TAKEOVER
  spellings     text[],                        -- D19, a live claim's: as typed, canonical key, the writer's aliases
  exempt        boolean NOT NULL DEFAULT false, -- set only by an import, on a pair already at C
  seq           bigint  NOT NULL REFERENCES journal (seq),
  mode          text    NOT NULL CHECK (mode IN ('files', 'primary')),
  PRIMARY KEY (object, lane_key),
  CHECK (NOT exempt OR mode = 'files'));
CREATE UNIQUE INDEX one_live_claim ON object_holds (object)   -- Rule 1's net under claim's own check
  WHERE NOT exempt AND superseded_by IS NULL AND verb IN ('CLAIMED', 'TAKEOVER');
CREATE INDEX object_holds_by_line ON object_holds (file, ordinal);  -- step 6 finds a line's holds (ERR-48)

CREATE VIEW holds AS                           -- holders_of (code/lanes-index:1013-1036)
  SELECT object, lane_key, lane, verb, utc_ts, file, ordinal, seq, mode FROM object_holds
  WHERE superseded_by IS NULL AND object NOT LIKE 'lane:%'   -- lane-kind objects hold nothing
    AND verb IN ('CLAIMED', 'TAKEOVER', 'OPENED', 'LANDING', 'WITHDRAWN');

CREATE VIEW stale_claims AS                    -- claim_is_stale (code/lanes-edit.sh:4318) on the DB clock
  SELECT h.* FROM object_holds h
  WHERE h.verb = 'CLAIMED' AND h.superseded_by IS NULL
    AND clock_timestamp() - h.utc_ts > interval '4 hours'
    AND NOT EXISTS (SELECT 1 FROM log_lines o WHERE o.object = h.object AND o.verb = 'OPENED')
    AND NOT EXISTS (SELECT 1 FROM log_lines o WHERE lower(o.lane) = h.lane_key
                    AND o.file = h.file AND o.ordinal > h.ordinal AND o.verb = 'OPENED'
                    AND h.object = ANY (string_to_array(o.payload, ' ')));

CREATE TABLE register_lines (                  -- every non-row LANES.md line, parsed best effort
  line_id     bigint  PRIMARY KEY REFERENCES doc_lines (line_id) ON DELETE CASCADE
                      DEFERRABLE INITIALLY DEFERRED,
  kind        text,
  slot_role   text    CHECK (slot_role IN ('take', 'close')),  -- NULL decides nothing
  slot_kind   text    CHECK (slot_kind IN ('hold', 'landing')),
  lane text, repo text, repo_key text, pr integer, tip text, utc text, utc_ts timestamptz,
  session text,
  for_lane    text,                            -- F13: the lane whose LANDING a LANDING EXPIRED closes
  raw         text    NOT NULL,
  seq         bigint  NOT NULL REFERENCES journal (seq),
  mode        text    NOT NULL CHECK (mode IN ('files', 'primary')),
  workstation text,
  repo_spellings text[],                       -- D18, a slot line's: as typed, canonical key, the writer's aliases
  CHECK ((slot_role IS NULL) = (slot_kind IS NULL)),
  CHECK (slot_role IS NULL OR repo_key IS NOT NULL),
  CHECK (slot_kind IS DISTINCT FROM 'landing' OR pr IS NOT NULL),   -- RULE6_AWK pairs by PR
  CHECK ((for_lane IS NOT NULL) = (kind IS NOT DISTINCT FROM 'LANDING EXPIRED')),
  CHECK (for_lane IS NULL OR (slot_role = 'close' AND slot_kind = 'landing')),
  CHECK (mode = 'files' OR coalesce(workstation, '') <> ''));
CREATE INDEX register_lines_slots ON register_lines (repo_key, line_id) WHERE slot_role IS NOT NULL;
CREATE INDEX files_last_seq ON files (last_seq);                 -- the seven columns that reference
CREATE INDEX doc_lines_written_seq ON doc_lines (written_seq);   -- journal (seq) and lead no index,
CREATE INDEX lanes_last_seq ON lanes (last_seq);                 -- so an import's deletes do not
CREATE INDEX log_lines_seq ON log_lines (seq);                   -- scan a table per journal row
CREATE INDEX object_holds_seq ON object_holds (seq);
CREATE INDEX register_lines_seq ON register_lines (seq);
CREATE INDEX journal_scopes_seq ON journal_scopes (seq);

CREATE VIEW main_slots AS                      -- A10, Rule 6: the earliest open take wins
  SELECT t.repo_key, t.line_id, t.kind, t.slot_kind, t.lane, t.pr, t.tip, t.utc_ts, t.raw,
         CASE WHEN t.slot_kind = 'landing'
              THEN clock_timestamp() - t.utc_ts > interval '30 minutes' END AS stale,
         rank() OVER (PARTITION BY t.repo_key ORDER BY t.line_id) AS place,
         t.repo_spellings                      -- D18: one repository, however spelled
  FROM register_lines t
  WHERE t.slot_role = 'take'
    AND NOT EXISTS (SELECT 1 FROM register_lines c
                    WHERE c.slot_role = 'close' AND c.slot_kind = t.slot_kind
                      AND (c.repo_key = t.repo_key OR c.repo_spellings && t.repo_spellings)
                      AND lower(coalesce(c.for_lane, c.lane)) = lower(t.lane)
                      AND c.line_id > t.line_id AND (t.slot_kind = 'hold' OR c.pr = t.pr));

CREATE FUNCTION render_file(p_path text) RETURNS bytea LANGUAGE sql STABLE
  SET search_path = lanes_register, pg_catalog, pg_temp AS $f$
  SELECT convert_to(coalesce(string_agg(d.text, E'\n' ORDER BY d.line_no), '')
           || CASE WHEN f.final_newline AND count(d.line_id) > 0 THEN E'\n' ELSE '' END, 'UTF8')
  FROM files f LEFT JOIN doc_lines d ON d.path = f.path
  WHERE f.path = p_path GROUP BY f.final_newline $f$;

CREATE FUNCTION line_scopes(p_path text, p_text text) RETURNS SETOF text LANGUAGE sql IMMUTABLE
  SET search_path = lanes_register, pg_catalog, pg_temp AS $f$
  -- D5, F5: the scopes a line names by its text, by build_records' rules (code/lanes-index:765):
  -- a row by ROW_AWK's (row_name, :648-660), in LANES.md (:831-837) or the archive (:843-847); a
  -- lane-kind line by its verb (parse_log_line, :538-546) in the log that file_lane names
  -- (:530-532); an alias line by its first two tab fields (:849-865); a uuid by UUID_RE (:110).
  -- S3: an archived row also names its normalized key, where that differs from its own, by
  -- RETIRED_ROWS_AWK's key() (code/lanes-edit.sh:3743-3760): the name before its last '-',
  -- lower-cased, '-', and the digits after it, less one trailing letter, without leading zeros.
  WITH l AS (SELECT substring(p_text FROM '^\|[^`]*`([^`]*)`') AS rown,
               p_path ~ '^lanes/log/' AND p_text ~
                 '^[ \t]*(STARTED|RESUMED|PAUSED|ENDED|RETIRED|RENAMED)[ \t]* — ' AS lane_kind,
               lower(regexp_replace(regexp_replace(p_path, '^.*/', ''), '\.[Mm][Dd]$', '')) AS flane),
       a AS (SELECT lower(m[1]) || '-' || coalesce(nullif(ltrim(m[2], '0'), ''), '0') AS akey
             FROM l, regexp_match(rown, '^(.*)-([0-9]+)[A-Za-z]?$') AS m)   -- NULL: no key
  SELECT 'row:' || lower(rown) FROM l WHERE p_path = 'lanes/LANES.md' AND rown <> ''
  UNION SELECT 'archive:' || lower(rown) FROM l WHERE p_path ~ '^lanes/archive/' AND rown <> ''
  UNION SELECT 'archive:' || akey FROM l, a WHERE p_path ~ '^lanes/archive/' AND akey <> lower(rown)
  UNION SELECT 'bind:' || flane FROM l WHERE lane_kind
  UNION SELECT 'sid:' || u.m[1] FROM l, regexp_matches(lower(p_text),
          '([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})', 'g') AS u(m)
        WHERE lane_kind OR (rown <> '' AND p_path ~ '^lanes/(LANES\.md|archive/)')
  UNION SELECT 'alias:' || lower(a) FROM l, unnest(ARRAY[btrim(split_part(p_text, E'\t', 1), E' \t'),
          btrim(split_part(p_text, E'\t', 2), E' \t')]) AS a
        WHERE p_path = 'lanes/aliases.tsv' AND p_text !~ '^[ \t]*#' AND a <> '' $f$;

CREATE FUNCTION doc_line_scopes(p_line_id bigint, p_path text) RETURNS SETOF text LANGUAGE sql STABLE
  SET search_path = lanes_register, pg_catalog, pg_temp AS $f$
  -- A stored line's scopes, read at p_path: its text's, and objects: from its structured row: a
  -- readable log line on an object that is not lane-kind (parse_log, :618-645), and a slot
  -- line's lane and a LANDING EXPIRED's for_lane (parse_register_line, :683-713; D18, F13).
  SELECT line_scopes(p_path, d.text) FROM doc_lines d WHERE d.line_id = p_line_id
  UNION SELECT 'objects:' || lower(g.lane) FROM log_lines g
    WHERE g.line_id = p_line_id AND NOT g.unreadable AND g.object NOT LIKE 'lane:%'
  UNION SELECT 'objects:' || lower(x) FROM register_lines r, unnest(ARRAY[r.lane, r.for_lane]) AS x
    WHERE r.line_id = p_line_id AND r.slot_role IS NOT NULL AND x IS NOT NULL $f$;

CREATE FUNCTION entry_new_keys(p_seq bigint) RETURNS TABLE (path text, line_no integer, scope text)
  LANGUAGE sql STABLE SET search_path = lanes_register, pg_catalog, pg_temp AS $f$
  -- Step 8a's new side, each key with the line it came from (N2): every line entry p_seq appended
  -- or replaced, every line a rename moved, read at its new path, and objects: for every lane
  -- holding an object it wrote a hold for, at that lane's last line on the object.
  SELECT d.path, d.line_no, k.scope FROM doc_lines d, doc_line_scopes(d.line_id, d.path) AS k(scope)
    WHERE d.written_seq = p_seq
  UNION SELECT d.path, d.line_no, k.scope FROM journal_edits j JOIN doc_lines d ON d.path = j.to_path,
      doc_line_scopes(d.line_id, d.path) AS k(scope)
    WHERE j.seq = p_seq AND j.op = 'rename'
  UNION SELECT h.file, h.ordinal, 'objects:' || lower(h.lane_key)   -- N1: lower(), as doc_line_scopes;
    FROM object_holds n JOIN object_holds h ON h.object = n.object  -- lane_key is lower case by construction
    WHERE n.seq = p_seq AND n.object NOT LIKE 'lane:%' $f$;

CREATE FUNCTION scope_fault(p_scope text) RETURNS text LANGUAGE sql IMMUTABLE
  SET search_path = lanes_register, pg_catalog, pg_temp AS $f$
  -- N2: NULL where a derived key has a scope's form, journal_scopes' CHECK read with Unicode's
  -- White_Space (the no-break space included; the CHECK's [:space:] under "C" is ASCII's alone);
  -- else the key, each white-space character shown as [U+hhhh].
  SELECT CASE WHEN p_scope ~ '^sid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
                OR (p_scope ~ '^(row|bind|objects|alias|archive):.' AND p_scope !~ w.re
                    AND p_scope = lower(p_scope COLLATE "C")) THEN NULL
         ELSE (SELECT string_agg(CASE WHEN c ~ w.re THEN '[U+' || lpad(upper(to_hex(ascii(c))), 4, '0')
                                      || ']' ELSE c END, '' ORDER BY n)
               FROM regexp_split_to_table(p_scope, '') WITH ORDINALITY AS t(c, n)) END
  FROM (VALUES ('[\t\n\v\f\r \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]')) AS w(re) $f$;

CREATE FUNCTION scope_checked(p_path text, p_line integer, p_scope text) RETURNS text
  LANGUAGE plpgsql IMMUTABLE SET search_path = lanes_register, pg_catalog, pg_temp AS $f$
-- N2: a derived key, returned as it is, or LR010 naming the line it came from.
DECLARE
  v_shown text := scope_fault(p_scope);
BEGIN
  IF v_shown IS NOT NULL THEN
    RAISE EXCEPTION 'key: % line % derives %, which is not a scope (a scope''s name is lower case, not empty, and holds no white space)',
      p_path, p_line, v_shown USING ERRCODE = 'LR010'; END IF;
  RETURN p_scope;
END $f$;
-- commit_write, switch_to_files, record_marker, find_write and record_mirror_state follow in §1.3.1, in this transaction;
-- its block ends migration 1: schema_version (1, 1, 1), register_head (-1), an empty
-- mirror_state row, the switch at 'files' (set_seq -1), the migrations row, then COMMIT.
"""

#: Migration 1, part two: design.md §1.3.1's SQL block with lane 1's changes
#: to `commit_write` (T107, opensoft/openRepoTools#165), which design.md has
#: yet to fold: erratum (c)'s step 6, which deletes the structured rows its
#: edits leave stale, with the entry's `object_holds` comment (ERR-48); and
#: case 6a, where step 6 keeps the objects whose holds it deletes, step 7
#: re-marks their stored rows and stamps no `seq` or `mode` on them, and step
#: 5a adds `objects:` for every lane holding an object whose hold sits on a
#: line the entry changes (lane 3's ruling, #165 6771318480). It holds
#: `commit_write` in full, then `switch_to_files`, `record_marker`,
#: `find_write` and `record_mirror_state`, then migration 1's rows: the version
#: (1, 1, 1), the head at -1, an empty `mirror_state`, the switch at `files`
#: with the marker `absent` and `set_seq` -1, and the `migrations` row. Then
#: COMMIT. Its psql variables are the bootstrap's inputs: `repo`, `label`,
#: `lane`, `ws` and `script_sha256`.
_REGISTER_M1_FUNCTIONS = r"""CREATE FUNCTION commit_write(p_base bigint, p_write_id uuid, p_client integer, p_generation uuid,
                             p_entry jsonb)
  RETURNS bigint LANGUAGE plpgsql SECURITY DEFINER
  SET search_path = lanes_register, pg_catalog, pg_temp AS $f$
-- The entry is one jsonb object; an absent key is an empty list.
--   journal        {kind, verb, lane, workstation, author, message, git_commit, git_tree,
--                   repos_blob, args_sha256}: step 5's columns; args_sha256 (F10) is the
--                   pending record's digest of the lane, verb and arguments
--   root_seq       an import's root on an empty journal (--after-loss's m); else absent
--   switch         {after_loss, database_label}: a cutover's after-loss form (F18)
--   not_after      required: the call's bound (F3), the snapshot's database clock plus the
--                  call's client timer plus 2 s; an attempt that ends past it is LR008
--   act            a write's, made inside one of lane 4's acts (D5, F5); else absent:
--                  {id, base, generation, expect}: LANES_ACT's id (journal.act_id) and base
--                  seq, the generation its base was read in, and LANES_EXPECT's scopes, a
--                  list that may be empty (step 3b). Files mode ignores both variables.
--   edits          [{ord, op, path, line_no, old_sha256, new_text, to_path}], journal_edits'
--                  columns; old_sha256 is the sha256 of the line's UTF-8 text, without its LF
--   files          [{path, present, sha256, final_newline}]: every path an edit touches, as
--                  it stands after the write (a rename's old path is present = false)
--   lanes          [{path, line_no, raw, lane_key, lane, aliases, home, workstation,
--                    started_utc, handoff_path, state_phrase, objects_cell, session_ids,
--                    last_session, archived, owner}]
--   log_lines      [{path, line_no, raw, lane, verb, session, workstation, utc, utc_ts,
--                    object, ref, payload, payload_fields, free_text, written_lane,
--                    unreadable, unreadable_why}]
--   register_lines [{path, line_no, raw, kind, slot_role, slot_kind, lane, repo, repo_key,
--                    repo_spellings, pr, tip, utc, utc_ts, session, for_lane, workstation}]
--   object_holds   [{object, lane_key, lane, verb, utc_ts, file, ordinal, spellings, exempt}]:
--                  each lane's last line per object, as the lines stand after the write, for
--                  every lane and object that a line the entry writes, replaces or deletes
--                  names, and every one the lines of a renamed log give: step 6 deletes the
--                  holds on each line it changes, and every hold of a path it renames or
--                  removes (ERR-48); superseded_by is computed here
-- A structured row names its line by path and line_no, and its raw is that line's text.
-- Step 7 applies lanes, log_lines, register_lines, then object_holds, in that order.
DECLARE
  v_head  bigint;
  v_ver   schema_version;
  v_sw    register_switch;
  v_old   journal;                              -- F10: a write id already in the journal
  v_needs text;
  v_after_loss boolean := coalesce((p_entry -> 'switch' ->> 'after_loss')::boolean, false);
  v_seq   bigint;
  v_kind  text := p_entry -> 'journal' ->> 'kind';
  v_ws    text := p_entry -> 'journal' ->> 'workstation';
  v_wmode text;                                 -- written_mode and mode of the rows written
  v_holds jsonb := coalesce(p_entry -> 'object_holds', '[]');
  v_gone  text[] := '{}';                       -- case 6a: the objects whose holds step 6 deleted
  v_imp   journal;
  v_prior jsonb;                                -- the restore form's: what its cutover replaces
  v_line  doc_lines;
  ed      journal_edits;
  r       record;
  v_n     integer;
  v_sha   text;
  v_con   text;
  v_det   text;
  v_not_after timestamptz;                      -- F3: the call's bound (step 9)
  v_act   jsonb := p_entry -> 'act';            -- D5, F5: the act, or NULL (step 3b)
  v_expect text[];                              -- its scopes, lower case, as listed
  v_hit   record;                               -- the entry that changed one (LR009)
  v_mir   mirror_state;                         -- S5: a rollback's divergence gate (LR012)
  v_take  register_lines;                       -- U3's take, or F13's newest take
  v_close record;                               -- F13: the close that already closed it
BEGIN
  IF jsonb_typeof(p_entry -> 'journal') IS DISTINCT FROM 'object' THEN    -- the entry's shape
    RAISE EXCEPTION 'the entry has no journal object' USING ERRCODE = 'LR004'; END IF;
  IF EXISTS (SELECT 1 FROM jsonb_each(p_entry -> 'journal') k
             WHERE jsonb_typeof(k.value) NOT IN ('string', 'null'))
     OR EXISTS (SELECT 1 FROM unnest(ARRAY['edits', 'files', 'lanes', 'log_lines',
                                           'register_lines', 'object_holds']) k
                WHERE p_entry ? k AND jsonb_typeof(p_entry -> k) <> 'array')
     OR jsonb_typeof(p_entry -> 'not_after') IS DISTINCT FROM 'string' THEN
    RAISE EXCEPTION 'the entry is not well formed' USING ERRCODE = 'LR004'; END IF;
  v_not_after := (p_entry ->> 'not_after')::timestamptz;
  v_needs := CASE v_kind WHEN 'write' THEN 'primary' WHEN 'stray-import' THEN 'primary'
                         WHEN 'stray-revert' THEN 'primary' WHEN 'rollback' THEN 'primary'
                         WHEN 'import' THEN 'files' WHEN 'cutover' THEN 'files' END;
  IF v_needs IS NULL THEN
    RAISE EXCEPTION 'unknown kind %', v_kind USING ERRCODE = 'LR004'; END IF;
  v_wmode := CASE WHEN v_kind IN ('write', 'cutover') THEN 'primary' ELSE 'files' END;
  IF v_kind IN ('cutover', 'rollback') AND (      -- ruling 1: an operator entry writes lanes/STORE
       EXISTS (SELECT 1 FROM jsonb_array_elements(coalesce(p_entry -> 'files', '[]')) f   -- alone:
               WHERE f ->> 'path' IS DISTINCT FROM 'lanes/STORE')     -- no other files row and
       OR EXISTS (SELECT 1 FROM unnest(ARRAY['lanes', 'log_lines', 'register_lines',  -- no row
                                             'object_holds']) k
                  WHERE jsonb_array_length(coalesce(p_entry -> k, '[]')) > 0)) THEN
    RAISE EXCEPTION 'a % entry writes outside lanes/STORE (ruling 1)', v_kind
      USING ERRCODE = 'LR004'; END IF;
  IF v_act IS NOT NULL THEN                     -- the act's shape (D5, F5): a write's alone
    IF v_kind <> 'write' OR jsonb_typeof(v_act) <> 'object'
       OR jsonb_typeof(v_act -> 'id') IS DISTINCT FROM 'string'
       OR jsonb_typeof(v_act -> 'base') IS DISTINCT FROM 'number'
       OR jsonb_typeof(v_act -> 'generation') IS DISTINCT FROM 'string'
       OR jsonb_typeof(coalesce(v_act -> 'expect', '[]')) <> 'array' THEN
      RAISE EXCEPTION 'the entry''s act is not well formed' USING ERRCODE = 'LR004'; END IF;
    IF v_act ->> 'id' !~ '^[^@[:space:]]+$' OR v_act ->> 'base' !~ '^[0-9]+$'
       OR lower(v_act ->> 'generation')
          !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
       OR EXISTS (SELECT 1 FROM jsonb_array_elements(coalesce(v_act -> 'expect', '[]')) x
                  WHERE jsonb_typeof(x) <> 'string'
                     OR lower(x #>> '{}') !~ ('^((row|bind|objects|alias|archive):[^[:space:]]+'
                          || '|sid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$')) THEN
      RAISE EXCEPTION 'the entry''s act is not well formed' USING ERRCODE = 'LR004'; END IF;
    v_expect := ARRAY(SELECT lower(t.x) FROM jsonb_array_elements_text(coalesce(v_act -> 'expect',
                        '[]')) WITH ORDINALITY AS t(x, n) ORDER BY t.n);
  END IF;

SELECT seq INTO v_head FROM register_head WHERE id = 1 FOR UPDATE;            -- 1. the lock
SELECT * INTO v_sw FROM register_switch WHERE id = 1;                         -- the generation first,
IF p_generation IS DISTINCT FROM v_sw.generation THEN       -- F10, F18: an id from another database,
  RAISE EXCEPTION 'write % belongs to register generation %, not %', p_write_id, p_generation,
    v_sw.generation USING ERRCODE = 'LR007', DETAIL = 'generation'; END IF;  -- whatever the switch reads (S-3)
SELECT * INTO v_old FROM journal WHERE write_id = p_write_id;                 -- a write in doubt
IF FOUND THEN                                                                 -- that committed
  IF v_old.lane IS DISTINCT FROM p_entry -> 'journal' ->> 'lane'
     OR v_old.verb IS DISTINCT FROM p_entry -> 'journal' ->> 'verb'
     OR v_old.args_sha256 IS DISTINCT FROM p_entry -> 'journal' ->> 'args_sha256' THEN
    RAISE EXCEPTION 'write % is seq %, another write''s (F10)', p_write_id, v_old.seq
      USING ERRCODE = 'LR007', DETAIL = 'another-write'; END IF;
  RAISE EXCEPTION 'write % is in the journal at seq %', p_write_id, v_old.seq USING ERRCODE = 'LR006'; END IF;
IF v_head IS DISTINCT FROM p_base THEN
  RAISE EXCEPTION 'register head is %, not %', v_head, p_base USING ERRCODE = 'LR001'; END IF;
SELECT * INTO v_ver FROM schema_version WHERE id = 1;                         -- 2. the version
IF p_client > v_ver.version OR p_client < v_ver.writers_from THEN
  RAISE EXCEPTION 'register schema % (writers from %); this client is %', v_ver.version,
    v_ver.writers_from, p_client USING ERRCODE = 'LR003'; END IF;
IF NOT (CASE WHEN v_kind = 'cutover' AND v_after_loss AND v_sw.mode = 'primary'   -- 3. the switch
             THEN v_sw.marker_state = 'present'             -- a restore's after-loss cutover
             ELSE v_sw.mode = v_needs AND v_sw.marker_state =
                    CASE v_needs WHEN 'primary' THEN 'present' ELSE 'absent' END
        END) THEN
  RAISE EXCEPTION 'register switch is % with the marker %', v_sw.mode, v_sw.marker_state
    USING ERRCODE = 'LR002'; END IF;

  -- 3a. The kinds table's rules that come before the seq is taken.
  IF v_kind = 'import' THEN               -- no 'write' entry: start the journal again (head -1)
    DELETE FROM register_lines; DELETE FROM log_lines; DELETE FROM lanes;
    DELETE FROM object_holds; DELETE FROM doc_lines; DELETE FROM files;
    IF NOT EXISTS (SELECT 1 FROM journal WHERE base_seq IS NOT NULL) THEN   -- only its root; after a rollback, continue
      DELETE FROM journal_files; DELETE FROM journal_edits; DELETE FROM journal;
      UPDATE register_head SET seq = -1 WHERE id = 1;
      v_head := -1;
    END IF;
  END IF;
  IF p_entry ? 'root_seq' AND (v_kind <> 'import' OR v_head <> -1) THEN
    RAISE EXCEPTION 'root_seq % on a journal that is not empty', p_entry ->> 'root_seq'
      USING ERRCODE = 'LR004'; END IF;
  IF v_kind = 'cutover' AND v_after_loss                 -- N4: an after-loss form names its database
     AND p_entry -> 'switch' ->> 'database_label' IS NULL THEN
    RAISE EXCEPTION 'an after-loss cutover with no database_label (N4)' USING ERRCODE = 'LR004'; END IF;
  IF v_kind = 'rollback' THEN             -- S5: never over a recorded divergence (F1); FOR SHARE, so
    SELECT * INTO v_mir FROM mirror_state WHERE id = 1 FOR SHARE;   -- record_mirror_state's UPDATE
    IF v_mir.diverged_sha IS NOT NULL THEN                          -- waits, or this read waits for it
      RAISE EXCEPTION 'rollback refused: diverged at %, found % by %; resolve it first with import --single or render --revert (F1, S5)',
        v_mir.diverged_sha, v_mir.found_utc, v_mir.found_by_ws USING ERRCODE = 'LR012'; END IF;
  END IF;
  IF v_kind = 'cutover' AND NOT (v_after_loss AND v_sw.mode = 'primary') THEN
    SELECT * INTO v_imp FROM journal WHERE kind = 'import' ORDER BY seq DESC LIMIT 1;
    IF v_imp.seq IS DISTINCT FROM p_base THEN
      RAISE EXCEPTION 'cutover base %, but the latest import is %', p_base, v_imp.seq
        USING ERRCODE = 'LR004'; END IF;
  ELSIF v_kind = 'cutover' THEN           -- the restore form: what it replaces, for its abort
    IF NOT (p_entry -> 'switch' ->> 'database_label' IS DISTINCT FROM v_sw.database_label) THEN
      RAISE EXCEPTION 'after-loss cutover: database % is the switch''s own label, not a replacement''s (N4)',
        v_sw.database_label USING ERRCODE = 'LR004'; END IF;     -- N4: the live database, by mistake
    v_prior := jsonb_build_object('switch', to_jsonb(v_sw),
      'file', (SELECT to_jsonb(f) FROM files f WHERE f.path = 'lanes/STORE'),
      'lines', (SELECT jsonb_agg(to_jsonb(d) ORDER BY d.line_no) FROM doc_lines d
                WHERE d.path = 'lanes/STORE'));
  END IF;

  -- 3b. The act's expectations (S1's step 3.2; D5, F5), under the head's lock and
  -- before the seq is taken: refused when an entry after the act's base, made outside this act,
  -- touched a listed scope. Each entry's scopes are its steps 5a and 8a's, stored at its commit.
  IF cardinality(v_expect) > 0 THEN             -- no expectations: no check
    IF lower(v_act ->> 'generation')::uuid IS DISTINCT FROM v_sw.generation THEN
      RAISE EXCEPTION 'act % has its base in register generation %, not %', v_act ->> 'id',
        v_act ->> 'generation', v_sw.generation USING ERRCODE = 'LR007', DETAIL = 'act-generation'; END IF;
    IF (v_act ->> 'base')::bigint > v_head THEN
      RAISE EXCEPTION 'act % has its base at %, past the head %', v_act ->> 'id',
        v_act ->> 'base', v_head USING ERRCODE = 'LR004'; END IF;
    SELECT s.scope, s.seq, j.lane, j.verb INTO v_hit    -- one indexed query, on (scope, seq)
      FROM journal_scopes s JOIN journal j ON j.seq = s.seq
      WHERE s.scope = ANY (v_expect || '*'::text) AND s.seq > (v_act ->> 'base')::bigint
        AND j.act_id IS DISTINCT FROM v_act ->> 'id'      -- the act's own entries never refuse it
      ORDER BY s.seq, s.scope LIMIT 1;
    IF FOUND THEN
      RAISE EXCEPTION 'expectation: % changed at seq % by %/%',
        CASE v_hit.scope WHEN '*' THEN v_expect[1] ELSE v_hit.scope END, v_hit.seq, v_hit.lane,
        v_hit.verb USING ERRCODE = 'LR009'; END IF;
  END IF;

UPDATE register_head SET seq = CASE WHEN v_head = -1                          -- 4. advance; the empty journal's
    THEN coalesce((p_entry ->> 'root_seq')::bigint, 0) ELSE seq + 1 END       -- one entry is the root, at 0 or `m`
  WHERE id = 1 RETURNING seq INTO v_seq;
INSERT INTO journal (seq, base_seq, write_id, kind, verb, lane, workstation, author, message,
                     git_commit, git_tree, repos_blob, args_sha256, act_id)    -- 5. the entry
SELECT v_seq, nullif(v_head, -1), p_write_id, e.*, p_entry -> 'act' ->> 'id'  -- D5's act, or NULL
  FROM jsonb_to_record(p_entry -> 'journal')
  AS e(kind text, verb text, lane text, workstation text, author text, message text,
       git_commit text, git_tree text, repos_blob text, args_sha256 text);

  -- 5a. The touched keys' old side (D5, F5): what each line this entry replaces or deletes
  -- (found by path and old_sha256), and every line of a path it removes or renames, said
  -- before step 6 changes it; and objects: for every lane holding an object whose hold sits
  -- on such a line, since step 6 deletes that hold and step 7 re-marks the object's stored
  -- rows, so the flip is reported (case 6a; lane 3's ruling, #165 6771318480).
  IF v_kind IN ('write', 'stray-import') THEN
    INSERT INTO journal_scopes (seq, scope)
    SELECT DISTINCT v_seq, scope_checked(d.path, d.line_no, k.scope)   -- N2: LR010, not 23514
    FROM jsonb_to_recordset(coalesce(p_entry -> 'edits', '[]')) AS x(op text, path text,
         old_sha256 text)
    JOIN doc_lines d ON d.path = x.path AND (x.op IN ('remove', 'rename')
         OR (x.op IN ('replace', 'delete')
             AND encode(sha256(convert_to(d.text, 'UTF8')), 'hex') = x.old_sha256))
    CROSS JOIN LATERAL (SELECT doc_line_scopes(d.line_id, d.path)
      UNION SELECT 'objects:' || lower(o.lane_key)   -- N1: lower(), as entry_new_keys
      FROM object_holds h JOIN object_holds o ON o.object = h.object
      WHERE h.file = d.path AND h.ordinal = d.line_no AND h.object NOT LIKE 'lane:%') AS k(scope);
  END IF;

  -- 6. The edits: journal_edits as sent, then applied in ord order. The structured rows an edit
  -- leaves stale go with it (ERR-48; lane 3's ruling (c), #165 6755386771): as a replace or a
  -- delete changes a line, its lanes row by row_line_id, its log_lines and register_lines rows
  -- by line_id, and its object_holds by (file, ordinal); a remove, those of every line of its
  -- path; a rename, the old path's object_holds, while its log_lines move to the new file's
  -- lane. Step 7 then inserts what the entry sends: an entry carries no deletes. The objects
  -- whose holds go are kept in v_gone, and step 7 re-marks them (case 6a, #165 6771318480).
  INSERT INTO journal_edits (seq, ord, op, path, line_no, old_sha256, new_text, to_path)
  SELECT v_seq, x.ord, x.op, x.path, x.line_no, x.old_sha256, x.new_text, x.to_path
  FROM jsonb_to_recordset(coalesce(p_entry -> 'edits', '[]')) AS x(ord integer, op text,
       path text, line_no integer, old_sha256 text, new_text text, to_path text);
  IF v_kind IN ('cutover', 'rollback')                     -- D24, F2: an operator entry has edits
     AND NOT EXISTS (SELECT 1 FROM journal_edits WHERE seq = v_seq) THEN
    RAISE EXCEPTION 'a % entry with no edit', v_kind USING ERRCODE = 'LR004'; END IF;
  FOR ed IN SELECT * FROM journal_edits WHERE seq = v_seq ORDER BY ord LOOP
    IF (ed.path = 'lanes/STORE') <> (v_kind IN ('cutover', 'rollback')) THEN  -- and edits
      RAISE EXCEPTION 'edit %: a % edits lanes/STORE alone, or never', ed.ord, v_kind  -- STORE alone
        USING ERRCODE = 'LR004'; END IF;
    IF (v_kind = 'import' AND ed.op NOT IN ('create', 'append')) OR v_kind = 'stray-revert' THEN
      RAISE EXCEPTION 'edit %: a % may not %', ed.ord, v_kind, ed.op USING ERRCODE = 'LR004';
    END IF;
    IF (ed.op = 'create') = EXISTS (SELECT 1 FROM files WHERE path = ed.path) THEN
      RAISE EXCEPTION 'edit %: % % %', ed.ord, ed.op, ed.path,
        CASE WHEN ed.op = 'create' THEN 'exists' ELSE 'does not exist' END
        USING ERRCODE = 'LR004'; END IF;
    CASE ed.op
    WHEN 'create' THEN
      INSERT INTO files (path, final_newline, sha256, last_seq)     -- step 8 sets the last two
      VALUES (ed.path, true, encode(sha256(''::bytea), 'hex'), v_seq);
    WHEN 'append' THEN
      SELECT coalesce(max(line_no), 0) + 1 INTO v_n FROM doc_lines WHERE path = ed.path;
      IF ed.line_no IS DISTINCT FROM NULL AND ed.line_no <> v_n THEN
        RAISE EXCEPTION 'edit %: append at %, but % has % lines', ed.ord, ed.line_no, ed.path,
          v_n - 1 USING ERRCODE = 'LR004'; END IF;
      INSERT INTO doc_lines (path, line_no, text, written_seq, written_mode, written_ws)
      VALUES (ed.path, v_n, ed.new_text, v_seq, v_wmode, v_ws);
    WHEN 'replace', 'delete' THEN
      SELECT * INTO v_line FROM doc_lines WHERE path = ed.path AND line_no = ed.line_no;
      IF NOT FOUND OR encode(sha256(convert_to(v_line.text, 'UTF8')), 'hex') <> ed.old_sha256 THEN
        RAISE EXCEPTION 'edit %: % line % is not %', ed.ord, ed.path, ed.line_no, ed.old_sha256
          USING ERRCODE = 'LR004'; END IF;
      -- The line's structured rows go before it changes, and step 7 inserts what the entry
      -- sends. Its holds go too, so a delete's shift below leaves none of them on the line
      -- that moves into its place.
      DELETE FROM lanes WHERE row_line_id = v_line.line_id;
      DELETE FROM log_lines WHERE line_id = v_line.line_id;
      DELETE FROM register_lines WHERE line_id = v_line.line_id;
      WITH g AS (DELETE FROM object_holds WHERE file = ed.path AND ordinal = ed.line_no
                 RETURNING object)
      SELECT v_gone || ARRAY(SELECT object FROM g) INTO v_gone;
      IF ed.op = 'replace' THEN
        UPDATE doc_lines SET text = ed.new_text, written_seq = v_seq, written_mode = v_wmode,
                             written_ws = v_ws
        WHERE line_id = v_line.line_id;
      ELSE                                      -- doc_lines_pos checks at the statement's end
        DELETE FROM doc_lines WHERE line_id = v_line.line_id;
        UPDATE doc_lines SET line_no = line_no - 1 WHERE path = ed.path AND line_no > ed.line_no;
        UPDATE log_lines SET ordinal = ordinal - 1 WHERE file = ed.path AND ordinal > ed.line_no;
        UPDATE object_holds SET ordinal = ordinal - 1 WHERE file = ed.path AND ordinal > ed.line_no;
      END IF;
    WHEN 'rename' THEN
      IF EXISTS (SELECT 1 FROM files WHERE path = ed.to_path) THEN
        RAISE EXCEPTION 'edit %: % exists', ed.ord, ed.to_path USING ERRCODE = 'LR004'; END IF;
      UPDATE files SET path = ed.to_path WHERE path = ed.path;   -- cascades to doc_lines
      WITH g AS (DELETE FROM object_holds WHERE file = ed.path   -- the entry sends the new path's
                 RETURNING object)
      SELECT v_gone || ARRAY(SELECT object FROM g) INTO v_gone;
      -- The log's lines move to the new file's lane, by file_lane (code/lanes-index:530-532),
      -- and a lane-kind object names that lane, as parse_log's does (:618-645).
      UPDATE log_lines SET file = ed.to_path,
        lane = regexp_replace(regexp_replace(ed.to_path, '^.*/', ''), '\.[Mm][Dd]$', '')
      WHERE file = ed.path;
      UPDATE log_lines SET object = 'lane:' || lane
      WHERE file = ed.to_path AND object LIKE 'lane:%';
    WHEN 'remove' THEN                          -- every line's structured rows, then the lines
      DELETE FROM lanes WHERE row_line_id IN (SELECT line_id FROM doc_lines WHERE path = ed.path);
      DELETE FROM log_lines WHERE line_id IN (SELECT line_id FROM doc_lines WHERE path = ed.path);
      DELETE FROM register_lines WHERE line_id IN (SELECT line_id FROM doc_lines
                                                   WHERE path = ed.path);
      WITH g AS (DELETE FROM object_holds WHERE file = ed.path RETURNING object)
      SELECT v_gone || ARRAY(SELECT object FROM g) INTO v_gone;
      DELETE FROM doc_lines WHERE path = ed.path;
      DELETE FROM files WHERE path = ed.path;
    END CASE;
  END LOOP;

  -- 7. The structured rows, upserted by key, each given its line's line_id.
  FOR r IN
    SELECT x.t, x.path, x.line_no, x.raw, d.line_id, d.text FROM (
      SELECT 'lanes' AS t, path, line_no, raw FROM jsonb_to_recordset(coalesce(p_entry -> 'lanes',
        '[]')) AS y(path text, line_no integer, raw text)
      UNION ALL SELECT 'log_lines', path, line_no, raw FROM jsonb_to_recordset(coalesce(
        p_entry -> 'log_lines', '[]')) AS y(path text, line_no integer, raw text)
      UNION ALL SELECT 'register_lines', path, line_no, raw FROM jsonb_to_recordset(coalesce(
        p_entry -> 'register_lines', '[]')) AS y(path text, line_no integer, raw text)) x
    LEFT JOIN doc_lines d ON d.path = x.path AND d.line_no = x.line_no
  LOOP
    IF r.line_id IS NULL OR r.text IS DISTINCT FROM r.raw THEN
      RAISE EXCEPTION '% row at % line %: no such line, or raw is not its text', r.t, r.path,
        r.line_no
        USING ERRCODE = 'LR004'; END IF;
  END LOOP;
  INSERT INTO lanes AS o (lane_key, lane, row_line_id, aliases, home, workstation, started_utc,
                          handoff_path, state_phrase, objects_cell, session_ids, last_session,
                          archived, owner, last_seq, last_mode)
  SELECT x.lane_key, x.lane, d.line_id, x.aliases, x.home, x.workstation, x.started_utc,
         x.handoff_path, x.state_phrase, x.objects_cell, x.session_ids, x.last_session,
         x.archived, x.owner, v_seq, v_wmode
  FROM jsonb_to_recordset(coalesce(p_entry -> 'lanes', '[]')) AS x(path text, line_no integer,
       lane_key text, lane text, aliases jsonb, home text, workstation text, started_utc text,
       handoff_path text, state_phrase text, objects_cell text, session_ids jsonb,
       last_session text, archived boolean, owner text)
  JOIN doc_lines d ON d.path = x.path AND d.line_no = x.line_no
  ON CONFLICT (lane_key) DO UPDATE SET lane = EXCLUDED.lane, row_line_id = EXCLUDED.row_line_id,
    aliases = EXCLUDED.aliases, home = EXCLUDED.home, workstation = EXCLUDED.workstation,
    started_utc = EXCLUDED.started_utc, handoff_path = EXCLUDED.handoff_path,
    state_phrase = EXCLUDED.state_phrase, objects_cell = EXCLUDED.objects_cell,
    session_ids = EXCLUDED.session_ids, last_session = EXCLUDED.last_session,
    archived = EXCLUDED.archived, owner = EXCLUDED.owner, last_seq = EXCLUDED.last_seq,
    last_mode = EXCLUDED.last_mode;
  INSERT INTO log_lines (line_id, file, ordinal, lane, verb, session, workstation, utc, utc_ts,
                         object, ref, payload, payload_fields, free_text, written_lane,
                         unreadable, unreadable_why, raw, seq, mode)
  SELECT d.line_id, x.path, x.line_no, x.lane, x.verb, x.session, x.workstation, x.utc,
         x.utc_ts, x.object, x.ref, x.payload, x.payload_fields, x.free_text, x.written_lane,
         x.unreadable, x.unreadable_why, x.raw, v_seq, v_wmode
  FROM jsonb_to_recordset(coalesce(p_entry -> 'log_lines', '[]')) AS x(path text,
       line_no integer, raw text, lane text, verb text, session text, workstation text,
       utc text, utc_ts timestamptz, object text, ref text, payload text, payload_fields jsonb,
       free_text text, written_lane text, unreadable boolean, unreadable_why text)
  JOIN doc_lines d ON d.path = x.path AND d.line_no = x.line_no
  ON CONFLICT (line_id) DO UPDATE SET file = EXCLUDED.file, ordinal = EXCLUDED.ordinal,
    lane = EXCLUDED.lane, verb = EXCLUDED.verb, session = EXCLUDED.session,
    workstation = EXCLUDED.workstation, utc = EXCLUDED.utc, utc_ts = EXCLUDED.utc_ts,
    object = EXCLUDED.object, ref = EXCLUDED.ref, payload = EXCLUDED.payload,
    payload_fields = EXCLUDED.payload_fields, free_text = EXCLUDED.free_text,
    written_lane = EXCLUDED.written_lane, unreadable = EXCLUDED.unreadable,
    unreadable_why = EXCLUDED.unreadable_why, raw = EXCLUDED.raw, seq = EXCLUDED.seq,
    mode = EXCLUDED.mode;
  INSERT INTO register_lines (line_id, kind, slot_role, slot_kind, lane, repo, repo_key, pr, tip,
                              utc, utc_ts, session, for_lane, raw, seq, mode, workstation,
                              repo_spellings)
  SELECT d.line_id, x.kind, x.slot_role, x.slot_kind, x.lane, x.repo, x.repo_key, x.pr, x.tip,
         x.utc, x.utc_ts, x.session, x.for_lane, x.raw, v_seq, v_wmode, x.workstation,
         x.repo_spellings
  FROM jsonb_to_recordset(coalesce(p_entry -> 'register_lines', '[]')) AS x(path text,
       line_no integer, raw text, kind text, slot_role text, slot_kind text, lane text,
       repo text, repo_key text, pr integer, tip text, utc text, utc_ts timestamptz,
       session text, for_lane text, workstation text, repo_spellings text[])
  JOIN doc_lines d ON d.path = x.path AND d.line_no = x.line_no
  ON CONFLICT (line_id) DO UPDATE SET kind = EXCLUDED.kind, slot_role = EXCLUDED.slot_role,
    slot_kind = EXCLUDED.slot_kind, lane = EXCLUDED.lane, repo = EXCLUDED.repo,
    repo_key = EXCLUDED.repo_key, pr = EXCLUDED.pr, tip = EXCLUDED.tip, utc = EXCLUDED.utc,
    utc_ts = EXCLUDED.utc_ts, session = EXCLUDED.session, for_lane = EXCLUDED.for_lane,
    raw = EXCLUDED.raw, seq = EXCLUDED.seq, mode = EXCLUDED.mode,
    workstation = EXCLUDED.workstation, repo_spellings = EXCLUDED.repo_spellings;
  -- superseded_by, #160's rule (code/lanes-index:1013-1036): a lane's state on an object is
  -- its own last line on it, and another lane whose own last line on it is a TAKEOVER
  -- supersedes it. The stored rows of each touched object are re-marked first, against the
  -- incoming rows, so no transient pair of live claims trips one_live_claim. An object whose
  -- hold step 6 deleted is touched though the entry sends no hold on it (case 6a; lane 3's
  -- ruling, #165 6771318480). A re-mark stamps no seq or mode, so D19 never takes such a row
  -- for this entry's own claim, and an exempt row keeps its files mode.
  BEGIN                                         -- a 23505 on one_live_claim is LR005
  UPDATE object_holds h SET superseded_by = (
    SELECT min(e.lane_key) FROM (
      SELECT i.object, i.lane_key, i.verb
      FROM jsonb_to_recordset(v_holds) AS i(object text, lane_key text, verb text)
      UNION ALL
      SELECT s.object, s.lane_key, s.verb FROM object_holds s
      WHERE NOT v_holds @> jsonb_build_array(jsonb_build_object('object', s.object,
                                                                'lane_key', s.lane_key))) e
    WHERE e.object = h.object AND e.lane_key <> h.lane_key AND e.verb = 'TAKEOVER')
  WHERE v_holds @> jsonb_build_array(jsonb_build_object('object', h.object))
     OR h.object = ANY (v_gone);
  INSERT INTO object_holds (object, lane_key, lane, verb, utc_ts, file, ordinal, superseded_by,
                            spellings, exempt, seq, mode)
  SELECT x.object, x.lane_key, x.lane, x.verb, x.utc_ts, x.file, x.ordinal,
         (SELECT min(e.lane_key) FROM (
            SELECT i.object, i.lane_key, i.verb
            FROM jsonb_to_recordset(v_holds) AS i(object text, lane_key text, verb text)
            UNION ALL
            SELECT s.object, s.lane_key, s.verb FROM object_holds s
            WHERE NOT v_holds @> jsonb_build_array(jsonb_build_object('object', s.object,
                                                                      'lane_key', s.lane_key))) e
          WHERE e.object = x.object AND e.lane_key <> x.lane_key AND e.verb = 'TAKEOVER'),
         x.spellings, v_kind = 'import' AND coalesce(x.exempt, false), v_seq, v_wmode
  FROM jsonb_to_recordset(v_holds) AS x(object text, lane_key text, lane text, verb text,
       utc_ts timestamptz, file text, ordinal integer, spellings text[], exempt boolean)
  ON CONFLICT (object, lane_key) DO UPDATE SET lane = EXCLUDED.lane, verb = EXCLUDED.verb,
    utc_ts = EXCLUDED.utc_ts, file = EXCLUDED.file, ordinal = EXCLUDED.ordinal,
    superseded_by = EXCLUDED.superseded_by, spellings = EXCLUDED.spellings,
    exempt = EXCLUDED.exempt, seq = EXCLUDED.seq, mode = EXCLUDED.mode;
  EXCEPTION WHEN unique_violation THEN
    GET STACKED DIAGNOSTICS v_con = CONSTRAINT_NAME, v_det = PG_EXCEPTION_DETAIL;
    IF v_con = 'one_live_claim' THEN
      RAISE EXCEPTION 'the object is held (one_live_claim): %', v_det
        USING ERRCODE = 'LR005', DETAIL = 'one-live-claim';
    END IF;
    RAISE;
  END;
  IF v_wmode = 'primary' THEN                   -- the register's own rules bind new writes
    SELECT * INTO v_take FROM register_lines n    -- U3: Rule 6's 30 minutes are measured from a
      WHERE n.seq = v_seq AND n.slot_role = 'take' AND n.utc_ts IS NULL LIMIT 1;   -- take's UTC
    IF FOUND THEN
      RAISE EXCEPTION 'a % take with no readable UTC (U3): %', v_take.kind, left(v_take.raw, 160)
        USING ERRCODE = 'LR005', DETAIL = 'take-no-utc'; END IF;
    IF EXISTS (SELECT 1 FROM object_holds n JOIN object_holds o ON o.lane_key <> n.lane_key
               WHERE n.seq = v_seq AND n.verb IN ('CLAIMED', 'TAKEOVER')
                 AND n.superseded_by IS NULL AND NOT n.exempt
                 AND o.verb IN ('CLAIMED', 'TAKEOVER') AND o.superseded_by IS NULL
                 AND n.spellings && o.spellings) THEN
      RAISE EXCEPTION 'a claim''s spellings overlap another lane''s live claim (D19)'
        USING ERRCODE = 'LR005', DETAIL = 'claim-spellings'; END IF;
    IF EXISTS (SELECT 1 FROM register_lines n JOIN main_slots m      -- one repository, however
                 ON m.repo_key = n.repo_key OR m.repo_spellings && n.repo_spellings   -- spelled
               WHERE n.seq = v_seq AND n.slot_role = 'take' AND m.line_id < n.line_id
                 AND lower(m.lane) <> lower(n.lane)) THEN
      RAISE EXCEPTION 'another lane holds main for this repository first (D18)'
        USING ERRCODE = 'LR005', DETAIL = 'main-held'; END IF;
    FOR r IN SELECT * FROM register_lines n               -- F13: a LANDING EXPIRED closes the
             WHERE n.seq = v_seq AND n.kind = 'LANDING EXPIRED' LOOP   -- holder's stale LANDING
      SELECT * INTO v_take FROM register_lines t   -- C1: the holder's newest take that it closes,
        WHERE t.slot_role = 'take' AND t.slot_kind = 'landing'          -- matched as main_slots
          AND (t.repo_key = r.repo_key OR t.repo_spellings && r.repo_spellings)    -- matches
          AND t.pr = r.pr AND lower(t.lane) = lower(r.for_lane) AND t.line_id < r.line_id
        ORDER BY t.line_id DESC LIMIT 1;
      IF NOT FOUND OR v_take.repo_key IS DISTINCT FROM r.repo_key THEN   -- point 5: repo_key alone
        RAISE EXCEPTION 'no open LANDING by % for PR #% under repo_key % (F13): there is none, or its newest is keyed %',
          r.for_lane, r.pr, r.repo_key, coalesce(v_take.repo_key, '-')
          USING ERRCODE = 'LR005', DETAIL = 'expired-none'; END IF;
      SELECT c.kind, c.lane INTO v_close FROM register_lines c    -- C2: a close, matched as
        WHERE c.slot_role = 'close' AND c.slot_kind = 'landing'     -- main_slots matches one
          AND (c.repo_key = v_take.repo_key OR c.repo_spellings && v_take.repo_spellings)
          AND c.pr = v_take.pr AND c.line_id > v_take.line_id AND c.line_id <> r.line_id
          AND lower(coalesce(c.for_lane, c.lane)) = lower(v_take.lane)
        ORDER BY c.line_id LIMIT 1;
      IF FOUND THEN
        RAISE EXCEPTION '%''s LANDING for PR #% under repo_key % is already closed, by a % of % (F13)',
          v_take.lane, v_take.pr, v_take.repo_key, v_close.kind, v_close.lane
          USING ERRCODE = 'LR005', DETAIL = 'expired-closed'; END IF;
      IF NOT coalesce(clock_timestamp() - v_take.utc_ts > interval '30 minutes', false) THEN
        RAISE EXCEPTION '%''s newest LANDING for PR #% under repo_key % is too young (F13): its age by the database''s clock is %, not more than Rule 6''s 30 minutes',
          v_take.lane, v_take.pr, v_take.repo_key,
          coalesce(date_trunc('second', clock_timestamp() - v_take.utc_ts)::text, 'unknown, since its UTC cannot be read')
          USING ERRCODE = 'LR005', DETAIL = 'expired-young'; END IF;
    END LOOP;
  END IF;

  -- 8. The proof: every touched path is in the entry's files, and renders to its digest.
  IF EXISTS (SELECT 1 FROM journal_edits j, LATERAL (VALUES (j.path), (j.to_path)) t(p)
             WHERE j.seq = v_seq AND t.p IS NOT NULL
               AND NOT coalesce(p_entry -> 'files', '[]') @> jsonb_build_array(
                         jsonb_build_object('path', t.p))) THEN
    RAISE EXCEPTION 'an edited path has no files row in the entry' USING ERRCODE = 'LR004';
  END IF;
  FOR r IN SELECT * FROM jsonb_to_recordset(coalesce(p_entry -> 'files', '[]'))
             AS x(path text, present boolean, sha256 text, final_newline boolean) LOOP
    INSERT INTO journal_files (seq, path, present, sha256, final_newline)
    VALUES (v_seq, r.path, r.present, r.sha256, r.final_newline);
    IF r.present THEN
      UPDATE files SET final_newline = coalesce(r.final_newline, final_newline)
      WHERE path = r.path;
      v_sha := encode(sha256(render_file(r.path)), 'hex');
      IF v_sha IS DISTINCT FROM r.sha256 THEN
        RAISE EXCEPTION 'proof: % renders %, the entry says %', r.path, v_sha, r.sha256
          USING ERRCODE = 'LR004'; END IF;
      UPDATE files SET sha256 = r.sha256, last_seq = v_seq WHERE path = r.path;
    ELSIF EXISTS (SELECT 1 FROM files WHERE path = r.path) THEN
      RAISE EXCEPTION 'proof: % is present', r.path USING ERRCODE = 'LR004';
    END IF;
  END LOOP;

  -- 8a. The touched keys' new side (D5, F5), from what the entry wrote, never from a list it
  -- sends: each line it appended or replaced, each line a rename moved, read at its new path,
  -- and objects: for every lane holding an object it wrote a hold for, since a TAKEOVER
  -- supersedes the others and the taker's next line may restore them (entry_new_keys). An
  -- import, a cutover and a rollback move what every read rests on: their one key is '*', which
  -- every scope meets. N2: each key is checked before it is stored, in path and line order, and
  -- an import checks every key its lines and holds derive, though it stores only '*'.
  IF v_kind IN ('import', 'cutover', 'rollback') THEN
    INSERT INTO journal_scopes (seq, scope) VALUES (v_seq, '*');
  END IF;
  IF v_kind = 'import' THEN
    PERFORM count(scope_checked(k.path, k.line_no, k.scope))
      FROM (SELECT * FROM entry_new_keys(v_seq) ORDER BY 1, 2, 3) AS k;
  ELSIF v_kind NOT IN ('cutover', 'rollback') THEN
    INSERT INTO journal_scopes (seq, scope)
    SELECT v_seq, scope_checked(k.path, k.line_no, k.scope)
      FROM (SELECT * FROM entry_new_keys(v_seq) ORDER BY 1, 2, 3) AS k
    ON CONFLICT DO NOTHING;
  END IF;

  -- The kinds table's rules that come after: D24's two operator entries move the switch.
  IF v_kind = 'cutover' THEN                    -- set_seq: its own seq, 1, m+1 after a re-import, or b+1 after a restore
    UPDATE register_switch SET mode = 'primary', marker_state = 'adding', marker_seq = v_seq,
      import_seq = coalesce(v_imp.seq, import_seq),             -- a restore's has no import entry
      import_commit = coalesce(v_imp.git_commit, import_commit),
      import_tree = coalesce(v_imp.git_tree, import_tree), set_seq = v_seq,
      database_label = CASE WHEN v_after_loss THEN p_entry -> 'switch' ->> 'database_label'
                            ELSE database_label END,
      generation = CASE WHEN v_after_loss THEN gen_random_uuid() ELSE generation END,
      set_utc = date_trunc('second', clock_timestamp()),
      set_by_lane = p_entry -> 'journal' ->> 'lane', set_by_ws = v_ws,
      restore_prior = v_prior                   -- NULL but in the restore form
    WHERE id = 1;
  ELSIF v_kind = 'rollback' THEN                -- set_seq: its own entry, the last seq, k+1
    UPDATE register_switch SET mode = 'files', marker_state = 'removing', marker_seq = v_seq,
      set_seq = v_seq, set_utc = date_trunc('second', clock_timestamp()),
      set_by_lane = p_entry -> 'journal' ->> 'lane', set_by_ws = v_ws
    WHERE id = 1;
  ELSIF v_kind IN ('stray-import', 'stray-revert') THEN
    UPDATE mirror_state SET diverged_sha = NULL, found_utc = NULL, found_by_ws = NULL
    WHERE id = 1;
  END IF;
  IF NOT (clock_timestamp() < v_not_after) THEN  -- 9. the bound (F3): past it, nothing commits
    RAISE EXCEPTION 'write % reached its end at %, past its not_after %', p_write_id,
      clock_timestamp(), v_not_after USING ERRCODE = 'LR008'; END IF;
  RETURN v_seq;                                 -- the deferred foreign keys check at COMMIT
END $f$;

CREATE FUNCTION switch_to_files(p_client integer, p_cutover_seq bigint, p_lane text, p_ws text)
  RETURNS bigint LANGUAGE plpgsql SECURITY DEFINER
  SET search_path = lanes_register, pg_catalog, pg_temp AS $f$
-- The cutover's abort (F2): run only after a read-back proves the entry's commit absent from
-- origin. In the restore form it puts back what restore_prior holds and sets nothing to files.
DECLARE
  v_head bigint;
  v_ver  schema_version;
  v_sw   register_switch;
BEGIN
  SELECT seq INTO v_head FROM register_head WHERE id = 1 FOR UPDATE;         -- the same lock
  SELECT * INTO v_ver FROM schema_version WHERE id = 1;
  IF p_client > v_ver.version OR p_client < v_ver.writers_from THEN
    RAISE EXCEPTION 'register schema % (writers from %); this client is %', v_ver.version,
      v_ver.writers_from, p_client USING ERRCODE = 'LR003'; END IF;
  SELECT * INTO v_sw FROM register_switch WHERE id = 1;       -- an unconfirmed cutover only
  IF v_sw.mode <> 'primary' OR v_sw.marker_state <> 'adding'
     OR v_sw.marker_seq IS DISTINCT FROM p_cutover_seq OR v_head <> p_cutover_seq THEN
    RAISE EXCEPTION 'no unconfirmed cutover at seq %', p_cutover_seq USING ERRCODE = 'LR002'; END IF;
  DELETE FROM doc_lines     WHERE path = 'lanes/STORE';       -- its rows, children first
  DELETE FROM files         WHERE path = 'lanes/STORE';
  IF v_sw.restore_prior IS NOT NULL THEN                      -- the restore form: lanes/STORE
    INSERT INTO files                                         -- as it was at b, line ids too
      SELECT * FROM jsonb_populate_record(NULL::files, v_sw.restore_prior -> 'file');
    INSERT INTO doc_lines OVERRIDING SYSTEM VALUE
      SELECT * FROM jsonb_populate_recordset(NULL::doc_lines, v_sw.restore_prior -> 'lines');
  END IF;
  DELETE FROM journal_files WHERE seq = p_cutover_seq;
  DELETE FROM journal_edits WHERE seq = p_cutover_seq;
  DELETE FROM journal       WHERE seq = p_cutover_seq;
  UPDATE register_head SET seq = p_cutover_seq - 1 WHERE id = 1;   -- a new row version: every
                                                                    -- older writer snapshot gets 40001
  IF v_sw.restore_prior IS NOT NULL THEN                      -- and the switch row as it was:
    DELETE FROM register_switch WHERE id = 1;                 -- primary, present, its label and
    INSERT INTO register_switch                               -- generation; no seq after b
      SELECT * FROM jsonb_populate_record(NULL::register_switch, v_sw.restore_prior -> 'switch');
    RETURN p_cutover_seq - 1;
  END IF;
  UPDATE register_switch SET mode = 'files', marker_state = 'absent', marker_seq = NULL,
    set_seq = p_cutover_seq - 1,
    set_utc = date_trunc('second', clock_timestamp()), set_by_lane = p_lane, set_by_ws = p_ws
  WHERE id = 1;
  RETURN p_cutover_seq - 1;
END $f$;

CREATE FUNCTION record_marker(p_client integer, p_seq bigint, p_commit text, p_ws text)
  RETURNS text LANGUAGE plpgsql SECURITY DEFINER
  SET search_path = lanes_register, pg_catalog, pg_temp AS $f$
-- S4's read-back of an operator entry's push, recorded (F12).
DECLARE
  v_ver schema_version;
  v_sw  register_switch;
  v_new text;
BEGIN
  PERFORM 1 FROM register_head WHERE id = 1 FOR UPDATE;      -- serialises with the abort
  SELECT * INTO v_ver FROM schema_version WHERE id = 1;
  IF p_client > v_ver.version OR p_client < v_ver.writers_from THEN
    RAISE EXCEPTION 'register schema % (writers from %); this client is %', v_ver.version,
      v_ver.writers_from, p_client USING ERRCODE = 'LR003'; END IF;
  SELECT * INTO v_sw FROM register_switch WHERE id = 1;
  IF v_sw.marker_state NOT IN ('adding', 'removing') OR v_sw.marker_seq IS DISTINCT FROM p_seq THEN
    RAISE EXCEPTION 'no unconfirmed operator entry at seq %', p_seq USING ERRCODE = 'LR002'; END IF;
  v_new := CASE v_sw.marker_state WHEN 'adding' THEN 'present' ELSE 'absent' END;
  UPDATE register_switch SET marker_state = v_new, marker_commit = p_commit,
    set_utc = date_trunc('second', clock_timestamp()), set_by_ws = p_ws,
    restore_prior = NULL                       -- confirmed: nothing left to put back
  WHERE id = 1;
  RETURN v_new;
END $f$;

CREATE FUNCTION find_write(p_write_id uuid, p_not_after timestamptz, p_generation uuid,
                           p_lane text, p_verb text, p_args_sha256 text)
  RETURNS bigint LANGUAGE plpgsql SECURITY DEFINER
  SET search_path = lanes_register, pg_catalog, pg_temp AS $f$
-- F3's one lookup (S2; D8, S1), at READ COMMITTED in a transaction the caller rolls back.
-- p_not_after is the largest not_after the write's commit calls carried, and p_generation,
-- p_lane, p_verb and p_args_sha256 are what those calls sent (NIT 1). It waits, holding no
-- lock, until the server's clock has passed p_not_after, at most 3 s (the call's statement_timeout
-- less its lock_timeout and 1 s); then it takes the head row's lock under the caller's
-- lock_timeout (55P03 while a transaction of the write may still be open), checks the clock again
-- under it, the exact complement of commit_write's step 9, then checks as commit_write does, in
-- its order (S-3): another generation is LR007, and so is an entry of this id for another lane,
-- verb or arguments. It returns the write's seq, or NULL if it is absent. The writer has no
-- UPDATE, so it cannot take that lock itself.
DECLARE
  v_wait interval := p_not_after - clock_timestamp();
  v_gen  uuid;                                  -- the switch's generation, under the lock
  v_old  journal;                               -- the entry of this id, if any
BEGIN
  IF p_not_after IS NULL THEN
    RAISE EXCEPTION 'lookup of write %: no not_after', p_write_id USING ERRCODE = 'LR011'; END IF;
  IF v_wait > interval '3 seconds' THEN                 -- LR011: further ahead than the wait's bound
    RAISE EXCEPTION 'lookup of write %: not_after % is % ahead of the database clock, past the 3 s wait',
      p_write_id, p_not_after, v_wait USING ERRCODE = 'LR011'; END IF;
  IF v_wait > interval '0' THEN                         -- the wait, on the server's clock, before the lock
    PERFORM pg_sleep(extract(epoch FROM v_wait) + 0.001); END IF;
  PERFORM 1 FROM register_head WHERE id = 1 FOR UPDATE;
  IF clock_timestamp() < p_not_after THEN               -- step 9 commits only while this holds
    RAISE EXCEPTION 'lookup of write %: the database clock % has not passed not_after % under the head row''s lock',
      p_write_id, clock_timestamp(), p_not_after USING ERRCODE = 'LR011'; END IF;
  SELECT generation INTO v_gen FROM register_switch WHERE id = 1;
  IF p_generation IS DISTINCT FROM v_gen THEN          -- commit_write's order: the generation first
    RAISE EXCEPTION 'write % belongs to register generation %, not %', p_write_id, p_generation,
      v_gen USING ERRCODE = 'LR007', DETAIL = 'generation'; END IF;
  SELECT * INTO v_old FROM journal WHERE write_id = p_write_id;
  IF NOT FOUND THEN RETURN NULL; END IF;               -- absent
  IF v_old.lane IS DISTINCT FROM p_lane OR v_old.verb IS DISTINCT FROM p_verb
     OR v_old.args_sha256 IS DISTINCT FROM p_args_sha256 THEN   -- then another write's entry
    RAISE EXCEPTION 'write % is seq %, another write''s (F10)', p_write_id, v_old.seq
      USING ERRCODE = 'LR007', DETAIL = 'another-write'; END IF;
  RETURN v_old.seq;                                    -- found: this write's own entry
END $f$;

CREATE FUNCTION record_mirror_state(p_ws text, p_diverged_sha text, p_error text)
  RETURNS void LANGUAGE plpgsql SECURITY DEFINER
  SET search_path = lanes_register, pg_catalog, pg_temp AS $f$
-- S5: its UPDATE takes the row's FOR NO KEY UPDATE lock, which conflicts with a rollback's FOR
-- SHARE, so it waits for that rollback to end, and a rollback that reaches the row after it waits
-- for it. It reads nothing before it writes and takes no other lock, so no explicit lock is needed.
BEGIN
  UPDATE mirror_state SET                      -- each right-hand side reads the old row
    found_utc   = CASE WHEN diverged_sha IS NOT NULL OR p_diverged_sha IS NULL THEN found_utc
                       ELSE date_trunc('second', clock_timestamp()) END,
    found_by_ws = CASE WHEN diverged_sha IS NOT NULL OR p_diverged_sha IS NULL THEN found_by_ws
                       ELSE p_ws END,
    diverged_sha = coalesce(diverged_sha, p_diverged_sha),   -- D16: the first finder's; only a
                                                             -- stray entry clears it
    last_error = p_error,
    last_error_utc = CASE WHEN p_error IS NULL THEN NULL
                          ELSE date_trunc('second', clock_timestamp()) END
  WHERE id = 1;
END $f$;

-- Migration 1's rows, from operations.md §2.4's bootstrap inputs (psql -v repo=… label=… lane=… ws=… script_sha256=…).
INSERT INTO schema_version (version, writers_from, readers_from, applied_utc)
  VALUES (1, 1, 1, date_trunc('second', clock_timestamp()));
INSERT INTO register_head (seq) VALUES (-1);
INSERT INTO mirror_state DEFAULT VALUES;
INSERT INTO register_switch (mode, marker_state, generation, repository, database_label, set_utc,
                             set_seq, set_by_lane, set_by_ws)
  VALUES ('files', 'absent', gen_random_uuid(), :'repo', :'label',
          date_trunc('second', clock_timestamp()), -1, :'lane', :'ws');
INSERT INTO migrations (version, script_sha256, by_lane, by_ws)
  VALUES (1, :'script_sha256', :'lane', :'ws');
COMMIT;                                        -- then 1.4's statements after its CREATE ROLEs
"""

#: Every migration this build ships, by number. Each script is one transaction,
#: sent whole as one `psql` call.
REGISTER_MIGRATIONS = {
    1: _REGISTER_M1_TABLES + "\n" + _REGISTER_M1_FUNCTIONS,
}

#: The `schema_version` row a script leaves: migration 1's INSERT, or a later
#: script's UPDATE.
_REGISTER_VERSION_ROW_RE = re.compile(
    r"INSERT INTO schema_version \(version, writers_from, readers_from, applied_utc\)\s+"
    r"VALUES \((\d+), (\d+), (\d+),"
    r"|UPDATE schema_version SET version = (\d+), writers_from = (\d+), readers_from = (\d+)")


def _register_migrations_consistent() -> None:
    """THE ONE-NUMBER RULE INSIDE THIS FILE, checked before anything is sent.
    The scripts are numbered 1 to `REGISTER_SCHEMA_VERSION` with no gap. The
    floors keep `schema_version`'s CHECK. The newest script leaves the version
    and floors the constants name. A build that breaks this is a defect, so
    the error is not a refusal."""
    if sorted(REGISTER_MIGRATIONS) != list(range(1, REGISTER_SCHEMA_VERSION + 1)):
        raise RuntimeError(f"register migrations {sorted(REGISTER_MIGRATIONS)} are not 1 to "
                           f"REGISTER_SCHEMA_VERSION {REGISTER_SCHEMA_VERSION}")
    if not 1 <= REGISTER_READERS_FROM <= REGISTER_WRITERS_FROM <= REGISTER_SCHEMA_VERSION:
        raise RuntimeError(f"register floors: readers from {REGISTER_READERS_FROM}, writers from "
                           f"{REGISTER_WRITERS_FROM}, version {REGISTER_SCHEMA_VERSION}")
    rows = [tuple(int(n) for n in m.groups() if n is not None)
            for m in _REGISTER_VERSION_ROW_RE.finditer(REGISTER_MIGRATIONS[REGISTER_SCHEMA_VERSION])]
    want = (REGISTER_SCHEMA_VERSION, REGISTER_WRITERS_FROM, REGISTER_READERS_FROM)
    if rows != [want]:
        raise RuntimeError(f"register migration {REGISTER_SCHEMA_VERSION} leaves schema_version "
                           f"{rows}, not {want}")


def register_migration_sha256(version: int) -> str:
    """The `script_sha256` that migration `version`'s `migrations` row records:
    the sha256 of the script's UTF-8 bytes as shipped, with its psql variables
    unexpanded. Every build that ships the same script records the same digest."""
    return hashlib.sha256(REGISTER_MIGRATIONS[version].encode("utf-8")).hexdigest()


def register_migration_plan(current: int | None) -> list[int]:
    """The migrations that take a schema at `current` to
    `REGISTER_SCHEMA_VERSION`, in order. `current` is the `schema_version`
    row's `version`, or None where the schema `lanes_register` does not exist.
    An empty list means `unchanged`. A schema newer than this build is refused
    (operations.md §2.4: 2), and is never migrated down."""
    _register_migrations_consistent()
    if current is None:
        return list(range(1, REGISTER_SCHEMA_VERSION + 1))
    if not isinstance(current, int) or isinstance(current, bool) or current < 1:
        raise ValueError(f"a register schema version is a number of at least 1, not {current!r}")
    if current > REGISTER_SCHEMA_VERSION:
        raise Refusal(f"the register's schema is at version {current}, newer than this "
                      f"{PROG}'s {REGISTER_SCHEMA_VERSION}: upgrade the tools. A schema is "
                      f"migrated forward, never down")
    return list(range(current + 1, REGISTER_SCHEMA_VERSION + 1))


def _register_migration_variables(repository: str, label: str, lane: str,
                                  workstation: str) -> dict[str, str]:
    """The bootstrap's inputs, as the scripts' psql variables. Each is checked
    here against the CHECKs of design.md §1.2 that it meets, so that a bad
    input is refused with 2 before anything is sent, rather than failing as a
    23514 inside the transaction."""
    values = {"repository": ("repo", repository), "label": ("label", label),
              "lane": ("lane", lane), "workstation": ("ws", workstation)}
    for what, (_name, value) in values.items():
        if not isinstance(value, str) or not value.strip():
            raise Refusal(f"bootstrap: the {what} is empty")
        if any(ord(ch) < 0x20 or ord(ch) == 0x7F for ch in value):
            raise Refusal(f"bootstrap: the {what} holds a control character")
    if "@" in label:
        raise Refusal("bootstrap: a database label holds no '@', so it is never a credential "
                      "(design.md §1.2, register_switch.database_label)")
    return {name: value for name, value in values.values()}


def apply_register_migrations(run, current: int | None, *, repository: str, label: str,
                              lane: str, workstation: str) -> list[tuple[int, str]]:
    """MIGRATE THE REGISTER FORWARD TO `REGISTER_SCHEMA_VERSION` (§1.5). This
    is the bootstrap's step and nobody else's: `lanes-index bootstrap` calls
    it, and no subcommand does.

    `current` is as `register_migration_plan` takes it. The other inputs are
    the bootstrap's own (operations.md §2.4): `--repository`, `--label` and
    `--lane`, and the host's workstation name. They fill the switch's `repository`,
    `database_label`, `set_by_lane` and `set_by_ws`, and the `migrations` row's
    `by_lane` and `by_ws`.

    `run(script, variables)` sends one script through Brett's admin
    connection as ONE `psql` call:
      - the script on stdin, with `-X` and `-v ON_ERROR_STOP=1`;
      - one `-v <name>=<value>` per variable;
      - `PGCLIENTENCODING=UTF8`, since `line_scopes`' pattern holds an em dash;
      - no `--single-transaction`, since each script has its own BEGIN and
        COMMIT.
    It raises on any end but 0. The script's transaction has then rolled back,
    so the schema stands at the version before it.

    Returns `(version, script_sha256)` for each migration applied, in order.
    An empty list means `unchanged`. Bad inputs, and a schema newer than this
    build, are refused before anything is sent."""
    plan = register_migration_plan(current)
    variables = _register_migration_variables(repository, label, lane, workstation)
    applied = []
    for version in plan:
        digest = register_migration_sha256(version)
        run(REGISTER_MIGRATIONS[version], dict(variables, script_sha256=digest))
        applied.append((version, digest))
    return applied


def register_version_refusal(version: int, writers_from: int, readers_from: int, *,
                             write: bool) -> str | None:
    """§1.5'S WINDOW, as a client checks it before it reads or writes. A
    writer goes on only where `writers_from` <= `REGISTER_SCHEMA_VERSION` <=
    `version`. A reader goes on only where `readers_from` <=
    `REGISTER_SCHEMA_VERSION` <= `version`.

    Returns None inside the window. Outside it, the returned refusal names
    both numbers and the remedy, in the shape of `commit_write`'s LR003. The
    exit code is the caller's own: 69 for writers, S3's readers and the
    register commands; 2 for the guard; 1 for `managed-projection`."""
    floor, who = (writers_from, "writers") if write else (readers_from, "readers")
    head = f"register schema {version} ({who} from {floor}); this client is {REGISTER_SCHEMA_VERSION}"
    if REGISTER_SCHEMA_VERSION > version:
        return f"{head}: the database is behind: run the bootstrap"
    if REGISTER_SCHEMA_VERSION < floor:
        return f"{head}: upgrade the tools"
    return None


# §1.4'S ROLES AND GRANTS (design.md §1.4). Brett's admin connection sends
# §1.4's block in two parts, with migration 1 between them, as the block's own
# comment line says. `lanes-index bootstrap` calls, in this order:
#   1. `register_roles_query()`, read through that connection, for the names
#      of §1.4's roles that exist already;
#   2. `apply_register_roles(run, found)`: the CREATE ROLE of each role the
#      query did not find, then the admin's GRANT;
#   3. `apply_register_migrations` (above);
#   4. `apply_register_grants(run, database=<name>)`: the rest of the block.
# Every statement goes as the design prints it, comments and all. The GRANT
# and the rest can run again. Nothing here is a subcommand, and nothing here
# sets a floor on a role: each login carries its own (`lanes-index login`).

#: Design.md §1.4's SQL block, verbatim: the register's roles and GRANTs.
#: Above its comment line "-- Migration 1 (...) runs here, and commits. Then:"
#: are the CREATE ROLEs of the owner and the two groups, none of which can log
#: in, and of the indexer's login, then the admin's GRANT of the owner and the
#: indexer to itself, WITH INHERIT TRUE, SET TRUE. Below it are CONNECT and
#: USAGE, SELECT on the tables and, for `pg_dump`, on the sequences, the
#: default privileges, EXECUTE on the five writer functions and on
#: `render_file`, and `lanes_index`'s schema. Its one psql variable is `db`.
_REGISTER_ROLE_BLOCK = r"""CREATE ROLE lanes_register_owner NOLOGIN;      -- owns lanes_register and its functions
CREATE ROLE lanes_register_writer NOLOGIN;     -- REGISTER-WRITER: a group; each engineer's login joins it
CREATE ROLE lanes_register_reader NOLOGIN;     -- READER: a group, as the writer's
CREATE ROLE lanes_indexer LOGIN;               -- Amendment 14's indexer
GRANT lanes_register_owner, lanes_indexer TO CURRENT_USER   -- PG16 gives a CREATEROLE admin
  WITH INHERIT TRUE, SET TRUE;                 -- ADMIN only: SET for 1.2's AUTHORIZATION and
                                               -- SET ROLE, INHERIT for the GRANTs below
-- Migration 1 (§1.2, §1.3.1) runs here, and commits. Then:
REVOKE ALL ON DATABASE :"db" FROM PUBLIC;      -- the database Q22 names (psql -v db=…)
GRANT CONNECT ON DATABASE :"db" TO lanes_register_writer, lanes_register_reader, lanes_indexer;

REVOKE ALL ON SCHEMA lanes_register FROM PUBLIC;
GRANT USAGE ON SCHEMA lanes_register TO lanes_register_writer, lanes_register_reader;
REVOKE ALL ON ALL TABLES IN SCHEMA lanes_register FROM PUBLIC;
GRANT SELECT ON ALL TABLES IN SCHEMA lanes_register TO lanes_register_writer, lanes_register_reader;
ALTER DEFAULT PRIVILEGES FOR ROLE lanes_register_owner IN SCHEMA lanes_register   -- and a later
  GRANT SELECT ON TABLES TO lanes_register_writer, lanes_register_reader;          -- migration's
GRANT SELECT ON ALL SEQUENCES IN SCHEMA lanes_register TO lanes_register_reader;   -- pg_dump reads
ALTER DEFAULT PRIVILEGES FOR ROLE lanes_register_owner IN SCHEMA lanes_register   -- doc_lines'
  GRANT SELECT ON SEQUENCES TO lanes_register_reader;                               -- identity
REVOKE ALL ON ALL FUNCTIONS IN SCHEMA lanes_register FROM PUBLIC;
ALTER DEFAULT PRIVILEGES FOR ROLE lanes_register_owner         -- global form: a per-schema REVOKE
  REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC;                      -- cannot undo PUBLIC's default
GRANT EXECUTE ON FUNCTION lanes_register.commit_write(bigint, uuid, integer, uuid, jsonb),
                          lanes_register.switch_to_files(integer, bigint, text, text),
                          lanes_register.record_marker(integer, bigint, text, text),
                          lanes_register.find_write(uuid, timestamptz, uuid, text, text, text),
                          lanes_register.record_mirror_state(text, text, text)
  TO lanes_register_writer;                    -- no INSERT, UPDATE, DELETE or DDL anywhere
GRANT EXECUTE ON FUNCTION lanes_register.render_file(text)
  TO lanes_register_writer, lanes_register_reader;

-- #160's schema: the indexer owns it and its open_write fills it; the reader reads it.
-- The register writer gets nothing in lanes_index, and the indexer nothing in lanes_register.
CREATE SCHEMA IF NOT EXISTS lanes_index AUTHORIZATION lanes_indexer;
REVOKE ALL ON SCHEMA lanes_index FROM PUBLIC;
GRANT USAGE ON SCHEMA lanes_index TO lanes_register_reader;
GRANT SELECT ON ALL TABLES IN SCHEMA lanes_index TO lanes_register_reader;   -- any already there
ALTER DEFAULT PRIVILEGES FOR ROLE lanes_indexer IN SCHEMA lanes_index
  GRANT SELECT ON TABLES TO lanes_register_reader;
ALTER DEFAULT PRIVILEGES FOR ROLE lanes_indexer IN SCHEMA lanes_index   -- #160 has no sequence;
  GRANT SELECT ON SEQUENCES TO lanes_register_reader;                   -- a later one, for pg_dump

-- The floors are each login's own (the login step): a role's settings reach no member.
"""

#: The block's comment line where migration 1 runs and commits: its split.
_REGISTER_ROLE_BLOCK_SPLIT = "-- Migration 1 (§1.2, §1.3.1) runs here, and commits. Then:\n"

#: One of the block's CREATE ROLE statements: one line, its comment included.
_REGISTER_CREATE_ROLE_RE = re.compile(
    r"CREATE ROLE ([a-z_][a-z0-9_]*) (?:NO)?LOGIN;[ \t]*(?:--[^\n]*)?\n")


def _register_sql_units(text: str) -> list[str]:
    """`text` cut into units, byte for byte, by the layout of the design's SQL
    blocks: a line that starts in column 0 starts a unit, the indented lines
    after it belong to it, and a blank line is a unit of its own. So a
    statement's unit holds its trailing comments, and its units sent
    unchanged send the design's text unchanged. Text that does not cut so is
    a defect of this build."""
    units = re.findall(r"[^ \t\n][^\n]*\n(?:[ \t][^\n]*\n)*|\n", text)
    if "".join(units) != text:
        raise RuntimeError("register SQL text does not cut into units: each unit starts in "
                           "column 0, and every line ends in a newline")
    return units


def _register_role_block_parts() -> tuple[list[tuple[str, str]], str, str]:
    """§1.4'S BLOCK, CUT WHERE MIGRATION 1 RUNS. Returns `(creates, grant,
    rest)`, each the block's own text:
      - `creates`: `(role, statement)` for each CREATE ROLE above the split,
        in the block's order;
      - `grant`: the admin's GRANT, the last statement above the split, with
        its comment lines;
      - `rest`: everything below the split.
    A block that does not cut so is a defect of this build, so the error is
    not a refusal."""
    head, split, rest = _REGISTER_ROLE_BLOCK.partition(_REGISTER_ROLE_BLOCK_SPLIT)
    if (not split or not head.endswith("\n")
            or _REGISTER_ROLE_BLOCK.count(_REGISTER_ROLE_BLOCK_SPLIT) != 1):
        raise RuntimeError("the register's role block has no one line where migration 1 runs")
    *units, grant = _register_sql_units(head)
    creates = []
    for unit in units:
        match = _REGISTER_CREATE_ROLE_RE.fullmatch(unit)
        if not match:
            raise RuntimeError(f"the register's role block holds {unit!r} before its GRANT, "
                               f"not a CREATE ROLE")
        creates.append((match.group(1), unit))
    roles = [role for role, _statement in creates]
    if (not roles or len(set(roles)) != len(roles) or not grant.startswith("GRANT ")
            or " TO CURRENT_USER" not in grant):
        raise RuntimeError(f"the register's role block creates {roles}, then {grant!r}: not "
                           f"distinct roles, then the admin's GRANT")
    return creates, grant, rest


def register_role_names() -> list[str]:
    """The roles §1.4 creates, in its order: the owner, the writer and reader
    groups, and the indexer's login."""
    return [role for role, _statement in _register_role_block_parts()[0]]


def register_roles_query() -> str:
    """THE `pg_roles` CHECK that guards §1.4's CREATE ROLEs: one query, read
    through the admin connection just before `apply_register_roles`. Its rows
    are the names of those of §1.4's roles that exist already, one per row.
    The names are the block's own, plain identifiers by
    `_REGISTER_CREATE_ROLE_RE`, so each is a literal as it stands."""
    names = ", ".join(f"'{role}'" for role in register_role_names())
    return f"SELECT rolname FROM pg_catalog.pg_roles WHERE rolname IN ({names}) ORDER BY rolname;\n"


def _register_role_selection(existing) -> tuple[list[str], list[str]]:
    """The roles to create, and the statements to send, given `existing`."""
    if isinstance(existing, (str, bytes)):
        raise TypeError("the roles found are a collection of names, not one string")
    found = frozenset(existing)
    if not all(isinstance(role, str) for role in found):
        raise TypeError(f"the roles found are names, each a str: {sorted(map(repr, found))}")
    creates, grant, _rest = _register_role_block_parts()
    absent = [(role, statement) for role, statement in creates if role not in found]
    statements = [statement for _role, statement in absent] + [grant]
    return [role for role, _statement in absent], statements


def register_role_statements(existing) -> list[str]:
    """§1.4'S FIRST PART, GUARDED: the statements the bootstrap sends before
    migration 1. `existing` holds the role names `register_roles_query` found.
    Returns the CREATE ROLE of each of §1.4's roles that `existing` lacks, in
    the block's order, then the admin's GRANT, which goes every time since it
    can run again. Each is the block's own text, byte for byte, comments and
    all: none is wrapped, rewritten or put in a DO block. Where no role
    exists, they are the block's first part whole. Nothing is sent here."""
    return _register_role_selection(existing)[1]


def apply_register_roles(run, existing) -> list[str]:
    """SEND §1.4'S FIRST PART: the bootstrap's step before migration 1, which
    `--roles-only` sends too.

    `existing` is as `register_role_statements` takes it, read just before.
    `run(script, variables)` is the runner `apply_register_migrations` takes.
    The statements go as one script, with no psql variable and, as in §1.4,
    no BEGIN. The bootstrap's runner sends it with psql's
    `--single-transaction` (lane 1's ruling for T109), so it commits whole,
    and the owner role and the admin's SET on it then stand before migration
    1's `CREATE SCHEMA ... AUTHORIZATION lanes_register_owner` and its `SET
    LOCAL ROLE` need them; a run that fails leaves nothing.

    Returns the roles it created, in the block's order; the others were
    there already, `unchanged`. The GRANT is sent either way."""
    created, statements = _register_role_selection(existing)
    run("".join(statements), {})
    return created


def apply_register_grants(run, *, database: str) -> None:
    """SEND §1.4'S SECOND PART: the bootstrap's step after migration 1 has
    committed. It is the rest of the block below its split line, whole: the
    database's CONNECT, the schemas' USAGE, SELECT and default privileges,
    EXECUTE on the writer functions and on `render_file`, and `lanes_index`'s
    schema.

    `database` is the register's database, the one the admin connection
    reaches and owns (operations.md §2.4). It goes as the psql variable `db`,
    which the block reads as `:"db"`, an identifier psql quotes. It is
    refused before anything is sent where it is empty or holds a control
    character. Like the first part, the script carries no BEGIN, and the
    bootstrap's runner sends it as one transaction. Each statement can run
    again, so a run that fails is finished by the next."""
    if not isinstance(database, str) or not database.strip():
        raise Refusal("bootstrap: the database name is empty")
    if any(ord(ch) < 0x20 or ord(ch) == 0x7F for ch in database):
        raise Refusal("bootstrap: the database name holds a control character")
    run(_register_role_block_parts()[2], {"db": database})


# `LANES-INDEX BOOTSTRAP` (operations.md §2.4; FR-053, FR-054; T109). Brett's
# command for the register's roles and schema, run from his own shell and never
# from a lane session, through the admin service he names. In this order:
#   1. the refusals that need no connection: usage (64); an argument that
#      carries a connection string or a password, `store=sqlite`, a
#      `register_schema=` that is not a plain identifier or that a script does
#      not render for, a stdout that is not a terminal without
#      `--no-passwords`, and a workstation with no name (2);
#   2. ONE READ through the admin service: who the admin is and what it may
#      do, which of §1.4's roles exist, the schema, the states §1.4's
#      statements leave, and each privilege of §1.4's roles outside its scope.
#      An admin that may not create roles or schemas, or does not own the
#      database, a schema newer than this build, and a privilege outside a
#      role's scope are refused (2) before anything is written;
#   3. §1.4's first part (T108), with the indexer's password where it creates
#      that login, as one transaction; then that login's password-file line,
#      printed once;
#   4. migration 1 (T107), rendered for `register_schema=` (lane 3's ruling
#      (a), #165 6746655077), or `unchanged`;
#   5. §1.4's second part, rendered the same way, as one transaction;
#   6. one read that confirms the result: the indexer cannot write the
#      register's tables, no role holds a privilege outside its scope, and
#      the database-level states stand.
# With the switch at `primary`, as on a restored backup, it verifies, applies a
# pending migration, writes no label and "changes nothing else" (ops:434).
# `--roles-only` sends steps 3 and §1.4's three database-level statements, as
# one transaction (option (a), lane 3's ruling, #165 6727022920).
#
# ONE TRANSACTION A STEP, AND Y'S BYTES UNCHANGED (lane 1's ruling for T109).
# A part whose text carries no transaction control goes through psql's
# `--single-transaction`, with `-v ON_ERROR_STOP=1`, so a failed step leaves
# nothing. A migration carries its own BEGIN and COMMIT, and goes as T107's
# runner sends it. Every statement each step sends can run inside a
# transaction block: CREATE ROLE, GRANT, REVOKE, ALTER ROLE, ALTER DEFAULT
# PRIVILEGES and CREATE SCHEMA.
#
# THE ADMIN CONNECTION (ops:404; lane 3's ruling, #165 6747611042). `psql`
# reaches the database only through `PGSERVICE=<service>` in its environment.
# Every inherited variable whose name begins `PG` is dropped first, and only
# `lanes-index`'s own fixed settings are set beside it. So only Brett's own
# `~/.pg_service.conf` defines the connection, his own `~/.pgpass` holds its
# password, and `lanes-index` never picks a database.

#: The codes this subcommand exits with, by contracts/exit-codes.md §1's names.
#: `bootstrap` is the first new subcommand on this line to exit with them; #160's
#: own exits keep their literals.
EXIT_OK = 0
EXIT_REFUSED = 2
EXIT_USAGE = 64
EXIT_UNAVAILABLE = 69


class RegisterUnavailable(Exception):
    """The admin connection failed, or the database refused what was sent:
    exit 69 (operations.md §2.4's exits). The step that was running rolled
    back as a whole; a step before it stands, and a rerun goes on from it."""


class _RegisterUsage(Exception):
    """A bootstrap command line that is not its usage: exit 64, before any
    connection is opened."""


#: The schema Y's scripts name. A run on it renders each script to its own
#: bytes, so the rendered digest equals `script_sha256`.
REGISTER_TEMPLATE_SCHEMA = "lanes_register"

#: §1.4's three roles whose names begin with the template's schema name. The
#: rendering never touches them, and they are the only such names a rendered
#: script may hold (lane 3's ruling (a)).
_REGISTER_SCHEMA_NAMED_ROLES = frozenset(
    ("lanes_register_owner", "lanes_register_writer", "lanes_register_reader"))

#: The indexer's login: §1.4's one login, and so the one password the
#: bootstrap ever generates.
_REGISTER_INDEXER = "lanes_indexer"

#: The client timer of each admin `psql` call, as #160's own bound. D9 gives a
#: migration no timer (Y:3530); this one only ends a call that hangs.
_REGISTER_ADMIN_TIMEOUT_S = 300

#: The SCRAM-SHA-256 iteration count psql's `\password` uses by default (the
#: server's `scram_iterations`, 4096 in PostgreSQL 16).
_REGISTER_SCRAM_ITERATIONS = 4096

_REGISTER_TOKEN = r"(?<![A-Za-z0-9_$])lanes_register(?![A-Za-z0-9_$])"

#: The schema's name after `CREATE SCHEMA` (with `IF NOT EXISTS`), and after
#: `ON SCHEMA` and `IN SCHEMA`, where §1.4's second part names it.
_REGISTER_SCHEMA_WORD_RE = re.compile(
    r"((?i:\bcreate\s+schema(?:\s+if\s+not\s+exists)?|\bon\s+schema|\bin\s+schema)\s+)"
    + _REGISTER_TOKEN)

#: A `search_path` setting's list of schemas, `TO` or `=`.
_REGISTER_SEARCH_PATH_RE = re.compile(
    r"((?i:\bsearch_path)\s*(?:(?i:to)\s+|=\s*))"
    r"([A-Za-z_][A-Za-z0-9_$]*(?:\s*,\s*[A-Za-z_][A-Za-z0-9_$]*)*)")

#: The schema's name as a qualifier, before a `.`.
_REGISTER_QUALIFIER_RE = re.compile(r"(?<![A-Za-z0-9_$])lanes_register(?=\.)")

_REGISTER_TOKEN_RE = re.compile(_REGISTER_TOKEN)

#: Any identifier that begins with the template's schema name, in any case.
_REGISTER_NAME_RE = re.compile(r"(?<![A-Za-z0-9_$])(?i:lanes_register)[A-Za-z0-9_$]*")

#: A verifier, wherever psql might echo one in an error.
_REGISTER_VERIFIER_RE = re.compile(r"SCRAM-SHA-256\$[^\s'\"]*")

#: The marker between the answers of one read, as `_query_many`'s.
_REGISTER_NEXT = "\x1eLANES-INDEX-NEXT"

_BOOTSTRAP_USAGE = f"""\
{PROG} bootstrap --admin-service <service> --label <name> --repository <owner/name>
                    --lane <name> [--no-passwords]
{PROG} bootstrap --admin-service <service> --roles-only [--no-passwords]

Makes the SQL register's roles and schema, or migrates the schema forward, through
the libpq service <service> in your own ~/.pg_service.conf, with its password in
your own ~/.pgpass (operations.md §2.4). The service names the register's
database; {PROG} never picks one. Run it from your shell: it prints the
indexer's password-file line once, only to a terminal.

  --label <name>        the database's label, written into the switch it creates
  --repository <o/n>    the workspace repository the register serves
  --lane <name>         the lane or person running it
  --roles-only          only the roles and the three database-level statements a
                        database dump does not carry, before a restore
  --no-passwords        for roles that log in by peer, trust or certificate

Exit: 0 done · 2 refused, nothing written · 64 usage · 69 the admin connection
failed, or the database refused a step."""


def render_register_script(text: str, schema: str, what: str = "the script") -> str:
    """ONE OF Y'S SCRIPTS, RENDERED FOR `register_schema=` (lane 3's ruling
    (a), #165 6746655077). Y's bytes stay the template.

    Whole identifier tokens `lanes_register` are replaced by `schema` where
    they name the schema, and nowhere else:
      - after `CREATE SCHEMA`, and after `ON SCHEMA` and `IN SCHEMA`, which
        §1.4's second part uses;
      - in every `search_path` list;
      - as a qualifier, before a `.`.
    So `lanes_register_owner`, `lanes_register_writer` and
    `lanes_register_reader`, which are other tokens, stay as they are. After
    rendering, a script that still names `lanes_register`, in any case, as
    anything but those three roles is refused (2), and so is a schema that is
    not a plain lower-case identifier. On `lanes_register` the result is the
    template's own bytes."""
    if not isinstance(schema, str) or not SCHEMA_NAME_RE.match(schema):
        raise Refusal("register_schema= is not a plain lower-case SQL identifier "
                      "([a-z_][a-z0-9_]{0,62})")
    out = _REGISTER_SCHEMA_WORD_RE.sub(lambda m: m.group(1) + schema, text)
    out = _REGISTER_SEARCH_PATH_RE.sub(
        lambda m: m.group(1) + _REGISTER_TOKEN_RE.sub(lambda _t: schema, m.group(2)), out)
    out = _REGISTER_QUALIFIER_RE.sub(lambda _m: schema, out)
    left = sorted({m.group(0) for m in _REGISTER_NAME_RE.finditer(out)
                   if m.group(0).lower() != schema
                   and m.group(0).lower() not in _REGISTER_SCHEMA_NAMED_ROLES})
    if left:
        raise Refusal(f"bootstrap: {what}, rendered for the schema {schema}, still names "
                      f"{', '.join(left)}, which is neither that schema nor one of the roles "
                      f"{', '.join(sorted(_REGISTER_SCHEMA_NAMED_ROLES))} (lane 3's ruling (a), "
                      f"#165 6746655077); this build cannot bootstrap that schema")
    return out


def _register_rendered(schema: str) -> tuple[dict[str, str], str]:
    """Every script the bootstrap may send that names the schema, rendered
    before anything is sent: each migration, keyed by its template, and
    §1.4's second part."""
    migrations = {REGISTER_MIGRATIONS[version]: render_register_script(
        REGISTER_MIGRATIONS[version], schema, f"migration {version}")
        for version in sorted(REGISTER_MIGRATIONS)}
    rest = render_register_script(_register_role_block_parts()[2], schema,
                                  "§1.4's second part")
    return migrations, rest


def _register_execute_grants() -> dict[str, list[str]]:
    """§1.4's EXECUTE grants, read from its own text: for each group, the
    signatures it may execute, as `name(types)` without the schema."""
    grants: dict[str, list[str]] = {}
    for unit in _register_sql_units(_register_role_block_parts()[2]):
        if not unit.startswith("GRANT EXECUTE ON FUNCTION "):
            continue
        signatures = re.findall(r"lanes_register\.([a-z_][a-z0-9_]*\([^()]*\))", unit)
        to = re.search(r"\n[ \t]+TO ([a-z_][a-z0-9_]*(?:, [a-z_][a-z0-9_]*)*);", unit)
        if not signatures or not to:
            raise RuntimeError(f"the register's role block's EXECUTE grant {unit!r} does not "
                               f"read as functions, then TO its roles")
        for role in to.group(1).split(", "):
            grants.setdefault(role, []).extend(signatures)
    if set(grants) != {"lanes_register_writer", "lanes_register_reader"}:
        raise RuntimeError(f"the register's role block grants EXECUTE to {sorted(grants)}")
    return grants


def _register_roles_only_parts() -> list[str]:
    """`--roles-only`'S THREE DATABASE-LEVEL STATEMENTS, each §1.4's own unit,
    unchanged and in its order: Y:2243's `REVOKE ALL ON DATABASE ... FROM
    PUBLIC`, Y:2244's `GRANT CONNECT`, and Y:2256-2257's global `ALTER
    DEFAULT PRIVILEGES FOR ROLE lanes_register_owner REVOKE EXECUTE ON
    FUNCTIONS FROM PUBLIC`. No database dump carries them (lane 3's ruling
    (a), #165 6727022920)."""
    units = _register_sql_units(_register_role_block_parts()[2])
    picks = [
        [u for u in units if u.startswith("REVOKE ALL ON DATABASE ")],
        [u for u in units if u.startswith("GRANT CONNECT ON DATABASE ")],
        [u for u in units if u.startswith("ALTER DEFAULT PRIVILEGES FOR ROLE lanes_register_owner ")
         and " IN SCHEMA " not in u and "REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC" in u],
    ]
    if any(len(pick) != 1 for pick in picks):
        raise RuntimeError("the register's role block does not hold exactly one of each of "
                           "the three database-level statements")
    return [pick[0] for pick in picks]


def register_scram_verifier(password: str, salt: bytes | None = None,
                            iterations: int = _REGISTER_SCRAM_ITERATIONS) -> str:
    """A SCRAM-SHA-256 verifier for `password`, computed here, on the client,
    as psql's `\\password` computes it (RFC 5802, RFC 7677; PostgreSQL's
    `scram_build_secret`): a random 16-byte salt, PBKDF2-HMAC-SHA-256, then
    `SCRAM-SHA-256$<iterations>:<salt>$<StoredKey>:<ServerKey>`, each part in
    base64. The server stores it as given, so neither its log nor a failed
    statement ever holds the password itself. The bootstrap's passwords are
    ASCII letters, digits, `-` and `_`, which SASLprep leaves as they are."""
    import base64
    import hmac
    import secrets
    if salt is None:
        salt = secrets.token_bytes(16)
    salted = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt, iterations)
    client_key = hmac.new(salted, b"Client Key", hashlib.sha256).digest()
    stored_key = hashlib.sha256(client_key).digest()
    server_key = hmac.new(salted, b"Server Key", hashlib.sha256).digest()

    def b64(raw: bytes) -> str:
        return base64.b64encode(raw).decode("ascii")

    return f"SCRAM-SHA-256${iterations}:{b64(salt)}${b64(stored_key)}:{b64(server_key)}"


def _register_pgpass_line(database: str, login: str, password: str) -> str:
    """A libpq password-file line for `login` on `database`, at any host and
    port: the file holds this one line, and the URL beside it names the host.
    `:` and `\\` in a field are escaped, as libpq reads them."""
    def field(value: str) -> str:
        return value.replace("\\", "\\\\").replace(":", "\\:")
    return f"*:*:{field(database)}:{field(login)}:{field(password)}"


def _register_admin_env(service: str) -> dict:
    """THE ADMIN `psql`'S ENVIRONMENT (ops:404; lane 3's ruling, #165
    6747611042): every inherited variable whose name begins `PG` dropped, then
    `PGSERVICE=<service>` and `lanes-index`'s own fixed settings, nothing else
    that begins `PG`. A `connect_timeout=` in the service file wins over
    `PGCONNECT_TIMEOUT` (libpq reads the service first), so 2, D9's `c` where
    none is measured, holds only where the service names none."""
    env = {key: value for key, value in os.environ.items() if not key.startswith("PG")}
    env["PGSERVICE"] = service
    env["PGAPPNAME"] = PROG
    env["PGCLIENTENCODING"] = "UTF8"
    env["PGCONNECT_TIMEOUT"] = "2"
    return env


def _register_psql_error(proc: subprocess.CompletedProcess) -> str:
    lines = [_REGISTER_VERIFIER_RE.sub("SCRAM-SHA-256$<verifier>", line.strip())
             for line in (proc.stderr or "").splitlines() if line.strip()]
    for line in lines:
        if re.search(r"\b(ERROR|FATAL|PANIC):|psql: error:", line):
            return line
    return lines[-1] if lines else f"psql exited {proc.returncode}"


def _register_admin_psql(service: str, script: str, variables: dict, *,
                         single_transaction: bool) -> str:
    """ONE `psql` CALL THROUGH THE ADMIN SERVICE: the script on stdin (`-f -`),
    `-X`, `-q`, `-w` (never a password prompt), `-v ON_ERROR_STOP=1`, one
    `-v <name>=<value>` per variable, and, for a script with no transaction
    control of its own, `--single-transaction`, so the call commits whole or
    leaves nothing. No connection string and no service name is in its
    argument list.

    Returns its stdout. Any end but 0, a timer that runs out, or no `psql` is
    `RegisterUnavailable` (69), with psql's error, every verifier in it
    masked. On success, a WARNING psql printed is passed on; a NOTICE is not."""
    psql = shutil.which("psql")
    if not psql:
        raise RegisterUnavailable("there is no psql on PATH")
    argv = [psql, "-X", "-q", "-w", "-v", "ON_ERROR_STOP=1"]
    if single_transaction:
        argv.append("--single-transaction")
    for name, value in variables.items():
        argv += ["-v", f"{name}={value}"]
    argv += ["-f", "-"]
    try:
        proc = subprocess.run(argv, input=script, capture_output=True, encoding="utf-8",
                              errors="replace", check=False, env=_register_admin_env(service),
                              timeout=_REGISTER_ADMIN_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        raise RegisterUnavailable(f"psql did not answer within {_REGISTER_ADMIN_TIMEOUT_S} s")
    except OSError as exc:
        raise RegisterUnavailable(f"psql could not be run: {exc}")
    if proc.returncode != 0:
        raise RegisterUnavailable(_register_psql_error(proc))
    for line in (proc.stderr or "").splitlines():
        if re.search(r"\bWARNING:", line):
            note(_REGISTER_VERIFIER_RE.sub("SCRAM-SHA-256$<verifier>", line.strip()))
    return proc.stdout


def _register_reads(service: str, tag: str, queries: list[str], *,
                    command: str = "bootstrap") -> list[list[list]]:
    """Several SELECTs through the admin service in ONE `psql` call and one
    transaction, each answered as TEXT-format COPY rows, as `_query_many`
    reads them. Nothing is written. `command` names the subcommand reading,
    `bootstrap` or `login`, in the script's first line."""
    lines = [f"-- lanes-index {command}: {tag}"]
    for query in queries:
        lines.append(f"COPY ({query}) TO STDOUT;")
        lines.append("\\echo '\\036LANES-INDEX-NEXT'")
    out = _register_admin_psql(service, "\n".join(lines) + "\n", {}, single_transaction=True)
    results: list[list[list]] = []
    current: list[list] = []
    for line in out.split("\n"):
        if line == _REGISTER_NEXT:
            results.append(current)
            current = []
            continue
        if line:
            current.append([_pg_unescape(field) for field in line.split("\t")])
    if len(results) != len(queries):
        raise RegisterUnavailable(f"psql answered {len(results)} of the {len(queries)} reads "
                                  f"of the {command}'s {tag}")
    return results


def _register_names_sql(names) -> str:
    return ", ".join(_pg_quote(name) for name in names)


def _register_admin_query() -> str:
    """Who the admin is, and what it may do (operations.md §2.4's refusals)."""
    return ("SELECT current_user::text, current_database()::text, "
            "a.rolsuper OR a.rolcreaterole, "
            "pg_catalog.has_database_privilege(current_database(), 'CREATE'), "
            "pg_catalog.pg_has_role(current_user, d.datdba, 'USAGE'), "
            "current_setting('server_version_num') "
            "FROM pg_catalog.pg_roles a, pg_catalog.pg_database d "
            "WHERE a.rolname = current_user AND d.datname = current_database()")


def _register_schema_query(schema: str) -> str:
    """The schema, if it exists, and whether it holds a register's three
    first tables."""
    return (f"SELECT n.nspname::text, "
            f"to_regclass({_pg_quote(schema + '.schema_version')}) IS NOT NULL, "
            f"to_regclass({_pg_quote(schema + '.register_switch')}) IS NOT NULL, "
            f"to_regclass({_pg_quote(schema + '.register_head')}) IS NOT NULL "
            f"FROM pg_catalog.pg_namespace n WHERE n.nspname = {_pg_quote(schema)}")


def _register_states_query() -> str:
    """THE STATES §1.4'S STATEMENTS LEAVE, each true where it already stands:
    PUBLIC holds no privilege on the database; the two groups and the indexer
    each hold CONNECT; the owner's global default privileges give PUBLIC no
    EXECUTE; and the admin holds the owner and the indexer WITH INHERIT TRUE,
    SET TRUE. So each line prints `created` or `unchanged`."""
    roles = register_role_names()
    owner, indexer = roles[0], _REGISTER_INDEXER
    groups = _register_names_sql(roles[1:3] + [indexer])
    database_acl = ("FROM pg_catalog.pg_database d CROSS JOIN LATERAL pg_catalog.aclexplode("
                    "coalesce(d.datacl, pg_catalog.acldefault('d', d.datdba))) AS e "
                    "WHERE d.datname = current_database()")
    return (f"SELECT NOT EXISTS (SELECT 1 {database_acl} AND e.grantee = 0), "
            f"(SELECT count(DISTINCT e.grantee) {database_acl} AND e.privilege_type = 'CONNECT' "
            f"AND e.grantee IN (SELECT a.oid FROM pg_catalog.pg_roles a "
            f"WHERE a.rolname IN ({groups}))) = 3, "
            f"EXISTS (SELECT 1 FROM pg_catalog.pg_default_acl x "
            f"JOIN pg_catalog.pg_roles a ON a.oid = x.defaclrole "
            f"WHERE a.rolname = {_pg_quote(owner)} AND x.defaclnamespace = 0 "
            f"AND x.defaclobjtype = 'f' AND NOT EXISTS (SELECT 1 FROM "
            f"pg_catalog.aclexplode(x.defaclacl) AS e WHERE e.grantee = 0 "
            f"AND e.privilege_type = 'EXECUTE')), "
            f"(SELECT count(DISTINCT b.rolname) FROM pg_catalog.pg_auth_members m "
            f"JOIN pg_catalog.pg_roles b ON b.oid = m.roleid "
            f"JOIN pg_catalog.pg_roles a ON a.oid = m.member "
            f"WHERE a.rolname = current_user "
            f"AND b.rolname IN ({_register_names_sql([owner, indexer])}) "
            f"AND coalesce((to_jsonb(m) ->> 'inherit_option')::boolean, false) "
            f"AND coalesce((to_jsonb(m) ->> 'set_option')::boolean, false)) = 2")


def _register_fingerprint_query(schema: str) -> str:
    """One digest of every privilege in the register's schema and in
    `lanes_index`: the schemas', the relations', the functions' and the
    default privileges. Equal before and after §1.4's second part means it
    changed nothing."""
    names = _register_names_sql([schema, "lanes_index"])
    return ("SELECT md5(coalesce(string_agg(x.line, chr(10) ORDER BY x.line), '')) FROM ("
            f"SELECT 'schema ' || n.nspname || ' ' || coalesce(n.nspacl::text, '-') AS line "
            f"FROM pg_catalog.pg_namespace n WHERE n.nspname IN ({names}) "
            f"UNION ALL SELECT 'relation ' || n.nspname || '.' || c.relname || ' ' "
            f"|| coalesce(c.relacl::text, '-') FROM pg_catalog.pg_class c "
            f"JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace "
            f"WHERE n.nspname IN ({names}) AND c.relkind IN ('r', 'p', 'v', 'm', 'f', 'S') "
            f"UNION ALL SELECT 'function ' || n.nspname || '.' || p.proname || '(' "
            f"|| pg_catalog.oidvectortypes(p.proargtypes) || ') ' || coalesce(p.proacl::text, '-') "
            f"FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace "
            f"WHERE n.nspname IN ({names}) "
            f"UNION ALL SELECT 'default ' || da.defaclrole::regrole::text || ' ' || n.nspname "
            f"|| ' ' || da.defaclobjtype::text || ' ' || da.defaclacl::text "
            f"FROM pg_catalog.pg_default_acl da "
            f"JOIN pg_catalog.pg_namespace n ON n.oid = da.defaclnamespace "
            f"WHERE n.nspname IN ({names})) AS x(line)")


def _register_scope_queries(schema: str) -> list[str]:
    """EACH PRIVILEGE OF §1.4'S ROLES OUTSIDE ITS SCOPE (operations.md §2.4:
    "a role holds a privilege outside its scope ... named and never revoked
    silently"). Four reads, each a row `(role, what it holds, class)`:
      - an attribute: SUPERUSER, CREATEROLE, CREATEDB, REPLICATION or
        BYPASSRLS on any of the four, or LOGIN on the owner or a group;
      - a membership of any of the four in any role;
      - a grant, by the object's ACL with PostgreSQL's defaults filled in, to
        a group, the indexer or PUBLIC, beyond §1.4's matrix:
          - REGISTER-WRITER: USAGE on the schema, SELECT on its tables and
            sequences, EXECUTE on the five writer functions and
            `render_file`, CONNECT; nothing in `lanes_index`;
          - READER: USAGE and SELECT in both schemas, EXECUTE on
            `render_file`, CONNECT;
          - the indexer: anything in `lanes_index`, CONNECT; nothing in the
            register's schema;
          - PUBLIC: nothing;
      - a table of the register's schema that a group or the indexer can
        write by any route, and a table of `lanes_index` the writer can:
        operations.md §2.4's "the indexer cannot write the register's
        tables".
    The class marks PUBLIC's PostgreSQL defaults, CONNECT and TEMPORARY on the
    database and EXECUTE on a function, which §1.4's REVOKEs remove."""
    roles = register_role_names()
    four = _register_names_sql(roles)
    three = _register_names_sql(roles[1:])
    s = _pg_quote(schema)
    fns = []
    for role, signatures in sorted(_register_execute_grants().items()):
        who = "writer" if role == roles[1] else "reader"
        for signature in signatures:
            fns.append(f"(to_regprocedure({_pg_quote(schema + '.' + signature)})::oid, "
                       f"{_pg_quote(who)})")
    attributes = (
        "SELECT a.rolname::text, 'has the attribute ' || x.attr, '' "
        "FROM pg_catalog.pg_roles a CROSS JOIN LATERAL (VALUES "
        "('SUPERUSER', a.rolsuper), ('CREATEROLE', a.rolcreaterole), "
        "('CREATEDB', a.rolcreatedb), ('REPLICATION', a.rolreplication), "
        "('BYPASSRLS', a.rolbypassrls), "
        f"('LOGIN', a.rolcanlogin AND a.rolname <> {_pg_quote(_REGISTER_INDEXER)})) AS x(attr, held) "
        f"WHERE a.rolname IN ({four}) AND x.held")
    memberships = (
        "SELECT a.rolname::text, 'is a member of the role ' || quote_ident(b.rolname), '' "
        "FROM pg_catalog.pg_auth_members m "
        "JOIN pg_catalog.pg_roles a ON a.oid = m.member "
        "JOIN pg_catalog.pg_roles b ON b.oid = m.roleid "
        f"WHERE a.rolname IN ({four})")
    grants = (
        "WITH g(oid, name, who) AS ("
        "SELECT a.oid, a.rolname::text, v.who FROM (VALUES "
        f"({_pg_quote(roles[1])}, 'writer'), ({_pg_quote(roles[2])}, 'reader'), "
        f"({_pg_quote(_REGISTER_INDEXER)}, 'indexer')) AS v(rolname, who) "
        "JOIN pg_catalog.pg_roles a ON a.rolname = v.rolname "
        "UNION ALL SELECT 0::oid, 'PUBLIC', 'public'), "
        "ns(oid, nspname, half, acl) AS ("
        f"SELECT n.oid, n.nspname::text, CASE WHEN n.nspname = {s} THEN 'register' "
        "ELSE 'index' END, coalesce(n.nspacl, pg_catalog.acldefault('n', n.nspowner)) "
        f"FROM pg_catalog.pg_namespace n WHERE n.nspname IN ({s}, 'lanes_index')), "
        "obj(kind, half, oid, label, acl) AS ("
        "SELECT 'schema'::text, ns.half, ns.oid, 'schema ' || quote_ident(ns.nspname), ns.acl "
        "FROM ns "
        "UNION ALL SELECT CASE WHEN c.relkind = 'S' THEN 'sequence' ELSE 'table' END, "
        "ns.half, c.oid, CASE WHEN c.relkind = 'S' THEN 'sequence ' ELSE 'table ' END "
        "|| quote_ident(ns.nspname) || '.' || quote_ident(c.relname), "
        "coalesce(c.relacl, pg_catalog.acldefault("
        "CASE WHEN c.relkind = 'S' THEN 's' ELSE 'r' END::\"char\", c.relowner)) "
        "FROM ns JOIN pg_catalog.pg_class c ON c.relnamespace = ns.oid "
        "WHERE c.relkind IN ('r', 'p', 'v', 'm', 'f', 'S') "
        "UNION ALL SELECT 'function', ns.half, p.oid, 'function ' || quote_ident(ns.nspname) "
        "|| '.' || quote_ident(p.proname) || '(' || pg_catalog.oidvectortypes(p.proargtypes) "
        "|| ')', coalesce(p.proacl, pg_catalog.acldefault('f', p.proowner)) "
        "FROM ns JOIN pg_catalog.pg_proc p ON p.pronamespace = ns.oid "
        "UNION ALL SELECT 'database', 'database', d.oid, 'database ' || quote_ident(d.datname), "
        "coalesce(d.datacl, pg_catalog.acldefault('d', d.datdba)) "
        "FROM pg_catalog.pg_database d WHERE d.datname = current_database()), "
        f"fn(oid, who) AS (VALUES {', '.join(fns)}) "
        "SELECT g.name, 'holds ' || e.privilege_type || ' on ' || o.label, "
        "CASE WHEN g.who = 'public' AND o.kind = 'database' "
        "AND e.privilege_type IN ('CONNECT', 'TEMPORARY') THEN 'public-default-database' "
        "WHEN g.who = 'public' AND o.kind = 'function' AND o.half = 'register' "
        "AND e.privilege_type = 'EXECUTE' THEN 'public-default-function' ELSE '' END "
        "FROM obj o CROSS JOIN LATERAL pg_catalog.aclexplode(o.acl) AS e "
        "JOIN g ON g.oid = e.grantee "
        "WHERE NOT ("
        "(g.who = 'writer' AND ("
        "(o.half = 'register' AND o.kind = 'schema' AND e.privilege_type = 'USAGE') "
        "OR (o.half = 'register' AND o.kind IN ('table', 'sequence') "
        "AND e.privilege_type = 'SELECT') "
        "OR (o.half = 'register' AND o.kind = 'function' AND e.privilege_type = 'EXECUTE' "
        "AND o.oid IN (SELECT fn.oid FROM fn WHERE fn.who = 'writer' AND fn.oid IS NOT NULL)) "
        "OR (o.kind = 'database' AND e.privilege_type = 'CONNECT'))) "
        "OR (g.who = 'reader' AND ("
        "(o.kind = 'schema' AND e.privilege_type = 'USAGE') "
        "OR (o.kind IN ('table', 'sequence') AND e.privilege_type = 'SELECT') "
        "OR (o.half = 'register' AND o.kind = 'function' AND e.privilege_type = 'EXECUTE' "
        "AND o.oid IN (SELECT fn.oid FROM fn WHERE fn.who = 'reader' AND fn.oid IS NOT NULL)) "
        "OR (o.kind = 'database' AND e.privilege_type = 'CONNECT'))) "
        "OR (g.who = 'indexer' AND (o.half = 'index' "
        "OR (o.kind = 'database' AND e.privilege_type = 'CONNECT'))))")
    writes = (
        "SELECT a.rolname::text, 'can write the table ' || quote_ident(n.nspname) || '.' "
        "|| quote_ident(c.relname) || ' (INSERT, UPDATE, DELETE or TRUNCATE)', '' "
        "FROM pg_catalog.pg_roles a CROSS JOIN pg_catalog.pg_class c "
        "JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace "
        f"WHERE a.rolname IN ({three}) AND c.relkind IN ('r', 'p') "
        f"AND (n.nspname = {s} OR (n.nspname = 'lanes_index' "
        f"AND a.rolname = {_pg_quote(roles[1])})) "
        "AND pg_catalog.has_table_privilege(a.oid, c.oid, 'INSERT, UPDATE, DELETE, TRUNCATE')")
    return [attributes, memberships, grants, writes]


def _register_scope_faults(rows: list[list], phase: str) -> list[str]:
    """The faults among the scope reads' rows, for `phase`:
      - `before`, ahead of any statement: PUBLIC's PostgreSQL defaults, which
        §1.4's own REVOKEs remove, are not faults yet;
      - `roles-only`, after `--roles-only`: PUBLIC's default EXECUTE on the
        schema's functions is the full bootstrap's to remove;
      - `all`, after the full bootstrap, and with the switch at `primary`,
        where nothing is sent again: every row is a fault."""
    ignore = {"before": {"public-default-database", "public-default-function"},
              "roles-only": {"public-default-function"},
              "all": set()}[phase]
    return [f"{row[0]} {row[1]}" for row in rows if len(row) >= 3 and row[2] not in ignore]


def _register_refuse_scope(faults: list[str]) -> None:
    if faults:
        raise Refusal("bootstrap: a role holds a privilege outside its scope, which the "
                      "bootstrap names and never revokes (operations.md §2.4); revoke it by "
                      "hand, then run it again:\n  - " + "\n  - ".join(faults))


def _register_flag(value: str) -> bool:
    if value not in ("t", "f"):
        raise RegisterUnavailable(f"psql answered {value!r} where a boolean was asked")
    return value == "t"


def _register_one_row(rows: list[list], width: int, what: str) -> list:
    if len(rows) != 1 or len(rows[0]) != width:
        raise RegisterUnavailable(f"psql answered {len(rows)} rows for {what}, not one row of "
                                  f"{width} fields")
    return rows[0]


def _register_states(rows: list[list]) -> dict:
    row = _register_one_row(rows, 4, "the role block's states")
    return dict(zip(("public", "connect", "defaults", "grant"), map(_register_flag, row)))


def _register_probe(service: str, schema: str) -> dict:
    """THE BOOTSTRAP'S FIRST READ, through the admin service, before anything
    is written."""
    queries = [_register_admin_query(),
               register_roles_query().rstrip().rstrip(";"),
               _register_schema_query(schema),
               _register_states_query(),
               _register_fingerprint_query(schema)] + _register_scope_queries(schema)
    res = _register_reads(service, "probe", queries)
    admin = _register_one_row(res[0], 6, "the admin")
    schema_rows = res[2]
    if len(schema_rows) > 1 or (schema_rows and len(schema_rows[0]) != 4):
        raise RegisterUnavailable("psql answered more than one schema row")
    return {
        "user": admin[0], "database": admin[1],
        "create_roles": _register_flag(admin[2]), "create_schemas": _register_flag(admin[3]),
        "owns": _register_flag(admin[4]), "server": admin[5],
        "roles": {row[0] for row in res[1] if row},
        "schema": None if not schema_rows else [_register_flag(v) for v in schema_rows[0][1:]],
        "states": _register_states(res[3]),
        "fingerprint": _register_one_row(res[4], 1, "the privileges' digest")[0],
        "scope": [row for rows in res[5:] for row in rows],
    }


def _register_state(service: str, schema: str) -> dict:
    """The register's own rows, where its schema exists: its version and
    floors, the switch and the head."""
    res = _register_reads(service, "state", [
        f"SELECT version, writers_from, readers_from FROM {schema}.schema_version",
        f"SELECT mode, marker_state, database_label, set_seq FROM {schema}.register_switch",
        f"SELECT seq FROM {schema}.register_head"])
    for rows, what in zip(res, ("schema_version", "register_switch", "register_head")):
        if len(rows) != 1:
            raise Refusal(f"bootstrap: {schema}.{what} holds {len(rows)} rows, not one: this "
                          f"schema is not a register this tool made")
    version = _register_one_row(res[0], 3, "schema_version")
    switch = _register_one_row(res[1], 4, "register_switch")
    head = _register_one_row(res[2], 1, "register_head")
    try:
        current = int(version[0])
    except (TypeError, ValueError):
        raise RegisterUnavailable(f"psql answered the version {version[0]!r}")
    return {"version": current, "mode": switch[0], "marker": switch[1], "label": switch[2],
            "set_seq": switch[3], "head": head[0]}


def _register_confirm(service: str, schema: str) -> dict:
    """THE BOOTSTRAP'S LAST READ: the states, the privileges' digest and the
    scope reads again, after its statements."""
    res = _register_reads(service, "check", [_register_states_query(),
                                            _register_fingerprint_query(schema)]
                          + _register_scope_queries(schema))
    return {"states": _register_states(res[0]),
            "fingerprint": _register_one_row(res[1], 1, "the privileges' digest")[0],
            "scope": [row for rows in res[2:] for row in rows]}


def _register_store_named_sqlite(cfg: dict) -> bool:
    """Whether the configuration's own `store=` line says `sqlite`. A file
    that names no `store=`, or no file, does not: `load_config` defaults the
    store from `url=`, the index half's, and an engineer's file names no
    `url=` (contracts/config.md §3.2)."""
    if not cfg.get("present"):
        return False
    try:
        with open(cfg["path"], encoding="utf-8") as handle:
            lines = handle.read().splitlines()
    except (OSError, UnicodeDecodeError) as exc:
        raise Refusal(f"the configuration {cfg['path']} cannot be read: {exc}")
    named = ""
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = (part.strip() for part in line.split("=", 1))
        if key == "store":
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            named = value
    return named == "sqlite"


def _register_refuse_argument(flag: str, value: str, *, command: str = "bootstrap") -> None:
    """An argument that carries a connection string or a password, such as a
    `key=value` pair or a URI, is refused (2), and never echoed. `command`
    names the subcommand refusing, `bootstrap` or `login`."""
    if "=" in value or "://" in value or _url_has_password(value):
        raise Refusal(f"{command}: {flag} carries a connection string or a password (a "
                      f"`key=value` pair or a URI). The admin connection is a service name "
                      f"in your own ~/.pg_service.conf, and no argument carries a connection")
    if flag == "--admin-service" and not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]{0,62}", value):
        raise Refusal(f"{command}: --admin-service is not a plain service name: letters, "
                      "digits, '_', '.' and '-', as a section of ~/.pg_service.conf")


def _register_workstation() -> str:
    """This workstation's name, for the switch's `set_by_ws` and the
    `migrations` row's `by_ws`. `$LANES_WORKSTATION`, where it is set, is
    the name: it is the seam `lanes-edit.sh workstation` answers with first,
    as it stands. Otherwise that command is asked, and it needs the
    workspace repository. A container with no name is refused, as every
    writer of the workstation column refuses it (R-A11-14)."""
    seam = os.environ.get("LANES_WORKSTATION", "")
    if seam:
        return seam
    try:
        name, how = this_workstation()
    except StoreUnusable as exc:
        raise Refusal(f"bootstrap: this workstation's name cannot be read ({exc.detail})")
    if how == "container-unset":
        raise Refusal("bootstrap: this is a container and LANES_WORKSTATION is not set, so "
                      "the switch and the migrations row would be stamped with the "
                      "container's own id (Amendment 11, R-A11-14). Run it from the host's "
                      "shell, or export LANES_WORKSTATION")
    return name


def _bootstrap_args(args: list[str]) -> dict | None:
    """The bootstrap's flags; None for `--help`."""
    opts: dict = {"--admin-service": None, "--label": None, "--repository": None,
                  "--lane": None, "--roles-only": False, "--no-passwords": False}
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-h", "--help"):
            return None
        name, eq, value = arg.partition("=")
        if name in ("--admin-service", "--label", "--repository", "--lane"):
            if not eq:
                value = args[i + 1] if i + 1 < len(args) else ""
                i += 1
            if not value:
                raise _RegisterUsage(f"bootstrap: {name} needs a value")
            if opts[name] is not None:
                raise _RegisterUsage(f"bootstrap: {name} is given twice")
            opts[name] = value
        elif arg in ("--roles-only", "--no-passwords"):
            opts[arg] = True
        else:
            raise _RegisterUsage(f"bootstrap: unknown argument '{arg}'")
        i += 1
    if opts["--admin-service"] is None:
        raise _RegisterUsage("bootstrap needs --admin-service <service>")
    if not opts["--roles-only"]:
        missing = [flag for flag in ("--label", "--repository", "--lane") if opts[flag] is None]
        if missing:
            raise _RegisterUsage(f"bootstrap needs {', '.join(missing)} (or --roles-only)")
    return opts


def _bootstrap_say(what: str, created: bool, detail: str = "") -> None:
    say(f"{what}: {'created' if created else 'unchanged'}" + (f" ({detail})" if detail else ""))


def cmd_bootstrap(args: list[str]) -> int:
    """`lanes-index bootstrap` (operations.md §2.4): its exits, by the
    contract's constants."""
    try:
        opts = _bootstrap_args(args)
    except _RegisterUsage as exc:
        note(f"{exc} - see {PROG} bootstrap --help")
        return EXIT_USAGE
    if opts is None:
        say(_BOOTSTRAP_USAGE)
        return EXIT_OK
    try:
        return _bootstrap(opts)
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return EXIT_REFUSED
    except RegisterUnavailable as exc:
        note(f"bootstrap: the admin connection failed, or the database refused a step: {exc}")
        return EXIT_UNAVAILABLE


def _bootstrap(opts: dict) -> int:
    service = opts["--admin-service"]
    roles_only = opts["--roles-only"]
    for flag in ("--admin-service", "--label", "--repository", "--lane"):
        if opts[flag] is not None:
            _register_refuse_argument(flag, opts[flag])
    if not opts["--no-passwords"] and not sys.stdout.isatty():
        raise Refusal("bootstrap: stdout is not a terminal. It prints a password only to a "
                      "terminal, so that no transcript, log or pipe holds one: run it from your "
                      "shell, or pass --no-passwords for roles that need none")
    cfg = load_config()
    if _register_store_named_sqlite(cfg):
        raise Refusal(f"bootstrap: {cfg['path']} names store=sqlite: the register is shared "
                      f"by workstations, and SQLite is one disk")
    schema = cfg.get("register_schema") or REGISTER_TEMPLATE_SCHEMA
    if not SCHEMA_NAME_RE.match(schema):
        raise Refusal("register_schema= is not a plain lower-case SQL identifier "
                      "([a-z_][a-z0-9_]{0,62})")
    if schema.startswith("pg_") or schema in ("lanes_index", cfg.get("schema") or "lanes_index"):
        raise Refusal(f"bootstrap: register_schema={schema} is the index half's schema or a "
                      f"name PostgreSQL reserves; the register takes a schema of its own")
    migrations, rest = _register_rendered(schema)
    workstation = ""
    if not roles_only:
        workstation = _register_workstation()
        _register_migration_variables(opts["--repository"], opts["--label"], opts["--lane"],
                                      workstation)

    probe = _register_probe(service, schema)
    who, database = probe["user"], probe["database"]
    if not probe["create_roles"]:
        raise Refusal(f"bootstrap: the admin {who} may not create roles: it has neither "
                      f"CREATEROLE nor SUPERUSER")
    if not probe["create_schemas"]:
        raise Refusal(f"bootstrap: the admin {who} may not create schemas in the database "
                      f"{database}")
    if not probe["owns"]:
        raise Refusal(f"bootstrap: the admin {who} does not own the database {database} "
                      f"(pg_has_role(current_user, datdba, 'USAGE') is false), where the "
                      f"database-level REVOKE and GRANT would only warn (design.md §1.4). Run "
                      f"it through a service that names a database its admin owns")
    _register_refuse_scope(_register_scope_faults(probe["scope"], "before"))
    if not isinstance(database, str) or not database.strip() or any(
            ord(ch) < 0x20 or ord(ch) == 0x7F for ch in database):
        raise Refusal("bootstrap: the database's name is empty or holds a control character")

    state = None
    if probe["schema"] is not None and not roles_only:
        if not all(probe["schema"]):
            raise Refusal(f"bootstrap: the schema {schema} exists and is not a register this "
                          f"tool made: it lacks schema_version, register_switch or "
                          f"register_head. Name another register_schema=, or drop it")
        state = _register_state(service, schema)
    plan = [] if roles_only else register_migration_plan(
        None if state is None else state["version"])
    primary = state is not None and state["mode"] == "primary"

    names = register_role_names()
    grant = _register_role_block_parts()[1]
    granted = re.match(r"GRANT ([a-z_][a-z0-9_]*(?:, [a-z_][a-z0-9_]*)*) TO CURRENT_USER", grant)
    if not granted or _REGISTER_INDEXER not in names:
        raise RuntimeError("the register's role block's GRANT, or its indexer, is not as built")
    grant_line = (f"the admin {who}'s membership of {granted.group(1).replace(', ', ' and ')}, "
                  f"WITH INHERIT TRUE, SET TRUE")
    db_lines = [f"database {database}, REVOKE ALL FROM PUBLIC",
                f"database {database}, GRANT CONNECT to {names[1]}, {names[2]} and "
                f"{_REGISTER_INDEXER}",
                f"default privileges of {names[0]}, REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC"]
    db_states = [probe["states"][key] for key in ("public", "connect", "defaults")]

    if primary:
        missing = [f"role {role}" for role in names if role not in probe["roles"]]
        if not probe["states"]["grant"]:
            missing.append(grant_line)
        missing += [line for line, done in zip(db_lines, db_states) if not done]
        if missing:
            raise Refusal("bootstrap: the switch is at primary, so it changes nothing but a "
                          "pending migration (operations.md:434), and these are not in place: "
                          + "; ".join(missing) + ". Run bootstrap --roles-only first")
        _register_refuse_scope(_register_scope_faults(probe["scope"], "all"))
        for role in names:
            _bootstrap_say(f"role {role}", False)
        _bootstrap_say(grant_line, False)
    else:
        creating = [role for role in names if role not in probe["roles"]]
        password = ""
        extra = ""
        if _REGISTER_INDEXER in creating and not opts["--no-passwords"]:
            import secrets
            password = secrets.token_urlsafe(32)
            extra = (f"ALTER ROLE {_REGISTER_INDEXER} PASSWORD "
                     f"{_pg_quote(register_scram_verifier(password))};\n")

        def run_roles(script: str, variables: dict) -> None:
            _register_admin_psql(service, script + extra, variables, single_transaction=True)

        created = apply_register_roles(run_roles, probe["roles"])
        for role in names:
            _bootstrap_say(f"role {role}", role in created)
        _bootstrap_say(grant_line, not probe["states"]["grant"])
        if password:
            say(f"# {_REGISTER_INDEXER}'s password-file line, printed once: put it alone in a "
                f"0600 file, and name that file in passfile=")
            say(_register_pgpass_line(database, _REGISTER_INDEXER, password))
            sys.stdout.flush()

    if roles_only:
        _register_admin_psql(service, "".join(_register_roles_only_parts()), {"db": database},
                             single_transaction=True)
        after = _register_confirm(service, schema)
        unmet = [line for line, done in zip(db_lines, (after["states"][key] for key in
                                                        ("public", "connect", "defaults")))
                 if not done]
        if unmet or not after["states"]["grant"]:
            raise Refusal("bootstrap --roles-only: after its statements these are still not in "
                          "place: " + "; ".join(unmet + ([] if after["states"]["grant"]
                                                         else [grant_line])))
        _register_refuse_scope(_register_scope_faults(after["scope"], "roles-only"))
        for line, done in zip(db_lines, db_states):
            _bootstrap_say(line, not done)
        return EXIT_OK

    rendered_digests: dict[int, str] = {}

    def run_migration(script: str, variables: dict) -> None:
        text = migrations.get(script)
        if text is None:
            raise RuntimeError("a migration this build does not ship was to be sent")
        version = next(v for v, t in REGISTER_MIGRATIONS.items() if t == script)
        rendered_digests[version] = hashlib.sha256(text.encode("utf-8")).hexdigest()
        _register_admin_psql(service, text, variables, single_transaction=False)

    applied = apply_register_migrations(
        run_migration, None if state is None else state["version"],
        repository=opts["--repository"], label=opts["--label"], lane=opts["--lane"],
        workstation=workstation) if plan else []
    if applied and applied[0][0] == 1:
        _bootstrap_say(f"schema {schema}", True, f"version {REGISTER_SCHEMA_VERSION}")
    elif applied:
        say(f"schema {schema}: migrated (version {state['version']} to "
            f"{REGISTER_SCHEMA_VERSION})")
    else:
        _bootstrap_say(f"schema {schema}", False, f"version {state['version']}")
    for version, digest in applied:
        _bootstrap_say(f"migration {version}", True,
                       f"script_sha256 {digest}, rendered sha256 {rendered_digests[version]}")
    if state is None:
        _bootstrap_say("switch", True, f"mode files, marker absent, label {opts['--label']}, "
                                       f"set_seq -1, a new generation")
        _bootstrap_say("head", True, "seq -1")
    else:
        _bootstrap_say("switch", False, f"mode {state['mode']}, marker {state['marker']}, "
                                        f"label {state['label']}, set_seq {state['set_seq']}")
        _bootstrap_say("head", False, f"seq {state['head']}")

    if not primary:
        def run_grants(script: str, variables: dict) -> None:
            if script != _register_role_block_parts()[2]:
                raise RuntimeError("the role block's second part was not the one rendered")
            _register_admin_psql(service, rest, variables, single_transaction=True)

        apply_register_grants(run_grants, database=database)
    after = _register_confirm(service, schema)
    unmet = [line for line, done in zip(db_lines, (after["states"][key] for key in
                                                    ("public", "connect", "defaults")))
             if not done]
    if unmet or not after["states"]["grant"]:
        raise Refusal("bootstrap: after its statements these are still not in place: "
                      + "; ".join(unmet + ([] if after["states"]["grant"] else [grant_line])))
    _register_refuse_scope(_register_scope_faults(after["scope"], "all"))
    for line, done in zip(db_lines, db_states):
        _bootstrap_say(line, not done)
    _bootstrap_say(f"privileges in the schemas {schema} and lanes_index",
                   after["fingerprint"] != probe["fingerprint"])

    say("# lanes-index.conf lines for this database, with no secret:")
    if primary:
        label = opts["--label"]
        if label != state["label"]:
            note(f"the switch is at primary and names {state['label']}; bootstrap writes no "
                 f"label. register_label={label} is for a restored backup's replacement, whose "
                 f"cutover --after-loss sets it; for the live database, keep {state['label']}")
        else:
            note(f"the switch is at primary and names {label}: if this is a restored backup, "
                 f"its replacement needs a label of its own (N4)")
    else:
        say("mode=index")
        label = state["label"] if state is not None else opts["--label"]
        if state is not None and opts["--label"] != state["label"]:
            note(f"the switch already names {state['label']}, so --label {opts['--label']} is "
                 f"not written; register_label= is the switch's label")
    say(f"register_label={label}")
    if schema != REGISTER_TEMPLATE_SCHEMA:
        say(f"register_schema={schema}")
    return EXIT_OK


# `LANES-INDEX LOGIN` (operations.md §2.4, "lanes-index login"; FR-009, FR-054;
# T110). Brett's command for each engineer's two logins and the dump job's one
# (design.md §1.4, "One engineer's logins"; Brett's "Two logins each
# (Recommended)", #165 6723413756), run from his own shell after the bootstrap,
# through the admin service as the bootstrap connects, under §2.4's four rules:
#   - `add <engineer>` makes `lanes_w_<engineer>`, a member of REGISTER-WRITER,
#     and `lanes_r_<engineer>`, a member of READER, each with its group's
#     floors and a password it generates. It prints, once, their two
#     password-file lines, then the `register_url=` and `reader_url=` lines for
#     that engineer's file. Run again, it changes nothing but a lost
#     membership, which it puts back;
#   - `add --dump-job` makes `lanes_register_dump` alone, §1.4's second half
#     with `r=lanes_register_dump`, whose password Brett stores as the Key
#     Vault secret the dump CronJob reads;
#   - `rotate <engineer>` sets new passwords for both logins, and `rotate
#     --dump-job` for `lanes_register_dump` alone (lane 3's ruling,
#     #165 6726725691), and prints the new password-file lines;
#   - `revoke <engineer>`, for each of the two logins in turn, the writer's
#     first, runs §1.4's revoke and prints each step's result.
#
# ONE TRANSACTION A STEP, AND Y'S BYTES UNCHANGED (as T108 and T109). The login
# step is one `--single-transaction` call: Y:2288-2300, or its second half alone
# for the dump job, less the CREATE ROLE of each login that exists already (the
# `pg_roles` guard, which is outside Y's bytes), then one `ALTER ROLE ...
# PASSWORD '<verifier>'` for each login it creates, so each password is set in
# the transaction that makes its login. The revoke's three numbered steps are
# three such calls per login, each committed before the next, so their effects
# come in Y's order: no new session (28000), then an open session's next
# statement refused (42501), then its sessions ended (57P01), with step 3's
# grant to the admin never outliving that step. Joined, one login's three
# scripts are Y:2302-2309 byte for byte. A rotation is `ALTER ROLE ... PASSWORD`
# with a new verifier (Y:2312), both of an engineer's logins in one call.
#
# THE SECRET (operations.md:481; P20). `add` and `rotate` make passwords, so
# they refuse when stdout is not a terminal, before any connection; `revoke`
# prints none and does not. Each password is generated here, sent only as a
# SCRAM-SHA-256 verifier in the script on psql's stdin, and printed once, as a
# password-file line, after its step has committed.
#
# THE URL LINES (Y:2326; contracts/config.md §3.1). The bootstrap gives `login`
# no endpoint, and `login` guesses none: the host and port are those psql
# connected to, its own `:HOST` and `:PORT`, and the database is the one the
# admin connection reached, which on the install name `<endpoint>`, as the
# admin's own service does (Y:2324). Each line carries `sslmode=verify-full` and
# an `sslrootcert=` that `--sslrootcert <path>` fills, or that reads `<root
# file>` for the engineer to fill. No URL carries a password.

#: Design.md §1.4's login step and revoke, verbatim (Y:2288-2309). The login
#: step's psql variables are `w` and `r`, the revoke's `login` and `grp`.
_REGISTER_LOGIN_BLOCK = r"""-- lanes-index login add <engineer>: psql -v w=lanes_w_<engineer> -v r=lanes_r_<engineer>.
-- The dump job's login is the second half alone, with r=lanes_register_dump. Each CREATE ROLE
-- is guarded by a pg_roles check, as the bootstrap's are.
CREATE ROLE :"w" LOGIN;                         -- its password: a SCRAM verifier, set as it is made
GRANT lanes_register_writer TO :"w";            -- again on a rerun: puts back a lost membership
ALTER ROLE :"w" SET lock_timeout = '2000ms';    -- the writer's floors, the login's own (§1.3)
ALTER ROLE :"w" SET statement_timeout = '5s';
ALTER ROLE :"w" SET idle_in_transaction_session_timeout = '5s';
CREATE ROLE :"r" LOGIN;
GRANT lanes_register_reader TO :"r";
ALTER ROLE :"r" SET default_transaction_read_only = on;   -- the reader's floors
ALTER ROLE :"r" SET lock_timeout = '1000ms';
ALTER ROLE :"r" SET statement_timeout = '1500ms';

-- lanes-index login revoke <engineer>: for each of its logins, psql -v login=… -v grp=…
ALTER ROLE :"login" NOLOGIN;                                  -- 1. no new session (28000)
REVOKE :"grp" FROM :"login";                                  -- 2. an open session's next statement
                                                              --    is refused (42501)
GRANT :"login" TO CURRENT_USER WITH INHERIT TRUE, SET FALSE;  -- 3. its privileges, so the admin may
SELECT pg_terminate_backend(pid) FROM pg_stat_activity        --    end its sessions (57P01) with no
  WHERE usename = :'login';                                   --    pg_signal_backend
REVOKE :"login" FROM CURRENT_USER;
"""

#: The dump job's login, a READER login alone (design.md §1.4's roles table;
#: operations.md act 3's step 1).
_REGISTER_DUMP_LOGIN = "lanes_register_dump"

#: An engineer's name (operations.md:487), matched whole.
_REGISTER_ENGINEER_RE = re.compile(r"[a-z][a-z0-9_]{0,40}")

#: An `--sslrootcert` path: absolute, and of characters a URL's query carries
#: as they are, so the line needs no escaping.
_REGISTER_ROOT_FILE_RE = re.compile(r"/[A-Za-z0-9._/-]*")

#: The login step's units: a login's CREATE ROLE, its group's GRANT and each of
#: its floors, each one line with its comment.
_REGISTER_LOGIN_CREATE_RE = re.compile(r'CREATE ROLE :"([wr])" LOGIN;[ \t]*(?:--[^\n]*)?\n')
_REGISTER_LOGIN_GRANT_RE = re.compile(
    r'GRANT ([a-z_][a-z0-9_]*) TO :"([wr])";[ \t]*(?:--[^\n]*)?\n')
_REGISTER_LOGIN_FLOOR_RE = re.compile(
    r"ALTER ROLE :\"([wr])\" SET ([a-z_]+) = '?([A-Za-z0-9]+)'?;[ \t]*(?:--[^\n]*)?\n")

_LOGIN_USAGE = f"""\
{PROG} login add <engineer> --admin-service <service> [--sslrootcert <path>]
{PROG} login add --dump-job --admin-service <service>
{PROG} login rotate <engineer> --admin-service <service>
{PROG} login rotate --dump-job --admin-service <service>
{PROG} login revoke <engineer> --admin-service <service>

Makes, re-keys or revokes an engineer's two logins on the SQL register,
lanes_w_<engineer> (REGISTER-WRITER) and lanes_r_<engineer> (READER), each with
its group's floors, or the dump job's lanes_register_dump (READER), through the
libpq service <service> in your own ~/.pg_service.conf, as bootstrap connects
(operations.md §2.4). Run it from your shell, after bootstrap: add and rotate
print each new password once, as a password-file line, only to a terminal, and
send it to the database only as a SCRAM verifier computed here.

  add          makes the logins; run again, it puts back a lost membership and
               changes nothing else. With an engineer, it also prints the
               register_url= and reader_url= lines for that engineer's file, at
               the host, port and database the admin connection reached
  rotate       a new password for each login; a session already open goes on
  revoke       for each login, the writer's first: NOLOGIN, its membership
               revoked, then its sessions ended, each step's result printed
  <engineer>   [a-z][a-z0-9_]{{0,40}}
  --dump-job   lanes_register_dump alone; store its password as the Key Vault
               secret the dump CronJob reads
  --sslrootcert <path>
               the root file on the engineer's host, for add's URL lines;
               without it they read sslrootcert=<root file>

Exit: 0 done · 2 refused, nothing written · 64 usage · 69 the admin connection
failed, or the database refused a step."""


def _register_login_parts() -> dict:
    """§1.4'S LOGIN BLOCK, CUT. Returns, each the block's own text:
      - `head`: the login step's comment lines;
      - `halves`: for `w` and `r`, that half's units in the block's order, its
        CREATE ROLE first;
      - `groups`: the group each half's GRANT names;
      - `floors`: each half's `ALTER ROLE ... SET`s, as `name=value`, the form
        `pg_roles.rolconfig` holds;
      - `revoke`: the revoke's three steps, the first with the revoke's comment
        line, so that joined they are the revoke whole.
    A block that does not cut so is a defect of this build, so the error is
    not a refusal."""
    step, blank, revoke = _REGISTER_LOGIN_BLOCK.partition("\n\n")
    if not blank or "\n\n" in revoke or not revoke.endswith("\n"):
        raise RuntimeError("the register's login block is not the login step, one blank "
                           "line, then the revoke")
    units = _register_sql_units(step + "\n")
    head = []
    while units and units[0].startswith("--"):
        head.append(units.pop(0))
    halves: dict[str, list[str]] = {"w": [], "r": []}
    groups: dict[str, str] = {}
    floors: dict[str, list[str]] = {"w": [], "r": []}
    order: list[str] = []
    for unit in units:
        create = _REGISTER_LOGIN_CREATE_RE.fullmatch(unit)
        grant = _REGISTER_LOGIN_GRANT_RE.fullmatch(unit)
        floor = _REGISTER_LOGIN_FLOOR_RE.fullmatch(unit)
        if create:
            half = create.group(1)
            if halves[half]:
                raise RuntimeError(f"the login block's half {half} does not open with its "
                                   f"CREATE ROLE")
        elif grant:
            half = grant.group(2)
            if half in groups:
                raise RuntimeError(f"the login block's half {half} grants two groups")
            groups[half] = grant.group(1)
        elif floor:
            half = floor.group(1)
            floors[half].append(f"{floor.group(2)}={floor.group(3)}")
        else:
            raise RuntimeError(f"the login block holds {unit!r}, which is not a CREATE ROLE, "
                               f"a GRANT or a floor")
        if not halves[half] and not create:
            raise RuntimeError(f"the login block's half {half} does not open with its "
                               f"CREATE ROLE")
        if not order or order[-1] != half:
            order.append(half)
        halves[half].append(unit)
    roles = register_role_names()
    if (len(head) != 3 or order != ["w", "r"] or not floors["w"] or not floors["r"]
            or groups != {"w": roles[1], "r": roles[2]}):
        raise RuntimeError(f"the login block is not three comment lines, the writer's half, "
                           f"then the reader's, each granting its group: {order}, {groups}")
    steps = _register_sql_units(revoke)
    if (len(steps) != 6 or not steps[0].startswith("--")
            or not steps[1].startswith('ALTER ROLE :"login" NOLOGIN;')
            or not steps[2].startswith('REVOKE :"grp" FROM :"login";')
            or not steps[3].startswith('GRANT :"login" TO CURRENT_USER WITH INHERIT TRUE, SET FALSE;')
            or "pg_terminate_backend(pid)" not in steps[4]
            or not steps[5].startswith('REVOKE :"login" FROM CURRENT_USER;')):
        raise RuntimeError("the login block's revoke is not its comment, NOLOGIN, the "
                           "membership revoked, then the grant, the end of its sessions and "
                           "the grant revoked")
    revoke_steps = ["".join(steps[:2]), steps[2], "".join(steps[3:])]
    if "".join(revoke_steps) != revoke:
        raise RuntimeError("the login block's revoke does not cut into three steps")
    return {"head": "".join(head), "halves": halves, "groups": groups, "floors": floors,
            "revoke": revoke_steps}


def register_login_script(halves: list[str], existing, verifiers: dict) -> str:
    """THE LOGIN STEP AS SENT, one script for one `--single-transaction` call.

    `halves` is `["w", "r"]` for an engineer, or `["r"]` for the dump job, §1.4's
    "second half alone". `existing` holds the halves whose login exists
    already: their CREATE ROLE is left out, the `pg_roles` guard. `verifiers`
    maps each half whose login this step creates to the SCRAM verifier of its
    new password; each goes as one `ALTER ROLE :"<half>" PASSWORD
    '<verifier>';` after the block's text. Every other line is the block's own
    text, byte for byte, comments and all; for an engineer whose logins are
    both new, the script opens with Y:2288-2300 whole."""
    parts = _register_login_parts()
    if halves not in (["w", "r"], ["r"]):
        raise ValueError(f"the login step's halves are ['w', 'r'] or ['r'], not {halves!r}")
    if set(verifiers) - (set(halves) - set(existing)):
        raise ValueError("a verifier was given for a login this step does not create")
    text = parts["head"] if halves == ["w", "r"] else ""
    for half in halves:
        units = parts["halves"][half]
        text += "".join(units[1:] if half in existing else units)
    for half in halves:
        if half in verifiers:
            text += f'ALTER ROLE :"{half}" PASSWORD {_pg_quote(verifiers[half])};\n'
    return text


def _register_login_query(login: str, group: str) -> str:
    """One login's state, as one row or none: its name, whether it may log in,
    whether it is a member of `group`, and its own settings, one per line."""
    return ("SELECT a.rolname::text, a.rolcanlogin, EXISTS (SELECT 1 FROM "
            "pg_catalog.pg_auth_members m JOIN pg_catalog.pg_roles g ON g.oid = m.roleid "
            f"WHERE m.member = a.oid AND g.rolname = {_pg_quote(group)}), "
            "coalesce(pg_catalog.array_to_string(a.rolconfig, chr(10)), '') "
            f"FROM pg_catalog.pg_roles a WHERE a.rolname = {_pg_quote(login)}")


def _register_login_probe(service: str, logins: list[tuple[str, str]], *, url: bool) -> dict:
    """THE LOGIN'S FIRST READ, through the admin service, before anything is
    written: who the admin is and what it may do, which of the two groups
    exist, and each login's state. With `url`, also the host and port psql
    connected to, psql's own `:HOST` and `:PORT`, which psql fills in."""
    groups = _register_login_parts()["groups"]
    queries = [_register_admin_query(),
               f"SELECT rolname::text FROM pg_catalog.pg_roles WHERE rolname IN "
               f"({_register_names_sql([groups['w'], groups['r']])})"]
    queries += [_register_login_query(login, groups[half]) for login, half in logins]
    if url:
        queries.append("SELECT :'HOST', :'PORT'")
    res = _register_reads(service, "probe", queries, command="login")
    admin = _register_one_row(res[0], 6, "the admin")
    states: dict[str, dict] = {}
    for (login, _half), rows in zip(logins, res[2:2 + len(logins)]):
        if len(rows) > 1 or (rows and len(rows[0]) != 4):
            raise RegisterUnavailable(f"psql answered {len(rows)} rows for the login {login}")
        if rows:
            states[login] = {"can_login": _register_flag(rows[0][1]),
                             "member": _register_flag(rows[0][2]),
                             "settings": set((rows[0][3] or "").split("\n")) - {""}}
    probe = {"user": admin[0], "database": admin[1], "create_roles": _register_flag(admin[2]),
             "owns": _register_flag(admin[4]), "groups": {row[0] for row in res[1] if row},
             "logins": states}
    if url:
        probe["host"], probe["port"] = _register_one_row(
            res[-1], 2, "the admin connection's host and port")
    return probe


def register_login_url(login: str, host: str, port: str, database: str,
                       root_file: str | None) -> str:
    """ONE OF AN ENGINEER'S URL LINES' VALUES, in Y's form (Y:2326):
    `postgresql://<login>@<host>:<port>/<database>?sslmode=verify-full&sslrootcert=<root>`,
    at the host, port and database the admin connection reached. A socket
    directory is percent-encoded whole, an IPv6 address bracketed. No
    password: the login's line goes in its own 0600 file."""
    from urllib.parse import quote
    if not isinstance(port, str) or not re.fullmatch(r"[0-9]{1,5}", port):
        raise RegisterUnavailable(f"psql answered the port {port!r}")
    host = host or ""
    if ":" in host and not host.startswith("/"):
        where = "[" + quote(host, safe=":") + "]"
    else:
        where = quote(host, safe="")
    return (f"postgresql://{login}@{where}:{port}/{quote(database, safe='')}"
            f"?sslmode=verify-full&sslrootcert={root_file or '<root file>'}")


def _register_login_args(args: list[str]) -> dict | None:
    """`login`'s command line; None for `--help`. First, no argument may carry
    a connection string or a password, wherever it stands (2, never echoed);
    then its usage (64); then its values (2)."""
    for arg in args:
        value = arg.partition("=")[2] if arg.startswith("--") and "=" in arg else arg
        _register_refuse_argument("an argument", value, command="login")
    opts: dict = {"--admin-service": None, "--sslrootcert": None, "--dump-job": False}
    words: list[str] = []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-h", "--help"):
            return None
        name, eq, value = arg.partition("=")
        if name in ("--admin-service", "--sslrootcert"):
            if not eq:
                value = args[i + 1] if i + 1 < len(args) else ""
                i += 1
            if not value:
                raise _RegisterUsage(f"login: {name} needs a value")
            if opts[name] is not None:
                raise _RegisterUsage(f"login: {name} is given twice")
            opts[name] = value
        elif arg == "--dump-job":
            if opts["--dump-job"]:
                raise _RegisterUsage("login: --dump-job is given twice")
            opts["--dump-job"] = True
        elif arg.startswith("-"):
            raise _RegisterUsage(f"login: unknown option {name}")
        else:
            words.append(arg)
        i += 1
    if not words or words[0] not in ("add", "rotate", "revoke"):
        raise _RegisterUsage("login needs add, rotate or revoke")
    action, rest = words[0], words[1:]
    if len(rest) > 1:
        raise _RegisterUsage(f"login {action} takes one engineer")
    engineer = rest[0] if rest else None
    dump = opts["--dump-job"]
    if action == "revoke" and dump:
        raise _RegisterUsage("login revoke takes an engineer; the dump job's login is "
                             "rotated, never revoked, by this command")
    if action == "revoke" and engineer is None:
        raise _RegisterUsage("login revoke needs an engineer")
    if (engineer is None) == (not dump):
        raise _RegisterUsage(f"login {action} needs an engineer or --dump-job, and not both")
    if opts["--sslrootcert"] is not None and (action != "add" or dump):
        raise _RegisterUsage("login: --sslrootcert is for the URL lines of login add "
                             "<engineer>")
    if opts["--admin-service"] is None:
        raise _RegisterUsage("login needs --admin-service <service>")
    if engineer is not None and not _REGISTER_ENGINEER_RE.fullmatch(engineer):
        raise Refusal("login: the engineer's name is not ^[a-z][a-z0-9_]{0,40}$: a lower-case "
                      "letter, then up to 40 lower-case letters, digits or '_'")
    _register_refuse_argument("--admin-service", opts["--admin-service"], command="login")
    root = opts["--sslrootcert"]
    if root is not None and (root == "system" or not _REGISTER_ROOT_FILE_RE.fullmatch(root)):
        raise Refusal("login: --sslrootcert is not an absolute path of letters, digits, '.', "
                      "'_', '-' and '/'. It names the root file on the engineer's host, never "
                      "`system`, which holds no private root (design.md §1.4, Y:2324)")
    return {"action": action, "engineer": engineer, "dump": dump,
            "service": opts["--admin-service"], "root": root}


def cmd_login(args: list[str]) -> int:
    """`lanes-index login` (operations.md §2.4): its exits, by the contract's
    constants."""
    try:
        opts = _register_login_args(args)
    except _RegisterUsage as exc:
        note(f"{exc} - see {PROG} login --help")
        return EXIT_USAGE
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return EXIT_REFUSED
    if opts is None:
        say(_LOGIN_USAGE)
        return EXIT_OK
    try:
        return _login(opts)
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return EXIT_REFUSED
    except RegisterUnavailable as exc:
        hint = {"add": " A step cut at its commit may have made a login: `login add` again "
                       "names what it finds, and `login rotate` gives such a login a password "
                       "you hold.",
                "rotate": " A step cut at its commit may have changed the passwords: run "
                          "`login rotate` again.",
                "revoke": " Each step printed above stands; run `login revoke` again to "
                          "finish."}[opts["action"]] if opts.get("sent") else " Nothing was sent."
        note(f"login {opts['action']}: the admin connection failed, or the database refused "
             f"a step: {exc}.{hint}")
        return EXIT_UNAVAILABLE


def _login(opts: dict) -> int:
    action, engineer, dump, service = (opts["action"], opts["engineer"], opts["dump"],
                                       opts["service"])
    if action in ("add", "rotate") and not sys.stdout.isatty():
        raise Refusal(f"login {action}: stdout is not a terminal. It prints a password only "
                      f"to a terminal, so that no transcript, log or pipe holds one: run it "
                      f"from your shell")
    load_config()
    parts = _register_login_parts()
    groups = parts["groups"]
    if dump:
        logins = [(_REGISTER_DUMP_LOGIN, "r")]
    else:
        logins = [(f"lanes_w_{engineer}", "w"), (f"lanes_r_{engineer}", "r")]
    probe = _register_login_probe(service, logins, url=(action == "add" and not dump))
    who, database = probe["user"], probe["database"]
    if not probe["create_roles"]:
        raise Refusal(f"login {action}: the admin {who} may not create or alter roles: it has "
                      f"neither CREATEROLE nor SUPERUSER")
    if not isinstance(database, str) or not database.strip() or any(
            ord(ch) < 0x20 or ord(ch) == 0x7F for ch in database):
        raise Refusal(f"login {action}: the database's name is empty or holds a control "
                      f"character")
    states = probe["logins"]
    if action == "revoke":
        return _login_revoke(service, parts, logins, probe, opts)
    for login, _half in logins:
        state = states.get(login)
        if action == "rotate" and state is None:
            raise Refusal(f"login rotate: {login} does not exist; `login add` makes it")
        if state is not None and not state["can_login"]:
            raise Refusal(f"login {action}: {login} exists and cannot log in: it was revoked, "
                          f"and a revoked login's name is not reused while the server's logs "
                          f"still name it (design.md §1.4). "
                          + ("Give the engineer another name, or drop the role first"
                             if action == "add" else "A revoked login takes no new password"))
    if action == "add":
        missing = [groups[half] for _login_name, half in logins
                   if groups[half] not in probe["groups"]]
        if missing:
            raise Refusal(f"login add: {' and '.join(missing)} "
                          f"{'do' if len(missing) > 1 else 'does'} not exist: run bootstrap, "
                          f"or bootstrap --roles-only, first")
    if not probe["owns"]:
        note(f"login {action}: the admin {who} does not own the database {database}, which "
             f"the lines below name. If it is not the register's database, run it again "
             f"through the service that names that one")
    import secrets
    creating = [(login, half) for login, half in logins
                if action == "rotate" or states.get(login) is None]
    passwords = {login: secrets.token_urlsafe(32) for login, _half in creating}
    verifiers = {half: register_scram_verifier(passwords[login]) for login, half in creating}
    variables = {half: login for login, half in logins}
    if action == "add":
        script = register_login_script([half for _login_name, half in logins],
                                       {half for login, half in logins if login in states},
                                       verifiers)
    else:
        script = "".join(f'ALTER ROLE :"{half}" PASSWORD {_pg_quote(verifiers[half])};\n'
                         for _login_name, half in logins)
    opts["sent"] = True
    _register_admin_psql(service, script, variables, single_transaction=True)

    if action == "add":
        for login, half in logins:
            state = states.get(login)
            _bootstrap_say(f"login {login}", state is None,
                           "LOGIN, its password a SCRAM verifier set as it was made"
                           if state is None else "")
            _bootstrap_say(f"login {login}'s membership of {groups[half]}",
                           state is None or not state["member"],
                           "put back" if state is not None and not state["member"] else "")
            lacking = [f for f in parts["floors"][half]
                       if state is None or f not in state["settings"]]
            _bootstrap_say(f"login {login}'s floors", bool(lacking),
                           ("put back: " if state is not None and lacking else "")
                           + ", ".join(lacking or parts["floors"][half]))
    else:
        for login, _half in logins:
            say(f"login {login}'s password: changed (a new SCRAM verifier; a session already "
                f"open goes on until it ends)")
    for login, half in creating:
        if dump:
            say(f"# {login}'s password-file line, printed once: store it as the Key Vault "
                f"secret the dump CronJob reads (its password is the line's last field)")
        else:
            key = "register_passfile=" if half == "w" else "reader_passfile="
            say(f"# {login}'s password-file line, printed once: put it alone in a 0600 file "
                f"of {engineer}'s account, and name that file in {key}")
        say(_register_pgpass_line(database, login, passwords[login]))
    sys.stdout.flush()
    if action == "add" and not creating:
        say(f"# no password line: {' and '.join(login for login, _half in logins)} existed "
            f"already. `{PROG} login rotate {'--dump-job' if dump else engineer}` gives "
            f"{'it a new one' if dump else 'them new ones'}")
    if action == "rotate" and not dump:
        say(f"# until {engineer}'s two password files hold these lines, that workstation's "
            f"new connections fail at login (69): write them before its lanes resume")
    if action == "add" and not dump:
        say(f"# lanes-index.conf lines for {engineer}'s file, with no secret; sslrootcert= "
            f"names the root file on {engineer}'s host:")
        for login, key in ((logins[0][0], "register_url="), (logins[1][0], "reader_url=")):
            say(key + register_login_url(login, probe["host"], probe["port"], database,
                                         opts["root"]))
    return EXIT_OK


def _login_revoke(service: str, parts: dict, logins: list[tuple[str, str]],
                  probe: dict, opts: dict) -> int:
    """§1.4'S REVOKE (Y:2302-2309; operations.md §2.4's `revoke`), for each of
    the engineer's logins in turn, the writer's first: its three steps, each
    one `--single-transaction` call that commits before the next, each step's
    result printed as it ends. A login that does not exist is said so; where
    neither does, nothing is revoked (2)."""
    states, groups = probe["logins"], parts["groups"]
    present = [(login, half) for login, half in logins if login in states]
    if not present:
        raise Refusal(f"login revoke: neither {logins[0][0]} nor {logins[1][0]} exists, so "
                      f"there is nothing to revoke; check the engineer's name")
    missing = [groups[half] for _login, half in present if groups[half] not in probe["groups"]]
    if missing:
        raise Refusal(f"login revoke: {' and '.join(missing)} "
                      f"{'do' if len(missing) > 1 else 'does'} not exist, so no membership of "
                      f"{'them' if len(missing) > 1 else 'it'} can be revoked; nothing was "
                      f"revoked")
    nologin, revoke_group, end_sessions = parts["revoke"]
    for login, half in logins:
        state = states.get(login)
        if state is None:
            say(f"login {login}: absent, nothing to revoke")
            continue
        variables = {"login": login, "grp": groups[half]}
        opts["sent"] = True
        _register_admin_psql(service, nologin, variables, single_transaction=True)
        say(f"login {login}, step 1, NOLOGIN: "
            + ("done (a new session is refused: 28000)" if state["can_login"]
               else "unchanged (it could not log in)"))
        sys.stdout.flush()
        _register_admin_psql(service, revoke_group, variables, single_transaction=True)
        say(f"login {login}, step 2, its membership of {groups[half]} revoked: "
            + ("done (an open session's next statement is refused: 42501)" if state["member"]
               else "unchanged (it held none)"))
        sys.stdout.flush()
        out = _register_admin_psql(service, end_sessions, variables, single_transaction=True)
        answers = [line.strip() for line in out.splitlines() if line.strip() in ("t", "f")]
        ended, gone = answers.count("t"), answers.count("f")
        say(f"login {login}, step 3, its sessions ended: {ended} ended (57P01)"
            + (f", {gone} gone before the signal" if gone else "")
            + f"; the admin held {login}'s privileges for this step alone")
        sys.stdout.flush()
    return EXIT_OK


# ============================================================ local status

def _status_path() -> str:
    return os.path.join(state_dir(), "lanes-index.status.json")


def read_status() -> dict:
    try:
        with open(_status_path(), encoding="utf-8") as handle:
            data = json.load(handle)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def write_status(source: str, **fields) -> None:
    """This workstation's own record of its last attempt, which the store
    cannot hold for an attempt that could not reach it."""
    try:
        os.makedirs(state_dir(), mode=0o700, exist_ok=True)
        data = read_status()
        entry = data.get(source, {})
        entry.update(fields)
        data[source] = entry
        tmp = _status_path() + f".{os.getpid()}"
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(data, handle, indent=1, sort_keys=True)
        os.chmod(tmp, 0o600)
        os.replace(tmp, _status_path())
    except OSError:
        pass


class SyncLock:
    """ONE SYNC AT A TIME PER WORKSTATION (14(d)). A second sync that finds the
    lock held leaves a RERUN mark and returns at once - the holder syncs again
    before it lets go - so a burst of writes is one or two syncs, never a
    queue of them, and no nudge ever waits."""

    def __init__(self):
        self.path = os.path.join(state_dir(), "lanes-index.lock")
        self.rerun = os.path.join(state_dir(), "lanes-index.rerun")
        self.handle = None

    def acquire(self, wait_seconds: float) -> bool:
        try:
            import fcntl
        except ImportError:
            return True
        os.makedirs(state_dir(), mode=0o700, exist_ok=True)
        self.handle = open(self.path, "a+")
        try:
            os.chmod(self.path, 0o600)
        except OSError:
            pass
        deadline = time.monotonic() + wait_seconds
        while True:
            try:
                fcntl.flock(self.handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                return True
            except OSError:
                if time.monotonic() >= deadline:
                    self.handle.close()
                    self.handle = None
                    return False
                time.sleep(0.2)

    # ONE MARK PER SOURCE (opensoft/openRepoTools#161). The holder syncs again
    # for every mark it finds, and a mark says WHICH source asked: a register
    # sync holding the lock when an inventory write's nudge arrives syncs the
    # inventory before it lets go, rather than the register a second time. The
    # register's mark keeps the name it has always had.
    KINDS = ("register", "inventory")

    def rerun_path(self, kind: str = "register") -> str:
        return self.rerun if kind == "register" else f"{self.rerun}-{kind}"

    def mark_rerun(self, kind: str = "register") -> None:
        try:
            with open(self.rerun_path(kind), "w", encoding="utf-8") as handle:
                handle.write(utc_now() + "\n")
        except OSError:
            pass

    def take_rerun(self, kind: str = "register") -> bool:
        try:
            os.unlink(self.rerun_path(kind))
            return True
        except OSError:
            return False

    def take_reruns(self) -> list:
        return [kind for kind in self.KINDS if self.take_rerun(kind)]

    def has_rerun(self) -> bool:
        return any(os.path.exists(self.rerun_path(kind)) for kind in self.KINDS)

    def release(self) -> None:
        if self.handle is not None:
            self.handle.close()
            self.handle = None


# ================================================================ the acts

def resolve_source(requested: str | None, root: str) -> str:
    source = source_of(root)
    if requested and requested != source:
        if is_inventory(requested):
            raise Refusal(f"{requested} is this workstation's worktree inventory, which "
                          f"`sync`/`reconcile --source inventory` write and `export "
                          f"--worktrees` reads; this is the register's path")
        if requested.startswith("ledger:"):
            raise Refusal(f"{requested} is the managed ledger's half, which T058 of the 001 "
                          f"feature writes (Amendment 14(g) act 4); this indexer writes the "
                          f"register half only")
        raise Refusal(f"this workstation's register is {source}, not {requested}")
    return source


def diff_records(store, source: str, records: dict, verify_content: bool) -> tuple:
    """The upserts and deletes that take the stored source to `records`.

    `sync` compares DIGESTS: an upsert bearing the stored digest changes
    nothing. `reconcile` recomputes each stored row's digest from its CONTENT,
    so a row somebody changed by hand - which still carries its old digest - is
    found and put right."""
    upserts, deletes, kept = {}, {}, {}
    for table in REGISTER_TABLES:
        cols = TABLE_COLUMNS[table]
        stored = {r["record_id"]: r for r in store.rows(table, source,
                                                         cols + ["digest"])}
        for rec in records[table].values():
            rec["digest"] = digest_of(table, rec)
        for rec_id, rec in records[table].items():
            old = stored.get(rec_id)
            if old is not None:
                have = digest_of(table, old) if verify_content else old["digest"]
                if have == rec["digest"] and (not verify_content or old["digest"] == rec["digest"]):
                    kept[table] = kept.get(table, 0) + 1
                    continue
            upserts.setdefault(table, {})[rec_id] = rec
        gone = [rec_id for rec_id in stored if rec_id not in records[table]]
        if gone:
            deletes[table] = gone
    return upserts, deletes, kept


def has_unknown_owner(store, source: str) -> bool:
    return any(r["owner"] == "unknown" for r in store.rows("lanes", source, ["owner"]))


def stored_lanes_of(store, source: str) -> dict:
    return {r["record_id"]: r for r in store.rows("lanes", source,
                                                   ["lane", "owner", "row_text"])}


def run_index(mode: str, requested: str | None, dry_run: bool) -> int:
    cfg = load_config()
    root = workspace_root()
    source = resolve_source(requested, root)
    tip = tip_of(root)
    store = open_store(cfg, "writer")
    if dry_run:
        try:
            store.open_read()
        except StoreUnusable as exc:
            if exc.kind not in ("missing", "wiped"):
                raise
            store = None
    else:
        store.open_write()
    old = store.provenance(source) if store is not None else None
    label = f"{source} at register@{tip[:12]} ({cfg['store']})"
    if old and old.get("commit_sha"):
        prev = old["commit_sha"]
        if not has_commit(root, prev):
            say(f"{PROG} {mode}: the index holds register@{prev[:12]}, which this checkout has "
                f"not fetched - another workstation is ahead of it; nothing written")
            write_status(source, last_attempt_utc=utc_now(), last_result="behind (unknown commit)")
            return 0
        # NOT WHILE AN OWNER IS `unknown` (Codex on #164): an `unknown` may be a
        # read that failed, and asking again is how it clears - so a sync at
        # the same commit goes the long way round, asks only those, and writes
        # nothing where nothing has changed.
        if prev == tip and mode == "sync" and not has_unknown_owner(store, source):
            say(f"{PROG} sync: {label} - the index is at the tip; nothing to write")
            write_status(source, last_attempt_utc=utc_now(), last_sync_utc=utc_now(),
                         last_result="current", last_error="")
            return 0
        if not is_ancestor(root, prev, tip):
            behind = is_ancestor(root, tip, prev)
            why = ("this checkout is BEHIND the index" if behind else
                   "the two have diverged - a register history rewritten under the index is "
                   "rebuilt by wiping the index and reconciling")
            say(f"{PROG} {mode}: register@{tip[:12]} does not descend from the indexed "
                f"register@{prev[:12]}: {why}. The provenance only moves forward "
                f"(Amendment 14(d)); nothing written")
            write_status(source, last_attempt_utc=utc_now(),
                         last_result="not a descendant; nothing written")
            return 0 if behind else 1
    snap = read_snapshot(root, tip)
    records = build_records(snap)
    if store is None:
        fill_owners(records, None)
        upserts = {t: dict(r) for t, r in records.items() if r}
        for table, recs in upserts.items():
            for rec in recs.values():
                rec["digest"] = digest_of(table, rec)
        deletes, kept = {}, {}
    else:
        stored = None if mode == "reconcile" else stored_lanes_of(store, source)
        fill_owners(records, stored)
        upserts, deletes, kept = diff_records(store, source, records,
                                              verify_content=(mode == "reconcile"))
    # THE OWNERS ARE ASKED OF `origin/<branch>` AS IT STANDS, and the rows were
    # read at ONE commit (Copilot round 1 on #164): `managed-projection` reads
    # the ref, not a sha. So the ref is asked again once every owner is in, and
    # a ref that moved meanwhile writes NOTHING - not rows of one commit beside
    # owners of another - and the caller starts over at the new tip.
    if not dry_run and tip_of(root) != tip:
        raise SourceMoved(f"origin/{branch()} moved from {tip[:12]} while the owners were "
                          f"read; nothing was written from that read")
    n_up = sum(len(v) for v in upserts.values())
    n_del = sum(len(v) for v in deletes.values())
    if mode == "reconcile":
        say(f"{PROG} reconcile: {label}{' - DRY RUN' if dry_run else ''}")
        for table in REGISTER_TABLES:
            say(f"  {table:<20} {kept.get(table, 0):>6} kept  {len(upserts.get(table, {})):>6} "
                f"upserted  {len(deletes.get(table, [])):>6} removed")
    if dry_run:
        say(f"  total: {n_up} to upsert, {n_del} to remove - nothing written (--dry-run)")
        return 0
    if old and old.get("commit_sha") == tip and not upserts and not deletes:
        if mode == "sync":
            say(f"{PROG} sync: {label} - the index is at the tip; nothing to write")
        else:
            say("  total: nothing differs; nothing written")
        write_status(source, last_attempt_utc=utc_now(), last_sync_utc=utc_now(),
                     last_result="current", last_error="")
        return 0
    store.apply(source, old, tip, upserts, deletes)
    write_status(source, last_attempt_utc=utc_now(), last_sync_utc=utc_now(),
                 last_result=f"{n_up} upserted, {n_del} removed at {tip[:12]}", last_error="")
    if mode == "sync":
        say(f"{PROG} sync: {label} - {n_up} upserted, {n_del} removed")
    else:
        say(f"  total: {n_up} upserted, {n_del} removed")
    return 0


# ======================================== the inventory (opensoft/openRepoTools#161)
#
# THIS WORKSTATION'S #97 WORKTREE INVENTORY, AS A SECOND SOURCE. Amendment 14(e)
# left "#97's lifecycle snapshots and worktree inventories, local to one
# workstation by design" to a later word; #161 is it. The source is
# `inventory:<Workstation>` - one per workstation, because the sidecars are on
# that workstation's disk and nowhere else - and its rows are what
# `lanes-edit.sh worktrees --all` prints, which is the inventory read through
# the helper that writes it. Nothing here parses a sidecar, a snapshot or an
# ownership marker, and nothing here lists a directory.

def _helper_run(args: list, timeout: float, what: str) -> subprocess.CompletedProcess:
    helper = lanes_edit_path()
    if not helper:
        raise StoreUnusable("unread", f"no lanes-edit.sh beside this file or on PATH, so {what} "
                            f"cannot be read")
    try:
        return subprocess.run([helper, *args], capture_output=True, encoding="utf-8",
                              errors="replace", check=False, env=helper_env(),
                              stdin=subprocess.DEVNULL, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise StoreUnusable("unread", f"`lanes-edit.sh {' '.join(args)}` did not answer within "
                            f"{int(timeout)} s")
    except OSError as exc:
        raise StoreUnusable("unread", f"`lanes-edit.sh {' '.join(args)}` could not be run: {exc}")


@functools.lru_cache(maxsize=None)
def this_workstation() -> tuple[str, str]:
    """`lanes-edit.sh workstation`'s first two columns: the name every row of
    this workstation is filed under, and where it came from.

    ASKED ONCE A PROCESS (the review of #219): the refusal `cmd_sync` makes
    before the lock asks it, and the sync that then takes the lock asked again
    for the same answer - one environment, one name. A read that failed raises,
    and is not kept."""
    proc = _helper_run(["workstation"], 60, "this workstation's name")
    first = (proc.stdout.splitlines() or [""])[0].split("\t")
    if proc.returncode != 0 or not first[0]:
        why = (proc.stderr.strip().splitlines() or ["no answer"])[-1]
        raise StoreUnusable("unread", f"`lanes-edit.sh workstation` exited {proc.returncode}: {why}")
    return first[0], (first[1] if len(first) > 1 else "")


def inventory_source(requested: str | None) -> str:
    """`inventory:<this workstation>`. `--source inventory` is the short name for
    it; another workstation's is refused, as another register is - its sidecars
    are on its own disk. AND A CONTAINER WITH NO NAME FILES NOTHING (Amendment
    11, `R-A11-14`): a source named for a container's own id is a source no
    restart of any workstation will ever find again."""
    name, how = this_workstation()
    if how == "container-unset":
        raise Refusal("this container has no LANES_WORKSTATION, so its inventory would be "
                      f"filed under the container's own id `{name}` - a source no restart of "
                      "any workstation finds again (Amendment 11, R-A11-14). Export "
                      "LANES_WORKSTATION, as the launcher does")
    source = f"{INVENTORY_PREFIX}{name}"
    if requested and requested not in ("inventory", source):
        raise Refusal(f"this workstation's inventory is {source}, not {requested}: an "
                      f"inventory is synced by the workstation whose disk holds it")
    return source


def _int_or_none(value: str):
    return int(value) if value.isdigit() else None


def tree_record(fields: list) -> dict:
    """One `TREE` line of `lanes-edit.sh worktrees`, as the `worktrees` row it
    is. An empty field is NULL: a count the inventory recorded as `unknown`, a
    base or a last commit that could not be read, a lane with no snapshot."""
    text = [f if f != "" else None for f in fields]
    return {"workstation": text[1], "lane": fields[2], "owner": text[3], "path": fields[4],
            "branch": text[5], "base": text[6], "lifecycle": text[7],
            "generation": _int_or_none(fields[8]), "operation": text[9],
            "writer_live": _int_or_none(fields[10]), "last_seen_utc": text[11],
            "last_commit": text[12], "dirty_count": _int_or_none(fields[13]),
            "unpushed_count": _int_or_none(fields[14]), "pr_number": None, "pr_state": None,
            "_provenance": text[15]}


def tree_line(row: dict, provenance) -> str:
    """The `TREE` line a stored row came from - the inverse of `tree_record`, so
    that `lanes --index --worktrees` and `lanes --worktrees` print the same
    bytes wherever the index is current."""
    def text(value) -> str:
        return "" if value is None else str(value)
    return US.join(["TREE"] + [text(row.get(c)) for c in (
        "workstation", "lane", "owner", "path", "branch", "base", "lifecycle", "generation",
        "operation", "writer_live", "last_seen_utc", "last_commit", "dirty_count",
        "unpushed_count")] + [text(provenance)])


#: THE BRANCH OF A LANE'S UNREAD MARKER (opensoft/openRepoTools#173): a
#: `worktrees` row with no path and a branch `unreadable inventory (<why>)`,
#: saying the lane's inventory could not be read at the last
#: sync, and why. A MARKER IS ITS KEY, `unread_key(<lane>)` - `<lane>:` and a
#: US - and nothing else decides it (the review of #219 and its delta check):
#: no tree's key can carry a US after the colon but its own `<US><n>`, while a
#: hand-made sidecar's branch can read like this one, and so can the row an
#: older helper printed for a sidecar with no `path:`, which has an EMPTY path.
#: (The helper no longer prints that row: the id of such a record stands where
#: its path would be, and the lane is `UNREAD` beside it, #302.)
UNREAD_BRANCH = "unreadable inventory"


def is_unread_marker(row: dict) -> bool:
    return row.get("record_id") == unread_key(row.get("lane") or "")


def unread_key(lane: str) -> str:
    return f"{lane}:{US}unread"


def unread_record(workstation: str, lane: str, why: str) -> dict:
    """The marker row of a lane whose inventory could not be read."""
    record = {col: None for col in TABLE_COLUMNS["worktrees"]}
    record.update(workstation=workstation, lane=lane, path="",
                  branch=f"{UNREAD_BRANCH} ({why})", _provenance=None)
    return record


def unread_line(row: dict) -> str:
    """The `UNREAD` line a marker row came from - `UNREAD <workstation> <lane>
    <why>`, as `lanes-edit.sh worktrees` prints it, so that `lanes --index
    --worktrees` says NOT READ wherever the source read said it."""
    why = row.get("branch") or ""
    if why.startswith(f"{UNREAD_BRANCH} (") and why.endswith(")"):
        why = why[len(UNREAD_BRANCH) + 2:-1]
    return US.join(["UNREAD", row.get("workstation") or "", row.get("lane") or "", why])


def inventory_digest(record: dict) -> str:
    """The register's digest, and the row's provenance with it: two
    observations of one tree filed under two generations are two versions."""
    content = ["worktrees"] + [record.get(col) for col in TABLE_COLUMNS["worktrees"]] + \
        [record.get("_provenance")]
    blob = json.dumps(content, ensure_ascii=False, separators=(",", ":"), sort_keys=False)
    return hashlib.sha256(blob.encode("utf-8")).hexdigest()


def lane_generation(lane: str) -> tuple:
    """`(generation, None)` of a lane's lifecycle snapshot, asked of `lanes-edit.sh
    lane-state` - 0 where the lane has no snapshot or no control root here - or
    `(None, why)` where its generation could not be read.

    THE REASON IS THE HELPER'S OWN FIRST SENTENCE (opensoft/openRepoTools#290,
    review r3 of #289's NIT-A). `lane-state` is 10 where the snapshot is there
    and could not be read, and where the lane's object log could not be read,
    so where the snapshot is kept is not known; the hold says which, in its
    words. It said "its lifecycle snapshot could not be read" for both - and
    a helper older than #290 said 8 for the second, which is read as 0 here
    still: the hold that makes is a hold, for the reason it gives."""
    proc = _helper_run(["lane-state", lane], 120, f"lane {lane}'s lifecycle snapshot")
    if proc.returncode in (1, 8):
        return 0, None
    if proc.returncode != 0:
        # `die`'S OWN `(exit <n>)` LINE IS NOT THE REASON (the review of #290,
        # N3). The helper runs in this process's environment, and with
        # `LANES_DEBUG` set `die` writes that line after the sentence, last.
        lines = proc.stderr.strip().splitlines()
        if lines and re.fullmatch(r"lanes-edit: \(exit [0-9]+\)", lines[-1].strip()):
            lines.pop()
        said = (lines or [""])[-1]
        if said.startswith("lanes-edit: "):
            said = said[len("lanes-edit: "):]
        said = said.split(". ", 1)[0].rstrip(".")
        return None, (f"its lifecycle generation could not be read - "
                      f"{said or 'lane-state said nothing more'} "
                      f"(lane-state exited {proc.returncode})")
    fields = dict(line.split("\t", 1) for line in proc.stdout.splitlines() if "\t" in line)
    if fields.get("state") == "UNKNOWN-SCHEMA":
        return None, f"its lifecycle snapshot records schema {fields.get('schema')}"
    gen = fields.get("generation", "")
    return (int(gen) if gen.isdigit() else 0), None


def collect_inventory() -> tuple[dict, dict]:
    """Every tree the inventory names, keyed `<lane>:<path>` (a second tree of
    one lane with the same path `<lane>:<path><US><n>`), and every lane whose
    inventory could not be read - whose rows are KEPT, never taken
    for a lane with no trees (Amendment 7(d)).

    A READ WHOSE LANE LISTING WAS NOT WHOLE IS NO ANSWER AT ALL
    (opensoft/openRepoTools#173 item c1). The helper lists the lanes out of the
    register, the archive and the object logs, and where one of those reads
    failed it says so in a `PARTIAL <workstation> <why>` line beside the rows it
    did reach. A lane it could not name is not a lane with no trees, and which
    lanes those are is exactly what the read does not know - so nothing is
    written from it, as nothing is from a listing that could not be read at
    all: the index stays at the last whole read, which `synced <UTC>` dates. An
    indexer older than this line refuses it too, as a line it does not read."""
    proc = _helper_run(["worktrees", "--all"], 600, "the worktree inventory")
    if proc.returncode == 8:
        return {}, {}
    if proc.returncode != 0:
        why = (proc.stderr.strip().splitlines() or ["no answer"])[-1]
        raise StoreUnusable("unread", f"`lanes-edit.sh worktrees --all` exited "
                            f"{proc.returncode}: {why}")
    trees, unread = {}, {}
    for line in proc.stdout.split("\n"):
        if not line:
            continue
        fields = line.split(US)
        if fields[0] == "PARTIAL" and len(fields) >= 3:
            raise StoreUnusable("unread", f"the lane listing `lanes-edit.sh worktrees --all` "
                                f"reads the inventory through was not whole - {fields[2]} - so "
                                f"a lane it could not name would read as a lane with no "
                                f"worktrees and its rows would be removed (R22, Amendment 7(d))")
        if fields[0] == "UNREAD" and len(fields) >= 4:
            unread[fields[2]] = fields[3]
            continue
        if fields[0] != "TREE" or len(fields) != 16:
            raise StoreUnusable("unread", f"`lanes-edit.sh worktrees` printed a line this "
                                f"indexer does not read ({len(fields)} fields): {line[:120]!r} - "
                                f"is the helper on PATH another version?")
        record = tree_record(fields)
        # TWO TREES OF ONE LANE WITH ONE PATH ARE TWO ROWS (the review of #219):
        # it was found for two sidecars with no `path:`, each a tree whose path
        # was EMPTY, and a second one replaced the first here. The helper no
        # longer lists such a tree (its lane is `UNREAD`, #302), but a record
        # that is not whole can still name the path of a whole one. A later
        # one is keyed with its place among them, after a US, which no path in a
        # US-separated line can carry. The read is sorted, so a place holds
        # while those trees keep their order; a change that reorders them - a
        # renamed branch, say - moves both keys, and that sync upserts both.
        key = f"{record['lane']}:{record['path']}"
        if key in trees:
            n = 2
            while f"{key}{US}{n}" in trees:
                n += 1
            key = f"{key}{US}{n}"
        trees[key] = record
    return trees, unread


def _github_repo(path: str) -> str:
    if not os.path.isdir(path):
        return ""
    proc = subprocess.run(["git", "-C", path, "remote", "get-url", "origin"], capture_output=True,
                          encoding="utf-8", errors="replace", check=False,
                          stdin=subprocess.DEVNULL)
    url = proc.stdout.strip()
    if proc.returncode != 0 or "github.com" not in url:
        return ""
    repo = _norm_repo(url)
    return repo if re.match(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", repo) else ""


def pr_of(path: str, branch_name: str):
    """`(number, state)` of the newest pull request whose head is this branch,
    asked of `gh` - BEST EFFORT, and `(None, None)` wherever it does not answer.
    The one network read of this source, and only of it."""
    repo = _github_repo(path)
    if not repo:
        return None, None
    env = dict(os.environ)
    env["GH_PROMPT_DISABLED"] = "1"
    try:
        proc = subprocess.run(["gh", "pr", "list", "--repo", repo, "--head", branch_name,
                               "--state", "all", "--json", "number,state", "--limit", "1"],
                              capture_output=True, encoding="utf-8", errors="replace",
                              check=False, env=env, stdin=subprocess.DEVNULL, timeout=20)
        found = json.loads(proc.stdout) if proc.returncode == 0 else []
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return None, None
    if not isinstance(found, list) or not found or not isinstance(found[0], dict):
        return None, None
    number = found[0].get("number")
    state = found[0].get("state")
    return (number if isinstance(number, int) else None,
            state if isinstance(state, str) and state else None)


def fill_prs(trees: dict, stored: dict, mode: str, held: dict | None = None) -> int:
    """`pr_number`/`pr_state` for every tree on a branch. A `sync` carries a
    stored answer over for a tree whose branch and last commit have not moved
    where that answer is final (MERGED, CLOSED) or `gh` is not to be asked;
    `reconcile` asks again. Returns how many were asked."""
    use_gh = os.environ.get("LANES_NO_GITHUB", "") != "1" and bool(shutil.which("gh"))
    ask = []
    for rec_id, rec in trees.items():
        name = rec.get("branch") or ""
        if not name or " " in name or name in ("unknown", "HEAD") or rec["lane"] in (held or {}):
            continue
        old = stored.get(rec_id)
        if mode == "sync" and old is not None and old.get("branch") == rec["branch"] \
                and old.get("last_commit") == rec["last_commit"] \
                and (old.get("pr_state") in ("MERGED", "CLOSED") or not use_gh):
            rec["pr_number"], rec["pr_state"] = old.get("pr_number"), old.get("pr_state")
            continue
        if use_gh:
            ask.append(rec_id)
    if ask:
        with ThreadPoolExecutor(max_workers=max(1, min(8, len(ask)))) as pool:
            answers = list(pool.map(lambda rid: pr_of(trees[rid]["path"], trees[rid]["branch"]),
                                    ask))
        for rec_id, (number, state) in zip(ask, answers):
            trees[rec_id]["pr_number"], trees[rec_id]["pr_state"] = number, state
    return len(ask)


def run_inventory(mode: str, requested: str | None, dry_run: bool) -> int:
    cfg = load_config()
    source = inventory_source(requested)
    store = open_store(cfg, "writer")
    if dry_run:
        try:
            store.open_read()
        except StoreUnusable as exc:
            if exc.kind not in ("missing", "wiped"):
                raise
            store = None
    else:
        store.open_write()
    old = store.provenance(source) if store is not None else None
    trees, unread = collect_inventory()
    label = f"{source} ({cfg['store']})"
    cols = TABLE_COLUMNS["worktrees"]
    stored = {} if store is None else {
        r["record_id"]: r for r in store.rows("worktrees", source, cols + ["digest", "provenance"])}

    # THE PROVENANCE MOVES ONLY FORWARD, PER LANE (14(d)). A lane's lifecycle
    # generation is monotonic by `set-lane-state`'s own fence, so a read BELOW
    # the generation a lane's rows were written at is a snapshot that was moved
    # aside or replaced - and a `sync` writes nothing for that lane rather than
    # roll its rows back. `reconcile` is the act that takes the source as it now
    # stands, and it says so. A lane whose inventory could not be read keeps its
    # rows in either: a read that failed is never an answer. (A read whose LANE
    # LISTING was not whole never gets this far: `collect_inventory` refuses it,
    # in either act, because which lanes it could not name is what it does not
    # know - #173 item c1.)
    held: dict = {}
    for lane, why in unread.items():
        held[lane] = f"its inventory could not be read ({why})"
    read_gen: dict = {}
    for rec in trees.values():
        read_gen[rec["lane"]] = max(read_gen.get(rec["lane"], 0), rec["generation"] or 0)
    stored_gen: dict = {}
    for row in stored.values():
        stored_gen[row["lane"]] = max(stored_gen.get(row["lane"], 0), row["generation"] or 0)
    # A LANE WHOSE ROWS WOULD ALL LEAVE IS FENCED TOO (Copilot round 2 on #171).
    # It names no tree now, so it carries no generation in the read; its
    # snapshot is asked for - only for these lanes, which are few - so that one
    # moved aside and begun again without trees is held for `reconcile` like
    # any other lane that went back, rather than emptied by a `sync`.
    for lane in sorted(set(stored_gen) - set(read_gen) - set(held)):
        if not stored_gen[lane]:
            continue
        gen, why = lane_generation(lane)
        if why:
            held[lane] = why
        else:
            read_gen[lane] = gen
    taken: list = []
    for lane, gen in sorted(read_gen.items()):
        if lane in held or gen >= stored_gen.get(lane, 0):
            continue
        if mode == "sync":
            held[lane] = (f"its lifecycle generation reads {gen} and its rows were written at "
                          f"{stored_gen[lane]}; the provenance only moves forward, so nothing "
                          f"is written for it - `{PROG} reconcile --source inventory` takes "
                          f"the lane as it now stands")
        else:
            taken.append(f"  lane {lane}: its lifecycle generation went back from "
                         f"{stored_gen[lane]} to {gen} (a snapshot moved aside or replaced); "
                         f"reconcile takes it as it now stands")

    # THE UNREAD STATE IS KEPT AS WELL AS THE ROWS (opensoft/openRepoTools#173,
    # Copilot's third review of #171). A lane held because its inventory could
    # not be read gets ONE marker row, which `export --worktrees` writes back as
    # the source's own `UNREAD` line. Without it a FIRST sync that could not
    # read a lane committed usable provenance with nothing for it, and the
    # index answered "no worktree is inventoried" where the source says NOT
    # READ; and rows held over from an earlier sync read as freshly read - so
    # the marker says they are kept. It leaves with the first sync that reads
    # its lane, a lane held for its generation included: that lane was read.
    workstation = source[len(INVENTORY_PREFIX):]
    markers: dict = {}
    for lane, why in unread.items():
        rows_kept = sum(1 for row in stored.values()
                        if row["lane"] == lane and not is_unread_marker(row))
        if rows_kept:
            why = (f"{why} - the {rows_kept} row(s) listed for it are kept from the last sync "
                   f"that read it")
        markers[unread_key(lane)] = unread_record(workstation, lane, why)

    fill_prs(trees, stored, mode, held)
    upserts, deletes, kept = {}, [], 0
    for rec_id, rec in list(trees.items()) + list(markers.items()):
        rec["digest"] = inventory_digest(rec)
        if rec["lane"] in held and rec_id not in markers:
            continue
        row = stored.get(rec_id)
        if row is not None:
            if mode == "reconcile":
                as_written = {c: row.get(c) for c in cols}
                as_written["_provenance"] = row.get("provenance")
                same = inventory_digest(as_written) == rec["digest"] == row.get("digest")
            else:
                same = row.get("digest") == rec["digest"]
            if same:
                kept += 1
                continue
        upserts[rec_id] = rec
    for rec_id, row in stored.items():
        if rec_id in trees or rec_id in markers:
            continue
        if row["lane"] not in held or is_unread_marker(row):
            deletes.append(rec_id)
    after = {rid: rec["digest"] for rid, rec in trees.items() if rec["lane"] not in held}
    after.update({rid: row["digest"] for rid, row in stored.items()
                  if row["lane"] in held and not is_unread_marker(row)})
    after.update({rid: rec["digest"] for rid, rec in markers.items()})
    fingerprint = hashlib.sha256("\n".join(
        f"{rid}\t{digest}" for rid, digest in sorted(after.items())).encode("utf-8")).hexdigest()

    n_up, n_del = len(upserts), len(deletes)
    if mode == "reconcile":
        say(f"{PROG} reconcile: {label}{' - DRY RUN' if dry_run else ''}")
        say(f"  {'worktrees':<20} {kept:>6} kept  {n_up:>6} upserted  {n_del:>6} removed")
        for line in taken:
            say(line)
    for lane, why in sorted(held.items()):
        say(f"  lane {lane}: its rows are kept as they are - {why}")
    if dry_run:
        say(f"  total: {n_up} to upsert, {n_del} to remove - nothing written (--dry-run)")
        return 0
    # NOTHING TO WRITE ONLY WHERE THE SOURCE'S OWN ROW AGREES TOO (Copilot
    # round 1 on #171): a fingerprint changed by hand, with every row right, is
    # put right here rather than left disagreeing with the table it names.
    if old is not None and not upserts and not deletes and old.get("commit_sha") == fingerprint:
        if mode == "sync":
            say(f"{PROG} sync: {label} - the index is current; nothing to write")
        else:
            say("  total: nothing differs; nothing written")
        write_status(source, last_attempt_utc=utc_now(), last_sync_utc=utc_now(),
                     last_result="current", last_error="")
        return 0
    try:
        generation = int((old or {}).get("generation") or 0) + 1
    except (TypeError, ValueError):
        generation = 1
    store.apply(source, old, fingerprint, {"worktrees": upserts} if upserts else {},
                {"worktrees": deletes} if deletes else {}, generation=generation)
    write_status(source, last_attempt_utc=utc_now(), last_sync_utc=utc_now(),
                 last_result=f"{n_up} upserted, {n_del} removed at sync {generation}",
                 last_error="")
    if mode == "sync":
        say(f"{PROG} sync: {label} - {n_up} upserted, {n_del} removed")
    else:
        say(f"  total: {n_up} upserted, {n_del} removed")
    return 0


def is_inventory(requested: str | None) -> bool:
    return bool(requested) and (requested == "inventory" or requested.startswith(INVENTORY_PREFIX))


def _sync_once(kind: str, requested: str | None) -> int:
    if kind == "inventory":
        # A REFUSAL HERE IS ANSWERED HERE: a register sync that took the
        # inventory's mark must not lose the marks behind it to an exception.
        try:
            return _guarded(lambda: run_inventory("sync", requested, False), requested, kind)
        except Refusal as exc:
            note(f"REFUSED: {exc}")
            return 2
    return _guarded(lambda: run_index("sync", requested, False), requested, kind)


def cmd_sync(requested: str | None) -> int:
    if os.environ.get("LANES_INDEX", "") == "off":
        say(f"{PROG} sync: LANES_INDEX=off - nothing indexed")
        return 0
    kind = "inventory" if is_inventory(requested) else "register"
    asked = {kind: requested}
    # A SOURCE IS REFUSED BEFORE THE LOCK IS ASKED FOR (opensoft/openRepoTools#173,
    # Copilot's fourth review of #171). Behind a held lock this sync only
    # leaves a mark of its KIND, and the holder syncs THIS workstation's source
    # for it - so `--source inventory:Raven` on Eagle, `--source inventory` in
    # a container with no name, or another register, exited 0 there instead of
    # 2. A refusal leaves through `main`; a helper that cannot answer is the
    # sync's own to say and record, as it was.
    try:
        if kind == "inventory":
            inventory_source(requested)
        elif requested:
            resolve_source(requested, workspace_root())
    except StoreUnusable:
        pass
    lock = SyncLock()
    # THE HANDSHAKE, BOTH HALVES (Codex on #164). A sync that finds the lock
    # held leaves its mark and then tries ONCE MORE: if that fails, somebody
    # holds the lock NOW, after the mark was written, and the holder looks for
    # marks after it lets go. The holder, for its part, looks again AFTER it
    # releases - a mark written between its last look and its release is
    # found there, and it takes the lock back for it. No mark is left with
    # nobody due to read it. AND THE MARK NAMES ITS SOURCE (#161): the holder
    # syncs every source a mark names, its own included, before it lets go.
    if not lock.acquire(0):
        lock.mark_rerun(kind)
        if not lock.acquire(0):
            say(f"{PROG} sync: another sync holds {lock.path}; it will sync again before "
                f"it is done")
            return 0
    rc = 0
    try:
        rounds = 0
        due = [kind]
        while True:
            for marked in lock.take_reruns():
                if marked not in due:
                    due.append(marked)
            if not due:
                lock.release()
                if not lock.has_rerun() or not lock.acquire(0):
                    return rc
                continue
            current = due[0]
            rounds += 1
            result = _sync_once(current, asked.get(current))
            if result == MOVED and rounds < 5:
                continue
            due.pop(0)
            if result == MOVED:
                say(f"{PROG} sync: origin/{branch()} kept moving through {rounds} reads; "
                    f"nothing written - the next write's nudge syncs it")
                result = 0
            # A FAILED SOURCE DOES NOT DROP THE OTHERS (Copilot round 1 on #171):
            # their marks were taken off the disk with this one's, so the loop
            # drains them all and the exit is the first failure.
            if result != 0 and rc == 0:
                rc = result
            if rounds >= 8:
                # THE CAP HANDS BACK WHAT IT DID NOT RUN (Copilot round 2 on
                # #171): a source whose mark this loop took off the disk and
                # never synced is marked again, for the next sync, exactly as a
                # mark this loop never took is left for it.
                for pending in due:
                    lock.mark_rerun(pending)
                return rc
    finally:
        lock.release()


def cmd_reconcile(requested: str | None, dry_run: bool) -> int:
    if os.environ.get("LANES_INDEX", "") == "off" and not dry_run:
        say(f"{PROG} reconcile: LANES_INDEX=off - nothing indexed")
        return 0
    kind = "inventory" if is_inventory(requested) else "register"
    lock = SyncLock()
    if not dry_run and not lock.acquire(60):
        note(f"another sync has held {lock.path} for 60 s; nothing written")
        return 1
    try:
        if kind == "inventory":
            return _guarded(lambda: run_inventory("reconcile", requested, dry_run), requested,
                            kind)
        for _attempt in range(3):
            rc = _guarded(lambda: run_index("reconcile", requested, dry_run), requested)
            if rc != MOVED:
                return rc
        note(f"origin/{branch()} kept moving through three reads; nothing written")
        return 1
    finally:
        lock.release()


#: `_guarded`'s answer for a read the source moved under: not an exit code
#: anybody sees, a signal to the two drivers above to read again.
MOVED = -1


def _guarded(act, requested, kind: str = "register") -> int:
    try:
        return act()
    except SourceMoved as exc:
        note(str(exc))
        return MOVED
    except CasLost as exc:
        note(str(exc))
        _record_error(requested, str(exc), kind)
        return 1
    except StoreUnusable as exc:
        note(f"{exc.kind}: {exc.detail} - nothing written")
        _record_error(requested, f"{exc.kind}: {exc.detail}", kind)
        return 1


def _record_error(requested, message: str, kind: str = "register") -> None:
    if kind == "inventory":
        try:
            source = inventory_source(requested)
        except (StoreUnusable, Refusal):
            source = requested if requested and requested != "inventory" else "inventory:?"
        write_status(source, last_attempt_utc=utc_now(), last_error=f"{utc_now()} {message}")
        return
    try:
        source = requested or source_of(workspace_root())
    except StoreUnusable:
        source = requested or "register:?"
    write_status(source, last_attempt_utc=utc_now(), last_error=f"{utc_now()} {message}")


def cmd_status() -> int:
    cfg = load_config()
    store = open_store(cfg, "reader")
    say(f"store: {cfg['store']} {store.where} (configuration: "
        f"{cfg['path'] if cfg['present'] else 'none - the defaults'})")
    rc = 0
    root = ""
    source = ""
    tip = ""
    try:
        root = workspace_root()
        source = source_of(root)
        tip = tip_of(root)
    except StoreUnusable as exc:
        say(f"workspace: {exc.detail}")
        rc = 1
    provs: list = []
    try:
        store.open_read()
        provs = store.all_provenance()
        say(f"schema: {SCHEMA_VERSION}")
    except StoreUnusable as exc:
        say(f"index: {exc.kind} - {exc.detail}")
        rc = 1
    local = read_status()
    sources = [p["source"] for p in provs]
    if source and source not in sources:
        sources.append(source)
    # THIS WORKSTATION'S INVENTORY TOO (#161), indexed or not - its name is the
    # helper's, and a helper that cannot say it costs the line, not the status.
    inv_source = ""
    try:
        inv_source = inventory_source(None)
    except (StoreUnusable, Refusal):
        inv_source = ""
    if inv_source and inv_source not in sources:
        sources.append(inv_source)
    for name in sorted(set(sources) | set(local)):
        prov = next((p for p in provs if p["source"] == name), None)
        say(f"source {name}")
        if name.startswith(INVENTORY_PREFIX):
            if prov is None:
                say("  provenance:  none - this inventory is not indexed (a wiped or "
                    "never-synced index; `lanes-index reconcile --source inventory` builds it)")
            else:
                fp = prov.get("commit_sha") or ""
                say(f"  provenance:  inventory@{fp[:12]} (sync {prov.get('generation')}, indexed "
                    f"{prov['indexed_utc']}, schema {prov['schema_version']})")
                try:
                    wt_rows = store.rows("worktrees", name, ["lane"])
                    count = sum(1 for row in wt_rows if not is_unread_marker(row))
                    # A LANE'S UNREAD MARKER IS NOT A WORKTREE (#173), and is said
                    # as what it is.
                    unread = len(wt_rows) - count
                    say(f"  rows:        {count} worktree(s)" + (
                        f", and {unread} lane(s) whose inventory could not be read at the "
                        f"last sync" if unread else ""))
                except StoreUnusable as exc:
                    say(f"  rows:        unread - {exc.kind}: {exc.detail}")
                    rc = 1
        elif prov is None:
            say("  provenance:  none - this source is not indexed (a wiped or never-synced "
                "index; `lanes-index reconcile` builds it)")
        elif prov.get("commit_sha"):
            say(f"  provenance:  register@{prov['commit_sha'][:12]} (indexed "
                f"{prov['indexed_utc']}, schema {prov['schema_version']})")
        else:
            say(f"  provenance:  generation {prov.get('generation')} (indexed "
                f"{prov['indexed_utc']}, schema {prov['schema_version']})")
        if name == source and tip:
            say(f"  tip:         register@{tip[:12]} (origin/{branch()} in {root})")
            if prov is not None and prov.get("commit_sha"):
                lag = commits_between(root, prov["commit_sha"], tip)
                say(f"  lag:         {'unknown (the indexed commit is not in this checkout)' if lag is None else f'{lag} commit(s)'}")
        entry = local.get(name, {})
        say(f"  last sync:   {entry.get('last_sync_utc') or 'never, from this workstation'}"
            f"{' (' + entry['last_result'] + ')' if entry.get('last_result') else ''}")
        say(f"  last error:  {entry.get('last_error') or 'none'}")
    return rc


def cmd_export(out_dir: str, requested: str | None, worktrees: bool = False) -> int:
    """The read flags' reader, and nothing else's: the index's image of this
    workstation's register in the shapes `lanes-edit.sh` reads from origin -
    or, with `worktrees` (#161), every inventory source's rows as the `TREE`
    lines `lanes-edit.sh worktrees` prints.

    It writes FILES into `out_dir` and prints nothing a caller parses. On
    success `meta`; on any reason the index cannot answer, `why` - one line,
    which `lanes-edit.sh` prints as `read: sources (index <why>)`."""
    if not os.path.isdir(out_dir):
        note(f"--out {out_dir} is not a directory")
        return 64

    def unusable(kind: str, detail: str) -> int:
        with open(os.path.join(out_dir, "why"), "w", encoding="utf-8") as handle:
            handle.write(f"{kind}: {detail}\n")
        return 3

    try:
        cfg = load_config()
    except Refusal as exc:
        unusable("refused", str(exc))
        return 2
    if worktrees:
        return _export_worktrees(out_dir, cfg, unusable)
    try:
        root = workspace_root()
        source = resolve_source(requested, root)
        store = open_store(cfg, "reader")
        store.open_read()
        # ONE COMMIT'S IMAGE (opensoft/openRepoTools#166 item 1): the provenance
        # and every table in one read snapshot, or a sync committing between two
        # reads writes rows of two commits under a `meta` naming the first.
        prov, (file_rows, lanes, reg_lines, aliases, log_rows) = store.read_image(source, [
            ("source_files", TABLE_COLUMNS["source_files"]),
            ("lanes", ["row_file", "row_ordinal", "row_text"]),
            ("register_lines", ["ordinal", "raw"]),
            ("lane_aliases", ["ordinal", "raw"]),
            ("log_lines", [c for c in TABLE_COLUMNS["log_lines"]
                           if c not in ("payload_fields", "raw")])])
        if prov is None or not prov.get("commit_sha"):
            return unusable("wiped", f"no provenance for {source} in the {cfg['store']} store")
        files = {r["record_id"]: r for r in file_rows}
    except Refusal as exc:
        unusable("refused", str(exc))
        return 2
    except StoreUnusable as exc:
        return unusable(exc.kind, exc.detail)

    def write(name: str, lines: list[str]) -> None:
        with open(os.path.join(out_dir, name), "w", encoding="utf-8", newline="") as handle:
            for line in lines:
                handle.write(line + "\n")

    register = [(r["row_ordinal"], r["row_text"]) for r in lanes if r["row_file"] == REGISTER_PATH]
    register += [(r["ordinal"], r["raw"]) for r in reg_lines]
    write("register", [text for _o, text in sorted(register, key=lambda x: x[0])])
    if ARCHIVE_PATH in files:
        write("archive", [r["row_text"] for r in sorted(
            (r for r in lanes if r["row_file"] == ARCHIVE_PATH), key=lambda r: r["row_ordinal"])])
    if ALIASES_PATH in files:
        write("aliases", [r["raw"] for r in sorted(aliases, key=lambda r: r["ordinal"])])
    logs = sorted((f for f in files.values() if f["kind"] == "log"), key=lambda f: f["ls_order"])
    write("logs", [f["record_id"] for f in logs])
    by_file: dict = {}
    for row in log_rows:
        by_file.setdefault(row["file"], []).append(row)
    events, warn = [], []
    for f in logs:
        bad = 0
        for row in sorted(by_file.get(f["record_id"], []), key=lambda r: r["ordinal"]):
            if row["unreadable"]:
                bad += 1
                warn.append(f"unreadable: {row['file']}:{row['ordinal']} ({row['unreadable_why']})")
                continue
            events.append(US.join([row["utc"] or "", row["lane"] or "", row["verb"] or "",
                                   row["session"] or "", row["workstation"] or "",
                                   row["object"] or "", row["ref"] or "", row["payload"] or "",
                                   row["free_text"] or "", row["file"] or "",
                                   str(row["ordinal"])]))
        if bad:
            warn.append(f"{bad} unreadable line(s) above — an append-only log is never "
                        f"rewritten, so a line no parser reads is a hold no tool will mention "
                        f"again")
    write("events", events)
    write("warn", warn)
    write("meta", [f"store={cfg['store']}", f"source={source}",
                   f"sha={prov['commit_sha']}", f"indexed_utc={prov['indexed_utc']}"])
    return 0


def _export_worktrees(out_dir: str, cfg: dict, unusable) -> int:
    """EVERY `inventory:<Workstation>` THE STORE HOLDS - this workstation's and
    any other syncing into the same Postgres, which is what the table is for:
    the next account, on either workstation, sees every open worktree in one
    read. `meta` names each source with the time it was synced."""
    try:
        store = open_store(cfg, "reader")
        store.open_read()
        provs = [p for p in store.all_provenance()
                 if str(p["source"]).startswith(INVENTORY_PREFIX)]
        if not provs:
            return unusable("wiped", f"no {INVENTORY_PREFIX}<Workstation> source in the "
                            f"{cfg['store']} store")
        lines = []
        for prov in provs:
            for row in store.rows("worktrees", prov["source"],
                                  TABLE_COLUMNS["worktrees"] + ["provenance"]):
                # A LANE'S UNREAD MARKER (#173) is written back as the `UNREAD`
                # line it was read from.
                lines.append(unread_line(row) if is_unread_marker(row)
                             else tree_line(row, row.get("provenance")))
    except Refusal as exc:
        unusable("refused", str(exc))
        return 2
    except StoreUnusable as exc:
        return unusable(exc.kind, exc.detail)
    # THE BYTE ORDER `LC_ALL=C sort` GIVES the source read, so this
    # workstation's rows are the source read's own stream wherever the index is
    # current; a shared store adds other workstations' rows among them.
    lines.sort(key=lambda line: line.encode("utf-8"))
    with open(os.path.join(out_dir, "worktrees"), "w", encoding="utf-8", newline="") as handle:
        for line in lines:
            handle.write(line + "\n")
    # AND THE LAST ERROR THIS WORKSTATION RECORDED FOR THE SOURCE (N2 of the
    # review of #289): a sync that wrote nothing - a lane listing that was not
    # whole, among others - leaves the table and its `synced` time as they
    # were, and only `status` said why. It is `status`'s `last error`, so a
    # refused `reconcile` is in it too, a `--dry-run` included (NIT-1 of review
    # r2 of #289). A fifth field, which a reader from before it ignores.
    # Another workstation's error is in its own record and not here, so a
    # shared store's other sources never carry one.
    recorded = read_status()
    with open(os.path.join(out_dir, "meta"), "w", encoding="utf-8", newline="") as handle:
        handle.write(f"store={cfg['store']}\n")
        for prov in sorted(provs, key=lambda p: str(p["source"])):
            entry = recorded.get(prov["source"])
            error = entry.get("last_error") if isinstance(entry, dict) else ""
            error = " ".join(str(error or "").split())
            handle.write(f"inventory\t{prov['source']}\t{prov['indexed_utc']}\t"
                         f"{prov.get('generation')}" + (f"\t{error}" if error else "") + "\n")
    return 0


USAGE = f"""\
{PROG} sync      [--source <s>]              index what LANDED, behind the source
{PROG} reconcile [--source <s>] [--dry-run]  read the source whole; put the index right
{PROG} status                                 per source: store, provenance, lag, errors
{PROG} export    --out <dir> [--source <s> | --worktrees]
                                             the `--index` read flags' reader

The DERIVED INDEX of the lane register (lane-collision-protocol Amendment 14).
It is written behind the sources by this command alone, read only by tooling
that decides nothing, and never a gate: no lane act reads it or waits on it.

  sync        Reads `origin/<branch>` of the workspace repository as the push
              left it - never the working tree - and upserts each record that
              differs, keyed by (source, record id) and versioned by a digest,
              with the source's provenance compared and swapped in the SAME
              transaction. A sync from a commit that does not descend from the
              indexed one writes nothing. `lanes-edit.sh` starts it DETACHED
              after every write that landed; `LANES_INDEX=off` stops that.
  reconcile   Reads the source whole, compares every stored row by its
              CONTENT, upserts what differs and removes what is gone: on a
              wiped index, the rebuild. `--dry-run` prints the counts only.
  status      The store, each source's provenance against its tip, the lag in
              commits, and this workstation's last sync and last error.
  export      Writes the index's image of the register into <dir> for
              `lanes --index` and `lanes-edit.sh history --index` - or, with
              `--worktrees`, every inventory source's rows for `lanes --index
              --worktrees`. Not for people.

  --source <s>  `register:<owner/repo>`, which must be this workstation's own
                and is the default; `inventory` (or `inventory:<Workstation>`,
                this one's) is THIS workstation's #97 worktree inventory, read
                through `lanes-edit.sh worktrees --all` into the `worktrees`
                table (opensoft/openRepoTools#161) - every inventory write
                nudges `sync --source inventory`. The managed ledger's
                `ledger:<Workstation>` is T058's to write.

THE STORE: SQLite at ${{XDG_STATE_HOME:-~/.local/state}}/openRepoTools/lanes-index.sqlite,
or QA Postgres through `psql` where the configuration names a `url=`.
THE CONFIGURATION: ${{XDG_CONFIG_HOME:-~/.config}}/openRepoTools/lanes-index.conf, or the
file $LANES_INDEX_CONFIG names - mode 0600, outside every git work tree and
outside ~/.agents/, with no password in any URL:

  store=sqlite|postgres     default: postgres where url= is set, else sqlite
  sqlite=<path>             the SQLite file
  url=<libpq URL>           the WRITER role (sync, reconcile)
  passfile=<path>           the 0600 libpq password file for it
  reader_url=<libpq URL>    the SELECT-only READER role (status, export) -
                            required beside url=; a read never uses the writer
  reader_passfile=<path>    its password file, where it is not the same one
  schema=<name>             the Postgres schema (default lanes_index)

Exit: 0 done · 1 a read or write failed, nothing half-written · 2 refused ·
3 export: the index cannot answer (the reason is in <dir>/why) · 64 usage."""


def main(argv: list[str]) -> int:
    if not argv:
        sys.stderr.write(USAGE + "\n")
        return 64
    if argv[0] in ("-h", "--help", "help"):
        say(USAGE)
        return 0
    if argv[0] == "--version":
        say(f"{PROG} {VERSION} (schema {SCHEMA_VERSION})")
        return 0
    verb, args = argv[0], argv[1:]
    if verb == "bootstrap":
        return cmd_bootstrap(args)
    if verb == "login":
        return cmd_login(args)
    source = None
    dry_run = False
    worktrees = False
    out_dir = None
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-h", "--help"):
            say(USAGE)
            return 0
        if arg == "--source" or arg.startswith("--source="):
            value = arg.split("=", 1)[1] if "=" in arg else (args[i + 1] if i + 1 < len(args) else "")
            if not value:
                note("--source needs a value: register:<owner/repo>")
                return 64
            source = value
            i += 1 if "=" in arg else 2
            continue
        if (arg == "--out" or arg.startswith("--out=")) and verb == "export":
            value = arg.split("=", 1)[1] if "=" in arg else (args[i + 1] if i + 1 < len(args) else "")
            if not value:
                note("--out needs a directory")
                return 64
            out_dir = value
            i += 1 if "=" in arg else 2
            continue
        if arg == "--dry-run" and verb == "reconcile":
            dry_run = True
            i += 1
            continue
        if arg == "--worktrees" and verb == "export":
            worktrees = True
            i += 1
            continue
        note(f"unknown argument '{arg}' for {verb} - see {PROG} --help")
        return 64
    try:
        if verb == "sync":
            return cmd_sync(source)
        if verb == "reconcile":
            return cmd_reconcile(source, dry_run)
        if verb == "status":
            if source:
                note("status takes no --source; it prints every source the store holds")
                return 64
            return cmd_status()
        if verb == "export":
            if not out_dir:
                note("export needs --out <dir>")
                return 64
            if worktrees and source:
                note("export --worktrees reads every inventory source the store holds; it "
                     "takes no --source")
                return 64
            return cmd_export(out_dir, source, worktrees)
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return 2
    except StoreUnusable as exc:
        note(f"{exc.kind}: {exc.detail}")
        return 1
    note(f"unknown subcommand '{verb}' (sync|reconcile|status|export) - see {PROG} --help")
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
