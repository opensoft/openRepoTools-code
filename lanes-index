REGISTER_TABLES = ("source_files", "lanes", "log_lines", "register_lines", "lane_aliases",
                   "transcript_pointers")


def digest_of(table: str, record: dict) -> str:
    content = [table] + [record.get(col) for col in TABLE_COLUMNS[table]]
    blob = json.dumps(content, ensure_ascii=False, separators=(",", ":"), sort_keys=False)
    return hashlib.sha256(blob.encode("utf-8")).hexdigest()


def build_records(snap: dict) -> dict:
    """Every record of the register half at one commit, WITHOUT the owner
    column: the owner is `managed-projection`'s answer, asked separately."""
    out = {table: {} for table in REGISTER_TABLES}

    def put(table: str, record_id: str, record: dict) -> None:
        out[table][record_id] = record

    # ---- the files themselves
    for path, kind in ((REGISTER_PATH, "register"), (ALIASES_PATH, "aliases"),
                       (ARCHIVE_PATH, "archive")):
        text = snap.get(kind)
        if text is None:
            continue
        put("source_files", path, {"kind": kind, "lane": None, "ls_order": None,
                                   "blob_sha": snap["blobs"].get(path),
                                   "line_count": len(text.split("\n")),
                                   "unreadable_count": None})

    # ---- the logs, every line, the unreadable ones kept (7(b))
    facts: dict = {}
    first_log_of: dict = {}
    for path, text, obj, order in snap["logs"]:
        records, _warnings = parse_log(path, text)
        lane = file_lane(path)
        first_log_of.setdefault(lane.lower(), lane)
        unreadable = 0
        for rec in records:
            rec_id = f"{rec['lane']}:{rec['ordinal']}"
            # TWO FILES WHOSE NAMES DIFFER ONLY BY CASE are two logs for one
            # lane - Amendment 15(d)'s hand merge - and each keeps its lines
            # under its own spelling, so neither file's lines replace the other's.
            if rec_id in out["log_lines"]:
                rec_id = f"{rec['file']}:{rec['ordinal']}"
            if rec["unreadable"]:
                unreadable += 1
                row = {col: None for col in TABLE_COLUMNS["log_lines"]}
                row.update(lane=rec["lane"], file=rec["file"], ordinal=rec["ordinal"],
                           unreadable=1, unreadable_why=rec["unreadable_why"], raw=rec["raw"])
            else:
                row = {col: rec.get(col) for col in TABLE_COLUMNS["log_lines"]}
                row["payload_fields"] = json.dumps(payload_fields(rec["payload"]),
                                                   ensure_ascii=False, sort_keys=False)
            put("log_lines", rec_id, row)
            if rec["unreadable"]:
                continue
            f = facts.setdefault(lane.lower(), {"home": None, "sid": None, "paused": []})
            fork = rec["payload"].startswith("fork ")
            if rec["verb"] in ("STARTED", "RESUMED") and not fork:
                hm = re.search(r"home [^ ;]+", rec["payload"])
                if hm:
                    value = hm.group(0)[5:]
                    if value != "unknown":
                        f["home"] = value
            if rec["verb"] in ("PAUSED", "RESUMED") and UUID_FULL_RE.match(rec["session"] or ""):
                f["sid"] = rec["session"].lower()
            if rec["verb"] == "PAUSED":
                pf = payload_fields(rec["payload"])
                if "transcript" in pf:
                    f["paused"].append((rec["file"], rec["ordinal"], pf.get("transcript"),
                                        pf.get("agent")))
        put("source_files", path, {"kind": "log", "lane": lane, "ls_order": order,
                                   "blob_sha": obj, "line_count": len(text.split("\n")),
                                   "unreadable_count": unreadable})

    # ---- the register: its rows and its Rule 6 / Amendment 10 lines
    rows = []
    for ordinal, line in enumerate(snap["register"].split("\n"), 1):
        name = row_name(line)
        if name is not None:
            if name != "":
                rows.append((REGISTER_PATH, ordinal, name, line, 0))
            continue
        fields = parse_register_line(line)
        if fields is not None:
            fields["ordinal"] = ordinal
            fields["raw"] = line
            put("register_lines", str(ordinal), fields)
    if snap.get("archive") is not None:
        for ordinal, line in enumerate(snap["archive"].split("\n"), 1):
            name = row_name(line)
            if name:
                rows.append((ARCHIVE_PATH, ordinal, name, line, 1))

    # ---- Amendment 16(e)'s alias table, every line kept
    alias_map: dict = {}
    if snap.get("aliases") is not None:
        for ordinal, line in enumerate(snap["aliases"].split("\n"), 1):
            if line.strip() == "":
                continue
            parts = line.split("\t")
            old = _trim(parts[0]) if parts else ""
            new = _trim(parts[1]) if len(parts) > 1 else ""
            when = _trim(parts[2]) if len(parts) > 2 else ""
            comment = bool(re.match(r"^[ \t]*#", line))
            put("lane_aliases", str(ordinal), {
                "old_name": None if comment else (old or None),
                "new_name": None if comment else (new or None),
                "utc": None if comment else (when or None), "ordinal": ordinal, "raw": line})
            if not comment and old and new:
                alias_map[old.lower()] = (old, new, ordinal)

    def resolve(name: str) -> str:
        seen = set()
        cur = name
        while cur.lower() in alias_map and cur.lower() not in seen:
            seen.add(cur.lower())
            cur = alias_map[cur.lower()][1]
        return cur

    aliases_of: dict = {}
    for _key, (old, _new, ordinal) in sorted(alias_map.items(), key=lambda kv: kv[1][2]):
        aliases_of.setdefault(resolve(old).lower(), []).append(old)

    # ---- one record per lane: every row, then every log with no row
    used_lower: set = set()
    for row_file, ordinal, name, line, archived in rows:
        rec_id = name
        if rec_id in out["lanes"]:
            rec_id = f"{name}~{'archive' if archived else 'register'}:{ordinal}"
        parts = line.split("|")
        session_cell = parts[2] if len(parts) > 2 else ""
        ids = UUID_RE.findall(session_cell.lower())
        f = facts.get(name.lower(), {})
        state = cell_state(line)
        put("lanes", rec_id, {
            "lane": name,
            "aliases": json.dumps(aliases_of.get(name.lower(), []), ensure_ascii=False),
            "home": f.get("home"),
            "workstation": _trim(parts[3]) if len(parts) > 3 else None,
            "started_utc": _trim(parts[4]) if len(parts) > 4 else None,
            "objects_cell": _trim(parts[5]) if len(parts) > 5 else None,
            "handoff_path": _trim(parts[6]) if len(parts) > 6 else None,
            "state_phrase": _trim(state) if state else None,
            "session_ids": json.dumps(ids),
            "last_session": ids[-1] if ids else f.get("sid"),
            "archived": archived, "owner": None,
            "row_file": row_file, "row_ordinal": ordinal, "row_text": line})
        used_lower.add(name.lower())
        cell_ids = ids
        for position, tid in enumerate(cell_ids, 1):
            put("transcript_pointers", f"{rec_id}:cell:{position}", {
                "lane": name, "kind": "session-cell", "transcript_id": tid, "agent": None,
                "position": position})
    for path, _text, _obj, _order in snap["logs"]:
        lane = file_lane(path)
        key = lane.lower()
        if key in used_lower:
            continue
        used_lower.add(key)
        f = facts.get(key, {})
        put("lanes", lane, {
            "lane": lane,
            "aliases": json.dumps(aliases_of.get(key, []), ensure_ascii=False),
            "home": f.get("home"), "workstation": None, "started_utc": None,
            "objects_cell": None, "handoff_path": None, "state_phrase": None,
            "session_ids": json.dumps([]), "last_session": f.get("sid"),
            "archived": 0, "owner": None, "row_file": None, "row_ordinal": None,
            "row_text": None})
    for key, f in facts.items():
        lane = first_log_of.get(key, key)
        for path, ordinal, tid, agent in f["paused"]:
            # KEYED AS `log_lines` IS (Copilot round 1 on #164): two logs whose
            # names differ only by case are two files, and a PAUSED at the same
            # line of each is two pointers, never one written over the other.
            rec_id = f"{lane}:log:{ordinal}"
            if rec_id in out["transcript_pointers"]:
                rec_id = f"{path}:log:{ordinal}"
            put("transcript_pointers", rec_id, {
                "lane": lane, "kind": "paused", "transcript_id": tid, "agent": agent,
                "position": ordinal})
    for table in ("transcript_pointers",):
        for record in out[table].values():
            for col in TABLE_COLUMNS[table]:
                record.setdefault(col, None)
    return out


# ================================================== the owner column's reader

def managed_projection(lane: str) -> str:
    """`legacy`, `managed <owner>` or `unknown`, AND NOTHING ELSE DECIDES IT.

    #97's own reader answers: `lanes-edit.sh managed-projection <lane>` exits 0
    with the owner, 8 for a legacy lane, anything else for UNKNOWN. This file
    carries no parser of the marker, so a malformed one can never be read here
    as `legacy` (Amendment 14(e)); a reader that could not be run at all is
    UNKNOWN for the same reason."""
    helper = lanes_edit_path()
    if not helper:
        return "unknown"
    try:
        proc = subprocess.run([helper, "managed-projection", lane], capture_output=True,
                              text=True, check=False, env=helper_env(),
                              stdin=subprocess.DEVNULL, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return "unknown"
    if proc.returncode == 0 and proc.stdout.strip():
        return f"managed {proc.stdout.strip().splitlines()[0]}"
    if proc.returncode == 8:
        return "legacy"
    return "unknown"


def fill_owners(records: dict, stored_lanes: dict | None) -> int:
    """Ask `managed-projection` for every lane whose row text is new or changed
    (all of them where `stored_lanes` is None, which is `reconcile`), and carry
    the stored answer over for a row that has not moved. An `unknown` is never
    carried: it may be a read that failed, and asking again is how it clears.
    Returns how many lanes were asked."""
    ask = []
    for rec_id, rec in records["lanes"].items():
        old = (stored_lanes or {}).get(rec_id)
        if stored_lanes is not None and old is not None and old.get("row_text") == rec["row_text"] \
                and old.get("lane") == rec["lane"] and old.get("owner") \
                and old.get("owner") != "unknown":
            rec["owner"] = old["owner"]
        else:
            ask.append(rec_id)
    if ask:
        workers = max(1, min(8, len(ask)))
        with ThreadPoolExecutor(max_workers=workers) as pool:
            answers = list(pool.map(lambda rid: managed_projection(records["lanes"][rid]["lane"]),
                                    ask))
        for rec_id, owner in zip(ask, answers):
            records["lanes"][rec_id]["owner"] = owner
    return len(ask)


# =============================================================== the stores

def ddl(dialect: str, schema: str) -> list[str]:
    q = (lambda name: f'"{schema}".{name}') if dialect == "postgres" else (lambda name: name)
    big = "BIGINT" if dialect == "postgres" else "INTEGER"
    stmts = [
        f"CREATE TABLE IF NOT EXISTS {q('schema_version')} "
        f"(version INTEGER NOT NULL, applied_utc TEXT NOT NULL)",
        f"CREATE TABLE IF NOT EXISTS {q('provenance')} (source TEXT NOT NULL PRIMARY KEY, "
        f"commit_sha TEXT, generation {big}, indexed_utc TEXT NOT NULL, "
        f"schema_version INTEGER NOT NULL)",
    ]
    for table, cols in TABLE_COLUMNS.items():
        defs = ["source TEXT NOT NULL", "record_id TEXT NOT NULL"]
        for col in cols:
            defs.append(f"{col} {big if col in INTEGER_COLUMNS else 'TEXT'}")
        defs += ["digest TEXT NOT NULL", "provenance TEXT", "indexed_utc TEXT NOT NULL",
                 "schema_version INTEGER NOT NULL", "PRIMARY KEY (source, record_id)"]
        stmts.append(f"CREATE TABLE IF NOT EXISTS {q(table)} ({', '.join(defs)})")
    # HOLDS ARE COMPUTED, NEVER STORED (14(e)), and computed AS `holders_of`
    # COMPUTES THEM (Copilot round 2 on #164), which is `who`'s answer:
    #   * a lane's state on an object is its own LAST line on it - the lane
    #     compared case-insensitively (Amendment 15), so two logs one case
    #     apart are one lane - and "last" is the FILE-ORDERED position
    #     (file, then line; PER_LANE_AWK's `file "\034" %09d line`), never
    #     the UTC (R14);
    #   * it holds while that verb is open, UNLESS another lane's own last line
    #     on the object is a TAKEOVER (`superseded_by`, R18, #30).
    # The file comparison is BYTE order, as awk's string comparison is: SQLite's
    # default BINARY collation, and Postgres's "C".
    coll = ' COLLATE "C"' if dialect == "postgres" else ""
    ll = q("log_lines")
    view = (
        f"WITH ev AS (SELECT source, lane, lower(lane) AS lk, object, verb, utc, session, "
        f"file, ordinal FROM {ll} WHERE unreadable = 0 AND object IS NOT NULL "
        f"AND object NOT LIKE 'lane:%'), "
        f"last AS (SELECT e.* FROM ev e WHERE NOT EXISTS (SELECT 1 FROM ev m "
        f"WHERE m.source = e.source AND m.object = e.object AND m.lk = e.lk "
        f"AND (m.file{coll} > e.file{coll} OR (m.file = e.file AND m.ordinal > e.ordinal)))) "
        f"SELECT h.source, h.lane, h.object, h.verb, h.utc, h.session, h.file, h.ordinal "
        f"FROM last h WHERE h.verb IN ({', '.join(repr(v) for v in OPEN_VERBS)}) "
        f"AND NOT EXISTS (SELECT 1 FROM last t WHERE t.source = h.source "
        f"AND t.object = h.object AND t.lk <> h.lk AND t.verb = 'TAKEOVER')")
    stmts.append(f"CREATE INDEX IF NOT EXISTS log_lines_by_object ON {ll} (source, object)")
    if dialect == "postgres":
        stmts.append(f"CREATE OR REPLACE VIEW {q('holds')} AS {view}")
    else:
        stmts.append(f"CREATE VIEW IF NOT EXISTS holds AS {view}")
    stmts.append(
        f"INSERT INTO {q('schema_version')} (version, applied_utc) SELECT {SCHEMA_VERSION}, "
        f"'{utc_now()}' WHERE NOT EXISTS (SELECT 1 FROM {q('schema_version')})")
    return stmts


class SqliteStore:
    dialect = "sqlite"

    def __init__(self, cfg: dict):
        self.path = cfg["sqlite"]
        self.label = "sqlite"
        self.where = self.path
        self.conn = None

    def open_read(self):
        import sqlite3
        if not os.path.exists(self.path):
            raise StoreUnusable("missing", f"{self.path} does not exist")
        try:
            self.conn = sqlite3.connect(f"file:{self.path}?mode=ro", uri=True, timeout=10)
            self.conn.execute("SELECT 1 FROM sqlite_master LIMIT 1").fetchall()
        except sqlite3.Error as exc:
            raise StoreUnusable("unreachable", f"{self.path}: {exc}")
        self._check_schema(writing=False)

    def open_write(self):
        import sqlite3
        os.makedirs(os.path.dirname(self.path), mode=0o700, exist_ok=True)
        try:
            self.conn = sqlite3.connect(self.path, timeout=30, isolation_level=None)
            # EVERY WRITE-OPEN, NOT ONLY THE FIRST (Copilot round 2 on #164): a
            # store whose mode drifted to 0644 is made private again before
            # another row goes into it, or nothing more is written.
            try:
                os.chmod(self.path, 0o600)
            except OSError as exc:
                raise StoreUnusable("unreachable", f"{self.path} cannot be made 0600 "
                                    f"({exc.strerror or exc}); nothing written")
            have = {r[0] for r in self.conn.execute(
                "SELECT name FROM sqlite_master WHERE type IN ('table','view')")}
            if "schema_version" in have:
                self._check_schema(writing=True)
            self.conn.execute("BEGIN IMMEDIATE")
            for stmt in ddl("sqlite", ""):
                self.conn.execute(stmt)
            self.conn.execute("COMMIT")
        except sqlite3.Error as exc:
            raise StoreUnusable("unreachable", f"{self.path}: {exc}")
        self._check_schema(writing=True)

    def _check_schema(self, writing: bool):
        import sqlite3
        try:
            rows = self.conn.execute("SELECT version FROM schema_version").fetchall()
        except sqlite3.Error:
            if writing:
                return
            raise StoreUnusable("wiped", f"{self.path} carries no schema_version table")
        versions = {r[0] for r in rows}
        if not versions:
            if writing:
                return
            raise StoreUnusable("wiped", f"{self.path} carries no schema_version row")
        if versions != {SCHEMA_VERSION}:
            raise StoreUnusable("unknown-schema",
                                f"schema {sorted(versions)} in {self.path}; this "
                                f"{PROG} knows {SCHEMA_VERSION}")

    def provenance(self, source: str) -> dict | None:
        import sqlite3
        try:
            row = self.conn.execute(
                "SELECT commit_sha, generation, indexed_utc, schema_version FROM provenance "
                "WHERE source = ?", (source,)).fetchone()
        except sqlite3.Error as exc:
            raise StoreUnusable("wiped", f"{self.path}: {exc}")
        if row is None:
            return None
        return {"commit_sha": row[0], "generation": row[1], "indexed_utc": row[2],
                "schema_version": row[3]}

    def all_provenance(self) -> list:
        import sqlite3
        try:
            return [{"source": r[0], "commit_sha": r[1], "generation": r[2], "indexed_utc": r[3],
                     "schema_version": r[4]} for r in self.conn.execute(
                         "SELECT source, commit_sha, generation, indexed_utc, schema_version "
                         "FROM provenance ORDER BY source")]
        except sqlite3.Error as exc:
            raise StoreUnusable("wiped", f"{self.path}: {exc}")

    def rows(self, table: str, source: str, columns: list[str]) -> list:
        # A TABLE THAT CANNOT BE READ IS A STORE THAT CANNOT ANSWER, said as the
        # provenance's reads say it (opensoft/openRepoTools#173, Copilot's
        # fourth review of #171): a `worktrees` table dropped or damaged under
        # valid provenance was a traceback, before `status` reached its
        # `rows: unread` line and before `export` could write its `why`.
        import sqlite3
        cols = ", ".join(["record_id"] + columns)
        try:
            return [dict(zip(["record_id"] + columns, r)) for r in self.conn.execute(
                f"SELECT {cols} FROM {table} WHERE source = ?", (source,))]
        except sqlite3.Error as exc:
            raise StoreUnusable("wiped", f"{self.path}: {exc}")

    def read_image(self, source: str, reads: list) -> tuple:
        """`provenance(source)`, then `rows(table, source, columns)` for each
        `(table, columns)` of `reads`, as ONE READ SNAPSHOT (opensoft/openRepoTools#166
        item 1). Each statement was its own snapshot, so a sync committing
        between two of them made an image of two commits under a `meta` naming
        the first. One read transaction holds the SHARED lock in the rollback
        journal - a writer's commit waits the fraction of a second the export
        takes - and in WAL mode it is a snapshot."""
        import sqlite3
        try:
            self.conn.execute("BEGIN")
        except sqlite3.Error as exc:
            raise StoreUnusable("unreachable", f"{self.path}: {exc}")
        try:
            prov = self.provenance(source)
            tables = [self.rows(table, source, columns) for table, columns in reads]
        finally:
            # A read transaction ends however its reads did; nothing was written.
            try:
                self.conn.execute("COMMIT")
            except sqlite3.Error:
                pass
        return prov, tables

    def apply(self, source: str, old: dict | None, new_sha: str, upserts: dict,
              deletes: dict, generation: int | None = None) -> None:
        """The rows and the provenance, ONE transaction, the compare-and-swap
        first. `new_sha` is the register's commit, or the inventory's
        fingerprint of its whole table (#161), and `generation` the inventory's
        sync count; a record carrying `_provenance` is stamped with that rather
        than with `new_sha` - the generation its tree's own record was filed
        under."""
        import sqlite3
        now = utc_now()
        try:
            self.conn.execute("BEGIN IMMEDIATE")
            cur = self.conn.execute("SELECT commit_sha FROM provenance WHERE source = ?",
                                    (source,)).fetchone()
            want = old["commit_sha"] if old else None
            if (cur[0] if cur else None) != want or (cur is None) != (old is None):
                self.conn.execute("ROLLBACK")
                raise CasLost(f"the provenance of {source} moved under this sync "
                              f"(it read {str(want)[:12]}, the store now holds "
                              f"{str(cur[0] if cur else None)[:12]}); nothing was written")
            if cur is None:
                self.conn.execute(
                    "INSERT INTO provenance (source, commit_sha, generation, indexed_utc, "
                    "schema_version) VALUES (?, ?, ?, ?, ?)",
                    (source, new_sha, generation, now, SCHEMA_VERSION))
            else:
                self.conn.execute(
                    "UPDATE provenance SET commit_sha = ?, generation = ?, indexed_utc = ?, "
                    "schema_version = ? WHERE source = ?",
                    (new_sha, generation, now, SCHEMA_VERSION, source))
            for table, ids in deletes.items():
                for rec_id in ids:
                    self.conn.execute(f"DELETE FROM {table} WHERE source = ? AND record_id = ?",
                                      (source, rec_id))
            for table, recs in upserts.items():
                cols = TABLE_COLUMNS[table]
                allc = ["source", "record_id"] + cols + ["digest", "provenance", "indexed_utc",
                                                         "schema_version"]
                sets = ", ".join(f"{c} = excluded.{c}" for c in allc[2:])
                sql = (f"INSERT INTO {table} ({', '.join(allc)}) VALUES "
                       f"({', '.join('?' for _ in allc)}) ON CONFLICT (source, record_id) "
                       f"DO UPDATE SET {sets}")
                self.conn.executemany(sql, [
                    [source, rec_id] + [rec.get(c) for c in cols] +
                    [rec["digest"], rec.get("_provenance", new_sha), now, SCHEMA_VERSION]
                    for rec_id, rec in recs.items()])
            self.conn.execute("COMMIT")
        except sqlite3.Error as exc:
            try:
                self.conn.execute("ROLLBACK")
            except sqlite3.Error:
                pass
            raise StoreUnusable("unreachable", f"{self.path}: {exc}")


def _pg_quote(value) -> str:
    if value is None:
        return "NULL"
    if isinstance(value, int):
        return str(value)
    return "'" + str(value).replace("'", "''") + "'"


def _pg_unescape(field: str):
    """One field of `COPY ... TO STDOUT` in TEXT format: `\\N` is NULL and a
    backslash escapes the rest, exactly as the server wrote it."""
    if field == "\\N":
        return None
    if "\\" not in field:
        return field
    out, i, n = [], 0, len(field)
    simple = {"b": "\b", "f": "\f", "n": "\n", "r": "\r", "t": "\t", "v": "\v", "\\": "\\"}
    while i < n:
        ch = field[i]
        if ch != "\\" or i + 1 >= n:
            out.append(ch)
            i += 1
            continue
        nxt = field[i + 1]
        if nxt in simple:
            out.append(simple[nxt])
            i += 2
        elif nxt in "01234567":
            j = i + 1
            while j < n and j < i + 4 and field[j] in "01234567":
                j += 1
            out.append(chr(int(field[i + 1:j], 8)))
            i = j
        elif nxt == "x":
            j = i + 2
            while j < n and j < i + 4 and field[j] in "0123456789abcdefABCDEF":
                j += 1
            out.append(chr(int(field[i + 2:j], 16)) if j > i + 2 else "x")
            i = j
        else:
            out.append(nxt)
            i += 2
    return "".join(out)


#: THE SQL REGISTER'S TWO ROLES (FR-012; L1-A5; design Y:3455-3461, "Roles and
#: credentials"), which `PostgresStore(cfg, role)` takes beside #160's `writer`
#: and `reader`. REGISTER-WRITER connects with `register_url=` and
#: `register_passfile=`; READER with `reader_url=` and `reader_passfile=`, never
#: with a writer's file. Each reads `register_schema=`, and every call either
#: makes is a register path.
REGISTER_ROLES = ("register_writer", "register_reader")

#: THE ARGV OF EVERY REGISTER CALL, exactly (contract §2.2): #160's
#: `--no-psqlrc -X -q -v ON_ERROR_STOP=1`; `-A -t`, so a SELECT's value prints
#: bare while COPY's rows are unchanged; and `VERBOSITY=verbose` with
#: `SHOW_CONTEXT=never`, so `psql`'s first line on stderr is
#: `ERROR:  <SQLSTATE>: <message>` (Y:2590). No connection string and no `-d`
#: (Y:3491): the connection is the environment's alone.
REGISTER_PSQL_ARGS = ("--no-psqlrc", "-X", "-q", "-A", "-t", "-v", "ON_ERROR_STOP=1",
                      "-v", "VERBOSITY=verbose", "-v", "SHOW_CONTEXT=never")

#: D9'S ROWS (design Y:3501-3537; contract §2.4), one per kind of register call:
#: `lock_timeout` and `statement_timeout` in ms, which ride the startup
#: packet's `options=` as `PGOPTIONS`, `-c lock_timeout=<ms> -c
#: statement_timeout=<ms>` (Y:1573, Y:3503); the least client timer the row
#: gives, in s; and the role that runs it, or None where both do. A row's
#: client timer is `N_a`·`c` + its statement bound + 1 s, never below that
#: least figure (Y:3509-3511). The guard's has none: its caller cuts it at the
#: parse's start line, `T0 + 3.75 s` (Y:3518). The bounds need a direct
#: connection to the primary, never through a pooler, which drops `options`
#: (C13, Y:1575). `import --single` and `render --revert` take the commit's
#: row for their commit call and the writer's rows for the rest (Y:3536-3537).
#: The mode query runs no `psql` (Y:3521); the service's child (Y:3519) and a
#: migration (Y:3531) are not a role's calls.
REGISTER_BOUNDS = {
    # row: (lock_timeout ms, statement_timeout ms, least timer s, role)
    "snapshot": (2000, 5000, 8, "register_writer"),     # `register snapshot`, `act-begin`'s: S (Y:3522)
    "commit": (2000, 5000, 8, "register_writer"),       # `register commit`: C (Y:3523)
    "lookup": (2000, 6000, 9, "register_writer"),       # `journal --write-id`, each try: T_L (Y:3524)
    "read": (1000, 3000, 6, "register_reader"),         # `register read` forms 1, 3; `journal --last`: T_r (Y:3526)
    "guard": (1000, 1500, None, "register_reader"),     # `register read --for guard`, forms 2, 4 (Y:3518)
    # THE GUARD'S WHOLE-FILE FETCH (lane 3's ruling, opensoft/openRepoTools#165
    # 6783977598, item (3), on lane 5's question 3, 6783860030): the detached
    # `lanes-index` call the guard starts for the whole file its cut read would
    # lose (design W:4290-4300) is a call of its own, never the cut read's
    # `psql`, which that read's own timer ends. READER, so on `reader_url=`:
    # connect `c`, `lock_timeout` 1000 ms, `statement_timeout` 14000 ms, and a
    # client timer of `N_a`·`c` + 15 s, which is this row's rule, `N_a`·`c` + the
    # statement bound + 1 s, and is 17 s at `c` = 2 and `N_a` = 1. The guard
    # row's 1500 ms would cut the very fetch this call exists to finish.
    "guard-fetch": (1000, 14000, 17, "register_reader"),
    "render": (1000, 10000, 15, None),                  # `journal --since`, `render`; `reconcile` (Y:3527)
    "status": (1000, 5000, 8, "register_reader"),       # `status` (Y:3528)
    "rollback": (5000, 10000, 15, "register_writer"),   # `rollback`, each call (Y:3529)
    "import": (2000, 300000, 330, "register_writer"),   # `import` (Y:3530)
    "cutover": (5000, 10000, 15, "register_writer"),    # `cutover`, `switch_to_files`, `record_marker` (Y:3532-3534)
    "outage": (2000, 5000, 8, "register_writer"),       # `outage declare`'s database probe (Y:3535)
}

#: #160's `\echo` marker, as ONE request carries it (contract §2.3; Y:1417): a
#: `COPY` whose one row is the marker line `\echo` printed, byte for byte, so
#: `_query_many`'s parse reads both alike. COPY's text format escapes only
#: backslash, newline, carriage return, tab and the other C escapes, never
#: `\x1e`.
REGISTER_MARKER_COPY = r"COPY (SELECT E'\x1eLANES-INDEX-NEXT') TO STDOUT"

#: `psql` 15 OR LATER (FR-012; block :152; Y:5876, Y:5914): a register call
#: sends its statements as one request joined by `\;`, and a `psql` before 15
#: prints only that request's last result. `ready` asks for 16 (Y-ops:445).
PSQL_MIN_MAJOR = 15

#: Each `psql`'s version, read ONCE PER PROCESS by `psql --version`, keyed by
#: the path run: (its major number, or None where none could be read; the
#: version as it named it).
_PSQL_VERSIONS: dict = {}


def _psql_version_of(text: str) -> tuple:
    """`psql --version`'s answer as (major or None, the version as named):
    `psql (PostgreSQL) 16.15 (Ubuntu ...)` is (16, "16.15"). Anything else
    is (None, its first line, printable and at most 60 characters)."""
    first = (text.strip().splitlines() or [""])[0]
    match = re.search(r"\(PostgreSQL\) ([0-9]+)([0-9A-Za-z.]*)", first)
    if match:
        return int(match.group(1)), match.group(1) + match.group(2)
    return None, re.sub(r"[^\x20-\x7e]", "?", first)[:60]


class PsqlFailed(StoreUnusable):
    """A register call's `psql` that did not answer (FR-012): a
    `StoreUnusable` of kind `unreachable`, as #160 reads one, with what a
    register command maps to its own code KEPT APART for it (contract §2.2's
    exits, §2.6, §2.7). It maps nothing itself.

    `psql_exit` is `psql`'s exit - 0 only for an answer that is not UTF-8,
    negative where a signal ended it - or None where it never ended on its
    own. `stderr` is its whole stderr, and `first_line` that stderr's first
    line, where §2.6 reads the code. `timer_expired` is True where the call's
    client timer (D9) cut it. `ran` is False where no `psql` was handed the
    request: none could be started, the timer was spent before it, or the
    version check refused it - so the call cannot be in doubt."""

    def __init__(self, kind: str, detail: str, *, psql_exit: int | None = None,
                 stderr: str = "", first_line: str = "", timer_expired: bool = False,
                 ran: bool = True):
        super().__init__(kind, detail)
        self.psql_exit = psql_exit
        self.stderr = stderr
        self.first_line = first_line
        self.timer_expired = timer_expired
        self.ran = ran


class PsqlTooOld(PsqlFailed):
    """`psql` older than 15, or one whose `--version` names no version this
    build can read (FR-012; block :152): 69, naming the version, raised
    before anything is sent, so `ran` is False (contract §2.7's 69 row: "a
    `psql` that cannot be started or is too old"). `version` is the version
    as `psql --version` named it."""

    def __init__(self, version: str, readable: bool):
        if readable:
            why = (f"psql {version} is older than {PSQL_MIN_MAJOR}: a register call sends "
                   f"its statements as ONE request joined by `\\;`, and a psql before "
                   f"{PSQL_MIN_MAJOR} prints only its last result (FR-012)")
        else:
            why = (f"psql --version names no version this build can read "
                   f"({version or 'nothing'!r}), and a register call needs psql "
                   f"{PSQL_MIN_MAJOR} or later (FR-012)")
        super().__init__("psql-too-old", f"{why}; nothing was sent", ran=False)
        self.version = version


class PostgresStore:
    """QA Postgres, reached ONLY through `psql` and ONLY where `url=` is
    configured. Nothing here imports a driver: `psql` is libpq's own client,
    and the password it needs is in the 0600 file `PGPASSFILE` names - never
    in this process's arguments and never in an environment it hands on. The
    connection itself reaches `psql` as `PG*` variables (Question 11), never
    as `-d <url>`.

    THE SQL REGISTER'S ROLES (FR-012): `register_writer` and `register_reader`
    connect with `register_url=` and `reader_url=`, read `register_schema=`,
    and make register calls only: one request each (`request`, and
    `_query_many` with a D9 `row`), with D9's bounds, the URL as the whole
    connection and `psql` 15 or later. #160's index methods refuse on them,
    since a register path names its own client timer."""

    dialect = "postgres"
    #: #160'S INDEX PATHS KEEP THEIR BOUNDS (Y:4970, "the index paths keep 5 s
    #: and 300 s"): `PGCONNECT_TIMEOUT` defaults to 5, and an inherited value
    #: or the URL's `connect_timeout=` wins; the client timer is 300 s.
    INDEX_CONNECT_TIMEOUT = "5"
    INDEX_TIMER_S = 300

    def __init__(self, cfg: dict, role: str):
        #: A REGISTER ROLE (FR-012): every call it makes is a register path,
        #: and its `search_path` is `register_schema=`.
        self.role = role
        self.register = role in REGISTER_ROLES
        self.schema = ((cfg.get("register_schema") or "lanes_register") if self.register
                       else cfg["schema"])
        if role == "register_writer":
            # THE REGISTER'S WRITES: this engineer's REGISTER-WRITER login, never
            # the indexer's `url=` (Y:3459; contract §2.5).
            if not cfg.get("register_url"):
                raise Refusal(
                    "the configuration names no `register_url=`: the register's writes "
                    "connect only as this engineer's REGISTER-WRITER login (FR-012), never "
                    "as the indexer's `url=`")
            self.url, self.passfile = cfg["register_url"], cfg.get("register_passfile") or ""
            key = "register_url"
        elif role == "register_reader":
            # THE REGISTER'S READS: this engineer's READER login, with its own
            # file and never a writer's - not `register_passfile=`, and not #160's
            # `passfile=` either (Y:3460; contract §2.5). Only beside a
            # `register_url=`: without one, `reader_url=` is #160's, and
            # `load_config` never held it to R09's TLS check.
            if not cfg.get("register_url") or not cfg.get("reader_url"):
                raise Refusal(
                    "the register's reads connect only as this engineer's READER login, "
                    "`reader_url=`, beside the `register_url=` it pairs with (FR-012), and "
                    "never with the writer's credential: the configuration names "
                    + ("no `register_url=`" if not cfg.get("register_url") else
                       "no `reader_url=`"))
            self.url, self.passfile = cfg["reader_url"], cfg.get("reader_passfile") or ""
            key = "reader_url"
        elif role == "reader":
            # NEVER THE WRITER'S CREDENTIAL FOR A READ (Copilot round 1 on #164).
            # The writer is the indexer's and no session's (14(c)), and `export`
            # is run by a session typing `--index`: with no `reader_url=` the
            # read is refused, and the read flags answer from the sources.
            if not cfg.get("reader_url"):
                raise Refusal(
                    "the configuration names a Postgres `url=` and no `reader_url=`: the "
                    "reads (`status`, `--index`) connect only as the SELECT-only reader, "
                    "never with the writer's credential (Amendment 14(c))")
            self.url, self.passfile = cfg["reader_url"], cfg.get("reader_passfile") or cfg["passfile"]
            key = "reader_url"
        elif role == "writer":
            self.url, self.passfile = cfg["url"], cfg["passfile"]
            key = "url"
        else:
            raise ValueError(f"PostgresStore has no role {role!r}: it takes "
                             f"{', '.join(('writer', 'reader') + REGISTER_ROLES)}")
        #: The configuration key whose URL this store connects with.
        self.key = key
        # THE CONNECTION, MAPPED ONCE (Question 11; SVC-2): the variables every
        # `psql` this store runs connects with, refused here, before any `psql`,
        # where the URL cannot be mapped.
        self.pg_env = pg_url_env(self.url, f"`{key}=` in {cfg.get('path') or 'the configuration'}")
        #: `c` (D9): the URL's `connect_timeout=`, else 2. A register path's
        #: `PGCONNECT_TIMEOUT`, and the connect bound in its client timer.
        self.connect_timeout = int(self.pg_env.get("PGCONNECT_TIMEOUT", CONNECT_TIMEOUT_DEFAULT))
        #: `N_a` (D9): `register_addresses=`, the addresses the register's
        #: endpoint resolves to, default 1; libpq tries `c` on each in turn.
        self.addresses = int(cfg.get("register_addresses") or 1) if self.register else 1
        self.label = "postgres"
        self.where = re.sub(r"^[A-Za-z][A-Za-z0-9+.-]*://", "", self.url).split("?", 1)[0]
        self.psql = shutil.which("psql") or ""

    def _env(self, *, register: bool = False, options: str | None = None) -> dict:
        # THE CONFIGURED PASSWORD FILE OR NONE AT ALL (14(c); Copilot on #164):
        # an inherited `PGPASSWORD` or `PGPASSFILE` is dropped, and with no
        # `passfile=` libpq is handed an EMPTY 0600 file of this command's own -
        # never left to find `~/.pgpass` or a file some other environment named.
        # So are `PGSERVICEFILE`, `PGSYSCONFDIR` and `PGSERVICE`
        # (`PG_ENV_DROPPED`), and the URL's own parts are set over whatever was
        # inherited, as `-d <url>` set them over it.
        if register or self.register:
            # THE URL IS THE WHOLE CONNECTION ON A REGISTER PATH (lane 3's ruling,
            # #165 6747611042; contract §2.2): EVERY inherited variable whose name
            # begins `PG` is dropped first - `PGHOSTADDR`, `PGSSLMODE`, `PGOPTIONS`,
            # `PGTARGETSESSIONATTRS` and the rest - so `psql` gets only the URL's
            # mapping, the configured password file, `PGCONNECT_TIMEOUT` at `c`
            # (set, not defaulted, so an inherited value can never lengthen the
            # connect bound its client timer counts: Y:4970), the call's own
            # bounds as `PGOPTIONS`, and `PGAPPNAME`.
            env = {k: v for k, v in os.environ.items() if not k.startswith("PG")}
            env.update(self.pg_env)
            env["PGPASSFILE"] = self.passfile or _no_password_file()
            env["PGCONNECT_TIMEOUT"] = str(self.connect_timeout)
            if options:
                env["PGOPTIONS"] = options
            env["PGAPPNAME"] = PROG
            return env
        env = {k: v for k, v in os.environ.items() if k not in PG_ENV_DROPPED}
        env.update(self.pg_env)
        env["PGPASSFILE"] = self.passfile or _no_password_file()
        env.setdefault("PGCONNECT_TIMEOUT", self.INDEX_CONNECT_TIMEOUT)
        env["PGAPPNAME"] = PROG
        return env

    def _run(self, script: str, *, timer: float | None = None,
             register: bool = False, options: str | None = None) -> str:
        """`script` on `psql`'s stdin, its connection in the environment alone.

        `timer` is the call's client timer (D9), `subprocess.run`'s `timeout` on
        the whole `psql`, the connect inside it. #160's index paths keep
        `INDEX_TIMER_S`. A `register` path - every call of a register role -
        names its own timer and its D9 bounds as `options`, and runs as
        `_run_register` runs it."""
        register = register or self.register
        if timer is None:
            if register:
                raise ValueError("a register path's psql call names its own client timer (D9)")
            timer = self.INDEX_TIMER_S
        if register and not options:
            raise ValueError("a register path's psql call carries its D9 bounds as PGOPTIONS")
        if not self.psql:
            if register:
                raise PsqlFailed("unreachable", f"`{self.key}=` is configured and there is no "
                                 f"`psql` on PATH", ran=False)
            raise StoreUnusable("unreachable", "`url=` is configured and there is no `psql` on PATH")
        if register:
            return self._run_register(script, timer, options)
        try:
            proc = subprocess.run(
                [self.psql, "--no-psqlrc", "-X", "-q", "-v", "ON_ERROR_STOP=1"],
                input=script, capture_output=True, text=True, check=False,
                env=self._env(register=register), timeout=timer)
        except subprocess.TimeoutExpired:
            raise StoreUnusable("unreachable", f"psql did not answer within {timer:g} s")
        except OSError as exc:
            raise StoreUnusable("unreachable", f"psql could not be run: {exc}")
        if proc.returncode != 0:
            err = (proc.stderr.strip().splitlines() or [f"psql exited {proc.returncode}"])
            if "lanes-index: provenance moved" in proc.stderr:
                raise CasLost(err[-1])
            if proc.returncode == 2:
                raise StoreUnusable("unreachable", err[0])
            raise StoreUnusable("unreachable", err[-1])
        return proc.stdout

    def _run_register(self, script: str, timer: float, options: str) -> str:
        """`_run` on a register path (FR-012): `REGISTER_PSQL_ARGS`, the
        register environment with `options` as `PGOPTIONS`, and `psql` 15 or
        later, checked once per process inside this call's timer, so the
        whole call stays inside its D9 client timer.

        A `psql` that does not answer raises `PsqlFailed`, every kind as
        `unreachable`, with its exit, its stderr's first line and the timer's
        expiry kept apart; the code each means is the register command's to
        give (contract §2.2, §2.6, §2.7)."""
        deadline = time.monotonic() + timer
        env = self._env(register=True, options=options)
        self._check_psql_version(env, deadline)
        left = deadline - time.monotonic()
        expired = f"psql did not answer within {timer:g} s"
        if left <= 0:
            raise PsqlFailed("unreachable", expired, timer_expired=True, ran=False)
        try:
            proc = subprocess.run([self.psql, *REGISTER_PSQL_ARGS], input=script.encode("utf-8"),
                                  capture_output=True, check=False, env=env, timeout=left)
        except subprocess.TimeoutExpired as exc:
            stderr = (exc.stderr or b"").decode("utf-8", "replace")
            raise PsqlFailed("unreachable", expired, stderr=stderr,
                             first_line=(stderr.strip().splitlines() or [""])[0],
                             timer_expired=True)
        except OSError as exc:
            raise PsqlFailed("unreachable", f"psql could not be run: {exc}", ran=False)
        stderr = proc.stderr.decode("utf-8", "replace")
        first = (stderr.strip().splitlines() or [""])[0]
        if proc.returncode != 0:
            raise PsqlFailed("unreachable", first or f"psql exited {proc.returncode}",
                             psql_exit=proc.returncode, stderr=stderr, first_line=first)
        try:
            return proc.stdout.decode("utf-8")
        except UnicodeDecodeError:
            raise PsqlFailed("unreachable", "psql exited 0 with an answer that is not UTF-8",
                             psql_exit=0, stderr=stderr, first_line=first)

    def _check_psql_version(self, env: dict, deadline: float) -> None:
        """`psql` 15 OR LATER, checked ONCE PER PROCESS (FR-012; block :152;
        Y:5914) by `psql --version`, in the register environment and inside
        the call's timer. An older one, or one that names no version this
        build can read, is `PsqlTooOld`: 69, naming the version, with nothing
        sent. A `--version` that cannot be run or does not answer is a
        `PsqlFailed` with nothing sent, and is asked again by the next call."""
        known = _PSQL_VERSIONS.get(self.psql)
        if known is None:
            left = deadline - time.monotonic()
            if left <= 0:
                raise PsqlFailed("unreachable", "psql --version did not answer within its "
                                 "call's client timer", timer_expired=True, ran=False)
            try:
                proc = subprocess.run([self.psql, "--version"], stdin=subprocess.DEVNULL,
                                      capture_output=True, check=False, env=env, timeout=left)
            except subprocess.TimeoutExpired:
                raise PsqlFailed("unreachable", "psql --version did not answer within its "
                                 "call's client timer", timer_expired=True, ran=False)
            except OSError as exc:
                raise PsqlFailed("unreachable", f"psql could not be run: {exc}", ran=False)
            known = _psql_version_of(proc.stdout.decode("utf-8", "replace")
                                     if proc.returncode == 0 else "")
            _PSQL_VERSIONS[self.psql] = known
        major, version = known
        if major is None or major < PSQL_MIN_MAJOR:
            raise PsqlTooOld(version, major is not None)

    def bounds(self, row: str, timer: float | None = None, *,
               first_request_at: float | None = None) -> tuple[str, float]:
        """D9's `row` for one call of this register role: its `PGOPTIONS`,
        `-c lock_timeout=<ms> -c statement_timeout=<ms>`, and its client timer
        in s, `N_a`·`c` + the statement bound + 1 s and never below the row's
        figure (`REGISTER_BOUNDS`). Only the guard's caller passes `timer`, its
        cut at `T0 + 3.75 s`; every other row sets its own. A row of the other
        role is refused: a read never connects with the writer's credential.

        THE SECOND REQUEST OF A MISSED SNAPSHOT (lane 3's ruling on SHOULD-2 of
        lane 1's review of T111, opensoft/openRepoTools#165 6780364102, "Lane
        1" item (1): "`bounds` cuts the second request of a missed snapshot to
        what is left of `S` from its first request's start, and ends 69 where
        nothing is left. `T_write`, `bound_s` and D7 do not change."). On the
        `snapshot` row alone, `first_request_at` is the `time.monotonic()`
        reading its caller took right before the snapshot's first request.
        The timer returned is then `S` less the time since that reading, never
        more than `S`, so the two requests together end by `S` from the first
        one's start. Where nothing is left, nothing is sent: `PsqlFailed`,
        with `timer_expired` and not `ran`, as the timer's other ends raise it,
        which `register snapshot` ends 69. Every other row refuses
        `first_request_at`, and the snapshot's first request passes none."""
        if not self.register:
            raise ValueError("only the register's roles carry D9's bounds; #160's index "
                             "paths keep theirs")
        if row not in REGISTER_BOUNDS:
            raise ValueError(f"D9 has no register row {row!r}")
        lock_ms, statement_ms, least_s, role = REGISTER_BOUNDS[row]
        if role and role != self.role:
            raise ValueError(f"D9's {row} row is run as {role}, and this store is {self.role}")
        if first_request_at is not None and row != "snapshot":
            raise ValueError(f"only D9's snapshot row is cut to what is left of its first "
                             f"request's timer, and this call is the {row} row")
        options = f"-c lock_timeout={lock_ms} -c statement_timeout={statement_ms}"
        if least_s is None:
            if timer is None:
                raise ValueError(f"D9's {row} row is cut by its caller, at T0 + 3.75 s (Y:3518)")
            return options, timer
        if timer is not None:
            raise ValueError(f"D9's {row} row sets its own client timer; only the guard's "
                             f"caller cuts one")
        own = max(least_s, self.addresses * self.connect_timeout + statement_ms / 1000 + 1)
        if first_request_at is None:
            return options, own
        left = own - max(0.0, time.monotonic() - first_request_at)
        if left <= 0:
            raise PsqlFailed("unreachable", f"the snapshot's client timer S, {own:g} s from its "
                             f"first request's start, has run out, so its second request was "
                             f"not sent", timer_expired=True, ran=False)
        return options, left

    def request(self, statements: list[str], row: str, *, timer: float | None = None,
                first_request_at: float | None = None) -> str:
        """ONE REQUEST PER CALL (FR-012; contract §2.3; Y:5876): `statements`
        joined by `psql`'s `\\;` into one simple-protocol Query on stdin,
        `A \\; B \\; C;`, so the call costs the connect and one round trip,
        with D9's bounds for `row` and its client timer (`bounds`). Since
        PostgreSQL 13 `statement_timeout` bounds each statement of it.

        Each statement is one SQL statement with no `;` of its own outside a
        literal, no `--` comment and no `psql` meta-command; a trailing `;` is
        dropped. Returns `psql`'s stdout; a failure is `PsqlFailed`.
        `first_request_at` is a missed snapshot's second request's, which
        `bounds` cuts (#165 6780364102)."""
        if not self.register:
            raise ValueError("only the register's roles send a register request")
        parts = [statement.strip().rstrip(";").rstrip() for statement in statements]
        if not parts or not all(parts):
            raise ValueError("a register request is one or more statements, none of them empty")
        options, timer = self.bounds(row, timer, first_request_at=first_request_at)
        return self._run(" \\; ".join(parts) + ";\n", timer=timer, register=True,
                         options=options)

    def _query_many(self, queries: list[str], snapshot: bool = False, *,
                    row: str | None = None, timer: float | None = None,
                    first_request_at: float | None = None) -> list[list[list]]:
        """Several SELECTs in ONE connection, each answered as TEXT-format COPY
        rows; a marker line no COPY row can be (one field, a control
        character) separates them. With `snapshot`, in ONE read-only
        REPEATABLE READ transaction: every SELECT reads the same snapshot.

        With `row`, a register role's read (FR-012; contract §2.3; Y:1417):
        the same statements as ONE request (`request`), joined by `\\;`, with
        the marker sent as `REGISTER_MARKER_COPY`, whose row is the line
        `\\echo` prints, so the output is byte-identical and the parse below is
        #160's, unchanged. `row` names D9's bounds; `timer` is the guard's
        cut; `first_request_at` is a missed snapshot's second request's, which
        `bounds` cuts to what is left of `S` (#165 6780364102)."""
        if first_request_at is not None and row is None:
            raise ValueError("first_request_at cuts a register row's timer, and this read "
                             "names no row")
        marker = "\x1eLANES-INDEX-NEXT"
        parts = [f"SET search_path TO \"{self.schema}\";"]
        if snapshot:
            parts.append("BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY;")
        for query in queries:
            parts.append(f"COPY ({query}) TO STDOUT;")
            parts.append("\\echo '\\036LANES-INDEX-NEXT'")
        if snapshot:
            parts.append("COMMIT;")
        if row is None:
            out = self._run("\n".join(parts) + "\n")
        else:
            out = self.request([REGISTER_MARKER_COPY if part.startswith("\\echo") else part
                                for part in parts], row, timer=timer,
                               first_request_at=first_request_at)
        results, current = [], []
        for line in out.split("\n"):
            if line == marker:
                results.append(current)
                current = []
                continue
            if line == "":
                continue
            current.append([_pg_unescape(f) for f in line.split("\t")])
        return results

    def open_read(self):
        try:
            res = self._query_many([
                f"SELECT version FROM \"{self.schema}\".schema_version"])
        except StoreUnusable as exc:
            if "does not exist" in exc.detail:
                raise StoreUnusable("wiped", exc.detail)
            raise
        versions = {int(r[0]) for r in res[0]} if res else set()
        if not versions:
            raise StoreUnusable("wiped", f"schema {self.schema} carries no schema_version row")
        if versions != {SCHEMA_VERSION}:
            raise StoreUnusable("unknown-schema", f"schema {sorted(versions)} in {self.schema}; "
                                f"this {PROG} knows {SCHEMA_VERSION}")

    def open_write(self):
        # THE VERSION FIRST (Copilot round 2 on #164): the DDL includes a
        # `CREATE OR REPLACE VIEW`, so running it against another schema's
        # store would rewrite that store before `open_read` called it
        # `unknown-schema`. Only an ABSENT schema (`wiped`) is bootstrapped.
        try:
            self.open_read()
            return
        except StoreUnusable as exc:
            if exc.kind != "wiped":
                raise
        script = ["SET standard_conforming_strings = on;", "BEGIN;"]
        script += [s + ";" for s in ddl("postgres", self.schema)]
        script.append("COMMIT;")
        self._run("\n".join(script) + "\n")
        self.open_read()

    def provenance(self, source: str) -> dict | None:
        res = self._query_many([self._provenance_query(source)])
        return self._provenance_of(res[0] if res else [])

    def all_provenance(self) -> list:
        res = self._query_many([
            "SELECT source, commit_sha, generation, indexed_utc, schema_version "
            "FROM provenance ORDER BY source"])
        return [{"source": r[0], "commit_sha": r[1], "generation": r[2], "indexed_utc": r[3],
                 "schema_version": r[4]} for r in (res[0] if res else [])]

    def rows(self, table: str, source: str, columns: list[str]) -> list:
        res = self._query_many([self._rows_query(table, source, columns)])
        return self._rows_of(res[0] if res else [], columns)

    @staticmethod
    def _provenance_query(source: str) -> str:
        return (f"SELECT commit_sha, generation, indexed_utc, schema_version FROM provenance "
                f"WHERE source = {_pg_quote(source)}")

    @staticmethod
    def _provenance_of(answer: list) -> dict | None:
        if not answer:
            return None
        r = answer[0]
        return {"commit_sha": r[0], "generation": r[1], "indexed_utc": r[2],
                "schema_version": r[3]}

    @staticmethod
    def _rows_query(table: str, source: str, columns: list[str]) -> str:
        return (f"SELECT {', '.join(['record_id'] + columns)} FROM {table} "
                f"WHERE source = {_pg_quote(source)}")

    @staticmethod
    def _rows_of(answer: list, columns: list[str]) -> list:
        out = []
        for r in answer:
            rec = dict(zip(["record_id"] + columns, r))
            for col in columns:
                if col in INTEGER_COLUMNS and rec[col] is not None:
                    rec[col] = int(rec[col])
            out.append(rec)
        return out

    def read_image(self, source: str, reads: list) -> tuple:
        """`SqliteStore.read_image`'s answer, ONE `psql` session and one
        REPEATABLE READ READ ONLY transaction (opensoft/openRepoTools#166 item 1):
        each `rows()` was a session of its own, and a snapshot of its own."""
        res = self._query_many([self._provenance_query(source)] +
                               [self._rows_query(table, source, columns)
                                for table, columns in reads], snapshot=True)
        if len(res) != len(reads) + 1:
            raise StoreUnusable("unreachable", f"psql answered {len(res)} of the "
                                f"{len(reads) + 1} reads of one export")
        return self._provenance_of(res[0]), [self._rows_of(answer, columns)
                                             for answer, (_table, columns) in zip(res[1:], reads)]

    def apply(self, source: str, old: dict | None, new_sha: str, upserts: dict,
              deletes: dict, generation: int | None = None) -> None:
        now = utc_now()
        want = old["commit_sha"] if old else None
        lines = ["SET standard_conforming_strings = on;", "BEGIN;",
                 f"SET LOCAL search_path TO \"{self.schema}\";",
                 # THE COMPARE-AND-SWAP, FIRST AND IN THE SAME TRANSACTION AS THE
                 # ROWS: the UPDATE takes the provenance row's lock, so a second
                 # writer reading the same old commit blocks here and then finds
                 # it moved, and its whole transaction goes (Amendment 14(d)).
                 "DO $lanes_index_cas$ DECLARE n integer; BEGIN",
                 f"  INSERT INTO provenance (source, commit_sha, generation, indexed_utc, "
                 f"schema_version) VALUES ({_pg_quote(source)}, NULL, NULL, {_pg_quote(now)}, "
                 f"{SCHEMA_VERSION}) ON CONFLICT (source) DO NOTHING;",
                 f"  UPDATE provenance SET commit_sha = {_pg_quote(new_sha)}, generation = "
                 f"{_pg_quote(generation)}, indexed_utc = "
                 f"{_pg_quote(now)}, schema_version = {SCHEMA_VERSION} WHERE source = "
                 f"{_pg_quote(source)} AND commit_sha IS NOT DISTINCT FROM {_pg_quote(want)};",
                 "  GET DIAGNOSTICS n = ROW_COUNT;",
                 "  IF n <> 1 THEN RAISE EXCEPTION 'lanes-index: provenance moved under this "
                 "sync; nothing was written'; END IF;",
                 "END $lanes_index_cas$;"]
        for table, ids in deletes.items():
            for rec_id in ids:
                lines.append(f"DELETE FROM {table} WHERE source = {_pg_quote(source)} AND "
                             f"record_id = {_pg_quote(rec_id)};")
        for table, recs in upserts.items():
            cols = TABLE_COLUMNS[table]
            allc = ["source", "record_id"] + cols + ["digest", "provenance", "indexed_utc",
                                                     "schema_version"]
            sets = ", ".join(f"{c} = EXCLUDED.{c}" for c in allc[2:])
            for rec_id, rec in recs.items():
                values = [source, rec_id] + [rec.get(c) for c in cols] + \
                    [rec["digest"], rec.get("_provenance", new_sha), now, SCHEMA_VERSION]
                lines.append(f"INSERT INTO {table} ({', '.join(allc)}) VALUES "
                             f"({', '.join(_pg_quote(v) for v in values)}) ON CONFLICT "
                             f"(source, record_id) DO UPDATE SET {sets};")
        lines.append("COMMIT;")
        self._run("\n".join(lines) + "\n")


def _no_password_file() -> str:
    """An empty 0600 file for libpq to read where no `passfile=` is configured
    (a passwordless role: peer, trust or certificate authentication)."""
    path = os.path.join(state_dir(), "lanes-index.nopass")
    try:
        os.makedirs(state_dir(), mode=0o700, exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        os.close(fd)
        os.chmod(path, 0o600)
    except OSError as exc:
        raise StoreUnusable("unreachable", f"{path} could not be made as the empty password "
                            f"file ({exc.strerror or exc}); nothing was sent to Postgres")
    return path


def open_store(cfg: dict, role: str):
    return SqliteStore(cfg) if cfg["store"] == "sqlite" else PostgresStore(cfg, role)


# ===== the SQL register: the declared outage (007)
#
# `lanes-index outage declare` AND `outage clear` (feature 007,
# opensoft/openRepoTools#165; D20, design Y:599-612; operations.md §2.5;
# contracts/config.md §6; contracts/exit-codes.md §3.2; T121). A declared
# outage is the file `register-outage` beside `lanes-index.conf`, never a row
# in the database that is down. Each guard's client reads it offline, on
# `mode=primary` only (SVC-12; lane 5's T507), and `status` (T117) and
# `ready`'s check 7 (T119) report one left in place. Both sides read its form
# from config.md §6.3, which `parse_register_outage` holds.
#
# ON BRETT'S WORD, `outage declare --until <UTC> --why <words>` probes the
# database first, on D9's `outage` row as the REGISTER-WRITER: one read of the
# switch's `mode` and `set_seq`, and of the kind of the journal entry at
# `set_seq`. A database that answers from this host refuses it, 2: the outage
# is then not estate-wide. Its silence is the declaration's premise, and every
# end of the probe before its read completes counts the same (D9, Y:3535), so
# `outage declare` never exits 69. `mirror-seq=` is then the newest
# `Register-Seq` on `origin/<branch>`, read after a fetch, or `--mirror-seq
# <m>` where this host cannot fetch (F11).
#
# FROM A ROLLBACK, `outage declare --rollback --mirror-seq <k>` is written only
# where the probe reads the switch at `files`, the entry at its `set_seq` a
# `rollback`, and `<k>` that entry's base, `set_seq - 1` (R2's M1). A probe
# that cannot read the switch refuses it, 2, as does any other answer (V2's
# S-4). It carries no expiry. Lane 3's `rollback` (T304) writes the same record
# where its directory is writable, through `register_outage_text` and
# `write_register_outage`.
#
# IN BOTH FORMS, `last-head=` is the last head `status` recorded on this host
# (`read_register_last_head`; ops:511), for the disaster path's notice, and is
# written only where that record's `database=` is the declaration's.

#: THE DECLARATION'S FILE (D20; config.md §6.1), beside `lanes-index.conf`.
REGISTER_OUTAGE_FILE = "register-outage"

#: The keys a well-formed declaration carries once each, whatever its kind
#: (config.md §6.3). `until=` joins them exactly when `kind=word`, and
#: `last-head=` where `status` recorded a head.
REGISTER_OUTAGE_KEYS = ("format", "kind", "database", "utc", "host", "mirror-seq", "why")

#: A UTC in the declaration, `utc=` and `until=`, and `--until`'s own form,
#: whole seconds (config.md §6.3).
_OUTAGE_UTC_FORM = "%Y-%m-%dT%H:%M:%SZ"
_OUTAGE_UTC_RE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z")

#: FORM C'S PAGE (SVC-12, Y:4455-4466; the renderer's pass, Y:2840-2846): one
#: `git log --first-parent -n 200`, never with `--grep`, whose `-n` would count
#: matches rather than the commits walked.
MIRROR_SEQ_PAGE = 200

#: `LANES_GIT_TIMEOUT`'s default, in seconds, as `lanes-edit.sh`'s `git_net`
#: reads it.
MIRROR_GIT_TIMEOUT_DEFAULT = 60

_OUTAGE_USAGE = f"""\
{PROG} outage declare --until <UTC> --why <words> [--mirror-seq <m>]
{PROG} outage declare --rollback --mirror-seq <k> [--why <words>]
{PROG} outage clear

The declared outage (D20; operations.md section 2.5): the file
`register-outage` beside lanes-index.conf. Run each on every configured
workstation, from the host, as `set-mode` is.

  declare     On Brett's word: <UTC> is its expiry, YYYY-MM-DDTHH:MM:SSZ, and
              <words> his words, verbatim, on one line. It probes the database
              first, as the REGISTER-WRITER, and a database that answers from
              this host refuses it. `mirror-seq=` is the newest Register-Seq on
              origin/<branch> after a fetch, or --mirror-seq <m>, from
              `status` on a host that can fetch, where this one cannot.
  --rollback  The rollback's declaration, as `rollback` prints it: <k> is the
              rollback's head, and the probe must read the switch at `files`
              with a `rollback` entry at set_seq <k>+1. It has no expiry.
  clear       Removes the declaration, and says so where none is recorded.

Exit: 0 written or removed · 2 refused, with nothing written · 64 usage."""


class _OutageUsage(Exception):
    """An `outage` command line that is not its usage: exit 64, before
    anything is read or sent."""


def _outage_has_line_break(text: str) -> bool:
    """Whether `text` holds a line break: any character `str.splitlines` ends
    a line at (LF, CR, VT, FF, FS, GS, RS, NEL, LS and PS), so a reader that
    splits the file, or `.outage`'s `label=`, at any of them still finds one
    line (DEC-21; lane 5's O15)."""
    return "".join(text.splitlines()) != text


def _outage_utf8(text: str) -> bool:
    """Whether `text` encodes as UTF-8: an argument or a variable that was not
    UTF-8 reaches Python as lone surrogates, which do not."""
    try:
        text.encode("utf-8")
    except UnicodeEncodeError:
        return False
    return True


def _outage_utc_ok(text: str) -> bool:
    """`YYYY-MM-DDTHH:MM:SSZ`, naming a real instant (config.md §6.3)."""
    if not _OUTAGE_UTC_RE.fullmatch(text):
        return False
    try:
        _dt.datetime.strptime(text, _OUTAGE_UTC_FORM)
    except ValueError:
        return False
    return True


def register_outage_path(cfg: dict) -> str:
    """`register-outage` beside `lanes-index.conf` (D20; config.md §6.1): in
    the directory of the configuration's path as `load_config` names it,
    `$LANES_INDEX_CONFIG` or the default, made absolute and not resolved."""
    return os.path.join(os.path.dirname(os.path.abspath(cfg["path"])), REGISTER_OUTAGE_FILE)


def parse_register_outage(text: str) -> dict:
    """A declaration's fields, from its text, where it is WELL FORMED by
    config.md §6.3; otherwise `ValueError`, naming the first fault.

    Well formed: `format=1` the first line; `key=value` lines, each split at
    its first `=`, LF-ended, and each key at most once; every key of
    `REGISTER_OUTAGE_KEYS` present; `kind=` `word` or `rollback`; `until=`
    present exactly when `kind=word`; `utc=` and `until=` each
    `YYYY-MM-DDTHH:MM:SSZ`; `mirror-seq=` a whole number; and `why=` with no
    line break. A key this build does not know is kept and ignored, within
    `format=1`. Whether a declaration is unexpired, and names the reading
    host's `register_label=`, is its reader's question (SVC-12's condition 2;
    T507), not its form's."""
    if not text.endswith("\n"):
        raise ValueError("its last line is not LF-ended")
    fields: dict = {}
    for number, line in enumerate(text[:-1].split("\n"), 1):
        if number == 1 and line != "format=1":
            raise ValueError("its first line is not `format=1`")
        key, eq, value = line.partition("=")
        if not eq or not key:
            raise ValueError(f"its line {number} is not `key=value`")
        if key in fields:
            raise ValueError(f"`{key}=` is on more than one line")
        fields[key] = value
    for key in REGISTER_OUTAGE_KEYS:
        if key not in fields:
            raise ValueError(f"it carries no `{key}=`")
    if fields["kind"] not in ("word", "rollback"):
        raise ValueError("its `kind=` is neither `word` nor `rollback`")
    if ("until" in fields) != (fields["kind"] == "word"):
        raise ValueError("`until=` is present with `kind=word` only, and always with it")
    for key in ("utc", "until"):
        if key in fields and not _outage_utc_ok(fields[key]):
            raise ValueError(f"its `{key}=` is not a UTC of the form YYYY-MM-DDTHH:MM:SSZ")
    if not re.fullmatch(r"[0-9]+", fields["mirror-seq"]):
        raise ValueError("its `mirror-seq=` is not a whole number")
    if _outage_has_line_break(fields["why"]):
        raise ValueError("its `why=` holds a line break")
    return fields


def read_register_outage(path: str) -> dict | None:
    """The declaration at `path` (`register_outage_path`), by
    `parse_register_outage`: None where none is recorded, and `ValueError`
    where one is there that cannot be read as UTF-8 or is not well formed.
    `outage clear` reports with it, and `status` (T117) can report a
    declaration left in place with it."""
    try:
        with open(path, "rb") as handle:
            data = handle.read()
    except FileNotFoundError:
        return None
    except OSError as exc:
        raise ValueError(f"it cannot be read ({exc.strerror or exc})")
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        raise ValueError("it is not UTF-8")
    return parse_register_outage(text)


def register_outage_text(*, kind: str, database: str, host: str, mirror_seq: int, why: str,
                         until: str | None = None, utc: str | None = None,
                         last_head: int | None = None) -> str:
    """The declaration's bytes, in config.md §6.3's form and key order:
    `format=1`, `kind=`, `database=`, `utc=` (now, where `utc` is None),
    `host=`, `until=` where given, `mirror-seq=`, `why=`, and `last-head=`
    where given. Checked by `parse_register_outage` before it is returned, so
    the writer holds itself to the reader's rule: `ValueError` where a value
    holds a line break, or the text would not be well formed."""
    lines = [("format", "1"), ("kind", kind), ("database", database),
             ("utc", utc if utc is not None else utc_now()), ("host", host)]
    if until is not None:
        lines.append(("until", until))
    lines += [("mirror-seq", str(mirror_seq)), ("why", why)]
    if last_head is not None:
        lines.append(("last-head", str(last_head)))
    for key, value in lines:
        if _outage_has_line_break(value):
            raise ValueError(f"its `{key}=` would hold a line break")
        if not _outage_utf8(value):
            raise ValueError(f"its `{key}=` would not be UTF-8")
    text = "".join(f"{key}={value}\n" for key, value in lines)
    parse_register_outage(text)
    return text


def write_register_outage(path: str, text: str) -> None:
    """`text` as `path`, by a temp file in the same directory and a rename
    (config.md §6.3), so no reader sees half a file, and a write that fails
    leaves the file as it was, with no temp file behind. Raises `OSError`
    where the directory cannot be written."""
    directory = os.path.dirname(path)
    tmp = ""
    try:
        for attempt in range(100):
            candidate = os.path.join(directory, f".{os.path.basename(path)}."
                                                f"{os.getpid()}.{attempt}.tmp")
            try:
                fd = os.open(candidate, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            except FileExistsError:
                continue
            tmp = candidate
            break
        else:
            raise FileExistsError(f"no free temp file name beside {path}")
        with os.fdopen(fd, "wb") as handle:
            handle.write(text.encode("utf-8"))
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
        tmp = ""
    finally:
        if tmp:
            try:
                os.unlink(tmp)
            except OSError:
                pass
    # The rename itself, to disk, where the directory can be opened for it.
    try:
        dir_fd = os.open(directory, os.O_RDONLY)
    except OSError:
        return
    try:
        os.fsync(dir_fd)
    except OSError:
        pass
    finally:
        os.close(dir_fd)


def mirror_git_timeout() -> float | None:
    """`LANES_GIT_TIMEOUT` as `lanes-edit.sh`'s `git_net` reads it: the bound,
    in seconds, of a git call that touches the network, 60 where it is unset
    or empty, and None, no bound, where it is 0 or not a whole number."""
    raw = os.environ.get("LANES_GIT_TIMEOUT", "")
    if raw == "":
        return float(MIRROR_GIT_TIMEOUT_DEFAULT)
    if not re.fullmatch(r"[0-9]+", raw) or int(raw) == 0:
        return None
    return float(raw)


def _mirror_git_error(stderr: bytes) -> str:
    """git's first `fatal:` or `error:` line on stderr, else its last line,
    with any URL's user and password taken out."""
    lines = [line for line in stderr.decode("utf-8", "replace").splitlines() if line.strip()]
    if not lines:
        return "no message"
    first = next((line for line in lines if line.startswith(("fatal:", "error:"))), lines[-1])
    return re.sub(r"(://)[^/\s@]*@", r"\1", first.strip())


def mirror_fetch(root: str, timeout: float | None) -> None:
    """`git fetch -q origin <branch>` in the checkout `root`, as
    `lanes-edit.sh` fetches it, so its `origin/<branch>` is origin's own;
    `timeout`, from `mirror_git_timeout`, bounds it. A fetch that fails or
    runs out of time raises `StoreUnusable` of kind `unread`."""
    what = f"`git fetch origin {branch()}` in {root}"
    env = git_location_free_env()
    env["GIT_TERMINAL_PROMPT"] = "0"
    try:
        proc = subprocess.run(["git", "-c", "gc.auto=0", "-c", "maintenance.auto=false",
                               "-C", root, "fetch", "-q", "origin", branch()],
                              capture_output=True, check=False, stdin=subprocess.DEVNULL,
                              env=env, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise StoreUnusable("unread", f"{what} did not end within {timeout:g} s "
                            f"(LANES_GIT_TIMEOUT)")
    except OSError as exc:
        raise StoreUnusable("unread", f"{what} could not be run: {exc}")
    if proc.returncode != 0:
        raise StoreUnusable("unread", f"{what} exited {proc.returncode}: "
                            f"{_mirror_git_error(proc.stderr)}")


def mirror_register_seq(root: str, deadline: float | None = None, *,
                        skip: frozenset[str] | set[str] | None = None,
                        passed: list | None = None,
                        tip: str | None = None,
                        max_pages: int | None = None) -> tuple[int, str]:
    """`m`, the newest `Register-Seq` on `origin/<branch>` in the checkout
    `root` AS LAST FETCHED, and the commit that carries it. Nothing here
    fetches: `mirror_fetch` does, where its caller wants the fetch.

    Form C (SVC-12, Y:4455-4466), in pages as the renderer's pass finds `m`
    (Y:2840-2846): `git log --first-parent -n 200 --skip <s>
    --format='%H%x00%(trailers:key=Register-Seq,valueonly)'` from the tip,
    never with `--grep`, taking the first non-empty value. `deadline`, a
    `time.monotonic()` instant, bounds the whole walk.

    THE SKIP SET (Y:2848-2850; lane 3's ruling, opensoft/openRepoTools#165
    6770600106, item 5): `skip` names the RESOLVED STRAYS, each commit that a
    `stray-import` or `stray-revert` entry names in `git_commit`, whose
    `Register-Seq`, if it carries one, does not count when `m` is found. The
    walk passes over each of them, whatever value it carries, and takes the
    first non-empty value of a commit `skip` does not name. Where `passed` is
    a list, each commit passed over that carries a value is appended to it as
    `(commit, its first value)`, newest first. With no `skip`, it returns
    what it always has. Only a caller that has read the journal can give
    one: `status` and `reconcile` (T117), and the renderer's pass (T322).

    Raises `StoreUnusable`: of kind `unread` where the ref is missing, git
    fails or the deadline passes; of kind `no-seq` where no commit on that
    first-parent line carries a `Register-Seq` that counts, or the newest
    that does carries one that is not a whole number. `outage declare` reads
    its `mirror-seq=` with it after a fetch (F11), with no skip set.

    `tip`, where given, is the commit the walk starts from in place of
    `origin/<branch>`'s tip: `import --at <M> --after-loss` (T115) takes `M`'s
    newest `Register-Seq` (D22), and checks itself that `M` is on origin.
    Without it, the walk is what it always was.

    `max_pages`, where given, is how many pages the walk reads before it
    gives up, and is the guard's form C (SVC-12's condition 3, B14 design
    :4501-4511: "exactly one `git log --first-parent -n 200` ... refuses 2 if
    none of the 200 carries one"): the guard calls
    `mirror_register_seq(root, deadline, max_pages=1, tip=<the commit it
    records as mirror_tip=>)` (opensoft/openRepoTools#165 6783860030,
    question 5). With `max_pages=n`, `n` full pages with no value that counts
    answer `no-seq`, with no further `git log` call, so a trailer more than
    `n` pages down is not found; a page that ends the line sooner answers as
    it always has. `max_pages` below 1, or not an `int` (a `bool` is not
    one), raises `ValueError` before any git call. `None`, the default, pages
    until it finds a trailer or reaches the end of the line, as the renderer
    does and as `status`, `reconcile`, `outage declare` and `import
    --after-loss` need."""
    if max_pages is not None and (isinstance(max_pages, bool) or not isinstance(max_pages, int)
                                  or max_pages < 1):
        raise ValueError(f"max_pages must be None or a whole number of 1 or more, "
                         f"not {max_pages!r}")
    if tip is None:
        tip = tip_of(root)
        ref = f"origin/{branch()}"
    else:
        ref = tip[:12]
    resolved = frozenset(skip or ())
    over: list = []
    walked = 0
    pages = 0
    while True:
        left = None if deadline is None else deadline - time.monotonic()
        out_of_time = (f"the walk of {ref}'s first-parent line for a Register-Seq ran out "
                       f"of time after {walked} commits (LANES_GIT_TIMEOUT)")
        if left is not None and left <= 0:
            raise StoreUnusable("unread", out_of_time)
        try:
            proc = subprocess.run(
                ["git", "-c", "log.showSignature=false", "-C", root, "log", "--first-parent",
                 "-n", str(MIRROR_SEQ_PAGE), "--skip", str(walked),
                 "--format=%H%x00%(trailers:key=Register-Seq,valueonly)", tip, "--"],
                capture_output=True, check=False, stdin=subprocess.DEVNULL, timeout=left,
                env=git_location_free_env())
        except subprocess.TimeoutExpired:
            raise StoreUnusable("unread", out_of_time)
        except OSError as exc:
            raise StoreUnusable("unread", f"git could not be run in {root}: {exc}")
        if proc.returncode != 0:
            raise StoreUnusable("unread", f"`git log` of {ref} exited {proc.returncode} in "
                                f"{root}: {_mirror_git_error(proc.stderr)}")
        commits, commit = 0, ""
        for line in proc.stdout.decode("utf-8", "replace").split("\n"):
            if "\x00" in line:
                commits += 1
                commit, _, line = line.partition("\x00")
            value = line.strip()
            if commit and value:
                if commit in resolved:
                    if not over or over[-1][0] != commit:
                        over.append((commit, value))
                        if passed is not None:
                            passed.append((commit, value))
                    continue
                if not re.fullmatch(r"[0-9]+", value):
                    raise StoreUnusable("no-seq", f"commit {commit[:12]}, the newest on {ref}'s "
                                        f"first-parent line to carry a Register-Seq, carries "
                                        f"{value!r}, which is not a whole number")
                return int(value), commit
        if commits < MIRROR_SEQ_PAGE:
            if over:
                raise StoreUnusable("no-seq", f"no commit on {ref}'s first-parent line carries a "
                                    f"Register-Seq that counts: the {len(over)} that carry one "
                                    f"are resolved strays, passed over (Y:2848-2850) "
                                    f"({walked + commits} read)")
            raise StoreUnusable("no-seq", f"no commit on {ref}'s first-parent line carries a "
                                f"Register-Seq ({walked + commits} read)")
        pages += 1
        if max_pages is not None and pages >= max_pages:
            counts, strays = "", ""
            if over:
                counts = " that counts"
                strays = (f"; {len(over)} resolved "
                          f"{'stray' if len(over) == 1 else 'strays'} passed over")
            raise StoreUnusable("no-seq", f"none of the first {walked + commits} commits on "
                                f"{ref}'s first-parent line carries a Register-Seq{counts}: "
                                f"the limit of {max_pages} page{'' if max_pages == 1 else 's'} "
                                f"of {MIRROR_SEQ_PAGE} commits was reached "
                                f"(SVC-12's condition 3{strays})")
        walked += commits


def _outage_mirror_seq() -> tuple[int, str]:
    """`mirror-seq=` on Brett's word with no `--mirror-seq`: `m` read after a
    fetch (ops:497; F11), in the workspace repository's checkout as `sync`
    finds it (`lanes-edit.sh workspace-root`; Amendment 9(a)). The fetch, and
    then the walk, are each bounded by `mirror_git_timeout`, as the
    renderer's are. `StoreUnusable` where this host cannot fetch or read it."""
    root = workspace_root()
    timeout = mirror_git_timeout()
    mirror_fetch(root, timeout)
    return mirror_register_seq(root, None if timeout is None else time.monotonic() + timeout)


def _outage_probe(store) -> dict:
    """D9'S `outage` ROW (Y:3535): ONE read as the REGISTER-WRITER, connected
    as a writer's snapshot is, with the row's bounds and its client timer,
    `N_a`·`c` + 6 s: the switch's `mode` and `set_seq`, and the kind of the
    journal entry at `set_seq`, '' where there is none.

    `answered` is True where `psql` ended 0: the database answered from this
    host, and `switch` is `files` or `primary`, or None where its answer could
    not be read. Every other end before the read completes - no answer within
    its bounds, a refusal, a `psql` that could not be run - is `answered`
    False. `end` says which, with nothing secret in it (contract §2.6)."""
    schema = f'"{store.schema}"'
    sql = (f"SELECT s.mode, s.set_seq, coalesce((SELECT j.kind FROM {schema}.journal AS j "
           f"WHERE j.seq = s.set_seq), '') FROM {schema}.register_switch AS s WHERE s.id = 1")
    try:
        out = store.request([sql], "outage")
    except PsqlFailed as exc:
        if exc.timer_expired:
            end = f"no answer within its client timer: {exc.detail}"
        elif not exc.ran:
            end = f"nothing was sent: {exc.detail}"
        else:
            end = f"psql exited {exc.psql_exit}: {exc.first_line or exc.detail}"
        return {"answered": False, "end": end}
    except StoreUnusable as exc:
        return {"answered": False, "end": f"nothing was sent: {exc.detail}"}
    match = re.fullmatch(r"(files|primary)\|(-?[0-9]+)\|([a-z-]*)\n?", out)
    if not match:
        return {"answered": True, "switch": None, "set_seq": None, "kind": "",
                "end": "the database answered, and its answer could not be read"}
    return {"answered": True, "switch": match.group(1), "set_seq": int(match.group(2)),
            "kind": match.group(3),
            "end": f"the switch reads {match.group(1)} at set_seq {match.group(2)}"}


def _outage_refuse_unwritable(path: str, form: str, nothing: str) -> None:
    """A configuration directory this process cannot write, as a bench's
    read-only mount of it is (Q23(a)), refused with 2 before anything is sent:
    declare it from the host, as `set-mode` refuses (ops:470)."""
    directory = os.path.dirname(path)
    if not os.access(directory, os.W_OK | os.X_OK):
        raise Refusal(f"{form}: {directory} cannot be written from here, as on a bench's "
                      f"read-only mount of the configuration: run it from the host, as "
                      f"`set-mode` is (ops:470; operations.md §2.5); {nothing}")


def _outage_host(form: str) -> str:
    """`host=`, the workstation the declaration is made on: `$LANES_WORKSTATION`
    where it is set, the seam `lanes-edit.sh workstation` answers with first;
    otherwise that command. A container with no name is refused, as every
    writer of a workstation column refuses it (R-A11-14)."""
    name = os.environ.get("LANES_WORKSTATION", "")
    if not name:
        try:
            name, how = this_workstation()
        except StoreUnusable as exc:
            raise Refusal(f"{form}: this workstation's name cannot be read ({exc.detail}); "
                          f"export LANES_WORKSTATION, or run it from the host; nothing was "
                          f"written")
        if how == "container-unset":
            raise Refusal(f"{form}: this is a container and LANES_WORKSTATION is not set, so "
                          f"`host=` would be the container's own id (R-A11-14). Run it from "
                          f"the host's shell; nothing was written")
    if not name.strip() or _outage_has_line_break(name):
        raise Refusal(f"{form}: this workstation's name is empty or holds a line break, and "
                      f"`host=` is one line; nothing was written")
    return name


def _outage_args(args: list[str]) -> dict | None:
    """`outage`'s command line: its verb, `declare` or `clear`, and
    `declare`'s flags, each as `--flag <value>` or `--flag=<value>`; None for
    `--help`. Usage is `_OutageUsage`: no verb or an unknown one, an unknown
    argument, a flag with no value or given twice, an argument to `clear`, and
    `--until` beside `--rollback`, whose declaration carries no expiry."""
    if not args:
        raise _OutageUsage("outage needs `declare` or `clear`")
    if args[0] in ("-h", "--help"):
        return None
    verb, rest = args[0], args[1:]
    if verb not in ("declare", "clear"):
        raise _OutageUsage(f"outage: unknown verb '{verb}': it is `declare` or `clear`")
    opts: dict = {"verb": verb, "--until": None, "--why": None, "--mirror-seq": None,
                  "--rollback": False}
    i = 0
    while i < len(rest):
        arg = rest[i]
        if arg in ("-h", "--help"):
            return None
        if verb == "clear":
            raise _OutageUsage(f"outage clear takes no argument, and was given '{arg}'")
        name, eq, value = arg.partition("=")
        if name in ("--until", "--why", "--mirror-seq"):
            if not eq:
                if i + 1 >= len(rest):
                    raise _OutageUsage(f"outage declare: {name} needs a value")
                i += 1
                value = rest[i]
            if not value:
                raise _OutageUsage(f"outage declare: {name} needs a value")
            if opts[name] is not None:
                raise _OutageUsage(f"outage declare: {name} is given twice")
            opts[name] = value
        elif arg == "--rollback":
            if opts["--rollback"]:
                raise _OutageUsage("outage declare: --rollback is given twice")
            opts["--rollback"] = True
        else:
            raise _OutageUsage(f"outage declare: unknown argument '{arg}'")
        i += 1
    if opts["--rollback"] and opts["--until"] is not None:
        raise _OutageUsage("outage declare --rollback takes no --until: a rollback's "
                           "declaration carries no expiry, and counts until it is cleared")
    return opts


def cmd_outage(args: list[str]) -> int:
    """`lanes-index outage declare` and `outage clear` (D20; operations.md
    §2.5; contracts/exit-codes.md §3.2): 0, the declaration written or
    removed, or none to remove; 2, a refusal, with nothing written; 64, usage,
    before anything is read. Never 69: on Brett's word a database that does
    not answer is the declaration's premise, and in the `--rollback` form the
    same silence is 2."""
    try:
        opts = _outage_args(args)
    except _OutageUsage as exc:
        note(f"{exc} - see {PROG} outage --help")
        return EXIT_USAGE
    if opts is None:
        say(_OUTAGE_USAGE)
        return EXIT_OK
    try:
        if opts["verb"] == "clear":
            return _outage_clear()
        return _outage_declare(opts)
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return EXIT_REFUSED


def _outage_declare(opts: dict) -> int:
    """`outage declare`, in both forms (ops:496-507): each refusal is a
    `Refusal`, 2, raised before the file is written."""
    rollback = opts["--rollback"]
    until, why, given = opts["--until"], opts["--why"], opts["--mirror-seq"]
    form = "outage declare --rollback" if rollback else "outage declare"
    nothing = "nothing was written"
    # BEFORE ANYTHING IS READ OR SENT: ops §2.5's refusals that need no probe,
    # in its order, then those of the declaration's form (DEC-21; config.md
    # §6.3).
    if not rollback and until is None:
        raise Refusal(f"{form}: no --until <UTC>. On Brett's word the outage's expiry is "
                      f"his to name, and every guard ignores the declaration after it (D20; "
                      f"operations.md §2.5); {nothing}")
    if rollback and given is None:
        raise Refusal(f"{form}: no --mirror-seq <k>. A rollback's declaration records the "
                      f"rollback's head k, as `rollback` prints it; without it, it would "
                      f"record the mirror's m and reopen R2's M1 (operations.md §2.5); "
                      f"{nothing}")
    if not rollback and why is None:
        raise Refusal(f"{form}: no --why <words>. On Brett's word the declaration records "
                      f"his words, verbatim (D20); {nothing}")
    if why is not None and _outage_has_line_break(why):
        raise Refusal(f"{form}: --why holds a line break. The declaration carries the words "
                      f"on one line, so the guard's `.outage` label stays on one line "
                      f"(DEC-21; lane 5's O15); {nothing}")
    if why is not None and not _outage_utf8(why):
        raise Refusal(f"{form}: --why is not UTF-8 text, and the declaration is UTF-8 "
                      f"(contracts/config.md §6.3); {nothing}")
    if until is not None and not _outage_utc_ok(until):
        raise Refusal(f"{form}: --until {until!r} is not a UTC of the form "
                      f"YYYY-MM-DDTHH:MM:SSZ (contracts/config.md §6.3); {nothing}")
    if given is not None and not re.fullmatch(r"[0-9]+", given):
        raise Refusal(f"{form}: --mirror-seq {given!r} is not a whole number, as a "
                      f"Register-Seq is (contracts/config.md §6.3); {nothing}")
    # THE CONFIGURATION: one refused, Q6(c)'s refusal included, is 2
    # (exit-codes.md §2). The declaration names the database it covers by this
    # host's `register_label=` (config.md §6.3), and the probe connects as
    # `register_url=`'s REGISTER-WRITER.
    cfg = load_config()
    label = cfg["register_label"]
    if not label:
        raise Refusal(f"{form}: {cfg['path']} names no `register_label=`, the label of the "
                      f"database the declaration covers (contracts/config.md §6.3); {nothing}")
    if not cfg["register_url"]:
        raise Refusal(f"{form}: {cfg['path']} names no `register_url=`, the REGISTER-WRITER "
                      f"login the probe connects as (D9, Y:3535); {nothing}")
    store = PostgresStore(cfg, "register_writer")
    path = register_outage_path(cfg)
    _outage_refuse_unwritable(path, form, nothing)
    host = _outage_host(form)
    # THE PROBE (D9, Y:3535), and ops §2.5's refusals that read it. Where two
    # of them describe one answer, the narrower one's text is given: Brett's
    # word at `files` after a rollback is also a database that answers.
    probe = _outage_probe(store)
    switch, set_seq, kind = probe.get("switch"), probe.get("set_seq"), probe.get("kind")
    after_rollback = probe["answered"] and switch == "files" and kind == "rollback"
    if not rollback:
        if after_rollback:
            raise Refusal(f"{form}: the database answers from this host, and the switch "
                          f"reads `files` after a rollback, its entry at set_seq {set_seq}. A "
                          f"declaration on Brett's word would record the mirror's m, not the "
                          f"rollback's head (R2's M1; operations.md §2.5); {nothing}. Run "
                          f"instead:\n{PROG} outage declare --rollback --mirror-seq "
                          f"{set_seq - 1}")
        if probe["answered"]:
            raise Refusal(f"{form}: the database answers from this host ({probe['end']}), so "
                          f"the outage is not estate-wide from here (operations.md §2.5); "
                          f"{nothing}")
    else:
        if probe["answered"] and switch == "primary":
            raise Refusal(f"{form}: the database answers from this host, with the switch at "
                          f"`primary` (set_seq {set_seq}): no rollback has set it to `files` "
                          f"(operations.md §2.5); {nothing}")
        if probe["answered"] and switch == "files" and not after_rollback:
            entry = f"of kind `{kind}`" if kind else "absent"
            raise Refusal(f"{form}: the switch reads `files`, but the journal entry at its "
                          f"set_seq {set_seq} is {entry}, not a `rollback` (operations.md "
                          f"§2.5); {nothing}")
        if after_rollback and int(given) != set_seq - 1:
            raise Refusal(f"{form} --mirror-seq {given}: the rollback's head k is "
                          f"{set_seq - 1}, set_seq {set_seq} less one, and not {given} (R2's "
                          f"M1; operations.md §2.5); {nothing}. Run instead:\n{PROG} outage "
                          f"declare --rollback --mirror-seq {set_seq - 1}")
        if not after_rollback:
            raise Refusal(f"{form}: the probe cannot read the switch ({probe['end']}). A "
                          f"rollback's declaration counts only where a guard's own read finds "
                          f"the switch at `files`, so here it would gain nothing and be left "
                          f"behind (V2's S-4; operations.md §2.5); {nothing}")
    # `mirror-seq=` (F11): the rollback's head k, as given; on Brett's word, m
    # as given, or else read after a fetch, and with neither, 2 (ops:497).
    if rollback:
        seq, whence = int(given), f"the rollback's head k, its entry at set_seq {set_seq}"
    elif given is not None:
        seq, whence = int(given), "as --mirror-seq gave it"
    else:
        try:
            seq, commit = _outage_mirror_seq()
        except StoreUnusable as exc:
            raise Refusal(f"{form}: no mirror-seq: this host cannot read the mirror's "
                          f"Register-Seq after a fetch ({exc.detail}). Run `{PROG} status` on "
                          f"a host that can, and name its m here with --mirror-seq <m> (F11; "
                          f"operations.md §2.5); {nothing}")
        whence = f"origin/{branch()} at {commit[:12]}, read after a fetch"
    # `last-head=` (ops:511; config.md §6.2-6.3), in both forms: the last head
    # `status` recorded here, for the disaster path's notice, only where that
    # record names this declaration's database. Where none is recorded, or it
    # names another, the declaration carries no `last-head=` line (lane 3's
    # ruling, opensoft/openRepoTools#165 6770600106, item 4).
    recorded = read_register_last_head()
    last_head = (recorded["head"] if recorded is not None
                 and recorded.get("database") == label else None)
    try:
        text = register_outage_text(kind="rollback" if rollback else "word", database=label,
                                    host=host, mirror_seq=seq,
                                    why=why if why is not None else "rollback",
                                    until=None if rollback else until, last_head=last_head)
    except ValueError as exc:
        raise Refusal(f"{form}: the declaration would not be well formed ({exc}); {nothing}")
    replaced = os.path.lexists(path)
    try:
        write_register_outage(path, text)
    except OSError as exc:
        raise Refusal(f"{form}: {path} could not be written ({exc.strerror or exc}); "
                      f"{nothing}, and no temp file is left")
    say(f"outage declared: {path}" + (", replacing the declaration there" if replaced else ""))
    for line in text.splitlines():
        say(f"  {line}")
    say(f"the probe: {probe['end']}")
    say(f"mirror-seq: {whence}")
    return EXIT_OK


def _outage_clear() -> int:
    """`outage clear` (ops:541): removes this host's declaration, and where
    none is recorded says so and exits 0, so a clear on every host can be
    repeated. A configuration directory it cannot write is 2, as `outage
    declare`'s is, with nothing removed."""
    cfg = load_config()
    path = register_outage_path(cfg)
    if not os.path.lexists(path):
        say(f"outage clear: no declared outage is recorded at {path}; nothing to clear")
        return EXIT_OK
    _outage_refuse_unwritable(path, "outage clear", "nothing was removed")
    try:
        fields = read_register_outage(path)
        what = (f"kind={fields['kind']}, declared {fields['utc']} on {fields['host']}"
                if fields else "")
    except ValueError as exc:
        what = f"not well formed: {exc}"
    try:
        os.unlink(path)
    except FileNotFoundError:
        say(f"outage clear: no declared outage is recorded at {path}; nothing to clear")
        return EXIT_OK
    except OSError as exc:
        raise Refusal(f"outage clear: {path} could not be removed ({exc.strerror or exc}); "
                      f"nothing was removed")
    say(f"outage cleared: removed {path}" + (f" ({what})" if what else ""))
    return EXIT_OK


# ===== the SQL register: `register read`, the readers' and the guard's forms (007, T113)
#
# `lanes-index register read` IN CONTRACT §3.6'S FOUR FORMS (feature 007,
# opensoft/openRepoTools#165; FR-015; T113, which lane 1 handed to lane 5):
#   1. `--prefetch --cache <file> (--files <set> | --all)`, the readers' prefetch;
#   2. `--for guard --prefetch --cache <file> --pid <pid> --repo <dir> [--lane=<w>]`,
#      the guard's prefetch;
#   3. `--since <n> --cache <file> [--files <set>] [--log-key=<key>]`, the
#      readers' second read, at the register's head `n'`;
#   4. `--for guard --at <n> --pid <pid> --cache <file> --lane=<key>`, the
#      guard's second read, at `n`.
# Each is ONE REPEATABLE READ READ ONLY snapshot sent as ONE request (contract
# §2.3), built by `register_read_queries`, the one SQL builder (OP-15). Each
# snapshot reads the switch and the readers' schema window first. Phase 1's
# `register read` has only its direct path (Y:4868), so it asks no service,
# writes no `.direct` and prints no `guard: direct` line, and `.head`'s
# `w_s_ms=` is 0.
#
# THE CACHE FAMILY is §3.6's: `<file>.register`, `.paths`, `.archive`,
# `.aliases`, `.log.<key>` with `.logpath.<key>`, `.log.%<hex>` with
# `.logpath.%<hex>` (O18), and `.head`, written last. Each is written whole by
# a temp file beside it and `os.replace`, as Y:4890's `mv -f`. Forms 1 to 3
# read at the head from `files` and `doc_lines`; form 4 reads at `n` from
# `journal_files`, and replays the journal only where the head has moved past
# `n`. An image comes from T302's cache only where its name is the digest the
# database gave at the read's seq (D17); every other image is fetched whole in
# the same request and checked against that digest.
#
# WHAT IS NOT HERE: `T0` from the pid, the clamp, the floor, the declaration,
# `.outage`, form C in `--repo` and the detached whole-file fetch are lane 5's
# T507 (contract §3.6, R07). Until T507, the guard's cut at `T0` + 3.75 s is
# counted from this process's own start. T113 still ends "too late to verify",
# 2, where that cut is passed before the request or reached during it.

#: `check_lane_name`'s class (`lanes-edit.sh`; Y:4956; contract §3.6, O18):
#: letters, digits, `.`, `_` and `-`, not opening with `.` or `-`.
_REGISTER_LANE_CLASS_RE = re.compile(r"[A-Za-z0-9_][A-Za-z0-9._-]*")

#: `--files`' members beside `log:<key>` (contract §3.6).
REGISTER_READ_MEMBERS = ("register", "paths", "archive", "aliases")

#: The render set's set members' prefixes (Y:258-260).
_REGISTER_ARCHIVE_PREFIX = "lanes/archive/"

#: `EXIT_FAILED`, exit-codes.md §1's name for 1 (#160's failed read or write).
#: `register read --for guard` is the first register command to exit with it:
#: a refused configuration there (O14), since 2 means only "too late" under the
#: guard. Neither the pin nor line R defines it, so T113 does, as §1 asks of
#: the task that first exits with a code.
EXIT_FAILED = 1

#: D9's guard row is cut at `T0` + 3.75 s (Y:3518; contract §2.4, B5). Form 4
#: reads no declaration, so its cut is always this one.
REGISTER_GUARD_CUT_S = 3.75

#: `T0`'S STAND-IN UNTIL T507: this process's own start. T507's client half
#: reads `T0` from `--pid` (`/proc/<pid>/stat` against `/proc/uptime`, Y:4263)
#: and applies the clamp and the floor; T113 ships the cut and its end.
_REGISTER_READ_STARTED = time.monotonic()

#: `w_s`, the client's wait for the service, in whole ms (contract §2.5, O15):
#: 0 while this `lanes-index` has no `serve` (Y:4868).
REGISTER_READ_W_S_MS = 0

#: `.aliases` for an empty or absent table, as `lane_alias_text` caches one
#: (Y:4150; contract §3.6's table).
REGISTER_NO_ALIASES = b"# no lane aliases\n"

#: ASCII case, as `log_path_ci`'s `awk tolower` folds a path (C11).
_REGISTER_UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"


class RegisterReadUsage(Exception):
    """`register read`'s usage, 64, raised before the configuration is read."""


class RegisterReadFailed(Exception):
    """A failed read, 69. `cause` is §3.6's `refuse db <cause>` word where the
    direct read found the switch not `primary` (`switch-files`) or the
    client outside the readers' window (`schema`), and None otherwise."""

    def __init__(self, why: str, cause: str | None = None):
        super().__init__(why)
        self.cause = cause


def register_lane_in_class(key: str) -> bool:
    """Whether `key` is in `check_lane_name`'s class (Y:4956)."""
    return isinstance(key, str) and _REGISTER_LANE_CLASS_RE.fullmatch(key) is not None


def register_log_slot(key: str) -> str:
    """A key's slot in `.log.<slot>` and `.logpath.<slot>`: the key where it is
    in the class, else `%<hex>`, the key's bytes in lowercase hex (O18). `%`
    is outside the class, so no class key names such a file."""
    return key if register_lane_in_class(key) else "%" + os.fsencode(key).hex()


def _register_fold(path: str) -> bytes:
    """`path`'s bytes with ASCII letters lowered, and nothing else changed."""
    return os.fsencode(path).lower()


def register_log_index(paths) -> dict:
    """{folded name: [paths]} of the render-set logs among `paths`, for
    `register_log_path_ci`'s `index`, so a read over every log folds each
    path once."""
    index: dict = {}
    for path in sorted(paths, key=os.fsencode):
        if path.startswith(LOG_PREFIX) and register_render_path(path):
            index.setdefault(_register_fold(path), []).append(path)
    return index


def register_log_path_ci(paths, key: str, *, index: dict | None = None) -> list[str]:
    """THE ONE CASE-INSENSITIVE LOG RESOLUTION (contract §3.6, C11; T511's
    OP-6, which `serve` reuses): the render-set logs among `paths`, the paths
    present at the read's seq, whose names equal `lanes/log/<key>.md` but for
    ASCII case, as `log_path_ci`'s `awk tolower` compares them, sorted
    bytewise. One is the key's log; none means no log; two or more is C11,
    two logs that differ only by case, which no form writes. `index`, where
    given, is `register_log_index(paths)`."""
    want = _register_fold(f"{LOG_PREFIX}{key}.md")
    if index is not None:
        return list(index.get(want, ()))
    return sorted((path for path in paths
                   if path.startswith(LOG_PREFIX) and register_render_path(path)
                   and _register_fold(path) == want), key=os.fsencode)


def _register_sql_text(data: bytes) -> str:
    """`data`, UTF-8 bytes, as an SQL text expression of hex digits alone, so
    a key's quotes, backslashes and line breaks never reach `psql`'s parser."""
    return f"convert_from(decode('{data.hex()}', 'hex'), 'UTF8')"


def _register_read_filter(texts) -> str:
    """The `doc_lines` filter for `texts`, a list of `("path", <path>)`,
    `("prefix", <prefix>)` and `("fold", <folded bytes>)`: `false` for none."""
    terms = []
    for kind, value in texts:
        if kind == "path":
            terms.append(f"d.path = {_register_sql_text(os.fsencode(value))}")
        elif kind == "prefix":
            terms.append(f"starts_with(d.path, {_register_sql_text(os.fsencode(value))})")
        elif kind == "fold":
            terms.append(f"translate(d.path, '{_REGISTER_UPPER}', '{_REGISTER_UPPER.lower()}') "
                         f"= {_register_sql_text(value)}")
        else:
            raise ValueError(f"no register read text of kind {kind!r}")
    return " OR ".join(terms) if terms else "false"


def register_read_queries(*, texts=(), held=(), at: int | None = None) -> list[str]:
    """THE ONE SQL BUILDER OF `register read` (contract §3.6; T511's OP-15,
    which the service sends on its held connection): the SELECTs of one
    REPEATABLE READ READ ONLY snapshot, each SELECT only, naming its tables
    through the store's `search_path`.

    At the head (forms 1 to 3, `at` None), four:
    1. `schema_version`, first, as every reader checks it (Y:2334);
    2. the switch's mode and generation, and the head's seq;
    3. `files`: every rendered path at the head, with its digest and
       `final_newline`;
    4. `doc_lines`: the lines of the paths `texts` names, in path and line
       order, but those whose digest is in `held`, the digests T302's cache
       holds, which are read from the cache instead (D17).

    At `at` = `n` (form 4), seven, with `L`, the latest import at or below
    `n`, and the head read in the same snapshot:
    1. `schema_version`;
    2. the mode, the generation, the head's seq, and `L`;
    3. each `lanes/log/` path's latest `journal_files` row from `L` to `n`;
    4. `doc_lines` of the paths `texts` names, only where the head is `n`;
    5. to 7. `journal`, `journal_edits` and `journal_files` from `L` to `n`,
       in `REGISTER_RENDER_COLUMNS`' order, only where the head is past `n`,
       for `register_images`' replay.
    `at` is a whole number, which its caller parsed."""
    version = "SELECT version, writers_from, readers_from FROM schema_version WHERE id = 1"
    where = _register_read_filter(texts)
    if at is None:
        digests = sorted(digest for digest in held if _IMAGE_DIGEST_RE.fullmatch(digest))
        unheld = (" AND f.sha256 NOT IN (" + ", ".join(f"'{digest}'" for digest in digests) + ")"
                  if digests else "")
        return [
            version,
            "SELECT s.mode, s.generation, h.seq FROM register_switch s, register_head h "
            "WHERE s.id = 1 AND h.id = 1",
            "SELECT f.path, f.sha256, f.final_newline FROM files f ORDER BY f.path",
            f"SELECT d.path, d.text FROM doc_lines d JOIN files f ON f.path = d.path "
            f"WHERE ({where}){unheld} ORDER BY d.path, d.line_no",
        ]
    n = int(at)
    latest = (f"(SELECT i.seq FROM journal i WHERE i.kind = 'import' AND i.seq <= {n} "
              f"ORDER BY i.seq DESC LIMIT 1)")
    head = "(SELECT hh.seq FROM register_head hh WHERE hh.id = 1)"
    return [
        version,
        f"SELECT s.mode, s.generation, h.seq, {latest} FROM register_switch s, register_head h "
        f"WHERE s.id = 1 AND h.id = 1",
        f"SELECT DISTINCT ON (f.path) f.path, f.present, f.sha256, f.final_newline "
        f"FROM journal_files f WHERE starts_with(f.path, '{LOG_PREFIX}') AND f.seq >= {latest} "
        f"AND f.seq <= {n} ORDER BY f.path, f.seq DESC",
        f"SELECT d.path, d.text FROM doc_lines d WHERE ({where}) AND {head} = {n} "
        f"ORDER BY d.path, d.line_no",
        f"SELECT j.seq, j.kind FROM journal j WHERE j.seq >= {latest} AND j.seq <= {n} "
        f"AND {head} > {n} ORDER BY j.seq",
        f"SELECT e.seq, e.ord, e.op, e.path, e.line_no, e.old_sha256, e.new_text, e.to_path "
        f"FROM journal_edits e WHERE e.seq >= {latest} AND e.seq <= {n} AND {head} > {n} "
        f"ORDER BY e.seq, e.ord",
        f"SELECT f.seq, f.path, f.present, f.sha256, f.final_newline FROM journal_files f "
        f"WHERE f.seq >= {latest} AND f.seq <= {n} AND {head} > {n} ORDER BY f.seq, f.path",
    ]


def _register_read_snapshot(answers: list, *, at: int | None = None) -> dict:
    """`register_read_queries`' answers, checked: the readers' window, then
    the switch, each a failed read (69) with its `refuse db` cause (contract
    §3.6, T511's OP-4). Returns `mode`, `generation`, `head`, with `at` also
    `latest`, the latest import at or below `n`; `listing`, {path: (sha256,
    final_newline)} of the paths present (`lanes/STORE` left out, contract
    draft 4.13's :681); `lines`, {path: [text, ...]}; and with `at`, `replay`,
    the rows for `register_images`."""
    expected = 4 if at is None else 7
    if len(answers) != expected:
        raise RegisterReadFailed(f"psql answered {len(answers)} of the {expected} reads of one "
                                 f"register read")
    rows = answers[0]
    if len(rows) != 1 or len(rows[0]) != 3:
        raise RegisterReadFailed("the register's schema_version row could not be read")
    try:
        version, writers_from, readers_from = (int(value) for value in rows[0])
    except (TypeError, ValueError):
        raise RegisterReadFailed("the register's schema_version row is not three numbers")
    refusal = register_version_refusal(version, writers_from, readers_from, write=False)
    if refusal:
        raise RegisterReadFailed(refusal, cause="schema")
    rows = answers[1]
    if len(rows) != 1 or len(rows[0]) != (3 if at is None else 4):
        raise RegisterReadFailed("the register's switch and head could not be read")
    mode, generation = rows[0][0], (rows[0][1] or "").lower()
    if mode != "primary":
        raise RegisterReadFailed(
            f"the register's switch is `{mode}`, not `primary`: the register's text is the "
            f"files' again, and this read is a failed read (Y:2338, Y:4084)", cause="switch-files")
    if not UUID_FULL_RE.match(generation):
        raise RegisterReadFailed("the register's generation could not be read")
    try:
        head = int(rows[0][2])
        latest = None if at is None or rows[0][3] is None else int(rows[0][3])
    except (TypeError, ValueError):
        raise RegisterReadFailed("the register's head could not be read")
    listing = {}
    for row in answers[2]:
        if at is None:
            if len(row) != 3:
                raise RegisterReadFailed("a `files` row of the register could not be read")
            path, digest, final_newline = row
        else:
            if len(row) != 4:
                raise RegisterReadFailed("a `journal_files` row of the register could not be read")
            path, present, digest, final_newline = row
            if present != "t":
                continue
        if path == "lanes/STORE" or not register_render_path(path):
            continue
        if not isinstance(digest, str) or _IMAGE_DIGEST_RE.fullmatch(digest) is None \
                or final_newline not in ("t", "f"):
            raise RegisterReadFailed(f"the register's digest of {path!r} could not be read")
        listing[path] = (digest, final_newline == "t")
    lines: dict = {}
    for row in answers[3]:
        if len(row) != 2 or row[1] is None:
            raise RegisterReadFailed("a `doc_lines` row of the register could not be read")
        lines.setdefault(row[0], []).append(row[1])
    snap = {"mode": mode, "generation": generation, "head": head, "latest": latest,
            "listing": listing, "lines": lines}
    if at is not None:
        try:
            snap["replay"] = (_render_rows(answers[4], "journal"),
                              _render_rows(answers[5], "journal_edits"),
                              _render_rows(answers[6], "journal_files"))
        except RenderRefused as exc:
            raise RegisterReadFailed(str(exc))
    return snap


def _register_read_image(snap: dict, held: dict, path: str, fetched: dict) -> bytes:
    """The image of `path`, present in `snap`'s listing: T302's object where
    `held` has the digest the database gave (D17), else its bytes from the
    snapshot's `doc_lines`, which must hash to that digest. An image fetched
    whole is added to `fetched`, for `image_cache_put`."""
    digest, final_newline = snap["listing"][path]
    data = held.get(digest)
    if data is not None:
        return data
    data = register_image_bytes(snap["lines"].get(path, []), final_newline)
    if hashlib.sha256(data).hexdigest() != digest:
        raise RegisterReadFailed(f"the register's lines of {path} do not hash to the digest it "
                                 f"gave for that file, {digest}")
    fetched[path] = data
    return data


def _register_read_held(candidates: dict, wanted) -> dict:
    """{digest: bytes} of T302's objects for the paths `wanted(path)` takes
    among `candidates`, {path: digest}: each through `image_cache_get`, which
    re-hashes it, so only an object whose name is its digest is held."""
    held: dict = {}
    for path, digest in candidates.items():
        if digest in held or not wanted(path):
            continue
        data = image_cache_get(digest)
        if data is not None:
            held[digest] = data
    return held


def _register_read_shell_text(data: bytes) -> bytes:
    """A file as `printf '%s\\n' "$(git show ...)"` caches it: its trailing
    line feeds dropped, then one (`register_text_checked`, Y:4149)."""
    return data.rstrip(b"\n") + b"\n"


def _register_read_row_path(path: str) -> str:
    if _RENDER_CONTROL_RE.search(path):
        raise RegisterReadFailed(f"the path {path!r} holds a control character or a line "
                                 f"separator, so it cannot be a line of the cache family")
    return path


def _register_read_family(snap: dict, held: dict, *, members, keys, all_logs: bool) -> dict:
    """The members' files at the snapshot's seq (contract §3.6's table), with
    `.head`'s rows: {"files": {suffix: bytes}, "rows": {path: digest or None},
    "absent": {key}, "ambiguous": {key}, "images": {path: bytes}, "fetched":
    {path: bytes}}. A `file=` row is given for every path a member names,
    present or not, and for every file a set member holds, its text cached or
    not; a `log:<key>` that resolves to no log gives an `absent=` row; a key
    that resolves to two logs (C11) is `ambiguous` and gets no `.log` file."""
    listing = snap["listing"]
    out = {"files": {}, "rows": {}, "absent": set(), "ambiguous": set(), "images": {},
           "fetched": {}}

    def image(path: str) -> bytes:
        if path not in out["images"]:
            out["images"][path] = _register_read_image(snap, held, path, out["fetched"])
        return out["images"][path]

    def row(path: str) -> None:
        out["rows"][_register_read_row_path(path)] = listing[path][0] if path in listing else None

    files = out["files"]
    if "register" in members:
        row(REGISTER_PATH)
        files["register"] = _register_read_shell_text(
            image(REGISTER_PATH) if REGISTER_PATH in listing else b"")
    if "paths" in members:
        files["paths"] = b"".join(os.fsencode(_register_read_row_path(path)) + b"\n"
                                  for path in sorted(listing, key=os.fsencode))
    if "archive" in members:
        archive = sorted((path for path in listing if path.startswith(_REGISTER_ARCHIVE_PREFIX)),
                         key=os.fsencode)
        for path in archive:
            row(path)
        files["archive"] = b"".join(image(path) for path in archive)
    if "aliases" in members:
        row(ALIASES_PATH)
        body = (image(ALIASES_PATH) if ALIASES_PATH in listing else b"").rstrip(b"\n")
        files["aliases"] = body + b"\n" if body else REGISTER_NO_ALIASES
    wanted = set(keys)
    if all_logs:
        for path in listing:
            if path.startswith(LOG_PREFIX):
                row(path)
                name = path[len(LOG_PREFIX):-len(".md")]
                if register_lane_in_class(name):
                    wanted.add(name)
    index = register_log_index(listing)
    for key in sorted(wanted, key=os.fsencode):
        found = register_log_path_ci(listing, key, index=index)
        for path in found:
            row(path)
        if len(found) > 1:
            out["ambiguous"].add(key)
        elif not found:
            out["absent"].add(key)
            files[f"log.{key}"], files[f"logpath.{key}"] = b"", b""
        else:
            files[f"log.{key}"] = image(found[0])
            files[f"logpath.{key}"] = os.fsencode(found[0]) + b"\n"
    return out


def _register_read_texts(members, keys, *, all_logs: bool = False) -> list:
    """`register_read_queries`' `texts` for these members and log keys."""
    texts = []
    if "register" in members:
        texts.append(("path", REGISTER_PATH))
    if "aliases" in members:
        texts.append(("path", ALIASES_PATH))
    if "archive" in members:
        texts.append(("prefix", _REGISTER_ARCHIVE_PREFIX))
    if all_logs:
        texts.append(("prefix", LOG_PREFIX))
    for key in sorted(keys, key=os.fsencode):
        folded = _register_fold(f"{LOG_PREFIX}{key}.md")
        try:
            folded.decode("utf-8")
        except UnicodeDecodeError:
            continue        # no path is such a key's: it resolves to no log
        texts.append(("fold", folded))
    return texts


def _register_read_wanted(members, keys, *, all_logs: bool = False):
    """The predicate `_register_read_texts`' filter is, on a path."""
    folds = {_register_fold(f"{LOG_PREFIX}{key}.md") for key in keys}

    def wanted(path: str) -> bool:
        return ((path == REGISTER_PATH and "register" in members)
                or (path == ALIASES_PATH and "aliases" in members)
                or (path.startswith(_REGISTER_ARCHIVE_PREFIX) and "archive" in members)
                or (path.startswith(LOG_PREFIX) and (all_logs or _register_fold(path) in folds)))
    return wanted


def _register_read_put(cache: str, suffix: str, data: bytes) -> None:
    """`<cache>.<suffix>`, written whole by a temp file beside it and
    `os.replace`, as Y:4890's `mv -f`. The temp file's `%` is outside the
    class, so it is never read as a member. Raises `OSError`."""
    target = f"{cache}.{suffix}"
    temp = f"{cache}.%tmp-{os.getpid()}-{os.urandom(4).hex()}"
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
        os.replace(temp, target)
    except BaseException:
        try:
            os.unlink(temp)
        except OSError:
            pass
        raise


def _register_read_drop(cache: str, suffix: str) -> None:
    try:
        os.unlink(f"{cache}.{suffix}")
    except FileNotFoundError:
        pass


def _register_read_head_bytes(snap: dict, cfg: dict, rows: dict, absent) -> bytes:
    """`.head` (contract §3.6): `format=1`, `n`, `generation`, `c`, `n_a`,
    `w_s_ms`, then one `file=` row per path in §3.2's canonical form and one
    `absent=` row per key, each sorted bytewise. `c` is the larger of the two
    URLs' `connect_timeout=` (O15), and `n_a` is `register_addresses=`."""
    bounds = [int(pg_url_env(cfg[key]).get("PGCONNECT_TIMEOUT", CONNECT_TIMEOUT_DEFAULT))
              for key in ("register_url", "reader_url") if cfg.get(key)]
    out = ["format=1", f"n={snap['head']}", f"generation={snap['generation']}",
           f"c={max(bounds or [CONNECT_TIMEOUT_DEFAULT])}",
           f"n_a={int(cfg.get('register_addresses') or 1)}", f"w_s_ms={REGISTER_READ_W_S_MS}"]
    for path in sorted(rows, key=os.fsencode):
        digest = rows[path]
        out.append(f"file={path}\t1\t{digest}" if digest else f"file={path}\t0\t-")
    out += [f"absent={key}" for key in sorted(absent, key=os.fsencode)]
    return ("\n".join(out) + "\n").encode("utf-8")


def register_read_parse_head(data: bytes) -> dict | None:
    """`.head`'s text as {"n": int, "generation": str, "rows": {path: digest
    or None}, "absent": {key}}, or None where it is out of form, so what it
    cached cannot be dated (contract §3.6, form 3)."""
    try:
        text = data.decode("utf-8")
    except (AttributeError, UnicodeDecodeError):
        return None
    if not text.endswith("\n"):
        return None
    head: dict = {"rows": {}, "absent": set()}
    for line in text[:-1].split("\n"):
        key, sep, value = line.partition("=")
        if not sep:
            return None
        if key == "file":
            parts = value.split("\t")
            if len(parts) != 3 or parts[0] in head["rows"]:
                return None
            path, present, digest = parts
            if present == "1" and _IMAGE_DIGEST_RE.fullmatch(digest):
                head["rows"][path] = digest
            elif present == "0" and digest == "-":
                head["rows"][path] = None
            else:
                return None
        elif key == "absent":
            head["absent"].add(value)
        elif key in ("format", "n", "generation", "c", "n_a", "w_s_ms") and key not in head:
            head[key] = value
        else:
            return None
    if head.get("format") != "1" or not re.fullmatch(r"-?[0-9]+", head.get("n", "")) \
            or not UUID_FULL_RE.match(head.get("generation", "")):
        return None
    head["n"], head["generation"] = int(head["n"]), head["generation"].lower()
    return head


def _register_read_cached(cache: str) -> tuple[set, set]:
    """The members the family at `cache` holds, by their files (contract
    §3.6, form 3): `register`, `paths`, `archive` and `aliases`, and each
    `.log.<key>`'s key in the class. A `.log.%<hex>` is never cached (O18)."""
    folder, base = os.path.split(os.path.abspath(cache))
    try:
        names = os.listdir(folder)
    except OSError:
        return set(), set()
    members = {member for member in REGISTER_READ_MEMBERS if f"{base}.{member}" in names}
    stem = f"{base}.log."
    keys = {name[len(stem):] for name in names
            if name.startswith(stem) and register_lane_in_class(name[len(stem):])}
    return members, keys


def _register_read_args(args: list[str]) -> dict | None:
    """`register read`'s argv as one of §3.6's four forms, or None for
    `--help`. Raises `RegisterReadUsage`, 64, for anything else.

    `--lane` and `--log-key` take their value only in the `=` form, and the
    value is everything after the first `=`, verbatim (L1-D1). Every other
    flag with a value takes it as `--flag <value>` or `--flag=<value>`, so
    `--at -1` and `--since -1` are numbers, never flags."""
    opts: dict = {"prefetch": False, "all": False}
    valued = {"--cache": "cache", "--files": "files", "--for": "for", "--pid": "pid",
              "--repo": "repo", "--since": "since", "--at": "at"}
    equals_only = {"--lane": "lane", "--log-key": "log_key"}
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-h", "--help"):
            return None
        if arg in ("--prefetch", "--all"):
            if opts[arg[2:]]:
                raise RegisterReadUsage(f"{arg} is given twice")
            opts[arg[2:]] = True
            i += 1
            continue
        name, eq, value = arg.partition("=")
        if name in equals_only:
            if not eq:
                raise RegisterReadUsage(
                    f"{name} takes its value only as {name}=<key>, so that a key beginning "
                    f"with `-` is never read as a flag (L1-D1)")
            if equals_only[name] in opts:
                raise RegisterReadUsage(f"{name}= is given twice")
            opts[equals_only[name]] = value
            i += 1
            continue
        if name in valued:
            if not eq:
                if i + 1 >= len(args):
                    raise RegisterReadUsage(f"{name} needs a value")
                value = args[i + 1]
            if valued[name] in opts:
                raise RegisterReadUsage(f"{name} is given twice")
            if value == "":
                raise RegisterReadUsage(f"{name} needs a value")
            opts[valued[name]] = value
            i += 1 if eq else 2
            continue
        raise RegisterReadUsage(f"unknown argument {arg!r}")
    if "cache" not in opts:
        raise RegisterReadUsage("every form names its cache, --cache <file>")
    if opts.get("for", "guard") != "guard":
        raise RegisterReadUsage(f"--for takes only `guard`, not {opts['for']!r}")
    guard = "for" in opts

    def only(form: int, allowed) -> None:
        extra = sorted(k for k in opts if k not in allowed and k not in ("prefetch", "all"))
        extra += [k for k in ("prefetch", "all") if opts[k] and k not in allowed]
        if extra:
            raise RegisterReadUsage(f"form {form} takes no --{extra[0].replace('_', '-')}")
    if guard and opts["prefetch"]:
        only(2, ("cache", "for", "pid", "repo", "lane", "prefetch"))
        opts["form"] = 2
        for need in ("pid", "repo"):
            if need not in opts:
                raise RegisterReadUsage(f"form 2, the guard's prefetch, needs --{need}")
    elif guard and "at" in opts:
        only(4, ("cache", "for", "pid", "lane", "at"))
        opts["form"] = 4
        for need in ("pid", "lane"):
            if need not in opts:
                raise RegisterReadUsage(f"form 4, the guard's second read, needs "
                                        f"--{need}{'=<key>' if need == 'lane' else ''}")
    elif guard:
        raise RegisterReadUsage("--for guard takes --prefetch (form 2) or --at <n> (form 4)")
    elif opts["prefetch"]:
        only(1, ("cache", "files", "all", "prefetch"))
        opts["form"] = 1
        if ("files" in opts) == opts["all"]:
            raise RegisterReadUsage("form 1, the readers' prefetch, takes --files <set> or --all")
    elif "since" in opts:
        only(3, ("cache", "files", "log_key", "since"))
        opts["form"] = 3
        if "files" not in opts and "log_key" not in opts:
            raise RegisterReadUsage("form 3, the second read, takes --files <set>, "
                                    "--log-key=<key>, or both")
    else:
        raise RegisterReadUsage("register read takes --prefetch, --since <n>, or --for guard")
    if "pid" in opts and not re.fullmatch(r"[1-9][0-9]{0,9}", opts["pid"]):
        raise RegisterReadUsage(f"--pid {opts['pid']!r} is not a process id")
    for flag in ("since", "at"):
        if flag in opts:
            if not re.fullmatch(r"-?(0|[1-9][0-9]{0,18})", opts[flag]) \
                    or not -2 ** 63 <= int(opts[flag]) <= 2 ** 63 - 1:
                raise RegisterReadUsage(f"--{flag} {opts[flag]!r} is not a seq")
            opts[flag] = int(opts[flag])
    if opts.get("lane") == "":
        raise RegisterReadUsage("--lane= names no key")
    if "log_key" in opts:
        if opts["log_key"] == "":
            raise RegisterReadUsage("--log-key= names no key")
        if register_lane_in_class(opts["log_key"]):
            raise RegisterReadUsage("--log-key= names a key outside check_lane_name's class; "
                                    "a key in it goes in --files as log:<key> (O18)")
    opts["members"], opts["keys"] = set(), set()
    for member in (opts["files"].split(",") if "files" in opts else ()):
        if member in REGISTER_READ_MEMBERS:
            opts["members"].add(member)
        elif member.startswith("log:") and register_lane_in_class(member[4:]):
            opts["keys"].add(member[4:])
        elif member.startswith("log:") and member[4:]:
            raise RegisterReadUsage(f"--files names log:{member[4:]!r}, a key outside "
                                    f"check_lane_name's class, which goes as --log-key=<key> "
                                    f"(O18)")
        else:
            raise RegisterReadUsage(f"--files names {member!r}, which is not register, paths, "
                                    f"archive, aliases or log:<key>")
    if opts["all"]:
        opts["members"].update(REGISTER_READ_MEMBERS)
    return opts


def _register_read_query(store, queries: list, guard: bool) -> list:
    """The one request, with D9's reader row, or the guard's cut at `T0` +
    3.75 s (forms 2 and 4)."""
    if not guard:
        return store._query_many(queries, snapshot=True, row="read")
    left = REGISTER_GUARD_CUT_S - (time.monotonic() - _REGISTER_READ_STARTED)
    if left <= 0:
        raise PsqlFailed("unreachable", f"the guard's cut, T0 + {REGISTER_GUARD_CUT_S:g} s, has "
                         f"passed", timer_expired=True, ran=False)
    return store._query_many(queries, snapshot=True, row="guard", timer=left)


def _register_read_finish(cache: str, family: dict, rows: dict, absent, snap: dict,
                          cfg: dict, drops=()) -> None:
    """Writes the family's files, drops `drops`, then writes `.head`, last,
    and gives the images to T302's cache: each image fetched whole by
    `image_cache_put`, then `image_cache_record` at the read's seq."""
    for suffix, data in family["files"].items():
        _register_read_put(cache, suffix, data)
    for suffix in drops:
        _register_read_drop(cache, suffix)
    _register_read_put(cache, "head", _register_read_head_bytes(snap, cfg, rows, absent))
    for data in family["fetched"].values():
        image_cache_put(data)
    if snap["head"] >= 0 and family["images"]:
        image_cache_record(snap["head"], {path: hashlib.sha256(data).hexdigest()
                                          for path, data in family["images"].items()})


def _register_read_prefetch(store, cfg: dict, opts: dict) -> int:
    """FORMS 1 AND 2, the prefetch (contract §3.6): the members at the head
    `n`, then `.head`. Form 2's members are `register`, `aliases` and, with
    `--lane=<window>` in the class, `log:<window>`; a window outside the
    class fetches no log and refuses nothing (O18). Two logs that differ
    from a key only by case write no `.log.<key>`, and refuse nothing here
    (C11). Prints nothing past the mode line."""
    cache, guard = opts["cache"], opts["form"] == 2
    if guard:
        members, all_logs = {"register", "aliases"}, False
        keys = {opts["lane"]} if register_lane_in_class(opts.get("lane", "")) else set()
    else:
        members, keys, all_logs = opts["members"], opts["keys"], opts["all"]
    cached = image_cache_head()
    held = _register_read_held(cached[1] if cached else {},
                               _register_read_wanted(members, keys, all_logs=all_logs))
    answers = _register_read_query(store, register_read_queries(
        texts=_register_read_texts(members, keys, all_logs=all_logs), held=held), guard)
    snap = _register_read_snapshot(answers)
    family = _register_read_family(snap, held, members=members, keys=keys, all_logs=all_logs)
    drops = [f"{kind}.{key}" for key in sorted(family["ambiguous"]) for kind in ("log", "logpath")]
    _register_read_finish(cache, family, family["rows"], family["absent"], snap, cfg, drops)
    return EXIT_OK


def _register_read_since(store, cfg: dict, opts: dict) -> int:
    """FORM 3, the readers' second read (contract §3.6): one snapshot at the
    head `n'`. It finds the cached paths changed in `(n, n']` by their
    digests at `n'` against `.head`'s rows, a cached `.paths`, a cached
    `.archive`'s rows and the `absent=` keys, and a cached log member that
    now matches two logs (N-g). Where nothing cached changed, it writes the
    members `--files` names and `.head` at `n'` with their rows added; where
    any did, or `.head` is missing or names another `n` or generation, it
    rewrites the whole family at `n'`. A `--log-key=` key's pair is written
    each time and never counted as cached (O18). It prints `n=<n'>`, one
    `changed=<path>` per path, sorted, and `refetched=0` or `1`. A key the
    call asks for that matches two logs ends 69 (C11). A refetch keeps the
    `file=` rows `.head` had for logs still present, so a log that an earlier
    `--all` rowed without caching its text keeps its row. It does not make
    `--all`'s set member a member of the family: `.head` does not say that
    `--all` was read, so a log created since is cached only where a read asks
    for its key."""
    cache, since = opts["cache"], opts["since"]
    asked_members, asked_keys, log_key = opts["members"], opts["keys"], opts.get("log_key")
    try:
        with open(f"{cache}.head", "rb") as handle:
            head = register_read_parse_head(handle.read())
    except OSError:
        head = None
    cached_members, cached_keys = _register_read_cached(cache)
    members = cached_members | asked_members
    keys = cached_keys | asked_keys
    texts_keys = keys | ({log_key} if log_key else set())
    candidates = dict((image_cache_head() or (0, {}))[1])
    if head:
        candidates.update({path: digest for path, digest in head["rows"].items() if digest})
    held = _register_read_held(candidates, _register_read_wanted(members, texts_keys))
    answers = _register_read_query(store, register_read_queries(
        texts=_register_read_texts(members, texts_keys), held=held), False)
    snap = _register_read_snapshot(answers)
    listing = snap["listing"]
    for key in sorted(asked_keys | ({log_key} if log_key else set()), key=os.fsencode):
        found = register_log_path_ci(listing, key)
        if len(found) > 1:
            raise RegisterReadFailed(
                f"the key {key!r} matches {len(found)} logs that differ only by case, "
                f"{', '.join(found)}, so no read of it is unambiguous (C11)")
    ambiguous = {key for key in cached_keys if len(register_log_path_ci(listing, key)) > 1}
    changed: set = set()
    dated = (head is not None and head["n"] == since
             and head["generation"] == snap["generation"])
    old_paths = None
    if dated and "paths" in cached_members:
        try:
            with open(f"{cache}.paths", "rb") as handle:
                old_paths = {os.fsdecode(line) for line in handle.read().split(b"\n") if line}
        except OSError:
            dated = False
    if dated:
        for path, digest in head["rows"].items():
            if digest != (listing[path][0] if path in listing else None):
                changed.add(path)
        if old_paths is not None:
            changed |= set(listing) ^ old_paths
        if "archive" in cached_members:
            changed |= {path for path in listing if path.startswith(_REGISTER_ARCHIVE_PREFIX)
                        and path not in head["rows"]}
        for key in head["absent"]:
            changed.update(register_log_path_ci(listing, key))
        for key in ambiguous:
            changed.update(path for path in register_log_path_ci(listing, key)
                           if path not in head["rows"])
    for path in changed:
        _register_read_row_path(path)
    refetch = not dated or bool(changed)
    if refetch:
        family = _register_read_family(snap, held, members=members, keys=keys - ambiguous,
                                       all_logs=False)
        rows, absent = family["rows"], family["absent"]
        for path in head["rows"] if head else ():
            # S-a (register-cli.md's `.head` notes): a log a set member read
            # keeps its row, its text cached or not. The family above rows
            # only the keys it caches, so the rows of the others, which an
            # earlier `--all` wrote, are carried over at their digests at `n'`.
            if path.startswith(LOG_PREFIX) and path in listing:
                rows.setdefault(_register_read_row_path(path), listing[path][0])
    else:
        family = _register_read_family(snap, held, members=asked_members, keys=asked_keys,
                                       all_logs=False)
        rows = dict(head["rows"])
        rows.update(family["rows"])
        absent = head["absent"] | family["absent"]
    if log_key:
        found = register_log_path_ci(listing, log_key)
        slot = register_log_slot(log_key)
        if found:
            family["files"][f"log.{slot}"] = _register_read_image(snap, held, found[0],
                                                                  family["fetched"])
            family["images"][found[0]] = family["files"][f"log.{slot}"]
            family["files"][f"logpath.{slot}"] = os.fsencode(found[0]) + b"\n"
        else:
            family["files"][f"log.{slot}"], family["files"][f"logpath.{slot}"] = b"", b""
    drops = [f"{kind}.{key}" for key in sorted(ambiguous) for kind in ("log", "logpath")]
    _register_read_finish(cache, family, rows, absent, snap, cfg, drops)
    say(f"n={snap['head']}")
    for path in sorted(changed, key=os.fsencode):
        say(f"changed={path}")
    say(f"refetched={1 if refetch else 0}")
    return EXIT_OK


def _register_read_at(store, cfg: dict, opts: dict) -> int:
    """FORM 4, the guard's second read (contract §3.6; B1 to B8): `<key>`'s
    log at `n`, resolved case-insensitively in the images at `n`, never in
    the mirror, read directly in one snapshot with the guard's row. It takes
    the generation from `.head`, and ends 69 where `.head` is missing or out
    of form, the database's generation differs (B3), `n` is above the head,
    or `n` is below the latest import at or below it, from which alone the
    journal renders, and where two logs differ from the key only by case
    (C11). It writes that one log's `.log.<slot>` and `.logpath.<slot>`, each
    empty where no log resolves, and nothing else: no `.head`, no `.outage`
    (B4, B8). The image is T302's object where its name is the digest at `n`;
    else the snapshot's lines, where the head is `n`; else the journal's
    replay to `n`, `register_images`, all in the one request."""
    cache, n, key = opts["cache"], opts["at"], opts["lane"]
    try:
        with open(f"{cache}.head", "rb") as handle:
            head = register_read_parse_head(handle.read())
    except OSError as exc:
        raise RegisterReadFailed(f"{cache}.head could not be read ({exc.strerror or exc}), so "
                                 f"form 4 has no generation to read at (B3)")
    if head is None:
        raise RegisterReadFailed(f"{cache}.head is out of form, so form 4 has no generation to "
                                 f"read at (B3)")
    texts = _register_read_texts((), {key})
    snap = _register_read_snapshot(_register_read_query(
        store, register_read_queries(texts=texts, at=n), True), at=n)
    if snap["generation"] != head["generation"]:
        raise RegisterReadFailed(f"the register's generation is {snap['generation']}, and "
                                 f"{cache}.head's is {head['generation']} (B3)")
    if n > snap["head"]:
        raise RegisterReadFailed(f"--at {n} is above the register's head, seq {snap['head']} (B3)")
    if snap["latest"] is None:
        raise RegisterReadFailed(f"--at {n} is below the generation's first seq: no import is "
                                 f"at or below it")
    found = register_log_path_ci(snap["listing"], key)
    if len(found) > 1:
        raise RegisterReadFailed(
            f"the key {key!r} matches {len(found)} logs that differ only by case at seq {n}, "
            f"{', '.join(found)}, so no read of it is unambiguous (C11)")
    slot = register_log_slot(key)
    if not found:
        data, where = b"", b""
    else:
        path = _register_read_row_path(found[0])
        digest = snap["listing"][path][0]
        data = image_cache_get(digest)
        if data is None and snap["head"] == n:
            data = _register_read_image(snap, {}, path, {})
        elif data is None:
            try:
                data = register_images(*snap["replay"]).get(path)
            except RenderRefused as exc:
                raise RegisterReadFailed(f"the journal could not be replayed to seq {n}: {exc}")
            if data is None or hashlib.sha256(data).hexdigest() != digest:
                raise RegisterReadFailed(f"the journal's replay to seq {n} gives no image of "
                                         f"{path} with its digest, {digest}")
        where = os.fsencode(path) + b"\n"
    _register_read_put(cache, f"log.{slot}", data)
    _register_read_put(cache, f"logpath.{slot}", where)
    return EXIT_OK


def _register_read_end(exc: Exception, guard: bool = False) -> int:
    """A failed read's stderr and exit (contract §2.6, §3.6): the cause
    first, which the guard quotes (O15). A direct read that found the switch
    not `primary`, or the client outside the window, opens with `refuse db
    <cause> -`; a database's refusal with `psql`'s own `ERROR:` and
    `DETAIL:` lines; anything else with this file's own line.

    Under `--for guard`, a `psql` that the guard's cut stopped, at the time
    left or before it ran, is "too late to verify", 2, as a cut already
    passed before the request is (§3.6's exits table, tasks:466, Y:3518's
    "On expiry", exit-codes.md:246): not a failed read, 69. Every other
    `PsqlFailed` keeps its 69. It is not T114's `_register_read_failed`
    (`journal`'s end), which line R defines under that name."""
    if guard and isinstance(exc, PsqlFailed) and exc.timer_expired:
        note("too late to verify")
        return EXIT_REFUSED
    if isinstance(exc, RegisterReadFailed):
        if exc.cause:
            note(f"refuse db {exc.cause} -")
        note(f"register read: {exc}")
        return EXIT_UNAVAILABLE
    if isinstance(exc, PsqlFailed):
        echoed = _register_psql_lines(exc)
        note(f"register read: the register could not be read"
             f"{'' if echoed else ': ' + exc.detail}")
        code = next((m.group(1) for m in (re.match(r"ERROR:\s+([0-9A-Z]{5}):", line)
                                           for line in (exc.stderr or "").splitlines()) if m),
                    None)
        if exc.psql_exit == 3 and code in ("42P01", "42703"):
            note(f"register read: a table or column this client reads is missing, so the "
                 f"register's schema may not be this client's, {REGISTER_SCHEMA_VERSION}: if it "
                 f"is newer, upgrade the tools; if it is older, the database is behind: run the "
                 f"bootstrap")
        return EXIT_UNAVAILABLE
    if isinstance(exc, StoreUnusable):
        note(f"register read: the register could not be read: {exc.detail}")
        return EXIT_UNAVAILABLE
    note(f"register read: the cache family could not be written ({exc}); the read failed")
    return EXIT_UNAVAILABLE


def cmd_register_read(args: list[str]) -> int:
    """`lanes-index register read` (contract §3.6; FR-015; T113), in four
    forms: see this section's head. Its first stdout line is `mode index` or
    `mode primary`. In `mode index` it exits 0 and reads and writes nothing.

    Exits (§3.6's tables; §2.7):
    - 0: read, and the family written; or `mode index`;
    - 69: a failed read: the database unreachable or refusing, a switch not
      `primary` or a client outside the readers' window (each naming its
      cause first), an answer it cannot read, its timer outside `--for guard`,
      a family that could not be written; in forms 3 and 4 a key that matches
      two logs (C11);
      in form 4 also a missing `.head`, a generation that differs, an `--at`
      above the head or below the generation's first seq;
    - 78: Q6(c)'s refusal of `mode=primary` (`EXIT_CONFIG`), in every form;
    - 2: a refused configuration, R09's included, in forms 1 and 3; under
      `--for guard`, only "too late to verify": the cut passed before the
      request, or reached during the read, which stops `psql`;
    - 1 (`EXIT_FAILED`): under `--for guard`, a refused configuration (O14);
    - 64: usage, before the configuration is read, an empty `--lane=`
      included."""
    try:
        opts = _register_read_args(args)
    except RegisterReadUsage as exc:
        note(f"register read: {exc} - see {PROG} --help")
        return EXIT_USAGE
    if opts is None:
        say(USAGE)
        return EXIT_OK
    guard = opts["form"] in (2, 4)
    refused = EXIT_FAILED if guard else EXIT_REFUSED    # O14: 2 means only "too late" under the guard
    try:
        cfg = load_config()
    except PrimaryNotBuilt as exc:
        note(str(exc))
        return EXIT_CONFIG
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return refused
    if cfg["mode"] != "primary":
        say("mode index")
        return EXIT_OK
    try:
        store = PostgresStore(cfg, "register_reader")
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return refused
    say("mode primary")
    sys.stdout.flush()
    if guard and time.monotonic() - _REGISTER_READ_STARTED >= REGISTER_GUARD_CUT_S:
        note("too late to verify")
        return EXIT_REFUSED
    try:
        if opts["form"] in (1, 2):
            return _register_read_prefetch(store, cfg, opts)
        if opts["form"] == 3:
            return _register_read_since(store, cfg, opts)
        return _register_read_at(store, cfg, opts)
    except (RegisterReadFailed, StoreUnusable, OSError) as exc:
        return _register_read_end(exc, guard)


# ===== the SQL register: schema, roles, bootstrap and logins (007)
#
# THE SQL REGISTER'S SCHEMA, WHICH THE BOOTSTRAP ALONE APPLIES (feature 007,
# opensoft/openRepoTools#165; design.md §1.2, §1.3.1 and §1.5). Nothing here is
# a subcommand. `lanes-index bootstrap` calls `apply_register_migrations`
# through Brett's admin connection, after §1.4's CREATE ROLEs and the admin's
# GRANT and before §1.4's other statements. No client role owns anything in
# `lanes_register`, so no writer can apply a migration (§1.5: "Only the
# bootstrap applies them").
#
# FORWARD ONLY (§1.5). Migrations are numbered scripts, each one transaction,
# applied in order from the schema's `version` up to `REGISTER_SCHEMA_VERSION`.
# There is no down-migration: a bad one is followed by a forward fix. Each
# `migrations` row records `script_sha256`, the digest of its script as shipped.
#
# Migration 1 creates the schema. Its `CREATE SCHEMA` fails on a schema that
# already exists, so it never runs twice. Every later script follows §1.5's
# step 3, in one transaction:
#   - `SET LOCAL lock_timeout = '2000ms'`;
#   - `UPDATE register_head SET seq = seq WHERE id = 1`, so every older
#     writer snapshot gets 40001;
#   - a check that `version` is one below its own, else LR003;
#   - its DDL and GRANTs, then the new `version` and floors;
#   - its `migrations` row.
# A 55P03 is retried, never queued.

#: THE REGISTER'S SCHEMA THIS BUILD KNOWS (§1.5), apart from #160's
#: `SCHEMA_VERSION` above. Every copy in a release is one number (lane 2's
#: hygiene test, L2-N6), so it is assigned here and nowhere else.
REGISTER_SCHEMA_VERSION = 1

#: The floors the newest migration sets (§1.5, "The floors"): the oldest client
#: version that may write, and the oldest that may read. By default a migration
#: sets both to its own number, R3a's exact match. One that leaves older
#: clients correct may keep them, and says so in its header.
REGISTER_WRITERS_FROM = 1
REGISTER_READERS_FROM = 1

#: Migration 1, part one: design.md §1.2's SQL block with lane 1's changes
#: (T107, opensoft/openRepoTools#165), which design.md has yet to fold:
#: erratum (c)'s backstop, `row_line_id`'s UNIQUE made DEFERRABLE INITIALLY
#: IMMEDIATE (ERR-48), and idx1's index `object_holds_by_line`, for step 6
#: (lane 3's NIT). Case 6a changes nothing here. It holds the
#: tables, views and indexes in `lanes_register`, and `render_file`,
#: `line_scopes`, `doc_line_scopes`, `entry_new_keys`, `scope_fault` and
#: `scope_checked`. It opens the one transaction (BEGIN), and part two ends it.
_REGISTER_M1_TABLES = r"""BEGIN;                                         -- one transaction (§1.5): SET LOCAL needs one
CREATE SCHEMA lanes_register AUTHORIZATION lanes_register_owner;
SET LOCAL ROLE lanes_register_owner;           -- so the owner owns every table and function
SET LOCAL search_path TO lanes_register, pg_catalog;

CREATE TABLE schema_version (                  -- §1.5: every client checks it first
  id           smallint    PRIMARY KEY DEFAULT 1 CHECK (id = 1),
  version      integer     NOT NULL CHECK (version >= 1),
  writers_from integer     NOT NULL,           -- oldest client version that may write
  readers_from integer     NOT NULL,           -- oldest client version that may read
  applied_utc  timestamptz NOT NULL,
  CHECK (1 <= readers_from AND readers_from <= writers_from AND writers_from <= version));

CREATE TABLE migrations (                      -- forward only: one row per script applied
  version       integer     PRIMARY KEY CHECK (version >= 1),
  script_sha256 text        NOT NULL CHECK (script_sha256 ~ '^[0-9a-f]{64}$'),
  applied_utc   timestamptz NOT NULL DEFAULT date_trunc('second', clock_timestamp()),
  by_lane       text        NOT NULL,
  by_ws         text        NOT NULL CHECK (by_ws <> ''));

CREATE TABLE register_switch (                 -- S1: the database half; lanes/STORE mirrors it (D24)
  id             smallint    PRIMARY KEY DEFAULT 1 CHECK (id = 1),
  mode           text        NOT NULL CHECK (mode IN ('files', 'primary')),
  marker_state   text        NOT NULL CHECK (marker_state IN ('absent', 'adding', 'present', 'removing')),
                                               -- F1, F2, F12: the marker as SQL knows it; adding and
                                               -- removing wait for S4's read-back (record_marker)
  marker_seq     bigint,                       -- the operator entry that last changed the marker
  marker_commit  text        CHECK (marker_commit ~ '^[0-9a-f]{40}$'),  -- the commit the read-back confirmed
  generation     uuid        NOT NULL,         -- F10, F18: the bootstrap's, or an after-loss cutover's
  repository     text        NOT NULL,                       -- owner/name
  database_label text        NOT NULL CHECK (strpos(database_label, '@') = 0), -- never a credential
  import_commit  text        CHECK (import_commit ~ '^[0-9a-f]{40}$'),
  import_tree    text        CHECK (import_tree ~ '^[0-9a-f]{40}$'),           -- C's lanes tree id
  import_seq     bigint,
  set_utc        timestamptz NOT NULL,
  set_seq        bigint      NOT NULL CHECK (set_seq >= -1),  -- the seq of the last change: an operator
                              -- entry's own (a cutover's 1, m+1 or b+1, a rollback's k+1), or an abort's base
  set_by_lane    text        NOT NULL,
  set_by_ws      text        NOT NULL CHECK (set_by_ws <> ''),
  restore_prior  jsonb,                        -- the restore form's cutover: the switch row and
                                               -- lanes/STORE's rows it replaced, for its abort
  CHECK (mode = 'files' OR (import_commit IS NOT NULL AND import_tree IS NOT NULL
                            AND import_seq IS NOT NULL)),
  CHECK ((mode = 'primary') = (marker_state IN ('adding', 'present'))),
  CHECK (marker_state = 'absent' OR marker_seq IS NOT NULL),
  CHECK (marker_state <> 'present' OR marker_commit IS NOT NULL),
  CHECK (restore_prior IS NULL OR marker_state = 'adding'));   -- cleared once confirmed

CREATE TABLE register_head (                   -- S1, S2, S6: its row lock orders every write.
  id  smallint PRIMARY KEY DEFAULT 1 CHECK (id = 1),   -- Never a SEQUENCE or IDENTITY:
  seq bigint   NOT NULL CHECK (seq >= -1));            -- gaps, and not commit order. -1: empty

CREATE TABLE mirror_state (                    -- D16: what the renderer reports; it never gates alone
  id             smallint    PRIMARY KEY DEFAULT 1 CHECK (id = 1),
  diverged_sha   text        CHECK (diverged_sha ~ '^[0-9a-f]{40}$'),   -- a stray commit stopped the renderer,
                                               -- or a last Register-Seq above the head (N6); a rollback
                                               -- entry is refused while it is set (S5, LR012)
  found_utc      timestamptz,
  found_by_ws    text        CHECK (found_by_ws <> ''),
  last_error     text,                         -- the last failed pass, for status
  last_error_utc timestamptz,
  CHECK ((diverged_sha IS NULL) = (found_utc IS NULL)),
  CHECK ((last_error IS NULL) = (last_error_utc IS NULL)));

CREATE TABLE journal (                         -- S2: one entry per write, gapless, commit order
  seq         bigint      PRIMARY KEY CHECK (seq >= 0),         -- = Register-Seq
  base_seq    bigint      UNIQUE REFERENCES journal (seq),      -- one chain, no gap
  write_id    uuid        NOT NULL CONSTRAINT journal_write_id_key UNIQUE,  -- ADV-C3
  utc         timestamptz NOT NULL DEFAULT date_trunc('second', clock_timestamp()), -- S6
  kind        text        NOT NULL CHECK (kind IN ('import', 'cutover', 'write',
                                         'stray-import', 'stray-revert', 'rollback')),
  operator    boolean     GENERATED ALWAYS AS (kind IN ('cutover', 'rollback')) STORED,
                                               -- D24, F2: touches lanes/STORE alone; never rendered;
                                               -- the command that writes it pushes it
  verb        text        NOT NULL,
  lane        text        NOT NULL,            -- 'unknown' where today's subject says it
  workstation text        NOT NULL CHECK (workstation <> ''),   -- Rule 10
  author      text        NOT NULL CHECK (author ~ '^[^<>]+ <[^<>]*>$'
                                          AND strpos(author, E'\n') = 0),
  message     text        NOT NULL CHECK (message <> '' AND strpos(message, E'\r') = 0),
  git_commit  text        CHECK (git_commit ~ '^[0-9a-f]{40}$'),
  git_tree    text        CHECK (git_tree ~ '^[0-9a-f]{40}$'),
  repos_blob  text        CHECK (repos_blob ~ '^[0-9a-f]{40}$'),
  args_sha256 text        CHECK (args_sha256 ~ '^[0-9a-f]{64}$'),  -- F10: the lane, verb and arguments,
                                                                   -- as the pending record's digest
  act_id      text        CHECK (act_id ~ '^[^@[:space:]]+$'),     -- D5, F5: the id of the act that made
                                                                   -- a write (LANES_ACT); NULL: no act
  CHECK (kind <> 'write' OR args_sha256 IS NOT NULL),
  CONSTRAINT journal_act_id_write CHECK (kind = 'write' OR act_id IS NULL),  -- none on another kind
  CHECK (base_seq IS NULL OR base_seq = seq - 1),   -- the one root (journal_one_root) may sit at any seq
  CHECK (utc = date_trunc('second', utc)),     -- whole seconds, as utc_now writes them
  CHECK (kind <> 'import' OR (git_commit IS NOT NULL AND git_tree IS NOT NULL)),
  CHECK (kind NOT IN ('stray-import', 'stray-revert') OR git_commit IS NOT NULL));
CREATE UNIQUE INDEX journal_one_root ON journal ((base_seq IS NULL)) WHERE base_seq IS NULL;  -- one chain, one root

CREATE TABLE journal_edits (                   -- Rule 9(d): a known, finite set of line edits
  seq        bigint  NOT NULL REFERENCES journal (seq),
  ord        integer NOT NULL CHECK (ord >= 1),   -- applied in this order
  op         text    NOT NULL CHECK (op IN ('create', 'append', 'replace', 'delete',
                                            'rename', 'remove')),
  path       text    COLLATE "C" NOT NULL,
  line_no    integer CHECK (line_no >= 1),        -- in the image the earlier edits left
  old_sha256 text    CHECK (old_sha256 ~ '^[0-9a-f]{64}$'),
  new_text   text    CHECK (strpos(new_text, E'\n') = 0 AND strpos(new_text, E'\r') = 0),
  to_path    text    COLLATE "C" CHECK (to_path ~ '^lanes/(archive|log)/[^/]+\.md$'
                                        AND to_path <> 'lanes/log/README.md'),
  PRIMARY KEY (seq, ord),
  CHECK (path ~ '^lanes/(LANES\.md|STORE|aliases\.tsv|archive/[^/]+\.md|log/[^/]+\.md)$'
         AND path <> 'lanes/log/README.md'),      -- Q18 (A): the rendered paths, and lanes/STORE for the operator entries
  CHECK ((op IN ('replace', 'delete')) = (line_no IS NOT NULL AND old_sha256 IS NOT NULL)),
  CHECK ((op IN ('append', 'replace')) = (new_text IS NOT NULL)),
  CHECK ((op = 'rename') = (to_path IS NOT NULL)));

CREATE TABLE journal_files (                   -- S2: each touched file's bytes after the write
  seq     bigint  NOT NULL REFERENCES journal (seq),
  path    text    COLLATE "C" NOT NULL,
  present boolean NOT NULL,                    -- false: removed or renamed away
  sha256  text    CHECK (sha256 ~ '^[0-9a-f]{64}$'),
  final_newline boolean,                       -- files.final_newline after the write
  PRIMARY KEY (seq, path),
  CHECK (present = (sha256 IS NOT NULL) AND present = (final_newline IS NOT NULL)));

CREATE TABLE journal_scopes (                  -- D5, F5: each entry's touched keys (lane 4's scopes),
  seq   bigint NOT NULL REFERENCES journal (seq) ON DELETE CASCADE,  -- derived by steps 5a and 8a,
  scope text   COLLATE "C" NOT NULL                                   -- never sent by a client
        CHECK (scope = lower(scope) AND (scope = '*'                  -- '*': every scope
               OR scope ~ '^(row|bind|objects|alias|archive):[^[:space:]]+$'
               OR scope ~ '^sid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')),
  PRIMARY KEY (scope, seq));                   -- step 3b: one index range per listed scope

CREATE TABLE files (                           -- the rendered files as they stand
  path          text    COLLATE "C" PRIMARY KEY
                CHECK (path ~ '^lanes/(LANES\.md|STORE|aliases\.tsv|archive/[^/]+\.md|log/[^/]+\.md)$'
                       AND path <> 'lanes/log/README.md'),
  final_newline boolean NOT NULL,
  sha256        text    NOT NULL CHECK (sha256 ~ '^[0-9a-f]{64}$'),
  last_seq      bigint  NOT NULL REFERENCES journal (seq));

CREATE TABLE doc_lines (                       -- the truth: a file is its lines in line_no order
  line_id      bigint  GENERATED ALWAYS AS IDENTITY PRIMARY KEY, -- stable; writes are serial under
                                                                  -- the head lock: ascending = append order
  path         text    COLLATE "C" NOT NULL REFERENCES files (path) ON UPDATE CASCADE,
  line_no      integer NOT NULL CHECK (line_no >= 1),
  text         text    NOT NULL CHECK (strpos(text, E'\n') = 0 AND strpos(text, E'\r') = 0),
  written_seq  bigint  NOT NULL REFERENCES journal (seq),
  written_mode text    NOT NULL CHECK (written_mode IN ('files', 'primary')), -- S1: mode last written
  written_ws   text,
  CONSTRAINT doc_lines_pos UNIQUE (path, line_no) DEFERRABLE INITIALLY IMMEDIATE, -- a delete shifts lines
  CHECK (written_mode = 'files' OR coalesce(written_ws, '') <> ''));          -- Rule 10, new writes

-- The structured layer: today's parsers' rows, filled in the same transaction. A constraint
-- that history breaks binds only mode = 'primary' (r3a/REPORT.md:348).
CREATE TABLE lanes (                           -- one row per lane, LANES.md and archive/ together
  lane_key    text    COLLATE "C" PRIMARY KEY,
  lane        text    COLLATE "C" NOT NULL CHECK (lower(lane) = lane_key),   -- Amendment 15
  row_line_id bigint  UNIQUE DEFERRABLE INITIALLY IMMEDIATE    -- ERR-48: checked at the statement's
                      REFERENCES doc_lines (line_id) DEFERRABLE INITIALLY DEFERRED,  -- end, as
                                               -- doc_lines_pos is, so never an ON CONFLICT arbiter
  aliases jsonb, home text, workstation text, started_utc text, handoff_path text,
  state_phrase text, objects_cell text, session_ids jsonb, last_session text,
  archived    boolean NOT NULL,
  owner       text,                            -- a copy; S4 answers from the row's own text
  last_seq    bigint  NOT NULL REFERENCES journal (seq),
  last_mode   text    NOT NULL CHECK (last_mode IN ('files', 'primary')));
CREATE INDEX lanes_by_last_session ON lanes (last_session);    -- binding; the guard's triple

CREATE TABLE log_lines (                       -- every log line; unreadable ones kept (7(b))
  line_id        bigint  PRIMARY KEY REFERENCES doc_lines (line_id) ON DELETE CASCADE
                         DEFERRABLE INITIALLY DEFERRED,
  file           text    COLLATE "C" NOT NULL,
  ordinal        integer NOT NULL,
  lane           text    NOT NULL,
  verb text, session text, workstation text, utc text, utc_ts timestamptz, object text,
  ref text, payload text, payload_fields jsonb, free_text text, written_lane text,
  unreadable     boolean NOT NULL,
  unreadable_why text,
  raw            text    NOT NULL,
  seq            bigint  NOT NULL REFERENCES journal (seq),
  mode           text    NOT NULL CHECK (mode IN ('files', 'primary')),
  CONSTRAINT log_lines_pos UNIQUE (file, ordinal) DEFERRABLE INITIALLY IMMEDIATE, -- shifts too
  CHECK (unreadable = (unreadable_why IS NOT NULL)),
  CHECK (mode = 'files' OR (NOT unreadable AND coalesce(workstation, '') <> ''   -- no CHECK on
         AND utc ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'     -- verb: WORD
         AND utc_ts IS NOT NULL)));                                             -- (S6, 7(b))
CREATE INDEX log_lines_by_object ON log_lines (object) WHERE NOT unreadable;

CREATE TABLE object_holds (                    -- each lane's LAST line per object, file order
  object        text    NOT NULL,
  lane_key      text    COLLATE "C" NOT NULL,
  lane          text    NOT NULL,
  verb          text    NOT NULL,
  utc_ts        timestamptz,
  file          text    COLLATE "C" NOT NULL,
  ordinal       integer NOT NULL,
  superseded_by text,                          -- another lane whose last line on it is TAKEOVER
  spellings     text[],                        -- D19, a live claim's: as typed, canonical key, the writer's aliases
  exempt        boolean NOT NULL DEFAULT false, -- set only by an import, on a pair already at C
  seq           bigint  NOT NULL REFERENCES journal (seq),
  mode          text    NOT NULL CHECK (mode IN ('files', 'primary')),
  PRIMARY KEY (object, lane_key),
  CHECK (NOT exempt OR mode = 'files'));
CREATE UNIQUE INDEX one_live_claim ON object_holds (object)   -- Rule 1's net under claim's own check
  WHERE NOT exempt AND superseded_by IS NULL AND verb IN ('CLAIMED', 'TAKEOVER');
CREATE INDEX object_holds_by_line ON object_holds (file, ordinal);  -- step 6 finds a line's holds (ERR-48)

CREATE VIEW holds AS                           -- holders_of (code/lanes-index:1013-1036)
  SELECT object, lane_key, lane, verb, utc_ts, file, ordinal, seq, mode FROM object_holds
  WHERE superseded_by IS NULL AND object NOT LIKE 'lane:%'   -- lane-kind objects hold nothing
    AND verb IN ('CLAIMED', 'TAKEOVER', 'OPENED', 'LANDING', 'WITHDRAWN');

CREATE VIEW stale_claims AS                    -- claim_is_stale (code/lanes-edit.sh:4318) on the DB clock
  SELECT h.* FROM object_holds h
  WHERE h.verb = 'CLAIMED' AND h.superseded_by IS NULL
    AND clock_timestamp() - h.utc_ts > interval '4 hours'
    AND NOT EXISTS (SELECT 1 FROM log_lines o WHERE o.object = h.object AND o.verb = 'OPENED')
    AND NOT EXISTS (SELECT 1 FROM log_lines o WHERE lower(o.lane) = h.lane_key
                    AND o.file = h.file AND o.ordinal > h.ordinal AND o.verb = 'OPENED'
                    AND h.object = ANY (string_to_array(o.payload, ' ')));

CREATE TABLE register_lines (                  -- every non-row LANES.md line, parsed best effort
  line_id     bigint  PRIMARY KEY REFERENCES doc_lines (line_id) ON DELETE CASCADE
                      DEFERRABLE INITIALLY DEFERRED,
  kind        text,
  slot_role   text    CHECK (slot_role IN ('take', 'close')),  -- NULL decides nothing
  slot_kind   text    CHECK (slot_kind IN ('hold', 'landing')),
  lane text, repo text, repo_key text, pr integer, tip text, utc text, utc_ts timestamptz,
  session text,
  for_lane    text,                            -- F13: the lane whose LANDING a LANDING EXPIRED closes
  raw         text    NOT NULL,
  seq         bigint  NOT NULL REFERENCES journal (seq),
  mode        text    NOT NULL CHECK (mode IN ('files', 'primary')),
  workstation text,
  repo_spellings text[],                       -- D18, a slot line's: as typed, canonical key, the writer's aliases
  CHECK ((slot_role IS NULL) = (slot_kind IS NULL)),
  CHECK (slot_role IS NULL OR repo_key IS NOT NULL),
  CHECK (slot_kind IS DISTINCT FROM 'landing' OR pr IS NOT NULL),   -- RULE6_AWK pairs by PR
  CHECK ((for_lane IS NOT NULL) = (kind IS NOT DISTINCT FROM 'LANDING EXPIRED')),
  CHECK (for_lane IS NULL OR (slot_role = 'close' AND slot_kind = 'landing')),
  CHECK (mode = 'files' OR coalesce(workstation, '') <> ''));
CREATE INDEX register_lines_slots ON register_lines (repo_key, line_id) WHERE slot_role IS NOT NULL;
CREATE INDEX files_last_seq ON files (last_seq);                 -- the seven columns that reference
CREATE INDEX doc_lines_written_seq ON doc_lines (written_seq);   -- journal (seq) and lead no index,
CREATE INDEX lanes_last_seq ON lanes (last_seq);                 -- so an import's deletes do not
CREATE INDEX log_lines_seq ON log_lines (seq);                   -- scan a table per journal row
CREATE INDEX object_holds_seq ON object_holds (seq);
CREATE INDEX register_lines_seq ON register_lines (seq);
CREATE INDEX journal_scopes_seq ON journal_scopes (seq);

CREATE VIEW main_slots AS                      -- A10, Rule 6: the earliest open take wins
  SELECT t.repo_key, t.line_id, t.kind, t.slot_kind, t.lane, t.pr, t.tip, t.utc_ts, t.raw,
         CASE WHEN t.slot_kind = 'landing'
              THEN clock_timestamp() - t.utc_ts > interval '30 minutes' END AS stale,
         rank() OVER (PARTITION BY t.repo_key ORDER BY t.line_id) AS place,
         t.repo_spellings                      -- D18: one repository, however spelled
  FROM register_lines t
  WHERE t.slot_role = 'take'
    AND NOT EXISTS (SELECT 1 FROM register_lines c
                    WHERE c.slot_role = 'close' AND c.slot_kind = t.slot_kind
                      AND (c.repo_key = t.repo_key OR c.repo_spellings && t.repo_spellings)
                      AND lower(coalesce(c.for_lane, c.lane)) = lower(t.lane)
                      AND c.line_id > t.line_id AND (t.slot_kind = 'hold' OR c.pr = t.pr));

CREATE FUNCTION render_file(p_path text) RETURNS bytea LANGUAGE sql STABLE
  SET search_path = lanes_register, pg_catalog, pg_temp AS $f$
  SELECT convert_to(coalesce(string_agg(d.text, E'\n' ORDER BY d.line_no), '')
           || CASE WHEN f.final_newline AND count(d.line_id) > 0 THEN E'\n' ELSE '' END, 'UTF8')
  FROM files f LEFT JOIN doc_lines d ON d.path = f.path
  WHERE f.path = p_path GROUP BY f.final_newline $f$;

CREATE FUNCTION line_scopes(p_path text, p_text text) RETURNS SETOF text LANGUAGE sql IMMUTABLE
  SET search_path = lanes_register, pg_catalog, pg_temp AS $f$
  -- D5, F5: the scopes a line names by its text, by build_records' rules (code/lanes-index:765):
  -- a row by ROW_AWK's (row_name, :648-660), in LANES.md (:831-837) or the archive (:843-847); a
  -- lane-kind line by its verb (parse_log_line, :538-546) in the log that file_lane names
  -- (:530-532); an alias line by its first two tab fields (:849-865); a uuid by UUID_RE (:110).
  -- S3: an archived row also names its normalized key, where that differs from its own, by
  -- RETIRED_ROWS_AWK's key() (code/lanes-edit.sh:3743-3760): the name before its last '-',
  -- lower-cased, '-', and the digits after it, less one trailing letter, without leading zeros.
  WITH l AS (SELECT substring(p_text FROM '^\|[^`]*`([^`]*)`') AS rown,
               p_path ~ '^lanes/log/' AND p_text ~
                 '^[ \t]*(STARTED|RESUMED|PAUSED|ENDED|RETIRED|RENAMED)[ \t]* — ' AS lane_kind,
               lower(regexp_replace(regexp_replace(p_path, '^.*/', ''), '\.[Mm][Dd]$', '')) AS flane),
       a AS (SELECT lower(m[1]) || '-' || coalesce(nullif(ltrim(m[2], '0'), ''), '0') AS akey
             FROM l, regexp_match(rown, '^(.*)-([0-9]+)[A-Za-z]?$') AS m)   -- NULL: no key
  SELECT 'row:' || lower(rown) FROM l WHERE p_path = 'lanes/LANES.md' AND rown <> ''
  UNION SELECT 'archive:' || lower(rown) FROM l WHERE p_path ~ '^lanes/archive/' AND rown <> ''
  UNION SELECT 'archive:' || akey FROM l, a WHERE p_path ~ '^lanes/archive/' AND akey <> lower(rown)
  UNION SELECT 'bind:' || flane FROM l WHERE lane_kind
  UNION SELECT 'sid:' || u.m[1] FROM l, regexp_matches(lower(p_text),
          '([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})', 'g') AS u(m)
        WHERE lane_kind OR (rown <> '' AND p_path ~ '^lanes/(LANES\.md|archive/)')
  UNION SELECT 'alias:' || lower(a) FROM l, unnest(ARRAY[btrim(split_part(p_text, E'\t', 1), E' \t'),
          btrim(split_part(p_text, E'\t', 2), E' \t')]) AS a
        WHERE p_path = 'lanes/aliases.tsv' AND p_text !~ '^[ \t]*#' AND a <> '' $f$;

CREATE FUNCTION doc_line_scopes(p_line_id bigint, p_path text) RETURNS SETOF text LANGUAGE sql STABLE
  SET search_path = lanes_register, pg_catalog, pg_temp AS $f$
  -- A stored line's scopes, read at p_path: its text's, and objects: from its structured row: a
  -- readable log line on an object that is not lane-kind (parse_log, :618-645), and a slot
  -- line's lane and a LANDING EXPIRED's for_lane (parse_register_line, :683-713; D18, F13).
  SELECT line_scopes(p_path, d.text) FROM doc_lines d WHERE d.line_id = p_line_id
  UNION SELECT 'objects:' || lower(g.lane) FROM log_lines g
    WHERE g.line_id = p_line_id AND NOT g.unreadable AND g.object NOT LIKE 'lane:%'
  UNION SELECT 'objects:' || lower(x) FROM register_lines r, unnest(ARRAY[r.lane, r.for_lane]) AS x
    WHERE r.line_id = p_line_id AND r.slot_role IS NOT NULL AND x IS NOT NULL $f$;

CREATE FUNCTION entry_new_keys(p_seq bigint) RETURNS TABLE (path text, line_no integer, scope text)
  LANGUAGE sql STABLE SET search_path = lanes_register, pg_catalog, pg_temp AS $f$
  -- Step 8a's new side, each key with the line it came from (N2): every line entry p_seq appended
  -- or replaced, every line a rename moved, read at its new path, and objects: for every lane
  -- holding an object it wrote a hold for, at that lane's last line on the object.
  SELECT d.path, d.line_no, k.scope FROM doc_lines d, doc_line_scopes(d.line_id, d.path) AS k(scope)
    WHERE d.written_seq = p_seq
  UNION SELECT d.path, d.line_no, k.scope FROM journal_edits j JOIN doc_lines d ON d.path = j.to_path,
      doc_line_scopes(d.line_id, d.path) AS k(scope)
    WHERE j.seq = p_seq AND j.op = 'rename'
  UNION SELECT h.file, h.ordinal, 'objects:' || lower(h.lane_key)   -- N1: lower(), as doc_line_scopes;
    FROM object_holds n JOIN object_holds h ON h.object = n.object  -- lane_key is lower case by construction
    WHERE n.seq = p_seq AND n.object NOT LIKE 'lane:%' $f$;

CREATE FUNCTION scope_fault(p_scope text) RETURNS text LANGUAGE sql IMMUTABLE
  SET search_path = lanes_register, pg_catalog, pg_temp AS $f$
  -- N2: NULL where a derived key has a scope's form, journal_scopes' CHECK read with Unicode's
  -- White_Space (the no-break space included; the CHECK's [:space:] under "C" is ASCII's alone);
  -- else the key, each white-space character shown as [U+hhhh].
  SELECT CASE WHEN p_scope ~ '^sid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
                OR (p_scope ~ '^(row|bind|objects|alias|archive):.' AND p_scope !~ w.re
                    AND p_scope = lower(p_scope COLLATE "C")) THEN NULL
         ELSE (SELECT string_agg(CASE WHEN c ~ w.re THEN '[U+' || lpad(upper(to_hex(ascii(c))), 4, '0')
                                      || ']' ELSE c END, '' ORDER BY n)
               FROM regexp_split_to_table(p_scope, '') WITH ORDINALITY AS t(c, n)) END
  FROM (VALUES ('[\t\n\v\f\r \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]')) AS w(re) $f$;

CREATE FUNCTION scope_checked(p_path text, p_line integer, p_scope text) RETURNS text
  LANGUAGE plpgsql IMMUTABLE SET search_path = lanes_register, pg_catalog, pg_temp AS $f$
-- N2: a derived key, returned as it is, or LR010 naming the line it came from.
DECLARE
  v_shown text := scope_fault(p_scope);
BEGIN
  IF v_shown IS NOT NULL THEN
    RAISE EXCEPTION 'key: % line % derives %, which is not a scope (a scope''s name is lower case, not empty, and holds no white space)',
      p_path, p_line, v_shown USING ERRCODE = 'LR010'; END IF;
  RETURN p_scope;
END $f$;
-- commit_write, switch_to_files, record_marker, find_write and record_mirror_state follow in §1.3.1, in this transaction;
-- its block ends migration 1: schema_version (1, 1, 1), register_head (-1), an empty
-- mirror_state row, the switch at 'files' (set_seq -1), the migrations row, then COMMIT.
"""

#: Migration 1, part two: design.md §1.3.1's SQL block with lane 1's changes
#: to `commit_write` (T107, opensoft/openRepoTools#165), which design.md has
#: yet to fold: erratum (c)'s step 6, which deletes the structured rows its
#: edits leave stale, with the entry's `object_holds` comment (ERR-48); and
#: case 6a, where step 6 keeps the objects whose holds it deletes, step 7
#: re-marks their stored rows and stamps no `seq` or `mode` on them, and step
#: 5a adds `objects:` for every lane holding an object whose hold sits on a
#: line the entry changes (lane 3's ruling, #165 6771318480). It holds
#: `commit_write` in full, then `switch_to_files`, `record_marker`,
#: `find_write` and `record_mirror_state`, then migration 1's rows: the version
#: (1, 1, 1), the head at -1, an empty `mirror_state`, the switch at `files`
#: with the marker `absent` and `set_seq` -1, and the `migrations` row. Then
#: COMMIT. Its psql variables are the bootstrap's inputs: `repo`, `label`,
#: `lane`, `ws` and `script_sha256`.
_REGISTER_M1_FUNCTIONS = r"""CREATE FUNCTION commit_write(p_base bigint, p_write_id uuid, p_client integer, p_generation uuid,
                             p_entry jsonb)
  RETURNS bigint LANGUAGE plpgsql SECURITY DEFINER
  SET search_path = lanes_register, pg_catalog, pg_temp AS $f$
-- The entry is one jsonb object; an absent key is an empty list.
--   journal        {kind, verb, lane, workstation, author, message, git_commit, git_tree,
--                   repos_blob, args_sha256}: step 5's columns; args_sha256 (F10) is the
--                   pending record's digest of the lane, verb and arguments
--   root_seq       an import's root on an empty journal (--after-loss's m); else absent
--   switch         {after_loss, database_label}: a cutover's after-loss form (F18)
--   not_after      required: the call's bound (F3), the snapshot's database clock plus the
--                  call's client timer plus 2 s; an attempt that ends past it is LR008
--   act            a write's, made inside one of lane 4's acts (D5, F5); else absent:
--                  {id, base, generation, expect}: LANES_ACT's id (journal.act_id) and base
--                  seq, the generation its base was read in, and LANES_EXPECT's scopes, a
--                  list that may be empty (step 3b). Files mode ignores both variables.
--   edits          [{ord, op, path, line_no, old_sha256, new_text, to_path}], journal_edits'
--                  columns; old_sha256 is the sha256 of the line's UTF-8 text, without its LF
--   files          [{path, present, sha256, final_newline}]: every path an edit touches, as
--                  it stands after the write (a rename's old path is present = false)
--   lanes          [{path, line_no, raw, lane_key, lane, aliases, home, workstation,
--                    started_utc, handoff_path, state_phrase, objects_cell, session_ids,
--                    last_session, archived, owner}]
--   log_lines      [{path, line_no, raw, lane, verb, session, workstation, utc, utc_ts,
--                    object, ref, payload, payload_fields, free_text, written_lane,
--                    unreadable, unreadable_why}]
--   register_lines [{path, line_no, raw, kind, slot_role, slot_kind, lane, repo, repo_key,
--                    repo_spellings, pr, tip, utc, utc_ts, session, for_lane, workstation}]
--   object_holds   [{object, lane_key, lane, verb, utc_ts, file, ordinal, spellings, exempt}]:
--                  each lane's last line per object, as the lines stand after the write, for
--                  every lane and object that a line the entry writes, replaces or deletes
--                  names, and every one the lines of a renamed log give: step 6 deletes the
--                  holds on each line it changes, and every hold of a path it renames or
--                  removes (ERR-48); superseded_by is computed here
-- A structured row names its line by path and line_no, and its raw is that line's text.
-- Step 7 applies lanes, log_lines, register_lines, then object_holds, in that order.
DECLARE
  v_head  bigint;
  v_ver   schema_version;
  v_sw    register_switch;
  v_old   journal;                              -- F10: a write id already in the journal
  v_needs text;
  v_after_loss boolean := coalesce((p_entry -> 'switch' ->> 'after_loss')::boolean, false);
  v_seq   bigint;
  v_kind  text := p_entry -> 'journal' ->> 'kind';
  v_ws    text := p_entry -> 'journal' ->> 'workstation';
  v_wmode text;                                 -- written_mode and mode of the rows written
  v_holds jsonb := coalesce(p_entry -> 'object_holds', '[]');
  v_gone  text[] := '{}';                       -- case 6a: the objects whose holds step 6 deleted
  v_imp   journal;
  v_prior jsonb;                                -- the restore form's: what its cutover replaces
  v_line  doc_lines;
  ed      journal_edits;
  r       record;
  v_n     integer;
  v_sha   text;
  v_con   text;
  v_det   text;
  v_not_after timestamptz;                      -- F3: the call's bound (step 9)
  v_act   jsonb := p_entry -> 'act';            -- D5, F5: the act, or NULL (step 3b)
  v_expect text[];                              -- its scopes, lower case, as listed
  v_hit   record;                               -- the entry that changed one (LR009)
  v_mir   mirror_state;                         -- S5: a rollback's divergence gate (LR012)
  v_take  register_lines;                       -- U3's take, or F13's newest take
  v_close record;                               -- F13: the close that already closed it
BEGIN
  IF jsonb_typeof(p_entry -> 'journal') IS DISTINCT FROM 'object' THEN    -- the entry's shape
    RAISE EXCEPTION 'the entry has no journal object' USING ERRCODE = 'LR004'; END IF;
  IF EXISTS (SELECT 1 FROM jsonb_each(p_entry -> 'journal') k
             WHERE jsonb_typeof(k.value) NOT IN ('string', 'null'))
     OR EXISTS (SELECT 1 FROM unnest(ARRAY['edits', 'files', 'lanes', 'log_lines',
                                           'register_lines', 'object_holds']) k
                WHERE p_entry ? k AND jsonb_typeof(p_entry -> k) <> 'array')
     OR jsonb_typeof(p_entry -> 'not_after') IS DISTINCT FROM 'string' THEN
    RAISE EXCEPTION 'the entry is not well formed' USING ERRCODE = 'LR004'; END IF;
  v_not_after := (p_entry ->> 'not_after')::timestamptz;
  v_needs := CASE v_kind WHEN 'write' THEN 'primary' WHEN 'stray-import' THEN 'primary'
                         WHEN 'stray-revert' THEN 'primary' WHEN 'rollback' THEN 'primary'
                         WHEN 'import' THEN 'files' WHEN 'cutover' THEN 'files' END;
  IF v_needs IS NULL THEN
    RAISE EXCEPTION 'unknown kind %', v_kind USING ERRCODE = 'LR004'; END IF;
  v_wmode := CASE WHEN v_kind IN ('write', 'cutover') THEN 'primary' ELSE 'files' END;
  IF v_kind IN ('cutover', 'rollback') AND (      -- ruling 1: an operator entry writes lanes/STORE
       EXISTS (SELECT 1 FROM jsonb_array_elements(coalesce(p_entry -> 'files', '[]')) f   -- alone:
               WHERE f ->> 'path' IS DISTINCT FROM 'lanes/STORE')     -- no other files row and
       OR EXISTS (SELECT 1 FROM unnest(ARRAY['lanes', 'log_lines', 'register_lines',  -- no row
                                             'object_holds']) k
                  WHERE jsonb_array_length(coalesce(p_entry -> k, '[]')) > 0)) THEN
    RAISE EXCEPTION 'a % entry writes outside lanes/STORE (ruling 1)', v_kind
      USING ERRCODE = 'LR004'; END IF;
  IF v_act IS NOT NULL THEN                     -- the act's shape (D5, F5): a write's alone
    IF v_kind <> 'write' OR jsonb_typeof(v_act) <> 'object'
       OR jsonb_typeof(v_act -> 'id') IS DISTINCT FROM 'string'
       OR jsonb_typeof(v_act -> 'base') IS DISTINCT FROM 'number'
       OR jsonb_typeof(v_act -> 'generation') IS DISTINCT FROM 'string'
       OR jsonb_typeof(coalesce(v_act -> 'expect', '[]')) <> 'array' THEN
      RAISE EXCEPTION 'the entry''s act is not well formed' USING ERRCODE = 'LR004'; END IF;
    IF v_act ->> 'id' !~ '^[^@[:space:]]+$' OR v_act ->> 'base' !~ '^[0-9]+$'
       OR lower(v_act ->> 'generation')
          !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
       OR EXISTS (SELECT 1 FROM jsonb_array_elements(coalesce(v_act -> 'expect', '[]')) x
                  WHERE jsonb_typeof(x) <> 'string'
                     OR lower(x #>> '{}') !~ ('^((row|bind|objects|alias|archive):[^[:space:]]+'
                          || '|sid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$')) THEN
      RAISE EXCEPTION 'the entry''s act is not well formed' USING ERRCODE = 'LR004'; END IF;
    v_expect := ARRAY(SELECT lower(t.x) FROM jsonb_array_elements_text(coalesce(v_act -> 'expect',
                        '[]')) WITH ORDINALITY AS t(x, n) ORDER BY t.n);
  END IF;

SELECT seq INTO v_head FROM register_head WHERE id = 1 FOR UPDATE;            -- 1. the lock
SELECT * INTO v_sw FROM register_switch WHERE id = 1;                         -- the generation first,
IF p_generation IS DISTINCT FROM v_sw.generation THEN       -- F10, F18: an id from another database,
  RAISE EXCEPTION 'write % belongs to register generation %, not %', p_write_id, p_generation,
    v_sw.generation USING ERRCODE = 'LR007', DETAIL = 'generation'; END IF;  -- whatever the switch reads (S-3)
SELECT * INTO v_old FROM journal WHERE write_id = p_write_id;                 -- a write in doubt
IF FOUND THEN                                                                 -- that committed
  IF v_old.lane IS DISTINCT FROM p_entry -> 'journal' ->> 'lane'
     OR v_old.verb IS DISTINCT FROM p_entry -> 'journal' ->> 'verb'
     OR v_old.args_sha256 IS DISTINCT FROM p_entry -> 'journal' ->> 'args_sha256' THEN
    RAISE EXCEPTION 'write % is seq %, another write''s (F10)', p_write_id, v_old.seq
      USING ERRCODE = 'LR007', DETAIL = 'another-write'; END IF;
  RAISE EXCEPTION 'write % is in the journal at seq %', p_write_id, v_old.seq USING ERRCODE = 'LR006'; END IF;
IF v_head IS DISTINCT FROM p_base THEN
  RAISE EXCEPTION 'register head is %, not %', v_head, p_base USING ERRCODE = 'LR001'; END IF;
SELECT * INTO v_ver FROM schema_version WHERE id = 1;                         -- 2. the version
IF p_client > v_ver.version OR p_client < v_ver.writers_from THEN
  RAISE EXCEPTION 'register schema % (writers from %); this client is %', v_ver.version,
    v_ver.writers_from, p_client USING ERRCODE = 'LR003'; END IF;
IF NOT (CASE WHEN v_kind = 'cutover' AND v_after_loss AND v_sw.mode = 'primary'   -- 3. the switch
             THEN v_sw.marker_state = 'present'             -- a restore's after-loss cutover
             ELSE v_sw.mode = v_needs AND v_sw.marker_state =
                    CASE v_needs WHEN 'primary' THEN 'present' ELSE 'absent' END
        END) THEN
  RAISE EXCEPTION 'register switch is % with the marker %', v_sw.mode, v_sw.marker_state
    USING ERRCODE = 'LR002'; END IF;

  -- 3a. The kinds table's rules that come before the seq is taken.
  IF v_kind = 'import' THEN               -- no 'write' entry: start the journal again (head -1)
    DELETE FROM register_lines; DELETE FROM log_lines; DELETE FROM lanes;
    DELETE FROM object_holds; DELETE FROM doc_lines; DELETE FROM files;
    IF NOT EXISTS (SELECT 1 FROM journal WHERE base_seq IS NOT NULL) THEN   -- only its root; after a rollback, continue
      DELETE FROM journal_files; DELETE FROM journal_edits; DELETE FROM journal;
      UPDATE register_head SET seq = -1 WHERE id = 1;
      v_head := -1;
    END IF;
  END IF;
  IF p_entry ? 'root_seq' AND (v_kind <> 'import' OR v_head <> -1) THEN
    RAISE EXCEPTION 'root_seq % on a journal that is not empty', p_entry ->> 'root_seq'
      USING ERRCODE = 'LR004'; END IF;
  IF v_kind = 'cutover' AND v_after_loss                 -- N4: an after-loss form names its database
     AND p_entry -> 'switch' ->> 'database_label' IS NULL THEN
    RAISE EXCEPTION 'an after-loss cutover with no database_label (N4)' USING ERRCODE = 'LR004'; END IF;
  IF v_kind = 'rollback' THEN             -- S5: never over a recorded divergence (F1); FOR SHARE, so
    SELECT * INTO v_mir FROM mirror_state WHERE id = 1 FOR SHARE;   -- record_mirror_state's UPDATE
    IF v_mir.diverged_sha IS NOT NULL THEN                          -- waits, or this read waits for it
      RAISE EXCEPTION 'rollback refused: diverged at %, found % by %; resolve it first with import --single or render --revert (F1, S5)',
        v_mir.diverged_sha, v_mir.found_utc, v_mir.found_by_ws USING ERRCODE = 'LR012'; END IF;
  END IF;
  IF v_kind = 'cutover' AND NOT (v_after_loss AND v_sw.mode = 'primary') THEN
    SELECT * INTO v_imp FROM journal WHERE kind = 'import' ORDER BY seq DESC LIMIT 1;
    IF v_imp.seq IS DISTINCT FROM p_base THEN
      RAISE EXCEPTION 'cutover base %, but the latest import is %', p_base, v_imp.seq
        USING ERRCODE = 'LR004'; END IF;
  ELSIF v_kind = 'cutover' THEN           -- the restore form: what it replaces, for its abort
    IF NOT (p_entry -> 'switch' ->> 'database_label' IS DISTINCT FROM v_sw.database_label) THEN
      RAISE EXCEPTION 'after-loss cutover: database % is the switch''s own label, not a replacement''s (N4)',
        v_sw.database_label USING ERRCODE = 'LR004'; END IF;     -- N4: the live database, by mistake
    v_prior := jsonb_build_object('switch', to_jsonb(v_sw),
      'file', (SELECT to_jsonb(f) FROM files f WHERE f.path = 'lanes/STORE'),
      'lines', (SELECT jsonb_agg(to_jsonb(d) ORDER BY d.line_no) FROM doc_lines d
                WHERE d.path = 'lanes/STORE'));
  END IF;

  -- 3b. The act's expectations (S1's step 3.2; D5, F5), under the head's lock and
  -- before the seq is taken: refused when an entry after the act's base, made outside this act,
  -- touched a listed scope. Each entry's scopes are its steps 5a and 8a's, stored at its commit.
  IF cardinality(v_expect) > 0 THEN             -- no expectations: no check
    IF lower(v_act ->> 'generation')::uuid IS DISTINCT FROM v_sw.generation THEN
      RAISE EXCEPTION 'act % has its base in register generation %, not %', v_act ->> 'id',
        v_act ->> 'generation', v_sw.generation USING ERRCODE = 'LR007', DETAIL = 'act-generation'; END IF;
    IF (v_act ->> 'base')::bigint > v_head THEN
      RAISE EXCEPTION 'act % has its base at %, past the head %', v_act ->> 'id',
        v_act ->> 'base', v_head USING ERRCODE = 'LR004'; END IF;
    SELECT s.scope, s.seq, j.lane, j.verb INTO v_hit    -- one indexed query, on (scope, seq)
      FROM journal_scopes s JOIN journal j ON j.seq = s.seq
      WHERE s.scope = ANY (v_expect || '*'::text) AND s.seq > (v_act ->> 'base')::bigint
        AND j.act_id IS DISTINCT FROM v_act ->> 'id'      -- the act's own entries never refuse it
      ORDER BY s.seq, s.scope LIMIT 1;
    IF FOUND THEN
      RAISE EXCEPTION 'expectation: % changed at seq % by %/%',
        CASE v_hit.scope WHEN '*' THEN v_expect[1] ELSE v_hit.scope END, v_hit.seq, v_hit.lane,
        v_hit.verb USING ERRCODE = 'LR009'; END IF;
  END IF;

UPDATE register_head SET seq = CASE WHEN v_head = -1                          -- 4. advance; the empty journal's
    THEN coalesce((p_entry ->> 'root_seq')::bigint, 0) ELSE seq + 1 END       -- one entry is the root, at 0 or `m`
  WHERE id = 1 RETURNING seq INTO v_seq;
INSERT INTO journal (seq, base_seq, write_id, kind, verb, lane, workstation, author, message,
                     git_commit, git_tree, repos_blob, args_sha256, act_id)    -- 5. the entry
SELECT v_seq, nullif(v_head, -1), p_write_id, e.*, p_entry -> 'act' ->> 'id'  -- D5's act, or NULL
  FROM jsonb_to_record(p_entry -> 'journal')
  AS e(kind text, verb text, lane text, workstation text, author text, message text,
       git_commit text, git_tree text, repos_blob text, args_sha256 text);

  -- 5a. The touched keys' old side (D5, F5): what each line this entry replaces or deletes
  -- (found by path and old_sha256), and every line of a path it removes or renames, said
  -- before step 6 changes it; and objects: for every lane holding an object whose hold sits
  -- on such a line, since step 6 deletes that hold and step 7 re-marks the object's stored
  -- rows, so the flip is reported (case 6a; lane 3's ruling, #165 6771318480).
  IF v_kind IN ('write', 'stray-import') THEN
    INSERT INTO journal_scopes (seq, scope)
    SELECT DISTINCT v_seq, scope_checked(d.path, d.line_no, k.scope)   -- N2: LR010, not 23514
    FROM jsonb_to_recordset(coalesce(p_entry -> 'edits', '[]')) AS x(op text, path text,
         old_sha256 text)
    JOIN doc_lines d ON d.path = x.path AND (x.op IN ('remove', 'rename')
         OR (x.op IN ('replace', 'delete')
             AND encode(sha256(convert_to(d.text, 'UTF8')), 'hex') = x.old_sha256))
    CROSS JOIN LATERAL (SELECT doc_line_scopes(d.line_id, d.path)
      UNION SELECT 'objects:' || lower(o.lane_key)   -- N1: lower(), as entry_new_keys
      FROM object_holds h JOIN object_holds o ON o.object = h.object
      WHERE h.file = d.path AND h.ordinal = d.line_no AND h.object NOT LIKE 'lane:%') AS k(scope);
  END IF;

  -- 6. The edits: journal_edits as sent, then applied in ord order. The structured rows an edit
  -- leaves stale go with it (ERR-48; lane 3's ruling (c), #165 6755386771): as a replace or a
  -- delete changes a line, its lanes row by row_line_id, its log_lines and register_lines rows
  -- by line_id, and its object_holds by (file, ordinal); a remove, those of every line of its
  -- path; a rename, the old path's object_holds, while its log_lines move to the new file's
  -- lane. Step 7 then inserts what the entry sends: an entry carries no deletes. The objects
  -- whose holds go are kept in v_gone, and step 7 re-marks them (case 6a, #165 6771318480).
  INSERT INTO journal_edits (seq, ord, op, path, line_no, old_sha256, new_text, to_path)
  SELECT v_seq, x.ord, x.op, x.path, x.line_no, x.old_sha256, x.new_text, x.to_path
  FROM jsonb_to_recordset(coalesce(p_entry -> 'edits', '[]')) AS x(ord integer, op text,
       path text, line_no integer, old_sha256 text, new_text text, to_path text);
  IF v_kind IN ('cutover', 'rollback')                     -- D24, F2: an operator entry has edits
     AND NOT EXISTS (SELECT 1 FROM journal_edits WHERE seq = v_seq) THEN
    RAISE EXCEPTION 'a % entry with no edit', v_kind USING ERRCODE = 'LR004'; END IF;
  FOR ed IN SELECT * FROM journal_edits WHERE seq = v_seq ORDER BY ord LOOP
    IF (ed.path = 'lanes/STORE') <> (v_kind IN ('cutover', 'rollback')) THEN  -- and edits
      RAISE EXCEPTION 'edit %: a % edits lanes/STORE alone, or never', ed.ord, v_kind  -- STORE alone
        USING ERRCODE = 'LR004'; END IF;
    IF (v_kind = 'import' AND ed.op NOT IN ('create', 'append')) OR v_kind = 'stray-revert' THEN
      RAISE EXCEPTION 'edit %: a % may not %', ed.ord, v_kind, ed.op USING ERRCODE = 'LR004';
    END IF;
    IF (ed.op = 'create') = EXISTS (SELECT 1 FROM files WHERE path = ed.path) THEN
      RAISE EXCEPTION 'edit %: % % %', ed.ord, ed.op, ed.path,
        CASE WHEN ed.op = 'create' THEN 'exists' ELSE 'does not exist' END
        USING ERRCODE = 'LR004'; END IF;
    CASE ed.op
    WHEN 'create' THEN
      INSERT INTO files (path, final_newline, sha256, last_seq)     -- step 8 sets the last two
      VALUES (ed.path, true, encode(sha256(''::bytea), 'hex'), v_seq);
    WHEN 'append' THEN
      SELECT coalesce(max(line_no), 0) + 1 INTO v_n FROM doc_lines WHERE path = ed.path;
      IF ed.line_no IS DISTINCT FROM NULL AND ed.line_no <> v_n THEN
        RAISE EXCEPTION 'edit %: append at %, but % has % lines', ed.ord, ed.line_no, ed.path,
          v_n - 1 USING ERRCODE = 'LR004'; END IF;
      INSERT INTO doc_lines (path, line_no, text, written_seq, written_mode, written_ws)
      VALUES (ed.path, v_n, ed.new_text, v_seq, v_wmode, v_ws);
    WHEN 'replace', 'delete' THEN
      SELECT * INTO v_line FROM doc_lines WHERE path = ed.path AND line_no = ed.line_no;
      IF NOT FOUND OR encode(sha256(convert_to(v_line.text, 'UTF8')), 'hex') <> ed.old_sha256 THEN
        RAISE EXCEPTION 'edit %: % line % is not %', ed.ord, ed.path, ed.line_no, ed.old_sha256
          USING ERRCODE = 'LR004'; END IF;
      -- The line's structured rows go before it changes, and step 7 inserts what the entry
      -- sends. Its holds go too, so a delete's shift below leaves none of them on the line
      -- that moves into its place.
      DELETE FROM lanes WHERE row_line_id = v_line.line_id;
      DELETE FROM log_lines WHERE line_id = v_line.line_id;
      DELETE FROM register_lines WHERE line_id = v_line.line_id;
      WITH g AS (DELETE FROM object_holds WHERE file = ed.path AND ordinal = ed.line_no
                 RETURNING object)
      SELECT v_gone || ARRAY(SELECT object FROM g) INTO v_gone;
      IF ed.op = 'replace' THEN
        UPDATE doc_lines SET text = ed.new_text, written_seq = v_seq, written_mode = v_wmode,
                             written_ws = v_ws
        WHERE line_id = v_line.line_id;
      ELSE                                      -- doc_lines_pos checks at the statement's end
        DELETE FROM doc_lines WHERE line_id = v_line.line_id;
        UPDATE doc_lines SET line_no = line_no - 1 WHERE path = ed.path AND line_no > ed.line_no;
        UPDATE log_lines SET ordinal = ordinal - 1 WHERE file = ed.path AND ordinal > ed.line_no;
        UPDATE object_holds SET ordinal = ordinal - 1 WHERE file = ed.path AND ordinal > ed.line_no;
      END IF;
    WHEN 'rename' THEN
      IF EXISTS (SELECT 1 FROM files WHERE path = ed.to_path) THEN
        RAISE EXCEPTION 'edit %: % exists', ed.ord, ed.to_path USING ERRCODE = 'LR004'; END IF;
      UPDATE files SET path = ed.to_path WHERE path = ed.path;   -- cascades to doc_lines
      WITH g AS (DELETE FROM object_holds WHERE file = ed.path   -- the entry sends the new path's
                 RETURNING object)
      SELECT v_gone || ARRAY(SELECT object FROM g) INTO v_gone;
      -- The log's lines move to the new file's lane, by file_lane (code/lanes-index:530-532),
      -- and a lane-kind object names that lane, as parse_log's does (:618-645).
      UPDATE log_lines SET file = ed.to_path,
        lane = regexp_replace(regexp_replace(ed.to_path, '^.*/', ''), '\.[Mm][Dd]$', '')
      WHERE file = ed.path;
      UPDATE log_lines SET object = 'lane:' || lane
      WHERE file = ed.to_path AND object LIKE 'lane:%';
    WHEN 'remove' THEN                          -- every line's structured rows, then the lines
      DELETE FROM lanes WHERE row_line_id IN (SELECT line_id FROM doc_lines WHERE path = ed.path);
      DELETE FROM log_lines WHERE line_id IN (SELECT line_id FROM doc_lines WHERE path = ed.path);
      DELETE FROM register_lines WHERE line_id IN (SELECT line_id FROM doc_lines
                                                   WHERE path = ed.path);
      WITH g AS (DELETE FROM object_holds WHERE file = ed.path RETURNING object)
      SELECT v_gone || ARRAY(SELECT object FROM g) INTO v_gone;
      DELETE FROM doc_lines WHERE path = ed.path;
      DELETE FROM files WHERE path = ed.path;
    END CASE;
  END LOOP;

  -- 7. The structured rows, upserted by key, each given its line's line_id.
  FOR r IN
    SELECT x.t, x.path, x.line_no, x.raw, d.line_id, d.text FROM (
      SELECT 'lanes' AS t, path, line_no, raw FROM jsonb_to_recordset(coalesce(p_entry -> 'lanes',
        '[]')) AS y(path text, line_no integer, raw text)
      UNION ALL SELECT 'log_lines', path, line_no, raw FROM jsonb_to_recordset(coalesce(
        p_entry -> 'log_lines', '[]')) AS y(path text, line_no integer, raw text)
      UNION ALL SELECT 'register_lines', path, line_no, raw FROM jsonb_to_recordset(coalesce(
        p_entry -> 'register_lines', '[]')) AS y(path text, line_no integer, raw text)) x
    LEFT JOIN doc_lines d ON d.path = x.path AND d.line_no = x.line_no
  LOOP
    IF r.line_id IS NULL OR r.text IS DISTINCT FROM r.raw THEN
      RAISE EXCEPTION '% row at % line %: no such line, or raw is not its text', r.t, r.path,
        r.line_no
        USING ERRCODE = 'LR004'; END IF;
  END LOOP;
  INSERT INTO lanes AS o (lane_key, lane, row_line_id, aliases, home, workstation, started_utc,
                          handoff_path, state_phrase, objects_cell, session_ids, last_session,
                          archived, owner, last_seq, last_mode)
  SELECT x.lane_key, x.lane, d.line_id, x.aliases, x.home, x.workstation, x.started_utc,
         x.handoff_path, x.state_phrase, x.objects_cell, x.session_ids, x.last_session,
         x.archived, x.owner, v_seq, v_wmode
  FROM jsonb_to_recordset(coalesce(p_entry -> 'lanes', '[]')) AS x(path text, line_no integer,
       lane_key text, lane text, aliases jsonb, home text, workstation text, started_utc text,
       handoff_path text, state_phrase text, objects_cell text, session_ids jsonb,
       last_session text, archived boolean, owner text)
  JOIN doc_lines d ON d.path = x.path AND d.line_no = x.line_no
  ON CONFLICT (lane_key) DO UPDATE SET lane = EXCLUDED.lane, row_line_id = EXCLUDED.row_line_id,
    aliases = EXCLUDED.aliases, home = EXCLUDED.home, workstation = EXCLUDED.workstation,
    started_utc = EXCLUDED.started_utc, handoff_path = EXCLUDED.handoff_path,
    state_phrase = EXCLUDED.state_phrase, objects_cell = EXCLUDED.objects_cell,
    session_ids = EXCLUDED.session_ids, last_session = EXCLUDED.last_session,
    archived = EXCLUDED.archived, owner = EXCLUDED.owner, last_seq = EXCLUDED.last_seq,
    last_mode = EXCLUDED.last_mode;
  INSERT INTO log_lines (line_id, file, ordinal, lane, verb, session, workstation, utc, utc_ts,
                         object, ref, payload, payload_fields, free_text, written_lane,
                         unreadable, unreadable_why, raw, seq, mode)
  SELECT d.line_id, x.path, x.line_no, x.lane, x.verb, x.session, x.workstation, x.utc,
         x.utc_ts, x.object, x.ref, x.payload, x.payload_fields, x.free_text, x.written_lane,
         x.unreadable, x.unreadable_why, x.raw, v_seq, v_wmode
  FROM jsonb_to_recordset(coalesce(p_entry -> 'log_lines', '[]')) AS x(path text,
       line_no integer, raw text, lane text, verb text, session text, workstation text,
       utc text, utc_ts timestamptz, object text, ref text, payload text, payload_fields jsonb,
       free_text text, written_lane text, unreadable boolean, unreadable_why text)
  JOIN doc_lines d ON d.path = x.path AND d.line_no = x.line_no
  ON CONFLICT (line_id) DO UPDATE SET file = EXCLUDED.file, ordinal = EXCLUDED.ordinal,
    lane = EXCLUDED.lane, verb = EXCLUDED.verb, session = EXCLUDED.session,
    workstation = EXCLUDED.workstation, utc = EXCLUDED.utc, utc_ts = EXCLUDED.utc_ts,
    object = EXCLUDED.object, ref = EXCLUDED.ref, payload = EXCLUDED.payload,
    payload_fields = EXCLUDED.payload_fields, free_text = EXCLUDED.free_text,
    written_lane = EXCLUDED.written_lane, unreadable = EXCLUDED.unreadable,
    unreadable_why = EXCLUDED.unreadable_why, raw = EXCLUDED.raw, seq = EXCLUDED.seq,
    mode = EXCLUDED.mode;
  INSERT INTO register_lines (line_id, kind, slot_role, slot_kind, lane, repo, repo_key, pr, tip,
                              utc, utc_ts, session, for_lane, raw, seq, mode, workstation,
                              repo_spellings)
  SELECT d.line_id, x.kind, x.slot_role, x.slot_kind, x.lane, x.repo, x.repo_key, x.pr, x.tip,
         x.utc, x.utc_ts, x.session, x.for_lane, x.raw, v_seq, v_wmode, x.workstation,
         x.repo_spellings
  FROM jsonb_to_recordset(coalesce(p_entry -> 'register_lines', '[]')) AS x(path text,
       line_no integer, raw text, kind text, slot_role text, slot_kind text, lane text,
       repo text, repo_key text, pr integer, tip text, utc text, utc_ts timestamptz,
       session text, for_lane text, workstation text, repo_spellings text[])
  JOIN doc_lines d ON d.path = x.path AND d.line_no = x.line_no
  ON CONFLICT (line_id) DO UPDATE SET kind = EXCLUDED.kind, slot_role = EXCLUDED.slot_role,
    slot_kind = EXCLUDED.slot_kind, lane = EXCLUDED.lane, repo = EXCLUDED.repo,
    repo_key = EXCLUDED.repo_key, pr = EXCLUDED.pr, tip = EXCLUDED.tip, utc = EXCLUDED.utc,
    utc_ts = EXCLUDED.utc_ts, session = EXCLUDED.session, for_lane = EXCLUDED.for_lane,
    raw = EXCLUDED.raw, seq = EXCLUDED.seq, mode = EXCLUDED.mode,
    workstation = EXCLUDED.workstation, repo_spellings = EXCLUDED.repo_spellings;
  -- superseded_by, #160's rule (code/lanes-index:1013-1036): a lane's state on an object is
  -- its own last line on it, and another lane whose own last line on it is a TAKEOVER
  -- supersedes it. The stored rows of each touched object are re-marked first, against the
  -- incoming rows, so no transient pair of live claims trips one_live_claim. An object whose
  -- hold step 6 deleted is touched though the entry sends no hold on it (case 6a; lane 3's
  -- ruling, #165 6771318480). A re-mark stamps no seq or mode, so D19 never takes such a row
  -- for this entry's own claim, and an exempt row keeps its files mode.
  BEGIN                                         -- a 23505 on one_live_claim is LR005
  UPDATE object_holds h SET superseded_by = (
    SELECT min(e.lane_key) FROM (
      SELECT i.object, i.lane_key, i.verb
      FROM jsonb_to_recordset(v_holds) AS i(object text, lane_key text, verb text)
      UNION ALL
      SELECT s.object, s.lane_key, s.verb FROM object_holds s
      WHERE NOT v_holds @> jsonb_build_array(jsonb_build_object('object', s.object,
                                                                'lane_key', s.lane_key))) e
    WHERE e.object = h.object AND e.lane_key <> h.lane_key AND e.verb = 'TAKEOVER')
  WHERE v_holds @> jsonb_build_array(jsonb_build_object('object', h.object))
     OR h.object = ANY (v_gone);
  INSERT INTO object_holds (object, lane_key, lane, verb, utc_ts, file, ordinal, superseded_by,
                            spellings, exempt, seq, mode)
  SELECT x.object, x.lane_key, x.lane, x.verb, x.utc_ts, x.file, x.ordinal,
         (SELECT min(e.lane_key) FROM (
            SELECT i.object, i.lane_key, i.verb
            FROM jsonb_to_recordset(v_holds) AS i(object text, lane_key text, verb text)
            UNION ALL
            SELECT s.object, s.lane_key, s.verb FROM object_holds s
            WHERE NOT v_holds @> jsonb_build_array(jsonb_build_object('object', s.object,
                                                                      'lane_key', s.lane_key))) e
          WHERE e.object = x.object AND e.lane_key <> x.lane_key AND e.verb = 'TAKEOVER'),
         x.spellings, v_kind = 'import' AND coalesce(x.exempt, false), v_seq, v_wmode
  FROM jsonb_to_recordset(v_holds) AS x(object text, lane_key text, lane text, verb text,
       utc_ts timestamptz, file text, ordinal integer, spellings text[], exempt boolean)
  ON CONFLICT (object, lane_key) DO UPDATE SET lane = EXCLUDED.lane, verb = EXCLUDED.verb,
    utc_ts = EXCLUDED.utc_ts, file = EXCLUDED.file, ordinal = EXCLUDED.ordinal,
    superseded_by = EXCLUDED.superseded_by, spellings = EXCLUDED.spellings,
    exempt = EXCLUDED.exempt, seq = EXCLUDED.seq, mode = EXCLUDED.mode;
  EXCEPTION WHEN unique_violation THEN
    GET STACKED DIAGNOSTICS v_con = CONSTRAINT_NAME, v_det = PG_EXCEPTION_DETAIL;
    IF v_con = 'one_live_claim' THEN
      RAISE EXCEPTION 'the object is held (one_live_claim): %', v_det
        USING ERRCODE = 'LR005', DETAIL = 'one-live-claim';
    END IF;
    RAISE;
  END;
  IF v_wmode = 'primary' THEN                   -- the register's own rules bind new writes
    SELECT * INTO v_take FROM register_lines n    -- U3: Rule 6's 30 minutes are measured from a
      WHERE n.seq = v_seq AND n.slot_role = 'take' AND n.utc_ts IS NULL LIMIT 1;   -- take's UTC
    IF FOUND THEN
      RAISE EXCEPTION 'a % take with no readable UTC (U3): %', v_take.kind, left(v_take.raw, 160)
        USING ERRCODE = 'LR005', DETAIL = 'take-no-utc'; END IF;
    IF EXISTS (SELECT 1 FROM object_holds n JOIN object_holds o ON o.lane_key <> n.lane_key
               WHERE n.seq = v_seq AND n.verb IN ('CLAIMED', 'TAKEOVER')
                 AND n.superseded_by IS NULL AND NOT n.exempt
                 AND o.verb IN ('CLAIMED', 'TAKEOVER') AND o.superseded_by IS NULL
                 AND n.spellings && o.spellings) THEN
      RAISE EXCEPTION 'a claim''s spellings overlap another lane''s live claim (D19)'
        USING ERRCODE = 'LR005', DETAIL = 'claim-spellings'; END IF;
    IF EXISTS (SELECT 1 FROM register_lines n JOIN main_slots m      -- one repository, however
                 ON m.repo_key = n.repo_key OR m.repo_spellings && n.repo_spellings   -- spelled
               WHERE n.seq = v_seq AND n.slot_role = 'take' AND m.line_id < n.line_id
                 AND lower(m.lane) <> lower(n.lane)) THEN
      RAISE EXCEPTION 'another lane holds main for this repository first (D18)'
        USING ERRCODE = 'LR005', DETAIL = 'main-held'; END IF;
    FOR r IN SELECT * FROM register_lines n               -- F13: a LANDING EXPIRED closes the
             WHERE n.seq = v_seq AND n.kind = 'LANDING EXPIRED' LOOP   -- holder's stale LANDING
      SELECT * INTO v_take FROM register_lines t   -- C1: the holder's newest take that it closes,
        WHERE t.slot_role = 'take' AND t.slot_kind = 'landing'          -- matched as main_slots
          AND (t.repo_key = r.repo_key OR t.repo_spellings && r.repo_spellings)    -- matches
          AND t.pr = r.pr AND lower(t.lane) = lower(r.for_lane) AND t.line_id < r.line_id
        ORDER BY t.line_id DESC LIMIT 1;
      IF NOT FOUND OR v_take.repo_key IS DISTINCT FROM r.repo_key THEN   -- point 5: repo_key alone
        RAISE EXCEPTION 'no open LANDING by % for PR #% under repo_key % (F13): there is none, or its newest is keyed %',
          r.for_lane, r.pr, r.repo_key, coalesce(v_take.repo_key, '-')
          USING ERRCODE = 'LR005', DETAIL = 'expired-none'; END IF;
      SELECT c.kind, c.lane INTO v_close FROM register_lines c    -- C2: a close, matched as
        WHERE c.slot_role = 'close' AND c.slot_kind = 'landing'     -- main_slots matches one
          AND (c.repo_key = v_take.repo_key OR c.repo_spellings && v_take.repo_spellings)
          AND c.pr = v_take.pr AND c.line_id > v_take.line_id AND c.line_id <> r.line_id
          AND lower(coalesce(c.for_lane, c.lane)) = lower(v_take.lane)
        ORDER BY c.line_id LIMIT 1;
      IF FOUND THEN
        RAISE EXCEPTION '%''s LANDING for PR #% under repo_key % is already closed, by a % of % (F13)',
          v_take.lane, v_take.pr, v_take.repo_key, v_close.kind, v_close.lane
          USING ERRCODE = 'LR005', DETAIL = 'expired-closed'; END IF;
      IF NOT coalesce(clock_timestamp() - v_take.utc_ts > interval '30 minutes', false) THEN
        RAISE EXCEPTION '%''s newest LANDING for PR #% under repo_key % is too young (F13): its age by the database''s clock is %, not more than Rule 6''s 30 minutes',
          v_take.lane, v_take.pr, v_take.repo_key,
          coalesce(date_trunc('second', clock_timestamp() - v_take.utc_ts)::text, 'unknown, since its UTC cannot be read')
          USING ERRCODE = 'LR005', DETAIL = 'expired-young'; END IF;
    END LOOP;
  END IF;

  -- 8. The proof: every touched path is in the entry's files, and renders to its digest.
  IF EXISTS (SELECT 1 FROM journal_edits j, LATERAL (VALUES (j.path), (j.to_path)) t(p)
             WHERE j.seq = v_seq AND t.p IS NOT NULL
               AND NOT coalesce(p_entry -> 'files', '[]') @> jsonb_build_array(
                         jsonb_build_object('path', t.p))) THEN
    RAISE EXCEPTION 'an edited path has no files row in the entry' USING ERRCODE = 'LR004';
  END IF;
  FOR r IN SELECT * FROM jsonb_to_recordset(coalesce(p_entry -> 'files', '[]'))
             AS x(path text, present boolean, sha256 text, final_newline boolean) LOOP
    INSERT INTO journal_files (seq, path, present, sha256, final_newline)
    VALUES (v_seq, r.path, r.present, r.sha256, r.final_newline);
    IF r.present THEN
      UPDATE files SET final_newline = coalesce(r.final_newline, final_newline)
      WHERE path = r.path;
      v_sha := encode(sha256(render_file(r.path)), 'hex');
      IF v_sha IS DISTINCT FROM r.sha256 THEN
        RAISE EXCEPTION 'proof: % renders %, the entry says %', r.path, v_sha, r.sha256
          USING ERRCODE = 'LR004'; END IF;
      UPDATE files SET sha256 = r.sha256, last_seq = v_seq WHERE path = r.path;
    ELSIF EXISTS (SELECT 1 FROM files WHERE path = r.path) THEN
      RAISE EXCEPTION 'proof: % is present', r.path USING ERRCODE = 'LR004';
    END IF;
  END LOOP;

  -- 8a. The touched keys' new side (D5, F5), from what the entry wrote, never from a list it
  -- sends: each line it appended or replaced, each line a rename moved, read at its new path,
  -- and objects: for every lane holding an object it wrote a hold for, since a TAKEOVER
  -- supersedes the others and the taker's next line may restore them (entry_new_keys). An
  -- import, a cutover and a rollback move what every read rests on: their one key is '*', which
  -- every scope meets. N2: each key is checked before it is stored, in path and line order, and
  -- an import checks every key its lines and holds derive, though it stores only '*'.
  IF v_kind IN ('import', 'cutover', 'rollback') THEN
    INSERT INTO journal_scopes (seq, scope) VALUES (v_seq, '*');
  END IF;
  IF v_kind = 'import' THEN
    PERFORM count(scope_checked(k.path, k.line_no, k.scope))
      FROM (SELECT * FROM entry_new_keys(v_seq) ORDER BY 1, 2, 3) AS k;
  ELSIF v_kind NOT IN ('cutover', 'rollback') THEN
    INSERT INTO journal_scopes (seq, scope)
    SELECT v_seq, scope_checked(k.path, k.line_no, k.scope)
      FROM (SELECT * FROM entry_new_keys(v_seq) ORDER BY 1, 2, 3) AS k
    ON CONFLICT DO NOTHING;
  END IF;

  -- The kinds table's rules that come after: D24's two operator entries move the switch.
  IF v_kind = 'cutover' THEN                    -- set_seq: its own seq, 1, m+1 after a re-import, or b+1 after a restore
    UPDATE register_switch SET mode = 'primary', marker_state = 'adding', marker_seq = v_seq,
      import_seq = coalesce(v_imp.seq, import_seq),             -- a restore's has no import entry
      import_commit = coalesce(v_imp.git_commit, import_commit),
      import_tree = coalesce(v_imp.git_tree, import_tree), set_seq = v_seq,
      database_label = CASE WHEN v_after_loss THEN p_entry -> 'switch' ->> 'database_label'
                            ELSE database_label END,
      generation = CASE WHEN v_after_loss THEN gen_random_uuid() ELSE generation END,
      set_utc = date_trunc('second', clock_timestamp()),
      set_by_lane = p_entry -> 'journal' ->> 'lane', set_by_ws = v_ws,
      restore_prior = v_prior                   -- NULL but in the restore form
    WHERE id = 1;
  ELSIF v_kind = 'rollback' THEN                -- set_seq: its own entry, the last seq, k+1
    UPDATE register_switch SET mode = 'files', marker_state = 'removing', marker_seq = v_seq,
      set_seq = v_seq, set_utc = date_trunc('second', clock_timestamp()),
      set_by_lane = p_entry -> 'journal' ->> 'lane', set_by_ws = v_ws
    WHERE id = 1;
  ELSIF v_kind IN ('stray-import', 'stray-revert') THEN
    UPDATE mirror_state SET diverged_sha = NULL, found_utc = NULL, found_by_ws = NULL
    WHERE id = 1;
  END IF;
  IF NOT (clock_timestamp() < v_not_after) THEN  -- 9. the bound (F3): past it, nothing commits
    RAISE EXCEPTION 'write % reached its end at %, past its not_after %', p_write_id,
      clock_timestamp(), v_not_after USING ERRCODE = 'LR008'; END IF;
  RETURN v_seq;                                 -- the deferred foreign keys check at COMMIT
END $f$;

CREATE FUNCTION switch_to_files(p_client integer, p_cutover_seq bigint, p_lane text, p_ws text)
  RETURNS bigint LANGUAGE plpgsql SECURITY DEFINER
  SET search_path = lanes_register, pg_catalog, pg_temp AS $f$
-- The cutover's abort (F2): run only after a read-back proves the entry's commit absent from
-- origin. In the restore form it puts back what restore_prior holds and sets nothing to files.
DECLARE
  v_head bigint;
  v_ver  schema_version;
  v_sw   register_switch;
BEGIN
  SELECT seq INTO v_head FROM register_head WHERE id = 1 FOR UPDATE;         -- the same lock
  SELECT * INTO v_ver FROM schema_version WHERE id = 1;
  IF p_client > v_ver.version OR p_client < v_ver.writers_from THEN
    RAISE EXCEPTION 'register schema % (writers from %); this client is %', v_ver.version,
      v_ver.writers_from, p_client USING ERRCODE = 'LR003'; END IF;
  SELECT * INTO v_sw FROM register_switch WHERE id = 1;       -- an unconfirmed cutover only
  IF v_sw.mode <> 'primary' OR v_sw.marker_state <> 'adding'
     OR v_sw.marker_seq IS DISTINCT FROM p_cutover_seq OR v_head <> p_cutover_seq THEN
    RAISE EXCEPTION 'no unconfirmed cutover at seq %', p_cutover_seq USING ERRCODE = 'LR002'; END IF;
  DELETE FROM doc_lines     WHERE path = 'lanes/STORE';       -- its rows, children first
  DELETE FROM files         WHERE path = 'lanes/STORE';
  IF v_sw.restore_prior IS NOT NULL THEN                      -- the restore form: lanes/STORE
    INSERT INTO files                                         -- as it was at b, line ids too
      SELECT * FROM jsonb_populate_record(NULL::files, v_sw.restore_prior -> 'file');
    INSERT INTO doc_lines OVERRIDING SYSTEM VALUE
      SELECT * FROM jsonb_populate_recordset(NULL::doc_lines, v_sw.restore_prior -> 'lines');
  END IF;
  DELETE FROM journal_files WHERE seq = p_cutover_seq;
  DELETE FROM journal_edits WHERE seq = p_cutover_seq;
  DELETE FROM journal       WHERE seq = p_cutover_seq;
  UPDATE register_head SET seq = p_cutover_seq - 1 WHERE id = 1;   -- a new row version: every
                                                                    -- older writer snapshot gets 40001
  IF v_sw.restore_prior IS NOT NULL THEN                      -- and the switch row as it was:
    DELETE FROM register_switch WHERE id = 1;                 -- primary, present, its label and
    INSERT INTO register_switch                               -- generation; no seq after b
      SELECT * FROM jsonb_populate_record(NULL::register_switch, v_sw.restore_prior -> 'switch');
    RETURN p_cutover_seq - 1;
  END IF;
  UPDATE register_switch SET mode = 'files', marker_state = 'absent', marker_seq = NULL,
    set_seq = p_cutover_seq - 1,
    set_utc = date_trunc('second', clock_timestamp()), set_by_lane = p_lane, set_by_ws = p_ws
  WHERE id = 1;
  RETURN p_cutover_seq - 1;
END $f$;

CREATE FUNCTION record_marker(p_client integer, p_seq bigint, p_commit text, p_ws text)
  RETURNS text LANGUAGE plpgsql SECURITY DEFINER
  SET search_path = lanes_register, pg_catalog, pg_temp AS $f$
-- S4's read-back of an operator entry's push, recorded (F12).
DECLARE
  v_ver schema_version;
  v_sw  register_switch;
  v_new text;
BEGIN
  PERFORM 1 FROM register_head WHERE id = 1 FOR UPDATE;      -- serialises with the abort
  SELECT * INTO v_ver FROM schema_version WHERE id = 1;
  IF p_client > v_ver.version OR p_client < v_ver.writers_from THEN
    RAISE EXCEPTION 'register schema % (writers from %); this client is %', v_ver.version,
      v_ver.writers_from, p_client USING ERRCODE = 'LR003'; END IF;
  SELECT * INTO v_sw FROM register_switch WHERE id = 1;
  IF v_sw.marker_state NOT IN ('adding', 'removing') OR v_sw.marker_seq IS DISTINCT FROM p_seq THEN
    RAISE EXCEPTION 'no unconfirmed operator entry at seq %', p_seq USING ERRCODE = 'LR002'; END IF;
  v_new := CASE v_sw.marker_state WHEN 'adding' THEN 'present' ELSE 'absent' END;
  UPDATE register_switch SET marker_state = v_new, marker_commit = p_commit,
    set_utc = date_trunc('second', clock_timestamp()), set_by_ws = p_ws,
    restore_prior = NULL                       -- confirmed: nothing left to put back
  WHERE id = 1;
  RETURN v_new;
END $f$;

CREATE FUNCTION find_write(p_write_id uuid, p_not_after timestamptz, p_generation uuid,
                           p_lane text, p_verb text, p_args_sha256 text)
  RETURNS bigint LANGUAGE plpgsql SECURITY DEFINER
  SET search_path = lanes_register, pg_catalog, pg_temp AS $f$
-- F3's one lookup (S2; D8, S1), at READ COMMITTED in a transaction the caller rolls back.
-- p_not_after is the largest not_after the write's commit calls carried, and p_generation,
-- p_lane, p_verb and p_args_sha256 are what those calls sent (NIT 1). It waits, holding no
-- lock, until the server's clock has passed p_not_after, at most 3 s (the call's statement_timeout
-- less its lock_timeout and 1 s); then it takes the head row's lock under the caller's
-- lock_timeout (55P03 while a transaction of the write may still be open), checks the clock again
-- under it, the exact complement of commit_write's step 9, then checks as commit_write does, in
-- its order (S-3): another generation is LR007, and so is an entry of this id for another lane,
-- verb or arguments. It returns the write's seq, or NULL if it is absent. The writer has no
-- UPDATE, so it cannot take that lock itself.
DECLARE
  v_wait interval := p_not_after - clock_timestamp();
  v_gen  uuid;                                  -- the switch's generation, under the lock
  v_old  journal;                               -- the entry of this id, if any
BEGIN
  IF p_not_after IS NULL THEN
    RAISE EXCEPTION 'lookup of write %: no not_after', p_write_id USING ERRCODE = 'LR011'; END IF;
  IF v_wait > interval '3 seconds' THEN                 -- LR011: further ahead than the wait's bound
    RAISE EXCEPTION 'lookup of write %: not_after % is % ahead of the database clock, past the 3 s wait',
      p_write_id, p_not_after, v_wait USING ERRCODE = 'LR011'; END IF;
  IF v_wait > interval '0' THEN                         -- the wait, on the server's clock, before the lock
    PERFORM pg_sleep(extract(epoch FROM v_wait) + 0.001); END IF;
  PERFORM 1 FROM register_head WHERE id = 1 FOR UPDATE;
  IF clock_timestamp() < p_not_after THEN               -- step 9 commits only while this holds
    RAISE EXCEPTION 'lookup of write %: the database clock % has not passed not_after % under the head row''s lock',
      p_write_id, clock_timestamp(), p_not_after USING ERRCODE = 'LR011'; END IF;
  SELECT generation INTO v_gen FROM register_switch WHERE id = 1;
  IF p_generation IS DISTINCT FROM v_gen THEN          -- commit_write's order: the generation first
    RAISE EXCEPTION 'write % belongs to register generation %, not %', p_write_id, p_generation,
      v_gen USING ERRCODE = 'LR007', DETAIL = 'generation'; END IF;
  SELECT * INTO v_old FROM journal WHERE write_id = p_write_id;
  IF NOT FOUND THEN RETURN NULL; END IF;               -- absent
  IF v_old.lane IS DISTINCT FROM p_lane OR v_old.verb IS DISTINCT FROM p_verb
     OR v_old.args_sha256 IS DISTINCT FROM p_args_sha256 THEN   -- then another write's entry
    RAISE EXCEPTION 'write % is seq %, another write''s (F10)', p_write_id, v_old.seq
      USING ERRCODE = 'LR007', DETAIL = 'another-write'; END IF;
  RETURN v_old.seq;                                    -- found: this write's own entry
END $f$;

CREATE FUNCTION record_mirror_state(p_ws text, p_diverged_sha text, p_error text)
  RETURNS void LANGUAGE plpgsql SECURITY DEFINER
  SET search_path = lanes_register, pg_catalog, pg_temp AS $f$
-- S5: its UPDATE takes the row's FOR NO KEY UPDATE lock, which conflicts with a rollback's FOR
-- SHARE, so it waits for that rollback to end, and a rollback that reaches the row after it waits
-- for it. It reads nothing before it writes and takes no other lock, so no explicit lock is needed.
BEGIN
  UPDATE mirror_state SET                      -- each right-hand side reads the old row
    found_utc   = CASE WHEN diverged_sha IS NOT NULL OR p_diverged_sha IS NULL THEN found_utc
                       ELSE date_trunc('second', clock_timestamp()) END,
    found_by_ws = CASE WHEN diverged_sha IS NOT NULL OR p_diverged_sha IS NULL THEN found_by_ws
                       ELSE p_ws END,
    diverged_sha = coalesce(diverged_sha, p_diverged_sha),   -- D16: the first finder's; only a
                                                             -- stray entry clears it
    last_error = p_error,
    last_error_utc = CASE WHEN p_error IS NULL THEN NULL
                          ELSE date_trunc('second', clock_timestamp()) END
  WHERE id = 1;
END $f$;

-- Migration 1's rows, from operations.md §2.4's bootstrap inputs (psql -v repo=… label=… lane=… ws=… script_sha256=…).
INSERT INTO schema_version (version, writers_from, readers_from, applied_utc)
  VALUES (1, 1, 1, date_trunc('second', clock_timestamp()));
INSERT INTO register_head (seq) VALUES (-1);
INSERT INTO mirror_state DEFAULT VALUES;
INSERT INTO register_switch (mode, marker_state, generation, repository, database_label, set_utc,
                             set_seq, set_by_lane, set_by_ws)
  VALUES ('files', 'absent', gen_random_uuid(), :'repo', :'label',
          date_trunc('second', clock_timestamp()), -1, :'lane', :'ws');
INSERT INTO migrations (version, script_sha256, by_lane, by_ws)
  VALUES (1, :'script_sha256', :'lane', :'ws');
COMMIT;                                        -- then 1.4's statements after its CREATE ROLEs
"""

#: Every migration this build ships, by number. Each script is one transaction,
#: sent whole as one `psql` call.
REGISTER_MIGRATIONS = {
    1: _REGISTER_M1_TABLES + "\n" + _REGISTER_M1_FUNCTIONS,
}

#: The `schema_version` row a script leaves: migration 1's INSERT, or a later
#: script's UPDATE.
_REGISTER_VERSION_ROW_RE = re.compile(
    r"INSERT INTO schema_version \(version, writers_from, readers_from, applied_utc\)\s+"
    r"VALUES \((\d+), (\d+), (\d+),"
    r"|UPDATE schema_version SET version = (\d+), writers_from = (\d+), readers_from = (\d+)")


def _register_migrations_consistent() -> None:
    """THE ONE-NUMBER RULE INSIDE THIS FILE, checked before anything is sent.
    The scripts are numbered 1 to `REGISTER_SCHEMA_VERSION` with no gap. The
    floors keep `schema_version`'s CHECK. The newest script leaves the version
    and floors the constants name. A build that breaks this is a defect, so
    the error is not a refusal."""
    if sorted(REGISTER_MIGRATIONS) != list(range(1, REGISTER_SCHEMA_VERSION + 1)):
        raise RuntimeError(f"register migrations {sorted(REGISTER_MIGRATIONS)} are not 1 to "
                           f"REGISTER_SCHEMA_VERSION {REGISTER_SCHEMA_VERSION}")
    if not 1 <= REGISTER_READERS_FROM <= REGISTER_WRITERS_FROM <= REGISTER_SCHEMA_VERSION:
        raise RuntimeError(f"register floors: readers from {REGISTER_READERS_FROM}, writers from "
                           f"{REGISTER_WRITERS_FROM}, version {REGISTER_SCHEMA_VERSION}")
    rows = [tuple(int(n) for n in m.groups() if n is not None)
            for m in _REGISTER_VERSION_ROW_RE.finditer(REGISTER_MIGRATIONS[REGISTER_SCHEMA_VERSION])]
    want = (REGISTER_SCHEMA_VERSION, REGISTER_WRITERS_FROM, REGISTER_READERS_FROM)
    if rows != [want]:
        raise RuntimeError(f"register migration {REGISTER_SCHEMA_VERSION} leaves schema_version "
                           f"{rows}, not {want}")


def register_migration_sha256(version: int) -> str:
    """The `script_sha256` that migration `version`'s `migrations` row records:
    the sha256 of the script's UTF-8 bytes as shipped, with its psql variables
    unexpanded. Every build that ships the same script records the same digest."""
    return hashlib.sha256(REGISTER_MIGRATIONS[version].encode("utf-8")).hexdigest()


def register_migration_plan(current: int | None) -> list[int]:
    """The migrations that take a schema at `current` to
    `REGISTER_SCHEMA_VERSION`, in order. `current` is the `schema_version`
    row's `version`, or None where the schema `lanes_register` does not exist.
    An empty list means `unchanged`. A schema newer than this build is refused
    (operations.md §2.4: 2), and is never migrated down."""
    _register_migrations_consistent()
    if current is None:
        return list(range(1, REGISTER_SCHEMA_VERSION + 1))
    if not isinstance(current, int) or isinstance(current, bool) or current < 1:
        raise ValueError(f"a register schema version is a number of at least 1, not {current!r}")
    if current > REGISTER_SCHEMA_VERSION:
        raise Refusal(f"the register's schema is at version {current}, newer than this "
                      f"{PROG}'s {REGISTER_SCHEMA_VERSION}: upgrade the tools. A schema is "
                      f"migrated forward, never down")
    return list(range(current + 1, REGISTER_SCHEMA_VERSION + 1))


def _register_migration_variables(repository: str, label: str, lane: str,
                                  workstation: str) -> dict[str, str]:
    """The bootstrap's inputs, as the scripts' psql variables. Each is checked
    here against the CHECKs of design.md §1.2 that it meets, so that a bad
    input is refused with 2 before anything is sent, rather than failing as a
    23514 inside the transaction."""
    values = {"repository": ("repo", repository), "label": ("label", label),
              "lane": ("lane", lane), "workstation": ("ws", workstation)}
    for what, (_name, value) in values.items():
        if not isinstance(value, str) or not value.strip():
            raise Refusal(f"bootstrap: the {what} is empty")
        if any(ord(ch) < 0x20 or ord(ch) == 0x7F for ch in value):
            raise Refusal(f"bootstrap: the {what} holds a control character")
    if "@" in label:
        raise Refusal("bootstrap: a database label holds no '@', so it is never a credential "
                      "(design.md §1.2, register_switch.database_label)")
    return {name: value for name, value in values.values()}


def apply_register_migrations(run, current: int | None, *, repository: str, label: str,
                              lane: str, workstation: str) -> list[tuple[int, str]]:
    """MIGRATE THE REGISTER FORWARD TO `REGISTER_SCHEMA_VERSION` (§1.5). This
    is the bootstrap's step and nobody else's: `lanes-index bootstrap` calls
    it, and no subcommand does.

    `current` is as `register_migration_plan` takes it. The other inputs are
    the bootstrap's own (operations.md §2.4): `--repository`, `--label` and
    `--lane`, and the host's workstation name. They fill the switch's `repository`,
    `database_label`, `set_by_lane` and `set_by_ws`, and the `migrations` row's
    `by_lane` and `by_ws`.

    `run(script, variables)` sends one script through Brett's admin
    connection as ONE `psql` call:
      - the script on stdin, with `-X` and `-v ON_ERROR_STOP=1`;
      - one `-v <name>=<value>` per variable;
      - `PGCLIENTENCODING=UTF8`, since `line_scopes`' pattern holds an em dash;
      - no `--single-transaction`, since each script has its own BEGIN and
        COMMIT.
    It raises on any end but 0. The script's transaction has then rolled back,
    so the schema stands at the version before it.

    Returns `(version, script_sha256)` for each migration applied, in order.
    An empty list means `unchanged`. Bad inputs, and a schema newer than this
    build, are refused before anything is sent."""
    plan = register_migration_plan(current)
    variables = _register_migration_variables(repository, label, lane, workstation)
    applied = []
    for version in plan:
        digest = register_migration_sha256(version)
        run(REGISTER_MIGRATIONS[version], dict(variables, script_sha256=digest))
        applied.append((version, digest))
    return applied


def register_version_refusal(version: int, writers_from: int, readers_from: int, *,
                             write: bool) -> str | None:
    """§1.5'S WINDOW, as a client checks it before it reads or writes. A
    writer goes on only where `writers_from` <= `REGISTER_SCHEMA_VERSION` <=
    `version`. A reader goes on only where `readers_from` <=
    `REGISTER_SCHEMA_VERSION` <= `version`.

    Returns None inside the window. Outside it, the returned refusal names
    both numbers and the remedy, in the shape of `commit_write`'s LR003. The
    exit code is the caller's own: 69 for writers, S3's readers and the
    register commands; 2 for the guard; 1 for `managed-projection`."""
    floor, who = (writers_from, "writers") if write else (readers_from, "readers")
    head = f"register schema {version} ({who} from {floor}); this client is {REGISTER_SCHEMA_VERSION}"
    if REGISTER_SCHEMA_VERSION > version:
        return f"{head}: the database is behind: run the bootstrap"
    if REGISTER_SCHEMA_VERSION < floor:
        return f"{head}: upgrade the tools"
    return None


# §1.4'S ROLES AND GRANTS (design.md §1.4). Brett's admin connection sends
# §1.4's block in two parts, with migration 1 between them, as the block's own
# comment line says. `lanes-index bootstrap` calls, in this order:
#   1. `register_roles_query()`, read through that connection, for the names
#      of §1.4's roles that exist already;
#   2. `apply_register_roles(run, found)`: the CREATE ROLE of each role the
#      query did not find, then the admin's GRANT;
#   3. `apply_register_migrations` (above);
#   4. `apply_register_grants(run, database=<name>)`: the rest of the block.
# Every statement goes as the design prints it, comments and all. The GRANT
# and the rest can run again. Nothing here is a subcommand, and nothing here
# sets a floor on a role: each login carries its own (`lanes-index login`).

#: Design.md §1.4's SQL block, verbatim: the register's roles and GRANTs.
#: Above its comment line "-- Migration 1 (...) runs here, and commits. Then:"
#: are the CREATE ROLEs of the owner and the two groups, none of which can log
#: in, and of the indexer's login, then the admin's GRANT of the owner and the
#: indexer to itself, WITH INHERIT TRUE, SET TRUE. Below it are CONNECT and
#: USAGE, SELECT on the tables and, for `pg_dump`, on the sequences, the
#: default privileges, EXECUTE on the five writer functions and on
#: `render_file`, and `lanes_index`'s schema. Its one psql variable is `db`.
_REGISTER_ROLE_BLOCK = r"""CREATE ROLE lanes_register_owner NOLOGIN;      -- owns lanes_register and its functions
CREATE ROLE lanes_register_writer NOLOGIN;     -- REGISTER-WRITER: a group; each engineer's login joins it
CREATE ROLE lanes_register_reader NOLOGIN;     -- READER: a group, as the writer's
CREATE ROLE lanes_indexer LOGIN;               -- Amendment 14's indexer
GRANT lanes_register_owner, lanes_indexer TO CURRENT_USER   -- PG16 gives a CREATEROLE admin
  WITH INHERIT TRUE, SET TRUE;                 -- ADMIN only: SET for 1.2's AUTHORIZATION and
                                               -- SET ROLE, INHERIT for the GRANTs below
-- Migration 1 (§1.2, §1.3.1) runs here, and commits. Then:
REVOKE ALL ON DATABASE :"db" FROM PUBLIC;      -- the database Q22 names (psql -v db=…)
GRANT CONNECT ON DATABASE :"db" TO lanes_register_writer, lanes_register_reader, lanes_indexer;

REVOKE ALL ON SCHEMA lanes_register FROM PUBLIC;
GRANT USAGE ON SCHEMA lanes_register TO lanes_register_writer, lanes_register_reader;
REVOKE ALL ON ALL TABLES IN SCHEMA lanes_register FROM PUBLIC;
GRANT SELECT ON ALL TABLES IN SCHEMA lanes_register TO lanes_register_writer, lanes_register_reader;
ALTER DEFAULT PRIVILEGES FOR ROLE lanes_register_owner IN SCHEMA lanes_register   -- and a later
  GRANT SELECT ON TABLES TO lanes_register_writer, lanes_register_reader;          -- migration's
GRANT SELECT ON ALL SEQUENCES IN SCHEMA lanes_register TO lanes_register_reader;   -- pg_dump reads
ALTER DEFAULT PRIVILEGES FOR ROLE lanes_register_owner IN SCHEMA lanes_register   -- doc_lines'
  GRANT SELECT ON SEQUENCES TO lanes_register_reader;                               -- identity
REVOKE ALL ON ALL FUNCTIONS IN SCHEMA lanes_register FROM PUBLIC;
ALTER DEFAULT PRIVILEGES FOR ROLE lanes_register_owner         -- global form: a per-schema REVOKE
  REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC;                      -- cannot undo PUBLIC's default
GRANT EXECUTE ON FUNCTION lanes_register.commit_write(bigint, uuid, integer, uuid, jsonb),
                          lanes_register.switch_to_files(integer, bigint, text, text),
                          lanes_register.record_marker(integer, bigint, text, text),
                          lanes_register.find_write(uuid, timestamptz, uuid, text, text, text),
                          lanes_register.record_mirror_state(text, text, text)
  TO lanes_register_writer;                    -- no INSERT, UPDATE, DELETE or DDL anywhere
GRANT EXECUTE ON FUNCTION lanes_register.render_file(text)
  TO lanes_register_writer, lanes_register_reader;

-- #160's schema: the indexer owns it and its open_write fills it; the reader reads it.
-- The register writer gets nothing in lanes_index, and the indexer nothing in lanes_register.
CREATE SCHEMA IF NOT EXISTS lanes_index AUTHORIZATION lanes_indexer;
REVOKE ALL ON SCHEMA lanes_index FROM PUBLIC;
GRANT USAGE ON SCHEMA lanes_index TO lanes_register_reader;
GRANT SELECT ON ALL TABLES IN SCHEMA lanes_index TO lanes_register_reader;   -- any already there
ALTER DEFAULT PRIVILEGES FOR ROLE lanes_indexer IN SCHEMA lanes_index
  GRANT SELECT ON TABLES TO lanes_register_reader;
ALTER DEFAULT PRIVILEGES FOR ROLE lanes_indexer IN SCHEMA lanes_index   -- #160 has no sequence;
  GRANT SELECT ON SEQUENCES TO lanes_register_reader;                   -- a later one, for pg_dump

-- The floors are each login's own (the login step): a role's settings reach no member.
"""

#: The block's comment line where migration 1 runs and commits: its split.
_REGISTER_ROLE_BLOCK_SPLIT = "-- Migration 1 (§1.2, §1.3.1) runs here, and commits. Then:\n"

#: One of the block's CREATE ROLE statements: one line, its comment included.
_REGISTER_CREATE_ROLE_RE = re.compile(
    r"CREATE ROLE ([a-z_][a-z0-9_]*) (?:NO)?LOGIN;[ \t]*(?:--[^\n]*)?\n")


def _register_sql_units(text: str) -> list[str]:
    """`text` cut into units, byte for byte, by the layout of the design's SQL
    blocks: a line that starts in column 0 starts a unit, the indented lines
    after it belong to it, and a blank line is a unit of its own. So a
    statement's unit holds its trailing comments, and its units sent
    unchanged send the design's text unchanged. Text that does not cut so is
    a defect of this build."""
    units = re.findall(r"[^ \t\n][^\n]*\n(?:[ \t][^\n]*\n)*|\n", text)
    if "".join(units) != text:
        raise RuntimeError("register SQL text does not cut into units: each unit starts in "
                           "column 0, and every line ends in a newline")
    return units


def _register_role_block_parts() -> tuple[list[tuple[str, str]], str, str]:
    """§1.4'S BLOCK, CUT WHERE MIGRATION 1 RUNS. Returns `(creates, grant,
    rest)`, each the block's own text:
      - `creates`: `(role, statement)` for each CREATE ROLE above the split,
        in the block's order;
      - `grant`: the admin's GRANT, the last statement above the split, with
        its comment lines;
      - `rest`: everything below the split.
    A block that does not cut so is a defect of this build, so the error is
    not a refusal."""
    head, split, rest = _REGISTER_ROLE_BLOCK.partition(_REGISTER_ROLE_BLOCK_SPLIT)
    if (not split or not head.endswith("\n")
            or _REGISTER_ROLE_BLOCK.count(_REGISTER_ROLE_BLOCK_SPLIT) != 1):
        raise RuntimeError("the register's role block has no one line where migration 1 runs")
    *units, grant = _register_sql_units(head)
    creates = []
    for unit in units:
        match = _REGISTER_CREATE_ROLE_RE.fullmatch(unit)
        if not match:
            raise RuntimeError(f"the register's role block holds {unit!r} before its GRANT, "
                               f"not a CREATE ROLE")
        creates.append((match.group(1), unit))
    roles = [role for role, _statement in creates]
    if (not roles or len(set(roles)) != len(roles) or not grant.startswith("GRANT ")
            or " TO CURRENT_USER" not in grant):
        raise RuntimeError(f"the register's role block creates {roles}, then {grant!r}: not "
                           f"distinct roles, then the admin's GRANT")
    return creates, grant, rest


def register_role_names() -> list[str]:
    """The roles §1.4 creates, in its order: the owner, the writer and reader
    groups, and the indexer's login."""
    return [role for role, _statement in _register_role_block_parts()[0]]


def register_roles_query() -> str:
    """THE `pg_roles` CHECK that guards §1.4's CREATE ROLEs: one query, read
    through the admin connection just before `apply_register_roles`. Its rows
    are the names of those of §1.4's roles that exist already, one per row.
    The names are the block's own, plain identifiers by
    `_REGISTER_CREATE_ROLE_RE`, so each is a literal as it stands."""
    names = ", ".join(f"'{role}'" for role in register_role_names())
    return f"SELECT rolname FROM pg_catalog.pg_roles WHERE rolname IN ({names}) ORDER BY rolname;\n"


def _register_role_selection(existing) -> tuple[list[str], list[str]]:
    """The roles to create, and the statements to send, given `existing`."""
    if isinstance(existing, (str, bytes)):
        raise TypeError("the roles found are a collection of names, not one string")
    found = frozenset(existing)
    if not all(isinstance(role, str) for role in found):
        raise TypeError(f"the roles found are names, each a str: {sorted(map(repr, found))}")
    creates, grant, _rest = _register_role_block_parts()
    absent = [(role, statement) for role, statement in creates if role not in found]
    statements = [statement for _role, statement in absent] + [grant]
    return [role for role, _statement in absent], statements


def register_role_statements(existing) -> list[str]:
    """§1.4'S FIRST PART, GUARDED: the statements the bootstrap sends before
    migration 1. `existing` holds the role names `register_roles_query` found.
    Returns the CREATE ROLE of each of §1.4's roles that `existing` lacks, in
    the block's order, then the admin's GRANT, which goes every time since it
    can run again. Each is the block's own text, byte for byte, comments and
    all: none is wrapped, rewritten or put in a DO block. Where no role
    exists, they are the block's first part whole. Nothing is sent here."""
    return _register_role_selection(existing)[1]


def apply_register_roles(run, existing) -> list[str]:
    """SEND §1.4'S FIRST PART: the bootstrap's step before migration 1, which
    `--roles-only` sends too.

    `existing` is as `register_role_statements` takes it, read just before.
    `run(script, variables)` is the runner `apply_register_migrations` takes.
    The statements go as one script, with no psql variable and, as in §1.4,
    no BEGIN. The bootstrap's runner sends it with psql's
    `--single-transaction` (lane 1's ruling for T109), so it commits whole,
    and the owner role and the admin's SET on it then stand before migration
    1's `CREATE SCHEMA ... AUTHORIZATION lanes_register_owner` and its `SET
    LOCAL ROLE` need them; a run that fails leaves nothing.

    Returns the roles it created, in the block's order; the others were
    there already, `unchanged`. The GRANT is sent either way."""
    created, statements = _register_role_selection(existing)
    run("".join(statements), {})
    return created


def apply_register_grants(run, *, database: str) -> None:
    """SEND §1.4'S SECOND PART: the bootstrap's step after migration 1 has
    committed. It is the rest of the block below its split line, whole: the
    database's CONNECT, the schemas' USAGE, SELECT and default privileges,
    EXECUTE on the writer functions and on `render_file`, and `lanes_index`'s
    schema.

    `database` is the register's database, the one the admin connection
    reaches and owns (operations.md §2.4). It goes as the psql variable `db`,
    which the block reads as `:"db"`, an identifier psql quotes. It is
    refused before anything is sent where it is empty or holds a control
    character. Like the first part, the script carries no BEGIN, and the
    bootstrap's runner sends it as one transaction. Each statement can run
    again, so a run that fails is finished by the next."""
    if not isinstance(database, str) or not database.strip():
        raise Refusal("bootstrap: the database name is empty")
    if any(ord(ch) < 0x20 or ord(ch) == 0x7F for ch in database):
        raise Refusal("bootstrap: the database name holds a control character")
    run(_register_role_block_parts()[2], {"db": database})


# `LANES-INDEX BOOTSTRAP` (operations.md §2.4; FR-053, FR-054; T109). Brett's
# command for the register's roles and schema, run from his own shell and never
# from a lane session, through the admin service he names. In this order:
#   1. the refusals that need no connection: usage (64); an argument that
#      carries a connection string or a password, `store=sqlite`, a
#      `register_schema=` that is not a plain identifier or that a script does
#      not render for, a stdout that is not a terminal without
#      `--no-passwords`, and a workstation with no name (2);
#   2. ONE READ through the admin service: who the admin is and what it may
#      do, which of §1.4's roles exist, the schema, the states §1.4's
#      statements leave, and each privilege of §1.4's roles outside its scope.
#      An admin that may not create roles or schemas, or does not own the
#      database, a schema newer than this build, and a privilege outside a
#      role's scope are refused (2) before anything is written;
#   3. §1.4's first part (T108), with the indexer's password where it creates
#      that login, as one transaction; then that login's password-file line,
#      printed once;
#   4. migration 1 (T107), rendered for `register_schema=` (lane 3's ruling
#      (a), #165 6746655077), or `unchanged`;
#   5. §1.4's second part, rendered the same way, as one transaction;
#   6. one read that confirms the result: the indexer cannot write the
#      register's tables, no role holds a privilege outside its scope, and
#      the database-level states stand.
# With the switch at `primary`, as on a restored backup, it verifies, applies a
# pending migration, writes no label and "changes nothing else" (ops:434).
# `--roles-only` sends steps 3 and §1.4's three database-level statements, as
# one transaction (option (a), lane 3's ruling, #165 6727022920).
#
# ONE TRANSACTION A STEP, AND Y'S BYTES UNCHANGED (lane 1's ruling for T109).
# A part whose text carries no transaction control goes through psql's
# `--single-transaction`, with `-v ON_ERROR_STOP=1`, so a failed step leaves
# nothing. A migration carries its own BEGIN and COMMIT, and goes as T107's
# runner sends it. Every statement each step sends can run inside a
# transaction block: CREATE ROLE, GRANT, REVOKE, ALTER ROLE, ALTER DEFAULT
# PRIVILEGES and CREATE SCHEMA.
#
# THE ADMIN CONNECTION (ops:404; lane 3's ruling, #165 6747611042). `psql`
# reaches the database only through `PGSERVICE=<service>` in its environment.
# Every inherited variable whose name begins `PG` is dropped first, and only
# `lanes-index`'s own fixed settings are set beside it. So only Brett's own
# `~/.pg_service.conf` defines the connection, his own `~/.pgpass` holds its
# password, and `lanes-index` never picks a database.

#: The codes this subcommand exits with, by contracts/exit-codes.md §1's names.
#: `bootstrap` is the first new subcommand on this line to exit with them; #160's
#: own exits keep their literals.
EXIT_UNAVAILABLE = 69


class RegisterUnavailable(Exception):
    """The admin connection failed, or the database refused what was sent:
    exit 69 (operations.md §2.4's exits). The step that was running rolled
    back as a whole; a step before it stands, and a rerun goes on from it."""


class _RegisterUsage(Exception):
    """A bootstrap command line that is not its usage: exit 64, before any
    connection is opened."""


#: The schema Y's scripts name. A run on it renders each script to its own
#: bytes, so the rendered digest equals `script_sha256`.
REGISTER_TEMPLATE_SCHEMA = "lanes_register"

#: §1.4's three roles whose names begin with the template's schema name. The
#: rendering never touches them, and they are the only such names a rendered
#: script may hold (lane 3's ruling (a)).
_REGISTER_SCHEMA_NAMED_ROLES = frozenset(
    ("lanes_register_owner", "lanes_register_writer", "lanes_register_reader"))

#: The indexer's login: §1.4's one login, and so the one password the
#: bootstrap ever generates.
_REGISTER_INDEXER = "lanes_indexer"

#: The client timer of each admin `psql` call, as #160's own bound. D9 gives a
#: migration no timer (Y:3530); this one only ends a call that hangs.
_REGISTER_ADMIN_TIMEOUT_S = 300

#: The SCRAM-SHA-256 iteration count psql's `\password` uses by default (the
#: server's `scram_iterations`, 4096 in PostgreSQL 16).
_REGISTER_SCRAM_ITERATIONS = 4096

_REGISTER_TOKEN = r"(?<![A-Za-z0-9_$])lanes_register(?![A-Za-z0-9_$])"

#: The schema's name after `CREATE SCHEMA` (with `IF NOT EXISTS`), and after
#: `ON SCHEMA` and `IN SCHEMA`, where §1.4's second part names it.
_REGISTER_SCHEMA_WORD_RE = re.compile(
    r"((?i:\bcreate\s+schema(?:\s+if\s+not\s+exists)?|\bon\s+schema|\bin\s+schema)\s+)"
    + _REGISTER_TOKEN)

#: A `search_path` setting's list of schemas, `TO` or `=`.
_REGISTER_SEARCH_PATH_RE = re.compile(
    r"((?i:\bsearch_path)\s*(?:(?i:to)\s+|=\s*))"
    r"([A-Za-z_][A-Za-z0-9_$]*(?:\s*,\s*[A-Za-z_][A-Za-z0-9_$]*)*)")

#: The schema's name as a qualifier, before a `.`.
_REGISTER_QUALIFIER_RE = re.compile(r"(?<![A-Za-z0-9_$])lanes_register(?=\.)")

_REGISTER_TOKEN_RE = re.compile(_REGISTER_TOKEN)

#: Any identifier that begins with the template's schema name, in any case.
_REGISTER_NAME_RE = re.compile(r"(?<![A-Za-z0-9_$])(?i:lanes_register)[A-Za-z0-9_$]*")

#: A verifier, wherever psql might echo one in an error.
_REGISTER_VERIFIER_RE = re.compile(r"SCRAM-SHA-256\$[^\s'\"]*")

#: The marker between the answers of one read, as `_query_many`'s.
_REGISTER_NEXT = "\x1eLANES-INDEX-NEXT"

_BOOTSTRAP_USAGE = f"""\
{PROG} bootstrap --admin-service <service> --label <name> --repository <owner/name>
                    --lane <name> [--no-passwords]
{PROG} bootstrap --admin-service <service> --roles-only [--no-passwords]

Makes the SQL register's roles and schema, or migrates the schema forward, through
the libpq service <service> in your own ~/.pg_service.conf, with its password in
your own ~/.pgpass (operations.md §2.4). The service names the register's
database; {PROG} never picks one. Run it from your shell: it prints the
indexer's password-file line once, only to a terminal.

  --label <name>        the database's label, written into the switch it creates
  --repository <o/n>    the workspace repository the register serves
  --lane <name>         the lane or person running it
  --roles-only          only the roles and the three database-level statements a
                        database dump does not carry, before a restore
  --no-passwords        for roles that log in by peer, trust or certificate

Exit: 0 done · 2 refused, nothing written · 64 usage · 69 the admin connection
failed, or the database refused a step."""


def render_register_script(text: str, schema: str, what: str = "the script") -> str:
    """ONE OF Y'S SCRIPTS, RENDERED FOR `register_schema=` (lane 3's ruling
    (a), #165 6746655077). Y's bytes stay the template.

    Whole identifier tokens `lanes_register` are replaced by `schema` where
    they name the schema, and nowhere else:
      - after `CREATE SCHEMA`, and after `ON SCHEMA` and `IN SCHEMA`, which
        §1.4's second part uses;
      - in every `search_path` list;
      - as a qualifier, before a `.`.
    So `lanes_register_owner`, `lanes_register_writer` and
    `lanes_register_reader`, which are other tokens, stay as they are. After
    rendering, a script that still names `lanes_register`, in any case, as
    anything but those three roles is refused (2), and so is a schema that is
    not a plain lower-case identifier. On `lanes_register` the result is the
    template's own bytes."""
    if not isinstance(schema, str) or not SCHEMA_NAME_RE.match(schema):
        raise Refusal("register_schema= is not a plain lower-case SQL identifier "
                      "([a-z_][a-z0-9_]{0,62})")
    out = _REGISTER_SCHEMA_WORD_RE.sub(lambda m: m.group(1) + schema, text)
    out = _REGISTER_SEARCH_PATH_RE.sub(
        lambda m: m.group(1) + _REGISTER_TOKEN_RE.sub(lambda _t: schema, m.group(2)), out)
    out = _REGISTER_QUALIFIER_RE.sub(lambda _m: schema, out)
    left = sorted({m.group(0) for m in _REGISTER_NAME_RE.finditer(out)
                   if m.group(0).lower() != schema
                   and m.group(0).lower() not in _REGISTER_SCHEMA_NAMED_ROLES})
    if left:
        raise Refusal(f"bootstrap: {what}, rendered for the schema {schema}, still names "
                      f"{', '.join(left)}, which is neither that schema nor one of the roles "
                      f"{', '.join(sorted(_REGISTER_SCHEMA_NAMED_ROLES))} (lane 3's ruling (a), "
                      f"#165 6746655077); this build cannot bootstrap that schema")
    return out


def _register_rendered(schema: str) -> tuple[dict[str, str], str]:
    """Every script the bootstrap may send that names the schema, rendered
    before anything is sent: each migration, keyed by its template, and
    §1.4's second part."""
    migrations = {REGISTER_MIGRATIONS[version]: render_register_script(
        REGISTER_MIGRATIONS[version], schema, f"migration {version}")
        for version in sorted(REGISTER_MIGRATIONS)}
    rest = render_register_script(_register_role_block_parts()[2], schema,
                                  "§1.4's second part")
    return migrations, rest


def _register_execute_grants() -> dict[str, list[str]]:
    """§1.4's EXECUTE grants, read from its own text: for each group, the
    signatures it may execute, as `name(types)` without the schema."""
    grants: dict[str, list[str]] = {}
    for unit in _register_sql_units(_register_role_block_parts()[2]):
        if not unit.startswith("GRANT EXECUTE ON FUNCTION "):
            continue
        signatures = re.findall(r"lanes_register\.([a-z_][a-z0-9_]*\([^()]*\))", unit)
        to = re.search(r"\n[ \t]+TO ([a-z_][a-z0-9_]*(?:, [a-z_][a-z0-9_]*)*);", unit)
        if not signatures or not to:
            raise RuntimeError(f"the register's role block's EXECUTE grant {unit!r} does not "
                               f"read as functions, then TO its roles")
        for role in to.group(1).split(", "):
            grants.setdefault(role, []).extend(signatures)
    if set(grants) != {"lanes_register_writer", "lanes_register_reader"}:
        raise RuntimeError(f"the register's role block grants EXECUTE to {sorted(grants)}")
    return grants


def _register_roles_only_parts() -> list[str]:
    """`--roles-only`'S THREE DATABASE-LEVEL STATEMENTS, each §1.4's own unit,
    unchanged and in its order: Y:2243's `REVOKE ALL ON DATABASE ... FROM
    PUBLIC`, Y:2244's `GRANT CONNECT`, and Y:2256-2257's global `ALTER
    DEFAULT PRIVILEGES FOR ROLE lanes_register_owner REVOKE EXECUTE ON
    FUNCTIONS FROM PUBLIC`. No database dump carries them (lane 3's ruling
    (a), #165 6727022920)."""
    units = _register_sql_units(_register_role_block_parts()[2])
    picks = [
        [u for u in units if u.startswith("REVOKE ALL ON DATABASE ")],
        [u for u in units if u.startswith("GRANT CONNECT ON DATABASE ")],
        [u for u in units if u.startswith("ALTER DEFAULT PRIVILEGES FOR ROLE lanes_register_owner ")
         and " IN SCHEMA " not in u and "REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC" in u],
    ]
    if any(len(pick) != 1 for pick in picks):
        raise RuntimeError("the register's role block does not hold exactly one of each of "
                           "the three database-level statements")
    return [pick[0] for pick in picks]


def register_scram_verifier(password: str, salt: bytes | None = None,
                            iterations: int = _REGISTER_SCRAM_ITERATIONS) -> str:
    """A SCRAM-SHA-256 verifier for `password`, computed here, on the client,
    as psql's `\\password` computes it (RFC 5802, RFC 7677; PostgreSQL's
    `scram_build_secret`): a random 16-byte salt, PBKDF2-HMAC-SHA-256, then
    `SCRAM-SHA-256$<iterations>:<salt>$<StoredKey>:<ServerKey>`, each part in
    base64. The server stores it as given, so neither its log nor a failed
    statement ever holds the password itself. The bootstrap's passwords are
    ASCII letters, digits, `-` and `_`, which SASLprep leaves as they are."""
    import base64
    import hmac
    import secrets
    if salt is None:
        salt = secrets.token_bytes(16)
    salted = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt, iterations)
    client_key = hmac.new(salted, b"Client Key", hashlib.sha256).digest()
    stored_key = hashlib.sha256(client_key).digest()
    server_key = hmac.new(salted, b"Server Key", hashlib.sha256).digest()

    def b64(raw: bytes) -> str:
        return base64.b64encode(raw).decode("ascii")

    return f"SCRAM-SHA-256${iterations}:{b64(salt)}${b64(stored_key)}:{b64(server_key)}"


def _register_pgpass_line(database: str, login: str, password: str) -> str:
    """A libpq password-file line for `login` on `database`, at any host and
    port: the file holds this one line, and the URL beside it names the host.
    `:` and `\\` in a field are escaped, as libpq reads them."""
    def field(value: str) -> str:
        return value.replace("\\", "\\\\").replace(":", "\\:")
    return f"*:*:{field(database)}:{field(login)}:{field(password)}"


def _register_admin_env(service: str) -> dict:
    """THE ADMIN `psql`'S ENVIRONMENT (ops:404; lane 3's ruling, #165
    6747611042): every inherited variable whose name begins `PG` dropped, then
    `PGSERVICE=<service>` and `lanes-index`'s own fixed settings, nothing else
    that begins `PG`. A `connect_timeout=` in the service file wins over
    `PGCONNECT_TIMEOUT` (libpq reads the service first), so 2, D9's `c` where
    none is measured, holds only where the service names none."""
    env = {key: value for key, value in os.environ.items() if not key.startswith("PG")}
    env["PGSERVICE"] = service
    env["PGAPPNAME"] = PROG
    env["PGCLIENTENCODING"] = "UTF8"
    env["PGCONNECT_TIMEOUT"] = "2"
    return env


def _register_psql_error(proc: subprocess.CompletedProcess) -> str:
    lines = [_REGISTER_VERIFIER_RE.sub("SCRAM-SHA-256$<verifier>", line.strip())
             for line in (proc.stderr or "").splitlines() if line.strip()]
    for line in lines:
        if re.search(r"\b(ERROR|FATAL|PANIC):|psql: error:", line):
            return line
    return lines[-1] if lines else f"psql exited {proc.returncode}"


def _register_admin_psql(service: str, script: str, variables: dict, *,
                         single_transaction: bool) -> str:
    """ONE `psql` CALL THROUGH THE ADMIN SERVICE: the script on stdin (`-f -`),
    `-X`, `-q`, `-w` (never a password prompt), `-v ON_ERROR_STOP=1`, one
    `-v <name>=<value>` per variable, and, for a script with no transaction
    control of its own, `--single-transaction`, so the call commits whole or
    leaves nothing. No connection string and no service name is in its
    argument list.

    Returns its stdout. Any end but 0, a timer that runs out, or no `psql` is
    `RegisterUnavailable` (69), with psql's error, every verifier in it
    masked. On success, a WARNING psql printed is passed on; a NOTICE is not."""
    psql = shutil.which("psql")
    if not psql:
        raise RegisterUnavailable("there is no psql on PATH")
    argv = [psql, "-X", "-q", "-w", "-v", "ON_ERROR_STOP=1"]
    if single_transaction:
        argv.append("--single-transaction")
    for name, value in variables.items():
        argv += ["-v", f"{name}={value}"]
    argv += ["-f", "-"]
    try:
        proc = subprocess.run(argv, input=script, capture_output=True, encoding="utf-8",
                              errors="replace", check=False, env=_register_admin_env(service),
                              timeout=_REGISTER_ADMIN_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        raise RegisterUnavailable(f"psql did not answer within {_REGISTER_ADMIN_TIMEOUT_S} s")
    except OSError as exc:
        raise RegisterUnavailable(f"psql could not be run: {exc}")
    if proc.returncode != 0:
        raise RegisterUnavailable(_register_psql_error(proc))
    for line in (proc.stderr or "").splitlines():
        if re.search(r"\bWARNING:", line):
            note(_REGISTER_VERIFIER_RE.sub("SCRAM-SHA-256$<verifier>", line.strip()))
    return proc.stdout


def _register_reads(service: str, tag: str, queries: list[str], *,
                    command: str = "bootstrap") -> list[list[list]]:
    """Several SELECTs through the admin service in ONE `psql` call and one
    transaction, each answered as TEXT-format COPY rows, as `_query_many`
    reads them. Nothing is written. `command` names the subcommand reading,
    `bootstrap` or `login`, in the script's first line."""
    lines = [f"-- lanes-index {command}: {tag}"]
    for query in queries:
        lines.append(f"COPY ({query}) TO STDOUT;")
        lines.append("\\echo '\\036LANES-INDEX-NEXT'")
    out = _register_admin_psql(service, "\n".join(lines) + "\n", {}, single_transaction=True)
    results: list[list[list]] = []
    current: list[list] = []
    for line in out.split("\n"):
        if line == _REGISTER_NEXT:
            results.append(current)
            current = []
            continue
        if line:
            current.append([_pg_unescape(field) for field in line.split("\t")])
    if len(results) != len(queries):
        raise RegisterUnavailable(f"psql answered {len(results)} of the {len(queries)} reads "
                                  f"of the {command}'s {tag}")
    return results


def _register_names_sql(names) -> str:
    return ", ".join(_pg_quote(name) for name in names)


def _register_admin_query() -> str:
    """Who the admin is, and what it may do (operations.md §2.4's refusals)."""
    return ("SELECT current_user::text, current_database()::text, "
            "a.rolsuper OR a.rolcreaterole, "
            "pg_catalog.has_database_privilege(current_database(), 'CREATE'), "
            "pg_catalog.pg_has_role(current_user, d.datdba, 'USAGE'), "
            "current_setting('server_version_num') "
            "FROM pg_catalog.pg_roles a, pg_catalog.pg_database d "
            "WHERE a.rolname = current_user AND d.datname = current_database()")


def _register_schema_query(schema: str) -> str:
    """The schema, if it exists, and whether it holds a register's three
    first tables."""
    return (f"SELECT n.nspname::text, "
            f"to_regclass({_pg_quote(schema + '.schema_version')}) IS NOT NULL, "
            f"to_regclass({_pg_quote(schema + '.register_switch')}) IS NOT NULL, "
            f"to_regclass({_pg_quote(schema + '.register_head')}) IS NOT NULL "
            f"FROM pg_catalog.pg_namespace n WHERE n.nspname = {_pg_quote(schema)}")


def _register_states_query() -> str:
    """THE STATES §1.4'S STATEMENTS LEAVE, each true where it already stands:
    PUBLIC holds no privilege on the database; the two groups and the indexer
    each hold CONNECT; the owner's global default privileges give PUBLIC no
    EXECUTE; and the admin holds the owner and the indexer WITH INHERIT TRUE,
    SET TRUE. So each line prints `created` or `unchanged`."""
    roles = register_role_names()
    owner, indexer = roles[0], _REGISTER_INDEXER
    groups = _register_names_sql(roles[1:3] + [indexer])
    database_acl = ("FROM pg_catalog.pg_database d CROSS JOIN LATERAL pg_catalog.aclexplode("
                    "coalesce(d.datacl, pg_catalog.acldefault('d', d.datdba))) AS e "
                    "WHERE d.datname = current_database()")
    return (f"SELECT NOT EXISTS (SELECT 1 {database_acl} AND e.grantee = 0), "
            f"(SELECT count(DISTINCT e.grantee) {database_acl} AND e.privilege_type = 'CONNECT' "
            f"AND e.grantee IN (SELECT a.oid FROM pg_catalog.pg_roles a "
            f"WHERE a.rolname IN ({groups}))) = 3, "
            f"EXISTS (SELECT 1 FROM pg_catalog.pg_default_acl x "
            f"JOIN pg_catalog.pg_roles a ON a.oid = x.defaclrole "
            f"WHERE a.rolname = {_pg_quote(owner)} AND x.defaclnamespace = 0 "
            f"AND x.defaclobjtype = 'f' AND NOT EXISTS (SELECT 1 FROM "
            f"pg_catalog.aclexplode(x.defaclacl) AS e WHERE e.grantee = 0 "
            f"AND e.privilege_type = 'EXECUTE')), "
            f"(SELECT count(DISTINCT b.rolname) FROM pg_catalog.pg_auth_members m "
            f"JOIN pg_catalog.pg_roles b ON b.oid = m.roleid "
            f"JOIN pg_catalog.pg_roles a ON a.oid = m.member "
            f"WHERE a.rolname = current_user "
            f"AND b.rolname IN ({_register_names_sql([owner, indexer])}) "
            f"AND coalesce((to_jsonb(m) ->> 'inherit_option')::boolean, false) "
            f"AND coalesce((to_jsonb(m) ->> 'set_option')::boolean, false)) = 2")


def _register_fingerprint_query(schema: str) -> str:
    """One digest of every privilege in the register's schema and in
    `lanes_index`: the schemas', the relations', the functions' and the
    default privileges. Equal before and after §1.4's second part means it
    changed nothing."""
    names = _register_names_sql([schema, "lanes_index"])
    return ("SELECT md5(coalesce(string_agg(x.line, chr(10) ORDER BY x.line), '')) FROM ("
            f"SELECT 'schema ' || n.nspname || ' ' || coalesce(n.nspacl::text, '-') AS line "
            f"FROM pg_catalog.pg_namespace n WHERE n.nspname IN ({names}) "
            f"UNION ALL SELECT 'relation ' || n.nspname || '.' || c.relname || ' ' "
            f"|| coalesce(c.relacl::text, '-') FROM pg_catalog.pg_class c "
            f"JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace "
            f"WHERE n.nspname IN ({names}) AND c.relkind IN ('r', 'p', 'v', 'm', 'f', 'S') "
            f"UNION ALL SELECT 'function ' || n.nspname || '.' || p.proname || '(' "
            f"|| pg_catalog.oidvectortypes(p.proargtypes) || ') ' || coalesce(p.proacl::text, '-') "
            f"FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace "
            f"WHERE n.nspname IN ({names}) "
            f"UNION ALL SELECT 'default ' || da.defaclrole::regrole::text || ' ' || n.nspname "
            f"|| ' ' || da.defaclobjtype::text || ' ' || da.defaclacl::text "
            f"FROM pg_catalog.pg_default_acl da "
            f"JOIN pg_catalog.pg_namespace n ON n.oid = da.defaclnamespace "
            f"WHERE n.nspname IN ({names})) AS x(line)")


def _register_scope_queries(schema: str) -> list[str]:
    """EACH PRIVILEGE OF §1.4'S ROLES OUTSIDE ITS SCOPE (operations.md §2.4:
    "a role holds a privilege outside its scope ... named and never revoked
    silently"). Four reads, each a row `(role, what it holds, class)`:
      - an attribute: SUPERUSER, CREATEROLE, CREATEDB, REPLICATION or
        BYPASSRLS on any of the four, or LOGIN on the owner or a group;
      - a membership of any of the four in any role;
      - a grant, by the object's ACL with PostgreSQL's defaults filled in, to
        a group, the indexer or PUBLIC, beyond §1.4's matrix:
          - REGISTER-WRITER: USAGE on the schema, SELECT on its tables and
            sequences, EXECUTE on the five writer functions and
            `render_file`, CONNECT; nothing in `lanes_index`;
          - READER: USAGE and SELECT in both schemas, EXECUTE on
            `render_file`, CONNECT;
          - the indexer: anything in `lanes_index`, CONNECT; nothing in the
            register's schema;
          - PUBLIC: nothing;
      - a table of the register's schema that a group or the indexer can
        write by any route, and a table of `lanes_index` the writer can:
        operations.md §2.4's "the indexer cannot write the register's
        tables".
    The class marks PUBLIC's PostgreSQL defaults, CONNECT and TEMPORARY on the
    database and EXECUTE on a function, which §1.4's REVOKEs remove."""
    roles = register_role_names()
    four = _register_names_sql(roles)
    three = _register_names_sql(roles[1:])
    s = _pg_quote(schema)
    fns = []
    for role, signatures in sorted(_register_execute_grants().items()):
        who = "writer" if role == roles[1] else "reader"
        for signature in signatures:
            fns.append(f"(to_regprocedure({_pg_quote(schema + '.' + signature)})::oid, "
                       f"{_pg_quote(who)})")
    attributes = (
        "SELECT a.rolname::text, 'has the attribute ' || x.attr, '' "
        "FROM pg_catalog.pg_roles a CROSS JOIN LATERAL (VALUES "
        "('SUPERUSER', a.rolsuper), ('CREATEROLE', a.rolcreaterole), "
        "('CREATEDB', a.rolcreatedb), ('REPLICATION', a.rolreplication), "
        "('BYPASSRLS', a.rolbypassrls), "
        f"('LOGIN', a.rolcanlogin AND a.rolname <> {_pg_quote(_REGISTER_INDEXER)})) AS x(attr, held) "
        f"WHERE a.rolname IN ({four}) AND x.held")
    memberships = (
        "SELECT a.rolname::text, 'is a member of the role ' || quote_ident(b.rolname), '' "
        "FROM pg_catalog.pg_auth_members m "
        "JOIN pg_catalog.pg_roles a ON a.oid = m.member "
        "JOIN pg_catalog.pg_roles b ON b.oid = m.roleid "
        f"WHERE a.rolname IN ({four})")
    grants = (
        "WITH g(oid, name, who) AS ("
        "SELECT a.oid, a.rolname::text, v.who FROM (VALUES "
        f"({_pg_quote(roles[1])}, 'writer'), ({_pg_quote(roles[2])}, 'reader'), "
        f"({_pg_quote(_REGISTER_INDEXER)}, 'indexer')) AS v(rolname, who) "
        "JOIN pg_catalog.pg_roles a ON a.rolname = v.rolname "
        "UNION ALL SELECT 0::oid, 'PUBLIC', 'public'), "
        "ns(oid, nspname, half, acl) AS ("
        f"SELECT n.oid, n.nspname::text, CASE WHEN n.nspname = {s} THEN 'register' "
        "ELSE 'index' END, coalesce(n.nspacl, pg_catalog.acldefault('n', n.nspowner)) "
        f"FROM pg_catalog.pg_namespace n WHERE n.nspname IN ({s}, 'lanes_index')), "
        "obj(kind, half, oid, label, acl) AS ("
        "SELECT 'schema'::text, ns.half, ns.oid, 'schema ' || quote_ident(ns.nspname), ns.acl "
        "FROM ns "
        "UNION ALL SELECT CASE WHEN c.relkind = 'S' THEN 'sequence' ELSE 'table' END, "
        "ns.half, c.oid, CASE WHEN c.relkind = 'S' THEN 'sequence ' ELSE 'table ' END "
        "|| quote_ident(ns.nspname) || '.' || quote_ident(c.relname), "
        "coalesce(c.relacl, pg_catalog.acldefault("
        "CASE WHEN c.relkind = 'S' THEN 's' ELSE 'r' END::\"char\", c.relowner)) "
        "FROM ns JOIN pg_catalog.pg_class c ON c.relnamespace = ns.oid "
        "WHERE c.relkind IN ('r', 'p', 'v', 'm', 'f', 'S') "
        "UNION ALL SELECT 'function', ns.half, p.oid, 'function ' || quote_ident(ns.nspname) "
        "|| '.' || quote_ident(p.proname) || '(' || pg_catalog.oidvectortypes(p.proargtypes) "
        "|| ')', coalesce(p.proacl, pg_catalog.acldefault('f', p.proowner)) "
        "FROM ns JOIN pg_catalog.pg_proc p ON p.pronamespace = ns.oid "
        "UNION ALL SELECT 'database', 'database', d.oid, 'database ' || quote_ident(d.datname), "
        "coalesce(d.datacl, pg_catalog.acldefault('d', d.datdba)) "
        "FROM pg_catalog.pg_database d WHERE d.datname = current_database()), "
        f"fn(oid, who) AS (VALUES {', '.join(fns)}) "
        "SELECT g.name, 'holds ' || e.privilege_type || ' on ' || o.label, "
        "CASE WHEN g.who = 'public' AND o.kind = 'database' "
        "AND e.privilege_type IN ('CONNECT', 'TEMPORARY') THEN 'public-default-database' "
        "WHEN g.who = 'public' AND o.kind = 'function' AND o.half = 'register' "
        "AND e.privilege_type = 'EXECUTE' THEN 'public-default-function' ELSE '' END "
        "FROM obj o CROSS JOIN LATERAL pg_catalog.aclexplode(o.acl) AS e "
        "JOIN g ON g.oid = e.grantee "
        "WHERE NOT ("
        "(g.who = 'writer' AND ("
        "(o.half = 'register' AND o.kind = 'schema' AND e.privilege_type = 'USAGE') "
        "OR (o.half = 'register' AND o.kind IN ('table', 'sequence') "
        "AND e.privilege_type = 'SELECT') "
        "OR (o.half = 'register' AND o.kind = 'function' AND e.privilege_type = 'EXECUTE' "
        "AND o.oid IN (SELECT fn.oid FROM fn WHERE fn.who = 'writer' AND fn.oid IS NOT NULL)) "
        "OR (o.kind = 'database' AND e.privilege_type = 'CONNECT'))) "
        "OR (g.who = 'reader' AND ("
        "(o.kind = 'schema' AND e.privilege_type = 'USAGE') "
        "OR (o.kind IN ('table', 'sequence') AND e.privilege_type = 'SELECT') "
        "OR (o.half = 'register' AND o.kind = 'function' AND e.privilege_type = 'EXECUTE' "
        "AND o.oid IN (SELECT fn.oid FROM fn WHERE fn.who = 'reader' AND fn.oid IS NOT NULL)) "
        "OR (o.kind = 'database' AND e.privilege_type = 'CONNECT'))) "
        "OR (g.who = 'indexer' AND (o.half = 'index' "
        "OR (o.kind = 'database' AND e.privilege_type = 'CONNECT'))))")
    writes = (
        "SELECT a.rolname::text, 'can write the table ' || quote_ident(n.nspname) || '.' "
        "|| quote_ident(c.relname) || ' (INSERT, UPDATE, DELETE or TRUNCATE)', '' "
        "FROM pg_catalog.pg_roles a CROSS JOIN pg_catalog.pg_class c "
        "JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace "
        f"WHERE a.rolname IN ({three}) AND c.relkind IN ('r', 'p') "
        f"AND (n.nspname = {s} OR (n.nspname = 'lanes_index' "
        f"AND a.rolname = {_pg_quote(roles[1])})) "
        "AND pg_catalog.has_table_privilege(a.oid, c.oid, 'INSERT, UPDATE, DELETE, TRUNCATE')")
    return [attributes, memberships, grants, writes]


def _register_scope_faults(rows: list[list], phase: str) -> list[str]:
    """The faults among the scope reads' rows, for `phase`:
      - `before`, ahead of any statement: PUBLIC's PostgreSQL defaults, which
        §1.4's own REVOKEs remove, are not faults yet;
      - `roles-only`, after `--roles-only`: PUBLIC's default EXECUTE on the
        schema's functions is the full bootstrap's to remove;
      - `all`, after the full bootstrap, and with the switch at `primary`,
        where nothing is sent again: every row is a fault."""
    ignore = {"before": {"public-default-database", "public-default-function"},
              "roles-only": {"public-default-function"},
              "all": set()}[phase]
    return [f"{row[0]} {row[1]}" for row in rows if len(row) >= 3 and row[2] not in ignore]


def _register_refuse_scope(faults: list[str]) -> None:
    if faults:
        raise Refusal("bootstrap: a role holds a privilege outside its scope, which the "
                      "bootstrap names and never revokes (operations.md §2.4); revoke it by "
                      "hand, then run it again:\n  - " + "\n  - ".join(faults))


def _register_flag(value: str) -> bool:
    if value not in ("t", "f"):
        raise RegisterUnavailable(f"psql answered {value!r} where a boolean was asked")
    return value == "t"


def _register_one_row(rows: list[list], width: int, what: str) -> list:
    if len(rows) != 1 or len(rows[0]) != width:
        raise RegisterUnavailable(f"psql answered {len(rows)} rows for {what}, not one row of "
                                  f"{width} fields")
    return rows[0]


def _register_states(rows: list[list]) -> dict:
    row = _register_one_row(rows, 4, "the role block's states")
    return dict(zip(("public", "connect", "defaults", "grant"), map(_register_flag, row)))


def _register_probe(service: str, schema: str) -> dict:
    """THE BOOTSTRAP'S FIRST READ, through the admin service, before anything
    is written."""
    queries = [_register_admin_query(),
               register_roles_query().rstrip().rstrip(";"),
               _register_schema_query(schema),
               _register_states_query(),
               _register_fingerprint_query(schema)] + _register_scope_queries(schema)
    res = _register_reads(service, "probe", queries)
    admin = _register_one_row(res[0], 6, "the admin")
    schema_rows = res[2]
    if len(schema_rows) > 1 or (schema_rows and len(schema_rows[0]) != 4):
        raise RegisterUnavailable("psql answered more than one schema row")
    return {
        "user": admin[0], "database": admin[1],
        "create_roles": _register_flag(admin[2]), "create_schemas": _register_flag(admin[3]),
        "owns": _register_flag(admin[4]), "server": admin[5],
        "roles": {row[0] for row in res[1] if row},
        "schema": None if not schema_rows else [_register_flag(v) for v in schema_rows[0][1:]],
        "states": _register_states(res[3]),
        "fingerprint": _register_one_row(res[4], 1, "the privileges' digest")[0],
        "scope": [row for rows in res[5:] for row in rows],
    }


def _register_state(service: str, schema: str) -> dict:
    """The register's own rows, where its schema exists: its version and
    floors, the switch and the head."""
    res = _register_reads(service, "state", [
        f"SELECT version, writers_from, readers_from FROM {schema}.schema_version",
        f"SELECT mode, marker_state, database_label, set_seq FROM {schema}.register_switch",
        f"SELECT seq FROM {schema}.register_head"])
    for rows, what in zip(res, ("schema_version", "register_switch", "register_head")):
        if len(rows) != 1:
            raise Refusal(f"bootstrap: {schema}.{what} holds {len(rows)} rows, not one: this "
                          f"schema is not a register this tool made")
    version = _register_one_row(res[0], 3, "schema_version")
    switch = _register_one_row(res[1], 4, "register_switch")
    head = _register_one_row(res[2], 1, "register_head")
    try:
        current = int(version[0])
    except (TypeError, ValueError):
        raise RegisterUnavailable(f"psql answered the version {version[0]!r}")
    return {"version": current, "mode": switch[0], "marker": switch[1], "label": switch[2],
            "set_seq": switch[3], "head": head[0]}


def _register_confirm(service: str, schema: str) -> dict:
    """THE BOOTSTRAP'S LAST READ: the states, the privileges' digest and the
    scope reads again, after its statements."""
    res = _register_reads(service, "check", [_register_states_query(),
                                            _register_fingerprint_query(schema)]
                          + _register_scope_queries(schema))
    return {"states": _register_states(res[0]),
            "fingerprint": _register_one_row(res[1], 1, "the privileges' digest")[0],
            "scope": [row for rows in res[2:] for row in rows]}


def _register_store_named_sqlite(cfg: dict) -> bool:
    """Whether the configuration's own `store=` line says `sqlite`. A file
    that names no `store=`, or no file, does not: `load_config` defaults the
    store from `url=`, the index half's, and an engineer's file names no
    `url=` (contracts/config.md §3.2)."""
    if not cfg.get("present"):
        return False
    try:
        with open(cfg["path"], encoding="utf-8") as handle:
            lines = handle.read().splitlines()
    except (OSError, UnicodeDecodeError) as exc:
        raise Refusal(f"the configuration {cfg['path']} cannot be read: {exc}")
    named = ""
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = (part.strip() for part in line.split("=", 1))
        if key == "store":
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            named = value
    return named == "sqlite"


def _register_refuse_argument(flag: str, value: str, *, command: str = "bootstrap") -> None:
    """An argument that carries a connection string or a password, such as a
    `key=value` pair or a URI, is refused (2), and never echoed. `command`
    names the subcommand refusing, `bootstrap` or `login`."""
    if "=" in value or "://" in value or _url_has_password(value):
        raise Refusal(f"{command}: {flag} carries a connection string or a password (a "
                      f"`key=value` pair or a URI). The admin connection is a service name "
                      f"in your own ~/.pg_service.conf, and no argument carries a connection")
    if flag == "--admin-service" and not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]{0,62}", value):
        raise Refusal(f"{command}: --admin-service is not a plain service name: letters, "
                      "digits, '_', '.' and '-', as a section of ~/.pg_service.conf")


def _register_workstation() -> str:
    """This workstation's name, for the switch's `set_by_ws` and the
    `migrations` row's `by_ws`. `$LANES_WORKSTATION`, where it is set, is
    the name: it is the seam `lanes-edit.sh workstation` answers with first,
    as it stands. Otherwise that command is asked, and it needs the
    workspace repository. A container with no name is refused, as every
    writer of the workstation column refuses it (R-A11-14)."""
    seam = os.environ.get("LANES_WORKSTATION", "")
    if seam:
        return seam
    try:
        name, how = this_workstation()
    except StoreUnusable as exc:
        raise Refusal(f"bootstrap: this workstation's name cannot be read ({exc.detail})")
    if how == "container-unset":
        raise Refusal("bootstrap: this is a container and LANES_WORKSTATION is not set, so "
                      "the switch and the migrations row would be stamped with the "
                      "container's own id (Amendment 11, R-A11-14). Run it from the host's "
                      "shell, or export LANES_WORKSTATION")
    return name


def _bootstrap_args(args: list[str]) -> dict | None:
    """The bootstrap's flags; None for `--help`."""
    opts: dict = {"--admin-service": None, "--label": None, "--repository": None,
                  "--lane": None, "--roles-only": False, "--no-passwords": False}
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-h", "--help"):
            return None
        name, eq, value = arg.partition("=")
        if name in ("--admin-service", "--label", "--repository", "--lane"):
            if not eq:
                value = args[i + 1] if i + 1 < len(args) else ""
                i += 1
            if not value:
                raise _RegisterUsage(f"bootstrap: {name} needs a value")
            if opts[name] is not None:
                raise _RegisterUsage(f"bootstrap: {name} is given twice")
            opts[name] = value
        elif arg in ("--roles-only", "--no-passwords"):
            opts[arg] = True
        else:
            raise _RegisterUsage(f"bootstrap: unknown argument '{arg}'")
        i += 1
    if opts["--admin-service"] is None:
        raise _RegisterUsage("bootstrap needs --admin-service <service>")
    if not opts["--roles-only"]:
        missing = [flag for flag in ("--label", "--repository", "--lane") if opts[flag] is None]
        if missing:
            raise _RegisterUsage(f"bootstrap needs {', '.join(missing)} (or --roles-only)")
    return opts


def _bootstrap_say(what: str, created: bool, detail: str = "") -> None:
    say(f"{what}: {'created' if created else 'unchanged'}" + (f" ({detail})" if detail else ""))


def cmd_bootstrap(args: list[str]) -> int:
    """`lanes-index bootstrap` (operations.md §2.4): its exits, by the
    contract's constants."""
    try:
        opts = _bootstrap_args(args)
    except _RegisterUsage as exc:
        note(f"{exc} - see {PROG} bootstrap --help")
        return EXIT_USAGE
    if opts is None:
        say(_BOOTSTRAP_USAGE)
        return EXIT_OK
    try:
        return _bootstrap(opts)
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return EXIT_REFUSED
    except RegisterUnavailable as exc:
        note(f"bootstrap: the admin connection failed, or the database refused a step: {exc}")
        return EXIT_UNAVAILABLE


def _bootstrap(opts: dict) -> int:
    service = opts["--admin-service"]
    roles_only = opts["--roles-only"]
    for flag in ("--admin-service", "--label", "--repository", "--lane"):
        if opts[flag] is not None:
            _register_refuse_argument(flag, opts[flag])
    if not opts["--no-passwords"] and not sys.stdout.isatty():
        raise Refusal("bootstrap: stdout is not a terminal. It prints a password only to a "
                      "terminal, so that no transcript, log or pipe holds one: run it from your "
                      "shell, or pass --no-passwords for roles that need none")
    cfg = load_config()
    if _register_store_named_sqlite(cfg):
        raise Refusal(f"bootstrap: {cfg['path']} names store=sqlite: the register is shared "
                      f"by workstations, and SQLite is one disk")
    schema = cfg.get("register_schema") or REGISTER_TEMPLATE_SCHEMA
    if not SCHEMA_NAME_RE.match(schema):
        raise Refusal("register_schema= is not a plain lower-case SQL identifier "
                      "([a-z_][a-z0-9_]{0,62})")
    if schema.startswith("pg_") or schema in ("lanes_index", cfg.get("schema") or "lanes_index"):
        raise Refusal(f"bootstrap: register_schema={schema} is the index half's schema or a "
                      f"name PostgreSQL reserves; the register takes a schema of its own")
    migrations, rest = _register_rendered(schema)
    workstation = ""
    if not roles_only:
        workstation = _register_workstation()
        _register_migration_variables(opts["--repository"], opts["--label"], opts["--lane"],
                                      workstation)

    probe = _register_probe(service, schema)
    who, database = probe["user"], probe["database"]
    if not probe["create_roles"]:
        raise Refusal(f"bootstrap: the admin {who} may not create roles: it has neither "
                      f"CREATEROLE nor SUPERUSER")
    if not probe["create_schemas"]:
        raise Refusal(f"bootstrap: the admin {who} may not create schemas in the database "
                      f"{database}")
    if not probe["owns"]:
        raise Refusal(f"bootstrap: the admin {who} does not own the database {database} "
                      f"(pg_has_role(current_user, datdba, 'USAGE') is false), where the "
                      f"database-level REVOKE and GRANT would only warn (design.md §1.4). Run "
                      f"it through a service that names a database its admin owns")
    _register_refuse_scope(_register_scope_faults(probe["scope"], "before"))
    if not isinstance(database, str) or not database.strip() or any(
            ord(ch) < 0x20 or ord(ch) == 0x7F for ch in database):
        raise Refusal("bootstrap: the database's name is empty or holds a control character")

    state = None
    if probe["schema"] is not None and not roles_only:
        if not all(probe["schema"]):
            raise Refusal(f"bootstrap: the schema {schema} exists and is not a register this "
                          f"tool made: it lacks schema_version, register_switch or "
                          f"register_head. Name another register_schema=, or drop it")
        state = _register_state(service, schema)
    plan = [] if roles_only else register_migration_plan(
        None if state is None else state["version"])
    primary = state is not None and state["mode"] == "primary"

    names = register_role_names()
    grant = _register_role_block_parts()[1]
    granted = re.match(r"GRANT ([a-z_][a-z0-9_]*(?:, [a-z_][a-z0-9_]*)*) TO CURRENT_USER", grant)
    if not granted or _REGISTER_INDEXER not in names:
        raise RuntimeError("the register's role block's GRANT, or its indexer, is not as built")
    grant_line = (f"the admin {who}'s membership of {granted.group(1).replace(', ', ' and ')}, "
                  f"WITH INHERIT TRUE, SET TRUE")
    db_lines = [f"database {database}, REVOKE ALL FROM PUBLIC",
                f"database {database}, GRANT CONNECT to {names[1]}, {names[2]} and "
                f"{_REGISTER_INDEXER}",
                f"default privileges of {names[0]}, REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC"]
    db_states = [probe["states"][key] for key in ("public", "connect", "defaults")]

    if primary:
        missing = [f"role {role}" for role in names if role not in probe["roles"]]
        if not probe["states"]["grant"]:
            missing.append(grant_line)
        missing += [line for line, done in zip(db_lines, db_states) if not done]
        if missing:
            raise Refusal("bootstrap: the switch is at primary, so it changes nothing but a "
                          "pending migration (operations.md:434), and these are not in place: "
                          + "; ".join(missing) + ". Run bootstrap --roles-only first")
        _register_refuse_scope(_register_scope_faults(probe["scope"], "all"))
        for role in names:
            _bootstrap_say(f"role {role}", False)
        _bootstrap_say(grant_line, False)
    else:
        creating = [role for role in names if role not in probe["roles"]]
        password = ""
        extra = ""
        if _REGISTER_INDEXER in creating and not opts["--no-passwords"]:
            import secrets
            password = secrets.token_urlsafe(32)
            extra = (f"ALTER ROLE {_REGISTER_INDEXER} PASSWORD "
                     f"{_pg_quote(register_scram_verifier(password))};\n")

        def run_roles(script: str, variables: dict) -> None:
            _register_admin_psql(service, script + extra, variables, single_transaction=True)

        created = apply_register_roles(run_roles, probe["roles"])
        for role in names:
            _bootstrap_say(f"role {role}", role in created)
        _bootstrap_say(grant_line, not probe["states"]["grant"])
        if password:
            say(f"# {_REGISTER_INDEXER}'s password-file line, printed once: put it alone in a "
                f"0600 file, and name that file in passfile=")
            say(_register_pgpass_line(database, _REGISTER_INDEXER, password))
            sys.stdout.flush()

    if roles_only:
        _register_admin_psql(service, "".join(_register_roles_only_parts()), {"db": database},
                             single_transaction=True)
        after = _register_confirm(service, schema)
        unmet = [line for line, done in zip(db_lines, (after["states"][key] for key in
                                                        ("public", "connect", "defaults")))
                 if not done]
        if unmet or not after["states"]["grant"]:
            raise Refusal("bootstrap --roles-only: after its statements these are still not in "
                          "place: " + "; ".join(unmet + ([] if after["states"]["grant"]
                                                         else [grant_line])))
        _register_refuse_scope(_register_scope_faults(after["scope"], "roles-only"))
        for line, done in zip(db_lines, db_states):
            _bootstrap_say(line, not done)
        return EXIT_OK

    rendered_digests: dict[int, str] = {}

    def run_migration(script: str, variables: dict) -> None:
        text = migrations.get(script)
        if text is None:
            raise RuntimeError("a migration this build does not ship was to be sent")
        version = next(v for v, t in REGISTER_MIGRATIONS.items() if t == script)
        rendered_digests[version] = hashlib.sha256(text.encode("utf-8")).hexdigest()
        _register_admin_psql(service, text, variables, single_transaction=False)

    applied = apply_register_migrations(
        run_migration, None if state is None else state["version"],
        repository=opts["--repository"], label=opts["--label"], lane=opts["--lane"],
        workstation=workstation) if plan else []
    if applied and applied[0][0] == 1:
        _bootstrap_say(f"schema {schema}", True, f"version {REGISTER_SCHEMA_VERSION}")
    elif applied:
        say(f"schema {schema}: migrated (version {state['version']} to "
            f"{REGISTER_SCHEMA_VERSION})")
    else:
        _bootstrap_say(f"schema {schema}", False, f"version {state['version']}")
    for version, digest in applied:
        _bootstrap_say(f"migration {version}", True,
                       f"script_sha256 {digest}, rendered sha256 {rendered_digests[version]}")
    if state is None:
        _bootstrap_say("switch", True, f"mode files, marker absent, label {opts['--label']}, "
                                       f"set_seq -1, a new generation")
        _bootstrap_say("head", True, "seq -1")
    else:
        _bootstrap_say("switch", False, f"mode {state['mode']}, marker {state['marker']}, "
                                        f"label {state['label']}, set_seq {state['set_seq']}")
        _bootstrap_say("head", False, f"seq {state['head']}")

    if not primary:
        def run_grants(script: str, variables: dict) -> None:
            if script != _register_role_block_parts()[2]:
                raise RuntimeError("the role block's second part was not the one rendered")
            _register_admin_psql(service, rest, variables, single_transaction=True)

        apply_register_grants(run_grants, database=database)
    after = _register_confirm(service, schema)
    unmet = [line for line, done in zip(db_lines, (after["states"][key] for key in
                                                    ("public", "connect", "defaults")))
             if not done]
    if unmet or not after["states"]["grant"]:
        raise Refusal("bootstrap: after its statements these are still not in place: "
                      + "; ".join(unmet + ([] if after["states"]["grant"] else [grant_line])))
    _register_refuse_scope(_register_scope_faults(after["scope"], "all"))
    for line, done in zip(db_lines, db_states):
        _bootstrap_say(line, not done)
    _bootstrap_say(f"privileges in the schemas {schema} and lanes_index",
                   after["fingerprint"] != probe["fingerprint"])

    say("# lanes-index.conf lines for this database, with no secret:")
    if primary:
        label = opts["--label"]
        if label != state["label"]:
            note(f"the switch is at primary and names {state['label']}; bootstrap writes no "
                 f"label. register_label={label} is for a restored backup's replacement, whose "
                 f"cutover --after-loss sets it; for the live database, keep {state['label']}")
        else:
            note(f"the switch is at primary and names {label}: if this is a restored backup, "
                 f"its replacement needs a label of its own (N4)")
    else:
        say("mode=index")
        label = state["label"] if state is not None else opts["--label"]
        if state is not None and opts["--label"] != state["label"]:
            note(f"the switch already names {state['label']}, so --label {opts['--label']} is "
                 f"not written; register_label= is the switch's label")
    say(f"register_label={label}")
    if schema != REGISTER_TEMPLATE_SCHEMA:
        say(f"register_schema={schema}")
    return EXIT_OK


# `LANES-INDEX READY` (operations.md §2.4, "lanes-index ready", ops:437-461;
# FR-054, FR-055; T119, L1-A17). The operator lane's readiness check, run in
# every environment on P19's list before act 4 (act 3's step 6), and with
# `--expect primary` after the flip and on the disaster path (step 7). Thirteen
# checks, each a read that writes nothing, in Y ops' order. Each prints ONE
# line, `check <n>: ok` or `check <n>: FAIL: <reason>`, in order (lane 1's line
# form, block v4.11's :384, which lane 3 accepted, #165 6754522885); then one
# last line names the environment, the host, the workstation and the tools'
# version, and prints no secret (ops:457). Exit 0 when every check passed, 2
# when any failed, 64 for usage (ops:458). A database it cannot reach fails
# check 4, so `ready` exits 2 there, never 69 (contracts/exit-codes.md §3.3).
#
# EACH ROLE is one of the register's two logins this configuration names:
# `register_url=`'s REGISTER-WRITER login and `reader_url=`'s READER login,
# each with its own password file (design.md §1.4, "One engineer's file").
# `url=`'s indexer is #160's, and no check reads it. Each connects as every
# register path does (`PostgresStore`): its URL is the whole connection, its
# `connect_timeout=` is `c`, and the bounds are D9's reader row, since `ready`
# is a reader (ops:405; design.md:3526): `lock_timeout=1000`,
# `statement_timeout=3000` and a client timer of `N_a`·`c` + 4 s, never below
# 6 s. Per role it makes ONE read (check 4's scope, check 11's `pg_stat_ssl`
# row and `pg_is_in_recovery()`, check 12's own `pg_roles` row) and, once that
# connected, ONE write tried under `BEGIN READ WRITE` and never committed
# (check 4). Once, as the READER, or as the writer where the READER could not
# connect, it reads the version window and the switch (checks 8 to 10).
#
# [X: hosting] Checks 11 and 13 need facts only the hosted install gives: the
# cert-manager issuer's root, and the LoadBalancer's one address (`N_a` 1).
# Each is built to its text, and FAILS, never passes, where its fact cannot be
# read: a connection that does not verify, a `pg_stat_ssl` row it cannot read,
# a host that does not resolve.
#
# ITS ONE WRITE is check 5's scratch configuration, `mode=primary` alone, 0600
# in a private temporary directory, removed before `ready` prints. Nothing is
# fetched: check 8 reads `origin/<branch>` as the last fetch left it.

_READY_USAGE = f"""\
{PROG} ready --expect index|primary --release <version> --env <name>

The readiness check (operations.md §2.4): thirteen checks, each a read that
writes nothing, printed in order as `check <n>: ok` or `check <n>: FAIL:
<reason>`, then one line naming the environment, the host, the workstation and
the tools' version. It prints no secret and changes nothing.

  --expect index|primary  the mode this environment must be in: index until
                          the flip
  --release <version>     the release whose digests the installed tools must
                          match: openRepoTools-<version>.sha256 beside the
                          lanes-index that PATH names
  --env <name>            this environment's label in the last line

Exit: 0 every check passed · 2 a check failed, each failure named on its own
line (a database it cannot reach is check 4's failure, never 69) · 64 usage."""

#: The number of checks, ops:444-456.
_READY_CHECKS = 13

#: CHECK 1'S DIGEST LIST. Y names "the release's" digests (ops:441, ops:444) and
#: the test plan an installed-tools directory holding "the release's digest
#: list" (AT-P8), but neither fixes its form, so lane 1 chose this one, which
#: stands (lane 3's ruling, #165 6770600106): in the directory of the
#: `lanes-index` that PATH names, the installed-tools directory, the file
#: `openRepoTools-<release>.sha256`, in `sha256sum`'s own form, one
#: `<sha256>  <name>` line for each installed tool, each name one file of that
#: directory. A `#` line is a comment.
_READY_DIGEST_LIST = "openRepoTools-{release}.sha256"
_READY_DIGEST_LINE_RE = re.compile(r"([0-9a-f]{64}) [ *]([A-Za-z0-9_+-][A-Za-z0-9._+-]*)")

#: The tools every release's digest list names (lane 3's ruling, #165
#: 6770600106): "A list that does not name `lanes-index` and `lanes-edit.sh`
#: fails." Check 1 names each one a list leaves out.
_READY_DIGEST_NAMES = ("lanes-index", "lanes-edit.sh")

#: `--release` and `--env`: a version and a label, which become a file name and
#: part of the last line, so neither can carry a path, a space or a control
#: character.
_READY_RELEASE_RE = re.compile(r"[0-9A-Za-z][0-9A-Za-z.+_-]{0,39}")
_READY_ENV_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:/+-]{0,63}")

#: CHECK 2: the `psql` act 3 installs, 1A's `postgresql-16` (ops:445). A later
#: one is not older than any register path needs, so it passes too.
_READY_PSQL_MAJOR = 16

#: D9'S READER ROW (design.md:3526; ops:405): `lock_timeout` and
#: `statement_timeout` in ms, and the least client timer in s. The timer is
#: `N_a`·`c` + the statement bound + 1 s, never below that figure.
_READY_BOUNDS = (1000, 3000, 6)

#: Each role `ready` connects as, in order: `PostgresStore`'s role, the key of
#: its URL, its name in a line, and its half of §1.4's login block, whose floors
#: (check 12) and group (check 4's functions) it takes.
_READY_ROLES = (("register_writer", "register_url", "the REGISTER-WRITER login", "w"),
                ("register_reader", "reader_url", "the READER login", "r"))

#: The checks' bounded waits, in s, for what is not a database call: `psql
#: --version`, the installed `lanes-index mode`, and one name lookup.
_READY_LOCAL_TIMEOUT_S = 10


def _ready_args(args: list[str]) -> dict | None:
    """`ready`'s command line; None for `--help`. Each of `--expect
    index|primary`, `--release <version>` and `--env <name>` once, with a
    value, as `--flag value` or `--flag=value`. Anything else is usage (64),
    before anything is read, and no value is echoed."""
    opts: dict = {"--expect": None, "--release": None, "--env": None}
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-h", "--help"):
            return None
        name, eq, value = arg.partition("=")
        if name not in opts:
            shown = (f"'{arg}'" if re.fullmatch(r"--?[A-Za-z][A-Za-z-]{0,30}", arg)
                     else "that is not one of its flags")
            raise _RegisterUsage(f"ready: unknown argument {shown}")
        if not eq:
            if i + 1 >= len(args):
                raise _RegisterUsage(f"ready: {name} needs a value")
            value = args[i + 1]
            i += 1
        if not value:
            raise _RegisterUsage(f"ready: {name} needs a value")
        if opts[name] is not None:
            raise _RegisterUsage(f"ready: {name} is given twice")
        opts[name] = value
        i += 1
    missing = [flag for flag, value in opts.items() if value is None]
    if missing:
        raise _RegisterUsage(f"ready needs {', '.join(missing)}")
    if opts["--expect"] not in ("index", "primary"):
        raise _RegisterUsage("ready: --expect is index or primary")
    if not _READY_RELEASE_RE.fullmatch(opts["--release"]):
        raise _RegisterUsage("ready: --release is a version: a letter or digit, then letters, "
                             "digits, '.', '+', '_' or '-', at most 40 in all")
    if not _READY_ENV_RE.fullmatch(opts["--env"]):
        raise _RegisterUsage("ready: --env is a label: a letter or digit, then letters, digits, "
                             "'.', '_', ':', '/', '+' or '-', at most 64 in all")
    return opts


def _ready_line(text: str) -> str:
    """One printed line: every control character, a line break among them,
    becomes one space, so a reason never runs onto a second line."""
    return re.sub(r"[\x00-\x1f\x7f]+", " ", text).strip()


def _ready_psql_why(exc: StoreUnusable) -> str:
    """What a register call's failure says, for a check's line: libpq's or
    the server's own error line where `psql` printed one, else the call's
    detail (`PsqlFailed`, `PsqlTooOld`)."""
    stderr = getattr(exc, "stderr", "") or ""
    for line in stderr.splitlines():
        if re.search(r"(?:\berror|\bERROR|\bFATAL):", line):
            return line.strip()[:400]
    return exc.detail[:400]


def _ready_sqlstate(stderr: str) -> tuple[str, str]:
    """The SQLSTATE and message of the first `ERROR:` line, under the
    register's `VERBOSITY=verbose` (`ERROR:  <SQLSTATE>: <message>`), or
    two empty strings."""
    match = re.search(r"\bERROR:\s+([0-9A-Z]{5}):\s*([^\n]*)", stderr or "")
    return (match.group(1), match.group(2).strip()[:300]) if match else ("", "")


def _ready_request(store: PostgresStore, statements: list[str]) -> str:
    """ONE register request as `store`'s login, with D9's reader row, whichever
    role the login is (`_READY_BOUNDS`): `statements` joined by `\\;` into one
    Query, as `PostgresStore.request` joins them. A failure is `PsqlFailed`."""
    lock_ms, statement_ms, least_s = _READY_BOUNDS
    timer = max(least_s, store.addresses * store.connect_timeout + statement_ms / 1000 + 1)
    script = " \\; ".join(statement.strip().rstrip(";").rstrip() for statement in statements)
    return store._run(script + ";\n", timer=timer, register=True,
                      options=f"-c lock_timeout={lock_ms} -c statement_timeout={statement_ms}")


def _ready_reads(store: PostgresStore, queries: list[str]) -> list[list[list]]:
    """Several SELECTs as ONE request, each answered as TEXT-format COPY rows
    with `REGISTER_MARKER_COPY` after it, parsed as `_query_many` parses
    them. A reply that does not hold one answer per query is `PsqlFailed`."""
    statements: list[str] = []
    for query in queries:
        statements += [f"COPY ({query}) TO STDOUT", REGISTER_MARKER_COPY]
    out = _ready_request(store, statements)
    results: list[list[list]] = []
    current: list[list] = []
    for line in out.split("\n"):
        if line == _REGISTER_NEXT:
            results.append(current)
            current = []
        elif line:
            current.append([_pg_unescape(field) for field in line.split("\t")])
    if len(results) != len(queries):
        raise PsqlFailed("unreachable", f"psql answered {len(results)} of the {len(queries)} "
                         f"reads of one request", psql_exit=0)
    return results


def _ready_scope_query(schema: str, group: str) -> str:
    """CHECK 4'S SCOPE, READ: every privilege the connected login holds,
    directly or through a role, that §1.4 gives neither of its groups, one
    row of text each. Each group may SELECT and USAGE; neither may write a
    table or a view, use or set a sequence, create in a schema, create in the
    database or make a temporary table, or execute a function of the
    register's schema outside its group's EXECUTE grants (§1.4's block: "no
    INSERT, UPDATE, DELETE or DDL anywhere"); and no login holds SUPERUSER,
    CREATEROLE, CREATEDB, REPLICATION or BYPASSRLS. The catalogs are readable
    by any role, and every `has_*_privilege` asks of `current_user`."""
    signatures = _register_execute_grants().get(group, [])
    allowed = (", ".join(f"({_pg_quote(schema + '.' + signature)})" for signature in signatures)
               or "(NULL::text)")
    outside = "n.nspname !~ '^pg_' AND n.nspname <> 'information_schema'"
    return (
        "SELECT 'has the attribute ' || x.attr FROM pg_catalog.pg_roles a CROSS JOIN LATERAL "
        "(VALUES ('SUPERUSER', a.rolsuper), ('CREATEROLE', a.rolcreaterole), "
        "('CREATEDB', a.rolcreatedb), ('REPLICATION', a.rolreplication), "
        "('BYPASSRLS', a.rolbypassrls)) AS x(attr, held) "
        "WHERE a.rolname = current_user AND x.held "
        "UNION ALL SELECT 'holds ' || x.priv || ' on the database ' || "
        "quote_ident(current_database()) FROM (VALUES ('CREATE'), ('TEMPORARY')) AS x(priv) "
        "WHERE pg_catalog.has_database_privilege(current_database(), x.priv) "
        "UNION ALL SELECT 'holds CREATE on the schema ' || quote_ident(n.nspname) "
        f"FROM pg_catalog.pg_namespace n WHERE {outside} "
        "AND pg_catalog.has_schema_privilege(n.oid, 'CREATE') "
        "UNION ALL SELECT 'can write the table ' || quote_ident(n.nspname) || '.' "
        "|| quote_ident(c.relname) || ' (INSERT, UPDATE, DELETE, TRUNCATE, REFERENCES or "
        "TRIGGER)' FROM pg_catalog.pg_class c "
        "JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace "
        f"WHERE c.relkind IN ('r', 'p', 'v', 'f') AND {outside} "
        "AND pg_catalog.has_table_privilege(c.oid, "
        "'INSERT, UPDATE, DELETE, TRUNCATE, REFERENCES, TRIGGER') "
        "UNION ALL SELECT 'can use or set the sequence ' || quote_ident(n.nspname) || '.' "
        "|| quote_ident(c.relname) FROM pg_catalog.pg_class c "
        "JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace "
        f"WHERE c.relkind = 'S' AND {outside} "
        # A CASE, since a WHERE's order is the planner's, and
        # `has_sequence_privilege` raises 42809 on a relation that is not a
        # sequence (lane 1's engine run of T119).
        "AND CASE WHEN c.relkind = 'S' "
        "THEN pg_catalog.has_sequence_privilege(c.oid, 'USAGE, UPDATE') ELSE false END "
        "UNION ALL SELECT 'can execute the function ' || quote_ident(n.nspname) || '.' "
        "|| quote_ident(p.proname) || '(' || pg_catalog.oidvectortypes(p.proargtypes) || ')' "
        "FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace "
        f"WHERE n.nspname = {_pg_quote(schema)} "
        "AND pg_catalog.has_function_privilege(p.oid, 'EXECUTE') "
        "AND p.oid NOT IN (SELECT pg_catalog.to_regprocedure(v.sig)::oid "
        f"FROM (VALUES {allowed}) AS v(sig) "
        "WHERE pg_catalog.to_regprocedure(v.sig) IS NOT NULL)")


#: CHECK 11'S FACTS: the connection's own `pg_stat_ssl` row (ops:454: "WHERE
#: pid = pg_backend_pid()") and whether the server is in recovery.
_READY_SSL_QUERY = ("SELECT s.ssl, coalesce(s.version, ''), pg_catalog.pg_is_in_recovery() "
                    "FROM pg_catalog.pg_stat_ssl s WHERE s.pid = pg_catalog.pg_backend_pid()")

#: CHECK 12'S FACTS: the login's own `pg_roles` row (ops:455: "WHERE rolname =
#: current_user"), its settings one per line, in `rolconfig`'s `name=value`.
_READY_ROLE_QUERY = ("SELECT a.rolname::text, coalesce(pg_catalog.array_to_string(a.rolconfig, "
                     "chr(10)), '') FROM pg_catalog.pg_roles a WHERE a.rolname = current_user")


def _ready_write_probe(store: PostgresStore) -> str:
    """CHECK 4'S WRITE (ops:447): one write, tried in a transaction opened
    with `BEGIN READ WRITE`, which no statement commits and which rolls back
    when the request ends. The `READ WRITE` matters for the READER, whose
    role default is read-only: a plain write there fails with 25006 before
    any privilege is checked. The write is an INSERT into the head's table
    that selects no row, so a login that may write changes nothing either.
    Returns "" where it failed with 42501, else what happened."""
    head = f'"{store.schema}".register_head'
    try:
        _ready_request(store, ["BEGIN READ WRITE",
                               f"INSERT INTO {head} (id, seq) SELECT id, seq FROM {head} WHERE false",
                               "ROLLBACK"])
    except StoreUnusable as exc:
        code, message = _ready_sqlstate(getattr(exc, "stderr", ""))
        if code == "42501" and getattr(exc, "psql_exit", None) == 3:
            return ""
        if code:
            return (f"a write tried under BEGIN READ WRITE ended with {code} ({message}), "
                    f"not 42501")
        return f"a write could not be tried under BEGIN READ WRITE: {_ready_psql_why(exc)}"
    return (f"a write to {store.schema}.register_head, tried under BEGIN READ WRITE and never "
            f"committed, was not refused: 42501 was expected")


def _ready_roles(cfg: dict) -> list[dict]:
    """Each role's facts, in `_READY_ROLES`' order: `who` names it in a line;
    `store` is its `PostgresStore`, or None; `error` says why it could not be
    read, or is ""; `ssl`, `role_row` and `scope` are its one read's three
    answers; `probe` is `_ready_write_probe`'s answer."""
    groups = _register_login_parts()["groups"]
    entries = []
    for role, key, label, half in _READY_ROLES:
        entry = {"role": role, "key": key, "half": half, "who": f"{label} (`{key}=`)",
                 "store": None, "error": "", "ssl": None, "role_row": None, "scope": [],
                 "probe": ""}
        entries.append(entry)
        try:
            store = PostgresStore(cfg, role)
        except Refusal as exc:
            entry["error"] = str(exc)
            continue
        entry["store"] = store
        entry["who"] = (f"{label} {store.pg_env.get('PGUSER') or '(its URL names no user)'} "
                        f"(`{key}=`)")
        try:
            ssl, role_row, scope = _ready_reads(store, [
                _READY_SSL_QUERY, _READY_ROLE_QUERY, _ready_scope_query(store.schema,
                                                                        groups[half])])
        except StoreUnusable as exc:
            entry["error"] = (f"its connection and read failed (c {store.connect_timeout} s, "
                              f"N_a {store.addresses}): {_ready_psql_why(exc)}")
            continue
        entry["ssl"], entry["role_row"] = ssl, role_row
        entry["scope"] = [row[0] for row in scope if row and row[0]]
        entry["probe"] = _ready_write_probe(store)
    return entries


def _ready_state(entries: list[dict]) -> dict:
    """The version window and the switch, read once, as the READER where it
    connected, else as the writer: `error` is "" or why they could not be
    read; `schema`, `version` and `switch` are the schema's name and the
    rows."""
    readable = [entry for entry in reversed(entries) if entry["store"] and not entry["error"]]
    if not readable:
        return {"error": "neither login could connect (check 4)", "schema": "", "version": [],
                "switch": []}
    store = readable[0]["store"]
    schema = store.schema
    try:
        version, switch = _ready_reads(store, [
            f'SELECT version, writers_from, readers_from FROM "{schema}".schema_version',
            f'SELECT mode, marker_state, database_label FROM "{schema}".register_switch'])
    except StoreUnusable as exc:
        return {"error": f"{readable[0]['who']} could not read {schema}.schema_version and "
                         f"{schema}.register_switch: {_ready_psql_why(exc)}",
                "schema": schema, "version": [], "switch": []}
    return {"error": "", "schema": schema, "version": version, "switch": switch}


def _ready_switch(state: dict) -> tuple[list, str]:
    """The switch's one row as (mode, marker_state, database_label), or why
    it cannot be read."""
    if state["error"]:
        return [], f"the switch cannot be read: {state['error']}"
    rows = state["switch"]
    if len(rows) != 1 or len(rows[0]) != 3 or None in rows[0]:
        return [], f"{state['schema']}.register_switch holds {len(rows)} rows, not one switch"
    return rows[0], ""


def _ready_installed() -> str:
    """The `lanes-index` PATH names: the installed tools' (checks 1 and 5)."""
    return shutil.which("lanes-index") or ""


def _ready_check_digests(release: str) -> tuple[bool, str]:
    """CHECK 1 (ops:444): the installed tools' digests equal the release's,
    by `_READY_DIGEST_LIST` in the installed-tools directory, a list that
    names each of `_READY_DIGEST_NAMES`."""
    installed = _ready_installed()
    if not installed:
        return False, "there is no lanes-index on PATH, so there are no installed tools to compare"
    tools = os.path.dirname(os.path.abspath(installed))
    listing = os.path.join(tools, _READY_DIGEST_LIST.format(release=release))
    try:
        with open(listing, encoding="utf-8") as handle:
            text = handle.read()
    except (OSError, UnicodeDecodeError) as exc:
        why = exc.strerror if isinstance(exc, OSError) and exc.strerror else str(exc)
        return False, f"the release {release}'s digest list {listing} cannot be read ({why})"
    entries = []
    for number, line in enumerate(text.splitlines(), 1):
        if not line.strip() or line.startswith("#"):
            continue
        match = _READY_DIGEST_LINE_RE.fullmatch(line)
        if not match or match.group(2) in (".", ".."):
            return False, f"line {number} of {listing} is not `<sha256>  <file name>`"
        entries.append((match.group(1), match.group(2)))
    if not entries:
        return False, f"{listing} names no file"
    named = {name for _, name in entries}
    missing = [name for name in _READY_DIGEST_NAMES if name not in named]
    if missing:
        return False, f"{listing} does not name {' or '.join(missing)}"
    stale = []
    for digest, name in entries:
        try:
            with open(os.path.join(tools, name), "rb") as handle:
                actual = hashlib.sha256(handle.read()).hexdigest()
        except OSError as exc:
            stale.append(f"{name} ({exc.strerror or 'cannot be read'})")
            continue
        if actual != digest:
            stale.append(f"{name} (sha256 {actual[:12]}…, the release's {digest[:12]}…)")
    if stale:
        return False, (f"the installed tools in {tools} differ from release {release}'s "
                       f"digests: {', '.join(stale)}")
    return True, ""


def _ready_check_psql() -> tuple[bool, str]:
    """CHECK 2 (ops:445): `psql` 16 is present, the one the register's paths
    run (`PostgresStore`), asked its version with no inherited `PG` variable."""
    psql = shutil.which("psql")
    if not psql:
        return False, (f"there is no psql on PATH: the register's paths need psql "
                       f"{_READY_PSQL_MAJOR} (1A's postgresql-{_READY_PSQL_MAJOR})")
    env = {key: value for key, value in os.environ.items() if not key.startswith("PG")}
    try:
        proc = subprocess.run([psql, "--version"], stdin=subprocess.DEVNULL, capture_output=True,
                              encoding="utf-8", errors="replace", check=False, env=env,
                              timeout=_READY_LOCAL_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        return False, f"{psql} --version did not answer within {_READY_LOCAL_TIMEOUT_S} s"
    except OSError as exc:
        return False, f"{psql} could not be run: {exc.strerror or exc}"
    major, version = _psql_version_of(proc.stdout if proc.returncode == 0 else "")
    if major is None:
        return False, f"{psql} --version names no version this build can read ({version!r})"
    if major < _READY_PSQL_MAJOR:
        return False, f"{psql} is psql {version}, older than {_READY_PSQL_MAJOR}"
    return True, ""


def _ready_config(expect: str) -> tuple[dict | None, str]:
    """CHECK 3 (ops:446): the configuration is readable, 0600, outside every
    git work tree and `~/.agents/`, and says the expected mode. `load_config`
    makes every refusal of the file, the TLS refusal at load and Q6(c)'s
    among them. Returns the loaded configuration, or None where there is
    none to connect with, and "" or why check 3 fails."""
    path, _named = config_path()
    if not os.path.lexists(path):
        return None, (f"there is no configuration at {path}: ready reads this workstation's "
                      f"lanes-index.conf")
    try:
        cfg = load_config()
    except PrimaryNotBuilt as exc:
        return None, str(exc)
    except Refusal as exc:
        return None, f"the configuration is refused: {exc}"
    if cfg["mode"] != expect:
        return cfg, f"{cfg['path']} says mode={cfg['mode']}, and --expect is {expect}"
    return cfg, ""


def _ready_check_scope(cfg: dict | None, entries: list[dict]) -> tuple[bool, str]:
    """CHECK 4 (ops:447): each role connects within `c` and is refused
    outside its scope: its write fails with 42501, and its scope read finds
    nothing (`_ready_scope_query`)."""
    if cfg is None:
        return False, "there is no configuration to connect with (check 3)"
    reasons = []
    for entry in entries:
        if entry["error"]:
            reasons.append(f"{entry['who']}: {entry['error']}")
            continue
        faults = ([entry["probe"]] if entry["probe"] else []) + entry["scope"]
        if faults:
            reasons.append(f"{entry['who']} is not refused outside its scope: "
                           + "; ".join(faults))
    return (False, "; ".join(reasons)) if reasons else (True, "")


def _ready_check_unrefused() -> tuple[bool, str]:
    """CHECK 5 (ops:448): the installed `lanes-index` no longer carries
    Q6(c)'s refusal: `lanes-index mode` on a configuration that says only
    `mode=primary` does not exit 78 (F8; agreement test 14). A build without
    the refusal answers that file 2, for want of a `register_url=`; one with
    it answers 78 before that rule. The file is this check's scratch copy,
    0600 in a private temporary directory, which is removed."""
    import tempfile
    installed = _ready_installed()
    if not installed:
        return False, "there is no lanes-index on PATH, so no installed build can be asked"
    scratch = tempfile.mkdtemp(prefix="lanes-index-ready-")
    conf = os.path.join(scratch, "lanes-index.conf")
    try:
        fd = os.open(conf, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write("mode=primary\n")
        if git_work_tree_of(scratch) or _under(conf, _agents_root()):
            return False, (f"its scratch configuration in {scratch} would sit inside a git work "
                           f"tree or under {_agents_root()}, where every build refuses it, so "
                           f"the answer would not show Q6(c)'s refusal either way")
        env = {key: value for key, value in os.environ.items() if key != "LANES_INDEX_CONFIG"}
        env["LANES_INDEX_CONFIG"] = conf
        proc = subprocess.run([installed, "mode"], stdin=subprocess.DEVNULL, capture_output=True,
                              encoding="utf-8", errors="replace", check=False, env=env,
                              timeout=_READY_LOCAL_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        return False, (f"the installed {installed} did not answer `lanes-index mode` within "
                       f"{_READY_LOCAL_TIMEOUT_S} s")
    except OSError as exc:
        return False, f"the installed {installed} could not be asked: {exc.strerror or exc}"
    finally:
        for leftover in (conf, scratch):
            try:
                (os.rmdir if leftover == scratch else os.unlink)(leftover)
            except OSError:
                pass
    if proc.returncode == EXIT_CONFIG:
        return False, (f"the installed {installed} still carries Q6(c)'s refusal of "
                       f"mode=primary: `lanes-index mode` exits 78 on a mode=primary "
                       f"configuration (F8; agreement test 14)")
    if proc.returncode in (EXIT_OK, EXIT_REFUSED):
        return True, ""
    first = (proc.stderr.strip().splitlines() or ["no message"])[0]
    return False, (f"the installed {installed} answered `lanes-index mode` with exit "
                   f"{proc.returncode} ({first[:200]}), so it cannot show that Q6(c)'s refusal "
                   f"is gone")


def _ready_workstation() -> tuple[str, str]:
    """CHECK 6's facts (ops:449): this workstation's name, and "" or why
    check 6 fails. `$LANES_WORKSTATION` is the name where it is set, as
    `lanes-edit.sh workstation` answers first; otherwise that command is
    asked, and a container with no name fails, since a write there would be
    stamped with the container's own id (r3b/REPORT.md:192-194; R-A11-14)."""
    seam = os.environ.get("LANES_WORKSTATION", "")
    if seam:
        return seam, ""
    try:
        name, how = this_workstation()
    except StoreUnusable as exc:
        return "", f"this workstation's name cannot be read ({exc.detail})"
    if how == "container-unset":
        return name, (f"this is a container and LANES_WORKSTATION is not set, so a write here "
                      f"would be stamped with the container's own id {name} (Amendment 11, "
                      f"R-A11-14)")
    return name, ""


def _ready_check_declaration() -> tuple[bool, str]:
    """CHECK 7 (ops:450): no outage declaration is recorded: no
    `register-outage` beside the configuration (operations.md §2.5)."""
    path = os.path.join(os.path.dirname(config_path()[0]), "register-outage")
    if os.path.lexists(path):
        return False, (f"an outage declaration is recorded at {path} (operations.md §2.5): end "
                       f"it with `{PROG} outage clear`")
    return True, ""


def _ready_check_marker(expect: str, cfg: dict | None, state: dict) -> tuple[bool, str]:
    """CHECK 8 (ops:451), with `--expect primary` only: the switch is at
    `primary` with the marker `present`, and `origin/<branch>`, as last
    fetched, carries a `lanes/STORE` that names this database: D21's
    `store=primary` and `database=<the switch's label>`."""
    if expect != "primary":
        return True, ""
    if cfg is None:
        return False, "there is no configuration to connect with (check 3)"
    switch, why = _ready_switch(state)
    if why:
        return False, why
    mode, marker, label = switch
    if mode != "primary" or marker != "present":
        return False, (f"the switch is at {mode} with the marker {marker}, not at primary with "
                       f"the marker present")
    try:
        root = workspace_root()
        tip = tip_of(root)
    except StoreUnusable as exc:
        return False, f"origin/{branch()} cannot be read: {exc.detail}"
    proc = git(root, "cat-file", "blob", f"{tip}:lanes/STORE", check=False)
    if proc.returncode != 0:
        return False, (f"origin/{branch()} at {tip[:12]} carries no lanes/STORE, as last fetched "
                       f"into {root}")
    fields = {}
    for line in proc.stdout.splitlines():
        key, eq, value = line.partition("=")
        if eq and key.strip() not in fields:
            fields[key.strip()] = value.strip()
    if fields.get("store") != "primary" or fields.get("database") != label:
        return False, (f"origin/{branch()}'s lanes/STORE at {tip[:12]} says "
                       f"store={fields.get('store', '')} database={fields.get('database', '')}, "
                       f"and this database is {label}")
    return True, ""


def _ready_check_window(cfg: dict | None, state: dict) -> tuple[bool, str]:
    """CHECK 9 (ops:452): this build's `REGISTER_SCHEMA_VERSION` lies inside
    the database's window, from `writers_from` up to `version`, since every
    environment `ready` passes names a `register_url=` and writes; the reason
    names both numbers and the remedy (Y:2338; `register_version_refusal`)."""
    if cfg is None:
        return False, "there is no configuration to connect with (check 3)"
    if state["error"]:
        return False, f"the database's version window cannot be read: {state['error']}"
    rows = state["version"]
    if len(rows) != 1 or len(rows[0]) != 3:
        return False, f"{state['schema']}.schema_version holds {len(rows)} rows, not one"
    try:
        version, writers_from, readers_from = (int(value) for value in rows[0])
    except (TypeError, ValueError):
        return False, f"{state['schema']}.schema_version reads {rows[0]!r}, not three numbers"
    why = register_version_refusal(version, writers_from, readers_from, write=True)
    return (False, why) if why else (True, "")


def _ready_check_label(cfg: dict | None, state: dict) -> tuple[bool, str]:
    """CHECK 10 (ops:453): with the switch at `primary`, whatever `--expect`
    says, `register_label=` equals the switch's `database_label`, or it fails
    with `register_label=<x>, but the switch names <y>`. A switch it cannot
    read fails, since it cannot say the switch is not at `primary`."""
    if cfg is None:
        return False, "there is no configuration to connect with (check 3)"
    switch, why = _ready_switch(state)
    if why:
        return False, why
    mode, _marker, label = switch
    if mode == "primary" and cfg.get("register_label", "") != label:
        return False, f"register_label={cfg.get('register_label', '')}, but the switch names {label}"
    return True, ""


def _ready_check_tls(cfg: dict | None, entries: list[dict]) -> tuple[bool, str]:
    """CHECK 11 (ops:454; [X: hosting]): each role's connection is encrypted
    and reaches the primary. Its URL names no Unix socket, where libpq
    ignores `sslmode`, and carries `sslmode=verify-full` and an
    `sslrootcert=` that is not `system` (C7, Y:2324); it connects, so its
    chain verifies against that root file, else the line names the role and
    libpq's error; its own `pg_stat_ssl` row shows `ssl` true; and
    `pg_is_in_recovery()` is false."""
    if cfg is None:
        return False, "there is no configuration to connect with (check 3)"
    reasons = []
    for entry in entries:
        store = entry["store"]
        if store is None:
            reasons.append(f"{entry['who']}: {entry['error']}")
            continue
        env = store.pg_env
        faults = []
        if any(host == "" or host.startswith("/") for host in env.get("PGHOST", "").split(",")):
            faults.append("its URL names a Unix socket, where libpq ignores sslmode and nothing "
                          "is encrypted")
        mode = env.get("PGSSLMODE")
        if mode != "verify-full":
            faults.append(f"its URL carries {'no sslmode=' if mode is None else f'sslmode={mode}'}, "
                          f"not sslmode=verify-full")
        root = env.get("PGSSLROOTCERT", "")
        if not root:
            faults.append("its URL carries no sslrootcert= naming the issuer's root file")
        elif root == "system":
            faults.append("its sslrootcert= is system, whose store holds no private root (C7, "
                          "design Y:2324)")
        if entry["error"]:
            faults.append(entry["error"])
        else:
            rows = entry["ssl"]
            if len(rows) != 1 or len(rows[0]) != 3:
                faults.append(f"its own pg_stat_ssl row could not be read ({len(rows)} rows)")
            else:
                ssl, _version, recovery = rows[0]
                if ssl != "t":
                    faults.append("its own pg_stat_ssl row shows ssl false: the connection is "
                                  "not encrypted")
                if recovery != "f":
                    faults.append("pg_is_in_recovery() is not false: it reached a server in "
                                  "recovery, not the primary")
        if faults:
            reasons.append(f"{entry['who']}: " + "; ".join(faults))
    return (False, "; ".join(reasons)) if reasons else (True, "")


def _ready_check_floors(cfg: dict | None, entries: list[dict]) -> tuple[bool, str]:
    """CHECK 12 (ops:455): each login's own floors, from its own `pg_roles`
    row, are its group's, as §1.4's login step sets them
    (`_register_login_parts`' floors): the writer login's `lock_timeout`,
    `statement_timeout` and `idle_in_transaction_session_timeout`, the reader
    login's `default_transaction_read_only`, `lock_timeout` and
    `statement_timeout`. A missing or different floor fails, naming the
    login and the floor."""
    if cfg is None:
        return False, "there is no configuration to connect with (check 3)"
    floors = _register_login_parts()["floors"]
    reasons = []
    for entry in entries:
        if entry["error"]:
            reasons.append(f"{entry['who']}: its pg_roles row cannot be read: {entry['error']}")
            continue
        rows = entry["role_row"]
        if len(rows) != 1 or len(rows[0]) != 2:
            reasons.append(f"{entry['who']}: its own pg_roles row could not be read "
                           f"({len(rows)} rows)")
            continue
        login, config = rows[0][0], rows[0][1] or ""
        settings: dict = {}
        for item in config.split("\n"):
            name, eq, value = item.partition("=")
            if eq:
                settings.setdefault(name, value)
        faults = []
        for floor in floors[entry["half"]]:
            name, _eq, value = floor.partition("=")
            if name not in settings:
                faults.append(f"lacks the floor {floor}")
            elif settings[name] != value:
                faults.append(f"carries {name}={settings[name]}, not the floor {floor}")
        if faults:
            who = entry["who"] if f" {login} " in entry["who"] else f"{entry['who']}, as {login},"
            reasons.append(f"{who} " + "; ".join(faults))
    return (False, "; ".join(reasons)) if reasons else (True, "")


def _ready_resolve(host: str, port: str) -> tuple[list[str], str]:
    """The distinct addresses `host` resolves to by the lookup libpq makes
    for a host name (`getaddrinfo` with `SOCK_STREAM`, any family and no
    flags; libpq 16's `fe-connect.c`), in the resolver's order, or why they
    cannot be read. The lookup has `_READY_LOCAL_TIMEOUT_S`."""
    import socket
    import threading
    box: dict = {}

    def lookup() -> None:
        try:
            box["infos"] = socket.getaddrinfo(host, port, socket.AF_UNSPEC, socket.SOCK_STREAM)
        except (OSError, UnicodeError) as exc:
            box["error"] = exc

    worker = threading.Thread(target=lookup, daemon=True)
    worker.start()
    worker.join(_READY_LOCAL_TIMEOUT_S)
    if worker.is_alive():
        return [], f"the lookup did not answer within {_READY_LOCAL_TIMEOUT_S} s"
    if "error" in box:
        return [], str(box["error"])
    addresses: list[str] = []
    for _family, _kind, _proto, _name, sockaddr in box.get("infos", []):
        if sockaddr[0] not in addresses:
            addresses.append(sockaddr[0])
    if not addresses:
        return [], "the lookup answered no address"
    return addresses, ""


def _ready_check_addresses(cfg: dict | None) -> tuple[bool, str]:
    """CHECK 13 (ops:456; [X: hosting]): for each distinct host the register's
    URLs name, its address count against `N_a`, `register_addresses=`. A
    count above `N_a` fails, naming the host, the count, `N_a` and the
    addresses; a count at or below it passes and prints both. A host that
    does not resolve fails. It reads only the resolver, never the database,
    and a Unix socket has no address to count."""
    if cfg is None:
        return False, "there is no configuration to read the register's URLs from (check 3)"
    if not cfg.get("register_url"):
        return False, "the configuration names no register_url=, so there is no endpoint to count"
    hosts: dict = {}
    for key in ("register_url", "reader_url"):
        if not cfg.get(key):
            continue
        env = pg_url_env(cfg[key], f"`{key}=` in {cfg['path']}")
        names = env.get("PGHOST", "").split(",")
        ports = env.get("PGPORT", "").split(",")
        for i, host in enumerate(names):
            if host == "" or host.startswith("/"):
                continue
            port = ports[i] if len(ports) == len(names) else ports[0]
            hosts.setdefault(host, port or "5432")
    if not hosts:
        return True, "the register's URLs name no TCP host: a Unix socket has no address to count"
    n_a = cfg["register_addresses"]
    fails, oks = [], []
    for host, port in hosts.items():
        addresses, why = _ready_resolve(host, port)
        if why:
            fails.append(f"{host} cannot be resolved, so its address count cannot be read "
                         f"({why})")
            continue
        counted = f"{len(addresses)} address{'' if len(addresses) == 1 else 'es'}"
        if len(addresses) > n_a:
            fails.append(f"{host} resolves to {counted} ({', '.join(addresses)}), above N_a "
                         f"{n_a} (register_addresses=): a connect may then take more than "
                         f"N_a·c, which no timer counts. Measure N_a again and raise it (act "
                         f"3's step 1)")
        else:
            oks.append(f"{host} resolves to {counted}, N_a {n_a}")
    return (False, "; ".join(fails)) if fails else (True, "; ".join(oks))


def _ready(opts: dict) -> tuple[list[str], bool]:
    """The thirteen checks, in order, and the last line: the lines to print,
    and whether any check failed. Each step fails closed: an error it did
    not expect is that check's FAIL, never a pass."""
    expect, release = opts["--expect"], opts["--release"]

    def guarded(step, *args):
        try:
            return step(*args)
        except Exception as exc:  # NOSONAR
            return False, f"the check could not run ({type(exc).__name__}: {exc})"

    try:
        cfg, cfg_why = _ready_config(expect)
    except Exception as exc:  # NOSONAR
        cfg, cfg_why = None, f"the configuration could not be read ({type(exc).__name__}: {exc})"
    try:
        entries = _ready_roles(cfg) if cfg is not None else []
    except Exception as exc:  # NOSONAR
        entries = [{"who": "the register's logins", "half": "w", "store": None,
                    "error": f"they could not be read ({type(exc).__name__}: {exc})",
                    "ssl": None, "role_row": None, "scope": [], "probe": ""}]
    try:
        state = _ready_state(entries)
    except Exception as exc:  # NOSONAR
        state = {"error": f"{type(exc).__name__}: {exc}", "schema": "", "version": [],
                 "switch": []}
    try:
        workstation, workstation_why = _ready_workstation()
    except Exception as exc:  # NOSONAR
        workstation, workstation_why = "", f"the check could not run ({type(exc).__name__}: {exc})"

    results = [
        guarded(_ready_check_digests, release),
        guarded(_ready_check_psql),
        (not cfg_why, cfg_why),
        guarded(_ready_check_scope, cfg, entries),
        guarded(_ready_check_unrefused),
        (not workstation_why, workstation_why),
        guarded(_ready_check_declaration),
        guarded(_ready_check_marker, expect, cfg, state),
        guarded(_ready_check_window, cfg, state),
        guarded(_ready_check_label, cfg, state),
        guarded(_ready_check_tls, cfg, entries),
        guarded(_ready_check_floors, cfg, entries),
        guarded(_ready_check_addresses, cfg),
    ]
    if len(results) != _READY_CHECKS:
        raise RuntimeError(f"ready has {len(results)} checks, not {_READY_CHECKS}")
    lines, failed = [], []
    for number, (ok, text) in enumerate(results, 1):
        if ok:
            lines.append(_ready_line(f"check {number}: ok" + (f": {text}" if text else "")))
        else:
            failed.append(number)
            lines.append(_ready_line(f"check {number}: FAIL: {text or 'no reason was given'}"))
    import socket
    host = os.environ.get("LANES_HOST") or socket.gethostname() or "unknown"
    verdict = (f"{_READY_CHECKS} of {_READY_CHECKS} checks ok" if not failed else
               f"{_READY_CHECKS - len(failed)} of {_READY_CHECKS} checks ok, FAIL on "
               f"{', '.join(map(str, failed))}")
    lines.append(_ready_line(
        f"ready: env {opts['--env']}, host {host}, workstation {workstation or 'unknown'}, "
        f"tools {release if results[0][0] else 'unknown (check 1)'}: {verdict}"))
    return lines, bool(failed)


def cmd_ready(args: list[str]) -> int:
    """`lanes-index ready` (operations.md §2.4): its exits, by the contract's
    constants: 0 every check passed, 2 any failed, 64 usage. It never exits
    69: a database it cannot reach is check 4's failure."""
    try:
        opts = _ready_args(args)
    except _RegisterUsage as exc:
        note(f"{exc} - see {PROG} ready --help")
        return EXIT_USAGE
    if opts is None:
        say(_READY_USAGE)
        return EXIT_OK
    lines, failed = _ready(opts)
    for line in lines:
        say(line)
    return EXIT_REFUSED if failed else EXIT_OK


# `LANES-INDEX LOGIN` (operations.md §2.4, "lanes-index login"; FR-009, FR-054;
# T110). Brett's command for each engineer's two logins and the dump job's one
# (design.md §1.4, "One engineer's logins"; Brett's "Two logins each
# (Recommended)", #165 6723413756), run from his own shell after the bootstrap,
# through the admin service as the bootstrap connects, under §2.4's four rules:
#   - `add <engineer>` makes `lanes_w_<engineer>`, a member of REGISTER-WRITER,
#     and `lanes_r_<engineer>`, a member of READER, each with its group's
#     floors and a password it generates. It prints, once, their two
#     password-file lines, then the `register_url=` and `reader_url=` lines for
#     that engineer's file. Run again, it changes nothing but a lost
#     membership, which it puts back;
#   - `add --dump-job` makes `lanes_register_dump` alone, §1.4's second half
#     with `r=lanes_register_dump`, whose password Brett stores as the Key
#     Vault secret the dump CronJob reads;
#   - `rotate <engineer>` sets new passwords for both logins, and `rotate
#     --dump-job` for `lanes_register_dump` alone (lane 3's ruling,
#     #165 6726725691), and prints the new password-file lines;
#   - `revoke <engineer>`, for each of the two logins in turn, the writer's
#     first, runs §1.4's revoke and prints each step's result.
#
# ONE TRANSACTION A STEP, AND Y'S BYTES UNCHANGED (as T108 and T109). The login
# step is one `--single-transaction` call: Y:2288-2300, or its second half alone
# for the dump job, less the CREATE ROLE of each login that exists already (the
# `pg_roles` guard, which is outside Y's bytes), then one `ALTER ROLE ...
# PASSWORD '<verifier>'` for each login it creates, so each password is set in
# the transaction that makes its login. The revoke's three numbered steps are
# three such calls per login, each committed before the next, so their effects
# come in Y's order: no new session (28000), then an open session's next
# statement refused (42501), then its sessions ended (57P01), with step 3's
# grant to the admin never outliving that step. Joined, one login's three
# scripts are Y:2302-2309 byte for byte. A rotation is `ALTER ROLE ... PASSWORD`
# with a new verifier (Y:2312), both of an engineer's logins in one call.
#
# THE SECRET (operations.md:481; P20). `add` and `rotate` make passwords, so
# they refuse when stdout is not a terminal, before any connection; `revoke`
# prints none and does not. Each password is generated here, sent only as a
# SCRAM-SHA-256 verifier in the script on psql's stdin, and printed once, as a
# password-file line, after its step has committed.
#
# THE URL LINES (Y:2326; contracts/config.md §3.1). The bootstrap gives `login`
# no endpoint, and `login` guesses none: the host and port are those psql
# connected to, its own `:HOST` and `:PORT`, and the database is the one the
# admin connection reached, which on the install name `<endpoint>`, as the
# admin's own service does (Y:2324). Each line carries `sslmode=verify-full` and
# an `sslrootcert=` that `--sslrootcert <path>` fills, or that reads `<root
# file>` for the engineer to fill. No URL carries a password.

#: Design.md §1.4's login step and revoke, verbatim (Y:2288-2309). The login
#: step's psql variables are `w` and `r`, the revoke's `login` and `grp`.
_REGISTER_LOGIN_BLOCK = r"""-- lanes-index login add <engineer>: psql -v w=lanes_w_<engineer> -v r=lanes_r_<engineer>.
-- The dump job's login is the second half alone, with r=lanes_register_dump. Each CREATE ROLE
-- is guarded by a pg_roles check, as the bootstrap's are.
CREATE ROLE :"w" LOGIN;                         -- its password: a SCRAM verifier, set as it is made
GRANT lanes_register_writer TO :"w";            -- again on a rerun: puts back a lost membership
ALTER ROLE :"w" SET lock_timeout = '2000ms';    -- the writer's floors, the login's own (§1.3)
ALTER ROLE :"w" SET statement_timeout = '5s';
ALTER ROLE :"w" SET idle_in_transaction_session_timeout = '5s';
CREATE ROLE :"r" LOGIN;
GRANT lanes_register_reader TO :"r";
ALTER ROLE :"r" SET default_transaction_read_only = on;   -- the reader's floors
ALTER ROLE :"r" SET lock_timeout = '1000ms';
ALTER ROLE :"r" SET statement_timeout = '1500ms';

-- lanes-index login revoke <engineer>: for each of its logins, psql -v login=… -v grp=…
ALTER ROLE :"login" NOLOGIN;                                  -- 1. no new session (28000)
REVOKE :"grp" FROM :"login";                                  -- 2. an open session's next statement
                                                              --    is refused (42501)
GRANT :"login" TO CURRENT_USER WITH INHERIT TRUE, SET FALSE;  -- 3. its privileges, so the admin may
SELECT pg_terminate_backend(pid) FROM pg_stat_activity        --    end its sessions (57P01) with no
  WHERE usename = :'login';                                   --    pg_signal_backend
REVOKE :"login" FROM CURRENT_USER;
"""

#: The dump job's login, a READER login alone (design.md §1.4's roles table;
#: operations.md act 3's step 1).
_REGISTER_DUMP_LOGIN = "lanes_register_dump"

#: An engineer's name (operations.md:487), matched whole.
_REGISTER_ENGINEER_RE = re.compile(r"[a-z][a-z0-9_]{0,40}")

#: An `--sslrootcert` path: absolute, and of characters a URL's query carries
#: as they are, so the line needs no escaping.
_REGISTER_ROOT_FILE_RE = re.compile(r"/[A-Za-z0-9._/-]*")

#: The login step's units: a login's CREATE ROLE, its group's GRANT and each of
#: its floors, each one line with its comment.
_REGISTER_LOGIN_CREATE_RE = re.compile(r'CREATE ROLE :"([wr])" LOGIN;[ \t]*(?:--[^\n]*)?\n')
_REGISTER_LOGIN_GRANT_RE = re.compile(
    r'GRANT ([a-z_][a-z0-9_]*) TO :"([wr])";[ \t]*(?:--[^\n]*)?\n')
_REGISTER_LOGIN_FLOOR_RE = re.compile(
    r"ALTER ROLE :\"([wr])\" SET ([a-z_]+) = '?([A-Za-z0-9]+)'?;[ \t]*(?:--[^\n]*)?\n")

_LOGIN_USAGE = f"""\
{PROG} login add <engineer> --admin-service <service> [--sslrootcert <path>]
{PROG} login add --dump-job --admin-service <service>
{PROG} login rotate <engineer> --admin-service <service>
{PROG} login rotate --dump-job --admin-service <service>
{PROG} login revoke <engineer> --admin-service <service>

Makes, re-keys or revokes an engineer's two logins on the SQL register,
lanes_w_<engineer> (REGISTER-WRITER) and lanes_r_<engineer> (READER), each with
its group's floors, or the dump job's lanes_register_dump (READER), through the
libpq service <service> in your own ~/.pg_service.conf, as bootstrap connects
(operations.md §2.4). Run it from your shell, after bootstrap: add and rotate
print each new password once, as a password-file line, only to a terminal, and
send it to the database only as a SCRAM verifier computed here.

  add          makes the logins; run again, it puts back a lost membership and
               changes nothing else. With an engineer, it also prints the
               register_url= and reader_url= lines for that engineer's file, at
               the host, port and database the admin connection reached
  rotate       a new password for each login; a session already open goes on
  revoke       for each login, the writer's first: NOLOGIN, its membership
               revoked, then its sessions ended, each step's result printed
  <engineer>   [a-z][a-z0-9_]{{0,40}}
  --dump-job   lanes_register_dump alone; store its password as the Key Vault
               secret the dump CronJob reads
  --sslrootcert <path>
               the root file on the engineer's host, for add's URL lines;
               without it they read sslrootcert=<root file>

Exit: 0 done · 2 refused, nothing written · 64 usage · 69 the admin connection
failed, or the database refused a step."""


def _register_login_parts() -> dict:
    """§1.4'S LOGIN BLOCK, CUT. Returns, each the block's own text:
      - `head`: the login step's comment lines;
      - `halves`: for `w` and `r`, that half's units in the block's order, its
        CREATE ROLE first;
      - `groups`: the group each half's GRANT names;
      - `floors`: each half's `ALTER ROLE ... SET`s, as `name=value`, the form
        `pg_roles.rolconfig` holds;
      - `revoke`: the revoke's three steps, the first with the revoke's comment
        line, so that joined they are the revoke whole.
    A block that does not cut so is a defect of this build, so the error is
    not a refusal."""
    step, blank, revoke = _REGISTER_LOGIN_BLOCK.partition("\n\n")
    if not blank or "\n\n" in revoke or not revoke.endswith("\n"):
        raise RuntimeError("the register's login block is not the login step, one blank "
                           "line, then the revoke")
    units = _register_sql_units(step + "\n")
    head = []
    while units and units[0].startswith("--"):
        head.append(units.pop(0))
    halves: dict[str, list[str]] = {"w": [], "r": []}
    groups: dict[str, str] = {}
    floors: dict[str, list[str]] = {"w": [], "r": []}
    order: list[str] = []
    for unit in units:
        create = _REGISTER_LOGIN_CREATE_RE.fullmatch(unit)
        grant = _REGISTER_LOGIN_GRANT_RE.fullmatch(unit)
        floor = _REGISTER_LOGIN_FLOOR_RE.fullmatch(unit)
        if create:
            half = create.group(1)
            if halves[half]:
                raise RuntimeError(f"the login block's half {half} does not open with its "
                                   f"CREATE ROLE")
        elif grant:
            half = grant.group(2)
            if half in groups:
                raise RuntimeError(f"the login block's half {half} grants two groups")
            groups[half] = grant.group(1)
        elif floor:
            half = floor.group(1)
            floors[half].append(f"{floor.group(2)}={floor.group(3)}")
        else:
            raise RuntimeError(f"the login block holds {unit!r}, which is not a CREATE ROLE, "
                               f"a GRANT or a floor")
        if not halves[half] and not create:
            raise RuntimeError(f"the login block's half {half} does not open with its "
                               f"CREATE ROLE")
        if not order or order[-1] != half:
            order.append(half)
        halves[half].append(unit)
    roles = register_role_names()
    if (len(head) != 3 or order != ["w", "r"] or not floors["w"] or not floors["r"]
            or groups != {"w": roles[1], "r": roles[2]}):
        raise RuntimeError(f"the login block is not three comment lines, the writer's half, "
                           f"then the reader's, each granting its group: {order}, {groups}")
    steps = _register_sql_units(revoke)
    if (len(steps) != 6 or not steps[0].startswith("--")
            or not steps[1].startswith('ALTER ROLE :"login" NOLOGIN;')
            or not steps[2].startswith('REVOKE :"grp" FROM :"login";')
            or not steps[3].startswith('GRANT :"login" TO CURRENT_USER WITH INHERIT TRUE, SET FALSE;')
            or "pg_terminate_backend(pid)" not in steps[4]
            or not steps[5].startswith('REVOKE :"login" FROM CURRENT_USER;')):
        raise RuntimeError("the login block's revoke is not its comment, NOLOGIN, the "
                           "membership revoked, then the grant, the end of its sessions and "
                           "the grant revoked")
    revoke_steps = ["".join(steps[:2]), steps[2], "".join(steps[3:])]
    if "".join(revoke_steps) != revoke:
        raise RuntimeError("the login block's revoke does not cut into three steps")
    return {"head": "".join(head), "halves": halves, "groups": groups, "floors": floors,
            "revoke": revoke_steps}


def register_login_script(halves: list[str], existing, verifiers: dict) -> str:
    """THE LOGIN STEP AS SENT, one script for one `--single-transaction` call.

    `halves` is `["w", "r"]` for an engineer, or `["r"]` for the dump job, §1.4's
    "second half alone". `existing` holds the halves whose login exists
    already: their CREATE ROLE is left out, the `pg_roles` guard. `verifiers`
    maps each half whose login this step creates to the SCRAM verifier of its
    new password; each goes as one `ALTER ROLE :"<half>" PASSWORD
    '<verifier>';` after the block's text. Every other line is the block's own
    text, byte for byte, comments and all; for an engineer whose logins are
    both new, the script opens with Y:2288-2300 whole."""
    parts = _register_login_parts()
    if halves not in (["w", "r"], ["r"]):
        raise ValueError(f"the login step's halves are ['w', 'r'] or ['r'], not {halves!r}")
    if set(verifiers) - (set(halves) - set(existing)):
        raise ValueError("a verifier was given for a login this step does not create")
    text = parts["head"] if halves == ["w", "r"] else ""
    for half in halves:
        units = parts["halves"][half]
        text += "".join(units[1:] if half in existing else units)
    for half in halves:
        if half in verifiers:
            text += f'ALTER ROLE :"{half}" PASSWORD {_pg_quote(verifiers[half])};\n'
    return text


def _register_login_query(login: str, group: str) -> str:
    """One login's state, as one row or none: its name, whether it may log in,
    whether it is a member of `group`, and its own settings, one per line."""
    return ("SELECT a.rolname::text, a.rolcanlogin, EXISTS (SELECT 1 FROM "
            "pg_catalog.pg_auth_members m JOIN pg_catalog.pg_roles g ON g.oid = m.roleid "
            f"WHERE m.member = a.oid AND g.rolname = {_pg_quote(group)}), "
            "coalesce(pg_catalog.array_to_string(a.rolconfig, chr(10)), '') "
            f"FROM pg_catalog.pg_roles a WHERE a.rolname = {_pg_quote(login)}")


def _register_login_probe(service: str, logins: list[tuple[str, str]], *, url: bool) -> dict:
    """THE LOGIN'S FIRST READ, through the admin service, before anything is
    written: who the admin is and what it may do, which of the two groups
    exist, and each login's state. With `url`, also the host and port psql
    connected to, psql's own `:HOST` and `:PORT`, which psql fills in."""
    groups = _register_login_parts()["groups"]
    queries = [_register_admin_query(),
               f"SELECT rolname::text FROM pg_catalog.pg_roles WHERE rolname IN "
               f"({_register_names_sql([groups['w'], groups['r']])})"]
    queries += [_register_login_query(login, groups[half]) for login, half in logins]
    if url:
        queries.append("SELECT :'HOST', :'PORT'")
    res = _register_reads(service, "probe", queries, command="login")
    admin = _register_one_row(res[0], 6, "the admin")
    states: dict[str, dict] = {}
    for (login, _half), rows in zip(logins, res[2:2 + len(logins)]):
        if len(rows) > 1 or (rows and len(rows[0]) != 4):
            raise RegisterUnavailable(f"psql answered {len(rows)} rows for the login {login}")
        if rows:
            states[login] = {"can_login": _register_flag(rows[0][1]),
                             "member": _register_flag(rows[0][2]),
                             "settings": set((rows[0][3] or "").split("\n")) - {""}}
    probe = {"user": admin[0], "database": admin[1], "create_roles": _register_flag(admin[2]),
             "owns": _register_flag(admin[4]), "groups": {row[0] for row in res[1] if row},
             "logins": states}
    if url:
        probe["host"], probe["port"] = _register_one_row(
            res[-1], 2, "the admin connection's host and port")
    return probe


def register_login_url(login: str, host: str, port: str, database: str,
                       root_file: str | None) -> str:
    """ONE OF AN ENGINEER'S URL LINES' VALUES, in Y's form (Y:2326):
    `postgresql://<login>@<host>:<port>/<database>?sslmode=verify-full&sslrootcert=<root>`,
    at the host, port and database the admin connection reached. A socket
    directory is percent-encoded whole, an IPv6 address bracketed. No
    password: the login's line goes in its own 0600 file."""
    from urllib.parse import quote
    if not isinstance(port, str) or not re.fullmatch(r"[0-9]{1,5}", port):
        raise RegisterUnavailable(f"psql answered the port {port!r}")
    host = host or ""
    if ":" in host and not host.startswith("/"):
        where = "[" + quote(host, safe=":") + "]"
    else:
        where = quote(host, safe="")
    return (f"postgresql://{login}@{where}:{port}/{quote(database, safe='')}"
            f"?sslmode=verify-full&sslrootcert={root_file or '<root file>'}")


def _register_login_args(args: list[str]) -> dict | None:
    """`login`'s command line; None for `--help`. First, no argument may carry
    a connection string or a password, wherever it stands (2, never echoed);
    then its usage (64); then its values (2)."""
    for arg in args:
        value = arg.partition("=")[2] if arg.startswith("--") and "=" in arg else arg
        _register_refuse_argument("an argument", value, command="login")
    opts: dict = {"--admin-service": None, "--sslrootcert": None, "--dump-job": False}
    words: list[str] = []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-h", "--help"):
            return None
        name, eq, value = arg.partition("=")
        if name in ("--admin-service", "--sslrootcert"):
            if not eq:
                value = args[i + 1] if i + 1 < len(args) else ""
                i += 1
            if not value:
                raise _RegisterUsage(f"login: {name} needs a value")
            if opts[name] is not None:
                raise _RegisterUsage(f"login: {name} is given twice")
            opts[name] = value
        elif arg == "--dump-job":
            if opts["--dump-job"]:
                raise _RegisterUsage("login: --dump-job is given twice")
            opts["--dump-job"] = True
        elif arg.startswith("-"):
            raise _RegisterUsage(f"login: unknown option {name}")
        else:
            words.append(arg)
        i += 1
    if not words or words[0] not in ("add", "rotate", "revoke"):
        raise _RegisterUsage("login needs add, rotate or revoke")
    action, rest = words[0], words[1:]
    if len(rest) > 1:
        raise _RegisterUsage(f"login {action} takes one engineer")
    engineer = rest[0] if rest else None
    dump = opts["--dump-job"]
    if action == "revoke" and dump:
        raise _RegisterUsage("login revoke takes an engineer; the dump job's login is "
                             "rotated, never revoked, by this command")
    if action == "revoke" and engineer is None:
        raise _RegisterUsage("login revoke needs an engineer")
    if (engineer is None) == (not dump):
        raise _RegisterUsage(f"login {action} needs an engineer or --dump-job, and not both")
    if opts["--sslrootcert"] is not None and (action != "add" or dump):
        raise _RegisterUsage("login: --sslrootcert is for the URL lines of login add "
                             "<engineer>")
    if opts["--admin-service"] is None:
        raise _RegisterUsage("login needs --admin-service <service>")
    if engineer is not None and not _REGISTER_ENGINEER_RE.fullmatch(engineer):
        raise Refusal("login: the engineer's name is not ^[a-z][a-z0-9_]{0,40}$: a lower-case "
                      "letter, then up to 40 lower-case letters, digits or '_'")
    _register_refuse_argument("--admin-service", opts["--admin-service"], command="login")
    root = opts["--sslrootcert"]
    if root is not None and (root == "system" or not _REGISTER_ROOT_FILE_RE.fullmatch(root)):
        raise Refusal("login: --sslrootcert is not an absolute path of letters, digits, '.', "
                      "'_', '-' and '/'. It names the root file on the engineer's host, never "
                      "`system`, which holds no private root (design.md §1.4, Y:2324)")
    return {"action": action, "engineer": engineer, "dump": dump,
            "service": opts["--admin-service"], "root": root}


def cmd_login(args: list[str]) -> int:
    """`lanes-index login` (operations.md §2.4): its exits, by the contract's
    constants."""
    try:
        opts = _register_login_args(args)
    except _RegisterUsage as exc:
        note(f"{exc} - see {PROG} login --help")
        return EXIT_USAGE
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return EXIT_REFUSED
    if opts is None:
        say(_LOGIN_USAGE)
        return EXIT_OK
    try:
        return _login(opts)
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return EXIT_REFUSED
    except RegisterUnavailable as exc:
        hint = {"add": " A step cut at its commit may have made a login: `login add` again "
                       "names what it finds, and `login rotate` gives such a login a password "
                       "you hold.",
                "rotate": " A step cut at its commit may have changed the passwords: run "
                          "`login rotate` again.",
                "revoke": " Each step printed above stands; run `login revoke` again to "
                          "finish."}[opts["action"]] if opts.get("sent") else " Nothing was sent."
        note(f"login {opts['action']}: the admin connection failed, or the database refused "
             f"a step: {exc}.{hint}")
        return EXIT_UNAVAILABLE


def _login(opts: dict) -> int:
    action, engineer, dump, service = (opts["action"], opts["engineer"], opts["dump"],
                                       opts["service"])
    if action in ("add", "rotate") and not sys.stdout.isatty():
        raise Refusal(f"login {action}: stdout is not a terminal. It prints a password only "
                      f"to a terminal, so that no transcript, log or pipe holds one: run it "
                      f"from your shell")
    load_config()
    parts = _register_login_parts()
    groups = parts["groups"]
    if dump:
        logins = [(_REGISTER_DUMP_LOGIN, "r")]
    else:
        logins = [(f"lanes_w_{engineer}", "w"), (f"lanes_r_{engineer}", "r")]
    probe = _register_login_probe(service, logins, url=(action == "add" and not dump))
    who, database = probe["user"], probe["database"]
    if not probe["create_roles"]:
        raise Refusal(f"login {action}: the admin {who} may not create or alter roles: it has "
                      f"neither CREATEROLE nor SUPERUSER")
    if not isinstance(database, str) or not database.strip() or any(
            ord(ch) < 0x20 or ord(ch) == 0x7F for ch in database):
        raise Refusal(f"login {action}: the database's name is empty or holds a control "
                      f"character")
    states = probe["logins"]
    if action == "revoke":
        return _login_revoke(service, parts, logins, probe, opts)
    for login, _half in logins:
        state = states.get(login)
        if action == "rotate" and state is None:
            raise Refusal(f"login rotate: {login} does not exist; `login add` makes it")
        if state is not None and not state["can_login"]:
            raise Refusal(f"login {action}: {login} exists and cannot log in: it was revoked, "
                          f"and a revoked login's name is not reused while the server's logs "
                          f"still name it (design.md §1.4). "
                          + ("Give the engineer another name, or drop the role first"
                             if action == "add" else "A revoked login takes no new password"))
    if action == "add":
        missing = [groups[half] for _login_name, half in logins
                   if groups[half] not in probe["groups"]]
        if missing:
            raise Refusal(f"login add: {' and '.join(missing)} "
                          f"{'do' if len(missing) > 1 else 'does'} not exist: run bootstrap, "
                          f"or bootstrap --roles-only, first")
    if not probe["owns"]:
        note(f"login {action}: the admin {who} does not own the database {database}, which "
             f"the lines below name. If it is not the register's database, run it again "
             f"through the service that names that one")
    import secrets
    creating = [(login, half) for login, half in logins
                if action == "rotate" or states.get(login) is None]
    passwords = {login: secrets.token_urlsafe(32) for login, _half in creating}
    verifiers = {half: register_scram_verifier(passwords[login]) for login, half in creating}
    variables = {half: login for login, half in logins}
    if action == "add":
        script = register_login_script([half for _login_name, half in logins],
                                       {half for login, half in logins if login in states},
                                       verifiers)
    else:
        script = "".join(f'ALTER ROLE :"{half}" PASSWORD {_pg_quote(verifiers[half])};\n'
                         for _login_name, half in logins)
    opts["sent"] = True
    _register_admin_psql(service, script, variables, single_transaction=True)

    if action == "add":
        for login, half in logins:
            state = states.get(login)
            _bootstrap_say(f"login {login}", state is None,
                           "LOGIN, its password a SCRAM verifier set as it was made"
                           if state is None else "")
            _bootstrap_say(f"login {login}'s membership of {groups[half]}",
                           state is None or not state["member"],
                           "put back" if state is not None and not state["member"] else "")
            lacking = [f for f in parts["floors"][half]
                       if state is None or f not in state["settings"]]
            _bootstrap_say(f"login {login}'s floors", bool(lacking),
                           ("put back: " if state is not None and lacking else "")
                           + ", ".join(lacking or parts["floors"][half]))
    else:
        for login, _half in logins:
            say(f"login {login}'s password: changed (a new SCRAM verifier; a session already "
                f"open goes on until it ends)")
    for login, half in creating:
        if dump:
            say(f"# {login}'s password-file line, printed once: store it as the Key Vault "
                f"secret the dump CronJob reads (its password is the line's last field)")
        else:
            key = "register_passfile=" if half == "w" else "reader_passfile="
            say(f"# {login}'s password-file line, printed once: put it alone in a 0600 file "
                f"of {engineer}'s account, and name that file in {key}")
        say(_register_pgpass_line(database, login, passwords[login]))
    sys.stdout.flush()
    if action == "add" and not creating:
        say(f"# no password line: {' and '.join(login for login, _half in logins)} existed "
            f"already. `{PROG} login rotate {'--dump-job' if dump else engineer}` gives "
            f"{'it a new one' if dump else 'them new ones'}")
    if action == "rotate" and not dump:
        say(f"# until {engineer}'s two password files hold these lines, that workstation's "
            f"new connections fail at login (69): write them before its lanes resume")
    if action == "add" and not dump:
        say(f"# lanes-index.conf lines for {engineer}'s file, with no secret; sslrootcert= "
            f"names the root file on {engineer}'s host:")
        for login, key in ((logins[0][0], "register_url="), (logins[1][0], "reader_url=")):
            say(key + register_login_url(login, probe["host"], probe["port"], database,
                                         opts["root"]))
    return EXIT_OK


def _login_revoke(service: str, parts: dict, logins: list[tuple[str, str]],
                  probe: dict, opts: dict) -> int:
    """§1.4'S REVOKE (Y:2302-2309; operations.md §2.4's `revoke`), for each of
    the engineer's logins in turn, the writer's first: its three steps, each
    one `--single-transaction` call that commits before the next, each step's
    result printed as it ends. A login that does not exist is said so; where
    neither does, nothing is revoked (2)."""
    states, groups = probe["logins"], parts["groups"]
    present = [(login, half) for login, half in logins if login in states]
    if not present:
        raise Refusal(f"login revoke: neither {logins[0][0]} nor {logins[1][0]} exists, so "
                      f"there is nothing to revoke; check the engineer's name")
    missing = [groups[half] for _login, half in present if groups[half] not in probe["groups"]]
    if missing:
        raise Refusal(f"login revoke: {' and '.join(missing)} "
                      f"{'do' if len(missing) > 1 else 'does'} not exist, so no membership of "
                      f"{'them' if len(missing) > 1 else 'it'} can be revoked; nothing was "
                      f"revoked")
    nologin, revoke_group, end_sessions = parts["revoke"]
    for login, half in logins:
        state = states.get(login)
        if state is None:
            say(f"login {login}: absent, nothing to revoke")
            continue
        variables = {"login": login, "grp": groups[half]}
        opts["sent"] = True
        _register_admin_psql(service, nologin, variables, single_transaction=True)
        say(f"login {login}, step 1, NOLOGIN: "
            + ("done (a new session is refused: 28000)" if state["can_login"]
               else "unchanged (it could not log in)"))
        sys.stdout.flush()
        _register_admin_psql(service, revoke_group, variables, single_transaction=True)
        say(f"login {login}, step 2, its membership of {groups[half]} revoked: "
            + ("done (an open session's next statement is refused: 42501)" if state["member"]
               else "unchanged (it held none)"))
        sys.stdout.flush()
        out = _register_admin_psql(service, end_sessions, variables, single_transaction=True)
        answers = [line.strip() for line in out.splitlines() if line.strip() in ("t", "f")]
        ended, gone = answers.count("t"), answers.count("f")
        say(f"login {login}, step 3, its sessions ended: {ended} ended (57P01)"
            + (f", {gone} gone before the signal" if gone else "")
            + f"; the admin held {login}'s privileges for this step alone")
        sys.stdout.flush()
    return EXIT_OK


# ===== the SQL register: register commands (007)
#
# THE WRITERS' COMMIT (feature 007, opensoft/openRepoTools#165; contract
# §3.3; design.md §1.3 and §1.3.1). `register commit` is an attempt's second
# `psql` call. It reads the attempt directory the seam left, and derives the
# whole entry itself: the line edits from each path's base and new bytes, the
# per-file digests, and every structured row by this file's one classifier,
# with D18's and D19's alias sets from `tree/lanes/repos.tsv`. Group B sends
# no structured rows (contract §3.3, lane 4's Q4). Then ONE `commit_write`
# call at SERIALIZABLE, as one request, with D9's commit row.
#
# ITS EXITS ARE §3.3'S TABLE (Y:1553-1571; contract §2.7; CO-6). 2 and 69
# come only from a refusal identified by its SQLSTATE under `psql`'s exit 3,
# or from an error raised before anything was sent. Every other end of a call
# that was sent is 3, in doubt. An LR004 is followed by one re-read of the
# files the entry read from `tree/`, and never by a second commit call (R02,
# as lane 3 reads it: #165 6755615338). The SQLSTATE reader and the commit's
# exit mapping are named helpers, so `journal --write-id` reads errors the
# same way.

#: contracts/exit-codes.md §1's names for the two codes `register commit` is
#: the first subcommand to exit with: a write in doubt, and a lost turn.
EXIT_IN_DOUBT = 3
EXIT_BUSY = 75


class RegisterError:
    """One refusal the database returned, as contract §2.6 reads it.

    `sqlstate` and `message` come from `psql`'s `ERROR:  <SQLSTATE>: <message>`
    line (VERBOSITY=verbose, Y:2590). `detail` is the `DETAIL:  <token>` line's
    token, or "". `error_line` and `detail_line` are those two lines verbatim,
    which the command writes as its own first two stderr lines."""

    __slots__ = ("sqlstate", "message", "error_line", "detail", "detail_line")

    def __init__(self, sqlstate: str, message: str, error_line: str, detail: str = "",
                 detail_line: str = ""):
        self.sqlstate = sqlstate
        self.message = message
        self.error_line = error_line
        self.detail = detail
        self.detail_line = detail_line


_REGISTER_ERROR_LINE_RE = re.compile(r"ERROR:  ([0-9A-Z]{5}): (.*)")
_REGISTER_DETAIL_LINE_RE = re.compile(r"DETAIL:  (.*)")
#: The location `psql` puts before a message read from a FILE (`-f`, `\i`),
#: `psql:<file>:<line>: `. Stdin gets none (Y:2590); it is passed over all
#: the same, so a register call never reads a refusal as in doubt for it.
_REGISTER_PSQL_WHERE_RE = re.compile(r"psql:.*?:[0-9]+: ")


def register_error_of(stderr: str) -> RegisterError | None:
    """`psql`'s stderr, read as contract §2.6 reads it: the first line opening
    `ERROR:` is the refusal, and its SQLSTATE is the five characters after
    `ERROR:  `. Its `DETAIL:` line is the first one after it, before any other
    `ERROR:`, `FATAL:` or `PANIC:`. The `LOCATION:` line is never read.

    A `NOTICE:` or `WARNING:` line before the error is passed over, since a
    notice raised first would be stderr's first line (T106's report). None
    where no `ERROR:` line is there, or where the first one names no
    SQLSTATE."""
    lines = stderr.splitlines()
    bodies = [_REGISTER_PSQL_WHERE_RE.sub("", line, count=1)
              if _REGISTER_PSQL_WHERE_RE.match(line) else line for line in lines]
    for i, line in enumerate(lines):
        if not bodies[i].startswith("ERROR:"):
            continue
        match = _REGISTER_ERROR_LINE_RE.fullmatch(bodies[i])
        if not match:
            return None
        detail = detail_line = ""
        for j in range(i + 1, len(lines)):
            after = bodies[j]
            if after.startswith(("ERROR:", "FATAL:", "PANIC:")):
                break
            found = _REGISTER_DETAIL_LINE_RE.fullmatch(after)
            if found:
                detail, detail_line = found.group(1).strip(), lines[j]
                break
        return RegisterError(match.group(1), match.group(2), line, detail, detail_line)
    return None


def register_definitive_error(failure: PsqlFailed) -> RegisterError | None:
    """The refusal of a register call that ENDED DEFINITIVELY: `psql`'s exit
    3, a statement that failed under ON_ERROR_STOP, with a SQLSTATE that can
    be read (Y:2618, "A `psql` exit 3 is never in doubt").

    None for every other end: a call never sent, exit 1 or 2, a signal, the
    timer, an exit 0 whose answer cannot be read, or an exit 3 that names no
    SQLSTATE. A commit call reads each of those, once sent, as in doubt
    (contract §2.2's [D, R01]; CO-6)."""
    if not failure.ran or failure.timer_expired or failure.psql_exit != 3:
        return None
    return register_error_of(failure.stderr)


#: `register commit`'s code for each SQLSTATE under `psql`'s exit 3 (contract
#: §3.3's table; Y:1555-1569 and Y:2601-2616). LR006 is 0, with `already
#: <seq>`. LR004 is 69 after one re-read of the bases from SQL, and is never
#: sent again (R02; lane 3, #165 6755615338): `_register_commit_lr004` makes
#: it 75 instead where that re-read finds the head moved. Every SQLSTATE not
#: named here, a 23505 or a 23514 included, is 69.
REGISTER_COMMIT_EXITS = {
    "LR001": EXIT_BUSY, "40001": EXIT_BUSY, "40P01": EXIT_BUSY, "55P03": EXIT_BUSY,
    "LR008": EXIT_BUSY,
    "LR005": EXIT_REFUSED, "LR007": EXIT_REFUSED, "LR009": EXIT_REFUSED,
    "LR010": EXIT_REFUSED,
    "LR006": EXIT_OK,
    "LR002": EXIT_UNAVAILABLE, "LR003": EXIT_UNAVAILABLE, "LR004": EXIT_UNAVAILABLE,
}


def register_commit_exit(failure: PsqlFailed) -> tuple[int, RegisterError | None]:
    """The code a `register commit` call that did not answer ends with, and
    the refusal it rests on (CO-6):

    - 69 and None where nothing was sent (`ran` False: no `psql`, one too old,
      or the timer spent before it);
    - `REGISTER_COMMIT_EXITS`' code and the refusal, under exit 3 with a
      SQLSTATE, any other SQLSTATE being 69;
    - 3, in doubt, and None for every other end."""
    if not failure.ran:
        return EXIT_UNAVAILABLE, None
    err = register_definitive_error(failure)
    if err is None:
        return EXIT_IN_DOUBT, None
    return REGISTER_COMMIT_EXITS.get(err.sqlstate, EXIT_UNAVAILABLE), err


def register_say_error(err: RegisterError | None) -> None:
    """Contract §2.6's first two stderr lines: the `ERROR:` line, then its
    `DETAIL:` line where it has one, each verbatim. Every line after them is
    the command's own, through `note`."""
    if err is None:
        return
    sys.stderr.write(err.error_line + "\n")
    if err.detail_line:
        sys.stderr.write(err.detail_line + "\n")
    sys.stderr.flush()


def register_psql_end(failure: PsqlFailed) -> str:
    """How a register call's `psql` ended, in words, for a note: never a URL
    or a password (contract §2.6). `psql`'s own first line is kept, as it
    names a host at most."""
    if not failure.ran:
        return f"was never sent ({failure.detail})"
    if failure.timer_expired:
        return f"was cut by its client timer ({failure.detail})"
    if failure.psql_exit is None:
        return "ended with no exit status"
    if failure.psql_exit < 0:
        return f"was ended by signal {-failure.psql_exit}"
    if failure.psql_exit == 0:
        return f"exited 0 with an answer {PROG} cannot read ({failure.detail})"
    first = failure.first_line.strip()
    return f"exited {failure.psql_exit}" + (f": {first}" if first else "")


#: The paths a write may stage (contract §3.3; Y:5060, the seam's path check,
#: again): the render set, as `journal_edits`' and `files`' CHECKs name it,
#: less `lanes/STORE`, which only the two operator entries edit (D24). Like
#: those CHECKs, whose `[^/]+` admits every character but `/`, the pattern
#: takes any character in a file name. A path holding a control character,
#: U+0085, U+2028 or U+2029 is refused beside it, by
#: `register_path_unrenderable` (`_RENDER_CONTROL_RE`), and not by narrowing
#: the pattern, so the pattern stays the CHECKs' mirror and the refusal can say
#: why (line R, opensoft/openRepoTools#165 6783185080).
REGISTER_WRITE_PATH_RE = re.compile(
    r"lanes/(LANES\.md|aliases\.tsv|archive/[^/]+\.md|log/[^/]+\.md)")
#: Where a rename may move a file: `journal_edits.to_path`'s CHECK.
REGISTER_RENAME_TO_RE = re.compile(r"lanes/(archive|log)/[^/]+\.md")
REGISTER_LOG_README = "lanes/log/README.md"
REGISTER_ARCHIVE_PREFIX = "lanes/archive/"
REGISTER_REPOS_PATH = "lanes/repos.tsv"
_REGISTER_BLOB_RE = re.compile(r"[0-9a-f]{40}")
_REGISTER_ZERO_BLOB = "0" * 40
_REGISTER_SHA256_RE = re.compile(r"[0-9a-f]{64}")
_REGISTER_UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
_REGISTER_WORD_RE = re.compile(r"[^\s\x00-\x1f\x7f]+")
_REGISTER_AUTHOR_RE = re.compile(r"[^<>\n]+ <[^<>\n]*>")
#: An act's base seq (Y:5577): 1 to 18 digits, no leading zero but `0`.
_REGISTER_ACT_SEQ_RE = re.compile(r"0|[1-9][0-9]{0,17}")
#: An act's id, as `journal.act_id`'s CHECK takes it: no `@` and no white space.
_REGISTER_ACT_ID_RE = re.compile(r"[^@\s]+")
#: One of `LANES_EXPECT`'s six forms, read in lower case (Y:5581-5587): a
#: lane name as `check_lane_name` takes it, or a session uuid.
_REGISTER_SCOPE_RE = re.compile(
    r"(row|bind|objects|alias|archive):[a-z0-9_][a-z0-9._-]*"
    r"|sid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
#: The holds that D19 compares spellings for (`commit_write`'s step 7).
_REGISTER_CLAIM_VERBS = ("CLAIMED", "TAKEOVER")
#: The LR005 tokens whose refusal names a holder line on stdout (contract §3.3).
_REGISTER_HOLDER_TOKENS = ("main-held", "one-live-claim", "claim-spellings")
#: ASCII's upper case to lower, as PostgreSQL's `lower()` under COLLATE "C"
#: maps it, which is `lanes.lane_key`'s CHECK.
_REGISTER_ASCII_LOWER = {code: code + 32 for code in range(65, 91)}

_REGISTER_COMMIT_USAGE = (
    f"{PROG} register commit --write-id <uuid> --generation <uuid> --lane <lane> "
    f"--verb <verb> --args-sha256 <hex> --workstation <name> <attempt dir>")
_REGISTER_COMMIT_FLAGS = ("--write-id", "--generation", "--lane", "--verb", "--args-sha256",
                          "--workstation")


class RegisterAttemptRefused(Refusal):
    """A malformed attempt directory, or one whose files disagree among
    themselves (contract §3.3): 2, and nothing was sent. Like the seam's own
    (Y:5078), it is an internal error."""

    def __init__(self, what: str):
        super().__init__(f"attempt directory: {what}; nothing was sent")


def _register_lower(text: str) -> str:
    return text.translate(_REGISTER_ASCII_LOWER)


def register_epoch_utc(epoch: int) -> str:
    """Whole epoch seconds as the UTC text the entry's times take,
    `YYYY-MM-DDTHH:MM:SSZ`, which `::timestamptz` reads."""
    return _dt.datetime.fromtimestamp(epoch, _dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _register_utc_ts(utc: str | None) -> str | None:
    """A line's UTC as a structured row's `utc_ts`: NULL where it cannot be a
    time, never a value filled in (Y:5116)."""
    epoch = register_utc_epoch(utc)
    return None if epoch is None else register_epoch_utc(epoch)


def register_doc_lines(text: str) -> tuple[list[str], bool]:
    """A file's text as `doc_lines` holds it (`render_file`, §1.2): its lines,
    cut at LF, and whether it ends with one. An empty file has no lines, and
    renders as nothing whatever `final_newline` says."""
    if text == "":
        return [], True
    if text.endswith("\n"):
        return text[:-1].split("\n"), True
    return text.split("\n"), False


def register_line_edits(old: list[str], new: list[str]) -> tuple[list[tuple], list[int]]:
    """The line edits that turn `old` into `new`, in `commit_write`'s ops
    (step 6): `replace` and `delete` at a line number in the image the edits
    before it left, each checked by its old text, and `append` at the end.

    Lines kept are never written, so their `line_id`, their `written_seq` and
    their structured rows stand. There is no insert: a line added before the
    end is written by replacing each later line that then differs, and
    appending the rest. Each op is (op, line_no, old text or None, new text or
    None). The second value is every line number, in `new`, that an `append`
    or a `replace` wrote."""
    import difflib
    ops: list[tuple] = []
    written: list[int] = []
    p = 0
    while p < len(old) and p < len(new) and old[p] == new[p]:
        p += 1
    s = 0
    while s < len(old) - p and s < len(new) - p and old[-1 - s] == new[-1 - s]:
        s += 1
    old_mid, new_mid = old[p:len(old) - s], new[p:len(new) - s]
    pos = p + 1
    matcher = difflib.SequenceMatcher(None, old_mid, new_mid, autojunk=False)
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag == "equal":
            pos += i2 - i1
            continue
        k = min(i2 - i1, j2 - j1)
        for t in range(k):
            ops.append(("replace", pos, old_mid[i1 + t], new_mid[j1 + t]))
            written.append(pos)
            pos += 1
        for t in range(k, i2 - i1):
            ops.append(("delete", pos, old_mid[i1 + t], None))
        if j2 - j1 <= k:
            continue
        if i2 == len(old_mid) and s == 0:
            for text in new_mid[j1 + k:j2]:
                ops.append(("append", pos, None, text))
                written.append(pos)
                pos += 1
            continue
        # A LINE ADDED BEFORE THE END: the rest is rewritten, line by line.
        rest_old = old_mid[i2:] + old[len(old) - s:]
        rest_new = new_mid[j1 + k:] + new[len(new) - s:]
        for t in range(min(len(rest_old), len(rest_new))):
            if rest_old[t] != rest_new[t]:
                ops.append(("replace", pos, rest_old[t], rest_new[t]))
                written.append(pos)
            pos += 1
        for t in range(len(rest_new), len(rest_old)):
            ops.append(("delete", pos, rest_old[t], None))
        for text in rest_new[len(rest_old):]:
            ops.append(("append", pos, None, text))
            written.append(pos)
            pos += 1
        break
    return ops, written


def register_act_of_env(act: str, expect: str) -> dict | None:
    """`LANES_ACT` and `LANES_EXPECT`, checked again before `psql`, as
    `lanes-edit.sh` checks them before the first snapshot (Y:5597-5601). Each
    refusal is 2, names the variable, and sends nothing:

    1. `LANES_ACT` is malformed: not `<act-id>@<seq>:<generation>` or
       `<act-id>@files`;
    2. `LANES_EXPECT` is not empty and `LANES_ACT` is unset or empty;
    3. a scope is outside the six forms, `*` included;
    4. the base is `files`, taken off primary.

    Returns the entry's `act`, `{id, base, generation, expect}` with the
    scopes in lower case in the order given, or None outside an act."""
    tokens = expect.split()
    act_id = seq = generation = ""
    if act:
        act_id, at, rest = act.partition("@")
        if rest != "files":
            seq, colon, generation = rest.partition(":")
        if (not at or not _REGISTER_ACT_ID_RE.fullmatch(act_id)
                or (rest != "files" and (not colon or not _REGISTER_ACT_SEQ_RE.fullmatch(seq)
                                         or not _REGISTER_UUID_RE.fullmatch(generation)))):
            raise Refusal(f"LANES_ACT is {act!r}, which is not <act-id>@<seq>:<generation> or "
                          f"<act-id>@files (the act's id, its base seq, and the register "
                          f"generation in lower case). Nothing was sent.")
    elif tokens:
        raise Refusal("LANES_EXPECT names scopes and LANES_ACT is unset or empty: an "
                      "expectation is checked against an act's base, so these scopes would "
                      "go unchecked. Run the write inside its act. Nothing was sent.")
    for token in tokens:
        if not _REGISTER_SCOPE_RE.fullmatch(_register_lower(token)):
            raise Refusal(f'LANES_EXPECT carries "{token}", which is not row:, bind:, '
                          f"objects:, alias: or archive: and a lane name, or sid: and a "
                          f"session uuid. Nothing was sent.")
    if not act:
        return None
    if not seq:
        raise Refusal(f"LANES_ACT was taken off primary (`{act}`) and this write runs on "
                      f"primary: run the act again from its start. Nothing was sent.")
    return {"id": act_id, "base": int(seq), "generation": generation,
            "expect": [_register_lower(token) for token in tokens]}


def _register_attempt_read(directory: str, name: str, *, optional: bool = False) -> bytes | None:
    path = os.path.join(directory, name)
    if not os.path.isfile(path):
        if optional and not os.path.lexists(path):
            return None
        raise RegisterAttemptRefused(f"{name} is missing, or is not a regular file")
    try:
        with open(path, "rb") as handle:
            return handle.read()
    except OSError as exc:
        raise RegisterAttemptRefused(f"{name} cannot be read ({exc.strerror or exc})")


def _register_attempt_text(directory: str, name: str, data: bytes) -> str:
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        raise RegisterAttemptRefused(f"{name} is not UTF-8")


def _register_attempt_lines(text: str, name: str) -> list[str]:
    """A file of LF-ended lines: every line, the empty last piece dropped. An
    empty line anywhere else is malformed."""
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    for number, line in enumerate(lines, 1):
        if line == "":
            raise RegisterAttemptRefused(f"{name} line {number} is empty")
    return lines


def register_attempt_snapshot(text: str) -> dict:
    """The `snapshot` file, contract §3.2's stdout verbatim: one `key=value`
    per line, read by key. `file=` rows may repeat and are not read here; a
    key it does not know is passed over (§5)."""
    values: dict = {}
    for number, line in enumerate(_register_attempt_lines(text, "snapshot"), 1):
        key, eq, value = line.partition("=")
        if not eq or not key:
            raise RegisterAttemptRefused(f"snapshot line {number} is not key=value")
        if key == "file":
            continue
        if key in values:
            raise RegisterAttemptRefused(f"snapshot names {key}= twice")
        values[key] = value
    return values


def _register_act_file(text: str) -> dict:
    """The attempt directory's `act` file (contract §3.3): `id=`, `base=` and
    `generation=` once each, and one `expect=<scope>` per scope, possibly
    none. Read by `register_act_of_env`'s grammar."""
    fields: dict = {"expect": []}
    for number, line in enumerate(_register_attempt_lines(text, "act"), 1):
        key, eq, value = line.partition("=")
        if not eq or key not in ("id", "base", "generation", "expect"):
            raise RegisterAttemptRefused(f"act line {number} is not id=, base=, generation= "
                                         f"or expect=")
        if key == "expect":
            fields["expect"].append(value)
        elif key in fields:
            raise RegisterAttemptRefused(f"act names {key}= twice")
        else:
            fields[key] = value
    for key in ("id", "base", "generation"):
        if key not in fields:
            raise RegisterAttemptRefused(f"act has no {key}=")
    act_text = f"{fields['id']}@{fields['base']}"
    if fields["base"] != "files":
        act_text += f":{fields['generation']}"
    try:
        act = register_act_of_env(act_text, " ".join(fields["expect"]))
    except Refusal as exc:
        why = str(exc).replace(" Nothing was sent.", "")
        raise RegisterAttemptRefused(f"act is malformed: {why}")
    if act is None or any(len(value.split()) != 1 or value != value.strip()
                          for value in fields["expect"]):
        raise RegisterAttemptRefused("act is malformed: its scopes are one per expect= line")
    return act


def _register_blob_id(data: bytes) -> str:
    """The git blob id of `data`, as `git hash-object` gives it (SHA-1)."""
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


def register_files_rows(changes: dict, images: dict) -> bytes:
    """The canonical rows of contract §3.2 for every path in `changes.tsv`,
    as the write leaves it: `<path>` TAB `1` or `0` TAB the sha256 or `-`,
    sorted bytewise, each LF-ended. The `files` file must be exactly these."""
    rows = []
    for path in sorted(changes, key=lambda p: p.encode("utf-8")):
        if changes[path][0] == "D":
            rows.append(f"{path}\t0\t-\n")
        else:
            rows.append(f"{path}\t1\t{hashlib.sha256(images[path]).hexdigest()}\n")
    return "".join(rows).encode("utf-8")


def register_path_unrenderable(path: str, where: str) -> str | None:
    """Why `path`, staged or renamed in an attempt directory, cannot be
    written, or None (line R, lane 3's assignment, opensoft/openRepoTools#165
    6783185080; the characters, lane 5's NIT 3, 6779760684): it holds a
    character `_RENDER_CONTROL_RE` matches, a control character, U+0085,
    U+2028 or U+2029. No render of the register can write such a path as one
    `file=` row, and `register_write_images` and `register read` refuse it, so
    a write that stored it would leave a seq that nothing could render. The
    path is named with `!r`, so each such character shows as an escape.
    `where` opens the refusal, and names the file and the path's place in it."""
    if not _RENDER_CONTROL_RE.search(path):
        return None
    return (f"{where} {path!r}, which holds a control character, U+0085, U+2028 or U+2029, "
            f"so no render of the register can write its image as one file= row, and the "
            f"register stores no such path")


#: GIT'S SCISSORS LINE: the comment string, one space and wt-status.c's
#: `cut_line`, alone on its line, as `git commit --cleanup=scissors` writes it
#: and as `wt_status_locate_end` finds it at the message's start or after any
#: LF. git reads no trailer from that line on, so `%(trailers)` never reaches
#: a `Register-Seq` appended after it. The comment string is `#` unless
#: `core.commentChar` names another, so any prefix without white space counts.
_REGISTER_SCISSORS_RE = re.compile(r"[^\s]+ -{24} >8 -{24}")
#: A trailer line as git's `%(trailers)` reads one: a token of letters,
#: digits and `-` (F29, Y:5964), then any blanks, then the `:` separator.
_REGISTER_TRAILER_LINE_RE = re.compile(r"([A-Za-z0-9-]+)[ \t]*:")


def register_message_unrenderable(message: str) -> str | None:
    """Why `message` cannot be a render commit's message, or None (B13, lane
    3's ruling on `register commit`, opensoft/openRepoTools#165 6779518728:
    "`register commit` refuses with 2, before it journals, a message holding
    a scissors line or whose final trailer block already holds a
    `Register-Seq`"; render-commit.md §1). The render appends `Register-Seq:
    <k>` to the message's final trailer block, or after one blank line as a
    new last paragraph, and form C must read `<k>` back alone.

    1. A SCISSORS LINE (`_REGISTER_SCISSORS_RE`) anywhere, the subject
       included: git reads no trailer after it, so form C reads nothing.
    2. A `Register-Seq` ALREADY IN THE FINAL TRAILER BLOCK: form C would read
       two values. The final trailer block is the message's last paragraph,
       its trailing blank lines dropped, where that paragraph is not the
       first, which git reads as the title ("A subject alone never counts as
       trailers", Y:5965), and where every line of it is a trailer line
       (`_REGISTER_TRAILER_LINE_RE`) or a continuation, which begins with a
       blank. A paragraph is ended by a line of blanks alone, as git's
       `is_blank_line` reads one. The token is matched in any case, as
       `%(trailers:key=Register-Seq)` matches it.

    A `Register-Seq` anywhere else is passed: the render starts a new last
    paragraph, which form C reads alone."""
    lines = message.split("\n")
    for number, line in enumerate(lines, 1):
        if _REGISTER_SCISSORS_RE.fullmatch(line):
            return (f"msg line {number} is a scissors line, git's cut line "
                    f"`{'-' * 24} >8 {'-' * 24}` after a comment character (`#` by default), "
                    f"after which git reads no trailer, so form C could never read this "
                    f"write's Register-Seq from its render commit (render-commit.md §1)")
    blank = [line.strip(" \t") == "" for line in lines]
    end = len(lines)
    while end and blank[end - 1]:
        end -= 1
    title_end = next((at for at in range(end) if blank[at]), end)
    start = end
    while start > title_end and not blank[start - 1]:
        start -= 1
    if start <= title_end:
        return None
    block = lines[start:end]
    if not all(_REGISTER_TRAILER_LINE_RE.match(line) or (at and line[:1] in (" ", "\t"))
               for at, line in enumerate(block)):
        return None
    for at, line in enumerate(block):
        match = _REGISTER_TRAILER_LINE_RE.match(line)
        if match and match.group(1).lower() == "register-seq":
            return (f"msg's final trailer block already holds a Register-Seq, at its line "
                    f"{start + at + 1}, so its render commit would carry two and form C would "
                    f"not read this write's seq alone (render-commit.md §1)")
    return None


def read_attempt_dir(directory: str, ident: dict, env_act: dict | None) -> dict:
    """The attempt directory `register commit` takes as its argument (contract
    §3.3): only the names its table lists are read (CO-1), and each check that
    fails is `RegisterAttemptRefused`, 2, before anything is sent.

    Returns `n`, `repos_blob`, `not_after`, `message`, `author`, `act`,
    `changes` (path to (status, base blob, new blob)), `renames` (from to to),
    `images` (path to bytes), `tree` (the scratch tree's directory),
    `tree_blobs` (each path under `lanes/` at its HEAD, which is `n`) and
    `tree_bases` (each changed path's base bytes there)."""
    if not os.path.isdir(directory):
        raise RegisterAttemptRefused(f"{directory} is not a directory")
    read = functools.partial(_register_attempt_read, directory)
    text = functools.partial(_register_attempt_text, directory)

    # THE SNAPSHOT, AND THE FLAGS AGAINST IT.
    snap = register_attempt_snapshot(text("snapshot", read("snapshot")))
    if snap.get("format") != "1":
        raise RegisterAttemptRefused(f"snapshot is format={snap.get('format', '')}, and this "
                                     f"build reads format=1")
    for key, flag in (("generation", "--generation"), ("write_id", "--write-id")):
        if _register_lower(snap.get(key, "")) != ident[key]:
            raise RegisterAttemptRefused(
                f"the flags differ from snapshot: {flag} is {ident[key]}, and snapshot's "
                f"{key}= is {snap.get(key, '(absent)')}")
    n_text = snap.get("n", "")
    if not re.fullmatch(r"-1|0|[1-9][0-9]{0,17}", n_text):
        raise RegisterAttemptRefused(f"snapshot's n= is {n_text!r}, not a seq")
    repos_blob = snap.get("repos_blob")
    if repos_blob is not None and not _REGISTER_BLOB_RE.fullmatch(repos_blob):
        raise RegisterAttemptRefused(f"snapshot's repos_blob= is {repos_blob!r}, not 40 hex")
    after_text = _register_attempt_lines(text("not_after", read("not_after")), "not_after")
    if len(after_text) != 1 or not re.fullmatch(r"[0-9]{1,11}", after_text[0]):
        raise RegisterAttemptRefused("not_after is not one line of epoch seconds")
    if snap.get("not_after") != after_text[0]:
        raise RegisterAttemptRefused(f"not_after is {after_text[0]}, and snapshot's "
                                     f"not_after= is {snap.get('not_after', '(absent)')}")

    # THE CHANGES, THE RENAMES AND THE IMAGES.
    changes: dict = {}
    for number, line in enumerate(_register_attempt_lines(text("changes.tsv",
                                                               read("changes.tsv")),
                                                          "changes.tsv"), 1):
        parts = line.split("\t")
        if len(parts) != 4:
            raise RegisterAttemptRefused(f"changes.tsv line {number} is not four tab-separated "
                                         f"fields")
        status, path, base, new = parts
        if status not in ("A", "M", "D"):
            raise RegisterAttemptRefused(f"changes.tsv line {number}'s status is {status!r}, "
                                         f"not A, M or D")
        if not REGISTER_WRITE_PATH_RE.fullmatch(path) or path == REGISTER_LOG_README:
            raise RegisterAttemptRefused(
                f"changes.tsv stages {path!r}, which is outside the render set: lanes/LANES.md, "
                f"lanes/aliases.tsv, lanes/archive/*.md and lanes/log/<lane>.md")
        unrenderable = register_path_unrenderable(path, "changes.tsv stages")
        if unrenderable:
            raise RegisterAttemptRefused(unrenderable)
        if path in changes:
            raise RegisterAttemptRefused(f"changes.tsv names {path} twice")
        if not _REGISTER_BLOB_RE.fullmatch(base) or not _REGISTER_BLOB_RE.fullmatch(new):
            raise RegisterAttemptRefused(f"changes.tsv line {number}'s blob ids are not 40 "
                                         f"lower-case hex each")
        if (base == _REGISTER_ZERO_BLOB) != (status == "A") or \
                (new == _REGISTER_ZERO_BLOB) != (status == "D"):
            raise RegisterAttemptRefused(f"changes.tsv line {number}: an {status} line's "
                                         f"missing side, and only it, is 40 zeros")
        changes[path] = (status, base, new)
    renames: dict = {}
    raw = read("renames.tsv", optional=True)
    if raw is not None:
        targets: set = set()
        for number, line in enumerate(_register_attempt_lines(text("renames.tsv", raw),
                                                              "renames.tsv"), 1):
            parts = line.split("\t")
            if len(parts) != 2:
                raise RegisterAttemptRefused(f"renames.tsv line {number} is not <from> TAB <to>")
            frm, to = parts
            for side, moved in (("<from>", frm), ("<to>", to)):
                unrenderable = register_path_unrenderable(
                    moved, f"renames.tsv line {number}'s {side} is")
                if unrenderable:
                    raise RegisterAttemptRefused(unrenderable)
            if changes.get(frm, ("",))[0] != "D" or changes.get(to, ("",))[0] != "A":
                raise RegisterAttemptRefused(f"renames.tsv line {number}: {frm} must be a D line "
                                             f"and {to} an A line in changes.tsv")
            if not REGISTER_RENAME_TO_RE.fullmatch(to):
                raise RegisterAttemptRefused(f"renames.tsv moves {frm} to {to}, and a rename "
                                             f"stays in lanes/archive/ or lanes/log/")
            if frm in renames or to in targets:
                raise RegisterAttemptRefused(f"renames.tsv names {frm if frm in renames else to} "
                                             f"twice")
            renames[frm] = to
            targets.add(to)
    images: dict = {}
    root = os.path.join(directory, "images")
    if os.path.lexists(root) and not os.path.isdir(root):
        raise RegisterAttemptRefused("images is not a directory")
    if os.path.isdir(root):
        for here, dirs, names in os.walk(root, followlinks=False):
            for name in dirs + names:
                full = os.path.join(here, name)
                rel = os.path.relpath(full, root).replace(os.sep, "/")
                mode = os.lstat(full).st_mode
                if stat.S_ISDIR(mode):
                    continue
                if not stat.S_ISREG(mode):
                    raise RegisterAttemptRefused(f"images/{rel} is not a regular file")
                if changes.get(rel, ("",))[0] not in ("A", "M"):
                    raise RegisterAttemptRefused(f"images/{rel} has no A or M line in "
                                                 f"changes.tsv")
                images[rel] = read(os.path.join("images", rel))
    for path, (status, _base, new) in changes.items():
        if status == "D":
            continue
        if path not in images:
            raise RegisterAttemptRefused(f"images/{path} is missing")
        data = images[path]
        if _register_blob_id(data) != new:
            raise RegisterAttemptRefused(f"images/{path} is not the new blob changes.tsv names "
                                         f"({new})")
        try:
            image = data.decode("utf-8")
        except UnicodeDecodeError:
            raise RegisterAttemptRefused(f"images/{path} is not UTF-8, and the register holds "
                                         f"text")
        for bad, why in (("\r", "a carriage return"), ("\0", "a NUL")):
            if bad in image:
                number = image[:image.index(bad)].count("\n") + 1
                raise RegisterAttemptRefused(f"images/{path} line {number} holds {why}, which "
                                             f"no line of the register can hold")

    # THE FILES: recomputed from images/, and refused on any difference.
    files = read("files")
    listed: dict = {}
    for number, line in enumerate(_register_attempt_lines(text("files", files), "files"), 1):
        parts = line.split("\t")
        if len(parts) != 3:
            raise RegisterAttemptRefused(f"files line {number} is not <path> TAB <present> TAB "
                                         f"<sha256>")
        listed[parts[0]] = parts
    for path in changes:
        if path not in listed:
            raise RegisterAttemptRefused(f"{path} is in changes.tsv and has no files row")
    for path in listed:
        if path not in changes:
            raise RegisterAttemptRefused(f"files has a row for {path}, which has no changes.tsv "
                                         f"line")
    if files != register_files_rows(changes, images):
        wrong = sorted(path for path in changes
                       if "\t".join(listed[path]) + "\n" !=
                       register_files_rows({path: changes[path]}, images).decode("utf-8"))
        raise RegisterAttemptRefused(
            "files differs from the rows lanes-index recomputes from images/"
            + (f": {', '.join(wrong)}" if wrong else ", in its order or its line ends"))

    # THE MESSAGE, THE AUTHOR AND THE ACT.
    message = text("msg", read("msg"))
    if message == "" or "\r" in message or "\0" in message:
        raise RegisterAttemptRefused("msg is empty, or holds a carriage return or a NUL, which "
                                     "journal.message cannot hold")
    # A MESSAGE NO RENDER COMMIT CAN CARRY: refused here, before the store is
    # opened and so before anything is journaled (B13, #165 6779518728).
    unrenderable = register_message_unrenderable(message)
    if unrenderable:
        raise RegisterAttemptRefused(unrenderable)
    author = text("author", read("author"))
    author = author[:-1] if author.endswith("\n") else author
    if not _REGISTER_AUTHOR_RE.fullmatch(author):
        raise RegisterAttemptRefused("author is not one line `Name <email>`")
    raw = read("act", optional=True)
    act = _register_act_file(text("act", raw)) if raw is not None else None
    if env_act is not None and act != env_act:
        raise RegisterAttemptRefused(
            "act is missing, and LANES_ACT names an act" if act is None else
            "act disagrees with LANES_ACT and LANES_EXPECT, checked again before psql")

    # THE SCRATCH TREE AT n: each path's base, and repos.tsv's blob.
    tree = os.path.join(directory, "tree")
    try:
        if not os.path.isdir(tree):
            raise StoreUnusable("unread", "it is not a directory")
        git(tree, "rev-parse", "--verify", "-q", "HEAD^{commit}")
        listing = git(tree, "ls-tree", "-r", "-z", "HEAD", "--", "lanes").stdout
    except StoreUnusable as exc:
        raise RegisterAttemptRefused(f"tree/ is not the scratch tree --tree built ({exc.detail})")
    tree_blobs: dict = {}
    for item in listing.split("\0"):
        meta, tab, path = item.partition("\t")
        fields = meta.split()
        if tab and len(fields) == 3 and fields[1] == "blob":
            tree_blobs[path] = fields[2]
    for path, (status, base, _new) in changes.items():
        if status == "A" and path in tree_blobs:
            raise RegisterAttemptRefused(f"changes.tsv adds {path}, which tree/ has at HEAD")
        if status != "A" and tree_blobs.get(path) != base:
            raise RegisterAttemptRefused(f"changes.tsv's base blob of {path}, {base}, is not "
                                         f"tree/'s at HEAD")
    if repos_blob != tree_blobs.get(REGISTER_REPOS_PATH):
        raise RegisterAttemptRefused(
            f"snapshot's repos_blob= is {repos_blob or '(absent)'}, and tree/'s "
            f"{REGISTER_REPOS_PATH} is {tree_blobs.get(REGISTER_REPOS_PATH, '(absent)')}")
    try:
        blobs = cat_blobs(tree, [base for status, base, _new in changes.values() if status != "A"])
    except StoreUnusable as exc:
        raise RegisterAttemptRefused(f"tree/'s bases cannot be read ({exc.detail})")
    tree_bases: dict = {}
    for path, (status, base, _new) in changes.items():
        if status == "A":
            continue
        if base not in blobs:
            raise RegisterAttemptRefused(f"tree/ cannot give {path}'s base blob {base}")
        try:
            blobs[base].decode("utf-8")
        except UnicodeDecodeError:
            raise RegisterAttemptRefused(f"tree/'s {path} is not UTF-8")
        tree_bases[path] = blobs[base]
    return {"directory": directory, "n": int(n_text), "repos_blob": repos_blob,
            "not_after": int(after_text[0]), "message": message, "author": author,
            "act": act, "changes": changes, "renames": renames, "images": images,
            "tree": tree, "tree_blobs": tree_blobs, "tree_bases": tree_bases}


class RegisterView:
    """The render set at `n` and after this write: the scratch tree at HEAD,
    with the attempt's changes over it. `bases` holds each changed path's base
    bytes, `tree/`'s.

    It records what the entry read of `tree/`, which is what LR004's re-read
    compares with SQL (R02; lane 3, #165 6755386771 and 6755615338): `read`,
    every path whose text at `n` it read, or found absent; and `listed`,
    every prefix whose paths at `n` it listed. A changed path's base is read
    through `before` like any other."""

    def __init__(self, att: dict, bases: dict):
        self.att = att
        self.bases = bases
        self._texts: dict = {}
        self._raw: dict = {}
        self.read: set = set()
        self.listed: set = set()

    def load(self, paths) -> None:
        """Read the tree's copies of `paths` in one `git cat-file --batch`."""
        want = [p for p in paths if p not in self._texts and p in self.att["tree_blobs"]]
        if not want:
            return
        blobs = cat_blobs(self.att["tree"], [self.att["tree_blobs"][p] for p in want])
        for path in want:
            self._raw[path] = blobs.get(self.att["tree_blobs"][path], b"")
            self._texts[path] = _decode(self._raw[path])

    def tree_bytes(self, path: str) -> bytes | None:
        """`path`'s bytes in `tree/` at `n`, or None where it is absent there:
        what LR004's re-read compares with SQL's."""
        change = self.att["changes"].get(path)
        if change:
            return None if change[0] == "A" else self.bases[path]
        if path not in self.att["tree_blobs"]:
            return None
        self.load([path])
        return self._raw[path]

    def before(self, path: str) -> str | None:
        self.read.add(path)
        change = self.att["changes"].get(path)
        if change:
            return None if change[0] == "A" else self.bases[path].decode("utf-8")
        if path not in self.att["tree_blobs"]:
            return None
        self.load([path])
        return self._texts[path]

    def after(self, path: str) -> str | None:
        change = self.att["changes"].get(path)
        if change:
            return None if change[0] == "D" else self.att["images"][path].decode("utf-8")
        return self.before(path)

    def paths(self, prefix: str, side: str) -> list[str]:
        """The paths under `prefix` on one side, `before` or `after`, sorted
        bytewise, as `ls-tree` and COLLATE "C" order them."""
        self.listed.add(prefix)
        found = {p for p in self.att["tree_blobs"] if p.startswith(prefix)}
        if side == "after":
            for path, (status, _b, _n) in self.att["changes"].items():
                if path.startswith(prefix):
                    (found.discard if status == "D" else found.add)(path)
        return sorted(found, key=lambda p: p.encode("utf-8"))


# ----- THE DERIVATION HELPERS: ONE SET, T112'S AND T115'S (lane 3's reading 7,
# #165 6755386771; ERR-49). `register commit` and `import --at` derive every
# structured row through these and through nothing else, so a line a write
# stores and the same line an import stores give the same row. The set:
#   - `repo_key`: `register_repo_key`, over `register_repo_table` built in Rule
#     6's order - the shipped table (`register_shipped_repos_text`), then the
#     per-wip one, the last row winning - as `rule6_aliases` reads them
#     (`lanes-edit.sh:6938` at code `39839dc`);
#   - the spellings: `register_repo_spellings`, D18's, on a slot line, and
#     `register_object_spellings`, D19's, on a CLAIMED or TAKEOVER hold only
#     (Y:1231), each over that same table;
#   - the holds: `_register_last_hold`, each lane's last readable line on an
#     object, for an object `register_hold_object` takes, never a `lane:` one
#     (#160's holders, `lanes-index:1594`);
#   - `register_lines`' kinds: `_register_slot_row`, only for a line the one
#     classifier reads as a kind, since nothing reads a row with no kind, and
#     with no slot role where `RULE6_AWK` could not pair the line; and
#     `register_slot_rows`, THE WALK, which pairs a `LANDED` that names its
#     lane and PR and no repository as `RULE6_AWK` pairs it (lane 3's ruling,
#     #165 6771569269; ERR-53). The import runs it once over the file, in line
#     order; a write runs it only for such a `LANDED`, up to its line;
#   - the workstation: `register_line_workstation`, the line's own `session
#     <uuid>@<ws>`, else its caller's fallback - a write's `--workstation`, and
#     None for the import (Y:1273);
#   - `owner`, sent NULL by `_register_lane_row`, as the import sends it, since
#     S4 reads the row's own text (Y:1197);
#   - and the rows they fill: `_register_log_row`, `_register_lane_aliases` and
#     `_register_lane_row`.

def register_shipped_repos_path() -> str:
    """The shipped `repos.tsv`, found as `lanes-edit.sh` finds it for
    `rule6_aliases`: `$LANES_REPOS_TSV_SHIPPED`, else the one in
    `$OPENREPOTOOLS_BIN_DIR` where that file exists, else the one beside
    this command, where `--install` places both."""
    named = os.environ.get("LANES_REPOS_TSV_SHIPPED", "")
    if named:
        return named
    bin_dir = os.environ.get("OPENREPOTOOLS_BIN_DIR", "")
    if bin_dir and os.path.isfile(os.path.join(bin_dir, "repos.tsv")):
        return os.path.join(bin_dir, "repos.tsv")
    return os.path.join(os.path.dirname(os.path.realpath(__file__)), "repos.tsv")


def register_shipped_repos_text() -> str | None:
    """The shipped `repos.tsv`'s text, the first layer of Rule 6's table, or
    None where no such file is there, which `rule6_aliases` passes over too.
    One that is there and cannot be read is a `Refusal`, 2: a table read in
    part would key a hold otherwise than `lanes-edit.sh` keys it."""
    path = register_shipped_repos_path()
    if not os.path.isfile(path):
        return None
    try:
        with open(path, "rb") as handle:
            return _decode(handle.read())
    except OSError as exc:
        raise Refusal(f"the shipped alias table {path} cannot be read "
                      f"({exc.strerror or exc}), and Rule 6's key reads it first")


def register_repo_table(*texts: str | None) -> tuple[dict, dict]:
    """The repository alias table, read as `rule6_aliases` reads it: the
    `repos.tsv` texts in Rule 6's order, the shipped one and then the
    per-wip one (`tree/lanes/repos.tsv`, whose blob is `repos_blob`), each
    alias keyed in lower case and the LAST row naming it winning, so a
    per-wip row replaces the shipped row for its alias. A comment line, a
    line with no tab, and an empty alias or name are passed over.

    Returns two maps: each alias's canonical `owner/repo`, by the alias in
    lower case; and each canonical name's aliases, by that name in lower
    case - every spelling of an alias whose winning row names it, in the
    order the aliases were first seen."""
    canon: dict = {}
    spelled: dict = {}
    for text in texts:
        for raw in (text or "").split("\n"):
            if re.match(r"[ \t]*#", raw):
                continue
            parts = raw.split("\t")
            if len(parts) < 2:
                continue
            alias, target = _trim(parts[0]), _trim(parts[1])
            if not alias or not target:
                continue
            canon[alias.lower()] = target
            names = spelled.setdefault(alias.lower(), [])
            if alias not in names:
                names.append(alias)
    aliases: dict = {}
    for key, names in spelled.items():
        listed = aliases.setdefault(canon[key].lower(), [])
        for name in names:
            if name not in listed:
                listed.append(name)
    return canon, aliases


def register_repo_spellings(repo: str, table: tuple[dict, dict]) -> list[str]:
    """D18's and D19's set for one repository: the spelling as written, its
    canonical name, and every alias the table maps to that name (Y:3356).
    The order is kept and nothing repeats."""
    canon, aliases = table
    named = canon.get(repo.lower(), repo)
    out: list[str] = []
    for spelling in [repo, named] + aliases.get(named.lower(), []):
        if spelling not in out:
            out.append(spelling)
    return out


def register_repo_key(repo: str, table: tuple[dict, dict]) -> str:
    """A register line's `repo_key`: its repository through the alias table,
    lower case, as `RULE6_AWK` keys a hold (`canon`, then `tolower`), so F13's
    equality (Y:1989) meets the key `lanes-edit.sh` pairs by."""
    return table[0].get(repo.lower(), repo).lower()


def register_object_spellings(obj: str, table: tuple[dict, dict]) -> list[str] | None:
    """D19's set for a claim's object: the object as written, then the same
    object under each of its repository's spellings. An object with no
    repository part is its own one spelling, and a lane object has none."""
    if obj.startswith("lane:"):
        return None
    if ":openspec/changes/" in obj:
        repo, rest = obj.split(":openspec/changes/", 1)
        rest = ":openspec/changes/" + rest
    elif "#" in obj and not obj.startswith("#"):
        repo, rest = obj.split("#", 1)
        rest = "#" + rest
    else:
        return [obj]
    out = [obj]
    for spelling in register_repo_spellings(repo, table):
        if spelling + rest not in out:
            out.append(spelling + rest)
    return out


def register_hold_object(obj: str | None) -> bool:
    """Whether a log line's object can be an `object_holds` row: every
    object but a lane's, `lane:<name>`, which holds nothing (#160's holders,
    `lanes-index:1594`; the `holds` view, Y:1222 as amended)."""
    return bool(obj) and not obj.startswith("lane:")


def register_line_workstation(text: str, fallback: str | None) -> str | None:
    """A `lanes/LANES.md` line's workstation: its own `session <uuid>@<ws>`,
    else `fallback` - a write's `--workstation`, or None for the import,
    which files mode allows (Y:1273)."""
    found = re.search(r"session [^,@ ]+@([^,; \t]+)", text)
    return found.group(1) if found else fallback


def _register_log_row(path: str, line_no: int, text: str) -> dict | None:
    """A `log_lines` row for one log line, by `parse_log`'s rules: None for a
    line the grammar skips, an unreadable row kept (7(b)), else its fields."""
    parsed = parse_log_line(text)
    if parsed is None:
        return None
    lane = file_lane(path)
    row = {"path": path, "line_no": line_no, "raw": text, "lane": lane, "verb": None,
           "session": None, "workstation": None, "utc": None, "utc_ts": None, "object": None,
           "ref": None, "payload": None, "payload_fields": None, "free_text": None,
           "written_lane": None, "unreadable": "bad" in parsed, "unreadable_why": None}
    if "bad" in parsed:
        row["unreadable_why"] = parsed["bad"]
        return row
    obj = parsed["object"]
    if lane and obj.startswith("lane:"):
        obj = "lane:" + lane
    row.update(verb=parsed["verb"], session=parsed["uuid"], workstation=parsed["ws"],
               utc=parsed["utc"], utc_ts=_register_utc_ts(parsed["utc"]), object=obj,
               ref=parsed["ref"], payload=parsed["payload"],
               payload_fields=payload_fields(parsed["payload"]), free_text=parsed["text"],
               written_lane=parsed["written_lane"])
    return row


def _register_slot_row(line_no: int, text: str, table: tuple,
                       workstation: str | None) -> dict | None:
    """A `register_lines` row for one `lanes/LANES.md` line that is not a row:
    the one classifier's kind and fields (FR-030), its slot (Q17(B)), its
    `repo_key` and, on a slot line, D18's `repo_spellings`. None for a line
    of no kind. Its workstation is `register_line_workstation`'s, with
    `workstation` as the fallback: this write's, or None for the import.

    NO SLOT ROLE WHERE `RULE6_AWK` COULD NOT PAIR THE LINE (lane 1, #165
    6771151979; lane 3's ruling, 6771569269; ERR-53): a slot line with no
    lane or no repository, or a landing slot with no PR, keeps its kind and
    fields and stores no slot, as Y:1409 has it for a `LANDING EXPIRED`, so
    Y:1269-1270's CHECKs refuse no line the classifier reads. A NULL
    `slot_role` decides nothing (Y:1258). A `LANDING EXPIRED` is never cut
    here: `parse_register_line` reads it only with its holder, PR and
    repository, and its holder's `lane <name>` gives it a lane. A `LANDED`
    with its lane and PR and no repository gets its slot from
    `register_slot_rows`' walk, not from this row alone."""
    fields = parse_register_line(text)
    if fields is None:
        return None
    role, kind = REGISTER_SLOTS[fields["kind"]]
    repo = fields["repo"]
    if role and (fields["lane"] is None or repo is None
                 or (kind == "landing" and fields["pr"] is None)):
        role = kind = None
    return {"path": REGISTER_PATH, "line_no": line_no, "raw": text, "kind": fields["kind"],
            "slot_role": role, "slot_kind": kind, "lane": fields["lane"], "repo": repo,
            "repo_key": register_repo_key(repo, table) if repo else None,
            "repo_spellings": register_repo_spellings(repo, table) if repo and role else None,
            "pr": int(fields["pr"]) if fields["pr"] is not None else None,
            "tip": fields["tip"], "utc": fields["utc"],
            "utc_ts": _register_utc_ts(fields["utc"]), "session": fields["session"],
            "for_lane": fields.get("for_lane"),
            "workstation": register_line_workstation(text, workstation)}


def _register_landed_walks(fields: dict | None) -> bool:
    """Whether a line's row needs `register_slot_rows`' walk: a `LANDED` that
    names its lane and its PR and no repository (lane 3's ruling, #165
    6771569269)."""
    return (fields is not None and fields["kind"] == "LANDED" and fields["repo"] is None
            and fields["lane"] is not None and fields["pr"] is not None)


def _register_landing_closes(close: dict, take: dict) -> bool:
    """Whether a landing close ends a take of its lane and PR, as `main_slots`
    matches them (Y:1291-1295): one repository, by `repo_key` or by any shared
    spelling. A take that names no repository has no key, so no close ends it
    this way."""
    if take["repo_key"] is None:
        return False
    return (close["repo_key"] == take["repo_key"]
            or bool(set(close["repo_spellings"] or ()) & set(take["repo_spellings"] or ())))


def register_slot_rows(lines: list[str], table: tuple,
                       workstation: str | None) -> dict[int, dict]:
    """THE WALK (lane 3's ruling, #165 6771569269; ERR-53): the
    `register_lines` row of every line of `lines` that is of a kind and is not
    a row, keyed by its line number, in line order. `lines` are
    `lanes/LANES.md`'s from its first. Each row is `_register_slot_row`'s,
    with `workstation` its fallback, and a `LANDED` that names its lane and PR
    and no repository is paired as `RULE6_AWK` pairs it (Y:3383;
    `lanes-edit.sh:6983-6989` at code `12ff809`, R24).

    - **Its pair** is the newest `LANDING` before it of its lane, as written,
      and its PR, still open, in any repository. A take is open until a
      landing close of its lane and PR matches it as `main_slots` matches one
      (Y:1291-1295): a `LANDED` naming the repository, a `LANDING EXPIRED`
      for its lane, or a `LANDED` this walk paired before, each by `repo_key`
      or a shared spelling, with the lanes compared in lower case.
    - **A `LANDING` naming no repository** counts in the walk, though it
      stores no slot. A `LANDED` that pairs one closes every such `LANDING`
      of its lane, as written, and PR, which `RULE6_AWK` keys as one; nothing
      else closes them.
    - **The `LANDED`** takes its pair's `repo_key` and `repo_spellings`, and
      the close slot that `LANDED` holds; its `repo` stays NULL. Where its
      pair names no repository, or none is open, it stores no slot role.

    The import runs it once over the file; a write runs it, up to the line,
    only for such a `LANDED` (`register_commit_entry`)."""
    rows: dict = {}
    takes: dict = {}        # (lane in lower case, PR) -> its LANDINGs still open, in line order
    for line_no, text in enumerate(lines, 1):
        if row_name(text) is not None:
            continue
        row = _register_slot_row(line_no, text, table, workstation)
        if row is None:
            continue
        rows[line_no] = row
        if row["kind"] == "LANDING":
            if row["lane"] is not None and row["pr"] is not None:
                takes.setdefault((row["lane"].lower(), row["pr"]), []).append(row)
            continue
        if _register_landed_walks(row):
            group = takes.get((row["lane"].lower(), row["pr"]), [])
            pair = next((t for t in reversed(group) if t["lane"] == row["lane"]), None)
            if pair is None:
                continue
            if pair["repo_key"] is None:      # RULE6_AWK's one key for them all
                group[:] = [t for t in group
                            if t["repo_key"] is not None or t["lane"] != row["lane"]]
                continue
            row.update(slot_role="close", slot_kind="landing", repo_key=pair["repo_key"],
                       repo_spellings=list(pair["repo_spellings"] or []) or None)
        if row["slot_role"] == "close" and row["slot_kind"] == "landing":
            group = takes.get(((row["for_lane"] or row["lane"]).lower(), row["pr"]))
            if group:
                group[:] = [t for t in group if not _register_landing_closes(row, t)]
    return rows


def _register_lane_aliases(text: str | None) -> dict:
    """#160's `aliases_of` (`build_records`): each lane's old names from
    `lanes/aliases.tsv`, by the alias chain's end, lower case."""
    alias_map: dict = {}
    for ordinal, line in enumerate((text or "").split("\n"), 1):
        if line.strip() == "" or re.match(r"[ \t]*#", line):
            continue
        parts = line.split("\t")
        old = _trim(parts[0]) if parts else ""
        new = _trim(parts[1]) if len(parts) > 1 else ""
        if old and new:
            alias_map[old.lower()] = (old, new, ordinal)

    def resolve(name: str) -> str:
        seen: set = set()
        cur = name
        while cur.lower() in alias_map and cur.lower() not in seen:
            seen.add(cur.lower())
            cur = alias_map[cur.lower()][1]
        return cur

    out: dict = {}
    for _key, (old, _new, _ordinal) in sorted(alias_map.items(), key=lambda kv: kv[1][2]):
        out.setdefault(resolve(old).lower(), []).append(old)
    return out


def _register_lane_row(view: RegisterView, side: str, key: str, aliases: dict) -> dict | None:
    """The `lanes` row for one lane key on one side, by `build_records`' rules:
    its first row in `lanes/LANES.md`, else in `lanes/archive/`, with the
    home and session its logs give. None where the lane has no row: a
    structured row names a line (step 7)."""
    found = None
    for path in [REGISTER_PATH] + view.paths(REGISTER_ARCHIVE_PREFIX, side):
        content = view.before(path) if side == "before" else view.after(path)
        for line_no, line in enumerate(register_doc_lines(content or "")[0], 1):
            name = row_name(line)
            if name and _register_lower(name) == key:
                found = (path, line_no, name, line, path != REGISTER_PATH)
                break
        if found:
            break
    if found is None:
        return None
    path, line_no, name, line, archived = found
    home = sid = None
    logs = [p for p in view.paths(LOG_PREFIX, side)
            if p != REGISTER_LOG_README and _register_lower(file_lane(p)) == key]
    view.load(logs)
    for log in logs:
        content = view.before(log) if side == "before" else view.after(log)
        records, _warnings = parse_log(log, content or "")
        for rec in records:
            if rec["unreadable"]:
                continue
            fork = rec["payload"].startswith("fork ")
            if rec["verb"] in ("STARTED", "RESUMED") and not fork:
                hm = re.search(r"home [^ ;]+", rec["payload"])
                if hm and hm.group(0)[5:] != "unknown":
                    home = hm.group(0)[5:]
            if rec["verb"] in ("PAUSED", "RESUMED") and UUID_FULL_RE.match(rec["session"] or ""):
                sid = rec["session"].lower()
    parts = line.split("|")
    ids = UUID_RE.findall((parts[2] if len(parts) > 2 else "").lower())
    state = cell_state(line)
    return {"path": path, "line_no": line_no, "raw": line, "lane_key": key, "lane": name,
            "aliases": aliases.get(name.lower(), []), "home": home,
            "workstation": _trim(parts[3]) if len(parts) > 3 else None,
            "started_utc": _trim(parts[4]) if len(parts) > 4 else None,
            "handoff_path": _trim(parts[6]) if len(parts) > 6 else None,
            "state_phrase": _trim(state) if state else None,
            "objects_cell": _trim(parts[5]) if len(parts) > 5 else None,
            "session_ids": ids, "last_session": ids[-1] if ids else sid,
            # `owner` IS SENT NULL (reading 7): S4 answers from the row's own
            # text (Y:1197), and the import sends NULL too, so the column does
            # not change between the import and the first write.
            "archived": archived, "owner": None}


def _register_last_hold(view: RegisterView, obj: str, key: str, table: tuple) -> dict | None:
    """The `object_holds` row of one lane on one object after the write: that
    lane's LAST readable line on it, in file order - the file bytewise, then
    the line (R14; #160's `holders_of`) - over every log whose lane is the
    key. D19's spellings go on a claim's row alone."""
    best = None
    logs = [p for p in view.paths(LOG_PREFIX, "after")
            if p != REGISTER_LOG_README and _register_lower(file_lane(p)) == key]
    view.load(logs)
    for log in logs:
        for line_no, line in enumerate(register_doc_lines(view.after(log) or "")[0], 1):
            row = _register_log_row(log, line_no, line)
            if row and not row["unreadable"] and row["object"] == obj:
                best = row
    if best is None:
        return None
    return {"object": obj, "lane_key": key, "lane": best["lane"], "verb": best["verb"],
            "utc_ts": best["utc_ts"], "file": best["path"], "ordinal": best["line_no"],
            "spellings": (register_object_spellings(obj, table)
                          if best["verb"] in _REGISTER_CLAIM_VERBS else None),
            "exempt": False}


def register_commit_entry(att: dict, ident: dict, view: RegisterView,
                          shipped_repos: str | None = None, *, kind: str = "write",
                          git_commit: str | None = None) -> dict:
    """The one `jsonb` entry `commit_write` takes (its head comment, Y:1587-1611;
    contract §3.3), derived from the attempt directory, and from the shipped
    `repos.tsv`'s text, `shipped_repos`, for Rule 6's table:

    - `journal`: `kind` `write`, the flags' lane, verb, workstation and
      `args_sha256`, `author`, `msg` verbatim and `repos_blob`;
      `git_commit` NULL. S2's two ways out of a divergence (T324) pass `kind`
      `stray-import` or `stray-revert` and the stray's sha as `git_commit`,
      which the journal's CHECK requires of both (§1.3's kinds table); every
      other caller leaves both as they were;
    - `not_after`, the snapshot's, as a UTC text;
    - `act`, only inside an act;
    - `edits`, in `ord` order: per path, bytewise, a `remove`, a `create` and
      its `append`s, or `register_line_edits`' ops; a rename (`renames.tsv`)
      is one `rename` and the new path's ops against the old path's lines;
    - `files`, one row per path in `changes.tsv`;
    - `log_lines` for every log line written, a renamed log's included, and
      for no other; `register_lines` for every `lanes/LANES.md` line written
      that is a register kind, a `LANDED` naming its lane and PR and no
      repository paired by `register_slot_rows`' walk; `lanes` for every
      lane whose row line was written, or whose row or derived fields
      moved; `object_holds` for every lane and object that a line written,
      replaced or removed names, or that any line of a renamed log names.

    THE ENTRY CARRIES NO DELETES, AND NOTHING RESTS ON THE ORDER ITS ROWS ARE
    SENT IN (lane 3's ruling (c), #165 6755386771; ERR-48). `commit_write`'s
    step 6 derives every delete from the edits it applies: a `replace` or
    `delete` deletes its line's structured rows, a `remove` those of every
    line of its path, and a `rename` the old path's `object_holds`, moving its
    `log_lines` to the new file and its lane. Step 7 then inserts what this
    entry sends.

    A LINE'S WORKSTATION, where it names none of its own, is the write's
    `--workstation` (`register_line_workstation`). Any other kind writes in
    files mode (`commit_write`'s `v_wmode`): a stray's lines were written by
    the workstation that pushed it, never by the one that loads it, so its
    fallback is None, as the import's is (Y:1273)."""
    fallback = ident["workstation"] if kind == "write" else None
    changes, renames = att["changes"], att["renames"]
    renamed_to = {to: frm for frm, to in renames.items()}
    table = register_repo_table(shipped_repos, view.before(REGISTER_REPOS_PATH))
    edits: list = []
    written: dict = {}      # path after the write -> line numbers written there
    gone: dict = {}         # path the lines lived at -> texts replaced, deleted or removed

    def edit(op: str, path: str, line_no=None, old=None, new=None, to_path=None) -> None:
        edits.append({"ord": len(edits) + 1, "op": op, "path": path,
                      "line_no": line_no if op in ("replace", "delete", "append") else None,
                      "old_sha256": (hashlib.sha256(old.encode("utf-8")).hexdigest()
                                     if old is not None else None),
                      "new_text": new, "to_path": to_path})

    for path in sorted(changes, key=lambda p: p.encode("utf-8")):
        status = changes[path][0]
        if status == "A" and path in renamed_to:
            continue
        old_lines = register_doc_lines(view.before(path) or "")[0]
        target = path
        if status == "D":
            if path not in renames:
                edit("remove", path)
                gone.setdefault(path, []).extend(old_lines)
                continue
            target = renames[path]
            edit("rename", path, to_path=target)
            gone.setdefault(path, []).extend(old_lines)
        elif status == "A":
            edit("create", path)
        new_lines = register_doc_lines(view.after(target) or "")[0]
        ops, wrote = register_line_edits(old_lines, new_lines)
        for op, line_no, old, new in ops:
            edit(op, target, line_no, old, new)
            if old is not None and status != "D":
                gone.setdefault(path, []).append(old)
        written.setdefault(target, set()).update(wrote)

    files = []
    for path in sorted(changes, key=lambda p: p.encode("utf-8")):
        if changes[path][0] == "D":
            files.append({"path": path, "present": False, "sha256": None,
                          "final_newline": None})
        else:
            data = att["images"][path]
            files.append({"path": path, "present": True,
                          "sha256": hashlib.sha256(data).hexdigest(),
                          "final_newline": register_doc_lines(data.decode("utf-8"))[1]})

    # log_lines: each log line written, and no other. A RENAMED LOG'S OTHER
    # LINES KEEP THEIR ROWS, which the rename moves to the new file and its
    # lane (step 6, (c)): sent again, each would be stamped `mode=primary`,
    # and a line `log_lines`' primary CHECK refuses (Y:1217-1219) - a WORD
    # line with a millisecond time, say - would end the write with 23514,
    # 69. Its holds are still worked out from EVERY line of it, since the
    # rename deletes the old path's.
    log_rows: list = []
    holds: dict = {}        # (object, lane key) -> None, filled below
    for path in sorted(set(written) | set(renamed_to), key=lambda p: p.encode("utf-8")):
        if not path.startswith(LOG_PREFIX) or path == REGISTER_LOG_README:
            continue
        lines = register_doc_lines(view.after(path) or "")[0]
        wrote = written.get(path, set())
        scan = range(1, len(lines) + 1) if path in renamed_to else sorted(wrote)
        for line_no in scan:
            row = _register_log_row(path, line_no, lines[line_no - 1])
            if row is None:
                continue
            if line_no in wrote:
                log_rows.append(row)
            if not row["unreadable"] and register_hold_object(row["object"]):
                holds[(row["object"], _register_lower(file_lane(path)))] = None
    for path, texts in gone.items():
        if not path.startswith(LOG_PREFIX):
            continue
        for text in texts:
            row = _register_log_row(path, 1, text)
            if row and not row["unreadable"] and register_hold_object(row["object"]):
                holds[(row["object"], _register_lower(file_lane(path)))] = None

    # register_lines: each lanes/LANES.md line written that the one classifier
    # reads as a kind (FR-030; D18). A LANDED written with its lane and PR and
    # no repository takes its row from the walk over the file after the write,
    # up to the last such line, and only then (lane 3's ruling, #165
    # 6771569269; ERR-53): every other line's row is its own.
    slot_rows: list = []
    if REGISTER_PATH in written:
        lines = register_doc_lines(view.after(REGISTER_PATH) or "")[0]
        wrote = sorted(written[REGISTER_PATH])
        walks = [line_no for line_no in wrote if row_name(lines[line_no - 1]) is None
                 and _register_landed_walks(parse_register_line(lines[line_no - 1]))]
        walked = (register_slot_rows(lines[:walks[-1]], table, fallback)
                  if walks else {})
        for line_no in wrote:
            text = lines[line_no - 1]
            if row_name(text) is None:
                row = (walked[line_no] if line_no in walked else
                       _register_slot_row(line_no, text, table, fallback))
                if row is not None:
                    slot_rows.append(row)

    # lanes: each lane whose row line was written, removed or replaced, whose
    # log changed, or whose aliases moved; sent where its row then differs,
    # its line included: a replace or delete of the line a lane's row stood
    # on deletes that lane's row (step 6, (c)), so it is sent again wherever
    # its row now stands.
    keys: set = set()
    for path in list(written) + list(gone):
        if path == REGISTER_PATH or path.startswith(REGISTER_ARCHIVE_PREFIX):
            if path in written:
                lines = register_doc_lines(view.after(path) or "")[0]
                keys.update(_register_lower(row_name(lines[i - 1]) or "") for i in written[path])
            keys.update(_register_lower(row_name(text) or "") for text in gone.get(path, []))
    for path in list(changes) + list(renamed_to):
        if path.startswith(LOG_PREFIX):
            keys.add(_register_lower(file_lane(path)))
    aliases_after = _register_lane_aliases(view.after(ALIASES_PATH))
    if ALIASES_PATH in changes:
        aliases_before = _register_lane_aliases(view.before(ALIASES_PATH))
        keys.update(key for key in set(aliases_before) | set(aliases_after)
                    if aliases_before.get(key) != aliases_after.get(key))
    keys.discard("")
    view.load([REGISTER_PATH] + view.paths(REGISTER_ARCHIVE_PREFIX, "before"))
    lane_rows: list = []
    aliases_before_all = (_register_lane_aliases(view.before(ALIASES_PATH))
                          if ALIASES_PATH in changes else aliases_after)
    derived = ("lane", "aliases", "home", "workstation", "started_utc", "handoff_path",
               "state_phrase", "objects_cell", "session_ids", "last_session", "archived")
    for key in sorted(keys):
        after = _register_lane_row(view, "after", key, aliases_after)
        if after is None:
            continue
        before = _register_lane_row(view, "before", key, aliases_before_all)
        if (after["line_no"] in written.get(after["path"], ()) or before is None
                or ((before["path"], before["line_no"], before["raw"])
                    != (after["path"], after["line_no"], after["raw"]))
                or any(before[f] != after[f] for f in derived)):
            lane_rows.append(after)
    # Sent in key order, and nothing rests on it (ERR-48): a line one lane's
    # row leaves was a replace or a delete, whose rows step 6 has deleted
    # before step 7 inserts another lane's row on it.

    # object_holds: each (object, lane) a line written, replaced or removed
    # names, or any line of a renamed log, at that lane's last line on it. A
    # pair left with no line is not sent: step 6 deleted its row with the
    # line it stood on (c).
    hold_rows = []
    for obj, key in sorted(holds):
        row = _register_last_hold(view, obj, key, table)
        if row is not None:
            hold_rows.append(row)

    entry = {"journal": {"kind": kind, "verb": ident["verb"], "lane": ident["lane"],
                         "workstation": ident["workstation"], "author": att["author"],
                         "message": att["message"], "git_commit": git_commit, "git_tree": None,
                         "repos_blob": att["repos_blob"], "args_sha256": ident["args_sha256"]},
             "not_after": register_epoch_utc(att["not_after"])}
    if att["act"] is not None:
        entry["act"] = att["act"]
    entry.update(edits=edits, files=files, lanes=lane_rows, log_lines=log_rows,
                 register_lines=slot_rows, object_holds=hold_rows)
    return entry


def register_commit_request(schema: str, n: int, ident: dict, entry: dict) -> list[str]:
    """The commit as ONE request (contract §2.3; Y:1419): `BEGIN ISOLATION
    LEVEL SERIALIZABLE`, the one `commit_write` call, `COMMIT`. The entry is
    one `jsonb` literal, pure ASCII, so no client encoding can change it."""
    literal = json.dumps(entry, ensure_ascii=True, separators=(",", ":"))
    return ["BEGIN ISOLATION LEVEL SERIALIZABLE",
            f"SELECT {schema}.commit_write({n}, {_pg_quote(ident['write_id'])}, "
            f"{REGISTER_SCHEMA_VERSION}, {_pg_quote(ident['generation'])}, "
            f"{_pg_quote(literal)}::jsonb)",
            "COMMIT"]


def _register_commit_call(store: PostgresStore, att: dict, ident: dict,
                          entry: dict) -> tuple[int, int | None, RegisterError | None,
                                                PsqlFailed | None]:
    """One commit call: (its code, the seq committed, the refusal, the
    failure). Its answer under `-A -t` is the seq alone, on one line; any
    other answer of an exit 0 is one `lanes-index` cannot read: 3."""
    try:
        out = store.request(register_commit_request(store.schema, att["n"], ident, entry),
                            "commit")
    except PsqlFailed as failure:
        code, err = register_commit_exit(failure)
        return code, None, err, failure
    except StoreUnusable as exc:
        return EXIT_UNAVAILABLE, None, None, PsqlFailed(exc.kind, exc.detail, ran=False)
    lines = [line for line in out.split("\n") if line.strip()]
    if len(lines) == 1 and re.fullmatch(r"[0-9]+", lines[0].strip()):
        return EXIT_OK, int(lines[0].strip()), None, None
    shown = re.sub(r"[^\x20-\x7e]", "?", out.strip())[:80]
    return EXIT_IN_DOUBT, None, None, PsqlFailed(
        "unreadable", f"the answer was {shown!r}, not one seq", psql_exit=0)


def _register_array(values) -> str:
    if not values:
        return "NULL::text[]"
    return "ARRAY[" + ", ".join(_pg_quote(v) for v in values) + "]::text[]"


def _register_holder_line(store: PostgresStore, entry: dict) -> str | None:
    """LR005's holder, read after the refusal in a second request with the
    snapshot's bounds (contract §3.3): the earlier taker in `main_slots` for a
    take this entry made, or another lane's live claim on an object it
    claimed, as `held-by=<seq>` TAB `<path>` TAB `<raw line>`. None where the
    read fails or finds none: the line is left out.

    A claim an import marked `exempt` is never the holder named: it is
    outside `one_live_claim` and D19's check, so it refuses nothing (lane 3,
    #165 6755386771)."""
    queries = []
    for row in entry["register_lines"]:
        if row["slot_role"] == "take" and row["repo_key"]:
            queries.append(
                "SELECT d.written_seq, d.path, d.text FROM main_slots m JOIN doc_lines d "
                f"ON d.line_id = m.line_id WHERE (m.repo_key = {_pg_quote(row['repo_key'])} "
                f"OR m.repo_spellings && {_register_array(row['repo_spellings'])}) "
                f"AND lower(m.lane) IS DISTINCT FROM lower({_pg_quote(row['lane'])}) "
                "ORDER BY m.line_id LIMIT 1")
    for row in entry["object_holds"]:
        if row["verb"] in _REGISTER_CLAIM_VERBS:
            queries.append(
                "SELECT d.written_seq, d.path, d.text FROM object_holds o JOIN doc_lines d "
                "ON d.path = o.file AND d.line_no = o.ordinal "
                f"WHERE o.lane_key <> {_pg_quote(row['lane_key'])} "
                "AND o.verb IN ('CLAIMED', 'TAKEOVER') AND o.superseded_by IS NULL "
                "AND NOT o.exempt "
                f"AND (o.object = {_pg_quote(row['object'])} "
                f"OR o.spellings && {_register_array(row['spellings'])}) "
                "ORDER BY o.seq, o.lane_key LIMIT 1")
    if not queries:
        return None
    try:
        answers = store._query_many(queries, snapshot=True, row="snapshot")
    except StoreUnusable:
        return None
    for rows in answers:
        if rows and len(rows[0]) == 3 and all(v is not None for v in rows[0]):
            return f"held-by={rows[0][0]}\t{rows[0][1]}\t{rows[0][2]}"
    return None


def _register_already(store: PostgresStore, ident: dict, err: RegisterError) -> int:
    """LR006: this write is already in the journal, by an earlier attempt. 0,
    with `already <seq>` and that seq's `file=` rows, sorted, read in a second
    request with the snapshot's bounds (contract §3.3). Where that read fails,
    `already <seq>` alone, with the seq from LR006's message; where neither
    names the seq, 3, so the caller's lookup finds it."""
    named = re.search(r"at seq ([0-9]+)\s*$", err.message)
    write = _pg_quote(ident["write_id"])
    try:
        answers = store._query_many(
            [f"SELECT seq FROM journal WHERE write_id = {write}",
             "SELECT path, CASE WHEN present THEN '1' ELSE '0' END, coalesce(sha256, '-') "
             f"FROM journal_files WHERE seq = (SELECT seq FROM journal WHERE write_id = {write}) "
             "ORDER BY path"], snapshot=True, row="snapshot")
        seq = int(answers[0][0][0])
        rows = answers[1]
    except (StoreUnusable, IndexError, ValueError, TypeError):
        seq, rows = (int(named.group(1)) if named else None), None
    if seq is None:
        note(f"LR006: write {ident['write_id']} is in the journal, and neither its message nor "
             f"a read names its seq: in doubt, so look it up")
        return EXIT_IN_DOUBT
    note(f"LR006: write {ident['write_id']} is already in the journal at seq {seq}, committed "
         f"by an earlier attempt" + ("" if rows is not None else
                                     "; its file rows could not be read"))
    say(f"already {seq}")
    for row in rows or []:
        say("file=" + "\t".join("" if v is None else v for v in row))
    return EXIT_OK


def _register_commit_end(store: PostgresStore, ident: dict, entry: dict, code: int,
                         seq: int | None, err: RegisterError | None,
                         failure: PsqlFailed | None) -> int:
    """What a commit call's end prints, and its code (contract §2.6, §3.3)."""
    write = ident["write_id"]
    if code == EXIT_OK and seq is not None:
        say(f"committed {seq}")
        return EXIT_OK
    if err is not None and err.sqlstate == "LR006":
        return _register_already(store, ident, err)
    if code == EXIT_IN_DOUBT:
        note(f"in doubt: the commit call of write {write} {register_psql_end(failure)}, so "
             f"whether it committed is not known. Look it up (journal --write-id) before "
             f"ending with any code but 0, and rerun under the same id: "
             f"LANES_WRITE_ID={write} LANES_WRITE_GENERATION={ident['generation']}")
        return EXIT_IN_DOUBT
    if err is None:
        note(f"the commit call of write {write} {register_psql_end(failure)}; nothing was sent, "
             f"and nothing was written")
        return code
    register_say_error(err)
    if code == EXIT_BUSY:
        note(f"register busy ({err.sqlstate}): write {write} lost its turn, and nothing was "
             f"written; take a new attempt")
    elif code == EXIT_REFUSED:
        note(f"refused by the register ({err.sqlstate}"
             + (f" {err.detail}" if err.detail else "") + f"): nothing was written")
        if err.sqlstate == "LR005" and err.detail in _REGISTER_HOLDER_TOKENS:
            held = _register_holder_line(store, entry)
            if held:
                say(held)
    else:
        # LR004 never reaches this map: `cmd_register_commit` ends it in
        # `_register_commit_lr004` instead, so the map does not name it.
        why = {"LR002": "the register's switch is not primary with the marker present, so "
                        "no write commits",
               "LR003": "this client is outside the register schema's window; the message "
                        "names both numbers"}.get(
                   err.sqlstate, "the database refused the transaction")
        note(f"the register ({store.label}, schema {store.schema}) refused write {write} "
             f"with {err.sqlstate}: {why}; nothing was written")
    return code


#: The two paths `tree/` takes from the lane checkout and not from SQL
#: (contract §3.2's `--tree`), which LR004's re-read never compares:
#: `repos.tsv`, whose blob `repos_blob` is checked against `tree/`'s before
#: anything is sent, and the log directory's README.
_REGISTER_TREE_NOT_SQL = frozenset((REGISTER_REPOS_PATH, REGISTER_LOG_README))


def register_tree_reads(att: dict, view: RegisterView) -> tuple[list[str], list[str]]:
    """What the entry read of `tree/`, as LR004's re-read compares it (R02;
    lane 3, #165 6755386771 and 6755615338): every path whose text at `n` it
    read or found absent - each path in `changes.tsv` among them, and the
    unchanged rows and logs as well - and every prefix whose paths it
    listed; less `_REGISTER_TREE_NOT_SQL`. Each list is sorted bytewise."""
    paths = (view.read | set(att["changes"])) - _REGISTER_TREE_NOT_SQL
    return (sorted(paths, key=lambda p: p.encode("utf-8")),
            sorted(view.listed, key=lambda p: p.encode("utf-8")))


def _register_reread_bases(store: PostgresStore, paths: list[str],
                           prefixes: list[str]) -> tuple[int, dict, dict]:
    """R02's ONE re-read, after an LR004: the head; each of `paths`, re-read
    from SQL whole, past the image cache; and the paths under each of
    `prefixes` - in one REPEATABLE READ request with the snapshot's bounds.
    Returns (the head, path to bytes for each of `paths` SQL has, prefix to
    the set of paths SQL has under it). `StoreUnusable` where it fails."""
    queries = ["SELECT seq FROM register_head WHERE id = 1",
               "SELECT path, encode(render_file(path), 'hex') FROM files "
               f"WHERE path = ANY ({_register_array(paths) if paths else 'ARRAY[]::text[]'}) "
               "ORDER BY path"]
    if prefixes:
        queries.append("SELECT path FROM files WHERE "
                       + " OR ".join(f"starts_with(path, {_pg_quote(prefix)})"
                                     for prefix in prefixes)
                       + " ORDER BY path")
    answers = store._query_many(queries, snapshot=True, row="snapshot")
    if len(answers) != len(queries) or len(answers[0]) != 1:
        raise StoreUnusable("unreadable", "the re-read answered no head")
    try:
        head = int(answers[0][0][0])
        current = {row[0]: bytes.fromhex(row[1] or "") for row in answers[1]}
        listing: dict = {prefix: set() for prefix in prefixes}
        for row in (answers[2] if prefixes else []):
            for prefix in prefixes:
                if row[0].startswith(prefix):
                    listing[prefix].add(row[0])
    except (ValueError, TypeError, IndexError):
        raise StoreUnusable("unreadable", "the re-read's answer cannot be read")
    return head, current, listing


def _register_commit_lr004(store: PostgresStore, att: dict, ident: dict, entry: dict,
                           view: RegisterView, first: RegisterError) -> int:
    """LR004 under the scratch tree: ONE re-read from SQL of every file the
    entry read from `tree/`, and NO second commit call (R02, lane 1's form,
    as lane 3 accepted it: #165 6755615338). The entry rests on those same
    bases, so a resend would be the first request byte for byte, and with the
    head still at `n` could only meet LR004 again. Three ends, each with
    nothing written, after LR004's own `ERROR:` line:

    - the head is no longer `n`: 75, a lost turn;
    - a file the entry read differs from SQL's at `n`, or is on one side of a
      listing only: 69, naming the image cache, which gave `tree/`;
    - every one equal: 69, naming the entry and LR004's own message.

    A re-read that fails is 69 too (reading 2, #165 6755386771)."""
    write, n = ident["write_id"], att["n"]
    register_say_error(first)
    paths, prefixes = register_tree_reads(att, view)
    try:
        head, current, listing = _register_reread_bases(store, paths, prefixes)
        differ = {path for path in paths if current.get(path) != view.tree_bytes(path)}
    except StoreUnusable as exc:
        note(f"LR004 on write {write}, and the re-read from SQL of the files its entry read "
             f"from tree/ failed ({exc.detail}): the entry is not sent again, and nothing "
             f"was written")
        return EXIT_UNAVAILABLE
    if head != n:
        note(f"LR004 on write {write}, and the head is now {head}, not {n}: another write "
             f"committed, so this attempt lost its turn; nothing was written")
        return EXIT_BUSY
    for prefix, found in listing.items():
        mine = {p for p in att["tree_blobs"] if p.startswith(prefix)} - _REGISTER_TREE_NOT_SQL
        differ |= mine ^ found
    if differ:
        shown = sorted(differ, key=lambda p: p.encode("utf-8"))
        note(f"LR004 on write {write}: {', '.join(shown)} at seq {n}, re-read from SQL, "
             f"{'differs' if len(shown) == 1 else 'differ'} from the scratch tree's, which "
             f"the image cache gave, so the verb ran on a wrong base. Its images are not sent "
             f"again; nothing was written")
        return EXIT_UNAVAILABLE
    edited = sorted({e["path"] for e in entry["edits"]}
                    | {e["to_path"] for e in entry["edits"] if e["to_path"]},
                    key=lambda p: p.encode("utf-8"))
    count, npaths = len(entry["edits"]), len(paths)
    what = (f"its {count} edit{'' if count == 1 else 's'} of {', '.join(edited)} "
            f"{'does' if count == 1 else 'do'} not apply, or its proof differs" if count
            else "it carries no edit, so another of its checks failed")
    note(f"LR004 on write {write}: every file its entry read from tree/ ({npaths} "
         f"path{'' if npaths == 1 else 's'}) equals SQL's at seq {n}, so the image cache was "
         f"right and the entry itself was refused - {what}: {first.message}. A resend would "
         f"be the same request, so none is made; nothing was written")
    return EXIT_UNAVAILABLE


def _register_build_entry(att: dict, ident: dict, shipped_repos: str | None, *,
                          kind: str = "write",
                          git_commit: str | None = None) -> tuple[dict, RegisterView]:
    """`register_commit_entry` over `tree/`, and the view it read `tree/`
    through, whose reads LR004's re-read compares. A failed read of `tree/` is
    the attempt directory's fault: `RegisterAttemptRefused`, 2, nothing
    sent. `kind` and `git_commit` are `register_commit_entry`'s, which only
    S2's two ways out (T324) change."""
    view = RegisterView(att, att["tree_bases"])
    try:
        return register_commit_entry(att, ident, view, shipped_repos, kind=kind,
                                     git_commit=git_commit), view
    except StoreUnusable as exc:
        raise RegisterAttemptRefused(f"tree/ cannot be read ({exc.detail})")


def _register_commit_args(args: list[str]) -> tuple[dict, str] | None:
    """`register commit`'s argv (contract §3.3): the six flags, each once, as
    `--flag <value>` or `--flag=<value>`, and one attempt directory. None for
    `-h`; `_RegisterUsage` for anything else that is not this form."""
    values: dict = {}
    positional: list = []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-h", "--help"):
            return None
        flag, eq, value = arg.partition("=")
        if flag in _REGISTER_COMMIT_FLAGS:
            if not eq:
                if i + 1 >= len(args):
                    raise _RegisterUsage(f"register commit: {flag} needs a value")
                value = args[i + 1]
            i += 1 if eq else 2
            if flag in values:
                raise _RegisterUsage(f"register commit: {flag} is given twice")
            values[flag] = value
            continue
        if arg.startswith("-"):
            raise _RegisterUsage(f"register commit: unknown argument '{arg}'")
        positional.append(arg)
        i += 1
    missing = [flag for flag in _REGISTER_COMMIT_FLAGS if flag not in values]
    if missing:
        raise _RegisterUsage(f"register commit needs {', '.join(missing)}")
    if len(positional) != 1:
        raise _RegisterUsage("register commit takes one attempt directory")
    for flag in ("--write-id", "--generation"):
        if not UUID_FULL_RE.match(values[flag]):
            raise _RegisterUsage(f"register commit: {flag} is not a uuid")
    if not _REGISTER_SHA256_RE.fullmatch(values["--args-sha256"]):
        raise _RegisterUsage("register commit: --args-sha256 is not 64 lower-case hex")
    for flag in ("--lane", "--verb", "--workstation"):
        if not _REGISTER_WORD_RE.fullmatch(values[flag]):
            raise _RegisterUsage(f"register commit: {flag} is empty, or holds white space")
    ident = {"write_id": _register_lower(values["--write-id"]),
             "generation": _register_lower(values["--generation"]),
             "lane": values["--lane"], "verb": values["--verb"],
             "args_sha256": values["--args-sha256"], "workstation": values["--workstation"]}
    return ident, positional[0]


def cmd_register_commit(args: list[str]) -> int:
    """`lanes-index register commit` (contract §3.3; FR-014; L1-A10): one
    SERIALIZABLE `commit_write` call, as one request, of the entry derived
    from the attempt directory, with D9's commit row.

    In order: the argv (64); the configuration (2, Q6(c)'s refusal
    included); `LANES_ACT` and `LANES_EXPECT`, checked again (2); the attempt
    directory (2), one whose `changes.tsv` names no path included; the
    shipped `repos.tsv`, Rule 6's first table (2 where it is there and cannot
    be read); the store, as this engineer's
    REGISTER-WRITER login; then the call, made once. Exits 0 `committed
    <seq>` or `already <seq>`, 75, 69, 2 and 3, as `_register_commit_end`
    and, after an LR004, `_register_commit_lr004` read them."""
    try:
        parsed = _register_commit_args(args)
    except _RegisterUsage as exc:
        note(str(exc))
        note(f"usage: {_REGISTER_COMMIT_USAGE}")
        return EXIT_USAGE
    if parsed is None:
        say(USAGE)
        return EXIT_OK
    ident, directory = parsed
    # THE SCRATCH TREE IS READ AS ITSELF: a repository location inherited from
    # a caller's git (a hook's `GIT_DIR`, say) would point `git -C tree/`
    # somewhere else. `psql` reads none of these.
    for name in _REGISTER_GIT_LOCATION:
        os.environ.pop(name, None)
    try:
        cfg = load_config()
        env_act = register_act_of_env(os.environ.get("LANES_ACT", ""),
                                      os.environ.get("LANES_EXPECT", ""))
        att = read_attempt_dir(directory, ident, env_act)
        # AN EMPTY CHANGE SET: this arm's entry is always a `write`, and the
        # seam sends none that names no path (Y:5060), so it is refused here,
        # before the store opens. `read_attempt_dir` pairs every `files` row
        # with a `changes.tsv` line, so `files` is empty too. The shared read
        # takes no such check: T324's in-process entries with no edits still
        # journal (lane 3, #165 6808937880, batch e Q88).
        if not att["changes"]:
            raise RegisterAttemptRefused("changes.tsv names no path")
        entry, view = _register_build_entry(att, ident, register_shipped_repos_text())
        store = PostgresStore(cfg, "register_writer")
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return EXIT_REFUSED
    except StoreUnusable as exc:
        note(f"{exc.kind}: {exc.detail}; nothing was sent")
        return EXIT_UNAVAILABLE
    code, seq, err, failure = _register_commit_call(store, att, ident, entry)
    if err is not None and err.sqlstate == "LR004":
        return _register_commit_lr004(store, att, ident, entry, view, err)
    return _register_commit_end(store, ident, entry, code, seq, err, failure)


# THE JOURNAL (feature 007, opensoft/openRepoTools#165; contract §3.4 and
# §3.6; FR-016; design.md "The in-doubt rule (F3, D8)"). `lanes-index
# journal` has three forms:
#
# - `--write-id …`, the in-doubt lookup. The client waits first, on its own
#   estimate of the database's clock (F3; lane 4's answer 36 for a record
#   taken over), then makes `find_write`'s tries, each under D9's lookup row,
#   inside a CLOSED 10 s window from that wait's end: start to start at least
#   1 s apart, and never before the last try ended (lane 4's answer 40), on
#   the monotonic clock. Its codes are its own table (CO-3), never
#   `register commit`'s: LR007 is 2, and every other SQLSTATE is 3.
# - `--since <m>`, the renderer's read of the journal's history.
# - `--last --path <p> --grep <key> [--at <n> --generation <g>]`, the rank
#   `swapped_lanes` reads: git's `-S` pickaxe over the journal (C7), at the
#   door's `n` under `--at` (C8).

#: `journal --write-id`'s code for each SQLSTATE under `psql`'s exit 3, its
#: own table and never `register commit`'s (contract §3.4's exits; CO-3):
#: LR007 is 2, and its DETAIL token, `generation` or `another-write`, decides
#: the pending record's fate (Y:5241). LR011, and every SQLSTATE not named
#: here, is 3, since none of them settles the write.
REGISTER_LOOKUP_EXITS = {"LR007": EXIT_REFUSED}

#: The SQLSTATEs a lookup try ends on WITHOUT AN ANSWER (Y:5250-5253): 55P03,
#: the head row's lock not granted within the try's `lock_timeout`, whose
#: holder may be this write's own orphan; and 57014, the try's
#: `statement_timeout`, the server's own "no answer within the bound" (Y:3524),
#: the counterpart of a try cut by `T_L`, whose transaction ends and frees the
#: lock (lane 3's ruling, opensoft/openRepoTools#165 6755922262). Like a failed
#: connect and a try cut by `T_L`, each is tried again while a new try can
#: start inside the window. LR011 and LR007 are answers, and are never tried
#: again.
REGISTER_LOOKUP_RETRIED = frozenset({"55P03", "57014"})

#: `R`, the window every try starts inside, from the end of the client's own
#: wait (Y:5247). It is closed: a try may start at its 10 s mark (Y:5279).
REGISTER_LOOKUP_WINDOW_S = 10.0
#: The least time from one try's start to the next one's (lane 4's answer 40).
REGISTER_LOOKUP_SPACING_S = 1.0
#: The client calls once its estimate puts `<n>` at most this far ahead
#: (Y:5236), so `find_write`'s own wait of at most 3 s covers the estimate's
#: one-second grain.
REGISTER_LOOKUP_AHEAD_S = 2

#: Contract §3.4's stderr line where no try took the head row's lock: every
#: try ended as Y:5245 names a try that fails to take it, in 55P03, a failed
#: connect (`psql`'s exit 2) or its timer `T_L`, or in 57014, `T_L`'s
#: counterpart. Where a try ended any other way, this line is not printed,
#: and `_REGISTER_LOOKUP_NO_ANSWER` says how the tries ended instead.
_REGISTER_LOOKUP_NO_LOCK = "journal: no try took the head row's lock within 10 s"
_REGISTER_LOOKUP_NO_ANSWER = "journal: no try gave an answer within 10 s"
#: The token the lookup's SELECT prints where `find_write` returns NULL, and
#: the only text read as absent (lane 3's MUST, #165 6755922262).
_REGISTER_LOOKUP_ABSENT = "absent"

_REGISTER_JOURNAL_USAGE = (
    f"{PROG} journal --write-id <uuid> --not-after <epoch s> --generation <uuid> "
    f"--lane <lane> --verb <verb> --args-sha256 <hex> [--clock <epoch s> --clock-age <s>]",
    f"{PROG} journal --since <m>",
    f"{PROG} journal --last --path <log> --grep <key> [--at <n> --generation <uuid>]")
#: The flags that take a value, in any of the three forms.
_REGISTER_JOURNAL_VALUED = ("--write-id", "--not-after", "--generation", "--lane", "--verb",
                            "--args-sha256", "--clock", "--clock-age", "--since", "--path",
                            "--grep", "--at")
_REGISTER_LOOKUP_NEEDS = ("--write-id", "--not-after", "--generation", "--lane", "--verb",
                          "--args-sha256")
#: Whole epoch seconds, as `clock=` and `not_after=` print them (contract §3.2).
_REGISTER_EPOCH_RE = re.compile(r"0|[1-9][0-9]{0,10}")
#: Whole seconds of age, never below 0 (lane 4's answer 36).
_REGISTER_AGE_RE = re.compile(r"0|[1-9][0-9]{0,9}")
#: A journal seq as a bound: -1, an empty journal's head, or a seq.
_REGISTER_SEQ_ARG_RE = re.compile(r"-1|0|[1-9][0-9]{0,17}")


def _register_journal_args(args: list[str]) -> tuple[str, dict] | None:
    """`journal`'s argv (contract §3.4, §3.6), in one of its three forms, each
    flag at most once, as `--flag <value>` or `--flag=<value>`: (the form,
    `write-id`, `since` or `last`, and the flags' values). None for `-h`;
    `_RegisterUsage`, 64 before anything is read, for anything else that is
    not one of the forms."""
    values: dict = {}
    last = False
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-h", "--help"):
            return None
        if arg == "--last":
            if last:
                raise _RegisterUsage("journal: --last is given twice")
            last = True
            i += 1
            continue
        flag, eq, value = arg.partition("=")
        if flag not in _REGISTER_JOURNAL_VALUED:
            raise _RegisterUsage(f"journal: unknown argument '{arg}'")
        if not eq:
            if i + 1 >= len(args):
                raise _RegisterUsage(f"journal: {flag} needs a value")
            value = args[i + 1]
        i += 1 if eq else 2
        if flag in values:
            raise _RegisterUsage(f"journal: {flag} is given twice")
        values[flag] = value
    if "--write-id" in values and not last:
        form, needed = "write-id", _REGISTER_LOOKUP_NEEDS
        allowed = set(needed) | {"--clock", "--clock-age"}
    elif "--since" in values and not last:
        form, needed, allowed = "since", ("--since",), {"--since"}
    elif last:
        form, needed = "last", ("--path", "--grep")
        allowed = {"--path", "--grep", "--at", "--generation"}
    else:
        raise _RegisterUsage("journal takes one of three forms: --write-id …, --since <m>, "
                             "or --last --path <log> --grep <key>")
    extra = sorted(set(values) - allowed)
    if extra:
        raise _RegisterUsage(f"journal --{form}: {', '.join(extra)} is not part of this form")
    missing = [flag for flag in needed if flag not in values]
    if missing:
        raise _RegisterUsage(f"journal --{form} needs {', '.join(missing)}")
    if form == "write-id":
        for flag in ("--write-id", "--generation"):
            if not UUID_FULL_RE.fullmatch(values[flag]):
                raise _RegisterUsage(f"journal: {flag} is not a uuid")
        if not _REGISTER_SHA256_RE.fullmatch(values["--args-sha256"]):
            raise _RegisterUsage("journal: --args-sha256 is not 64 lower-case hex")
        for flag in ("--lane", "--verb"):
            if not _REGISTER_WORD_RE.fullmatch(values[flag]):
                raise _RegisterUsage(f"journal: {flag} is empty, or holds white space")
        # `--clock` AND `--clock-age` GO TOGETHER (contract §3.4): a run's last
        # snapshot's, or a taken-over record's (lane 4's answer 36), or neither.
        if ("--clock" in values) != ("--clock-age" in values):
            raise _RegisterUsage("journal: --clock and --clock-age go together")
        for flag in ("--not-after", "--clock"):
            if flag in values and not _REGISTER_EPOCH_RE.fullmatch(values[flag]):
                raise _RegisterUsage(f"journal: {flag} is not whole epoch seconds")
        if "--clock-age" in values and not _REGISTER_AGE_RE.fullmatch(values["--clock-age"]):
            raise _RegisterUsage("journal: --clock-age is not whole seconds, 0 or more")
    elif form == "since":
        if not _REGISTER_SEQ_ARG_RE.fullmatch(values["--since"]):
            raise _RegisterUsage("journal: --since is not a seq")
    else:
        if not values["--path"] or re.search(r"[\x00-\x1f\x7f]", values["--path"]):
            raise _RegisterUsage("journal: --path is empty, or holds a control character")
        if not values["--grep"]:
            raise _RegisterUsage("journal: --grep is empty")
        # `--at` NEEDS `--generation` (C8; contract §3.6), as `register
        # snapshot --at` does (§3.2): 64 without it. Neither means anything
        # alone.
        if ("--at" in values) != ("--generation" in values):
            raise _RegisterUsage("journal --last: --at and --generation go together")
        if "--at" in values:
            if not _REGISTER_SEQ_ARG_RE.fullmatch(values["--at"]):
                raise _RegisterUsage("journal: --at is not a seq")
            if not UUID_FULL_RE.fullmatch(values["--generation"]):
                raise _RegisterUsage("journal: --generation is not a uuid")
    return form, values


def _register_sleep_until(when: float) -> None:
    """Sleep until the monotonic clock reads `when`; at once where it has."""
    while True:
        left = when - time.monotonic()
        if left <= 0:
            return
        time.sleep(left)


def register_lookup_request(schema: str, ident: dict, not_after: int) -> list[str]:
    """The lookup as ONE request of FOUR statements (contract §2.3 and §3.4;
    Y:5235; lane 3's rulings, #165 6755922262, reading 2):

    1. `BEGIN ISOLATION LEVEL READ COMMITTED`, named, so no role's or
       database's default level changes what `find_write` sees;
    2. the one `find_write` call with the write's six values, as
       `coalesce(...::text, 'absent')`, so NULL prints as the token `absent`
       and never as an empty line (the MUST);
    3. one `COPY` of ONE text column, read in the SAME transaction (Y:5300),
       after the call, so its snapshot is taken under the head row's lock,
       after `find_write`'s wait: first `workstation=<name>`, the found
       entry's `journal.workstation` (Y:1114, NOT NULL and never empty),
       and `utc=<epoch>`, its `journal.utc` (Y:1106) in whole epoch seconds,
       as `journal --since` prints it, both from the `journal` row of this
       write id, the row `find_write` found; then that seq's `journal_files`
       rows, §3.2's canonical rows, each built as one value with its two
       tabs, sorted by path (lane 3's ruling on T418, #165 6770688147, item
       1, and its ruling on where they are read, #165 6774390716);
    4. `ROLLBACK`.

    Under `-A -t` the call prints its seq or `absent` bare. COPY prints one
    line per value, escaped as COPY's text format escapes a field, so each
    row's two tabs print as `\\t`. Where the id is absent, the COPY prints
    nothing.

    The two values are read in statement 3, not 2, because statement 2's
    own snapshot is taken before `find_write`'s wait: an orphan of this
    write that commits during that wait is seen by `find_write`, whose
    statements each take a fresh snapshot, and by statement 3, but not by
    statement 2 (lane 3, #165 6774390716). So the try that waited answers
    found, with both lines and the rows, and no further try is made."""
    write = _pg_quote(ident["write_id"])
    return ["BEGIN ISOLATION LEVEL READ COMMITTED",
            f"SELECT coalesce({schema}.find_write({write}, "
            f"{_pg_quote(register_epoch_utc(not_after))}, {_pg_quote(ident['generation'])}, "
            f"{_pg_quote(ident['lane'])}, {_pg_quote(ident['verb'])}, "
            f"{_pg_quote(ident['args_sha256'])})::text, {_pg_quote(_REGISTER_LOOKUP_ABSENT)})",
            f"COPY (WITH j AS (SELECT seq, workstation, utc FROM {schema}.journal "
            f"WHERE write_id = {write}) SELECT x.line FROM (SELECT 1 AS o, '' AS p, "
            "'workstation=' || j.workstation AS line FROM j UNION ALL SELECT 2, '', 'utc=' || "
            "extract(epoch FROM j.utc)::bigint::text FROM j UNION ALL SELECT 3, f.path, "
            "f.path || chr(9) || CASE WHEN f.present THEN '1' ELSE '0' END || chr(9) || "
            f"coalesce(f.sha256, '-') FROM {schema}.journal_files f JOIN j ON f.seq = j.seq) x "
            "ORDER BY x.o, x.p COLLATE \"C\") TO STDOUT",
            "ROLLBACK"]


def register_lookup_answer(out: str) -> tuple | None:
    """A lookup's stdout, read: `(seq, workstation, utc, rows)` where
    `find_write` found the write, its rows each `[path, present, sha256]`
    (§3.2's canonical values); `(None, None, None, [])` where its one line
    is exactly the token `absent`, absent with the lock held; and None, NO
    ANSWER, for anything else it cannot read, which is tried again (lane 3's
    MUST, #165 6755922262). That includes an empty stdout, a blank line
    anywhere, `absent` with anything after it or around it (`absent ` with a
    trailing space), `Absent`, and a first line that is neither the token
    nor a seq. A stdout that holds no answer is never read as absent. Only
    the newline that ends the last line is psql's own and not part of the
    answer.

    The lines after the seq are statement 3's COPY of one text column
    (`register_lookup_request`), one escaped value per line. So a line
    holding a raw tab, which that COPY never prints, or a NULL (`\\N`), is
    no answer. Each line is unescaped as COPY's text format escapes it.
    Then the first two values must be, in this order, each once (lane 3's
    ruling on T418, #165 6770688147, item 1): `workstation=<name>`, where
    `<name>` is a word, as `register commit --workstation` takes one
    (`_REGISTER_WORD_RE`), and never empty, since `journal.workstation` is
    NOT NULL and never '' (Y:1114); and `utc=<epoch>`, whole epoch seconds
    as `--clock` takes them (`_REGISTER_EPOCH_RE`). Each later value is one
    canonical row, split at its two tabs. A seq with either line missing,
    repeated, out of order or malformed, an empty `workstation=` included,
    is no answer, as is a seq alone."""
    lines = out.split("\n")
    if len(lines) > 1 and lines[-1] == "":
        lines.pop()
    if not all(lines):
        return None
    if lines[0] == _REGISTER_LOOKUP_ABSENT:
        return (None, None, None, []) if len(lines) == 1 else None
    if not re.fullmatch(r"[0-9]+", lines[0]) or len(lines) < 3:
        return None
    if any("\t" in line for line in lines[1:]):
        return None
    values = [_pg_unescape(line) for line in lines[1:]]
    if None in values:
        return None
    key, eq, workstation = values[0].partition("=")
    if key != "workstation" or not eq or not _REGISTER_WORD_RE.fullmatch(workstation):
        return None
    key, eq, utc = values[1].partition("=")
    if key != "utc" or not eq or not _REGISTER_EPOCH_RE.fullmatch(utc):
        return None
    rows = []
    for value in values[2:]:
        row = value.split("\t")
        if (len(row) != 3 or not row[0] or row[1] not in ("0", "1")
                or (row[1] == "1") != bool(_REGISTER_SHA256_RE.fullmatch(row[2] or ""))
                or (row[1] == "0" and row[2] != "-")):
            return None
        rows.append(row)
    return int(lines[0]), workstation, int(utc), rows


def _register_lookup_try(store: PostgresStore, ident: dict,
                         not_after: int) -> tuple[str, tuple | None, PsqlFailed | None,
                                                  RegisterError | None]:
    """One try of the lookup: (how it ended, the answer, the failure, the
    refusal). It ended:

    - `found` or `absent`: `find_write` answered, and its stdout was read
      (`register_lookup_answer`);
    - `refused`: `psql`'s exit 3 with a SQLSTATE that is an answer (LR007,
      LR011, any other but 55P03 and 57014);
    - `again`: with no answer, so it is tried again while a new try can start
      inside the window (Y:5250): a failed connect or a lost connection (exit
      2), the timer `T_L`, a 55P03 or a 57014, and every other end that names
      no SQLSTATE - exit 1, a signal, an exit 3 with none, or an answer that
      cannot be read, an empty one included;
    - `unsent`: never handed to a `psql` that could take it - none on PATH,
      or one too old - which no later try would change."""
    try:
        out = store.request(register_lookup_request(store.schema, ident, not_after), "lookup")
    except PsqlFailed as failure:
        if not failure.ran and not failure.timer_expired:
            return "unsent", None, failure, None
        err = register_definitive_error(failure)
        if err is None or err.sqlstate in REGISTER_LOOKUP_RETRIED:
            return "again", None, failure, err
        return "refused", None, failure, err
    except StoreUnusable as exc:
        return "unsent", None, PsqlFailed(exc.kind, exc.detail, ran=False), None
    answer = register_lookup_answer(out)
    if answer is None:
        # `ascii` keeps a blank line, a trailing space or a case visible, and
        # escapes every byte outside printable ASCII.
        return "again", None, PsqlFailed(
            "unreadable", f"the answer was {ascii(out[:80])}, not `{_REGISTER_LOOKUP_ABSENT}` "
            f"alone or a seq with its workstation=, utc= and file rows", psql_exit=0), None
    return ("absent" if answer[0] is None else "found"), answer, None, None


def _register_lookup_how(failure: PsqlFailed, err: RegisterError | None) -> tuple[bool, str]:
    """How a try with no answer ended, as a few words for the tries' tally,
    and whether that end shows the try did not take the head row's lock: a
    55P03 or a 57014, a failed connect (`psql`'s exit 2), or the timer `T_L`
    (Y:5245, with 57014 as `T_L`'s counterpart). Exit 1, a signal, an exit 3
    naming no SQLSTATE and an answer that cannot be read do not show it."""
    if err is not None:
        return err.sqlstate in REGISTER_LOOKUP_RETRIED, err.sqlstate
    if failure.timer_expired:
        return True, "the client timer's cut"
    code = failure.psql_exit
    if code == 2:
        return True, "exit 2"
    if code is None:
        return False, "no exit status"
    if code < 0:
        return False, f"signal {-code}"
    if code == 0:
        return False, f"exit 0 with an answer {PROG} cannot read"
    if code == 3:
        return False, "exit 3 naming no SQLSTATE"
    return False, f"exit {code}"


def _register_lookup_end(ident: dict, kind: str, answer: tuple | None,
                         failure: PsqlFailed | None, err: RegisterError | None,
                         ends: list[tuple[bool, str]]) -> int:
    """What the lookup's last try prints, and its code (contract §3.4's exits;
    §2.6's stderr): on stdout, 0, for absent, and for found: `found <seq>`,
    then `workstation=<w>` and `utc=<epoch>` (lane 3's ruling on T418, #165
    6770688147, item 1), then the `file=` rows; LR007's `ERROR:` and
    `DETAIL:` lines, 2; and 3, the pending record kept, for LR011, any other
    SQLSTATE, a call never sent, and no try that gave an answer.

    `ends` holds `_register_lookup_how` for each try that gave no answer, in
    order. Where none gave one, contract §3.4's line, "no try took the head
    row's lock", is printed only where it is true, every try having ended in
    a way that shows it; otherwise the line says how the tries ended."""
    write = ident["write_id"]
    kept = (f"write {write} stays in doubt: keep its pending record, and look it up again "
            f"under the same id")
    if kind == "found":
        seq, workstation, utc, rows = answer
        say(f"found {seq}")
        say(f"workstation={workstation}")
        say(f"utc={utc}")
        for row in rows:
            say("file=" + "\t".join(row))
        return EXIT_OK
    if kind == "absent":
        say("absent")
        return EXIT_OK
    if kind == "refused":
        code = REGISTER_LOOKUP_EXITS.get(err.sqlstate, EXIT_IN_DOUBT)
        register_say_error(err)
        if code == EXIT_REFUSED:
            note(f"journal: write {write} is refused by the register ({err.sqlstate}"
                 + (f" {err.detail}" if err.detail else "") + "): under this id it cannot "
                 "commit in this database; check the mirror for it")
        elif err.sqlstate == "LR011":
            note(f"journal: the lookup of write {write} was too early (LR011), so it proves "
                 f"nothing: {kept}")
        else:
            note(f"journal: the lookup of write {write} was refused with {err.sqlstate}, "
                 f"which settles nothing: {kept}")
        return code
    if kind == "unsent":
        note(f"journal: the lookup of write {write} {register_psql_end(failure)}: {kept}")
        return EXIT_IN_DOUBT
    tries = len(ends)
    if all(without_lock for without_lock, _how in ends):
        note(_REGISTER_LOOKUP_NO_LOCK)
    else:
        tally: dict = {}
        for _without_lock, how in ends:
            tally[how] = tally.get(how, 0) + 1
        note(f"{_REGISTER_LOOKUP_NO_ANSWER}: {tries} {'try' if tries == 1 else 'tries'}, "
             f"ended in " + ", ".join(f"{how} ({count})" for how, count in tally.items()))
    note(f"journal: write {write}: {tries} {'try' if tries == 1 else 'tries'}, the last of "
         f"which {register_psql_end(failure)}" + (f" ({err.sqlstate})" if err else "")
         + f"; {kept}")
    return EXIT_IN_DOUBT


def _register_journal_lookup(values: dict, started: float) -> int:
    """`journal --write-id …` (contract §3.4; Y:5235-5255): the client's own
    wait, then `find_write`'s tries inside the window.

    A refused configuration is 3, the pending record kept, R09's TLS refusal
    included, since the lookup proved nothing (CO-3); Q6(c)'s refusal of
    `mode=primary` alone is 2, as on every command (Y:2452)."""
    ident = {"write_id": _register_lower(values["--write-id"]),
             "generation": _register_lower(values["--generation"]),
             "lane": values["--lane"], "verb": values["--verb"],
             "args_sha256": values["--args-sha256"]}
    not_after = int(values["--not-after"])
    try:
        cfg = load_config()
        store = PostgresStore(cfg, "register_writer")
    except PrimaryNotBuilt as exc:
        note(f"REFUSED: {exc}")
        return EXIT_REFUSED
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        note(f"journal: nothing was looked up, so write {ident['write_id']} stays in doubt: "
             f"keep its pending record")
        return EXIT_IN_DOUBT
    clock = (int(values["--clock"]), int(values["--clock-age"])) if "--clock" in values else None
    kind, answer, failure, err, ends = register_lookup(store, ident, not_after, clock, started)
    return _register_lookup_end(ident, kind, answer, failure, err, ends)


def register_lookup(store: PostgresStore, ident: dict, not_after: int, clock: tuple | None,
                    started: float) -> tuple:
    """F3'S LOOKUP (Y:5235-5255), the client's own wait and then `find_write`'s
    tries inside the window, as `journal --write-id` makes it, for any caller
    that holds a store: `(kind, answer, failure, err, ends)`, which
    `_register_lookup_end` reads (`_register_lookup_try`'s first four, and the
    tally of the tries that gave no answer). `clock` is `(the database's
    clock, its age in seconds)` as a snapshot last read it, or None; `started`
    is the `time.monotonic()` instant that age is counted from. S2's two ways
    out (T324) make it in doubt, as a writer does (D8)."""
    # 1. THE CLIENT WAITS FIRST, on its own estimate of the database's clock:
    # `--clock` + `--clock-age` + the seconds since this command started, on
    # the monotonic clock. It calls once that puts `<n>` at most 2 s ahead
    # (Y:5236). The estimate only lags the database, so the wait only grows,
    # and an early estimate costs at most LR011 (lane 4's answer 36). The wait
    # is at most `C` + 2 s (contract §3.4), so a clock far behind `<n>` ends
    # in LR011's 3, never in a wait with no end. With no clock, it calls at
    # once.
    if clock is not None:
        ahead = not_after - REGISTER_LOOKUP_AHEAD_S - clock[0] - clock[1]
        _register_sleep_until(started + min(max(ahead, 0), store.bounds("commit")[1] + 2))
    # 2. THE WINDOW opens where that wait ends (Y:5247), and closes 10 s on.
    # A try that ends with no answer is made again: at least 1 s after the
    # last one STARTED, never before it ENDED, and only where that is still
    # inside the window, its 10 s mark included (lane 4's answer 40).
    opened = time.monotonic()
    closes = opened + REGISTER_LOOKUP_WINDOW_S
    start, ends = opened, []
    while True:
        _register_sleep_until(start)
        began = time.monotonic()
        kind, answer, failure, err = _register_lookup_try(store, ident, not_after)
        ended = time.monotonic()
        if kind != "again":
            break
        ends.append(_register_lookup_how(failure, err))
        start = max(began + REGISTER_LOOKUP_SPACING_S, ended)
        if start > closes:
            break
    return kind, answer, failure, err, ends


def _register_read_failed(what: str, failure: StoreUnusable) -> int:
    """A failed read of `journal --since` or `--last`: 69 (contract §2.7),
    with the database's `ERROR:` and `DETAIL:` lines first where it refused
    (§2.6)."""
    if isinstance(failure, PsqlFailed):
        register_say_error(register_definitive_error(failure))
        note(f"{what}: the read {register_psql_end(failure)}; nothing is answered")
    else:
        note(f"{what}: {failure.kind}: {failure.detail}; nothing is answered")
    return EXIT_UNAVAILABLE


def _register_one(rows: list, what: str) -> str:
    """The one value of a one-row, one-column answer, or `StoreUnusable`."""
    if len(rows) != 1 or len(rows[0]) != 1 or rows[0][0] is None:
        raise StoreUnusable("unreadable", f"the answer holds no one {what}")
    return rows[0][0]


def _register_bool(value) -> bool | None:
    """A boolean as COPY's text form writes it: `t`, `f`, or NULL."""
    if value is None:
        return None
    if value not in ("t", "f"):
        raise ValueError(f"{value!r} is not a boolean")
    return value == "t"


def register_since_queries(since: int) -> list[str]:
    """`journal --since <m>`'s reads, in one snapshot (contract §3.6): the
    generation, the head, then every entry above `m` with its edits and its
    files, in seq order."""
    return ["SELECT generation FROM register_switch WHERE id = 1",
            "SELECT seq FROM register_head WHERE id = 1",
            "SELECT seq, extract(epoch FROM utc)::bigint, author, operator, message "
            f"FROM journal WHERE seq > {since} ORDER BY seq",
            "SELECT seq, ord, op, path, line_no, old_sha256, new_text, to_path "
            f"FROM journal_edits WHERE seq > {since} ORDER BY seq, ord",
            "SELECT seq, path, CASE WHEN present THEN '1' ELSE '0' END, coalesce(sha256, '-') "
            f"FROM journal_files WHERE seq > {since} ORDER BY seq, path"]


def register_since_lines(answers: list) -> list[str]:
    """`journal --since`'s stdout (contract §3.6): `format=1`, `generation=`,
    `n=`, then one `entry=<JSON>` line per entry, compact and pure ASCII, with
    the keys `seq`, `utc` (epoch seconds), `author`, `operator`, `message`,
    `edits` (`journal_edits`' rows, Y:1598's shape) and `files` (`[path,
    present, sha256]`, §3.2's canonical values: `1` or `0`, and `-` where the
    path is not present). `StoreUnusable` where an answer cannot be read."""
    if len(answers) != 5:
        raise StoreUnusable("unreadable", f"{len(answers)} answers, not 5")
    generations, heads, entries, edit_rows, file_rows = answers
    generation = _register_one(generations, "generation")
    if not _REGISTER_UUID_RE.fullmatch(generation):
        raise StoreUnusable("unreadable", "the switch's generation is not a uuid")
    try:
        head = int(_register_one(heads, "head"))
        edits: dict = {}
        for row in edit_rows:
            seq, ordinal, op, path, line_no, old_sha256, new_text, to_path = row
            edits.setdefault(int(seq), []).append(
                {"ord": int(ordinal), "op": op, "path": path,
                 "line_no": None if line_no is None else int(line_no),
                 "old_sha256": old_sha256, "new_text": new_text, "to_path": to_path})
        files: dict = {}
        for row in file_rows:
            seq, path, present, sha256 = row
            files.setdefault(int(seq), []).append([path, present, sha256])
        lines = ["format=1", f"generation={generation}", f"n={head}"]
        for row in entries:
            seq, utc, author, operator, message = row
            entry = {"seq": int(seq), "utc": int(utc), "author": author,
                     "operator": _register_bool(operator), "message": message,
                     "edits": edits.get(int(seq), []), "files": files.get(int(seq), [])}
            lines.append("entry=" + json.dumps(entry, ensure_ascii=True,
                                               separators=(",", ":")))
    except (ValueError, TypeError) as exc:
        raise StoreUnusable("unreadable", f"a row cannot be read ({exc})")
    return lines


def _register_journal_since(since: int) -> int:
    """`journal --since <m>` (contract §3.6): one REPEATABLE READ READ ONLY
    snapshot, as REGISTER-WRITER, the renderer's role (Y:3459), with D9's
    renderer row. Exits 0; 69 for a failed read; 2 for a refused
    configuration, Q6(c)'s included (Y:2452)."""
    try:
        cfg = load_config()
        store = PostgresStore(cfg, "register_writer")
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return EXIT_REFUSED
    try:
        lines = register_since_lines(
            store._query_many(register_since_queries(since), snapshot=True, row="render"))
    except StoreUnusable as failure:
        return _register_read_failed("journal --since", failure)
    for line in lines:
        say(line)
    return EXIT_OK


def register_last_queries(path: str, at: int | None) -> list[str]:
    """`journal --last`'s reads, in one snapshot (contract §3.6): the head;
    the generation; the import entries' seqs; and the edits and the
    `journal_files` rows of `path` and of every path whose history reaches it
    by renames (`src`), at or below `--at`'s `n` where it is given.

    `src`'s first row carries `COLLATE "C"`, the collation of
    `journal_edits.path`, which a recursive query's two halves must share."""
    bound = "" if at is None else f" AND e.seq <= {at}"
    src = (f"WITH RECURSIVE src(p) AS (SELECT CAST({_pg_quote(path)} AS text) COLLATE \"C\" "
           "UNION SELECT e.path FROM journal_edits e JOIN src ON e.to_path = src.p "
           f"WHERE e.op = 'rename'{bound}) ")
    return ["SELECT seq FROM register_head WHERE id = 1",
            "SELECT generation FROM register_switch WHERE id = 1",
            "SELECT seq FROM journal WHERE kind = 'import'"
            + ("" if at is None else f" AND seq <= {at}") + " ORDER BY seq",
            src + "SELECT e.seq, e.ord, e.op, e.path, e.line_no, e.old_sha256, e.new_text, "
            f"e.to_path FROM journal_edits e WHERE e.path IN (SELECT p FROM src){bound} "
            "ORDER BY e.seq, e.ord",
            src + "SELECT f.seq, f.path, f.present, f.sha256, f.final_newline FROM journal_files f "
            "WHERE f.path IN (SELECT p FROM src)"
            + ("" if at is None else f" AND f.seq <= {at}") + " ORDER BY f.seq, f.path"]


def register_last_rows(answers: list) -> tuple:
    """`journal --last`'s answers, read: (the head, the generation, the
    import seqs, the edits as (seq, ord, op, path, line_no, old_sha256,
    new_text, to_path), the files as (seq, path, present, sha256,
    final_newline)). `StoreUnusable` where one cannot be read."""
    if len(answers) != 5:
        raise StoreUnusable("unreadable", f"{len(answers)} answers, not 5")
    heads, generations, import_rows, edit_rows, file_rows = answers
    generation = _register_one(generations, "generation")
    if not _REGISTER_UUID_RE.fullmatch(generation):
        raise StoreUnusable("unreadable", "the switch's generation is not a uuid")
    try:
        head = int(_register_one(heads, "head"))
        imports = [int(row[0]) for row in import_rows]
        edits = []
        for row in edit_rows:
            seq, ordinal, op, path, line_no, old_sha256, new_text, to_path = row
            edits.append((int(seq), int(ordinal), op, path,
                          None if line_no is None else int(line_no), old_sha256, new_text,
                          to_path))
        files = []
        for row in file_rows:
            seq, path, present, sha256, final_newline = row
            files.append((int(seq), path, _register_bool(present), sha256,
                          _register_bool(final_newline)))
    except (ValueError, TypeError, IndexError) as exc:
        raise StoreUnusable("unreadable", f"a row cannot be read ({exc})")
    return head, generation, imports, edits, files


class RegisterReplayError(Exception):
    """The journal's edits of a path do not replay: an edit that cannot apply
    to the image the edits before it left, a line whose text is not the
    edit's `old_sha256`, or an image whose digest is not its `journal_files`
    row's. `journal --last` then answers nothing (69), never a wrong rank."""


def _register_image(state: list) -> bytes:
    """A replayed file's bytes, as `render_file` renders it: its lines joined
    by LF, and one LF more where `final_newline` holds and it has a line."""
    lines, final_newline = state[0], state[1]
    return ("\n".join(lines) + ("\n" if final_newline and lines else "")).encode(
        "utf-8", "surrogateescape")


def _register_replay_edit(state: dict, edit: tuple, hits) -> None:
    """Apply one `journal_edits` row to the replayed files, as
    `commit_write`'s step 6 applies it. Each file is [its lines, its
    final_newline, the key's count in it]; `hits` counts the key in a line."""
    seq, ordinal, op, path, line_no, old_sha256, new_text, to_path = edit
    where = f"seq {seq} edit {ordinal} ({op} {path})"
    image = state.get(path)
    if op == "create":
        if image is not None:
            raise RegisterReplayError(f"{where}: the file exists")
        state[path] = [[], True, 0]
        return
    if image is None:
        raise RegisterReplayError(f"{where}: the file does not exist")
    lines = image[0]
    if op == "append":
        if new_text is None or (line_no is not None and line_no != len(lines) + 1):
            raise RegisterReplayError(f"{where}: not an append at line {len(lines) + 1}")
        lines.append(new_text)
        image[2] += hits(new_text)
    elif op in ("replace", "delete"):
        if line_no is None or not 1 <= line_no <= len(lines):
            raise RegisterReplayError(f"{where}: there is no line {line_no}")
        old = lines[line_no - 1]
        if hashlib.sha256(old.encode("utf-8", "surrogateescape")).hexdigest() != old_sha256:
            raise RegisterReplayError(f"{where}: line {line_no} is not its old_sha256")
        image[2] -= hits(old)
        if op == "delete":
            del lines[line_no - 1]
        elif new_text is None:
            raise RegisterReplayError(f"{where}: a replace with no new text")
        else:
            lines[line_no - 1] = new_text
            image[2] += hits(new_text)
    elif op == "rename":
        # The file moves whole. Its new path may be one this replay does not
        # follow, whose own edits it was not sent, so whatever it held there
        # is overwritten: only `src`'s paths are replayed exactly.
        if not to_path:
            raise RegisterReplayError(f"{where}: a rename with no to_path")
        state[to_path] = state.pop(path)
    elif op == "remove":
        del state[path]
    else:
        raise RegisterReplayError(f"{where}: an op this replay does not know")


def register_pickaxe(path: str, key: str, edits: list, files: list,
                     imports: list) -> int | None:
    """`journal --last`'s match (C7): the newest entry whose edits change the
    number of times `key` occurs, AS A FIXED STRING, in `path`, or None where
    no entry does. `key` is never a regex.

    That is git's `-S` pickaxe as `swapped_lanes`' rank reads it
    (`code/lanes-edit.sh:9087`, pin 2a057a6d): the count is taken in the
    file's bytes before and after each entry, non-overlapping from the left
    as git's `contains()` counts, so an edit that keeps the count does not
    match. A file an entry removes or renames away counts 0 after it, and one
    it renames in counts what it brings, since git's pathspec sees no rename.

    The images come from the journal alone: every imported line is a
    `create` or `append` edit, so the journal renders any seq from the import
    on (Y:5319; the kinds table's `import` row), and an import starts from no
    files. `edits` and `files` are `journal_edits`' and `journal_files`' rows
    of `path` and of every path whose history reaches it by renames, as
    `register_last_rows` reads them; `imports` the import entries' seqs.
    Every replace and delete is checked against its `old_sha256`, and
    `path`'s image at the end against its last digest, so a replay that went
    wrong raises `RegisterReplayError` and never gives a rank."""
    needle = os.fsencode(key)
    # A KEY ACROSS LINES is counted in the whole file; any other key's count
    # is the sum of its lines', kept as each edit applies.
    whole = b"\n" in needle

    def hits(text: str) -> int:
        return 0 if whole else text.encode("utf-8", "surrogateescape").count(needle)

    def occurs(state: dict) -> int:
        image = state.get(path)
        if image is None:
            return 0
        return _register_image(image).count(needle) if whole else image[2]

    edits_at: dict = {}
    for edit in edits:
        edits_at.setdefault(edit[0], []).append(edit)
    files_at: dict = {}
    for row in files:
        files_at.setdefault(row[0], []).append(row)
    marks = set(imports)
    state: dict = {}
    found = None
    for seq in sorted(set(edits_at) | set(files_at) | marks):
        before = occurs(state)
        if seq in marks:
            state.clear()
        for edit in sorted(edits_at.get(seq, []), key=lambda e: e[1]):
            _register_replay_edit(state, edit, hits)
        for _seq, row_path, present, _sha256, final_newline in files_at.get(seq, []):
            if present and final_newline is not None and row_path in state:
                state[row_path][1] = final_newline
        if occurs(state) != before:
            found = seq
    # THE PROOF: `path`'s image at the end is its last `journal_files` row's
    # since the latest import, or absent where it has none.
    floor = max(marks) if marks else None
    last = None
    for row in files:
        if row[1] == path and (floor is None or row[0] >= floor) and (
                last is None or row[0] >= last[0]):
            last = row
    image = state.get(path)
    if last is None or not last[2]:
        if image is not None:
            raise RegisterReplayError(f"{path} is present after the replay, and its last "
                                      f"journal_files row says it is not")
    elif image is None or hashlib.sha256(_register_image(image)).hexdigest() != last[3]:
        raise RegisterReplayError(f"{path} does not replay to its digest at seq {last[0]}")
    return found


def _register_journal_last(values: dict) -> int:
    """`journal --last --path <p> --grep <key> [--at <n> --generation <g>]`
    (contract §3.6; C7, C8): one REPEATABLE READ READ ONLY snapshot, as
    READER, with D9's reader row. It prints `format=1`, `n=` - `--at`'s `n`,
    or the journal's own head - and `seq=<k>` where an entry at or below `n`
    matches (`register_pickaxe`); with none, no `seq=` line, and the caller
    keeps 999999999. Under `--at`, a generation that differs, or an `n`
    above the head, ends 69 (lane 5's NIT, #165 6741787745). Exits as
    `journal --since`: 0, 69, 2 and 64."""
    path, key = values["--path"], values["--grep"]
    at = int(values["--at"]) if "--at" in values else None
    try:
        cfg = load_config()
        store = PostgresStore(cfg, "register_reader")
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return EXIT_REFUSED
    try:
        head, generation, imports, edits, files = register_last_rows(
            store._query_many(register_last_queries(path, at), snapshot=True, row="read"))
    except StoreUnusable as failure:
        return _register_read_failed("journal --last", failure)
    n = head
    if at is not None:
        wanted = _register_lower(values["--generation"])
        if wanted != generation:
            note(f"journal --last: --generation {wanted} is not the register's, {generation}: "
                 f"its n= is another register generation's; nothing is answered")
            return EXIT_UNAVAILABLE
        if at > head:
            note(f"journal --last: --at {at} is above the journal's head, {head}; nothing is "
                 f"answered")
            return EXIT_UNAVAILABLE
        n = at
    try:
        seq = register_pickaxe(path, key, edits, files, imports)
    except RegisterReplayError as exc:
        note(f"journal --last: the journal does not replay {path}: {exc}; nothing is answered")
        return EXIT_UNAVAILABLE
    say("format=1")
    say(f"n={n}")
    if seq is not None:
        say(f"seq={seq}")
    return EXIT_OK


def cmd_journal(args: list[str]) -> int:
    """`lanes-index journal` (contract §3.4 and §3.6; FR-016; L1-A12): the
    in-doubt lookup by write id, `--since`'s history and `--last`'s pickaxe.
    The argv comes first, 64 before anything is read; then the form's own
    configuration, store and reads. `started` is read before anything else,
    so the lookup's estimate leaves out only the interpreter's own start: a
    lag, which only lengthens the client's wait."""
    started = time.monotonic()
    try:
        parsed = _register_journal_args(args)
    except _RegisterUsage as exc:
        note(str(exc))
        for line in _REGISTER_JOURNAL_USAGE:
            note(f"usage: {line}")
        return EXIT_USAGE
    if parsed is None:
        say(USAGE)
        return EXIT_OK
    form, values = parsed
    if form == "write-id":
        return _register_journal_lookup(values, started)
    if form == "since":
        return _register_journal_since(int(values["--since"]))
    return _register_journal_last(values)


# ============================================================ local status

def _status_path() -> str:
    return os.path.join(state_dir(), "lanes-index.status.json")


def read_status() -> dict:
    try:
        with open(_status_path(), encoding="utf-8") as handle:
            data = json.load(handle)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def write_status(source: str, **fields) -> None:
    """This workstation's own record of its last attempt, which the store
    cannot hold for an attempt that could not reach it."""
    try:
        os.makedirs(state_dir(), mode=0o700, exist_ok=True)
        data = read_status()
        entry = data.get(source, {})
        entry.update(fields)
        data[source] = entry
        tmp = _status_path() + f".{os.getpid()}"
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(data, handle, indent=1, sort_keys=True)
        os.chmod(tmp, 0o600)
        os.replace(tmp, _status_path())
    except OSError:
        pass


class SyncLock:
    """ONE SYNC AT A TIME PER WORKSTATION (14(d)). A second sync that finds the
    lock held leaves a RERUN mark and returns at once - the holder syncs again
    before it lets go - so a burst of writes is one or two syncs, never a
    queue of them, and no nudge ever waits."""

    def __init__(self):
        self.path = os.path.join(state_dir(), "lanes-index.lock")
        self.rerun = os.path.join(state_dir(), "lanes-index.rerun")
        self.handle = None

    def acquire(self, wait_seconds: float) -> bool:
        try:
            import fcntl
        except ImportError:
            return True
        os.makedirs(state_dir(), mode=0o700, exist_ok=True)
        self.handle = open(self.path, "a+")
        try:
            os.chmod(self.path, 0o600)
        except OSError:
            pass
        deadline = time.monotonic() + wait_seconds
        while True:
            try:
                fcntl.flock(self.handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                return True
            except OSError:
                if time.monotonic() >= deadline:
                    self.handle.close()
                    self.handle = None
                    return False
                time.sleep(0.2)

    # ONE MARK PER SOURCE (opensoft/openRepoTools#161). The holder syncs again
    # for every mark it finds, and a mark says WHICH source asked: a register
    # sync holding the lock when an inventory write's nudge arrives syncs the
    # inventory before it lets go, rather than the register a second time. The
    # register's mark keeps the name it has always had.
    KINDS = ("register", "inventory")

    def rerun_path(self, kind: str = "register") -> str:
        return self.rerun if kind == "register" else f"{self.rerun}-{kind}"

    def mark_rerun(self, kind: str = "register") -> None:
        try:
            with open(self.rerun_path(kind), "w", encoding="utf-8") as handle:
                handle.write(utc_now() + "\n")
        except OSError:
            pass

    def take_rerun(self, kind: str = "register") -> bool:
        try:
            os.unlink(self.rerun_path(kind))
            return True
        except OSError:
            return False

    def take_reruns(self) -> list:
        return [kind for kind in self.KINDS if self.take_rerun(kind)]

    def has_rerun(self) -> bool:
        return any(os.path.exists(self.rerun_path(kind)) for kind in self.KINDS)

    def release(self) -> None:
        if self.handle is not None:
            self.handle.close()
            self.handle = None


# ===== the SQL register: status, reconcile and sync on primary (007)
#
# #160'S `status`, `reconcile` AND `sync` ON THE SQL REGISTER'S SIDE (feature
# 007, opensoft/openRepoTools#165; T117, FR-048, L1-A15; design Y:4853 and
# Y:4854; contracts/exit-codes.md §3.4). #160's own lines and exits stay as
# they were: a configuration with no `register_url=` prints and exits exactly
# as before, and so does every `reconcile` and `sync` on `mode=index`.
#
# STATUS, where `register_url=` is configured, in either mode, prints the
# register's block after #160's sources (`status_register`). It makes ONE
# request as this engineer's READER, on D9's `status` row (Y:3528), in one
# read-only snapshot: the readers' schema window, the switch, the journal's
# head `n` and the generation, the mirror state (D16), the resolved strays, and
# the journal's answer for each pending record's write id (D8, F10). The
# mirror's `m` is the newest `Register-Seq` on `origin/<branch>` as last
# fetched in the workspace checkout, read by T121's `mirror_register_seq`;
# `status` never fetches. Where SQL answers, the walk passes over each resolved
# stray, a commit a `stray-import` or `stray-revert` entry names, whose
# `Register-Seq` does not count (Y:2848-2850); where it does not, `m` is form
# C's first value, and `status` says so (lane 3's item 5). Then the
# pending records under `<state>/register-pending/`, and the declaration
# `register-outage`, which it reports as left in place while the database
# answers (ops §2.5). Each read records the head it found in
# `<state>/register-head`, so a `status` that cannot read the register prints
# `m` and that last head, `h`, or "unknown" (ops §2.3, the disaster path's
# step 4), and exits 69 (Y:3528). The service's lines are lane 5's T512, after
# these (R44).
#
# RECONCILE, on `mode=primary` and for the register's source, checks the mirror
# against SQL and writes nothing (`reconcile_register`; Y:4854). It compares the
# render set at `R`, the commit on `origin/<branch>` that carries `m`, with each
# render-set path's latest `journal_files` digest at or below `m`. It names
# each commit after `R` that changes the render set and carries no
# `Register-Seq` (Y:2921-2930), and counts the seqs the mirror lacks. It makes
# one request as READER, on D9's renderer row, which `reconcile` shares
# (Y:3527). A resolved stray is passed over when `m` is found and set aside
# after `R`, as in `status`; where the walk's first value is a resolved
# stray's, the walk runs again past them and the request is made again, at
# most `RECONCILE_READS` in all. A mirror that differs is reported with 0
# (exit-codes.md §3.4, [P]). The re-render is lane 3's T325, in phase 3.
#
# SYNC of the register's source on `mode=primary` does nothing and says so
# (`sync_register_on_primary`). It makes no `psql` call, takes no lock and
# writes no file: the mirror is never indexed back into the database it came
# from (Y:1031; Y:2976-2978). The inventory's sync is unchanged.

#: THE LAST HEAD `status` READ (ops §2.3, the disaster path's step 4; ops:511;
#: config.md §6.2), in the state directory: `format=1`, `database=`,
#: `generation=`, `head=` and `utc=`, one per line, 0600, by temp file and
#: rename. A `status` that cannot read the register prints it as `h`, beside
#: the mirror's `m`. `outage declare` (T121) writes it as `last-head=`, through
#: `read_register_last_head`, where its `database=` is the declaration's; T304's
#: `rollback` can, through `register_outage_text(last_head=...)`.
REGISTER_HEAD_FILE = "register-head"

#: THE PENDING RECORDS (F10; Y:5171-5172): `<state>/register-pending/<d>`, where
#: `<d>` is 64 lower hex. Claim files (`<d>.take.<k>`) and temp files are
#: passed over.
REGISTER_PENDING_DIR = "register-pending"
_REGISTER_PENDING_NAME_RE = re.compile(r"[0-9a-f]{64}")

#: THE RENDER SET IN A TREE (Q18(A); Y:2924-2926), as `git` takes it: the four
#: paths, with `lanes/log/README.md` left out. `lanes/STORE`, the marker, is
#: set aside, as the rollback's proof sets it aside (ops §2.3, step 3).
REGISTER_RENDER_PATHSPECS = (REGISTER_PATH, ALIASES_PATH, "lanes/archive/", LOG_PREFIX)
REGISTER_RENDER_EXCLUDED = "lanes/log/README.md"

#: How many of `reconcile`'s differences it names, one per line. It counts the
#: rest.
RECONCILE_SHOWN = 100

#: The indent of a continuation line in `status`'s blocks, under the value.
_REGISTER_INDENT = " " * 15


def _register_shown(value, limit: int = 200) -> str:
    """`value` as one printable line: each C0 or C1 control character, DEL,
    U+2028 and U+2029 as `?`, and at most `limit` characters."""
    text = re.sub(r"[\x00-\x1f\x7f-\x9f\u2028\u2029]", "?", "" if value is None else str(value))
    return text if len(text) <= limit else text[:limit] + "..."


def _register_utc(column: str) -> str:
    """A `timestamptz` column as `YYYY-MM-DDTHH:MM:SSZ`, whatever `TimeZone`
    the session has: this build's register calls set none."""
    return f"to_char({column} AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"')"


#: THE RESOLVED STRAYS (Y:2848-2850): the commits a `stray-import` or
#: `stray-revert` entry names in `git_commit`. Each is resolved, and its
#: `Register-Seq`, if it carries one, does not count when `m` is found.
_REGISTER_RESOLVED_QUERY = ("SELECT git_commit FROM journal WHERE kind IN ('stray-import', "
                            "'stray-revert') AND git_commit IS NOT NULL ORDER BY seq")


def _register_state_queries() -> list[str]:
    """The five reads every register state read starts with: the readers'
    schema window (§1.5), the switch (S1), the head `n` and the mirror state
    (D16), each one row; and the resolved strays, a row each
    (`_REGISTER_RESOLVED_QUERY`)."""
    return [
        "SELECT version, writers_from, readers_from FROM schema_version WHERE id = 1",
        f"SELECT mode, marker_state, marker_seq, marker_commit, generation, repository, "
        f"database_label, {_register_utc('set_utc')}, set_seq, set_by_lane, set_by_ws "
        f"FROM register_switch WHERE id = 1",
        "SELECT seq FROM register_head WHERE id = 1",
        f"SELECT diverged_sha, {_register_utc('found_utc')}, found_by_ws, last_error, "
        f"{_register_utc('last_error_utc')} FROM mirror_state WHERE id = 1",
        _REGISTER_RESOLVED_QUERY]


def _register_state_of(answers: list) -> dict:
    """`_register_state_queries`' five answers as one dict, the resolved
    strays as `resolved`, a frozenset of commits. A missing row, or a value
    that is not what its column holds, is `RegisterUnavailable`."""
    version = _register_one_row(answers[0], 3, "schema_version")
    switch = _register_one_row(answers[1], 11, "register_switch")
    head = _register_one_row(answers[2], 1, "register_head")
    mirror = _register_one_row(answers[3], 5, "mirror_state")
    if not all(len(row) == 1 and isinstance(row[0], str) and SHA_RE.match(row[0])
               for row in answers[4]):
        raise RegisterUnavailable("psql answered a resolved stray's commit this build cannot "
                                  "read: not 40 lower hex")
    resolved = frozenset(row[0] for row in answers[4])
    try:
        return {"version": int(version[0]), "writers_from": int(version[1]),
                "readers_from": int(version[2]),
                "mode": switch[0] or "", "marker": switch[1] or "",
                "marker_seq": None if switch[2] is None else int(switch[2]),
                "marker_commit": switch[3] or "", "generation": (switch[4] or "").lower(),
                "repository": switch[5] or "", "label": switch[6] or "",
                "set_utc": switch[7] or "", "set_seq": int(switch[8]),
                "set_by_lane": switch[9] or "", "set_by_ws": switch[10] or "",
                "n": int(head[0]),
                "diverged": mirror[0] or "", "found_utc": mirror[1] or "",
                "found_by_ws": mirror[2] or "", "last_error": mirror[3] or "",
                "last_error_utc": mirror[4] or "", "resolved": resolved}
    except (TypeError, ValueError):
        raise RegisterUnavailable("psql answered a register state this build cannot read: "
                                  "a number that is not one")


def _register_read_failure(exc: StoreUnusable) -> str:
    """Why a register read did not answer, with nothing secret in it
    (contract §2.6): its timer, nothing sent, or `psql`'s exit and its first
    line on stderr."""
    if isinstance(exc, PsqlFailed):
        if exc.timer_expired:
            return f"no answer within its client timer: {exc.detail}"
        if not exc.ran:
            return f"nothing was sent: {exc.detail}"
        return f"psql exited {exc.psql_exit}: {exc.first_line or exc.detail}"
    return f"nothing was sent: {exc.detail}"


def register_state_read(cfg: dict, row: str, extra: list[str] | None = None) -> tuple:
    """ONE register read as this engineer's READER (Y:2317; Y:3460), on D9's
    `row`, in one REPEATABLE READ READ ONLY snapshot, sent as one request
    (contract §2.3): `_register_state_queries`, then `extra`. The state
    carries the resolved strays as `resolved`, the skip set
    `mirror_register_seq` takes (Y:2848-2850).

    Returns `(state, extra's answers, "")`. Where the register cannot be read,
    it returns `(None, [], why)`: no answer, a failed statement, a missing row,
    or a schema outside the readers' window (§1.5; Y:2338), whose answer is
    then not used. Each is 69 to `status` and `reconcile` (D10; Y:3527;
    Y:3528)."""
    queries = _register_state_queries() + list(extra or [])
    try:
        store = PostgresStore(cfg, "register_reader")
        answers = store._query_many(queries, snapshot=True, row=row)
        if len(answers) != len(queries):
            raise RegisterUnavailable(f"psql answered {len(answers)} of the {len(queries)} "
                                      f"reads of one snapshot")
        state = _register_state_of(answers)
    except StoreUnusable as exc:
        return None, [], _register_read_failure(exc)
    except RegisterUnavailable as exc:
        return None, [], str(exc)
    refusal = register_version_refusal(state["version"], state["writers_from"],
                                       state["readers_from"], write=False)
    if refusal:
        return None, [], f"{refusal}; nothing it read is shown (Y:2338)"
    return state, answers[len(_register_state_queries()):], ""


def _register_store_name(cfg: dict) -> str:
    """The register's database, without a credential (contract §2.6): this
    host's `register_label=`, or else the host and database `reader_url=`
    names."""
    if cfg["register_label"]:
        return f"database {_register_shown(cfg['register_label'])}"
    env = pg_url_env(cfg["reader_url"], "`reader_url=`")
    return (f"database {_register_shown(env.get('PGDATABASE') or '(the default)')} at "
            f"{_register_shown(env.get('PGHOST') or '(the default host)')}")


def _register_mirror(root: str, unread: str = "",
                     skip: frozenset[str] | None = None) -> dict:
    """`m`, the newest `Register-Seq` on `origin/<branch>` as last fetched in
    the checkout `root`, and the commit `R` carrying it, by T121's
    `mirror_register_seq`, the walk bounded by `LANES_GIT_TIMEOUT`. Nothing is
    fetched. `why` says why there is no `m`: `unread` where `root` itself
    could not be found, `unread: ...` where git failed, and `no-seq: ...`
    where no commit carries one.

    `skip` is the resolved strays SQL named (`state["resolved"]`), or None
    where SQL did not answer, and `m` is then form C's first value
    (Y:2848-2850; lane 3's item 5). `passed` lists `(commit, value)` for each
    resolved stray the walk passed over that carries a `Register-Seq`, and
    the text names them."""
    if not root:
        return {"m": None, "commit": "", "why": f"unread: {unread or 'no workspace checkout'}",
                "text": f"unread - {unread or 'no workspace checkout'}", "passed": []}
    timeout = mirror_git_timeout()
    passed: list = []
    try:
        m, commit = mirror_register_seq(root, None if timeout is None
                                        else time.monotonic() + timeout,
                                        skip=skip, passed=passed)
    except StoreUnusable as exc:
        return {"m": None, "commit": "", "why": f"{exc.kind}: {exc.detail}",
                "text": f"{exc.kind} - {exc.detail}", "passed": passed}
    text = (f"Register-Seq {m} at {commit[:12]}, origin/{branch()} as last fetched in {root} "
            f"(not fetched here)")
    if passed:
        text += (f"; {len(passed)} resolved stray commit(s) newer than it, whose Register-Seq "
                 f"does not count (Y:2848-2850), passed over: "
                 + _register_commits([f"{sha[:12]} (Register-Seq {_register_shown(value, 40)})"
                                      for sha, value in passed]))
    return {"m": m, "commit": commit, "why": "", "text": text, "passed": passed}


def _register_commits(items: list[str]) -> str:
    """At most `RECONCILE_SHOWN` of `items`, joined, and how many more."""
    return (", ".join(items[:RECONCILE_SHOWN])
            + (f", and {len(items) - RECONCILE_SHOWN} more" if len(items) > RECONCILE_SHOWN
               else ""))


def register_head_path() -> str:
    """`<state>/register-head`, the last head `status` read."""
    return os.path.join(state_dir(), REGISTER_HEAD_FILE)


def read_register_last_head() -> dict | None:
    """The last head `status` recorded: `format`, `database`, `generation`,
    `head` (an int) and `utc`. None where none is recorded, or the file cannot
    be read as one."""
    try:
        with open(register_head_path(), "rb") as handle:
            text = handle.read(4096).decode("utf-8")
    except (OSError, UnicodeDecodeError):
        return None
    fields: dict = {}
    for line in text.split("\n"):
        key, eq, value = line.partition("=")
        if eq and key not in fields:
            fields[key] = value
    if fields.get("format") != "1" or not re.fullmatch(r"-?[0-9]+", fields.get("head", "")):
        return None
    fields["head"] = int(fields["head"])
    return fields


def record_register_head(state: dict) -> None:
    """Records the head `state` read, by temp file and rename in a 0700 state
    directory (T121's `write_register_outage`, which writes any such file).
    Raises `OSError`."""
    text = "".join(f"{key}={_register_shown(value)}\n" for key, value in (
        ("format", 1), ("database", state["label"]), ("generation", state["generation"]),
        ("head", state["n"]), ("utc", utc_now())))
    os.makedirs(state_dir(), mode=0o700, exist_ok=True)
    write_register_outage(register_head_path(), text)


def register_pending_records() -> tuple[str, list, str]:
    """The pending records (F10; Y:5171-5172), each as a dict: `name`, its
    file name, `<d>`; `fields`, its first value of each key; `calls`, how many
    `call` lines it holds; `write_id`, lower-cased; `id_ok`, whether that is
    a UUID; and `error`, why it could not be read, or "". Returns `(the
    directory, the records by name, why the directory could not be listed or
    "")`. Only lane 4's writers write them; this reads and changes nothing."""
    directory = os.path.join(state_dir(), REGISTER_PENDING_DIR)
    try:
        names = sorted(os.listdir(directory))
    except FileNotFoundError:
        return directory, [], ""
    except OSError as exc:
        return directory, [], f"{directory} cannot be listed ({exc.strerror or exc})"
    records = []
    for name in names:
        if not _REGISTER_PENDING_NAME_RE.fullmatch(name):
            continue
        rec = {"name": name, "fields": {}, "calls": 0, "write_id": "", "id_ok": False,
               "error": ""}
        records.append(rec)
        path = os.path.join(directory, name)
        try:
            if not stat.S_ISREG(os.lstat(path).st_mode):
                raise ValueError("it is not a regular file")
            with open(path, "rb") as handle:
                text = handle.read(1 << 20).decode("utf-8")
        except FileNotFoundError:
            rec["error"] = "it was removed while it was read"
            continue
        except OSError as exc:
            rec["error"] = f"it cannot be read ({exc.strerror or exc})"
            continue
        except ValueError as exc:
            rec["error"] = str(exc) if not isinstance(exc, UnicodeDecodeError) else "it is not UTF-8"
            continue
        for line in text.split("\n"):
            key, eq, value = line.partition("=")
            if not eq:
                continue
            if key == "call":
                rec["calls"] += 1
            elif key not in rec["fields"]:
                rec["fields"][key] = value
        rec["write_id"] = rec["fields"].get("write_id", "").lower()
        rec["id_ok"] = bool(UUID_FULL_RE.match(rec["write_id"]))
    return directory, records, ""


def _register_pending_query(ids: list[str]) -> str:
    """The journal's answer for each write id: its seq, lane, verb and
    `args_sha256`. `ids` are UUIDs."""
    return ("SELECT write_id, seq, lane, verb, args_sha256 FROM journal WHERE write_id IN ("
            + ", ".join(f"{_pg_quote(i)}::uuid" for i in ids) + ") ORDER BY seq")


def _register_pending_line(rec: dict, state: dict | None, found: dict) -> str:
    """One pending record, and what the journal says of its write id (test
    plan's AT-D8: `status` lists each record and reports whether its id is in
    the journal)."""
    shown = _register_shown
    if rec["error"]:
        return f"{rec['name'][:12]}: cannot be read: {shown(rec['error'])}"
    f = rec["fields"]
    what = (f"{rec['name'][:12]}: write {shown(f.get('write_id') or '?', 40)}, lane "
            f"{shown(f.get('lane') or '?', 80)}, verb {shown(f.get('verb') or '?', 40)}, made "
            f"{shown(f.get('created_utc') or '?', 40)}, {rec['calls']} call line(s)"
            f"{' - in doubt' if rec['calls'] else ''}, tail {shown(f.get('tail') or 'none', 80)}")
    generation = (f.get("generation") or "").lower()
    if not rec["id_ok"]:
        verdict = "its write_id is not a UUID, so it was not looked up"
    elif state is None:
        verdict = "not looked up, since the register cannot be read"
    elif generation and generation != state["generation"]:
        verdict = (f"of generation {shown(generation, 40)}, and this register is "
                   f"{state['generation']}: a plain rerun refuses it; look for its effect, "
                   f"then rerun with LANES_WRITE_ID=new (F10)")
    elif rec["write_id"] in found:
        row = found[rec["write_id"]]
        if (row[2], row[3], row[4] or "") == (f.get("lane"), f.get("verb"),
                                              f.get("args_sha256") or ""):
            verdict = f"in the journal at seq {row[1]}"
        else:
            verdict = (f"its id is in the journal at seq {row[1]}, for another write (lane "
                       f"{shown(row[2], 80)}, verb {shown(row[3], 40)})")
    else:
        verdict = f"not in the journal at n {state['n']}"
    return f"{what}: {verdict}"


def _register_outage_lines(cfg: dict, state: dict | None) -> list[str]:
    """The declaration beside `lanes-index.conf` (D20; config.md §6), as
    `status` reports it: none, one not well formed, or its fields and what
    they mean here. While the database answers, one present is LEFT IN PLACE,
    to be ended at once (ops §2.5, "How it ends")."""
    path = register_outage_path(cfg)
    try:
        fields = read_register_outage(path)
    except ValueError as exc:
        return [f"a file that is not a well-formed declaration is at {path} ({exc}): no "
                f"guard honours it, and `{PROG} outage clear` removes it"]
    if fields is None:
        return [f"none declared ({path})"]
    shown = _register_shown
    if fields["kind"] == "word":
        lines = [f"declared outage on Brett's word, at {fields['utc']} on "
                 f"{shown(fields['host'], 80)}, until {fields['until']}, for database "
                 f"{shown(fields['database'], 80)}, mirror-seq {fields['mirror-seq']}: "
                 f"\"{shown(fields['why'], 400)}\" ({path})"]
    else:
        lines = [f"declared outage from a rollback, at {fields['utc']} on "
                 f"{shown(fields['host'], 80)}, for database {shown(fields['database'], 80)}, "
                 f"mirror-seq {fields['mirror-seq']} (the rollback's head), with no expiry "
                 f"({path})"]
    if fields["database"] != cfg["register_label"]:
        lines.append(f"it names database {shown(fields['database'], 80)}, and this host's "
                     f"register_label= is {shown(cfg['register_label'] or '(unset)', 80)}: no "
                     f"guard here honours it")
    if fields["kind"] == "word" and fields["until"] <= utc_now():
        lines.append(f"it expired at {fields['until']}, so every guard ignores it")
    if state is None:
        lines.append("the database cannot be read from here, so on mode=primary a guard may "
                     "answer from the mirror under it (SVC-12)")
    elif fields["kind"] == "rollback" and state["mode"] == "files":
        lines.append("left in place while the database answers, with the switch at `files`: "
                     "the rollback's step 6 ends it (operations.md §2.3)")
    else:
        lines.append(f"left in place while the database answers: end it with `{PROG} outage "
                     f"clear` on each configured workstation (operations.md §2.5)")
    return lines


def status_register(cfg: dict, root: str, root_unread: str = "") -> int:
    """`status`'s register block (Y:4853; exit-codes.md §3.4), printed where
    `register_url=` is configured: the switch, `n`, the generation, the
    mirror's last `Register-Seq` and the lag, `diverged at`, the renderer's
    last failed pass, the pending records and a declaration left in place.
    Returns 0, or 69 where the register cannot be read or its timer expires;
    it then prints `m` and the last head recorded here, and the lag from them
    where it can (Y:3528; ops §2.3, step 4)."""
    directory, records, unlisted = register_pending_records()
    ids = sorted({rec["write_id"] for rec in records if rec["id_ok"]})
    state, answers, why = register_state_read(cfg, "status",
                                              [_register_pending_query(ids)] if ids else [])
    found = {}
    if state is not None and ids:
        for row in answers[0]:
            if len(row) == 5 and row[0]:
                found[row[0].lower()] = row
    say(f"register: {_register_store_name(cfg)} (mode={cfg['mode']}; schema "
        f"{cfg['register_schema']})")
    # WHERE SQL ANSWERS, the resolved strays it names are passed over when `m`
    # is found; where it does not, `m` is form C's first value, said below
    # (Y:2848-2850; lane 3's item 5).
    mirror = _register_mirror(root, root_unread, None if state is None else state["resolved"])
    m = mirror["m"]
    if state is None:
        say(f"  read:        the register cannot be read - {_register_shown(why, 400)}")
        say("  n:           unknown, since the register cannot be read")
        last = read_register_last_head()
        if last is None:
            say(f"  last head:   unknown: no head is recorded at {register_head_path()}")
        else:
            say(f"  last head:   {last['head']}, recorded by status at "
                f"{_register_shown(last.get('utc') or '?', 40)} (database "
                f"{_register_shown(last.get('database') or '?', 80)}, generation "
                f"{_register_shown(last.get('generation') or '?', 40)})")
        say(f"  mirror:      {mirror['text']}")
        if m is not None:
            say(f"{_REGISTER_INDENT}m is form C's first value: the register cannot be read, so "
                f"no resolved stray's Register-Seq was passed over (Y:2848-2850)")
        if last is None or m is None:
            lag = "unknown: it needs the mirror's m and a recorded head"
        elif last["head"] >= m:
            lag = (f"at least {last['head'] - m} seq(s): the last head recorded here, "
                   f"{last['head']}, less the mirror's {m}")
        else:
            lag = (f"unknown: the mirror's {m} is past the last head recorded here, "
                   f"{last['head']}")
        say(f"  lag:         {lag}")
    else:
        try:
            record_register_head(state)
        except OSError as exc:
            note(f"status: the head could not be recorded at {register_head_path()} "
                 f"({exc.strerror or exc})")
        marker = f"marker {state['marker']}"
        if state["marker_seq"] is not None:
            marker += f" (seq {state['marker_seq']}" + (
                f", commit {state['marker_commit'][:12]})" if state["marker_commit"] else ")")
        say(f"  switch:      {state['mode']}, {marker}; set at seq {state['set_seq']} on "
            f"{state['set_utc']} by {_register_shown(state['set_by_lane'], 80)} on "
            f"{_register_shown(state['set_by_ws'], 80)}")
        label = (f"  database:    {_register_shown(state['label'], 80)}, repository "
                 f"{_register_shown(state['repository'], 120)}")
        if state["label"] != cfg["register_label"]:
            label += (f"; this host's register_label= is "
                      f"{_register_shown(cfg['register_label'] or '(unset)', 80)}")
        say(label)
        say(f"  n:           {state['n']}" + (", the journal is empty" if state["n"] < 0 else ""))
        say(f"  generation:  {state['generation']}")
        say(f"  mirror:      {mirror['text']}")
        if m is None:
            lag = "unknown, since the mirror's m cannot be read here (the mirror line says why)"
        elif m <= state["n"]:
            lag = f"{state['n'] - m} seq(s): n {state['n']} less the mirror's {m}"
        else:
            lag = (f"none, and the mirror's {m} is past n {state['n']}: at primary a divergence "
                   f"the renderer records (R2's N6); at files, (ii')'s marker-first window")
        say(f"  lag:         {lag}")
        if state["diverged"]:
            say(f"  divergence:  diverged at {state['diverged']} (found {state['found_utc']} by "
                f"{_register_shown(state['found_by_ws'], 80)}): resolve it with `{PROG} import "
                f"--single <sha>` or `{PROG} render --revert <sha>` (D16)")
        else:
            say("  divergence:  none recorded")
        if state["last_error"]:
            say(f"  renderer:    its last failed pass, at {state['last_error_utc']}: "
                f"{_register_shown(state['last_error'], 400)}")
        else:
            say("  renderer:    no failed pass recorded")
    if unlisted:
        say(f"  pending:     unread - {unlisted}")
    elif not records:
        say(f"  pending:     none in {directory}")
    else:
        say(f"  pending:     {len(records)} record(s) in {directory}")
        for rec in records:
            say(f"    {_register_pending_line(rec, state, found)}")
    outage = _register_outage_lines(cfg, state)
    say(f"  outage:      {outage[0]}")
    for line in outage[1:]:
        say(f"{_REGISTER_INDENT}{line}")
    return EXIT_OK if state is not None else EXIT_UNAVAILABLE


def _register_render_set(root: str, sha: str) -> dict:
    """The render set in the tree of commit `sha`: each path's sha256, the
    digest `journal_files` holds (S2), or None for an entry that is not a
    file. `StoreUnusable` where git cannot read it."""
    proc = git(root, "ls-tree", "-r", "-z", sha, "--", *REGISTER_RENDER_PATHSPECS)
    entries = []
    for entry in proc.stdout.split("\0"):
        if not entry:
            continue
        meta, _, path = entry.partition("\t")
        if path == REGISTER_RENDER_EXCLUDED:
            continue
        parts = meta.split()
        entries.append((path, parts[2] if len(parts) == 3 and parts[1] == "blob" else ""))
    blobs = cat_blobs(root, [obj for _path, obj in entries if obj])
    return {path: (hashlib.sha256(blobs[obj]).hexdigest() if obj in blobs else None)
            for path, obj in entries}


def _register_strays(root: str, commit: str, tip: str) -> tuple[list[str], int]:
    """The commits after `commit` on `tip`'s first-parent line that change
    the render set, and how many commits come after it. None of them carries
    a `Register-Seq` that counts, since `commit` is the newest that does, so
    none is a render commit (Y:2921-2930). A resolved stray among them, which
    may carry one, is its caller's to set aside (`reconcile_register`;
    Y:2848-2850)."""
    count = git(root, "rev-list", "--first-parent", "--count", f"{commit}..{tip}")
    proc = git(root, "-c", "log.showSignature=false", "log", "--first-parent", "--format=%H",
               f"{commit}..{tip}", "--", *REGISTER_RENDER_PATHSPECS,
               f":(exclude){REGISTER_RENDER_EXCLUDED}")
    try:
        after = int(count.stdout.strip())
    except ValueError:
        after = 0
    return [line for line in proc.stdout.split("\n") if SHA_RE.match(line)], after


#: How many register reads `reconcile` makes at most (Y:2848-2850; lane 3's
#: item 5). Each read names the resolved strays. Only where the commit
#: carrying the walk's first value is one of them does the walk run again,
#: past them, and the read follow again at the `m` it then finds; a third
#: covers a stray resolved between the two. Past that the check is not made,
#: and `reconcile` exits 69.
RECONCILE_READS = 3


def _reconcile_mirror(root: str, tip: str, unread: StoreUnusable | None,
                      skip: frozenset[str] | None) -> tuple[dict, dict | None, list, int]:
    """One pass of `reconcile`'s git half: `_register_mirror`'s `m` and `R`,
    past the resolved strays `skip` names; the render set at `R`, or None;
    the commits after `R` that change it; and how many commits follow `R`.
    `unread` is why the checkout could not be found, and then nothing is
    read."""
    if unread is not None:
        return ({"m": None, "commit": "", "why": f"{unread.kind}: {unread.detail}",
                 "text": f"{unread.kind} - {unread.detail}", "passed": []}, None, [], 0)
    mirror = _register_mirror(root, skip=skip)
    if mirror["m"] is None:
        return mirror, None, [], 0
    try:
        mine = _register_render_set(root, mirror["commit"])
        strays, after = _register_strays(root, mirror["commit"], tip)
    except StoreUnusable as exc:
        mirror["why"] = f"{exc.kind}: {exc.detail}"
        mirror["text"] += f"; its render set cannot be read - {exc.kind}: {exc.detail}"
        return mirror, None, [], 0
    return mirror, mine, strays, after


def _reconcile_settled(mirror: dict, resolved: frozenset[str]) -> bool:
    """Whether the walk that found `mirror` took the value it takes past
    `resolved`: its `R` is not a resolved stray, and each commit it passed
    over is one."""
    return (mirror["commit"] not in resolved
            and all(sha in resolved for sha, _value in mirror["passed"]))


def reconcile_register(cfg: dict, requested: str | None, dry_run: bool) -> int:
    """`reconcile` on `mode=primary`, for the register's source: the mirror
    checked against SQL, READ-ONLY (Y:4854; exit-codes.md §3.4). Nothing is
    written, and no lock is taken, here or in the database.

    THE RESOLVED STRAYS (Y:2848-2850; lane 3's item 5): the read names them,
    the walk passes over their `Register-Seq` when it finds `m`, and the
    commits after `R` leave them out, each named as set aside. The names come
    with the read, which is made at `m`, so where the walk's first value is a
    resolved stray's, the walk runs again past them and the read is made
    again: one read in the usual case, and at most `RECONCILE_READS`.

    Exits 0 once the check is made, whatever it found: a mirror that differs
    is reported on stdout ([P]). 69 where the register cannot be read or its
    timer expires (D10; Y:3527). #160's 1 where the mirror's checkout cannot
    be read. 2 for a `--source` that is not this workstation's register.
    Where the workspace root is unknown, a `--source register:<...>` cannot
    be checked against this workstation's register, and it says it went
    unchecked (lane 3's item 2)."""
    root, tip = "", ""
    source = requested or "the register's source"
    unread: StoreUnusable | None = None
    unchecked = False
    try:
        root = workspace_root()
    except StoreUnusable as exc:
        unread, unchecked = exc, bool(requested)
    if unread is None:
        try:
            source = resolve_source(requested, root)
            tip = tip_of(root)
        except StoreUnusable as exc:
            unread = exc
    skip: frozenset[str] | None = None
    for _read in range(RECONCILE_READS):
        mirror, mine, strays, after = _reconcile_mirror(root, tip, unread, skip)
        m, commit = mirror["m"], mirror["commit"]
        after_m = -2 if m is None else m
        extra = [f"SELECT min(seq), max(seq), count(*) FILTER (WHERE seq > {after_m}), "
                 f"count(*) FILTER (WHERE seq > {after_m} AND operator) FROM journal"]
        if mine is not None:
            extra.append(f"SELECT DISTINCT ON (path) path, present, sha256 FROM journal_files "
                         f"WHERE seq <= {m} AND path <> 'lanes/STORE' ORDER BY path, seq DESC")
        state, answers, why = register_state_read(cfg, "render", extra)
        if state is None or _reconcile_settled(mirror, state["resolved"]):
            break
        skip = state["resolved"]
    else:
        state, why = None, (f"the resolved strays the journal names moved the mirror's m at "
                            f"each of {RECONCILE_READS} reads, so no m was settled to compare "
                            f"at (Y:2848-2850)")
    if state is not None:
        try:
            summary = _register_one_row(answers[0], 4, "the journal's extent")
            first = None if summary[0] is None else int(summary[0])
            lacks, operators = int(summary[2]), int(summary[3])
        except (RegisterUnavailable, TypeError, ValueError) as exc:
            state, why = None, (str(exc) if isinstance(exc, RegisterUnavailable) else
                                "psql answered a journal extent this build cannot read")
    say(f"{PROG} reconcile: {source} on primary - the mirror against the SQL register, "
        f"read-only{' - DRY RUN' if dry_run else ''}")
    if unchecked:
        say(f"  source:      {_register_shown(requested)} went unchecked: the workspace root is "
            f"unknown here (the mirror line says why), so whether it names this "
            f"workstation's register was not checked")
    say(f"  mirror:      {mirror['text']}"
        + (f"; the tip is {tip[:12]}" if tip and commit and tip != commit else ""))
    nothing = "nothing was written: this check is read-only"
    if state is None:
        say(f"  register:    cannot be read - {_register_shown(why, 400)}")
        say(f"  result:      the check could not be made; {nothing}")
        return EXIT_UNAVAILABLE
    say(f"  register:    switch {state['mode']}, marker {state['marker']}; n {state['n']}; "
        f"generation {state['generation']}")
    if state["diverged"]:
        recorded = (f"diverged at {state['diverged']} (found {state['found_utc']} by "
                    f"{_register_shown(state['found_by_ws'], 80)})")
    else:
        recorded = "none recorded"
    if mine is None:
        say(f"  divergence:  {recorded}")
        if mirror["why"].startswith("no-seq") and mirror["passed"]:
            say(f"  result:      the mirror carries no Register-Seq that counts, past the "
                f"resolved strays it passed over (Y:2848-2850; the mirror line says why), so it "
                f"has no seq to be compared at; {nothing}")
            return EXIT_OK
        if mirror["why"].startswith("no-seq"):
            say(f"  result:      the mirror carries no Register-Seq, so it has no seq to be "
                f"compared at, and it is no mirror of this register; {nothing}")
            return EXIT_OK
        say(f"  result:      the mirror cannot be read, so it was not compared; {nothing}")
        return 1
    differences, rows = [], []
    if first is None:
        compared = f"none: the journal is empty, and the mirror is at seq {m}"
        differences.append("the journal is empty")
    elif m > state["n"]:
        compared = (f"none: the mirror's {m} is past n {state['n']}, at primary a divergence "
                    f"the renderer records (R2's N6)")
        differences.append(f"the mirror's Register-Seq {m} is past n {state['n']}")
    elif m < first:
        compared = (f"none: the journal begins at seq {first}, after the mirror's {m}, so SQL "
                    f"holds no images at {m}")
        differences.append(f"the journal begins after seq {m}")
    else:
        sql = {row[0]: row[2] for row in answers[1] if len(row) == 3 and row[1] == "t"}
        for path in sorted(set(sql) | set(mine)):
            if path not in mine:
                rows.append(f"missing   {_register_shown(path)}: in SQL at seq {m}, not on the "
                            f"mirror")
            elif path not in sql:
                rows.append(f"extra     {_register_shown(path)}: on the mirror, not in SQL at "
                            f"seq {m}")
            elif mine[path] != sql[path]:
                rows.append(f"differs   {_register_shown(path)}: the mirror's sha256 "
                            f"{(mine[path] or 'not a file')[:12]}, SQL's {sql[path][:12]}")
        total = len(set(sql) | set(mine))
        if rows:
            compared = f"{len(rows)} of {total} render-set path(s) differ:"
            differences.append(f"{len(rows)} path(s) at seq {m}")
        else:
            compared = f"{total} render-set path(s), each equal on the mirror and in SQL"
    label = f"at seq {m}:"
    say(f"  {label}{' ' * max(1, 13 - len(label))}{compared}")
    for line in rows[:RECONCILE_SHOWN]:
        say(f"    {line}")
    if len(rows) > RECONCILE_SHOWN:
        say(f"    and {len(rows) - RECONCILE_SHOWN} more")
    # A RESOLVED STRAY AFTER `R` IS SET ASIDE (Y:2848-2850; lane 3's item 5):
    # a stray-import or stray-revert entry names it, so it is no difference.
    set_aside = [sha for sha in strays if sha in state["resolved"]]
    strays = [sha for sha in strays if sha not in state["resolved"]]
    aside = (f"{len(set_aside)} resolved stray commit(s), which a stray-import or stray-revert "
             f"entry names, set aside (Y:2848-2850): {_register_commits(set_aside)}"
             if set_aside else "")
    if strays:
        say(f"  after it:    {len(strays)} of the {after} commit(s) after {commit[:12]} change "
            f"the render set and carry no Register-Seq, so none is a render commit: "
            + _register_commits(strays) + (f"; and {aside}" if aside else ""))
        differences.append(f"{len(strays)} stray commit(s) after seq {m}")
    elif aside:
        say(f"  after it:    {after} commit(s) after {commit[:12]}, none of them changing the "
            f"render set but {aside}")
    else:
        say(f"  after it:    {after} commit(s) after {commit[:12]}, none of them changing the "
            f"render set")
    if m <= state["n"]:
        span = f" ({m + 1} to {state['n']})" if lacks else ""
        say(f"  lag:         {lacks} seq(s) the mirror lacks{span}, {operators} of them operator "
            f"entries")
    say(f"  divergence:  {recorded}")
    if differences:
        say(f"  result:      the mirror differs from SQL ({'; '.join(differences)}); {nothing}, "
            f"and a divergence is resolved on a person's word (D16; operations.md §2.3)")
    elif state["diverged"]:
        say(f"  result:      the mirror equals SQL at seq {m}, and the divergence recorded "
            f"stands until a person resolves it (D16); {nothing}")
    else:
        say(f"  result:      the mirror equals SQL at seq {m}; {nothing}, and T325 re-renders "
            f"what the mirror lacks, in phase 3")
    return EXIT_OK


