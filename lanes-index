#: such as `post-index-change`, run by a build (NIT-5 of lane 3's review of
#: T322).
_RENDER_BUILD_PINS = ("-c", "core.autocrlf=false", "-c", "i18n.commitEncoding=UTF-8",
                      "-c", "commit.gpgSign=false", "-c", "gc.auto=0",
                      "-c", "maintenance.auto=false", "-c", "core.splitIndex=false",
                      "-c", "core.sparseCheckout=false", "-c", "core.precomposeUnicode=false",
                      "-c", "core.hooksPath=/dev/null")
