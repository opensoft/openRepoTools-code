def lanes_edit_path() -> str:
    """`$LANES_EDIT`, else the `lanes-edit.sh` beside this file, else PATH -
    the order `lanes` already finds its reader in."""
    named = os.environ.get("LANES_EDIT", "")
    if named:
        return named
    here = os.path.join(os.path.dirname(os.path.realpath(__file__)), "lanes-edit.sh")
    if os.access(here, os.X_OK):
        return here
    return shutil.which("lanes-edit.sh") or ""


def helper_env() -> dict:
    """The environment `lanes-edit.sh` is run in from here: the caller's own,
    with the fetch, GitHub and the index switched off. This process reads what
    landed and reaches no network, and a helper run from inside the indexer
    must never start an indexer."""
    env = dict(os.environ)
    env["LANES_NO_FETCH"] = "1"
    env["LANES_NO_GITHUB"] = "1"
    env["LANES_INDEX"] = "off"
    return env


def workspace_root() -> str:
    helper = lanes_edit_path()
    if not helper:
        raise StoreUnusable("unread", "no lanes-edit.sh beside this file or on PATH, so the "
                            "workspace repository cannot be found (Amendment 9(a))")
    proc = subprocess.run([helper, "workspace-root"], capture_output=True, text=True,
                          check=False, env=helper_env(), stdin=subprocess.DEVNULL)
    root = proc.stdout.strip()
    if proc.returncode != 0 or not root:
        why = (proc.stderr.strip().splitlines() or ["no answer"])[0]
        raise StoreUnusable("unread", f"`lanes-edit.sh workspace-root` exited "
                            f"{proc.returncode}: {why}")
    return root


def _norm_repo(text: str) -> str:
    u = text.strip()
    if u.endswith(".git"):
        u = u[:-4]
    for prefix in ("https://github.com/", "ssh://git@github.com/", "git@github.com:",
                   "http://github.com/"):
        if u.startswith(prefix):
            return u[len(prefix):]
    return u


def source_of(root: str) -> str:
    """`register:<owner/repo>` - the `repository:` this workstation's
    `workspace.yaml` names, which is how every lane helper names the workspace
    (Amendment 9(a)); its checkout's `origin` where that file does not answer."""
    yaml = os.path.join(_agents_root(), "workspace.yaml")
    repo = ""
    try:
        with open(yaml, encoding="utf-8") as handle:
            for raw in handle:
                m = re.match(r"^repository:[ \t]*(.*)$", raw.rstrip("\n"))
                if m:
                    repo = re.sub(r"[ \t]*#.*$", "", m.group(1)).strip().strip("\"'")
                    break
    except OSError:
        repo = ""
    if not repo:
        proc = git(root, "remote", "get-url", "origin", check=False)
        repo = proc.stdout.strip()
    repo = _norm_repo(repo) or os.path.basename(root)
    return f"register:{repo}"


def branch() -> str:
    return os.environ.get("LANES_BRANCH") or "main"


def git(root: str, *args: str, check: bool = True, data: bytes | None = None,
        text: bool = True) -> subprocess.CompletedProcess:
    proc = subprocess.run(["git", "-C", root, *args], capture_output=True,
                          check=False, input=data, text=text if data is None else False,
                          stdin=None if data is not None else subprocess.DEVNULL)
    if check and proc.returncode != 0:
        err = proc.stderr if isinstance(proc.stderr, str) else proc.stderr.decode("utf-8", "replace")
        raise StoreUnusable("unread", f"git {' '.join(args)} failed in {root}: "
                            f"{(err.strip().splitlines() or ['no message'])[-1]}")
    return proc


def tip_of(root: str) -> str:
    proc = git(root, "rev-parse", "--verify", "-q", f"refs/remotes/origin/{branch()}^{{commit}}",
               check=False)
    sha = proc.stdout.strip()
    if proc.returncode != 0 or not SHA_RE.match(sha):
        raise StoreUnusable("unread", f"{root} has no origin/{branch()}: nothing has landed "
                            f"there for the index to follow")
    return sha


def has_commit(root: str, sha: str) -> bool:
    return git(root, "cat-file", "-e", f"{sha}^{{commit}}", check=False).returncode == 0


def is_ancestor(root: str, old: str, new: str) -> bool:
    return git(root, "merge-base", "--is-ancestor", old, new, check=False).returncode == 0


def commits_between(root: str, old: str, new: str) -> int | None:
    if not has_commit(root, old):
        return None
    proc = git(root, "rev-list", "--count", f"{old}..{new}", check=False)
    try:
        return int(proc.stdout.strip())
    except ValueError:
        return None


def _decode(blob: bytes) -> str:
    return blob.decode("utf-8", "replace")


def read_snapshot(root: str, sha: str) -> dict:
    """Every file the index derives from, AS OF ONE COMMIT.

    The log list is `git ls-tree <sha> -- lanes/log/` in ITS order, which is the
    order `lanes-edit.sh`'s own published read walks them in - and that order is
    kept, because a reader built on the index has to produce the same stream."""
    snap = {"sha": sha, "register": None, "aliases": None, "archive": None, "logs": [],
            "blobs": {}}
    wanted = []
    proc = git(root, "ls-tree", "-z", sha, "--", REGISTER_PATH, ALIASES_PATH, ARCHIVE_PATH)
    for entry in proc.stdout.split("\0"):
        if not entry:
            continue
        meta, _, path = entry.partition("\t")
        _mode, kind, obj = meta.split()
        if kind != "blob":
            continue
        wanted.append((path, obj))
    logs = []
    proc = git(root, "ls-tree", "-z", sha, "--", LOG_PREFIX)
    for entry in proc.stdout.split("\0"):
        if not entry:
            continue
        meta, _, path = entry.partition("\t")
        _mode, kind, obj = meta.split()
        if kind != "blob":
            continue
        if path.rsplit("/", 1)[-1] == "README.md":
            continue
        logs.append((path, obj))
        wanted.append((path, obj))
    contents = cat_blobs(root, [obj for _path, obj in wanted])
    for path, obj in wanted:
        text = _decode(contents.get(obj, b""))
        snap["blobs"][path] = obj
        if path == REGISTER_PATH:
            snap["register"] = text
        elif path == ALIASES_PATH:
            snap["aliases"] = text
        elif path == ARCHIVE_PATH:
            snap["archive"] = text
    for order, (path, obj) in enumerate(logs):
        snap["logs"].append((path, _decode(contents.get(obj, b"")), obj, order))
    if snap["register"] is None:
        raise StoreUnusable("unread", f"{sha[:12]} carries no {REGISTER_PATH}")
    return snap


def cat_blobs(root: str, objs: list[str]) -> dict:
    """The bytes of every blob named, in ONE `git cat-file --batch`."""
    out: dict = {}
    unique = list(dict.fromkeys(objs))
    if not unique:
        return out
    proc = git(root, "cat-file", "--batch", data=("\n".join(unique) + "\n").encode(), text=False)
    buf = proc.stdout
    pos = 0
    for obj in unique:
        nl = buf.index(b"\n", pos)
        header = buf[pos:nl].decode("ascii", "replace").split()
        pos = nl + 1
        if len(header) < 3 or header[1] == "missing":
            continue
        size = int(header[2])
        out[obj] = buf[pos:pos + size]
        pos += size + 1
    return out


# ============================================================== the parsers
#
# THE LOG GRAMMAR IS `lanes-edit.sh`'s `LOG_AWK`, PORTED LINE FOR LINE. A
# parser of this file's own that disagreed with that one would make `history
# --index` print a different diary from `history`, which is the one thing the
# read flag promises it does not. Every test, every trim and every reason for
# an unreadable line below is that awk's; `tests/test_lanes_index.py` holds the
# two to one output over the same logs.

def _trim(text: str) -> str:
    return text.strip(" \t")


def file_lane(path: str) -> str:
    base = path.rsplit("/", 1)[-1]
    return re.sub(r"\.[Mm][Dd]$", "", base)


def parse_log_line(line: str):
    """None for a line the grammar skips (a comment or a blank), a dict with
    `bad` for one it cannot read, else the parsed fields."""
    if re.match(r"^[ \t]*#", line) or re.match(r"^[ \t]*$", line):
        return None
    i = line.find(" — ")
    if i < 0:
        return {"bad": 'no " — " after the verb'}
    verb = _trim(line[:i])
    rest = line[i + 3:]
    if " " in verb:
        return {"bad": f'the verb is one token: "{verb}"'}
    if not rest.startswith("lane "):
        return {"bad": 'no "lane <name>" field'}
    rest = rest[5:]
    q = rest.find(",")
    if q < 0:
        return {"bad": 'no "," after the lane'}
    written_lane = _trim(rest[:q])
    rest = _trim(rest[q + 1:])
    if not rest.startswith("session "):
        return {"bad": 'no "session <uuid>@<ws>" field'}
    rest = rest[8:]
    q = rest.find(",")
    if q < 0:
        return {"bad": 'no "," after the session'}
    sess = _trim(rest[:q])
    rest = _trim(rest[q + 1:])
    a = sess.find("@")
    uuid = sess[:a] if a >= 0 else sess
    ws = sess[a + 1:] if a >= 0 else ""
    m = UTC_RE.match(rest)
    if not m:
        return {"bad": "no YYYY-MM-DDTHH:MM[:SS]Z"}
    utc = m.group(0)
    rest = rest[m.end():]
    if not rest.startswith(","):
        return {"bad": 'no "," and object after the UTC'}
    rest = _trim(rest[1:])
    sp = rest.find(" ")
    if sp < 0:
        obj, rest = rest, ""
    else:
        obj, rest = rest[:sp], rest[sp + 1:]
    ref = payload = txt = ""
    if rest != "":
        if rest.startswith("— "):
            txt = _trim(rest[2:])
        else:
            j = rest.find(" — ")
            if j >= 0:
                txt = _trim(rest[j + 3:])
                rest = _trim(rest[:j])
            if rest.startswith("→ "):
                ref, payload = "→", _trim(rest[2:])
            elif rest.startswith("← "):
                ref, payload = "←", _trim(rest[2:])
            else:
                payload = _trim(rest)
    return {"verb": verb, "written_lane": written_lane, "uuid": uuid, "ws": ws, "utc": utc,
            "object": obj, "ref": ref, "payload": payload, "text": txt}


def payload_fields(payload: str) -> dict:
    """`payload_subfield`'s split: `; `-separated sub-fields, the first token
    the name, a quoted value taken whole, and the FIRST of a repeated name wins
    exactly as that reader's `exit` makes it."""
    fields: dict = {}
    if not payload:
        return fields
    for piece in payload.split("; "):
        name, _, value = piece.partition(" ")
        if not name or name in fields:
            continue
        value = _trim(value)
        if value.startswith('"'):
            q = value.find('"', 1)
            if q > 0:
                value = value[1:q]
        fields[name] = value
    return fields


def parse_log(path: str, text: str) -> tuple[list, list]:
    """The log's records - one per line the grammar does not skip, unreadable
    ones INCLUDED - and the warnings `LOG_AWK` prints for it."""
    lane = file_lane(path)
    records, warnings = [], []
    for ordinal, line in enumerate(text.split("\n"), 1):
        parsed = parse_log_line(line)
        if parsed is None:
            continue
        rec = {"lane": lane, "file": path, "ordinal": ordinal, "raw": line}
        if "bad" in parsed:
            rec.update(unreadable=1, unreadable_why=parsed["bad"])
            warnings.append(f"unreadable: {path}:{ordinal} ({parsed['bad']})")
        else:
            obj = parsed["object"]
            if lane and obj.startswith("lane:"):
                obj = "lane:" + lane
            rec.update(unreadable=0, unreadable_why=None, verb=parsed["verb"],
                       written_lane=parsed["written_lane"], session=parsed["uuid"],
                       workstation=parsed["ws"], utc=parsed["utc"], object=obj,
                       ref=parsed["ref"], payload=parsed["payload"],
                       free_text=parsed["text"])
        records.append(rec)
    if warnings:
        warnings.append(f"{len(warnings)} unreadable line(s) above — an append-only log is "
                        f"never rewritten, so a line no parser reads is a hold no tool will "
                        f"mention again")
    return records, warnings


def row_name(line: str) -> str | None:
    """`ROW_AWK`'s rule: a line opening with `|` whose first backticked token
    is the lane. None where the line is not a row by that rule."""
    if not line.startswith("|"):
        return None
    p1 = line.find("`")
    if p1 < 0:
        return None
    rest = line[p1 + 1:]
    p2 = rest.find("`")
    if p2 < 0:
        return None
    return rest[:p2]


def cell_state(row: str) -> str:
    """`LANES_REGISTER_INDEX_AWK`'s `cell_state`: six ` | ` from the left or it
    is not knowable which text is the state cell, and then the last piece."""
    row = row.rstrip(" \t")
    if not row.startswith("|") or not row.endswith("|"):
        return ""
    rest = row[:-1]
    for _ in range(6):
        i = rest.find(" | ")
        if i < 0:
            return ""
        rest = rest[i + 3:]
    if " | " in rest:
        return ""
    return rest


#: THE ONE CLASSIFIER'S KINDS (feature 007, FR-030; design S6 and D18). A
#: register line's kind is its own opening words, then blanks, an em dash or a
#: hyphen, and a blank. Rule 6's `LANDING` and `LANDED` and Amendment 10's
#: `HOLD` and `HOLD RELEASED` are today's four; Q17(B) adds `HOLD (refresh)`,
#: `HOLD (run id)`, `HOLD WITHDRAWN`, `HOLD EXPIRED`, `QUEUED-HOLD` and
#: `LANDING WITHDRAWN`, and F13 adds `LANDING EXPIRED`. The dash after the kind
#: keeps `HOLD (refresh) — ` from reading as `HOLD` and `LANDING EXPIRED — `
#: from reading as `LANDING`, and leaves `LANDING EXPIREDX — `,
#: `HOLD REQUESTED — ` and `QUEUED-HOLD (refresh) — ` lines of no kind.
REGISTER_KIND_RE = re.compile(
    r"^(HOLD RELEASED|HOLD WITHDRAWN|HOLD EXPIRED|HOLD \(refresh\)|HOLD \(run id\)|HOLD"
    r"|QUEUED-HOLD|LANDING EXPIRED|LANDING WITHDRAWN|LANDING|LANDED)[ \t]+(—|-)[ \t]")

#: Q17(B), kind by kind: the `slot_role` and `slot_kind` that migration 1's
#: `register_lines` holds for a line of each kind (design S6's table, and its
#: note on `register_lines.slot_kind`). A take holds its repository's `main`.
#: A close ends an open take of its own slot kind: `HOLD RELEASED`,
#: `HOLD WITHDRAWN` and `HOLD EXPIRED` the writer's `HOLD`, `LANDED` the
#: writer's `LANDING`, and `LANDING EXPIRED` the `LANDING` of the lane its
#: `for_lane` names. `HOLD (refresh)` and `HOLD (run id)` continue an open
#: `HOLD` and take nothing new; they, `QUEUED-HOLD` and `LANDING WITHDRAWN`
#: take and close nothing. `register_lines`' CHECKs still bind each row: a
#: slot needs a `repo_key`, and a landing slot a PR.
REGISTER_SLOTS: dict[str, tuple[str | None, str | None]] = {
    "HOLD": ("take", "hold"),
    "HOLD (refresh)": (None, None),
    "HOLD (run id)": (None, None),
    "HOLD RELEASED": ("close", "hold"),
    "HOLD WITHDRAWN": ("close", "hold"),
    "HOLD EXPIRED": ("close", "hold"),
    "QUEUED-HOLD": (None, None),
    "LANDING": ("take", "landing"),
    "LANDED": ("close", "landing"),
    "LANDING EXPIRED": ("close", "landing"),
    "LANDING WITHDRAWN": (None, None),
}


def parse_register_line(line: str) -> dict | None:
    """The one classifier (FR-030): a register line's kind and fields, or None
    for a line of no kind.

    The kind is the line's own first word(s), by `REGISTER_KIND_RE`; every
    other field is read the way `RULE6_AWK` reads it, best effort, because a
    `HOLD` is free text by Amendment 10(e) and the raw line is kept beside
    whatever was found. Each field is its first match, so a
    `LANDING EXPIRED`'s `lane` is its writer, whose `lane <name>` comes first.

    A `LANDING EXPIRED` alone has one field more (F13), `for_lane`: the holder
    whose `LANDING` it closes, from its first `for lane <name>`, cut as a
    `lane <name>` is cut. Its row needs the holder, the PR and the repository
    (`register_lines`' CHECKs), so a line in its shape that lacks any of the
    three is a line of no kind, None: it takes and releases nothing. Every
    other kind keeps the seven fields it had."""
    m = REGISTER_KIND_RE.match(line)
    if not m:
        return None
    fields = {"kind": m.group(1), "lane": None, "repo": None, "pr": None, "tip": None,
              "utc": None, "session": None}
    lm = re.search(r"lane ([A-Za-z0-9._-]+)", line)
    if lm:
        fields["lane"] = lm.group(1)
    pm = re.search(r"PR #([0-9]+)", line) or re.search(r"#([0-9]+)", line)
    if pm:
        fields["pr"] = pm.group(1)
    rm = re.search(r"into ([A-Za-z0-9/._-]+) main", line) or \
        re.search(r"([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+) main\b", line)
    if rm:
        fields["repo"] = rm.group(1)
    um = UTC_RE.search(line)
    if um:
        fields["utc"] = um.group(0)
    sm = re.search(r"session ([^,@ ]+)@", line)
    if sm:
        fields["session"] = sm.group(1)
    tm = re.search(r"→ ([0-9a-f]{7,40})\b", line) or re.search(r" main ([0-9a-f]{7,40})\b", line)
    if tm:
        fields["tip"] = tm.group(1)
    if fields["kind"] == "LANDING EXPIRED":
        hm = re.search(r"for lane ([A-Za-z0-9._-]+)", line)
        if not hm or fields["pr"] is None or fields["repo"] is None:
            return None
        fields["for_lane"] = hm.group(1)
    return fields


def register_utc_epoch(utc: str | None) -> int | None:
    """A register line's UTC as `utc_ts` takes it (feature 007; contract
    draft 4.10, section 3.5): the stamp `parse_register_line` found,
    `YYYY-MM-DDTHH:MM[:SS]Z`, as whole seconds since the epoch, or None where
    there is no stamp or it cannot be a time - a month 13, a day 45 or a
    February 30th, an hour 24 or more, a minute or a second 60 or more, a year
    0. A take sends this, NULL for None, and never a value filled in (design
    Y:5116): a stamp that does not parse is a take with no UTC, never a guess
    at the nearest time."""
    if not utc:
        return None
    fmt = "%Y-%m-%dT%H:%M:%SZ" if utc.count(":") == 2 else "%Y-%m-%dT%H:%MZ"
    try:
        stamp = _dt.datetime.strptime(utc, fmt)
    except ValueError:
        return None
    return int(stamp.replace(tzinfo=_dt.timezone.utc).timestamp())


def classify_register_line(line: str) -> tuple[str, str, str, str, str]:
    """`register classify`'s five fields for one register line (contract
    draft 4.10, section 3.5; lane 3's R04), each `-` where absent:

    - `<kind>`, the kind `REGISTER_KIND_RE` reads: the line's SHAPE, even
      where F13's fields are missing, so a hand-typed `LANDING EXPIRED` that
      `parse_register_line` reads as no kind is still `LANDING EXPIRED`;
    - `<slot_role>`, that kind's role in `REGISTER_SLOTS`, `take` or `close`,
      whatever fields the line lacks, and `-` for a kind that takes and
      closes nothing;
    - `<repo_key>`, `<utc_ts>` and `<lane>`: `parse_register_line`'s
      repository as the line writes it (no `repos.tsv`: alias resolution
      stays the commit's), its UTC as `register_utc_epoch` reads it, and its
      lane. Where `parse_register_line` reads no kind - a `LANDING EXPIRED`
      lacking F13's holder, PR or repository - it reads none of the three.

    Every field is ASCII with no tab: the kinds are fixed, and the
    repository and the lane are cut by `[A-Za-z0-9/._-]` and
    `[A-Za-z0-9._-]`."""
    m = REGISTER_KIND_RE.match(line)
    if not m:
        return ("-", "-", "-", "-", "-")
    kind = m.group(1)
    fields = parse_register_line(line) or {}
    epoch = register_utc_epoch(fields.get("utc"))
    return (kind, REGISTER_SLOTS[kind][0] or "-", fields.get("repo") or "-",
            "-" if epoch is None else str(epoch), fields.get("lane") or "-")


def cmd_register_classify(args: list[str]) -> int:
    """`lanes-index register classify` (contract draft 4.10, section 3.5; FR-030,
    serving FR-032; lane 3's R04): THE ONE CLASSIFIER, for `append-line`'s
    refusals on primary. `lanes-edit.sh` (lane 4's T424) pipes register lines
    in, one per LF-ended line, and reads back one line each, in order:
    `<kind>` TAB `<slot_role>` TAB `<repo_key>` TAB `<utc_ts>` TAB `<lane>`,
    as `classify_register_line` gives them. A bash copy of the classifier
    would be the second classifier design Y:6247-6249 warns of.

    So the caller refuses, with 2 and before the lock, a line whose `<kind>`
    is `LANDING EXPIRED`; a `take` whose `<utc_ts>` or `<repo_key>` is `-`;
    and a `LANDING` whose `<lane>` is `-`.

    stdin is read as bytes and cut at LF alone, so a CR stays inside its line
    and the output has exactly one line per input line; a last line with no
    LF is a line, and empty input prints nothing. An argument is usage, 64,
    before anything is read. The configuration is loaded only so that a
    refused one is refused, 2 (Q6(c)'s refusal of `mode=primary` included,
    as a `Refusal`); nothing in it is used, since the contract lets this read
    no key but `register_schema=`, and with no database call it needs none.
    It opens no store and runs no `psql`."""
    for arg in args:
        if arg in ("-h", "--help"):
            say(USAGE)
            return 0
        note(f"register classify takes no argument, and was given '{arg}': it reads "
             f"register lines on stdin - see {PROG} --help")
        return 64
    try:
        load_config()
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return 2
    stdin = getattr(sys.stdin, "buffer", None)
    lines = (stdin.read() if stdin is not None else b"").split(b"\n")
    if lines[-1] == b"":
        lines.pop()
    sys.stdout.write("".join("\t".join(classify_register_line(_decode(raw))) + "\n"
                             for raw in lines))
    sys.stdout.flush()
    return 0


# ===== the SQL register: the renderer's images (007)
#
# THE RENDERER'S PURE FUNCTION (feature 007, opensoft/openRepoTools#165; T301;
# contract §3.6, `render --images --at <k> --out <dir>`; design Y:4835's
# `render` row). It builds the render set's images at seq `k` from the journal
# alone, from the latest import's baseline on. Every imported line is a
# `create` or an `append` edit, "so the journal alone renders any seq from the
# import on" (design §1.3's kinds table). It uses no git and no checkout, and
# writes no register. It reads one REPEATABLE READ READ ONLY snapshot of
# SELECTs, as REGISTER-WRITER, with D9's renderer row. It runs while
# `RENDER_GIT_HALF` is False, and it decides nothing.
#
# The image builder, `register_images`, takes the journal's rows and returns
# the images. It is kept apart from the read, `register_render_read`, so the
# image cache (T302) can reuse it.
#
# BRINGING A CACHE FORWARD (lane 1's cache signature, opensoft/openRepoTools#165
# 6755040818, which lane 3 accepted in 6755051914): `register_cache_state`
# reads cached images back into lines, and `start=(c, state)`, on the builder
# and on the read, replays only the entries after the cache's seq `c`. The
# proof is still over every image at `k`. `render --images` itself never uses
# the cache: T111's `--tree` and T113's reads do.

#: Q18(A)'s render set (design Y:258-260): `lanes/LANES.md`, every
#: `lanes/log/<lane>.md` but `lanes/log/README.md`, `lanes/aliases.tsv` and
#: `lanes/archive/*`. This is `journal_edits`' own CHECK on a path, less
#: `lanes/STORE`, the marker file of D24's two operator entries, which is
#: never an image. `lanes/repos.tsv` is never in the journal. Each name is
#: one component that ends `.md`, so no image path leaves `<dir>`.
_RENDER_SET_RE = re.compile(r"lanes/(?:LANES\.md|aliases\.tsv|(?:archive|log)/[^/]+\.md)")

#: A control character, U+0000-U+001F or U+007F: an image whose path holds one
#: cannot be a `file=` row of one line and three fields, and ends 69 where it
#: would be written (lane 3's review of T301, SHOULD-2). Only an image at `k`
#: is refused for it, never a row the replay passes over.
_RENDER_CONTROL_RE = re.compile(r"[\x00-\x1f\x7f]")

#: The columns `register_images` takes, in each row's order: `journal`'s, and
#: `journal_edits`' and `journal_files`' as T107's migration names them.
REGISTER_RENDER_COLUMNS = {
    "journal": ("seq", "kind"),
    "journal_edits": ("seq", "ord", "op", "path", "line_no", "old_sha256", "new_text",
                      "to_path"),
    "journal_files": ("seq", "path", "present", "sha256", "final_newline"),
}


class RenderRefused(Exception):
    """A seq `render --images` cannot render, journal rows that do not replay
    to the bytes the journal proved, or images that cannot be written. It
    exits `EXIT_UNAVAILABLE`, 69, with `<dir>` as it was, per exit-codes.md's
    `render --images` 69 row: a failed read, or a `k` above the head or
    before the latest import's baseline."""


def register_render_path(path) -> bool:
    """Whether `path` is a render-set path, an image's (Q18(A); `_RENDER_SET_RE`)."""
    return (isinstance(path, str) and path != "lanes/log/README.md"
            and _RENDER_SET_RE.fullmatch(path) is not None)


def register_image_bytes(lines: list, final_newline: bool) -> bytes:
    """One file's bytes, as `render_file` builds them (design Y:1297): its
    lines joined by LF, then one more LF where `final_newline` holds and the
    file has a line. A file with no line is empty either way. The text is
    UTF-8, as `render_file`'s `convert_to(..., 'UTF8')` gives it."""
    return ("\n".join(lines) + ("\n" if final_newline and lines else "")).encode("utf-8")


def register_image_lines(data: bytes) -> tuple[list[str], bool] | None:
    """`register_image_bytes`' INVERSE: one image's bytes as its lines, cut at
    LF, and whether it ends with one; None where the bytes are not UTF-8,
    read strictly. On decoded text it is T112's `register_doc_lines`: an
    empty image is `([], True)`, and a final LF is taken off before the cut.

    The bytes do not fix the lines: `["a", ""]` with no final newline and
    `["a"]` with one both render `a` LF, and this gives the second. So the
    lines read back are the canonical ones, which may not be the database's,
    as an empty file's `[""]` with `final_newline` false is not `[]`. A
    replay from them then fails an edit or the proof (`register_images`),
    and the caller replays in full."""
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        return None
    if text == "":
        return [], True
    if text.endswith("\n"):
        return text[:-1].split("\n"), True
    return text.split("\n"), False


def register_cache_state(images: dict[str, bytes]) -> dict[str, tuple[list[str], bool]] | None:
    """THE CACHE'S IMAGES AS A START STATE (lane 1's cache signature, #165
    6755040818, which lane 3 accepted in 6755051914): `{path: bytes}`, the
    images at the cache's seq `c`, read back as `{path: (lines,
    final_newline)}` by `register_image_lines`, for `start=(c, state)` on
    `register_images` and `register_render_read`.

    It returns None, A MISS, where any image is empty or is not UTF-8, and the
    caller then replays in full. An empty image's lines are not fixed by its
    bytes: it reads back as `([], True)`, and the database may hold `[""]`
    with `final_newline` false, which an append tells apart. So an estate
    with an empty file in its render set always replays in full, which costs
    time and never correctness (lane 3's acceptance). A path that is not a
    string, or an image that is not bytes, is a miss too. The cache's
    manifest stays `<path>` TAB `<digest>`: nothing here is stored."""
    if not isinstance(images, dict):
        return None
    state = {}
    for path, data in images.items():
        if not isinstance(path, str) or not isinstance(data, bytes) or not data:
            return None
        lines = register_image_lines(data)
        if lines is None:
            return None
        state[path] = lines
    return state


def _register_apply_edit(state: dict, where: str, op, path, line_no, old_sha256, new_text,
                         to_path) -> None:
    """ONE `journal_edits` row of a render-set path, applied to `state`
    ({path: [lines, final_newline]}) as `commit_write`'s step 6 applies it to
    `files` and `doc_lines` (design §1.3.1). Its caller passes over an edit
    of a path outside the render set. An edit that step 6 would refuse with
    LR004 is a journal this function cannot replay, and it raises
    `RenderRefused`."""
    if (op == "create") == (path in state):
        raise RenderRefused(f"{where} is a {op} of {path}, which "
                            f"{'exists' if op == 'create' else 'does not exist'} there")
    if op == "create":
        # A NEW FILE IS EMPTY, WITH `final_newline` TRUE, as step 6 inserts
        # its `files` row. The entry's `journal_files` row then sets it.
        state[path] = [[], True]
        return
    lines = state[path][0]
    if op == "append":
        if new_text is None:
            raise RenderRefused(f"{where} appends no text to {path}")
        if line_no is not None and line_no != len(lines) + 1:
            raise RenderRefused(f"{where} appends at line {line_no}, and {path} has "
                                f"{len(lines)} lines")
        lines.append(new_text)
    elif op in ("replace", "delete"):
        # THE LINE MUST BE THE ONE THE ENTRY NAMED, by the sha256 of its UTF-8
        # text without its LF, at its `line_no` in the image the earlier edits
        # left (design Y:1598's `edits`).
        if (line_no is None or not 1 <= line_no <= len(lines)
                or hashlib.sha256(lines[line_no - 1].encode("utf-8")).hexdigest()
                != old_sha256):
            raise RenderRefused(f"{where}: {path} line {line_no} is not {old_sha256}")
        if op == "replace":
            if new_text is None:
                raise RenderRefused(f"{where} replaces {path} line {line_no} with no text")
            lines[line_no - 1] = new_text
        else:
            del lines[line_no - 1]
    elif op == "rename":
        if to_path in state:
            raise RenderRefused(f"{where} renames {path} to {to_path}, which exists there")
        moved = state.pop(path)
        if register_render_path(to_path):
            state[to_path] = moved
        # A rename out of the render set takes the image out with the file.
        # `journal_edits`' CHECK on `to_path` allows only render-set paths, so
        # no journal holds such a rename.
    elif op == "remove":
        del state[path]
    else:
        raise RenderRefused(f"{where} is {op!r}, which is no edit `journal_edits` holds")


def _register_render_start(start) -> tuple:
    """`start`, `(c, {path: (lines, final_newline)})`, checked and copied, as
    `(c, {path: [lines, final_newline]})`: the replay changes the copy, and
    the caller's lists stay as they were. A `start` of any other form raises
    `RenderRefused`, the caller's miss."""
    bad = RenderRefused("the start state is not (c, {path: (lines, final_newline)})")
    if not isinstance(start, (tuple, list)) or len(start) != 2:
        raise bad
    c, cached = start
    if isinstance(c, bool) or not isinstance(c, int) or not isinstance(cached, dict):
        raise bad
    state = {}
    for path, value in cached.items():
        if not isinstance(path, str) or not isinstance(value, (tuple, list)) or len(value) != 2:
            raise bad
        lines, final_newline = value
        if (not isinstance(lines, (list, tuple)) or not isinstance(final_newline, bool)
                or not all(isinstance(line, str) for line in lines)):
            raise bad
        state[path] = [list(lines), final_newline]
    return c, state


def register_images(journal, edits, files, *, start=None) -> dict:
    """THE IMAGE BUILDER (T301; contract §3.6): the render set's images after
    the last of `journal`'s entries, as `{path: bytes}`, built from the
    journal's rows alone. It reads no database, no git and no file. Each image
    is byte-identical to a full render, `render_file`'s, final newline included.

    Its arguments are the rows of the entries to replay, each a sequence in
    `REGISTER_RENDER_COLUMNS`' column order, with typed values:
    - `journal`: `(seq, kind)`, in seq order, with no gap. The first is an
      `import`, since the journal renders only from an import's baseline on;
    - `edits`: `journal_edits`' `(seq, ord, op, path, line_no, old_sha256,
      new_text, to_path)`, each `seq` among `journal`'s. They are applied in
      `ord` order;
    - `files`: `journal_files`' `(seq, path, present, sha256, final_newline)`,
      each `seq` among `journal`'s, with `present` and `final_newline` as
      bools or None.

    It replays `commit_write`'s steps 6 and 8 (design §1.3.1):
    - an `import` starts from no file, as its step 3a clears the data tables;
    - each edit of a render-set path applies as step 6 applies it;
    - each `journal_files` row that is present sets its path's
      `final_newline`, as step 8 does.
    It passes over every edit, and every present row, of a path outside the
    render set: `lanes/STORE`, the operator entries' marker, is never an
    image, and `lanes/repos.tsv` is never in the journal. A row that records
    a path absent is never refused for its path's form. Whether an image's
    path can be a `file=` row is `register_write_images`' check, at `k`
    alone (lane 3's review, SHOULD-2).

    THE PROOF, AS STEP 8'S. Each image's sha256 must equal the digest that
    its path's LATEST `journal_files` row among the rows given recorded,
    which `commit_write` proved against `render_file` when it committed.
    ONLY THAT LATEST ROW IS CHECKED: an earlier row of the same path, which a
    later one supersedes, is not re-checked, since the image after the last
    entry rests on the latest row alone. A path that row recorded as present
    must have an image. Rows that are not one gapless chain from an import,
    an edit that step 6 would refuse, and an image that fails the proof each
    raise `RenderRefused`, and nothing is returned.

    For reuse (lane 3's review, choice 6): a seq is not unique over time,
    since a re-import before a confirmed cutover replaces the root and an
    aborted cutover's seq is reused. So a caller that brings a cached image
    forward checks every image at its `n`, not only those it touched.

    BROUGHT FORWARD FROM `start` (lane 1's cache signature, #165 6755040818,
    which lane 3 accepted in 6755051914). `start` is `(c, {path: (lines,
    final_newline)})`, the render set's state at seq `c`, as
    `register_cache_state` reads it back from cached images. Given `start`:
    - `journal` holds only the entries `c+1` to `k`, in seq order with no
      gap, and none where `c` is `k`. The import-first check is dropped;
    - `edits` holds only those entries' rows;
    - `files` holds those entries' rows AND the rows from the latest import
      to `c`, as `register_render_queries(k, since=c)` reads them. The rows
      at or below `c` only SEED THE PROOF: they set no `final_newline`,
      since `start` is the state at `c`;
    - IF ANY OF THE ENTRIES IS AN IMPORT, `start` is set aside, and the
      replay begins at the latest import, as it does without `start`. Every
      row of a seq before that import is passed over.
    THE PROOF IS THE SAME, OVER EVERY IMAGE AT `k`. After the seed and the
    replay, `proved` holds every path's latest digest at or below `k`, so a
    path untouched since `c` is proven by the same row as a path touched
    since, and each of `start`'s images that no entry touched must match
    its row too. A failed proof, an edit that does not apply on `start`, and
    a `start` of another form each raise `RenderRefused`, which
    `register_render_read` takes as a miss and answers with one full replay.
    `start` itself is never changed. Without `start`, T301 is unchanged."""
    entries = [(seq, kind) for seq, kind in journal]
    if start is None:
        if not entries:
            raise RenderRefused("no journal entry was read, so there is no import to render "
                                "from")
        if entries[0][1] != "import":
            raise RenderRefused(f"seq {entries[0][0]} is a {entries[0][1]!r} entry, not an "
                                f"import: the journal alone renders only from an import's "
                                f"baseline on")
    for (seq, _kind), (later, _later_kind) in zip(entries, entries[1:]):
        if later != seq + 1:
            raise RenderRefused(f"the journal read runs from seq {seq} to seq {later}: one "
                                f"chain has no gap")
    state: dict = {}    # path -> [its lines, final_newline]
    proved: dict = {}   # path -> its latest journal_files sha256; None: recorded as absent
    below = None        # with `start`: a row at or below this seq is no entry's to replay
    seeding = False     # whether those rows seed the proof (`start` kept) or are passed over
    if start is not None:
        c, state = _register_render_start(start)
        imports = [at for at, (_seq, kind) in enumerate(entries) if kind == "import"]
        if imports:
            # AN IMPORT AMONG `c+1` TO `k` sets `start` aside: the replay
            # begins at the latest import, which clears the state anyway.
            state = {}
            below = entries[imports[-1]][0] - 1
            entries = entries[imports[-1]:]
        elif entries and entries[0][0] != c + 1:
            raise RenderRefused(f"the start state is at seq {c}, and the journal read begins "
                                f"at seq {entries[0][0]}, not {c + 1}")
        else:
            below, seeding = c, True
    seqs = {seq for seq, _kind in entries}
    edits_of: dict = {}
    files_of: dict = {}
    seeds: list = []
    for rows, by, what in ((edits, edits_of, "journal_edits"), (files, files_of, "journal_files")):
        for row in rows:
            if row[0] not in seqs:
                if below is not None and isinstance(row[0], int) and row[0] <= below:
                    if not seeding:
                        continue        # before the latest import, which clears the state
                    if what == "journal_files":
                        seeds.append(row)
                        continue
                raise RenderRefused(f"a {what} row of seq {row[0]}, which is not among the "
                                    f"entries read")
            by.setdefault(row[0], []).append(row)
    # THE SEED: each path's latest row at or below `c`, in seq order, as the
    # replay records a row below. The entries' own rows then supersede it.
    for _seq, path, present, sha256, _final_newline in sorted(seeds, key=lambda row: row[0]):
        if present:
            if register_render_path(path):
                proved[path] = sha256
        else:
            proved[path] = None
    for seq, kind in entries:
        if kind == "import":
            state.clear()
            proved.clear()
        for (_seq, ordinal, op, path, line_no, old_sha256, new_text,
             to_path) in sorted(edits_of.get(seq, ()), key=lambda row: row[1]):
            if not register_render_path(path):
                continue        # lanes/STORE's edits, and any path outside the render set
            _register_apply_edit(state, f"seq {seq} edit {ordinal}", op, path, line_no,
                                 old_sha256, new_text, to_path)
        for _seq, path, present, sha256, final_newline in files_of.get(seq, ()):
            where = f"seq {seq}'s journal_files row for {path!r}"
            if present:
                if not register_render_path(path):
                    continue    # lanes/STORE's row, and any path outside the render set
                if path not in state:
                    raise RenderRefused(f"{where} records it present, and its edits leave "
                                        f"no such file")
                if final_newline is not None:
                    state[path][1] = bool(final_newline)
                proved[path] = sha256
            else:
                if path in state:
                    raise RenderRefused(f"{where} records it absent, and its edits leave it")
                proved[path] = None
    images = {}
    for path, (lines, final_newline) in state.items():
        data = register_image_bytes(lines, final_newline)
        digest = hashlib.sha256(data).hexdigest()
        if digest != proved.get(path):
            raise RenderRefused(f"{path} replays to sha256 {digest}, and the journal recorded "
                                f"{proved.get(path) or 'no digest'} for it")
        images[path] = data
    for path, sha256 in proved.items():
        if sha256 is not None and path not in state:
            raise RenderRefused(f"the journal recorded {path} as present, and its edits leave "
                                f"no such file")
    return images


def register_render_queries(k: int, *, since=None) -> list:
    """The read's five SELECTs, for one REPEATABLE READ READ ONLY snapshot,
    in this order:
    1. `schema_version`, first, as every reader checks it (design §1.5);
    2. the head and the latest import's seq;
    3. `journal`'s rows from that import to `k`;
    4. `journal_edits`' rows over the same seqs;
    5. `journal_files`' rows over the same seqs.
    Each is SELECT only, and names its tables through the store's
    `search_path`. `k` is a whole number, which this file parsed. The latest
    import is found by walking `journal`'s key backwards, `ORDER BY seq DESC
    LIMIT 1`, rather than by `max(seq)` over every import (lane 3's review,
    NIT-2); with no import it is NULL.

    WITH `since=c` (lane 1's cache signature, #165 6755040818, which lane 3
    accepted in 6755051914), the third and the fourth read only the entries
    `c+1` to `k`, for `register_images`' `start`. The digest query, the
    fifth, is unchanged: `journal_files`' rows from the latest import to
    `k`, so every path's latest digest at or below `k` is read, and a path
    untouched since `c` is proven by the same row as a path touched since.
    `c` is a whole number, which its caller checked."""
    latest = "(SELECT i.seq FROM journal i WHERE i.kind = 'import' ORDER BY i.seq DESC LIMIT 1)"

    def span(alias: str, *, entries: bool = False) -> str:
        if entries and since is not None:
            return f"{alias}.seq > {int(since)} AND {alias}.seq <= {int(k)}"
        return f"{alias}.seq >= {latest} AND {alias}.seq <= {int(k)}"

    return [
        "SELECT version, writers_from, readers_from FROM schema_version WHERE id = 1",
        f"SELECT h.seq, {latest} FROM register_head h WHERE h.id = 1",
        f"SELECT j.seq, j.kind FROM journal j WHERE {span('j', entries=True)} ORDER BY j.seq",
        f"SELECT e.seq, e.ord, e.op, e.path, e.line_no, e.old_sha256, e.new_text, e.to_path "
        f"FROM journal_edits e WHERE {span('e', entries=True)} ORDER BY e.seq, e.ord",
        f"SELECT f.seq, f.path, f.present, f.sha256, f.final_newline FROM journal_files f "
        f"WHERE {span('f')} ORDER BY f.seq, f.path",
    ]


def _render_int(value, what: str, *, null: bool = False):
    if value is None and null:
        return None
    try:
        return int(value)
    except (TypeError, ValueError):
        raise RenderRefused(f"the register answered {value!r} for {what}, which is not a "
                            f"whole number")


def _render_bool(value, what: str):
    if value is None:
        return None
    if value in ("t", "f"):
        return value == "t"
    raise RenderRefused(f"the register answered {value!r} for {what}, which is not a boolean")


def _render_rows(answer: list, table: str) -> list:
    """`_query_many`'s rows of one SELECT, typed for `register_images`."""
    width = len(REGISTER_RENDER_COLUMNS[table])
    out = []
    for row in answer:
        if len(row) != width:
            raise RenderRefused(f"the register answered a {table} row of {len(row)} fields, "
                                f"not {width}")
        if table == "journal":
            out.append((_render_int(row[0], "journal.seq"), row[1]))
        elif table == "journal_edits":
            out.append((_render_int(row[0], "journal_edits.seq"),
                        _render_int(row[1], "journal_edits.ord"), row[2], row[3],
                        _render_int(row[4], "journal_edits.line_no", null=True),
                        row[5], row[6], row[7]))
        else:
            out.append((_render_int(row[0], "journal_files.seq"), row[1],
                        _render_bool(row[2], "journal_files.present"), row[3],
                        _render_bool(row[4], "journal_files.final_newline")))
    return out


def register_render_read(store, k: int, *, start=None, row: str = "render") -> tuple | dict:
    """THE READ (contract §3.6; D9): `register_render_queries(k)` as ONE
    request, in one REPEATABLE READ READ ONLY snapshot, by `store`, a
    `PostgresStore(cfg, "register_writer")`, with D9's `render` row.

    `row` IS D9'S ROW for the read (lane 1's cache signature, #165
    6755040818, which lane 3 accepted in 6755051914): `render`, as `render
    --images` has it, or `read` or `guard`, T113's. Those two run as
    REGISTER-READER, so their `store` is a `PostgresStore(cfg,
    "register_reader")`: `PostgresStore.bounds` refuses a row of the other
    role. The guard's row is cut by its caller's timer, which this
    signature does not carry, so `bounds` refuses `guard` with `ValueError`
    until T113 settles that. Any other `row` raises `ValueError` here.

    WITH `start`, `(c, {path: (lines, final_newline)})`, the state at seq `c`
    that `register_cache_state` read back from the cache, it returns THE
    IMAGES AT `k`, `{path: bytes}`, each proven:
    1. it reads `register_render_queries(k, since=c)` as one request, and
       builds `register_images(..., start=start)`, whose proof is over
       every image at `k`;
    2. ANY `RenderRefused` THERE IS A MISS: a failed proof, an edit that
       does not apply on `start`, a `start` of another form, a `c` above `k`
       (a cache is never brought back) or a read it refuses. The call is
       then made once more WITHOUT `start`, as a second request, and its
       rows are replayed in full from the latest import. ONLY THAT FULL
       REPLAY'S FAILURE raises `RenderRefused`, 69. So a cache from a
       reused seq costs one full read, and is never trusted;
    3. a `psql` that does not answer is no miss: `PsqlFailed` or
       `StoreUnusable` is raised as it is, from either request.

    WITHOUT `start`: returns `(journal, edits, files)`, typed for
    `register_images`, from the latest import's seq to `k`. Raises
    `RenderRefused` (69) for each of these:
    - a `REGISTER_SCHEMA_VERSION` outside the readers' window (design §1.5,
      "the renderer: at each run, before it renders");
    - a `k` above the head;
    - a journal with no import;
    - a `k` before the latest import;
    - an answer it cannot read.
    A `psql` that does not answer raises `PsqlFailed`, which is 69 too.

    THE VERSION IS CHECKED ONCE THE ONE REQUEST HAS ANSWERED (lane 3's review,
    NIT-1). `schema_version` is the request's first SELECT, but a request
    that fails at a later one, as against a newer schema whose column
    changed, ends as that SQL error and never reaches Y:2338's remedy. The
    code is 69 either way, and `cmd_render` names the likely remedy where
    the error is a missing table or column. Asking the version in a request
    of its own first would cost a second round trip on every render, which
    contract §2.3's one request per call does not allow."""
    if row not in ("render", "read", "guard"):
        raise ValueError(f"the render read takes D9's render, read or guard row, not {row!r}")
    if start is None:
        return _register_render_rows(store, k, None, row)
    try:
        c, _state = _register_render_start(start)
        if c > k:
            raise RenderRefused(f"the start state is at seq {c}, above seq {k}")
        return register_images(*_register_render_rows(store, k, c, row), start=start)
    except RenderRefused:
        pass        # A MISS: the call is made once more without `start`, below
    return register_images(*_register_render_rows(store, k, None, row))


def _register_render_rows(store, k: int, since, row: str) -> tuple:
    """`register_render_read`'s one request and its checks, with D9's `row`:
    `(journal, edits, files)`, typed, from the latest import to `k`; or,
    with `since=c`, the entries `c+1` to `k` and their edits, beside every
    `journal_files` row from the latest import to `k`."""
    answers = store._query_many(register_render_queries(k, since=since), snapshot=True,
                                row=row)
    if len(answers) != 5:
        raise RenderRefused(f"psql answered {len(answers)} of the 5 reads of one render")
    version_rows, head_rows = answers[0], answers[1]
    if len(version_rows) != 1 or len(version_rows[0]) != 3:
        raise RenderRefused("the register's schema_version row could not be read")
    version, writers_from, readers_from = (_render_int(v, "schema_version")
                                           for v in version_rows[0])
    refusal = register_version_refusal(version, writers_from, readers_from, write=False)
    if refusal:
        raise RenderRefused(refusal)
    if len(head_rows) != 1 or len(head_rows[0]) != 2:
        raise RenderRefused("the register's head row could not be read")
    head = _render_int(head_rows[0][0], "register_head.seq")
    latest = _render_int(head_rows[0][1], "the latest import's seq", null=True)
    if k > head:
        raise RenderRefused(f"seq {k} is above the head, seq {head}" +
                            (": the journal is empty" if head < 0 else ""))
    if latest is None:
        raise RenderRefused("the journal holds no import, so no seq can be rendered from it")
    if k < latest:
        raise RenderRefused(f"seq {k} is before the latest import, seq {latest}: the journal "
                            f"renders only from that import's baseline on")
    journal = _render_rows(answers[2], "journal")
    if since is None:
        if not journal or journal[0][0] != latest or journal[-1][0] != k:
            raise RenderRefused(f"the journal's entries from seq {latest} to seq {k} were not "
                                f"all read")
    elif (((journal[0][0], journal[-1][0]) if journal else None)
          != ((since + 1, k) if since < k else None)):
        raise RenderRefused(f"the journal's entries from seq {since + 1} to seq {k} were not "
                            f"all read")
    return (journal, _render_rows(answers[3], "journal_edits"),
            _render_rows(answers[4], "journal_files"))


def register_write_images(out_dir: str, images: dict) -> list:
    """The images written under `<out_dir>/<path>` (contract §3.6), with
    `<out_dir>` as it was on any end but a return (lane 3's review of T301,
    MUST-1 and SHOULD-1). Returns the images' `file=` rows, without the
    prefix, in §3.2's canonical form: `<path>` TAB `1` TAB `<sha256>`, sorted
    by path, bytewise.

    - EACH PATH IS CHECKED FIRST, before anything is written. It must be a
      render-set path, so it cannot leave `<out_dir>`. It must hold no control
      character, U+0000-U+001F or U+007F, so its row stays one line (SHOULD-2).
      Either failure raises `RenderRefused`.
    - THE TREE IS BUILT APART, in a `tempfile.mkdtemp` directory beside
      `<out_dir>`, on its filesystem. Each image is written whole to a temp
      file there, then `os.link`ed to its path, and the temp file is
      unlinked. A link never replaces a file: where one is there already, as
      two logs that differ only by case on a filesystem that folds case, the
      link fails EEXIST and that raises `RenderRefused`. Nothing is ever
      `os.replace`d onto an image's path (MUST-1).
    - THE TREE IS THEN RENAMED ONTO `<out_dir>`. The rename succeeds where
      `<out_dir>` is absent or still an empty directory, and fails where
      anything was put in it during the read, so it never overwrites. The
      new `<out_dir>` keeps the mode it had, or takes the umask's.
    - ON ANY FAILURE the build directory is removed, and the `OSError` or
      `RenderRefused` is raised again. Only a missing parent of `<out_dir>`,
      made on the way, stays behind."""
    import tempfile     # used here alone, so the module's imports stay as they were
    order = sorted(images, key=lambda p: p.encode("utf-8"))
    for path in order:
        if not register_render_path(path):
            raise RenderRefused(f"{path!r} is not a render-set path")
        if _RENDER_CONTROL_RE.search(path):
            raise RenderRefused(f"the image {path!r} holds a control character in its path, "
                                f"so it cannot be a file= row")
    target_dir = os.path.abspath(out_dir)
    parent = os.path.dirname(target_dir)
    os.makedirs(parent, exist_ok=True)
    mask = os.umask(0)
    os.umask(mask)
    mode = (stat.S_IMODE(os.stat(target_dir).st_mode) if os.path.isdir(target_dir)
            else 0o777 & ~mask)
    build = tempfile.mkdtemp(prefix=f".{os.path.basename(target_dir)}.render-", dir=parent)
    rows = []
    try:
        for path in order:
            data = images[path]
            target = os.path.join(build, *path.split("/"))
            folder = os.path.dirname(target)
            os.makedirs(folder, exist_ok=True)
            temp = os.path.join(folder, f".{os.path.basename(target)}.tmp-{os.getpid()}")
            fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o666)
            try:
                with os.fdopen(fd, "wb") as handle:
                    handle.write(data)
                try:
                    os.link(temp, target)
                except FileExistsError:
                    raise RenderRefused(f"{path} would overwrite a file already written "
                                        f"beside it (EEXIST): two images that differ only by "
                                        f"case, on a filesystem that folds case?")
            finally:
                os.unlink(temp)
            rows.append(f"{path}\t1\t{hashlib.sha256(data).hexdigest()}")
        os.chmod(build, mode)
        os.rename(build, target_dir)
    except BaseException:
        shutil.rmtree(build, ignore_errors=True)
        raise
    return rows


def _register_psql_lines(exc) -> bool:
    """§2.6's first two stderr lines, where the database refused: psql's
    `ERROR:` line verbatim, and its `DETAIL:` line where the error has one.
    `LOCATION:` is dropped. Returns whether a line was written."""
    lines = (getattr(exc, "stderr", "") or "").splitlines()
    for at, line in enumerate(lines):
        if line.startswith("ERROR:"):
            out = [line] + [next((d for d in lines[at + 1:] if d.startswith("DETAIL:")), "")]
            sys.stderr.write("".join(text + "\n" for text in out if text))
            return True
    return False


def cmd_render(args: list[str]) -> int:
    """`lanes-index render --images --at <k> --out <dir>` (contract §3.6;
    exit-codes.md's `render --images` rows; T301). It writes the render set's
    images at seq `k` under `<dir>/<path>`. `<dir>` must not exist, or must be
    empty. It prints `format=1`, `n=<k>`, and one `file=` row per image, in
    §3.2's canonical form. It runs as REGISTER-WRITER, with the renderer's
    row.

    Exits:
    - 0: the images are written;
    - 64: usage, before the configuration is read and before any connection,
      whether the argument is malformed or `<dir>` exists and is not an empty
      directory (a symbolic link included, since the finished tree is renamed
      onto `<dir>`). So is any other `render` form: `--checkout` is group C's
      (§3.7), and this build does not have it;
    - 2: a refused configuration, Q6(c)'s refusal of `mode=primary`
      included;
    - 69: a failed read; a `k` above the head or before the latest import's
      baseline (exit-codes.md's [P]); a `REGISTER_SCHEMA_VERSION` outside the
      readers' window; journal rows that do not replay; an image whose path
      holds a control character; and images that could not be written, which
      the contract's four codes leave unnamed.
    On any end but 0, `<dir>` is as it was (lane 3's review, SHOULD-1), and
    stdout is printed only once every image is in place."""
    want = f"render takes --images --at <k> --out <dir> - see {PROG} --help"
    images_flag, at, out_dir = False, None, None
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-h", "--help"):
            say(USAGE)
            return EXIT_OK
        if arg == "--images":
            if images_flag:
                note(f"--images is given twice: {want}")
                return EXIT_USAGE
            images_flag = True
            i += 1
            continue
        if arg in ("--at", "--out") or arg.startswith(("--at=", "--out=")):
            name = arg.split("=", 1)[0]
            value = arg.split("=", 1)[1] if "=" in arg else (args[i + 1] if i + 1 < len(args)
                                                            else "")
            if not value:
                note(f"{name} needs a value: {want}")
                return EXIT_USAGE
            if (at if name == "--at" else out_dir) is not None:
                note(f"{name} is given twice: {want}")
                return EXIT_USAGE
            if name == "--at":
                at = value
            else:
                out_dir = value
            i += 1 if "=" in arg else 2
            continue
        if arg == "--checkout" or arg.startswith("--checkout="):
            note(f"render --checkout is the renderer fork, group C's (contract §3.7), which "
                 f"this build does not have: {want}")
            return EXIT_USAGE
        note(f"unknown argument '{arg}': {want}")
        return EXIT_USAGE
    if not images_flag or at is None or out_dir is None:
        note(f"render needs all of --images, --at <k> and --out <dir>: {want}")
        return EXIT_USAGE
    # `k` IS A SEQ: a whole number, and a `bigint`'s (design §1.2's journal).
    if not re.fullmatch(r"[0-9]+", at) or int(at) > 2 ** 63 - 1:
        note(f"--at {at!r} is not a seq, a whole number of at least 0: {want}")
        return EXIT_USAGE
    k = int(at)
    if os.path.lexists(out_dir):
        if os.path.islink(out_dir) or not os.path.isdir(out_dir):
            what = "a symbolic link" if os.path.islink(out_dir) else "not a directory"
            note(f"--out {out_dir} exists and is {what}: <dir> must not exist, or must be an "
                 f"empty directory")
            return EXIT_USAGE
        try:
            present = os.listdir(out_dir)
        except OSError as exc:
            note(f"--out {out_dir} cannot be listed ({exc.strerror or exc}): <dir> must not "
                 f"exist, or must be empty")
            return EXIT_USAGE
        if present:
            note(f"--out {out_dir} is not empty: <dir> must not exist, or must be empty")
            return EXIT_USAGE
    try:
        cfg = load_config()
        store = PostgresStore(cfg, "register_writer")
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return EXIT_REFUSED
    try:
        images = register_images(*register_render_read(store, k))
    except PsqlFailed as exc:
        echoed = _register_psql_lines(exc)
        note(f"render --images: the register could not be read"
             f"{'' if echoed else ': ' + exc.detail}; nothing was written")
        # A MISSING TABLE OR COLUMN is most likely a schema of another
        # version, which the request failed on before its version could be
        # checked (lane 3's review, NIT-1): name Y:2338's two remedies.
        code = next((m.group(1) for m in (re.match(r"ERROR:\s+([0-9A-Z]{5}):", line)
                                           for line in (exc.stderr or "").splitlines()) if m),
                    None)
        if exc.psql_exit == 3 and code in ("42P01", "42703"):
            note(f"render --images: a table or column this client reads is missing, so the "
                 f"register's schema may not be this client's, {REGISTER_SCHEMA_VERSION}: if "
                 f"it is newer, upgrade the tools; if it is older, the database is behind: "
                 f"run the bootstrap")
        return EXIT_UNAVAILABLE
    except StoreUnusable as exc:
        note(f"render --images: the register could not be read: {exc.detail}; nothing was "
             f"written")
        return EXIT_UNAVAILABLE
    except RenderRefused as exc:
        note(f"render --images: {exc}; nothing was written")
        return EXIT_UNAVAILABLE
    try:
        rows = register_write_images(out_dir, images)
    except (OSError, RenderRefused) as exc:
        note(f"render --images: the images at seq {k} could not be written under {out_dir} "
             f"({exc}); <dir> is as it was")
        return EXIT_UNAVAILABLE
    say("format=1")
    say(f"n={k}")
    for row in rows:
        say(f"file={row}")
    return EXIT_OK


# ===== the SQL register: the image cache (007)
#
# THE IMAGE CACHE (feature 007, opensoft/openRepoTools#165; T302; design
# Y:4963, question 13's form; PC-1; lane 3's API ruling, #165 6746004829). One
# cache per environment, under `state_dir()/register-images/`, of the render
# set's file images that the snapshots and the readers there fetched. Its
# files:
# - `objects/<digest>`: an image's bytes, named by their sha256 as 64
#   lowercase hex, the form of the journal's `journal_files` rows. Each is
#   content-addressed and immutable, and is written by a temp file and
#   `os.replace` with no lock, since two writers of one digest write the
#   same bytes;
# - `seq/<n>`: the manifest of seq `n`, one `<path>` TAB `<digest>` line per
#   path a writer read at `n`, sorted by path bytewise. A manifest may be
#   partial, and a second record of one `n` merges into the first;
# - `head`: the decimal seq of the newest manifest recorded. It moves only
#   forward;
# - `lock`: the flock that recording and collection take, in `SyncLock`'s
#   form, but with `LOCK_NB` and no wait: a busy lock skips the record. It is
#   opened without blocking, and a `lock` that is not a regular file counts
#   as busy. A symlinked `lock` is not followed, and skips the record too.
#
# THE CACHE IS ADVISORY (design Y:2516): correctness rests on the digests the
# database gives at `n`, and on the head check. So no error escapes the five
# `image_cache_*` functions but `image_cache_put`'s `TypeError` for data that
# is not bytes. An `OSError`, a busy lock or a corrupt file is a miss or a
# skipped write, and the caller fetches whole.
#
# NOTHING IS FSYNCED. After a power loss, a renamed file can be empty or torn,
# and each such file is a miss. An object fails its re-hash. A manifest or a
# `head` out of form is a miss, and the next record replaces it. An empty or
# cut-short manifest reads as a valid partial one, so its callers fetch the
# rest whole. That is accepted for an advisory cache (lane 3's review, #165
# 6755345889).
#
# Each caller:
# - uses an object only through `image_cache_get(<the digest the database
#   gave at n>)`, so an object is used only when its name equals that digest
#   (D17);
# - copies the bytes `image_cache_get` returns into its own per-invocation
#   file, never a link into the cache;
# - never brings forward a cache head above the database's `n`, as after a
#   re-import: it fetches whole.
# The callers are T111's `register snapshot --tree`, T113's `register read
# --prefetch` and form 4, and T512's write-through.

#: The cache's directory, under `state_dir()` (design Y:4963), and its parts.
IMAGE_CACHE_DIR = "register-images"
_IMAGE_OBJECTS = "objects"
_IMAGE_SEQS = "seq"
_IMAGE_HEAD = "head"
_IMAGE_LOCK = "lock"

#: N: collection keeps the objects that the last N manifests name, by seq, and
#: removes every older manifest. Y gives only "the last few manifests"
#: (Y:4963); N = 3 is lane 3's ruling (#165 6746004829).
IMAGE_CACHE_KEEP = 3

#: Collection's floor (PC-1): an object is removed only when its mtime is over
#: 10 minutes old, so an object a writer has put and not yet recorded, or one
#: a reader is copying, stays, but for the narrow race `image_cache_put`
#: names. An abandoned temp file is removed on the same floor.
IMAGE_CACHE_FLOOR_SECONDS = 600

#: A digest: a sha256 as 64 lowercase hex, as `journal_files` holds it.
_IMAGE_DIGEST_RE = re.compile(r"[0-9a-f]{64}")
#: A seq as `seq/<n>` and `head` spell it: decimal, with no leading zero, and
#: a `bigint`'s (design §1.2's journal).
_IMAGE_SEQ_RE = re.compile(r"0|[1-9][0-9]{0,18}")
_IMAGE_HEAD_RE = re.compile(rb"(0|[1-9][0-9]{0,18})\n?")
_IMAGE_SEQ_MAX = 2 ** 63 - 1
#: The temp files `_image_cache_write` names, and no other file.
_IMAGE_TEMP_RE = re.compile(r"\..+\.tmp-[0-9]+-[0-9a-f]{8}")
#: A manifest's path holds no control character, so each line keeps its two
#: fields.
_IMAGE_PATH_BAD_RE = re.compile(r"[\x00-\x1f\x7f]")


def _image_cache_root() -> str:
    return os.path.join(state_dir(), IMAGE_CACHE_DIR)


def _image_cache_makedirs(*subs: str) -> str:
    """The cache's root, once `state_dir()`, the root and each of `subs` under
    it exist, each created 0700, as `SyncLock` creates `state_dir()`. Raises
    `OSError`."""
    root = _image_cache_root()
    for path in (state_dir(), root, *(os.path.join(root, sub) for sub in subs)):
        os.makedirs(path, mode=0o700, exist_ok=True)
    return root


def _image_cache_read(path: str) -> bytes:
    """A cache file's bytes, read whole, from a regular file only: a FIFO or a
    device in its place is refused before any read can block, and a symlink
    is not followed (lane 3's review, #165 6755345889). So a symlink at an
    object's name is a miss, which `image_cache_put` replaces. Raises
    `OSError`."""
    fd = os.open(path, os.O_RDONLY | getattr(os, "O_NONBLOCK", 0) | getattr(os, "O_NOFOLLOW", 0))
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise OSError(f"{path} is not a regular file")
        chunks = []
        while True:
            chunk = os.read(fd, 1 << 20)
            if not chunk:
                return b"".join(chunks)
            chunks.append(chunk)
    finally:
        os.close(fd)


def _image_cache_write(path: str, data: bytes) -> None:
    """`data` written whole to `path`, 0600, by a temp file beside it and
    `os.replace`, so a reader finds the old file or the new one, never a part
    of either. The temp file's name is this call's own, and it is removed
    when the write fails. Raises `OSError`."""
    parent, name = os.path.split(path)
    temp = os.path.join(parent, f".{name}.tmp-{os.getpid()}-{os.urandom(4).hex()}")
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        try:
            view = memoryview(data)
            while view:
                view = view[os.write(fd, view):]
        finally:
            os.close(fd)
        os.replace(temp, path)
    except BaseException:
        try:
            os.unlink(temp)
        except OSError:
            pass
        raise


def _image_cache_unlink(path: str) -> None:
    try:
        os.unlink(path)
    except OSError:
        pass


def _image_cache_older(path: str, now: float) -> bool:
    """Whether `path`'s own mtime is over the floor's 10 minutes before `now`.
    A file that cannot be dated is not old: collection keeps it."""
    try:
        return now - os.lstat(path).st_mtime > IMAGE_CACHE_FLOOR_SECONDS
    except OSError:
        return False


def _image_cache_entry_ok(path, digest) -> bool:
    """Whether `path` and `digest` make one manifest line: a path that is not
    empty, holds no control character and encodes as UTF-8, and a digest."""
    if not (isinstance(path, str) and path and _IMAGE_PATH_BAD_RE.search(path) is None
            and isinstance(digest, str) and _IMAGE_DIGEST_RE.fullmatch(digest)):
        return False
    try:
        path.encode("utf-8")
    except UnicodeEncodeError:
        return False
    return True


def _image_cache_manifest_bytes(manifest: dict) -> bytes:
    """A manifest's file: one `<path>` TAB `<digest>` line per path, each
    ended by LF, sorted by path bytewise (lane 3's ruling, #165 6746004829).
    An empty manifest is an empty file."""
    return "".join(f"{path}\t{manifest[path]}\n"
                   for path in sorted(manifest, key=lambda p: p.encode("utf-8"))
                   ).encode("utf-8")


def _image_cache_parse_manifest(data: bytes):
    """A manifest file's paths and digests, or None where the file is not one
    `_image_cache_manifest_bytes` writes: text that is not UTF-8, a last line
    with no LF, a line with no TAB, a path or a digest out of form, or one
    path twice."""
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        return None
    if text and not text.endswith("\n"):
        return None
    manifest = {}
    for line in text.split("\n")[:-1]:
        path, tab, digest = line.partition("\t")
        if not tab or path in manifest or not _image_cache_entry_ok(path, digest):
            return None
        manifest[path] = digest
    return manifest


def _image_cache_parse_seq(data: bytes):
    """`head`'s seq, or None where `data` is not one decimal seq, with at most
    one LF after it."""
    match = _IMAGE_HEAD_RE.fullmatch(data)
    if match is None:
        return None
    seq = int(match.group(1))
    return seq if seq <= _IMAGE_SEQ_MAX else None


def _image_cache_lock(root: str):
    """The cache's flock on `register-images/lock`, taken as `SyncLock` takes
    its own (design Y:4963): the file opened for append, made 0600, and
    `LOCK_EX | LOCK_NB`. Unlike `SyncLock`, it is tried once, with no wait
    (lane 3's ruling, #165 6746004829), and where `fcntl` is missing there is
    no lock, so nothing is recorded.

    The open never blocks: `O_NONBLOCK`, with `O_CLOEXEC`. A `lock` that is
    not a regular file, such as a FIFO with a reader, counts as a busy lock.
    A FIFO with no reader refuses the open (lane 3's review, #165
    6755345889).

    The open never follows a symlink: `O_NOFOLLOW`. A symlinked `lock` fails
    the open with ELOOP, so its target, dangling or not, is neither changed
    nor created, and the caller skips the call. Only the last name is
    checked, so a symlinked `register-images/` still works (lane 3's delta
    check, #165 6755954683).

    Returns the open descriptor, which holds the lock until `os.close`, or
    None where the lock is busy or missing. Raises `OSError` where the file
    cannot be opened."""
    try:
        import fcntl
    except ImportError:
        return None
    fd = os.open(os.path.join(root, _IMAGE_LOCK),
                 os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NONBLOCK | os.O_CLOEXEC
                 | os.O_NOFOLLOW, 0o600)
    try:
        if stat.S_ISREG(os.fstat(fd).st_mode):
            try:
                os.fchmod(fd, 0o600)
            except OSError:
                pass
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
    except OSError:
        pass
    os.close(fd)
    return None


def _image_cache_seqs(seq_dir: str) -> list:
    """The seqs `seq/` lists, highest first, from the names `_IMAGE_SEQ_RE`
    matches whole; none where `seq/` is missing. Raises `OSError` where it
    cannot be listed."""
    try:
        listed = os.listdir(seq_dir)
    except FileNotFoundError:
        return []
    return sorted((seq for seq in (int(name) for name in listed if _IMAGE_SEQ_RE.fullmatch(name))
                   if seq <= _IMAGE_SEQ_MAX), reverse=True)


def _image_cache_record_locked(root: str, n: int, manifest: dict) -> None:
    """`image_cache_record`'s two writes, under the cache's flock:
    - `seq/<n>`, with the paths of an earlier record of `n` merged in, a path
      in both taking this record's digest. An earlier record that cannot be
      read, or is out of form, is replaced;
    - `head`, moved to `n` only where `n` is above it. A `head` that is
      missing, or holds no seq, as a crash can leave it, is written as the
      larger of `n` and the highest seq `seq/` lists, so it never moves back
      (lane 3's review, #165 6755345889). Where `seq/` cannot be listed, it
      is left. A symlinked `head` counts as missing: it is replaced by a
      regular `head`, and its target is left alone (lane 3's delta check,
      #165 6755954683). A `head` that cannot be read is left as it is, since
      it may name a seq above `n`.
    Raises `OSError`."""
    seq_dir = os.path.join(root, _IMAGE_SEQS)
    target = os.path.join(seq_dir, str(n))
    try:
        merged = _image_cache_parse_manifest(_image_cache_read(target)) or {}
    except OSError:
        merged = {}
    merged.update(manifest)
    _image_cache_write(target, _image_cache_manifest_bytes(merged))
    head_path = os.path.join(root, _IMAGE_HEAD)
    try:
        head = _image_cache_parse_seq(_image_cache_read(head_path))
    except OSError as error:
        if not isinstance(error, FileNotFoundError) and error.errno != errno.ELOOP:
            raise
        head = None
    if head is not None and n <= head:
        return
    to = n if head is not None else max([n, *_image_cache_seqs(seq_dir)])
    _image_cache_write(head_path, f"{to}\n".encode("ascii"))


def _image_cache_named(seq_dir: str, seqs: list):
    """The digests that the manifests of `seqs` name, or None where one of
    them cannot be read or is out of form, since what it names is not
    known."""
    named = set()
    for seq in seqs:
        try:
            manifest = _image_cache_parse_manifest(
                _image_cache_read(os.path.join(seq_dir, str(seq))))
        except OSError:
            return None
        if manifest is None:
            return None
        named.update(manifest.values())
    return named


def _image_cache_sweep(directory: str, pattern, now: float, keep=frozenset()) -> None:
    """Removes each file in `directory` whose name `pattern` matches whole, is
    not in `keep`, and whose mtime is over the floor's 10 minutes old. A file
    that cannot be removed is left."""
    try:
        names = os.listdir(directory)
    except OSError:
        return
    for name in names:
        path = os.path.join(directory, name)
        if pattern.fullmatch(name) and name not in keep and _image_cache_older(path, now):
            _image_cache_unlink(path)


def _image_cache_collect_locked(root: str) -> None:
    """`image_cache_collect`'s removals, under the cache's flock (design
    Y:4963; PC-1; lane 3's ruling, #165 6746004829). "The last N manifests"
    are the `IMAGE_CACHE_KEEP` highest seqs, so the head's own manifest is
    always among them. It removes:
    - every object named in none of them whose mtime is over
      `IMAGE_CACHE_FLOOR_SECONDS` old. Where `seq/` cannot be listed, or one
      of them cannot be read or is out of form, it removes no object;
    - every manifest older than them, by seq;
    - every temp file `_image_cache_write` names that is over the same floor
      old, since its writer died before its rename.
    It removes only names this cache writes, and leaves a file it cannot
    remove."""
    now = time.time()
    seq_dir = os.path.join(root, _IMAGE_SEQS)
    objects_dir = os.path.join(root, _IMAGE_OBJECTS)
    try:
        seqs = _image_cache_seqs(seq_dir)
    except OSError:
        return
    named = _image_cache_named(seq_dir, seqs[:IMAGE_CACHE_KEEP])
    if named is not None:
        _image_cache_sweep(objects_dir, _IMAGE_DIGEST_RE, now, named)
    for seq in seqs[IMAGE_CACHE_KEEP:]:
        _image_cache_unlink(os.path.join(seq_dir, str(seq)))
    for directory in (root, seq_dir, objects_dir):
        _image_cache_sweep(directory, _IMAGE_TEMP_RE, now)


def image_cache_get(digest: str) -> bytes | None:
    """The bytes of `objects/<digest>`, or None where the object is missing,
    unreadable, or its bytes do not hash to `digest`: they are checked again
    on every read (lane 3's ruling, #165 6746004829). The caller passes the
    digest the database gave at `n`, so an object is used only when its name
    equals it (D17). A `digest` that is not 64 lowercase hex is a miss. It
    takes no lock, writes nothing, and raises nothing. The caller copies what
    it returns into its own per-invocation file."""
    if not isinstance(digest, str) or _IMAGE_DIGEST_RE.fullmatch(digest) is None:
        return None
    try:
        data = _image_cache_read(os.path.join(_image_cache_root(), _IMAGE_OBJECTS, digest))
    except (OSError, ValueError):
        return None
    return data if hashlib.sha256(data).hexdigest() == digest else None


def image_cache_put(data: bytes) -> str:
    """Returns `data`'s digest, its sha256 as 64 lowercase hex, once
    `objects/<digest>` is written by a temp file and `os.replace` where it is
    missing, with no lock: two writers of one digest write the same bytes
    (design Y:4963).
    - An object `image_cache_get` would not return, unreadable, a symlink, or
      not hashing to its name, counts as missing, and is replaced.
    - An object already whole is not written again. Its mtime is set to now,
      so collection's 10-minute floor keeps it while the caller records it.
      That narrows the race with a collector, and does not close it: a
      `utime` that lands between the collector's `lstat` and its unlink
      loses the object, which costs a later reader one miss (lane 3's
      review, #165 6755345889). The `utime` does not follow a symlink
      planted there since the read: only the link's own times are set
      (lane 3's delta check, #165 6755954683).
    - A write that fails is skipped. The digest is returned all the same, and
      a later reader misses.
    `data` is `bytes` or a `bytearray`. Anything else raises `TypeError`
    before the cache is touched, the one error that escapes this section's
    five functions."""
    if not isinstance(data, (bytes, bytearray)):
        raise TypeError(f"image_cache_put takes bytes, not {type(data).__name__}")
    data = bytes(data)
    digest = hashlib.sha256(data).hexdigest()
    try:
        root = _image_cache_makedirs(_IMAGE_OBJECTS)
        target = os.path.join(root, _IMAGE_OBJECTS, digest)
        if image_cache_get(digest) is not None:
            try:
                os.utime(target, follow_symlinks=False)
                return digest
            except FileNotFoundError:
                pass
        _image_cache_write(target, data)
    except (OSError, ValueError):
        pass
    return digest


def image_cache_head() -> tuple[int, dict[str, str]] | None:
    """The cache's seq, from `head`, and its manifest `seq/<seq>`, path to
    digest; None where there is none, or where either cannot be read or is
    out of form. It takes no lock, writes nothing, and raises nothing.

    The caller brings those images to its `n` with the journal's entries
    since that seq, and checks each against the digest at `n` (design
    Y:2512-2516). A manifest may be partial: it holds the paths its writers
    read. A seq above `n`, as after a re-import, is never brought forward:
    the caller fetches whole (lane 3's ruling, #165 6746004829)."""
    try:
        root = _image_cache_root()
        seq = _image_cache_parse_seq(_image_cache_read(os.path.join(root, _IMAGE_HEAD)))
        if seq is None:
            return None
        manifest = _image_cache_parse_manifest(
            _image_cache_read(os.path.join(root, _IMAGE_SEQS, str(seq))))
    except (OSError, ValueError):
        return None
    return None if manifest is None else (seq, manifest)


def image_cache_record(n: int, manifest: dict[str, str]) -> None:
    """Records seq `n`'s manifest, path to digest, under the cache's flock
    (design Y:4963; lane 3's ruling, #165 6746004829):
    - it writes `seq/<n>` by a temp file and `os.replace`. A manifest may hold
      only the paths its writer read at `n`, and a second record of one `n`
      merges its paths into the first, a path in both taking the second's
      digest;
    - it moves `head` to `n` only where `n` is above it. A `head` that is
      missing, a symlink, or holds no seq takes the larger of `n` and the
      highest seq `seq/` lists. So `head` never moves back;
    - it then collects, as `image_cache_collect` does, under the same flock.
    The flock is taken with `LOCK_NB`: where another writer holds it, the
    record is skipped, never waited for. A record is skipped too where `n` is
    not a whole number from 0 to 2**63 - 1, where `manifest` is not a dict of
    paths with no control character to digests, and where it cannot be
    written. It raises nothing."""
    if (isinstance(n, bool) or not isinstance(n, int) or not 0 <= n <= _IMAGE_SEQ_MAX
            or not isinstance(manifest, dict)
            or not all(_image_cache_entry_ok(path, digest) for path, digest in manifest.items())):
        return
    try:
        root = _image_cache_makedirs(_IMAGE_OBJECTS, _IMAGE_SEQS)
        lock = _image_cache_lock(root)
    except (OSError, ValueError):
        return
    if lock is None:
        return
    try:
        try:
            _image_cache_record_locked(root, n, manifest)
        except (OSError, ValueError):
            pass
        _image_cache_collect_locked(root)
    except (OSError, ValueError):
        pass
    finally:
        os.close(lock)


def image_cache_collect() -> None:
    """Collection, under the cache's flock taken with `LOCK_NB`, and skipped
    where the lock is busy (design Y:4963; PC-1; lane 3's ruling, #165
    6746004829). It removes the objects named in none of the last
    `IMAGE_CACHE_KEEP` manifests whose mtime is over
    `IMAGE_CACHE_FLOOR_SECONDS` old, and every manifest older than those
    (`_image_cache_collect_locked`). `image_cache_record` runs it under its
    own flock. It creates no directory, and raises nothing."""
    try:
        root = _image_cache_root()
        lock = _image_cache_lock(root) if os.path.isdir(root) else None
    except (OSError, ValueError):
        return
    if lock is None:
        return
    try:
        _image_cache_collect_locked(root)
    except (OSError, ValueError):
        pass
    finally:
        os.close(lock)


# ===== the SQL register: `register snapshot` (007)
#
# THE WRITERS' SNAPSHOT (feature 007, opensoft/openRepoTools#165; T111; contract
# §3.2; design Y:2509-2516, Y:4985-4989 and Y:5044-5052). One REPEATABLE READ
# READ ONLY read, sent as ONE request (contract §2.3), as REGISTER-WRITER with
# D9's `snapshot` row: the switch with its marker state and generation, the
# head `n`, the database's clock in whole seconds (D13), and the write id's
# entry where it is found. `--tree <dir> --checkout <c>` also builds the
# scratch tree at `n`, or at `--at <k>`, and `--files <set>` or `--all` with
# `--out <dir>` writes those images at `n` (contract §3.6, O3). It writes no
# register.
#
# THE CHECKS, in lane 1's order, which `commit_write` keeps under the head
# row's lock (contract §3.2's table; Y:2518), each ending the call at once:
#   1. a `--generation` that is not the switch's: 2, LR007 `generation`,
#      whatever the switch reads and whether or not the journal holds the id;
#   2. the write id found with this run's lane, verb and `args_sha256`: 0,
#      with `found=`, then the entry's `workstation=` and `utc=` (draft
#      4.15), then that seq's `file=` rows, and no tree is built;
#   2'. the write id found for another write: 2, LR007 `another-write`;
#   3. `REGISTER_SCHEMA_VERSION` outside the writers' window: 69, naming both
#      numbers and the remedy;
#   4. the switch not `primary` with the marker `present`: 69, with
#      Amendment 22's S1 ("No fallback writes").
# Under `--at` only the generation is checked, of the identity and the
# switch, and the version still is (`_register_snapshot`'s docstring).
#
# THE IMAGES come through T302's cache, in the callers' order that lane 3
# accepted (#165 6755051914) and T302's task line records: `image_cache_head`;
# `image_cache_get` for each digest of its manifest, re-hashed, where any miss
# is a full replay; `register_cache_state`; the read with `start`; then
# `image_cache_put` and `image_cache_record`, last. The read with `start`
# rides the snapshot's own request: T301's `register_render_queries` is sent
# in it with no bound but the head, which every statement of one REPEATABLE
# READ snapshot sees alike, so a write's attempt stays one `psql` call (Y:2509).
# A miss, which Y:2509 answers by fetching "the files whole", costs one more
# request, a full replay at that same `n`, whose images must equal the first
# request's digests at `n`, or the call ends 69.

#: The upper bound of the snapshot's render rows when it reads at the head:
#: every entry of one snapshot is at or below its head, so a `bigint`'s
#: largest value reads them all, and the head bounds them.
_SNAPSHOT_SEQ_MAX = 2 ** 63 - 1

#: The flags that take a value, each at most once.
_SNAPSHOT_VALUE_FLAGS = ("--write-id", "--generation", "--lane", "--verb", "--args-sha256",
                         "--tree", "--checkout", "--at", "--files", "--out")

#: The identity a write passes after `--write-id` (contract §3.2).
_SNAPSHOT_IDENTITY = ("--lane", "--verb", "--args-sha256")

#: `args_sha256`, as the journal's CHECK takes it (design §1.2).
_SNAPSHOT_ARGS_SHA_RE = re.compile(r"[0-9a-f]{64}")

#: A UUID as `uuid`'s text output spells it, lower case: the write id and the
#: generation the snapshot prints, and so the ones a caller passes back.
_SNAPSHOT_UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")

#: What a `workstation=` value or a `file=` path may not hold, so that its row
#: is one line to every reader: the C0 controls and DEL, which
#: `_RENDER_CONTROL_RE` names, and U+0085, U+2028 and U+2029, which Python's
#: `str.splitlines()` splits on with the C0 ones (U+001C to U+001E among
#: them) and which bash's `read` does not. Lane 1's review of T111, #165
#: 6775233959, NIT 3.
_SNAPSHOT_LINE_RE = re.compile(r"[\x00-\x1f\x7f\x85\u2028\u2029]")

#: The variables that name a repository's location, which git reads before
#: `-C` (git rev-parse --local-env-vars, with the config ones): dropped before
#: the checkout is read and before the scratch tree is built, as T112 drops
#: them before it reads `tree/`.
_SNAPSHOT_GIT_LOCAL_VARS = (
    "GIT_DIR", "GIT_WORK_TREE", "GIT_IMPLICIT_WORK_TREE", "GIT_INDEX_FILE",
    "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_COMMON_DIR",
    "GIT_NAMESPACE", "GIT_PREFIX", "GIT_SHALLOW_FILE", "GIT_GRAFT_FILE",
    "GIT_REPLACE_REF_BASE", "GIT_NO_REPLACE_OBJECTS", "GIT_QUARANTINE_PATH",
    "GIT_CONFIG", "GIT_CONFIG_PARAMETERS", "GIT_CONFIG_COUNT", "GIT_TEMPLATE_DIR")

#: The scratch tree's one commit, made by this command and by no person.
_SNAPSHOT_TREE_IDENTITY = ("lanes-index", "lanes-index@invalid")


class _SnapshotUsage(Exception):
    """A `register snapshot` command line that is none of its forms: 64,
    before the configuration is read and before any connection."""


class SnapshotUnavailable(Exception):
    """A snapshot read that failed after the request answered, outside the
    image builder: an answer that cannot be read, an `--at <k>` above the
    head, or a checkout or a scratch tree that could not be read or built.
    It exits `EXIT_UNAVAILABLE`, 69 (contract §3.2's exits: "any failed
    read"), with nothing written."""


def _register_snapshot_dir_problem(flag: str, path: str) -> str | None:
    """Why `path`, a `<dir>` that must not exist or must be an empty
    directory, is usage, or None. A symbolic link is refused, since the
    finished tree is renamed onto `<dir>`, as `render --images` refuses one
    (lane 3's ruling, #165 6754819099, choice 2)."""
    if not os.path.lexists(path):
        return None
    if os.path.islink(path) or not os.path.isdir(path):
        what = "a symbolic link" if os.path.islink(path) else "not a directory"
        return f"{flag} {path} exists and is {what}: <dir> must not exist, or must be empty"
    try:
        present = os.listdir(path)
    except OSError as exc:
        return f"{flag} {path} cannot be listed ({exc.strerror or exc}): <dir> must not exist"
    if present:
        return f"{flag} {path} is not empty: <dir> must not exist, or must be empty"
    return None


def _register_snapshot_args(args: list[str]) -> dict | None:
    """`register snapshot`'s argv (contract §3.2, and §3.6 for `--files`),
    checked whole before anything is read; None for `--help`. Raises
    `_SnapshotUsage` for any line that is not one of these forms:

    - `act-begin`'s: no identity flag;
    - a new write's: `--write-id new --lane --verb --args-sha256`;
    - a write's own: all five, `--write-id <uuid> --generation <uuid> --lane
      --verb --args-sha256` (`--write-id <uuid>` without `--generation` is
      usage: O4, ratified by R08);
    - under `--at <k>`: `--generation <uuid>` alone, or all five (O13);
      `--at` without `--generation` is usage;
    - each of those with `--tree <dir> --checkout <c>`, the two together;
    - the image cache's: `--files <set>` or `--all`, with `--out <dir>`, and
      no other flag.

    Each flag takes its value as the next argument or after `=`, once. A
    `<dir>` that exists and is not an empty directory is usage, and so is a
    `--checkout` that is not a directory."""
    opts: dict = {flag: None for flag in _SNAPSHOT_VALUE_FLAGS}
    opts["--all"] = False
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-h", "--help"):
            return None
        if arg == "--all":
            if opts["--all"]:
                raise _SnapshotUsage("--all is given twice")
            opts["--all"] = True
            i += 1
            continue
        name = arg.split("=", 1)[0]
        if name not in _SNAPSHOT_VALUE_FLAGS:
            raise _SnapshotUsage(f"unknown argument '{arg}'")
        value = arg.split("=", 1)[1] if "=" in arg else (args[i + 1] if i + 1 < len(args)
                                                        else "")
        if not value:
            raise _SnapshotUsage(f"{name} needs a value")
        if opts[name] is not None:
            raise _SnapshotUsage(f"{name} is given twice")
        opts[name] = value
        i += 1 if "=" in arg else 2
    write_id, generation, at = opts["--write-id"], opts["--generation"], opts["--at"]
    identity = [flag for flag in _SNAPSHOT_IDENTITY if opts[flag] is not None]
    if opts["--files"] is not None or opts["--all"]:
        others = [flag for flag in _SNAPSHOT_VALUE_FLAGS
                  if flag not in ("--files", "--out") and opts[flag] is not None]
        if opts["--files"] is not None and opts["--all"]:
            raise _SnapshotUsage("--files and --all are two forms: give one")
        if others:
            raise _SnapshotUsage(f"--files and --all take only --out <dir>, not "
                                 f"{', '.join(others)} (contract §3.6)")
        if opts["--out"] is None:
            raise _SnapshotUsage("--files <set> and --all need --out <dir>")
        if opts["--files"] is not None:
            wanted = opts["--files"].split(",")
            bad = [path for path in wanted if not register_render_path(path)]
            if bad:
                raise _SnapshotUsage(f"--files names {bad[0]!r}, which is not a render-set "
                                     f"path; <set> is render-set paths, comma-separated")
            opts["--files"] = sorted(set(wanted), key=lambda p: p.encode("utf-8"))
        problem = _register_snapshot_dir_problem("--out", opts["--out"])
        if problem:
            raise _SnapshotUsage(problem)
        return opts
    if opts["--out"] is not None:
        raise _SnapshotUsage("--out goes with --files <set> or --all; the scratch tree is "
                             "--tree <dir> --checkout <c>")
    if (opts["--tree"] is None) != (opts["--checkout"] is None):
        raise _SnapshotUsage("--tree <dir> and --checkout <lane checkout> go together")
    for flag, value in (("--write-id", write_id), ("--generation", generation)):
        if value is not None and value != "new" and not _SNAPSHOT_UUID_RE.fullmatch(value):
            raise _SnapshotUsage(f"{flag} {value!r} is not a UUID in lower case")
    if generation == "new":
        raise _SnapshotUsage("--generation new is not a generation; a new write passes "
                             "--write-id new alone")
    sha = opts["--args-sha256"]
    if sha is not None and not _SNAPSHOT_ARGS_SHA_RE.fullmatch(sha):
        raise _SnapshotUsage(f"--args-sha256 {sha!r} is not 64 lower-case hex")
    if at is not None:
        if not re.fullmatch(r"[0-9]+", at) or int(at) > _SNAPSHOT_SEQ_MAX:
            raise _SnapshotUsage(f"--at {at!r} is not a seq, a whole number of at least 0")
        opts["--at"] = at = int(at)
        if generation is None:
            raise _SnapshotUsage("--at <k> needs --generation <uuid>, alone or with the "
                                 "write's other four identity flags (contract §3.2, O13)")
        if write_id == "new":
            raise _SnapshotUsage("--at <k> reads history for a write already found, so it "
                                 "takes no --write-id new")
        if (write_id is None) != (not identity) or (write_id and len(identity) != 3):
            raise _SnapshotUsage("under --at, --generation <uuid> goes alone or with all four "
                                 "of --write-id, --lane, --verb and --args-sha256")
    elif write_id is None:
        if generation is not None or identity:
            raise _SnapshotUsage("an identity flag needs --write-id: <uuid> with all five, "
                                 "or new with --lane, --verb and --args-sha256")
    elif write_id == "new":
        if generation is not None:
            raise _SnapshotUsage("--write-id new takes no --generation: the snapshot mints "
                                 "the id, and prints the generation")
        if len(identity) != 3:
            raise _SnapshotUsage("--write-id new needs --lane, --verb and --args-sha256")
    else:
        if generation is None:
            raise _SnapshotUsage("--write-id <uuid> needs --generation <uuid>: a printed rerun "
                                 "carries LANES_WRITE_GENERATION (contract §3.2, O4)")
        if len(identity) != 3:
            raise _SnapshotUsage("--write-id <uuid> needs --lane, --verb and --args-sha256")
    if opts["--tree"] is not None:
        problem = _register_snapshot_dir_problem("--tree", opts["--tree"])
        if problem:
            raise _SnapshotUsage(problem)
        if not os.path.isdir(opts["--checkout"]):
            raise _SnapshotUsage(f"--checkout {opts['--checkout']} is not a directory")
    return opts


def register_snapshot_queries(*, write_id: str | None = None, images: bool = False,
                              at: int | None = None, since: int | None = None,
                              entry_blob: bool = False) -> list[str]:
    """The snapshot's SELECTs, for ONE REPEATABLE READ READ ONLY request, in
    this order, each through the store's `search_path`:
    1. `schema_version`'s version and floors (design §1.5);
    2. the switch: its mode, marker state and generation;
    3. the head;
    4. the database's clock, in whole seconds (D13), truncated as
       `journal.utc` is;
    5. with `write_id`, a UUID this file checked: that id's journal entry,
       its seq, lane, verb and `args_sha256`, then its `workstation` and its
       `utc` in epoch seconds, which a found entry prints (contract §3.2,
       draft 4.15: Y:1114 and Y:1106; lane 3's ruling, #165 6770688147, T418
       item 1), truncated as the clock is, though the journal's CHECK keeps
       `utc` in whole seconds;
    6. with `write_id`: that entry's `journal_files` rows, in the same
       transaction (Y:5300);
    7. with `entry_blob` and `at`: the `repos_blob` of the entry at `at + 1`,
       the one whose base is `at`;
    8. with `images`: T301's `register_render_queries` but its first, the head
       and the latest import, the journal, its edits and its digests, bounded
       by `at`, or by the head where `at` is None, and with `since` for the
       cache's seq."""
    queries = [
        "SELECT version, writers_from, readers_from FROM schema_version WHERE id = 1",
        "SELECT mode, marker_state, generation FROM register_switch WHERE id = 1",
        "SELECT seq FROM register_head WHERE id = 1",
        "SELECT floor(extract(epoch FROM clock_timestamp()))::bigint",
    ]
    if write_id is not None:
        quoted = _pg_quote(write_id)
        queries.append(f"SELECT j.seq, j.lane, j.verb, j.args_sha256, j.workstation, "
                       f"floor(extract(epoch FROM j.utc))::bigint FROM journal j "
                       f"WHERE j.write_id = {quoted}::uuid")
        queries.append(f"SELECT f.path, f.present, f.sha256 FROM journal_files f "
                       f"JOIN journal j ON j.seq = f.seq WHERE j.write_id = {quoted}::uuid "
                       f"ORDER BY f.path")
    if entry_blob and at is not None:
        queries.append(f"SELECT j.repos_blob FROM journal j WHERE j.seq = {int(at)} + 1")
    if images:
        bound = _SNAPSHOT_SEQ_MAX if at is None else int(at)
        queries += register_render_queries(bound, since=since)[1:]
    return queries


def _register_snapshot_start(at: int | None) -> tuple | None:
    """The cache's state for `start`, `(c, {path: (lines, final_newline)})`,
    in lane 1's callers' order: `image_cache_head`, then `image_cache_get` for
    each digest its manifest names, re-hashed by the get, then
    `register_cache_state`. None, a full replay, where there is no head,
    where its manifest names no render-set path, where any object misses,
    where the state cannot be read back, or where `at` is given and the
    cache's seq is above it: a head above `k` is never brought forward
    (lane 3's ruling, #165 6746004829). Without `at`, a head above `n` is
    found once the request answers, and is a miss there."""
    head = image_cache_head()
    if head is None:
        return None
    c, manifest = head
    if at is not None and c > at:
        return None
    images = {}
    for path, digest in manifest.items():
        if not register_render_path(path):
            continue
        data = image_cache_get(digest)
        if data is None:
            return None
        images[path] = data
    if not images:
        return None
    state = register_cache_state(images)
    return None if state is None else (c, state)


def _register_snapshot_digests(files: list, k: int) -> dict:
    """Each render-set path's latest digest at or below `k`, among the typed
    `journal_files` rows from the latest import, as the proof reads them:
    {path: sha256} for the paths present at `k`."""
    proved: dict = {}
    for seq, path, present, sha256, _final_newline in sorted(files, key=lambda row: row[0]):
        if seq > k:
            continue
        proved[path] = sha256 if present else None
    return {path: sha256 for path, sha256 in proved.items()
            if sha256 is not None and register_render_path(path)}


def _register_snapshot_images(store, answers: list, k: int, start) -> dict:
    """The render set's images at `k`, `{path: bytes}`, each proven, from the
    four render answers of the snapshot's own request
    (`register_snapshot_queries`' item 8) and the cache's `start`:
    - with `start` at `c` <= `k`, and the entries read being `c+1` to `k`,
      `register_images(..., start=start)`;
    - where that raises `RenderRefused`, or `c` is above `k`: A MISS. One
      more request, `_register_render_rows(store, k, None, "snapshot")`, the
      full replay from the latest import, as `register_render_read` makes it
      on a miss, with D9's snapshot row. Its images must equal the first
      request's digests at `k`, path for path, since seq `k` may have been
      reused between the two (lane 3's ruling, #165 6754819099, choice 6);
    - without `start`, the request already read the full rows, and they are
      replayed with no second request.
    A journal with no import, a `k` before the latest import, rows that do
    not replay, and a full replay that does not match raise `RenderRefused`,
    69. A `psql` that does not answer raises `PsqlFailed`."""
    head_rows, journal_rows, edit_rows, file_rows = answers
    if len(head_rows) != 1 or len(head_rows[0]) != 2:
        raise RenderRefused("the register's head row could not be read")
    latest = _render_int(head_rows[0][1], "the latest import's seq", null=True)
    if latest is None:
        raise RenderRefused("the journal holds no import, so no seq can be rendered from it")
    if k < latest:
        raise RenderRefused(f"seq {k} is before the latest import, seq {latest}: the journal "
                            f"renders only from that import's baseline on")
    journal = _render_rows(journal_rows, "journal")
    edits = _render_rows(edit_rows, "journal_edits")
    files = _render_rows(file_rows, "journal_files")
    span = (journal[0][0], journal[-1][0]) if journal else None
    if start is None:
        if span != (latest, k):
            raise RenderRefused(f"the journal's entries from seq {latest} to seq {k} were not "
                                f"all read")
        return register_images(journal, edits, files)
    c = start[0]
    # Line R's reader starts at the latest import where that is above c + 1.
    first = max(c + 1, latest)
    if c <= k and span == ((first, k) if c < k else None):
        try:
            return register_images(journal, edits, files, start=start)
        except RenderRefused:
            pass        # A MISS: the files are fetched whole, below
    images = register_images(*_register_render_rows(store, k, None, "snapshot"))
    want = _register_snapshot_digests(files, k)
    got = {path: hashlib.sha256(data).hexdigest() for path, data in images.items()}
    if got != want:
        differ = sorted(set(got) ^ set(want) | {p for p in got if got[p] != want.get(p)})
        raise RenderRefused(f"the register changed between this snapshot's read and its full "
                            f"read at seq {k}: {differ[0]} differs")
    return images


def _register_snapshot_git_env(*, build: bool = False) -> dict:
    """git's environment for the checkout's read and the tree's build:
    `_SNAPSHOT_GIT_LOCAL_VARS` dropped. For the build, no system or global
    configuration either, so no person's filter, hook path, signing or
    default branch reaches the scratch tree, and the commit's identity and
    date are this command's."""
    env = {k: v for k, v in os.environ.items()
           if k not in _SNAPSHOT_GIT_LOCAL_VARS and not k.startswith(("GIT_CONFIG_KEY_",
                                                                       "GIT_CONFIG_VALUE_"))}
    if build:
        env["GIT_CONFIG_NOSYSTEM"] = "1"
        env["GIT_CONFIG_GLOBAL"] = os.devnull
        env["GIT_TERMINAL_PROMPT"] = "0"
    return env


def _register_snapshot_git(where: str, *args: str, env: dict, data: bytes | None = None,
                           build: bool = False) -> bytes:
    """One git call in `where`, its stdout as bytes, or `SnapshotUnavailable`
    naming it. In the scratch tree (`build`), the default attributes and
    excludes files are named away, since `GIT_CONFIG_GLOBAL` leaves them."""
    argv = ["git"]
    if build:
        argv += ["-c", f"core.attributesFile={os.devnull}", "-c",
                 f"core.excludesFile={os.devnull}", "-c", "core.fsmonitor=false"]
    argv += ["-C", where, *args]
    try:
        proc = subprocess.run(argv, input=data, capture_output=True, check=False, env=env,
                              stdin=None if data is not None else subprocess.DEVNULL)
    except OSError as exc:
        raise SnapshotUnavailable(f"git could not be run: {exc}")
    if proc.returncode != 0:
        why = (proc.stderr.decode("utf-8", "replace").strip().splitlines() or ["no message"])
        raise SnapshotUnavailable(f"git {args[0]} in {where} exited {proc.returncode}: {why[-1]}")
    return proc.stdout


def _register_git_blob_id(data: bytes) -> str:
    """A blob's git id, the sha1 of `blob <size>` NUL and its bytes."""
    return hashlib.sha1(b"blob %d\x00" % len(data) + data).hexdigest()


def _register_snapshot_checkout(checkout: str, entry_blob) -> dict:
    """What the scratch tree takes from the lane checkout (contract §3.2;
    Y:5050): `{path: bytes}` for `lanes/repos.tsv` and `lanes/log/README.md`,
    each where it is there.
    - `lanes/log/README.md` is always `refs/remotes/origin/<branch>`'s, as last
      fetched, where that commit holds it as a regular file.
    - `lanes/repos.tsv` is that commit's too, where `entry_blob` is None; the
      blob `entry_blob` names, read from the checkout's objects, where it is a
      blob id (`--at`); and absent where `entry_blob` is `""` (`--at`, on an
      entry that recorded no `repos_blob`).
    A checkout with no such commit, an entry of another kind than a regular
    file, or a blob not in its objects raises `SnapshotUnavailable`."""
    env = _register_snapshot_git_env()
    ref = f"refs/remotes/origin/{branch()}"
    try:
        tip = _register_snapshot_git(checkout, "rev-parse", "--verify", "-q",
                                     f"{ref}^{{commit}}", env=env).decode("ascii", "replace")
    except SnapshotUnavailable:
        tip = ""
    tip = tip.strip()
    if not SHA_RE.match(tip):
        raise SnapshotUnavailable(f"{checkout} has no {ref} to take lanes/repos.tsv and "
                                  f"lanes/log/README.md from")
    listing = _register_snapshot_git(checkout, "ls-tree", "-z", tip, "--", "lanes/repos.tsv",
                                     "lanes/log/README.md", env=env)
    entries = {}
    for record in listing.split(b"\x00"):
        if not record:
            continue
        head, _, path = record.partition(b"\t")
        mode, kind, oid = head.decode("ascii", "replace").split(" ")
        if kind != "blob" or mode not in ("100644", "100755"):
            raise SnapshotUnavailable(f"{path.decode('utf-8', 'replace')} at {ref} in "
                                      f"{checkout} is not a regular file (mode {mode})")
        entries[path.decode("utf-8")] = oid
    if entry_blob is not None:
        entries.pop("lanes/repos.tsv", None)
        if entry_blob:
            entries["lanes/repos.tsv"] = entry_blob
    out = {}
    for path, oid in sorted(entries.items()):
        data = _register_snapshot_git(checkout, "cat-file", "blob", oid, env=env)
        if _register_git_blob_id(data) != oid:
            raise SnapshotUnavailable(f"{checkout}'s blob {oid} for {path} does not hash to "
                                      f"its id")
        out[path] = data
    return out


def register_snapshot_tree(tree_dir: str, files: dict, *, seq: int, clock: int) -> None:
    """THE SCRATCH TREE (contract §3.2; Y:5048-5052): `files`, `{path:
    bytes}`, the render set's images at `seq` with what the checkout gave,
    written at `<tree_dir>/<path>`, then `git init`, one commit of them, and
    `refs/remotes/origin/<branch>` pointing at it, with HEAD on
    `refs/heads/<branch>` at the same commit and the index equal to it.

    - NEVER A HARDLINK (FR-020; Y:5052): each file is written whole, from
      bytes, into a file of its own made with `O_EXCL`, never linked to a
      work-tree file or into the image cache.
    - The tree is built apart, in a `tempfile.mkdtemp` directory beside
      `<tree_dir>`, and renamed onto it, so `<tree_dir>` is as it was on any
      end but a return, as `register_write_images` builds `render --images`'s.
    - git runs with no system or global configuration and no template, so no
      hook, filter or signing a person configured runs here, and the commit
      is made by plumbing (`write-tree`, `commit-tree`, `update-ref`), which
      runs no hook. Its author and committer are this command, at the
      database's clock.
    Raises `SnapshotUnavailable` or `OSError`."""
    import tempfile     # used here alone, so the module's imports stay as they were
    target = os.path.abspath(tree_dir)
    parent = os.path.dirname(target)
    os.makedirs(parent, exist_ok=True)
    mask = os.umask(0)
    os.umask(mask)
    mode = (stat.S_IMODE(os.stat(target).st_mode) if os.path.isdir(target)
            else 0o777 & ~mask)
    build = tempfile.mkdtemp(prefix=f".{os.path.basename(target)}.tree-", dir=parent)
    env = _register_snapshot_git_env(build=True)
    name, email = _SNAPSHOT_TREE_IDENTITY
    env.update(GIT_AUTHOR_NAME=name, GIT_AUTHOR_EMAIL=email, GIT_COMMITTER_NAME=name,
               GIT_COMMITTER_EMAIL=email, GIT_AUTHOR_DATE=f"@{clock} +0000",
               GIT_COMMITTER_DATE=f"@{clock} +0000")
    head_ref = f"refs/heads/{branch()}"
    try:
        _register_snapshot_git(build, "init", "-q", "--template=", env=env, build=True)
        _register_snapshot_git(build, "symbolic-ref", "HEAD", head_ref, env=env, build=True)
        for path in sorted(files, key=lambda p: p.encode("utf-8")):
            where = os.path.join(build, *path.split("/"))
            os.makedirs(os.path.dirname(where), exist_ok=True)
            fd = os.open(where, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o666)
            with os.fdopen(fd, "wb") as handle:
                handle.write(files[path])
        _register_snapshot_git(build, "add", "-A", "--", ".", env=env, build=True)
        tree = _register_snapshot_git(build, "write-tree", env=env,
                                      build=True).decode("ascii").strip()
        commit = _register_snapshot_git(
            build, "commit-tree", tree, env=env, build=True,
            data=f"lanes-index register snapshot: the render set at seq {seq}\n".encode(
                "ascii")).decode("ascii").strip()
        for ref in (head_ref, f"refs/remotes/origin/{branch()}"):
            _register_snapshot_git(build, "update-ref", ref, commit, env=env, build=True)
        os.chmod(build, mode)
        os.rename(build, target)
    except BaseException:
        shutil.rmtree(build, ignore_errors=True)
        raise


def _register_snapshot_lr007(token: str, message: str) -> int:
    """Check 1's or check 2''s refusal, in §2.6's shape for the snapshot's
    two client checks: `ERROR:  LR007: <message>`, `DETAIL:  <token>`, then
    this file's own line. Exit 2, with nothing on stdout."""
    sys.stderr.write(f"ERROR:  LR007: {message}\nDETAIL:  {token}\n")
    note("register snapshot: refused; nothing was written")
    return EXIT_REFUSED


def _register_snapshot_one_row(rows: list, width: int, what: str) -> list:
    if len(rows) != 1 or len(rows[0]) != width:
        raise SnapshotUnavailable(f"the register's {what} could not be read")
    return rows[0]


def _register_snapshot(store, opts: dict) -> int:
    """`register snapshot` once its argv is a form and its store is made: the
    one request, the checks, the images, the tree or the images' directory,
    then stdout. Raises `PsqlFailed`, `StoreUnusable`, `RenderRefused` and
    `SnapshotUnavailable`, each 69 to its caller.

    UNDER `--at <k>` (contract §3.2, [P]) it checks only the generation, of
    the identity and the switch: no write-id check and no switch check, since
    it reads history for a write already found. The version window is still
    checked (check 3), since a client outside it may not read the schema at
    all (design §1.5, Y:2338). A `k` above the head is 69, as `render
    --images`' is. `n=` prints `k`, the seq the snapshot and its tree are at,
    and `repos.tsv` is the `repos_blob` of the entry at `k + 1`, the entry
    whose base is `k`, which a replay at `s - 1` replays (Y:5318-5321): absent
    where that entry recorded none, and the checkout's `origin/<branch>`'s
    where no entry follows `k`, as at the head."""
    write_id, generation, at = opts["--write-id"], opts["--generation"], opts["--at"]
    tree_dir, wanted = opts["--tree"], opts["--files"]
    images_wanted = tree_dir is not None or wanted is not None or opts["--all"]
    look_up = write_id if write_id not in (None, "new") and at is None else None
    start = _register_snapshot_start(at) if images_wanted else None
    queries = register_snapshot_queries(write_id=look_up, images=images_wanted, at=at,
                                        since=start[0] if start else None,
                                        entry_blob=tree_dir is not None)
    answers = store._query_many(queries, snapshot=True, row="snapshot")
    if len(answers) != len(queries):
        raise SnapshotUnavailable(f"psql answered {len(answers)} of the {len(queries)} reads "
                                  f"of one snapshot")
    version, writers_from, readers_from = (
        _render_int(v, "schema_version") for v in
        _register_snapshot_one_row(answers[0], 3, "schema_version row"))
    mode, marker, switch_generation = _register_snapshot_one_row(answers[1], 3, "switch row")
    if (mode not in ("files", "primary")
            or marker not in ("absent", "adding", "present", "removing")
            or not isinstance(switch_generation, str)
            or not _SNAPSHOT_UUID_RE.fullmatch(switch_generation)):
        raise SnapshotUnavailable(f"the register's switch row reads {mode!r}, {marker!r}, "
                                  f"{switch_generation!r}")
    head = _render_int(_register_snapshot_one_row(answers[2], 1, "head row")[0],
                       "register_head.seq")
    clock = _render_int(_register_snapshot_one_row(answers[3], 1, "clock")[0],
                        "the database clock")
    at_next = 4 + (2 if look_up else 0)
    # CHECK 1: the generation, whatever the switch reads and whether or not
    # the journal holds the id (Y:4986; S-3).
    if generation is not None and generation != switch_generation:
        if write_id not in (None, "new"):
            message = (f"write {write_id} belongs to register generation {generation}, not "
                       f"{switch_generation}")
        else:
            message = (f"this run's register generation {generation} is not the switch's, "
                       f"{switch_generation}")
        return _register_snapshot_lr007("generation", message)
    printed_id = write_id
    found = None
    if write_id == "new":
        import uuid     # used here alone, so the module's imports stay as they were
        printed_id = str(uuid.uuid4())
    elif look_up:
        # CHECKS 2 AND 2': the write id, with this run's lane, verb and
        # arguments, or another write's (Y:4987).
        entry = answers[4]
        if len(entry) > 1 or (entry and len(entry[0]) != 6):
            raise SnapshotUnavailable(f"the journal's entry of write {write_id} could not "
                                      f"be read")
        if entry:
            seq, lane, verb, args_sha256, workstation, utc = entry[0]
            seq = _render_int(seq, "journal.seq")
            if (lane, verb, args_sha256) != (opts["--lane"], opts["--verb"],
                                             opts["--args-sha256"]):
                return _register_snapshot_lr007(
                    "another-write", f"write {write_id} is seq {seq}, another write's (F10)")
            # The entry's `workstation=` and `utc=` (draft 4.15), each one
            # line. The journal's CHECK refuses only an empty workstation, so
            # a name holding a control character or any other line break
            # (`_SNAPSHOT_LINE_RE`) can be stored; it cannot be one line, and
            # is a failed read, as a `file=` path holding one is.
            utc = _render_int(utc, "journal.utc")
            if (not isinstance(workstation, str) or not workstation
                    or _SNAPSHOT_LINE_RE.search(workstation)):
                raise SnapshotUnavailable(f"seq {seq}'s journal.workstation {workstation!r} "
                                          f"cannot be a workstation= line")
            found = [seq, workstation, utc, []]
            for row in answers[5]:
                if len(row) != 3:
                    raise SnapshotUnavailable(f"seq {seq}'s journal_files rows could not be "
                                              f"read")
                path, present, sha256 = row
                present = _render_bool(present, "journal_files.present")
                if (not isinstance(path, str) or _SNAPSHOT_LINE_RE.search(path)
                        or (present and not (isinstance(sha256, str)
                                             and _IMAGE_DIGEST_RE.fullmatch(sha256)))):
                    raise SnapshotUnavailable(f"seq {seq}'s journal_files row {path!r} "
                                              f"cannot be a file= row")
                found[3].append(f"{path}\t{1 if present else 0}\t{sha256 if present else '-'}")
            found[3].sort(key=lambda r: r.split("\t", 1)[0].encode("utf-8"))
    if found is None:
        # CHECK 3: the version, after the write id, as `commit_write` checks it
        # (Y:1419's step order; §2.8).
        refusal = register_version_refusal(version, writers_from, readers_from, write=True)
        if refusal:
            note(f"register snapshot: {refusal}; nothing was written")
            return EXIT_UNAVAILABLE
        # CHECK 4: the switch (Y:4988), never under `--at`.
        if at is None and (mode, marker) != ("primary", "present"):
            note(f"register snapshot: the register's switch is {mode} with the marker "
                 f"{marker}, not primary with the marker present: a register write goes to "
                 f"SQL in one transaction or refuses, and is never made in the files instead "
                 f"(Amendment 22's S1, \"No fallback writes\"); nothing was written")
            return EXIT_UNAVAILABLE
        if at is not None and at > head:
            raise SnapshotUnavailable(f"seq {at} is above the head, seq {head}")
    n = head if at is None else at
    repos_blob = None
    out_rows = None
    if found is None and images_wanted:
        images = _register_snapshot_images(store, answers[-4:], n, start)
        if tree_dir is not None:
            entry_blob = None
            if at is not None:
                rows = answers[at_next]
                if rows:
                    blob = _register_snapshot_one_row(rows, 1, f"seq {at + 1}'s repos_blob")[0]
                    if blob is not None and not SHA_RE.match(blob):
                        raise SnapshotUnavailable(f"seq {at + 1}'s repos_blob reads {blob!r}")
                    entry_blob = blob or ""
            given = _register_snapshot_checkout(opts["--checkout"], entry_blob)
            for path in images:
                if _RENDER_CONTROL_RE.search(path):
                    raise RenderRefused(f"the image {path!r} holds a control character in its "
                                        f"path")
            register_snapshot_tree(tree_dir, {**images, **given}, seq=n, clock=clock)
            if "lanes/repos.tsv" in given:
                repos_blob = _register_git_blob_id(given["lanes/repos.tsv"])
        else:
            chosen = images if opts["--all"] else {p: images[p] for p in wanted if p in images}
            out_rows = register_write_images(opts["--out"], chosen)
            out_rows += [f"{p}\t0\t-" for p in (wanted or ()) if p not in images]
            out_rows.sort(key=lambda r: r.split("\t", 1)[0].encode("utf-8"))
        manifest = {path: image_cache_put(data) for path, data in images.items()}
        image_cache_record(n, manifest)
    _options, commit_timer = store.bounds("commit")
    say("format=1")
    say(f"generation={switch_generation}")
    if printed_id is not None:
        say(f"write_id={printed_id}")
    if found is not None:
        found_seq, found_ws, found_utc, found_rows = found
        say(f"found={found_seq}")
        say(f"workstation={found_ws}")
        say(f"utc={found_utc}")
        for row in found_rows:
            say(f"file={row}")
    say(f"switch={mode}")
    say(f"marker={marker}")
    say(f"n={n}")
    say(f"clock={clock}")
    say(f"not_after={clock + int(-(-commit_timer // 1)) + 2}")
    say(f"schema={version}")
    if repos_blob is not None:
        say(f"repos_blob={repos_blob}")
    say(f"c={store.connect_timeout}")
    say(f"n_a={store.addresses}")
    for row in out_rows or ():
        say(f"image={row}")
    return EXIT_OK


def cmd_register_snapshot(args: list[str]) -> int:
    """`lanes-index register snapshot` (contract §3.2, and §3.6 for `--files`
    and `--all`; T111), in the forms `_register_snapshot_args` reads.

    STDOUT: one `key=value` per line, LF-ended, in §3.2's order: `format=1`,
    `generation=`, `write_id=` (echoed, or minted for `--write-id new`;
    absent for `act-begin` and for `--generation` alone under `--at`),
    `found=`, then its entry's `workstation=` (`journal.workstation`) and
    `utc=` (`journal.utc`, in epoch seconds), then its seq's `file=` rows
    (all only where check 2 found the id; contract §3.2, draft 4.15),
    `switch=`, `marker=`, `n=`, `clock=`, `not_after=` (the clock plus the
    commit's client timer `C` plus 2 s), `schema=`, `repos_blob=` (only with
    `--tree`, where the tree holds `lanes/repos.tsv`), `c=` (`register_url=`'s
    `connect_timeout=`) and `n_a=` (`register_addresses=`). With `--files` or
    `--all`, one `image=<path>` TAB `<present>` TAB `<sha256>` row per path
    follows, sorted by path, bytewise. Nothing is printed on any end but 0.

    EXITS (contract §3.2; §3.6 for `--files`):
    - 0: read; or check 2 found the write, with no tree built;
    - 2: checks 1 and 2', each with §2.6's two lines; a refused
      configuration, Q6(c)'s refusal of `mode=primary` included;
    - 64: usage, before the configuration is read and before any connection;
    - 69: checks 3 and 4; a database it cannot reach, its timer `S` included;
      a 55P03 or any other refusal (Y:2627); any failed read, a found
      entry whose workstation cannot be one line included, an `--at <k>`
      above the head, a `k` it cannot render, a checkout it cannot read, and
      a tree or images it could not write, with `<dir>` as it was."""
    try:
        opts = _register_snapshot_args(args)
    except _SnapshotUsage as exc:
        note(f"register snapshot: {exc} - see {PROG} --help")
        return EXIT_USAGE
    if opts is None:
        say(USAGE)
        return EXIT_OK
    try:
        cfg = load_config()
        store = PostgresStore(cfg, "register_writer")
    except Refusal as exc:
        note(f"REFUSED: {exc}")
        return EXIT_REFUSED
    try:
        return _register_snapshot(store, opts)
    except PsqlFailed as exc:
        echoed = _register_psql_lines(exc)
        note(f"register snapshot: the register could not be read"
             f"{'' if echoed else ': ' + exc.detail}; nothing was written")
        code = next((m.group(1) for m in (re.match(r"ERROR:\s+([0-9A-Z]{5}):", line)
                                           for line in (exc.stderr or "").splitlines()) if m),
                    None)
        if exc.psql_exit == 3 and code in ("42P01", "42703"):
            note(f"register snapshot: a table or column this client reads is missing, so the "
                 f"register's schema may not be this client's, {REGISTER_SCHEMA_VERSION}: if "
                 f"it is newer, upgrade the tools; if it is older, the database is behind: "
                 f"run the bootstrap")
        return EXIT_UNAVAILABLE
    except StoreUnusable as exc:
        note(f"register snapshot: the register could not be read: {exc.detail}; nothing was "
             f"written")
        return EXIT_UNAVAILABLE
    except RenderRefused as exc:
        note(f"register snapshot: {exc}; nothing was written")
        return EXIT_UNAVAILABLE
    except (SnapshotUnavailable, OSError) as exc:
        note(f"register snapshot: {exc}; nothing was written")
        return EXIT_UNAVAILABLE


# ======================================================== the records built

