# `restart` already spends 2 on exactly this case — *"no such lane, no recorded
# directory, no profile recorded yet"* (clause (i), `R-A11-20`) — so after this
# the two commands answer the same way about the same fact.
if [ -z "$DIR" ]; then
  # EVERY PIECE OF THIS MESSAGE IS BUILT OUT HERE, and that is this file's own
  # rule rather than a style: an apostrophe inside a `${var:-…}` expansion is
  # parsed by bash as a QUOTE and not as prose, and the whole script then fails
  # to parse. `restart` carries the same warning over the same kind of hint.
  ls_where="$PROJECTS_ROOT/$repo"
  [ -z "$DIR_DEFAULT_TRIED" ] || ls_where="$DIR_DEFAULT_TRIED"
  ls_pos="${LANE##*-}"
  if [ -n "$ls_home" ]; then
    ls_tried="the default $ls_where, the project.yaml legs of $ls_home, and a checkout of $ls_home one or two levels under $PROJECTS_ROOT"
  else
    ls_tried="the default $ls_where. This lane has no home on record either, so there was nothing to prove a candidate against"
  fi
  die "lane $LANE has no recorded checkout and none could be PROVED, so nothing was started.
    Tried: $ls_tried.
    Name it once, and every later start reads it back out of the lane's own log:
      lane-start --dir <path> $repo $ls_pos
    Nothing here guesses. This script writes the lane HOME from the directory's
    origin, and a directory that merely has the right name would re-home the lane
    for every \`#n\` it writes afterwards (Amendment 11 clause (c); Evidence 7,
    brettheap/new-workstation#20 comment 5656793094)." 2
fi
DIR="$(cd -- "$DIR" && pwd)"
DIR_REAL="$(cd -- "$DIR" && pwd -P)"
[ "$DIR_SOURCE" = "--dir" ] || step "dir $DIR, from $DIR_SOURCE (Amendment 11 clause (c))"

# THE DIRECTORY THIS SCRIPT IS ABOUT TO RECORD MUST BE READABLE BACK OUT OF THE
# LINE THAT RECORDS IT (clause (c), and Amendment 8(b)'s same refusal for
# `window`). `, ` and ` — ` are what divide an event line into its fields and
# its free text, `; ` is what divides the payload's SUB-FIELDS from each other,
# and a `"` is what clause (c) uses to make a path with a space ONE ref under
# Amendment 7(b)'s grammar — so a path carrying any of the four is REFUSED,
# naming the path, rather than truncated, escaped or appended. A log whose own
# parser cannot read a line is a log that has lost the fact.
#
# `; ` WAS THE ONE THIS FENCE DID NOT HAVE, and clause (c) names it in the same
# breath as the other two: *"A value containing `, `, ` — ` or `; ` is refused,
# exit 2, naming it — not truncated, not escaped, and not appended."* The
# `/lane-swap` skill, the other writer the clause names, has refused all three
# since `68614bf`; this one refused two of them and the quoting does NOT cover
# the gap. `payload_subfield` splits on `; ` BEFORE it honours a quote
# (`lanes-edit.sh:payload_subfield`), so `dir "/p/a; b"` — quoted, because it
# carries a space — splits into `dir "/p/a` and `b"`, and `lane-dir` answers
# `"/p/a`: a path that is wrong, carries a quote mark, and was never written by
# anyone. That is Evidence 3's failure exactly, in a file nothing rewrites.
case "$DIR" in
  *', '*|*' — '*|*'; '*|*'"'*)
    die "this lane's directory is $DIR, and a \`dir\` sub-field may not contain ', ', ' — ', '; ' or '\"': those are what divide an event line into its fields, its sub-fields and its free text, and the log is append-only, so a line written wrong there is wrong for ever. Move the checkout, or start the lane with --dir <a path without them>" 2 ;;
esac

# THIS LANE'S OWN ARGUMENTS, so no hint this script prints ever hands a reader a
# `<repo> <n>` to translate while the script holds both (F-B6's rule, on this
# side of the seam). A lane named before the `<repo>-<position>` rule has no
# position to print and is started through `--dir`, exactly as it was here.
if [ -n "$n" ]; then self_args="$repo $n"; else self_args="--dir $(quoted "$DIR") $LANE"; fi

step "lane $LANE · dir $DIR · estate $estate"

# ----------------------------------------------------------------- 2. in tmux

[ -n "${TMUX:-}" ] || die "run this inside the tmux window that will carry the lane — it renames that window and never creates a tmux session" 1
command -v tmux >/dev/null 2>&1 || die "tmux is not on PATH, but \$TMUX is set — this environment is inconsistent" 1
this_window="$(tmux display-message -p '#{session_name}:#{window_id}' 2>/dev/null || :)"
[ -n "$this_window" ] || die "tmux did not answer display-message — cannot tell which window this is" 1
this_window_name="$(tmux display-message -p '#W' 2>/dev/null || :)"
# AMENDMENT 11 CLAUSE (c) — THE WINDOW SUB-FIELD IS `<tmux session>:<window
# index> <@window id>`, TWO SPACE-SEPARATED REFS IN ONE SUB-FIELD, and neither
# of them is the `<session>:<@id>` above. That one is the harness's own `tmux`
# spelling and is what `window-session` matches a session record on; the
# record's refs are a person's `<session>:<index>` and tmux's own `<@id>`,
# which is what clause (b)'s precedence 3 and clause (h)'s `window-lane` match.
# Reading one for the other is how a record would name a window nothing can
# resolve, so both are captured here, from tmux, and neither is derived from
# the other.
this_window_ref="$(tmux display-message -p '#{session_name}:#{window_index}' 2>/dev/null || :)"
this_window_id="$(tmux display-message -p '#{window_id}' 2>/dev/null || :)"
record_window="$this_window_ref"
# THE ID IS WRITTEN WHERE ONE IS KNOWABLE AND THE SUB-FIELD IS THE REF ALONE
# WHERE IT IS NOT: a record with no id is COMPLETE, because the NAME is the key
# (clause (b)) and the id is information (ratified decision 5). A tmux server
# restart, a workstation reboot or a swap taken from a terminal that is then
# closed all leave a recorded id naming nothing, and a binding keyed on the id
# would lose the lane where one keyed on the name does not.
# AND AN ID IS `@<digits>` AND NOTHING ELSE (F-X13(a)). `@*` accepted anything
# that merely STARTED with an at-sign, and two things that are not ids do: a
# tmux too old to know `#{window_id}` PRINTS THE FORMAT BACK, and a shim on
# PATH may print anything at all. Either one recorded here is a lie in an
# append-only log — and worse than an absence, because the sub-field would then
# name a window `window-lane` can never resolve while looking complete.
# `claude-profile` makes exactly this check on exactly this value
# (`workBenches#71`'s `lane-swap` skill, `:239-240`: `[[ "$win_id" =~
# ^@[0-9]+$ ]]`), and two writers of one field with two standards is the drift
# this branch removes everywhere else.
#
# Written as a `case` rather than `[[ =~ ]]` to match this file's own style for
# this test: `@` alone is not an id, and `@` followed by any non-digit is not
# one either.
case "$this_window_id" in
  @) : ;;
  @*[!0-9]*) : ;;
  @*) record_window="$this_window_ref $this_window_id" ;;
esac
case "$record_window" in
  *', '*|*' — '*|*'"'*)
    die "this window's tmux refs are '$record_window', and a \`window\` sub-field may not contain ', ', ' — ' or '\"' (Amendment 8(b), extended by Amendment 11 clause (c) to \`dir\`): those are what divide an event line into its fields and its free text, and the log is append-only. Rename the tmux session" 2 ;;
esac
step "this window is $this_window, named '${this_window_name:-?}'"
step "  its record refs are $record_window"

# A RESTART-INTENT ANSWER IS READ TO ITS END (slice 2b; CI run 39806108007 at
# f1b19e9, openRepoTools#281's class). Each field used to be read with
# `printf … | awk '… { print $2; exit }'`, and under `set -o pipefail` that is
# a launch that can die with 141 and no word said: bash's `printf` writes the
# answer a line at a time, an `awk` that has found its line and exited closes
# the pipe under a writer that is not done, the writer's SIGPIPE becomes the
# pipeline's status, and `set -e` exits on it — at a rate the scheduler
# decides. So the answer is captured once (`x="$(…)"`), and each field is read
# by an `awk` that reads to the end and keeps the FIRST value, as the early
# exit did. Nothing here pipes into a reader that stops.
intent_field() {   # <restart-intent output> <field name>
  printf '%s\n' "$1" | awk -F'\t' -v k="$2" '$1 == k && !f { f = 1; v = $2 } END { if (f) print v }'
}

# Active restarts refuse unowned callers before any binding repair or rename.
# Detailed prompt and launch-fact validation follows before transcript writes.
preparation_failure_identity=""
preparation_failure_snapshot() {   # validated restart-intent output
  printf '%s\n' "$1" | awk -F'\t' '
    {v[$1]=$2} END {printf "%s|%s|%s|%s|%s|%s", v["state"],v["mode"],v["attempt"],v["new_transcript"],v["operation"],v["generation"]}'
}
preparation_failure_resume_check() {   # validated restart-intent output
  pfr_identity="$(preparation_failure_snapshot "$1")"
  case "$pfr_identity" in failed\|preservation-only\|0\|none\|*) : ;;
    *) die "a failed supervised launch requires its same-operation supervisor; ordinary resume refuses. Nothing was launched." 2 ;;
  esac
  [ -z "$preparation_failure_identity" ] || [ "$pfr_identity" = "$preparation_failure_identity" ] ||
    die "the failed preparation changed during ordinary recovery. Nothing was launched." 2
  [ -z "${op_flag:-}${LANE_RESTART_OPERATION:-}${LANE_RESTART_ATTEMPT:-}" ] ||
    die "failed preparation permits only ordinary resume without restart operation or attempt tokens. Nothing was launched." 2
  [ "${fresh_flag:-0}" != 1 ] && [ "${LANE_START_FRESH:-0}" != 1 ] ||
    die "failed preparation permits only ordinary resume, not a fresh session. Nothing was launched." 2
  LANES_NO_FETCH=1 "$LANES_EDIT" legacy-restart-check "$LANE" ||
    die "managed or unknown ownership blocks failed-preparation recovery. Nothing was launched." 2
  pfr_holder_rc=0
  LANES_NO_FETCH=1 "$LANES_EDIT" lane-holders "$LANE" >/dev/null || pfr_holder_rc=$?
  [ "$pfr_holder_rc" = 8 ] ||
    die "ordinary recovery from failed preparation requires confirmed absence of every holder (lane-holders exited $pfr_holder_rc). Nothing was launched." 2
  preparation_failure_identity="$pfr_identity"
}
eri_rc=0
eri_out="$(LANES_NO_FETCH=1 "$LANES_EDIT" restart-intent "$LANE" --dir "$DIR" 2>/dev/null)" || eri_rc=$?
case "$eri_rc" in
  0)
    eri_state="$(intent_field "$eri_out" state)"
    eri_op="$(intent_field "$eri_out" operation)"
    case "$eri_state" in
      preparing) die "this restart is still preparing its preservation records. Nothing was changed." 2 ;;
      failed) preparation_failure_resume_check "$eri_out" ;;
      pending|starting)
        eri_token="${op_flag:-${LANE_RESTART_OPERATION:-}}"
        [ -n "$eri_token" ] || die "an active restart requires its supervisor operation token. Nothing was changed." 2
        [ "$eri_token" = "$eri_op" ] || die "operation $eri_token is not lane $LANE's current restart operation $eri_op. Nothing was changed." 2
        LANES_NO_FETCH=1 "$LANES_EDIT" legacy-restart-check "$LANE" || die "managed ownership blocks this legacy restart. Nothing was changed." 2
        # --no-launch is a read-only command preview for an active restart.
        (( ! no_launch )) || dry_run=1 ;;
      ready) : ;;
      INCOMPLETE) die "the restart intent is INCOMPLETE: its fenced fields cannot compare. Nothing was changed. Read it: lanes-edit.sh restart-intent $LANE" 2 ;;
      UNKNOWN-SCHEMA) die "the restart schema is unreadable (Amendment 7(d)). Resuming could open the transcript that /ctx PAUSED. Update this workstation's openRepoTools or reconcile the intent once no restart is active. Nothing was changed." 2 ;;
      *) die "the restart intent is malformed ($eri_state). Nothing was changed." 2 ;;
    esac ;;
  8|2) : ;;
  1) die "the restart intent could not be read. That is NOT 'no restart is in flight': ordinary resume could open the transcript that /ctx PAUSED. Set LANES_LANE_STATE_ROOT to a readable control root. Nothing was changed." 2 ;;
  *) die "the restart intent could not be read. Nothing was changed." 2 ;;
esac

# -------------------------------------------------------- 3. liveness check

# THE SEAM (ruling 2026-10-04): A MANAGED-OWNED LANE IS NOT THIS COMMAND'S.
# `lanes-edit.sh managed-projection` answers 0 with the owner where the lane's
# register row carries the managed ledger's marker, 8 for a legacy lane, and 1
# where ownership could not be established. ANY other status — a helper that
# predates the verb included — is UNKNOWN as well, and refused the same way:
# a fence that opens because its read failed is no fence (Amendment 7(d)).
# A 69, 75 or 3 is UNKNOWN too, and exits 1, never the code passed on
# (feature 007, T402; S4; DEC-27; research.md ERR-46).
seam_refuse() {   # <lane> <the act>
  sr_out=""; sr_rc=0
  sr_out="$("$LANES_EDIT" managed-projection "$1" 2>/dev/null)" || sr_rc=$?
  case "$sr_rc" in
  0) die "lane $1 is owned by the managed ledger (owner ${sr_out:-unnamed}), and $2 is a legacy lane act, refused here, before the binding is read, before a handoff is requested of anybody and before a byte is written: no row, no log line, no stamp, no window name, no launch. Brett Heap's ruling of 2026-10-04: \"managed ledger owns enrolled lanes; #97 owns legacy\". Act on this lane through the managed ledger." 2 ;;
  8) : ;;
  *) die "whether the managed ledger owns lane $1 is UNKNOWN (\`$LANES_EDIT managed-projection $1\` exited $sr_rc): its register row carries managed-owner vocabulary that does not parse, or the read failed. An ownership nobody could establish is never read as legacy (Amendment 7(d)), so $2 is refused here, before the binding is read, before a handoff is requested of anybody and before a byte is written: no row, no log line, no stamp, no window name, no launch. Read it: $LANES_EDIT managed-projection $1" 1 ;;
  esac
}
# AT THE TOP OF SECTION 3, and so BEFORE Amendment 18's binding gate and its
# `request-handoff`: asking a managed lane's place to hand off is itself a
# legacy act on that lane.
seam_refuse "$LANE" "a lane start"

# The row, READ (never written) with the same rule lanes-edit.sh uses to find
# one: the row's FIRST backticked token is the lane name.
# AMENDMENT 15 — `tolower` ON BOTH SIDES, exactly as `row_line` now compares.
# This read is what decides "is this lane new", and it was the byte-for-byte
# comparison that let `lane-start openxfactory 2` add a SECOND row for
# `openXfactory-2` at 2026-09-13T23:51:56Z. Case-insensitive, the lane is found,
# the branch below is the RESUME branch, and `add-row` is never reached.
rows_for_lane() {
  ls_register_text | awk -v lane="$1" '
    substr($0,1,1) == "|" {
      p1 = index($0, "`"); if (p1 == 0) next
      rest = substr($0, p1 + 1); p2 = index(rest, "`"); if (p2 == 0) next
      if (tolower(substr(rest, 1, p2 - 1)) == tolower(lane)) print
    }'
}
# The names those rows carry — which under Amendment 15 may be two spellings of
# ONE name, and a refusal that could not say so would send a person looking for
# a duplicate that is not there to find.
row_names_for_lane() {
  ls_register_text | awk -v lane="$1" '
    substr($0,1,1) == "|" {
      p1 = index($0, "`"); if (p1 == 0) next
      rest = substr($0, p1 + 1); p2 = index(rest, "`"); if (p2 == 0) next
      t = substr(rest, 1, p2 - 1)
      if (tolower(t) == tolower(lane)) print t
    }'
}

ls_register_load
row="$(rows_for_lane "$LANE" || :)"
row_count=0
[ -n "$row" ] && row_count="$(printf '%s\n' "$row" | grep -c . || :)"

if [ "$row_count" -gt 1 ]; then
  rfl_names="$(row_names_for_lane "$LANE" | tr '\n' ' ')"
  rfl_distinct="$(row_names_for_lane "$LANE" | LC_ALL=C sort -u | grep -c . || :)"
  rfl_why="and lanes-edit.sh can edit neither"
  if [ "$rfl_distinct" -gt 1 ]; then
    # BRACED, AND THE BRACES ARE LOAD-BEARING (A9 Addendum 4, R-A9-11): bash
    # decides where a variable NAME ends with `isalnum()`, which is LOCALE-
    # DEPENDENT, and bash 3.2 on Darwin under the runner's `en_US.UTF-8` reads
    # the three bytes of `—` as name characters — so this looks up
    # `rfl_names—`, which `set -u` then kills the script over. Caught by
    # `test_no_shipped_bash_leaves_a_variable_name_to_bash_3_2s_locale`, which
    # is the rule this repository already learned once.
    rfl_why="spelled ${rfl_names}— a lane name is ONE name under any case (Amendment 15), so those are two rows for ONE lane, and lanes-edit.sh can edit neither"
  fi
  # UNDER THE OPT-IN A ROW IS NEVER MERGED IN W (lane openRepoTools-3's review
  # of #316, 730). `$LANES_FILE` is W here, the readers' copy, where no tool
  # writes (Amendment 23 S5), and the publish act commits in the lane's own
  # checkout, not in W. So where origin/<branch>, as W last fetched it, carries
  # fewer than two such rows, the duplicate is only in W's working tree: a
  # stray there, which a person takes out. Where origin carries it, the merge
  # is a hand edit of the lane's own checkout's register, published from there.
  # (With this helper a published duplicate is refused before this point:
  # `canon-lane` above and the managed-ledger fence read the published register.
  # So the stray is the case met here, and the second arm is the right words
  # for a path that reaches it anyway.)
  if [ "$LS_ROUTED" = 1 ]; then
    rfl_br="${LANES_BRANCH:-main}"
    rfl_pub="$row_count"
    if [ "$LS_ROWS_FROM" != ref ]; then
      rfl_pub=""
      # Through the reader verb (T428, `ls_ref_register_text`); any failure
      # keeps the second wording below, since this count only picks words.
      if ls_ref_register_text "refs/remotes/origin/$rfl_br"; then
        rfl_text="$LS_REF_TEXT"
        rfl_pub="$(LS_ROWS_FROM=ref; LS_ROWS_TEXT="$rfl_text"; rows_for_lane "$LANE" | grep -c . || :)"
      fi
    fi
    if [ -n "$rfl_pub" ] && [ "$rfl_pub" -lt 2 ]; then
      die "W's working tree has $row_count rows for lane $LANE, and origin/$rfl_br, as W last fetched it, has $rfl_pub, so the duplicate is a stray in W ($LANES_FILE), the readers' copy, where no tool writes (Amendment 23 S5; \`$LANES_EDIT refresh-workspace\` names it). Taking it out of W is a person's act; then re-run. Nothing was launched, renamed or written." 2
    fi
    rfl_co="$("$LANES_EDIT" lane-checkout "$LANE" 2>/dev/null || :)"
    if [ -n "$rfl_co" ]; then
      rfl_where="the lane's own checkout's register, $rfl_co/lanes/LANES.md,"
    else
      rfl_where="the lane's own checkout's register, lanes/LANES.md in the checkout that LANES_ROUTE_WRITES=1 $LANES_EDIT lane-checkout $LANE --create makes and names,"
    fi
    die "the register has $row_count rows for lane $LANE, $rfl_why. Merge them into one row by hand in $rfl_where never in W ($LANES_FILE), the readers' copy, where no tool writes (Amendment 23 S5) — Amendment 15(d): append the newer row's session id(s) to the older row's session cell, in order, and remove the newer row in the SAME commit, whose message names both spellings — then publish it from there with 'LANES_LANE=$LANE LANES_ROUTE_WRITES=1 lanes-edit.sh commit \"merged duplicate rows\"' and re-run" 2
  fi
  die "the register has $row_count rows for lane $LANE, $rfl_why. Merge them into one row by hand in $LANES_FILE (one line each) — Amendment 15(d): append the newer row's session id(s) to the older row's session cell, in order, and remove the newer row in the SAME commit, whose message names both spellings — then commit with 'LANES_LANE=$LANE lanes-edit.sh commit \"merged duplicate rows\"' and re-run" 2
fi

# AND EVERYTHING THIS SCRIPT DECIDES FROM THE ROW IS DECIDED AGAINST WHAT HAS
# LANDED, not against this checkout. `$LANES_FILE` is the working tree, and a
# `git fetch` does not move it: a row another workstation added and pushed, or a
# uuid it stamped on an existing row, is simply absent here until something
# pulls. Two decisions turn on that row and BOTH used to read the working tree.
#   "IS THIS LANE NEW" — reaching `add-row` on that reading appends a SECOND row
#     (`add-row` checks the working tree too, and `commit_push`'s rebase then
#     brings the peer's row in underneath it), and two rows for one lane is a
#     register no helper can edit at all, because `row_line` requires exactly one.
#   "WHICH SESSION IS THIS LANE'S" — the resume target, the id in the status
#     appended to the row, and the uuid stamped on the RESUMED / STARTED line
#     (see THE RESUME TARGET above).
# So: ask for the PUBLISHED row ONCE, here, for both. 0 and 8 are the answers;
# anything else is the helper failing, and this script decides nothing about a
# row on an answer it did not get. LANES_NO_FETCH=1 is honoured inside the
# helper, for an offline start.
pub_rc=0
pub_row="$("$LANES_EDIT" register-row "$LANE" 2>/dev/null)" || pub_rc=$?
if [ "$row_count" = 0 ]; then
  case "$pub_rc" in
    8) : ;;                        # no published row either: the lane really is new
    0)
      note "the register on origin/main ALREADY has a row for $LANE, and this checkout does not:"
      pub_row_first="${pub_row%%$'\n'*}"
      printf '  %s\n' "${pub_row_first:0:200}" >&2
      note "adding a row here would make two, and two rows for one lane is a register lanes-edit.sh cannot edit."
      note "RECOVERY — bring this checkout up to date, then re-run this command:"
      # NEVER A PULL (Amendment 23 S3, S5): W, the default register read, is
      # only ever fast-forwarded, and by one act; a caller's own checkout is
      # brought up the same two ways.
      if [ "$LANES_REG_DEFAULT" = 1 ]; then
        note "  $LANES_EDIT refresh-workspace   # W is only ever fast-forwarded; it says what blocks it"
      else
        ls_top="$(cd -- "$(dirname -- "$LANES_FILE")/.." && pwd)"
        note "  git -C \"$ls_top\" fetch origin ${LANES_BRANCH:-main} && git -C \"$ls_top\" merge --ff-only origin/${LANES_BRANCH:-main}"
      fi
      die "refusing to add a second row for $LANE" 2 ;;
    *)
      note "the helper's own output is above."
      die "$LANES_EDIT register-row $LANE failed (exit $pub_rc). That is NOT 'the register has no row for $LANE', and this script will not add a row on an answer it did not get — a duplicate row is a register no helper can edit. Fix the helper (or run it by hand: $LANES_EDIT register-row $LANE), then re-run." "$(ls_read_code "$pub_rc" 1)" ;;
  esac
else
  case "$pub_rc" in
    0) : ;;
    8)
      # A row HERE and none on `origin/main`: it is in a commit this checkout
      # has not pushed, or on another branch. There is then no published cell,
      # so there is no recorded session to resume — and this script does not
      # fall back to the working tree, because falling back is the fault. The
      # ids below are named as DIAGNOSTICS, never as a target: nothing outside
      # this checkout can see them. `lane-end`'s refusal reads `origin/<branch>`
      # for the same reason and cannot see an unpushed line either — what has
      # landed is what other lanes can see.
      note "this checkout has a row for $LANE and the register on origin/main has none — so there is no PUBLISHED session cell, and no recorded session to resume."
      unpub_ids="$(printf '%s\n' "$row" | awk -F'|' '{print $3}' | grep -oiE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' | tr 'A-F' 'a-f' | tr '\n' ' ' || :)"
      [ -n "$unpub_ids" ] && note "  the id(s) only this checkout's copy carries, which nothing else can see: ${unpub_ids% }"
      # THE PUBLISH ACT, NEVER A BARE PUSH (Amendment 23 S3): `commit` with
      # nothing staged publishes what the checkout has that origin lacks, and
      # carries a hand edit of the register as its own commit. W takes no
      # write at all, so a row only W carries is a stray there (S5).
      if [ "$LS_ROUTED" = 1 ]; then
        note "  RECOVERY — that row is a stray in W, the readers' copy, where no tool writes (Amendment 23 S5; \`$LANES_EDIT refresh-workspace\` names it): make it a write of the lane's own checkout and publish it from there, LANES_LANE=$LANE $LANES_EDIT commit \"<what it is>\", or take it out of W, then re-run."
      else
        note "  RECOVERY — publish the register from here, then re-run: LANES_LANE=$LANE $LANES_EDIT commit \"<what it is>\" (the publish act, in $(cd -- "$(dirname -- "$LANES_FILE")/.." && pwd))"
      fi ;;
    *)
      note "the helper's own output is above."
      die "$LANES_EDIT register-row $LANE failed (exit $pub_rc). That is NOT 'the register has no row for $LANE', and this script will not pick a resume target on an answer it did not get: resuming the working tree's id lands the operator in the lane's previous conversation and stamps that uuid on an append-only line. Fix the helper (or run it by hand: $LANES_EDIT register-row $LANE), then re-run." "$(ls_read_code "$pub_rc" 1)" ;;
  esac
fi

# Every field of a `| … |` row by position: 1 is empty (before the leading
# pipe), 2 the lane cell, 3 the session-id cell, NF-1 the state cell.
# OF THE PUBLISHED ROW. `$row` above is this checkout's, and it is read for
# exactly one thing: whether adding a row would make two. Every id this script
# acts on comes from `$pub_row`, which is empty when the published register has
# no row for the lane — the case the `8` branch above has already reported.
cell() { printf '%s\n' "$pub_row" | awk -F'|' -v i="$1" '{print $i}'; }

# Only the SESSION-ID CELL is read for ids. State cells quote other lanes'
# session ids all the time ("RESUMED by <id>", "handed off to <id>"), and a
# live one of those is not this lane's holder.
# Two readings of the same cell. The liveness check below wants the SET, so it
# sorts; the resume target wants the ORDER, because the cell is a history and
# its LAST id is the lane's current session (see THE RESUME TARGET above).
session_ids=""
session_ids_ordered=""
if [ "$row_count" = 1 ]; then
  session_ids_ordered="$(cell 3 | grep -oiE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' | tr 'A-F' 'a-f' || :)"
  [ -n "$session_ids_ordered" ] && session_ids="$(printf '%s\n' "$session_ids_ordered" | sort -u)"
  id_count=0; [ -n "$session_ids" ] && id_count="$(printf '%s\n' "$session_ids" | grep -c . || :)"
  step "the register already has a row for $LANE; its session cell on origin/main names $id_count session id(s)"
  # A row may record only `session_01…` FOOTER ids. Those are not transcript
  # ids: a transcript is `<uuid>.jsonl`, so a footer id can neither be checked
  # for liveness nor resumed. Name the gap rather than behave as if the cell
  # were empty — that silence is what made 2026-09-11 hard to diagnose.
  if [ "$id_count" = 0 ]; then
    footer_ids="$(cell 3 | grep -oE 'session_[A-Za-z0-9]{10,}' | sort -u || :)"
    if [ -n "$footer_ids" ]; then
      note "the cell records only PR-footer ids ($(printf '%s' "$footer_ids" | tr '\n' ' ')), which are not transcript ids — so this lane has no liveness check and no resume target. Its session must stamp its TRANSCRIPT uuid (the name of its <uuid>.jsonl) on the row."
    fi
  fi
else
  step "the register has no row for $LANE yet"
fi

# LIVENESS IS ONE IMPLEMENTATION, and it lives in `lanes-edit.sh`, because
# `who` asks exactly this question about exactly these rows and two copies
# would drift. It reads the row's session cell itself and tries EVERY
# transcript uuid recorded there, not merely the last one — a lane whose
# earlier lineage is still running is still held.
#
# It also carries the `nameSource` fix: a session record's `name` is evidence
# about some OTHER lane only when a person or a peer set it. `nameSource:
# derived` is the harness naming a window after its working directory, and
# treating that as a denial reported "no live session holds <lane>" for
# sessions that plainly did (2026-09-11, the orchestrator's own window).
# ONLY 0 AND 8 ARE ANSWERS: 0 is "this record holds the lane", 8 is "no live
# record does". Any other exit is the helper FAILING, and this script must not
# read a failure as "the name is free" — renaming a running session into a
# title something else still holds is exactly what mints `<lane> (2)` and costs
# the lane its address (AGENTS.md rule 7). The first version swallowed the
# helper's stderr and treated every non-zero exit as "no holder", so a helper
# that could not run at all produced a confident "no live session holds <lane>"
# about a session that was live in another window.
live_holder() { "$LANES_EDIT" live-holder "$LANE"; }

# AND IT IS ASKED UNCONDITIONALLY. This used to run only when the row THIS
# CHECKOUT has already named a session id, which is the wrong gate twice over:
# the ids came from the working tree, which no fetch moves, so a row (or a newly
# stamped uuid) that another workstation had already published was read as "no
# ids, nothing to check"; and a lane with no row here at all skipped the check
# entirely. Both skip exactly when the answer matters — the helper owns the row
# lookup, fetches first, and unions the published ids with this checkout's (R25),
# so asking it costs one fetch and can only ever ADD a reason to refuse.
holder_here=0
# Made at the act base above (T428), where `act-begin`'s words are held.
[ -n "$LS_TMP" ] || LS_TMP="$(mktemp)"
: > "$LS_TMP"
holder=""; lh_rc=0
holder="$(live_holder 2>"$LS_TMP")" || lh_rc=$?
[ -s "$LS_TMP" ] && cat -- "$LS_TMP" >&2
case "$lh_rc" in
  0)
    # WHOSE SESSION IT IS COMES FROM THE HELPER (Amendment 8, ruling (g)), not
    # from a string compare on the `tmux` column here. The first version made
    # that compare, and on 2026-09-12 it refused this lane the window it was
    # running in: the record it was handed was the harness's `kind: bg`
    # COMPANION, which carries the interactive session's own `sessionId` and no
    # `tmux` at all, so `"none" != "$this_window"` and the refusal read
    # "lane openRepoProject-1 is live in session c5701b54… (tmux none)" about
    # the session typing the command. A record with no target is not a record in
    # no window — the helper now answers with `here`, `elsewhere` or `orphan`,
    # having tested `$CLAUDE_CODE_SESSION_ID`, the window, and this pane's
    # process tree in that order.
    #
    # AN EMPTY FIFTH FIELD IS A REFUSAL, not a pass: an older `lanes-edit.sh`
    # that does not send one must not be read as saying "here".
    IFS=$'\037' read -r h_id h_target h_name h_pid h_where <<<"$holder"
    case "$h_where" in
      here)
        holder_here=1
        step "this window's own session $h_id (pid $h_pid, name '${h_name:-none}') already holds $LANE — carrying on" ;;
      orphan)
        # AMENDMENT 6(d), and not a refusal. A live record that names no window
        # and is in no pane's process tree is an idle background session still
        # holding the name — the thing 6(d) says to retire. It is not in this
        # window, so it is not this window's session; it is in no window, so it
        # is nobody's rival either. Say so, name the act, and carry on.
        note "lane $LANE is named by a live record that is in NO window and not in this pane's process tree: session $h_id, pid $h_pid, name '${h_name:-none}'. That is an orphaned holder, not a rival (Amendment 6(d)) — retire it: kill $h_pid. Carrying on."
        ;;
      *)
        note "lane $LANE is live in session $h_id (tmux ${h_target:-unknown}); take $repo-$next_n or resume that window"
        note "  $prog $repo $next_n"
        note "  tmux switch-client -t ${h_target%.*}     # or go to the window that holds it"
        exit 2 ;;
    esac ;;
  8)
    if [ "$row_count" = 1 ]; then
      step "no live session holds $LANE — this is a resume of a lane whose sessions have all ended"
    else
      step "no live session holds $LANE — the register records no session for it at all, here or on origin/main"
    fi ;;
  *)
    note "the helper's own output is above."
    die "$LANES_EDIT live-holder $LANE failed (exit $lh_rc). That is NOT 'no live session holds $LANE', and this script will not rename the window on an answer it did not get: a rename into a name something still holds is what mints '$LANE (2)'. Fix the helper (or run it by hand: $LANES_EDIT live-holder $LANE), then re-run." 1 ;;
esac

# ------------------------------ 3a. the orphaned holders (Amendment 8(f))
#
# R-A8-6. Step 3 asked whether the lane's CURRENT id is held. This asks who is
# still holding its EARLIER ones — Amendment 6(d)'s orphans, the live-but-idle
# sessions that are the whole reason the `/resume` picker offered this lane two
# transcripts of which neither was the lane.
#
# IT NAMES THEM AND IT NEVER KILLS. The retire act is `kill <pid>`, printed
# here with the session id and the profile beside it so a person can check
# before running it, and run by that person. Clause (f) rules it the operator's
# act — an idle background session is exactly the shape of thing that turns out
# to be somebody's long-running job — and it never blocks or delays the launch:
# a helper too old to know the read simply says nothing.
ih_out=""; ih_rc=0
ih_out="$("$LANES_EDIT" idle-holders "$LANE" 2>/dev/null)" || ih_rc=$?
if [ "$ih_rc" = 0 ] && [ -n "$ih_out" ]; then
  note "lane $LANE: this row's EARLIER session ids are still held by live but idle sessions (Amendment 6(d) orphans). They are history, not alternatives — retire them, and $prog never does it for you:"
  while IFS=$'\t' read -r o_sid o_pid o_kind o_prof; do
    [ -n "$o_sid" ] || continue
    note "  session $o_sid (kind ${o_kind:-none}, profile ${o_prof:-unknown}) — retire it: kill $o_pid"
  done <<<"$ih_out"
fi

# THE RESUME TARGET, from the PUBLISHED cell (R33): the LAST id in it. Read
# here rather than in 5a because step 3b may replace it with an id the cell does
# not carry yet, and 5a's launch decision has to see that.
row_sid=""
[ -n "$session_ids_ordered" ] && row_sid="$(printf '%s\n' "$session_ids_ordered" | tail -n1)"

# ------------------------------------- 3b. the live session in THIS window
#
# A DIFFERENT QUESTION FROM STEP 3's, and Amendment 8 exists for the gap between
# them. Step 3 asks "is any session the ROW names alive"; this asks "what is
# live in THIS WINDOW". The harness mints a new transcript uuid with nobody
# acting — a `/clear` does it (Amendment 6, fact 4), and so did the 2026-09-12
# usage reset that carried this lane's conversation into `4a91f1dc…` while its
# row still ended on `09dd34d1…`. An id in no row is an id `live-holder` cannot
# look up: it answers 8, "this lane is parked", about the conversation sitting
# in the window it was asked about, and this script would then resume the lane's
# PREVIOUS conversation and stamp that uuid on an append-only line.
#
# So the id is taken from the record itself, and step 5 appends it to the
# session cell BEFORE it stamps — which is what makes liveness and the next
# resume follow it. There is no flag for this and there could not be one: the id
# does not exist until the session does. The act is `lane-start --no-launch` run
# IN the window, which is what the SessionStart hook's block asks the new
# session to do, and what this lane did by hand at 2026-09-12T16:59Z.
#
# A FAILED READ IS A WARNING HERE, NOT A REFUSAL, and that is not R22 being
# waived. R22 is for a read whose empty answer PERMITS something: `live-holder`
# fails closed because a rename over a live name costs a lane its address. This
# read only ever ADDS an id to a cell, and it runs after `live-holder` has
# already read the same records and refused if it could not — so a failure here
# means the records went unreadable between two calls a second apart, and the
# honest response is to say so and carry on rather than to refuse a lane its
# start.
# ------------------- AMENDMENT 18(h): ONE LIVE PROCESS PER TRANSCRIPT
#
# *"`lane-start` — every launch branch and `--no-launch`'s window-binding step —
# counts the live records carrying the id it is about to resume or bind, across
# every profile's `sessions/`, and REFUSES when a process other than this
# window's holds it, naming the pid(s), their windows or `bg`, and the retire
# act; it never appends such an id to the row and never launches a second resume
# of it."* Ratified 2026-09-14T13:15:18Z as revision 4 of Amendment 18;
# opensoft/openRepoTools#39.
#
# MEASURED, AND THAT IS WHY IT IS A REFUSAL AND NOT A NOTE. On 2026-09-14 at
# 12:05Z the harness spawned `claude --session-id d1ac715c… --fork-session` under
# a `bg-pty-host`; at 12:07Z the launcher NAMED it as a defect; at 12:10Z a
# `lane-start --no-launch openRepoTools 3` in a new window bound THAT SAME
# transcript as the row's session, seeing nothing; at 12:25Z a second `pclaude`
# resumed it interactively. Three live processes, one transcript file, and the
# retire act could not see any of them BECAUSE the row now recorded the id.
# The count below is the read that was missing, and it is asked of the id this
# run is about to write down or resume — never of the lane.
#
# IT FAILS CLOSED, AND THE THREE CODES ARE THE CONTRACT: 0 with rows, 8 with
# none, 64 a usage error, anything else a read that did not happen. A 2 is a
# `lanes-edit.sh` that predates this read — the un-upgraded workstation — and
# THAT one falls through with a note, exactly as clause (h)'s other reads do,
# because refusing every lane start on every workstation that has not installed
# this yet is not a safety property.
#
# AND THE HARNESS HAS A FENCE OF ITS OWN ON THE SAME FILE, WHICH THIS RUN MUST
# ASK BEFORE IT EXECS RATHER THAN AFTER (measured on Eagle 2026-09-15 against
# `claude` 2.1.270, and reproduced live in a scratch config directory): a
# `claude --resume <id>` whose id is carried by a live session record whose
# `kind` is anything but `interactive` REFUSES AND EXITS 1 before it starts,
# with
#
#   Error: Session <id> is running as a background session. Run `claude agents`
#   to find its id, then `claude attach <id>` to open it, or `claude stop <id>`
#   first to resume it here. Add --fork-session to branch off a copy instead.
#
# — the harness's own `H5`/`zpe` pair, which takes the FIRST live record for the
# id whose `kind !== "interactive"` (a `--bg` job, a `bg-pty-host` child, the
# `bg` COMPANION of Amendment 8 ruling (g)) and stops there. A second live
# INTERACTIVE record does NOT stop it — the same measurement got past that check
# and failed later, on authentication — which is exactly why 18(h) is this
# tooling's to enforce and not the harness's.
#
# THE COST OF ASKING IT LATE IS A FALSE `RESUMED`. The row, the object log and
# the handoff stamp are all written BEFORE the `exec` at the foot of this
# command, so a launch the harness refuses leaves a lane recorded as RESUMED by
# a session that never started, and in a launcher-created window — `pclaude
# --lane <lane> <profile>`, whose pane's only command this is — tmux prints
# `[exited]` over the message and closes it (opensoft/workBenches#77's shape,
# one door along). So the `resume` rule below asks the harness's question in
# front of the launch and prints the harness's own remedy beside this estate's.
dup_check() {   # <session uuid> <what this run was about to do with it> [<rules>]
  # THE RULES, AND THE THIRD ARGUMENT IS WHICH OF THEM APPLY:
  #   bind         (the default) 18(h)'s duplicate count alone — the
  #                window-binding call, which opens no transcript;
  #   resume       both rules — the branch that is about to `--resume` this id
  #                with no record of it in this window;
  #   resume-here  the harness's fence alone — the same branch where the id IS
  #                this window's own live session, whose duplicate count the
  #                window-binding call above has already made.
  local dc_id="${1-}" dc_why="${2-}" dc_rules="${3-bind}" dc_rows="" dc_rc=0 dc_other="" dc_bg="" dc_att=""
  local dc_pid dc_kind dc_tgt dc_prof dc_where dc_verdict dc_file
  [ -n "$dc_id" ] || return 0
  : > "$LS_TMP"
  dc_rows="$("$LANES_EDIT" transcript-holders "$dc_id" 2>"$LS_TMP")" || dc_rc=$?
  case "$dc_rc" in
    0 | 8) : ;;
    2) [ -s "$LS_TMP" ] && cat -- "$LS_TMP" >&2
       note "this \`lanes-edit.sh\` has no \`transcript-holders\` (exit 2), so whether another live process already carries $dc_id is NOT known here. Install the one beside this script (\`openRepoTools --install\`); carrying on."
       return 0 ;;
    *) [ -s "$LS_TMP" ] && cat -- "$LS_TMP" >&2
       die "$LANES_EDIT transcript-holders $dc_id exited $dc_rc, so whether another live process already carries that transcript could NOT be read — and that is not 'no other process does'. A transcript is held by ONE live process (Amendment 18(h)); nothing has been renamed, written or launched." 1 ;;
  esac
  [ "$dc_rc" = 0 ] || return 0
  while IFS=$'\037' read -r dc_pid dc_kind dc_tgt dc_prof dc_where dc_verdict dc_file; do
    [ -n "${dc_pid:-}" ] || continue
    # `unrelated` BLOCKS HERE AND NOWHERE ELSE, and the difference is the
    # question being asked. `transcript_holders` answers "who holds this
    # transcript, and what is this window's relation to them", and its
    # `unrelated` means THIS WINDOW CARRIES NO RECORD OF IT AT ALL — kept
    # silent there so that a rule about a TRANSCRIPT cannot overturn
    # `live_holder`'s verdicts about a LANE, or `forks`, from a read that was
    # asked about neither. THE QUESTION HERE IS 18(h)'s OWN and is narrower:
    # *"the id it is about to resume or bind"*. The ROW-RESUME branch reaches
    # this call only when `row_sid != win_sid`, so this window has no record of
    # that id and EVERY live holder of it comes back `unrelated` — counting
    # only `duplicate` made that branch's check one that could never fire
    # (Copilot round 1 on opensoft/openRepoTools#52). At the window-binding call
    # the id IS this window's own session, so a `here` record exists and nothing
    # is `unrelated`; one rule, two call sites, no second definition of a
    # duplicate.
    #
    # AND IT DOES NOT DECIDE WHETHER THE LANE IS TAKEN. An ORPHAN — a live but
    # idle holder of the row's id — is still reported and never refused as a
    # rival (Amendment 8(f), through `live_holder`'s own verdict, printed above
    # this with 6(d)'s act), and a `bg` companion still holds no lane. What
    # 18(h) adds is about the FILE: this branch's next act is `claude --resume
    # <that id>`, and the clause says *"it never appends such an id to the row
    # and never launches a second resume of it"*. 8(f)'s own sentence does not
    # reach that state either — it rules on *"a row's EARLIER session ids …
    # still held by live but idle sessions"*, and this is the id the row ENDS
    # on, which is the one a resume opens.
    #
    # THE HARNESS'S OWN FENCE FIRST, because it decides whether the `exec` this
    # branch is about to make can start at all, and it reads the record's KIND
    # and not this read's verdict: the `bg` COMPANION of the session live in
    # THIS window is `companion` here — benign, one session seen twice — and it
    # is still a record whose kind is not `interactive`, so `claude --resume`
    # stops on it. A record with no `kind` at all is written down as
    # `interactive` by `transcript_holders` (an older harness wrote nothing
    # else), which is the same reading the harness makes.
    if [ "$dc_rules" != bind ] && [ -n "${dc_kind:-}" ] && [ "$dc_kind" != interactive ]; then
      dc_bg="${dc_bg:+$dc_bg, }pid $dc_pid ($dc_where, kind $dc_kind, profile $dc_prof)"
      if [ -z "$dc_att" ] && [ -n "${dc_tgt:-}" ] && [ "$dc_tgt" != none ]; then
        dc_att="${dc_tgt%.*}"
      fi
    fi
    # AND IT IS NOT A SECOND VERDICT, SO IT DOES NOT `continue` PAST 18(h)'s
    # COUNT: one record can be both — a `bg` duplicate in another profile is a
    # second process on the file AND the thing the harness will stop on — and a
    # refusal that named only the newer of the two reasons would drop the one
    # this suite has asserted since #52. `resume-here` is the exception and
    # states why: the id is this window's own session, whose duplicate count the
    # window-binding call above has already made.
    [ "$dc_rules" = resume-here ] && continue
    case "$dc_verdict" in
      duplicate | unrelated) : ;;
      *) continue ;;
    esac
    dc_other="${dc_other:+$dc_other, }pid $dc_pid ($dc_where, kind $dc_kind, profile $dc_prof)"
    if [ -z "$dc_att" ] && [ -n "${dc_tgt:-}" ] && [ "$dc_tgt" != none ]; then
      dc_att="${dc_tgt%.*}"
    fi
  done <<<"$dc_rows"
  [ -n "$dc_bg" ] || [ -n "$dc_other" ] || return 0
  if [ -n "$dc_other" ]; then
    note "another live process already carries transcript $dc_id: $dc_other"
    note "A transcript is held by ONE live process (Amendment 18(h)): two of them append to one file, each overwriting what the other wrote, and a row that records it has two processes answering for one lane. This run was about to $dc_why, and it has done NOTHING — no window renamed, no id appended, no session launched."
  fi
  if [ -n "$dc_bg" ]; then
    note "a live BACKGROUND session already carries transcript $dc_id: $dc_bg"
    note "\`$CLAUDE_BIN --resume $dc_id\` would REFUSE to start against it — \"Session $dc_id is running as a background session … Add --fork-session to branch off a copy instead\" — and exit 1 before anything ran (measured against claude 2.1.270, and reproduced in a scratch configuration directory). This run was about to $dc_why, and it has done NOTHING: no window renamed, no id appended, no session launched. A lane recorded RESUMED by a launch the harness refuses is a false transition in two append-only files, and in a window a launcher has just made — \`pclaude --lane <lane> <profile>\`, whose pane's only command this is — tmux prints \`[exited]\` over the message and closes it."
    note "open the one that is running rather than a second copy of it: \`claude agents\` names its id, \`claude attach <id>\` opens it, \`claude stop <id>\` ends it."
  fi
  # WHERE THAT PROCESS IS, WHEN ITS RECORD SAYS SO (Amendment 18 Addendum 1's
  # posture: the conversation that is already live is ATTACHED, never started a
  # second time). The line is printed beside the retire act and not instead of
  # it: which of the two this is — the lane running in another window, or a
  # duplicate to retire — is the person's to read, and only one of them is a
  # window to go to.
  [ -n "$dc_att" ] && note "that process is in ${dc_att}: tmux switch-client -t $dc_att   (from outside tmux: tmux attach -t ${dc_att%%:*})"
  die "retire the other one first — \`lane-end\` proves it is this lane's duplicate and prints Amendment 6(d)'s act for it, and it ends, writes and kills nothing:
    lane-end $LANE --retire <pid>" 1
}

win_sid=""; win_target=""; win_name=""; win_pid=""; win_profile=""
: > "$LS_TMP"
win_rec=""; ws_rc=0
win_rec="$("$LANES_EDIT" window-session "$this_window" 2>"$LS_TMP")" || ws_rc=$?
[ -s "$LS_TMP" ] && cat -- "$LS_TMP" >&2
case "$ws_rc" in
  0)
    IFS=$'\037' read -r win_sid win_target win_name win_pid win_profile <<<"$win_rec"
    step "this window's live session is $win_sid (name '${win_name:-none}', pid $win_pid, profile ${win_profile:-unknown})" ;;
  8) step "no live session record names this window ($this_window)" ;;
  *)
    note "$LANES_EDIT window-session $this_window failed (exit $ws_rc) — carrying on without it. This read only ever ADDS the harness's new transcript uuid to the cell, and live-holder has already read the same records; if the cell is behind, stamp it yourself." ;;
esac

# AMENDMENT 18(h), THE WINDOW-BINDING STEP. Asked BEFORE the vetoes and before
# anything is taken: an id a second live process already carries is one this run
# must neither append to a cell nor resume, whatever the vetoes below decide
# about whose it is.
[ -n "$win_sid" ] && dup_check "$win_sid" "bind $win_sid as lane $LANE's session"

# The id the cell does not carry. `$session_ids` is the PUBLISHED set (step 3),
# so an id only this checkout knows is not treated as recorded either.
#
# NOT WHEN STEP 3 ALREADY FOUND ITS HOLDER HERE: a row whose OWN id is live in
# this window is a cell that is current by definition, and there is nothing to
# append. And only a TRANSCRIPT UUID is ever appended — a cell records those and
# only those (Amendment 6(b)), and a record carrying anything else in its
# `sessionId` is not something `--resume` could take.
# ------------------ 3b(i). THE WINDOW-NAME VETO (Amendment 11, `R-A11-12`)
#
# STEP 3b'S FENCE IS TWO VETOES AND NO PERMISSION, and this is the second of
# them. `R-A11-1` was corrected twice before it reached this shape and both
# corrections are worth the reader's time, because each one broke the mechanism
# in the opposite direction:
#
#   * the FIRST fence added "and the row carries no transcript yet", which made
#     step 3b's cell-stamping DEAD in every case it exists for — the `/clear`,
#     the usage reset, the profile switch — and was withdrawn (RV-T1);
#   * the SECOND made the window's own NAME a CONDITION FOR TAKING, and that
#     fails for every session that came up bare in a window still called
#     `claude`, which was 8 of this workstation's 16 windows and this lane three
#     times in one day (CF-T10). Its second disjunct, `live-holder` answering
#     `here`, is unreachable at the site it governs: the branch below requires
#     `holder_here = 0`.
#
# So neither is a permission. The rule is: the live session is taken UNLESS one
# of two vetoes fires.
#
#   VETO 1 — THE REGISTER. A uuid that belongs to ANOTHER ROW is never taken,
#     read through `lanes-edit.sh session-lane <uuid>` and fail-closed: only 0
#     and 8 are answers. That veto is ADOPTION ACT 0'S (`opensoft/brett-wip#5`
#     @`3719d97`), ported into this copy by `openRepoTools#24` (Amendment 9's
#     adoption act 3, MERGED as `d4b5710`), and this branch
#     does not re-implement it. THE SHA IS THE MERGE COMMIT AND NOT THE DRAFT
#     HEAD: act 0 merged 2026-09-13T19:14:37Z, squashed, so `#5`'s pre-merge
#     head `95e7a4c` is NOT an ancestor of `origin/main` and citing it names
#     something that never landed (F-X18).
#
#   VETO 2 — THE WINDOW'S NAME, and it is this PR's second layer. A window NAMED
#     FOR ANOTHER LANE is never taken. It catches what the register veto cannot:
#     a session whose uuid is in NO row at all — the harness mints one on every
#     `/clear` — running in a window that plainly belongs to somebody else. That
#     is Evidence 2(b) exactly: `lane-start openXfactory-5` typed from a window
#     named `openRepoProject-1` took this lane's live uuid as that lane's resume
#     target and planned to stamp it on that lane's row.
#
# A NAME IS A VETO AND NEVER A PERMISSION, which is the whole of `R-A11-12`: a
# window called `claude` vetoes nothing and the taking goes ahead, which is
# exactly the case the first correction was made to preserve.
# AND IT FAILS CLOSED, EXACTLY AS THE REGISTER VETO BESIDE IT DOES (`R-A11-12`;
# clause (d) rule 1, ratified verbatim): *"Both reads fail closed: any answer but
# 0 naming another lane or 8 leaves the cell and the resume target alone, because
# here an empty answer is what PERMITS the take."* Only **8** — no row knows this
# window's name — is permission. Every other code is a read that did not answer
# the question, and this is the one place where not answering it would be read as
# "the session is free": the cost of vetoing is one printed act, and the cost of
# permitting is another lane's uuid on an append-only line.
#
# THE `2` IS NAMED RATHER THAN LEFT TO BE FOUND. `register-row` exits 2 where
# `check_lane_name` refuses the string — a window name carrying a space, a slash
# or a leading `-`, which no lane name may carry (`lanes-edit.sh:1210-1215`). Such
# a window is not provably ANOTHER lane's, but it is not provably free either, and
# the ruling's words admit no third answer: it vetoes, and the note says which
# code came back so the operator can rename the window or pass --dir. A window
# named `claude`, `zsh` or anything else lane-SHAPED that no row knows exits 8 and
# still permits the take, which is what keeps the /clear, the usage reset and the
# profile switch working in the windows this estate actually has.
win_veto=""; win_veto_why=""
# 1 where a read of the window's name in the register decided something here
# (this veto, or the new lane's own-name fence), so the act lists
# `row:<window name>` (feature 007, T428; Y's reads table, Y:5638-5639).
LS_WIN_ROW_READ=0
if [ -n "$win_sid" ] && [ -n "$this_window_name" ] && [ "$this_window_name" != "$LANE" ]; then
  if [ "$(printf '%s' "$this_window_name" | tr 'A-Z' 'a-z')" != "$(printf '%s' "$LANE" | tr 'A-Z' 'a-z')" ]; then
    LS_WIN_ROW_READ=1
    wnv_rc=0
    "$LANES_EDIT" register-row "$this_window_name" >/dev/null 2>&1 || wnv_rc=$?
    case "$wnv_rc" in
      0) win_veto="$this_window_name"
         win_veto_why="which is another lane the register has a row for" ;;
      8) : ;;
      *) win_veto="$this_window_name"
         win_veto_why="and whether that is another lane is NOT KNOWN — \`$LANES_EDIT register-row $this_window_name\` exited $wnv_rc, which is neither 0 (a row) nor 8 (no row), so this read fails closed (R-A11-12)" ;;
    esac
  fi
fi

harness_sid=""; cell_anchor=""
# ------------------- 3b(ii). THE BINDING MODE (`--bind`, openRepoTools#70)
#
# THE GUARD'S CHOICE `2` IS A PERSON SAYING "THIS SESSION IS THAT LANE NOW", and
# clause (h) rule 2 names the act it asks for: *"the row created or this uuid
# appended to its cell"*. Without this mode the take below refused that uuid —
# veto 1, because the row being LEFT still records it — so the row's ordinary
# resume path ran instead and stamped the row, the lane's log and the handoff
# with `RESUMED by <the id the row already had>`, under `--no-launch`, about a
# conversation nobody was in; and the guard then appended the uuid to the cell
# itself. The cell ended right and the append-only log said something else.
#
# SO THE MODE IS STEP 3b's OWN TAKE, WITH VETO 1 ANSWERED BY THE PERSON. Clause
# (h) rule 4's limit is that a uuid never moves between rows WITHOUT the
# person's yes, and `--bind` is that yes, carried by the one caller that asked
# for it. Everything else about the take is unchanged: the cell is extended
# first and the stamp second (Amendment 8), with the PUBLISHED last id as the
# anchor. One rule is added, and it is the guard's own former anchor rule moved
# here: a cell recording no uuid is anchored on either of the two texts such a
# cell carries instead.
#
# AND IT BINDS OR IT REFUSES. Every case where the take cannot happen — no live
# session in this window, a different one from the uuid named, a window named
# for ANOTHER lane (veto 2, which this mode does NOT lift) — is a refusal here,
# before the rename and before any write. Carrying on would reach the resume
# path, and that path stamping an id nobody is in is the defect this mode exists
# to end.
if [ -n "$bind_sid" ]; then
  bind_lc="$(printf '%s' "$bind_sid" | tr 'A-F' 'a-f')"
  [ -n "$win_sid" ] ||
    die "--bind $bind_sid: no live session record names this window ($this_window), so there is no session here to bind. Nothing has been renamed, written or launched." 2
  [ "$(printf '%s' "$win_sid" | tr 'A-F' 'a-f')" = "$bind_lc" ] ||
    die "--bind names $bind_sid, and the session live in this window is $win_sid. The binding mode binds THIS window's session and no other one, so nothing has been renamed, written or launched." 2
  [ -z "$win_veto" ] ||
    die "this window is named '$win_veto', $win_veto_why — so the session live in it ($win_sid) is NOT bound as $LANE's (Amendment 11 clause (d) rule 1, veto 2, which --bind does not lift). Rename the window to $LANE first. Nothing has been renamed, written or launched." 2
  if [ "$bind_lc" = "$row_sid" ]; then
    bind_cell_ends=1
    step "--bind: $win_sid is already the last id in $LANE's session cell — nothing to append"
  else
    harness_sid="$win_sid"
    cell_anchor="$row_sid"
    if [ -z "$cell_anchor" ]; then
      # THE TWO TEXTS A CELL CARRIES INSTEAD OF A UUID: `none recorded`, which a
      # person writes into a row by hand, and the `pending` line this file writes
      # into a row it creates with no uuid to put there (step 5, below). Both are
      # whole-cell texts, so they anchor exactly as an id does, and a cell
      # carrying anything else prints the act and is never guessed at.
      bind_cell="$(cell 3 | sed -e 's/^ *//' -e 's/ *$//')"
      case "$bind_cell" in
        "none recorded" | "pending — set by the session's first act") cell_anchor="$bind_cell" ;;
      esac
    fi
    row_sid="$harness_sid"
    note "--bind: the session live in THIS window is $harness_sid, and it is bound as $LANE's on the person's choice 2 at the name guard (Amendment 12(h) rule 2). Its uuid goes into the session cell before the row's status — even where another row records it, because that choice is the person's yes (clause (h) rule 4) — and every stamp this run writes names it."
  fi
elif [ -n "$win_veto" ]; then
  note "this window is named '$win_veto', $win_veto_why — so the session live in it ($win_sid) is NOT taken as $LANE's, and $LANE's row is not stamped with it (Amendment 11 clause (d) rule 1, veto 2; Evidence 2(b)). Run this from $LANE's own window, or pass --dir and let it start its own session."
elif [ -n "$win_sid" ] && [ "$holder_here" = 0 ]; then
  if ! [[ "$win_sid" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
    note "the session live in this window has id '$win_sid', which is not a transcript uuid — leaving the cell alone"
  elif printf '%s\n' "$session_ids" | grep -qx -F -- "$win_sid"; then
    step "  its uuid is already in the row's session cell — nothing to append"
  else
    # R-A11-1 (corrected; A11 Addendum 2, ratified 2026-09-13T18:05:29Z "Ratify
    # all four") — OWNERSHIP DECIDES, AND A LIVE SESSION THAT BELONGS TO ANOTHER
    # ROW IS NEVER TAKEN. Until this test, the branch above fired on ANY live
    # session in the typing window, so `lane-start X` typed from lane Y's window
    # resumed Y's transcript and appended Y's uuid to X's row — cross-lane
    # contamination, reproduced as Evidence 2(b) on `brettheap/new-workstation#20`
    # (the same run planned to write this lane's uuid into `openXfactory-5`'s row).
    #
    # THE TEST IS THE REGISTER, NOT THE WINDOW'S NAME. The two legitimate cases
    # this step exists for — a `/clear`, a usage reset, a profile switch — all
    # happen in a window the launcher has just made and named `claude`, BEFORE
    # step 4 renames it, and their uuid is one the harness has just minted, so it
    # is in NO row at all. Fencing on the window's name instead would refuse
    # exactly those three and leave step 3b dead, which is the failure `RV-T1`
    # raised against the withdrawn "and the row carries no transcript yet"
    # conjunct. An id that some OTHER lane's row already names is the one thing
    # that is provably not this lane's, and that is the fence.
    #
    # IT FAILS CLOSED (R22). Only 0 (a lane) and 8 (no row names it) are answers;
    # any other code is a read that did not happen — an older `lanes-edit.sh` with
    # no `session-lane` exits 2 — and a read that could not be made must never be
    # read as "the session is free", because an empty answer is what PERMITS the
    # take here. The cost of refusing is one printed act; the cost of permitting
    # is another lane's uuid on an append-only line.
    win_owner=""; wo_rc=0
    win_owner="$("$LANES_EDIT" session-lane "$win_sid" 2>/dev/null)" || wo_rc=$?
    # 007 (T402; Y:5729; spec:688): 69, busy and in doubt refuse the launch;
    # every other failed code keeps the note below.
    case "$wo_rc" in
      69 | 75 | 3) ls_read_refuse "$LANES_EDIT session-lane $win_sid" "$wo_rc" "whose session is live in this window" ;;
    esac
    if [ "$wo_rc" != 0 ] && [ "$wo_rc" != 8 ]; then
      note "$LANES_EDIT session-lane $win_sid failed (exit $wo_rc), so whose session is live in this window is NOT known — leaving $LANE's session cell and resume target alone. A helper with no 'session-lane' exits 2; install the one beside this script."
    elif [ "$wo_rc" = 0 ] && [ -n "$win_owner" ] && [ "$win_owner" != "$LANE" ]; then
      note "the session live in THIS window is $win_sid, and the register says it is lane $win_owner's, not $LANE's. A live session that belongs to another row is NEVER taken (R-A11-1): $LANE's session cell and resume target are left exactly as they are. Start $LANE in its own window, or take $win_owner here."
    else
      harness_sid="$win_sid"
      cell_anchor="$row_sid"
      row_sid="$harness_sid"
      note "the session live in THIS window is $harness_sid and the PUBLISHED session cell does not name it: the harness minted a new transcript (a /clear, a usage reset, a profile switch). No other row names it either, so it is this lane's current session, and the cell is stamped with it before the row's status."
    fi
  fi
elif [ -n "$win_sid" ]; then
  step "  it is the session step 3 already found holding $LANE in this window — the cell is current"
fi

# ------------------------------------------------------------- 3c. --confirm
#
# A window whose name is not the lane is a window whose lane came from somewhere
# else — the swap RECORD, or a flag — and taking it renames the window and
# writes the register. `--confirm` puts the three facts that disagree in front
# of a person first: the WINDOW, the SESSION live in it, and the ROW.
#
# NO TERMINAL AND NO `--yes` IS A REFUSAL, exit 2, before the rename and before
# any write. A question nobody can answer is not a Yes, and a launcher that read
# it as one would rename a window somebody else's lane is working in.
if (( confirm )); then
  if [ "$this_window_name" = "$LANE" ]; then
    step "--confirm: this window is already named $LANE — nothing to confirm"
  else
    # AMENDMENT 15 — A WINDOW NAMED FOR THIS LANE IN ANOTHER CASE IS NOT "not
    # the lane". The rename still happens below, because the row's spelling is
    # what the window is named; what changes is the sentence the operator is
    # asked to answer. Told their own lane's window is not the lane, the
    # reasonable answer is N — and N abandons a resume that was legitimate.
    if [ "$(printf '%s' "$this_window_name" | tr 'A-Z' 'a-z')" = "$(printf '%s' "$LANE" | tr 'A-Z' 'a-z')" ]; then
      why="named '$this_window_name', which is THIS LANE under another case — a lane name is ONE name under any case (Amendment 15), and the rename below is to the register row's own spelling, $LANE"
    else
      case "$this_window_name" in
        ""|claude|bash|zsh|sh|node) why="auto-named '${this_window_name:-none}'" ;;
        *)                          why="named '$this_window_name', which is not the lane" ;;
      esac
    fi
    note "--confirm: this window is $why. The three facts, before anything is renamed or written:"
    note "  window   $this_window '${this_window_name:-none}'"
    if [ -n "$win_sid" ]; then
      note "  session  $win_sid '${win_name:-none}' (pid $win_pid, profile ${win_profile:-unknown})"
    else
      note "  session  none — no live session record names this window"
    fi
    if [ "$row_count" = 1 ]; then
      note "  row      ${row:0:200}"
    elif [ -n "$pub_row" ]; then
      pub_row_first="${pub_row%%$'\n'*}"
      note "  row      ${pub_row_first:0:200}"
    else
      note "  row      none — the register has no row for $LANE"
    fi
    answer=""; no_tty=0
    if (( take_yes )); then
      step "Take lane $LANE in this window? [y/N] y   (--yes)"
      answer=y
    elif [ -n "${LANE_START_ANSWER+set}" ]; then
      step "Take lane $LANE in this window? [y/N] ${LANE_START_ANSWER:-<empty>}   (LANE_START_ANSWER)"
      answer="$LANE_START_ANSWER"
    elif [ -t 0 ]; then
      # A ^C OR A TERM AT THIS PROMPT ENDS THE RUN WITH 130 OR 143, AND THAT
      # IS CHOSEN (RC-W10b n1). The traps at the top (`1c86237`, REV-ACT2 N2)
      # end the run on INT and TERM here as anywhere. A signal is not an
      # answer: R-A8-3 below makes every ANSWER lead somewhere, and `N`, an
      # empty line, an end of input (^D) and no terminal each still start
      # Claude bare, exit 0. ^C is the person stopping this command, as at any
      # prompt in a terminal, and TERM is another process stopping it. Nothing
      # has been renamed or written yet, so nothing is left half done. Before
      # `1c86237` the one trap `cleanup EXIT INT TERM` ran `cleanup` and the
      # `read` went on waiting (RC-W10b; W11-T428, bash 5.2): a ^C did nothing
      # a person could see, and a TERM could not end the run. Keeping that
      # would take a trap of its own around each `read`, and bring back here
      # the defect N2 removed, a `cleanup` that runs while the run goes on.
      printf '%s: Take lane %s in this window? [y/N] ' "$prog" "$LANE" >&2
      IFS= read -r answer || answer=""
    else
      answer=""
      no_tty=1
    fi
    case "$answer" in
      y|Y|yes|YES|Yes) step "taking lane $LANE in this window" ;;
      *)
        # AMENDMENT 8(c)/(d), R-A8-3 — EVERY ANSWER LEADS SOMEWHERE AND NO
        # ANSWER EXITS. `claude-profile` EXECS this script, so this script's
        # exit status IS the launcher's: a refusal here is an exited pane with
        # no Claude in it, which is the one failure the whole change exists to
        # prevent. `N` means NOT THIS LANE, not NOT AT ALL — and no tty with no
        # `--yes` is the same answer with nobody there to give it, which must
        # still not take a lane on an inference nobody confirmed. Both fall
        # through to Claude, bare: nothing renamed, nothing written, no lane,
        # ONE notice, exit 0. Exit 2 is left to argument errors alone.
        if (( no_tty )); then
          bare_why="--confirm was passed, there is no terminal to ask on, and --yes was not, so lane $LANE is NOT taken in a window $why"
        else
          bare_why="lane $LANE is NOT taken: the answer was '${answer:-<empty, which is N>}'"
        fi
        note "$bare_why. Nothing has been renamed and nothing has been written. Starting Claude with no lane — to take it later, run: $prog $self_args"
        lane_claude_resolve_launch
        bare=("$CLAUDE_BIN" ${pass[@]+"${pass[@]}"})
        if (( no_launch )); then
          # The launcher asked for a command to exec; it gets the bare one, on
          # stdout, exactly as it would have got the lane's.
          quoted "${bare[@]}"; printf '\n'
          step "--no-launch: the command above was printed, not run"
          exit 0
        fi
        if (( dry_run )); then
          plan "exec $(quoted "${bare[@]}")"
          step "--dry-run: nothing was renamed, written or launched"
          exit 0
        fi
        # FEATURE 007, T428: the act's base is this run's, not the session's
        # (Y:5596), and LANES_EXPECT is never exported (Y:5581), so both are
        # unset before this launch (lane 3's G5 and shared ruling 5, #165
        # 6770733371), as at section 6's launch below.
        unset LANES_ACT LANES_EXPECT
        step "exec: $(quoted "${bare[@]}")"
        exec "${bare[@]}"
        ;;
    esac
  fi
fi

# Refuse known local conflicts before resolving or updating Claude, and
# before asking a holder to release its binding.
lane_check_local_fences() {
# Step 3 fetched the published register. Before changing a tmux name, prove
# this identity was not retired (including an unpushed local archive row).
retired_rc=0
retired_hits="$(LANES_NO_FETCH=1 "$LANES_EDIT" retired-identity "$LANE" 2>/dev/null)" || retired_rc=$?
case "$retired_rc" in
  8) : ;;
  0) die "lane $LANE is RETIRED (archive: $retired_hits). Nothing was renamed or written; choose a free position." 2 ;;
  *) die "the lane archive could not be checked for $LANE (exit $retired_rc). Nothing was renamed or written." "$(ls_read_code "$retired_rc" 1)" ;;
esac

# AND A RETIRED ROW THAT IS STILL IN THE REGISTER (opensoft/openRepoTools#138
# item 14). The archive holds a retired row only once `archive-rows` has moved
# it there; until then the row says so itself, and `retired-identity` answers 8
# about it. So the row is asked too — this checkout's copy and the published
# one, either of which may be ahead — and so is the lane's own log: a state
# word of RETIRED, or a last lane-kind line that is RETIRED, is a lane that is
# not coming back, and resuming it would append a STARTED or RESUMED after its
# retirement in a log nothing ever rewrites.
#
# RETIRED ONLY, AND NOT ENDED. `lane-end` is "the window is closing" and
# `--retire` is "the lane is not coming back" (docs/README-lanes.md); a binding
# is released by a PAUSED or an ENDED alike (Amendment 18(b)), `lane` sends a
# closed lane back here to be reopened, and an ENDED lane resumed by this
# command is in the real register. Making ENDED terminal is a ruling's to make.
for retired_row in "$row" "$pub_row"; do
  retired_word="$(printf '%s\n' "$retired_row" | awk -F'|' 'NF > 2 {
    split($(NF - 1), w, " "); if (w[1] == "RETIRED") { print w[1]; exit } }')"
  [ -z "$retired_word" ] ||
    die "lane $LANE's register row says RETIRED, though the archive does not hold it yet: a retired lane is not coming back (opensoft/openRepoTools#138 item 14). Nothing was renamed or written; choose a free position." 2
done
retired_last_rc=0
retired_last="$(LANES_NO_FETCH=1 "$LANES_EDIT" lane-last "$LANE" 2>/dev/null)" || retired_last_rc=$?
retired_verb="$(printf '%s\n' "$retired_last" | cut -f1)"
case "$retired_last_rc:$retired_verb" in
  0:RETIRED)
    die "lane $LANE's object log ends on its RETIRED line, though the archive does not hold it yet: a retired lane is not coming back (opensoft/openRepoTools#138 item 14). Nothing was renamed or written; choose a free position." 2 ;;
  0:* | 8:*) : ;;
  *) die "\`$LANES_EDIT lane-last $LANE\` exited $retired_last_rc, so whether lane $LANE's log ends on RETIRED could NOT be read — and that is not 'it does not' (Amendment 7(d)). Nothing was renamed or written." "$(ls_read_code "$retired_last_rc" 1)" ;;
esac

# A lane name is a tmux-window address. tmux itself allows two distinct
# windows to carry one name, so check the whole server before taking it. A
# linked window may appear in several sessions with the same @id; that is one
# window, not a collision.
#
# ASKED OF A NEW LANE ONLY — one with no row — because only there is every
# other window carrying the name certainly FOREIGN: nothing has bound that lane
# yet. An EXISTING lane's own binding is different since Amendment 18 (#83):
# a bench in another container shares this tmux server, its window keeps the
# lane's name until that session hands off, and a second place binding the
# lane after a release, or through `--request-handoff`, is the ratified flow.
# Asked of every lane, this fence refused exactly that takeover.
if [ "$row_count" = 0 ]; then
  window_named_lane ||
    die "tmux could not list window names, so whether $LANE is already in use is unknown. Nothing was renamed or written." 2
  [ -z "$WNL_ID" ] ||
    die "another tmux window ($WNL_ID) is already named $WNL_NAME, and $LANE is a NEW lane, so that window is not its own. Lane window names must be unique in this tmux server; nothing was renamed or written." 2

  # AND THIS WINDOW'S OWN NAME (opensoft/openRepoTools#138 item 16). The scan
  # above skips this window, so a NEW lane started from a stale or reused
  # window still named for ANOTHER registered lane would rename it and take
  # that lane's tmux address. Only a name no row carries is reusable: `claude`,
  # a shell, or a string `check_lane_name` refuses, which no row can carry.
  # Both copies of the register are asked, because a row this checkout has not
  # pushed already owns its window, and a read that fails refuses.
  case "$this_window_name" in
    "" | *[!A-Za-z0-9._-]* | .* | -*) : ;;
    *)
      if [ "$(printf '%s' "$this_window_name" | tr 'A-Z' 'a-z')" != "$(printf '%s' "$LANE" | tr 'A-Z' 'a-z')" ]; then
        LS_WIN_ROW_READ=1   # T428: the act lists row:<window name>
        for own_read in register-row register-row-local; do
          own_rc=0
          LANES_NO_FETCH=1 "$LANES_EDIT" "$own_read" "$this_window_name" >/dev/null 2>&1 || own_rc=$?
          case "$own_rc" in
            8) : ;;
            0) die "this window is named $this_window_name, which is another lane the register has a row for (\`$own_read\`), and $LANE is a NEW lane: renaming the window would take that lane's tmux address (opensoft/openRepoTools#138 item 16). Start $LANE in a window of its own. Nothing was renamed or written." 2 ;;
            *) die "\`$LANES_EDIT $own_read $this_window_name\` exited $own_rc, so whether this window is another lane's could NOT be read — and that is not 'it is not' (Amendment 7(d)). Nothing was renamed or written." 1 ;;
          esac
        done
      fi ;;
  esac
fi
}
# The first window OTHER than this one that this tmux server names $LANE, in
# any case, into WNL_ID and WNL_NAME (both empty where there is none); 1 where
# tmux could not list the windows. The fence above asks it before the rename,
# and step 4 asks it again after.
window_named_lane() {
  WNL_ID=""; WNL_NAME=""
  wnl_tab="$(printf '\t')"
  wnl_rows="$(tmux list-windows -a -F "#{window_id}${wnl_tab}#{window_name}" 2>/dev/null)" || return 1
  while IFS="$wnl_tab" read -r wnl_id wnl_name; do
    [ -n "$wnl_id" ] || continue
    if [ "$wnl_id" != "$this_window_id" ] &&
       [ "$(printf '%s' "$wnl_name" | tr 'A-Z' 'a-z')" = "$(printf '%s' "$LANE" | tr 'A-Z' 'a-z')" ]; then
      WNL_ID="$wnl_id"; WNL_NAME="$wnl_name"
      return 0
    fi
  done <<EOF
$wnl_rows
EOF
  return 0
}
lane_check_local_fences

# ------------- 3b(ii). AMENDMENT 18(b): ONE BINDING PER LANE, AND THIS PLACE
#
# *"A bound lane is started nowhere else — not a second window on the same host,
# not another container, not another host — until its binding is released by a
# `PAUSED` (its own, or one written under (e)) or ended. Liveness is pronounced
# only from INSIDE the binding's own `host` and `container`, where the pid
# namespace is the record's: from anywhere else a binding is UNKNOWN, never
# dead, whatever `kill -0` says."* Ratified 2026-09-14T13:15:18Z as revision 4;
# opensoft/openRepoTools#38.
#
# THIS IS A SECOND FENCE AND NOT A REPLACEMENT FOR STEP 3. Step 3 asks whether a
# session the ROW names is alive and answers out of THIS workstation's session
# records — which is exactly the read that cannot cross a container seam, and
# exactly why it said NOT LIVE about a lane cloudBench was writing. So where the
# binding IS this host's and this container's, step 3 has already pronounced and
# nothing changes; where it is NOT, this fence refuses whatever `kill -0` said,
# because the record it read is from another pid namespace.
#
# THE ONE EXCEPTION IS THE WINDOW, and the helper has already applied it: on one
# host the launcher mounts ONE tmux socket into every container it starts, so a
# binding whose `@id` no longer resolves there — matched by Amendment 11(h)'s
# agreement rule, the id TOGETHER with its session — is DEAD, and Amendment
# 6(d)'s retire act and opensoft/openRepoTools#30's takeover path apply as they
# stand. That is the `gone` the read answers with, and it is answered only where
# the HOST matches, because a window id from another machine resolving here
# would be a coincidence.
#
# A HELPER PREDATING THIS READ FALLS THROUGH WITH A NOTE, exactly as clause
# (h)'s other reads do: refusing every lane start on every workstation that has
# not taken the install yet is not a safety property. Every OTHER code is a read
# that did not happen, and this one fails CLOSED — a binding that could not be
# read is not a lane that is free, and the cost of guessing here is two sessions
# writing one append-only log.
bind_out=""; bind_rc=0; bind_recheck=0; ls_rh_wrote=""
: > "$LS_TMP"
bind_out="$("$LANES_EDIT" binding "$LANE" 2>"$LS_TMP")" || bind_rc=$?
case "$bind_rc" in
  0) [ -s "$LS_TMP" ] && cat -- "$LS_TMP" >&2 ;;
  8) [ -s "$LS_TMP" ] && cat -- "$LS_TMP" >&2
     step "no binding: lane $LANE's last lane-kind line released it, or it has none (Amendment 18(b)) — nothing to ask" ;;
  2) [ -s "$LS_TMP" ] && cat -- "$LS_TMP" >&2
     note "this \`lanes-edit.sh\` has no \`binding\` (exit 2), so whether lane $LANE is bound somewhere else is NOT known here. Install the one beside this script (\`openRepoTools --install\`); carrying on with step 3's liveness read alone, which cannot see another container." ;;
  *) [ -s "$LS_TMP" ] && cat -- "$LS_TMP" >&2
     die "$LANES_EDIT binding $LANE exited $bind_rc, so where this lane is bound could NOT be read — and that is not 'it is bound nowhere'. A lane has ONE binding (Amendment 18(b)); nothing has been renamed, written or launched." "$(ls_read_code "$bind_rc" 1)" ;;
esac
if [ "$bind_rc" = 0 ]; then
  IFS=$'\t' read -r b_host b_cont b_win b_utc b_sess b_os b_where b_wstate <<<"$bind_out"
  if [ "$b_where" = here ]; then
    step "binding: this host ($b_host) and container ($b_cont), window $b_win since $b_utc — liveness here is this place's to pronounce, and step 3 has (Amendment 18(b))"
  elif [ "$b_wstate" = gone ]; then
    note "lane $LANE's binding is window $b_win in container $b_cont on host $b_host (since $b_utc), and that window is GONE from this tmux server — the pane a session must live in does not exist. That is the ONE case in which a binding elsewhere reads DEAD (Amendment 18(b)), because one host's launcher mounts one tmux socket into every container it starts. Carrying on: this is Amendment 6(d)'s retire act and openRepoTools#30's takeover path, unchanged."
  else
    # ---- CLAUSE (c): THE SECOND PLACE ASKS, AND NEVER TAKES.
    ls_bind_facts="lane $LANE is bound to window ${b_win:-none} in container ${b_cont:-none} on host ${b_host:-unknown} (session ${b_sess:-unknown}, last line ${b_utc:-unknown}); this tmux server says that window is ${b_wstate:-unknown}"
    ls_ask=0
    if [ -n "$force_why" ]; then
      ls_ask=force
    elif (( request_handoff )); then
      ls_ask=yes
    elif [ -n "${LANE_START_HANDOFF_ANSWER+set}" ]; then
      step "$ls_bind_facts"
      step "ask it to hand off, then bind here? [y/N] ${LANE_START_HANDOFF_ANSWER:-<empty>}   (LANE_START_HANDOFF_ANSWER)"
      case "$LANE_START_HANDOFF_ANSWER" in y|Y|yes|YES|Yes) ls_ask=yes ;; *) ls_ask=no ;; esac
    elif [ -t 0 ]; then
      note "$ls_bind_facts"
      # A ^C or a TERM here ends the run with 130 or 143, before the request
      # is sent and with nothing renamed or written, as at `--confirm`'s
      # prompt above, and for its reasons (RC-W10b n1). `N` ends it too,
      # with 2 and the two commands below.
      printf '%s: ask it to hand off, then bind here? [y/N] ' "$prog" >&2
      IFS= read -r ls_answer || ls_answer=""
      case "$ls_answer" in y|Y|yes|YES|Yes) ls_ask=yes ;; *) ls_ask=no ;; esac
    else
      ls_ask=no-terminal
    fi
    if [ "$ls_ask" = no ] || [ "$ls_ask" = no-terminal ]; then
      ls_flag="Ask it to hand off — the request is written to the lane's log, pushed, and typed into that pane where it is on this tmux server:
      $prog --request-handoff $self_args"
      [ "$ls_ask" = no-terminal ] || ls_flag="Ask it to hand off:
      $prog --request-handoff $self_args"
      ls_why="a lane has ONE binding, and this is not it (Amendment 18(b))"
      [ "$ls_ask" = no-terminal ] && ls_why="$ls_why. There is no terminal on stdin to ask on — an agent's stdin is not one — so the flag is the answer"
      die "$ls_bind_facts.
    $ls_why. Nothing has been renamed, written or launched. Liveness is
    pronounced only from inside that binding's own host and container, so from
    here it is UNKNOWN and never dead, whatever a \`kill -0\` of a pid in
    another namespace would say.
      $ls_flag
      or take it anyway, which is a SECOND invocation and never automatic, and
      which makes that place STOP loudly rather than silently:
      $prog --force \"<why you are taking it>\" $self_args" 2
    fi
    # Approval precedes any possible update; resolution precedes release.
    # With no explicit agent the holder's new PAUSED may name Claude, so
    # preflight that possible launch before asking it to give up the binding.
    # An explicit other agent never needs a Claude preflight.
    if [ -z "$agent_flag" ] || [ "$agent_flag" = claude ]; then
      lane_claude_resolve_launch
    fi
    ls_rh=("$LANES_EDIT" request-handoff "$LANE")
    [ -z "$win_sid" ] || ls_rh+=(--session "$win_sid")
    if [ "$ls_ask" = force ]; then
      ls_rh+=(--force "$force_why")
    else
      ls_rh+=(--wait "$handoff_wait")
    fi
    (( dry_run )) && ls_rh+=(--dry-run)
    step "$(quoted "${ls_rh[@]}")"
    ls_rh_rc=0
    # ITS LANE, NAMED (Amendment 23 S2): `request-handoff` writes the lane's
    # record, so the lane its write belongs to is said rather than derived.
    # AND ITS EXPECTATION, W8's `bind:<lane>` (feature 007, T428; Y:5651;
    # FR-029), a prefix on this one call under the act's LANES_ACT: on primary
    # a binding line another place wrote after this act's base refuses it 2.
    ls_rh_expect="bind:$(printf '%s' "$LANE" | tr 'A-Z' 'a-z')"
    LANES_LANE="$LANE" LANES_EXPECT="$ls_rh_expect" "${ls_rh[@]}" || ls_rh_rc=$?
    case "$ls_rh_rc" in
      # 007 (T402): an answer of 0 is a line `request-handoff` WROTE to the
      # lane's append-only log (not under --dry-run, which writes none): the
      # forced PAUSED under --force, the HANDOFF-REQUESTED line otherwise. A
      # refusal after the rename names it (lane 3's ruling 6747281902, T402
      # item 5); it stands whole (R-A11-11).
      0) bind_recheck=1; step "lane $LANE is free — binding it here (Amendment 18(c))"
         if (( ! dry_run )); then
           if [ "$ls_ask" = force ]; then
             ls_rh_wrote="the forced PAUSED that \`request-handoff --force\` wrote to lane ${LANE}'s log above"
           else
             ls_rh_wrote="the HANDOFF-REQUESTED line that \`request-handoff\` wrote to lane ${LANE}'s log above"
           fi
         fi ;;
      8) bind_recheck=1; step "lane $LANE was already free by the time the request was made — binding it here" ;;
      2) ls_q4 2 &&
           die "\`$LANES_EDIT request-handoff $LANE\` exited 2 under this launch's base (its words are above: the holder kept the lane, or lane ${LANE}'s binding changed after this launch's base), so the handoff was not obtained, and NOTHING here has been renamed, written or launched. ${LS_Q4}." 2
         die "the handoff was not obtained (the helper's own facts and its \`--force\` line are above), so lane $LANE is still bound elsewhere and NOTHING here has been renamed, written or launched." 2 ;;
      # A WRITE'S ARM (Y:5731), AND IT PASSES THE CODE NOW (feature 007, T428;
      # lane 3's ruling 6747281902, T402 item 2; ERR-33): 69 and the busy 75
      # say nothing was sent; the in-doubt 3 says the request may be in the
      # lane's log or may not, and the writer's own words above carry its
      # printed rerun, in T433's text (G3). Every other code
      # keeps 1, as the read arms keep theirs (ERR-36).
      69 | 75)
        ls_rh_why="the register is busy"
        [ "$ls_rh_rc" = 75 ] || ls_rh_why="the register could not be read, or refused the write"
        die "$LANES_EDIT request-handoff $LANE exited ${ls_rh_rc}: ${ls_rh_why}, so the handoff was NOT asked for, and nothing here has been renamed, written or launched. Its words are above; ask again once it answers." "$ls_rh_rc" ;;
      3) die "$LANES_EDIT request-handoff $LANE exited 3: the request is IN DOUBT. Its HANDOFF-REQUESTED line, or under --force its PAUSED on the holder's behalf, ${LS_D8}. Nothing here has been renamed or launched, and no row, STARTED or RESUMED line or stamp was written." 3 ;;
      *) die "$LANES_EDIT request-handoff $LANE exited $ls_rh_rc, which is neither 'the lane is free' nor the refusal that says it is not — nothing here has been renamed, written or launched." 1 ;;
    esac
  fi
fi

# ------------- 3b(iii). A RERUN OF THE BINDING MODE WRITES NO REGISTER LINE AGAIN
#
# FEATURE 007, T503 (FR-039; design.md, "Reruns", phase 1). The name guard's
# choice `2` can be answered for the same session twice: the first bind's stamp
# push failed and the person is offered the bind again, or the window was moved
# away and back. Every write this run makes then lands a second time in files
# that are append-only — the row's state cell, the lane's log line, and the
# handoff's Rule 3 stamp, which counts resumes.
#
# THE RULE IS TWO READS AGREEING, BOTH ALREADY MADE ABOVE, AND NOTHING NEW IS
# ASKED OF THE REGISTER. The published session cell ENDS on the bound uuid
# (`bind_cell_ends`, step 3b(ii)), and the lane's binding — its last lane-kind
# line, `lanes-edit.sh binding` — names THIS window, here, with that uuid as its
# session: the lane is already bound to this session in this window, and the
# earlier bind's log line is the proof that its other writes landed. Then the
# row's state, the log line and the cell's append are not written again (the
# append is the "nothing to append" of step 3b(ii)), and the stamp is written
# only where the handoff carries no `RESUMED by <uuid> (lane <L>)` line (step
# 5c). A binding that names another window or another session, or a cell that
# ends on another id, is not a rerun, and every write is made as before.
#
# THE WINDOW IS COMPARED BY ITS TMUX ID, as `binding_is_this_window` compares it
# in `lanes-edit.sh`: the record's `<session>:<index> <@id>` and `<@id>` is the
# part that stays when windows are re-indexed. A record with no id is matched on
# its whole `<session>:<index>` spelling instead, and an empty or `none` window
# matches nothing.
if [ -n "$bind_sid" ] && [ "$bind_cell_ends" = 1 ] && [ "$bind_rc" = 0 ] && [ "${b_where-}" = here ]; then
  br_same=0
  br_win_id="${b_win##* }"
  case "$br_win_id" in
    @[0-9]*)
      if [ "$br_win_id" = "$this_window_id" ]; then br_same=1; fi ;;
    *)
      if [ -n "${b_win-}" ] && [ "$b_win" = "$record_window" ]; then br_same=1; fi ;;
  esac
  if [ "$br_same" = 1 ] && [ "$(printf '%s' "${b_sess-}" | tr 'A-F' 'a-f')" = "$bind_lc" ]; then
    bind_rerun=1
    step "--bind: a RERUN — lane $LANE's binding already names this window ($b_win) and $win_sid, and its session cell ends on that id, so the row's state, the lane's log line and the cell are not written again, and the handoff is stamped only if it carries no RESUMED by $win_sid (lane $LANE) line"
  fi
fi

# The successful handoff may have published a different agent in its PAUSED
# record. Read that authoritative answer now, before rename or transcript movement.
AGENT=""; AGENT_EXPLICIT=0; AGENT_ID=""; RECORDED_AGENT=""; RECORDED_AGENT_READ=0
read_recorded_agent() {
  rra_out=""; rra_rc=0
  rra_out="$("$LANES_EDIT" lane-agent "$LANE" 2>/dev/null)" || rra_rc=$?
  RECORDED_AGENT_READ=1
  case "$rra_rc" in
    0) RECORDED_AGENT="$rra_out" ;;
    8|2) RECORDED_AGENT="" ;;
    # A READ THAT FAILED IS NOT "THIS LANE'S RECORD NAMES NO AGENT", and the
    # helper says so in its own refusal: *"a caller that read it that way would
    # launch the default agent over a lane another one paused"* (Amendment
    # 7(d), `lanes-edit.sh`'s `lane-agent` arm). This used to `note` and launch
    # `claude` anyway — the one act in this whole command that no later refusal
    # can undo — so it refuses, and names the flag that goes past it, which is
    # a person naming the agent rather than this command guessing at one.
    *) die "\`$LANES_EDIT lane-agent $LANE\` failed (exit $rra_rc), so which agent paused this lane is UNKNOWN — and launching the default over a lane another agent paused is what Amendment 7(d) has this read refuse rather than answer. Run it by hand to see what it says, or name the agent: $prog --agent <name> …" "$(ls_read_code "$rra_rc" 2)" ;;
  esac
  return 0
}
if [ -n "$bind_sid" ]; then
  # THE BINDING MODE BINDS THE CLAUDE SESSION THE GUARD IS RUNNING IN
  # (openRepoTools#70), whichever agent last paused this lane: the launcher
  # table below would otherwise stamp `<agent> pending` for a session that is
  # plainly here and plainly Claude.
  AGENT=claude
elif [ -n "$agent_flag" ]; then
  AGENT="$agent_flag"; AGENT_EXPLICIT=1
else
  read_recorded_agent
  if [ -n "$RECORDED_AGENT" ]; then AGENT="$RECORDED_AGENT"; fi
  [ -n "$AGENT" ] || AGENT=claude
  [ "$AGENT" = claude ] || AGENT_EXPLICIT=1
fi
case "$AGENT" in
  *[!A-Za-z0-9._-]*|'') die "--agent takes a manifest key — letters, digits, '.', '_', '-' — and '$AGENT' is not one (Amendment 17(b))" 2 ;;
esac
# THE AGENT THIS LANE IS RUNNING, IN THE ENVIRONMENT OF THE SESSION IT STARTS
# (Copilot round 2 on openRepoTools#47). `lane-handoff` derives the record's
# `agent` sub-field from `$LANES_AGENT`, else `claude` — so a `codex` session
# launched here would write `agent claude` at its own handoff and the next
# `lane-start` would resume it with the wrong launcher, one record along. The
# launch decides which agent this is; the launch is therefore what says so.
export LANES_AGENT="$AGENT"
if [ "$AGENT" = claude ]; then
  lane_claude_resolve_launch
fi

# ------------------------------------------------------- 4. name the window

# Resolver work can take time. Preserve the final read too, so a retirement
# or new window collision during that wait still refuses before rename.
lane_check_local_fences

# ---------------- 3d. AND THE BINDING IS READ AGAIN BEFORE THE FIRST ACT
#
# A HANDOFF THAT LANDED IS AN OBSERVATION AND NOT A RESERVATION (Copilot round 1
# on opensoft/openRepoTools#83). `request-handoff` returns 0 when it SEES the
# release; between that and the rename, the row status, the log line and the
# launch, another place waiting on the same release can bind the lane — and
# `commit_push` rebases both append-only writes rather than refusing the second,
# so the log would carry two bindings and no reader could say which is the
# lane's.
#
# NOTHING IN THE RATIFIED TEXT GIVES A LANE A RESERVATION, and inventing one
# here would be an unratified act on an in-force protocol — it is filed rather
# than smuggled in (opensoft/openRepoTools#84). What IS available is to make the
# read the LAST thing before the first act instead of the first thing in the
# run: the window between them is then one read wide rather than a question, a
# rename, two register writes and a launch wide, and a lane that moved in it is
# a refusal naming where it went rather than a second binding written over it.
#
# A RESOLVER MAY WAIT TOO: another start can bind while this one waits for
# the update lock or npm. Recheck after resolution, immediately before rename,
# including an initially free binding. An unchanged existing binding remains
# valid; an observed release or replacement is not this invocation's binding.
# AND A DRY RUN HAS NOTHING TO RE-READ, BECAUSE IT DID NOTHING (Copilot round 3
# on opensoft/openRepoTools#83). `request-handoff --dry-run` prints its plan and
# answers 0 WITHOUT releasing anything, so an unconditional re-read here sees the
# binding still standing and refuses — and `lane-start --dry-run
# --request-handoff`, whose whole job is to print the plan, could never print
# one. A plan is a statement about what WOULD happen; the fence that protects
# the first act belongs to the run that takes it.
bind_waited="$bind_recheck"
bind_expected_rc="$bind_rc"; bind_expected_out="$bind_out"
if [ "$bind_recheck" = 1 ]; then
  bind_expected_rc=8; bind_expected_out=""
fi
[ "$lane_claude_checked" = 0 ] || bind_recheck=1
if [ "$bind_recheck" = 1 ] && (( dry_run )); then
  plan "read the binding again before the rename, and refuse if the lane moved while this run was taking it"
  [ "$bind_waited" = 1 ] &&
    plan "$LANES_EDIT act-begin --rebase, then read lane ${LANE}'s row again (register-row), and refuse if it changed outside its state cell while the handoff was waited for (feature 007, T428)"
  bind_recheck=0
fi
# FEATURE 007, T428 - THE ACT IS RE-BASED PAST THE HANDOFF WAIT (D5's first
# condition, Y:5656; FR-029). After a `request-handoff` that answered 0 or 8
# the holder's own PAUSED writes, made while this run waited (300 s by
# default), are past this act's base, so the act's first write would be
# refused for them. `act-begin --rebase` keeps the act's id and takes a new
# base from the register as it is now, BEFORE the reads this act keeps are
# read again (Y:5591-5592): the binding, below, and the row this run decided
# on. The row is then compared with what was read before the wait, its state
# cell aside, which is the one cell the holder's handoff writes; any other
# change refuses with 2, because nothing re-reads it after the new base and a
# write made on it would be one that base never checked. Not on the Claude
# resolution's wait alone: that wait has no handoff in it.
ls_rb_done="Nothing has been renamed or launched, and this run has written no row, no STARTED or RESUMED line and no stamp."
[ -z "$ls_rh_wrote" ] ||
  ls_rb_done="${ls_rb_done} One line of the handoff stands: ${ls_rh_wrote}, written whole to the append-only log (R-A11-11)."
if [ "$bind_recheck" = 1 ] && [ "$bind_waited" = 1 ]; then
  : > "$LS_TMP"
  ls_reb=""; ls_reb_rc=0
  ls_reb="$("$LANES_EDIT" act-begin --rebase 2>"$LS_TMP")" || ls_reb_rc=$?
  [ -s "$LS_TMP" ] && cat -- "$LS_TMP" >&2
  # `act-begin`'s arms, as A2 reads them (#165 6774499606): 69, 75 and 3
  # pass the code; any other code, and an exit 0 with no line or a
  # malformed one, refuses with 1, naming the verb and its code.
  if [ "$ls_reb_rc" != 0 ] || ! ls_act_form "$ls_reb"; then
    case "$ls_reb_rc" in
      69 | 75 | 3) ls_read_refuse "$LANES_EDIT act-begin --rebase" "$ls_reb_rc" "this launch's base after the handoff wait" "$ls_rb_done" ;;
      0) die "\`$LANES_EDIT act-begin --rebase\` exited 0 and printed no single line of base, \`<act-id>@files\` or \`<act-id>@<seq>:<generation>\` (Y:5577-5578), so this launch has none after the handoff wait. $ls_rb_done" 1 ;;
      *) die "\`$LANES_EDIT act-begin --rebase\` exited $ls_reb_rc (its words are above), so this launch's base could not be moved past the handoff wait, and its writes would be checked against a base the holder's own handoff has passed. $ls_rb_done" 1 ;;
    esac
  fi
  export LANES_ACT="$ls_reb"
  step "act re-based past the handoff wait: $LANES_ACT"
fi
if [ "$bind_recheck" = 1 ]; then
  : > "$LS_TMP"
  bind_again=""; bind_again_rc=0
  bind_again="$("$LANES_EDIT" binding "$LANE" 2>"$LS_TMP")" || bind_again_rc=$?
  [ -s "$LS_TMP" ] && cat -- "$LS_TMP" >&2
  case "$bind_again_rc" in
    8) [ "$bind_expected_rc" = 8 ] ||
         die "lane $LANE's binding changed while Claude was resolved: it is now released. Nothing here was renamed or bound; retry against the current record." 2
       if [ "$bind_waited" = 1 ]; then
         step "binding: still free after the handoff — taking it"
       else
         step "binding: still free after Claude resolution — taking it"
       fi ;;
    0)
      if [ "$bind_expected_rc" = 0 ] && [ "$bind_again" = "$bind_expected_out" ]; then
        step "binding: unchanged after Claude resolution"
      else
        IFS=$'\t' read -r ba_host ba_cont ba_win ba_utc ba_sess ba_os ba_where ba_wstate <<<"$bind_again"
        # A NEW OR CHANGED BINDING IS THE RACE, INCLUDING ONE IN THIS WINDOW.
        # This invocation wrote no STARTED/RESUMED yet. An unchanged prior
        # binding was accepted above; this one appeared during the wait.
        die "lane $LANE was BOUND AGAIN or changed while this run was taking it: it is now window ${ba_win:-none} in container ${ba_cont:-none} on host ${ba_host:-unknown} (session ${ba_sess:-unknown}, ${ba_utc:-unknown}). This run observed a free or earlier binding before its wait, and another binding now stands before its first act. This run has written no binding of its own yet, so that one is not this invocation's: a binding at THIS window is a second invocation IN it, which is the same race one pane closer. Nothing has been renamed, written or launched. Ask again, or take it up with that place:
      $prog --request-handoff $self_args" 2
      fi ;;
    2) [ "$bind_expected_rc" = 2 ] ||
         die "the binding could not be rechecked after Claude resolution (exit 2). Nothing here was renamed or bound." 1
       note "this \`lanes-edit.sh\` has no \`binding\`, so whether the lane moved again while this run waited is not known here; carrying on." ;;
    *) die "$LANES_EDIT binding $LANE exited $bind_again_rc on the re-read before the rename, so whether this lane is still free could NOT be established — and that is not 'it is'. Nothing has been renamed, written or launched." "$(ls_read_code "$bind_again_rc" 1)" ;;
  esac
fi
# THE ROW, READ AGAIN AFTER THE NEW BASE (T428; Y:5656). Field 8 is the state
# cell by position, as field 7 is the handoff path (5c says why a row's place
# is counted from the front); it is blanked on both copies before they are
# compared. 0 and 8 are answers; any other code refuses, passing 69, 75 and 3.
ls_row_but_state() {   # <register-row's answer>
  printf '%s\n' "$1" | awk -F'|' 'BEGIN { OFS = "|" } NF >= 9 { $8 = "" } { print }'
}
if [ "$bind_recheck" = 1 ] && [ "$bind_waited" = 1 ]; then
  ls_rr=""; ls_rr_rc=0
  ls_rr="$("$LANES_EDIT" register-row "$LANE" 2>/dev/null)" || ls_rr_rc=$?
  case "$ls_rr_rc" in
    0 | 8) [ "$ls_rr_rc" = 0 ] || ls_rr="" ;;
    69 | 75 | 3) ls_read_refuse "$LANES_EDIT register-row $LANE" "$ls_rr_rc" "lane ${LANE}'s row after the handoff wait" "$ls_rb_done" ;;
    *) die "\`$LANES_EDIT register-row $LANE\` exited $ls_rr_rc on the re-read after the handoff wait, so whether lane ${LANE}'s row changed while this run waited could NOT be read, and that is not 'it did not'. $ls_rb_done" "$(ls_read_code "$ls_rr_rc" 1)" ;;
  esac
  ls_rr_was="$pub_row"; [ "$pub_rc" = 0 ] || ls_rr_was=""
  if [ "$(ls_row_but_state "$ls_rr")" != "$(ls_row_but_state "$ls_rr_was")" ]; then
    ls_rr_now="${ls_rr%%$'\n'*}"; ls_rr_then="${ls_rr_was%%$'\n'*}"
    die "lane ${LANE}'s row changed outside its state cell while this run waited for the handoff: it read
      ${ls_rr_then:-no row}
    before the wait, and it reads
      ${ls_rr_now:-no row}
    now. Everything this run decided from the row was decided on the first, so it takes nothing on the second (feature 007, T428; D5's first condition). $ls_rb_done Re-run to decide again on the row as it is." 2
  fi
  step "lane ${LANE}'s row: unchanged after the handoff wait but for its state cell"
fi

if (( dry_run )); then
  plan "tmux rename-window $LANE   (also turns automatic-rename off for this window)"
else
  # Read for every rename now, not a new lane's alone: 007's refusals after
  # this rename give it back as #138 item 3's does (T402; T428's ERR-56).
  win_auto_was="$(tmux show-options -w -v automatic-rename 2>/dev/null || :)"
  tmux rename-window "$LANE"
  step "window renamed to $LANE (automatic-rename is now off for it)"
fi

# AND A NEW LANE'S NAME IS READ BACK (opensoft/openRepoTools#138 item 3). The
# fence's scan and the rename above are two tmux commands with nothing reserving
# the name between them, so two NEW-lane starts in two windows could both find
# it free and both take it — and the register's lock, which comes after, cannot
# undo a rename. Nothing here invents a reservation (#84: that is a ruling's to
# make); the rename is checked instead. tmux runs one command at a time, so of
# two starts that each rename and then list, the later list always sees the
# earlier rename: at most one keeps the name, and both refusing is the
# fail-closed answer. A list that fails is not a name that is free. A refusal
# gives THIS window back its name and its automatic-rename, so nothing of this
# run is left behind it.
# THE GIVING BACK IS ONE FUNCTION, shared with 007's refusals after the rename
# (T402; lane 3's ruling 6747281902, T402 item 5; T428's ERR-56 re-read of the
# base). It sets `rb_undo`.
ls_window_name_back() {
  # NO NAME TO GO BACK TO IS NO UNDO: where tmux answered `#W` with nothing,
  # nothing here can name this window back, and the refusal says so rather
  # than claiming an undo it did not make.
  rb_undo="This window's rename could NOT be undone, because its earlier name is not known — rename it yourself: tmux rename-window <its name>"
  if [ -n "$this_window_name" ]; then
    if tmux rename-window "$this_window_name" 2>/dev/null; then
      rb_undo="This window's rename is undone"
    else
      rb_undo="This window's rename could NOT be undone — rename it back yourself: tmux rename-window $this_window_name"
    fi
  fi
  case "$win_auto_was" in
    "") tmux set-option -w -u automatic-rename 2>/dev/null || : ;;
    on) tmux set-option -w automatic-rename on 2>/dev/null || : ;;
  esac
  return 0
}
if (( ! dry_run )) && [ "$row_count" = 0 ]; then
  rb_why=""
  if ! window_named_lane; then
    rb_why="tmux could not list the windows after the rename, so whether another window took $LANE as well is unknown"
  elif [ -n "$WNL_ID" ]; then
    rb_why="after the rename another tmux window ($WNL_ID) is named $WNL_NAME too: a second start took this NEW lane's name between this run's check and its rename"
  fi
  if [ -n "$rb_why" ]; then
    ls_window_name_back
    die "$rb_why (opensoft/openRepoTools#138 item 3). $rb_undo, and nothing has been written or launched. Lane window names are unique in a tmux server; settle which window is $LANE and re-run there." 2
  fi
fi

# ------------------------------------------------- 5a. what will be launched
#
# Decided BEFORE the row is written: a brand-new session's id is minted here
# and step 5 has to record it.

# Claude keeps one transcript directory per working directory, named by that
# path with every non-alphanumeric character turned into '-'. A lane reached
# through a symlink has two spellings, so both are searched.
sanitize() { printf '%s' "$1" | tr -c 'A-Za-z0-9' '-'; }

transcript_dirs() {
  printf '%s\n' "$PROJECTS_STATE/$(sanitize "$DIR")"
  [ "$DIR_REAL" = "$DIR" ] || printf '%s\n' "$PROJECTS_STATE/$(sanitize "$DIR_REAL")"
}

# ===================== AMENDMENT 17, adoption act 6: THE TRANSCRIPT FOLLOWS
# ===================== THE LANE
#
# `transcript_dirs` above looks under THIS PROFILE's projects directory and
# nowhere else, so a lane restarted under a NEW PROFILE after a usage limit
# never resumed its conversation: it fell to the title fallback or to a new
# session primed by a handoff the stuck session never refreshed.
#
# MEASURED FIRST, AND THE FACT SHRANK THE ACT (opensoft/openRepoTools#36, the
# correction of 2026-09-14T12:35Z): on a launcher-configured workstation EVERY
# profile's `projects/` is ONE shared directory —
# `readlink -f ~/.claude-profiles/profiles/<org>/<team>/<any>/projects` →
# `~/.claude-profiles/state/opensoft/projects` — so a transcript needs NO MOVE
# to be resumed under another profile, and the whole act there is to SAY SO.
# The move is for the workstation without that layout, where the two
# directories are really two.
#
# WHY A MOVE AND NEVER A COPY: two live transcripts of one uuid diverge, and
# nothing merges them. The pointer left behind says where it went.
# THE PROFILE STORE'S ROOT IS THE DOCUMENTED ONE, NEVER `~/.claude-profiles`
# SPELLED AGAIN (Copilot round 1 on openRepoTools#47). `$CLAUDE_PROFILES_HOME`
# is in this repository's README table and is what `lanes-edit.sh`'s own profile
# walk reads (`lanes-edit.sh:4381`); a second spelling here is a second answer
# to "where are this person's profiles", and on a workstation that moved the
# store it is the WRONG one — every scan below would find nothing, and a lane
# resumed under another profile would start a new conversation beside a
# transcript that was there all along.
PROFILES_HOME="${CLAUDE_PROFILES_HOME:-$HOME/.claude-profiles}"

profile_projects_dirs() {
  # This profile's own first, then every other profile's. Team profiles sit two
  # levels down, which is the same shape `lanes-edit.sh`'s `session_files` walks
  # for the sessions beside them.
  printf '%s\n' "$PROJECTS_STATE"
  for ppd_d in "$PROFILES_HOME"/profiles/*/*/*/projects \
               "$PROFILES_HOME"/profiles/*/*/projects \
               "$PROFILES_HOME"/profiles/*/projects \
               "$CLAUDE_HOME"/projects; do
    [ -d "$ppd_d" ] && printf '%s\n' "$ppd_d"
  done
}

# THE PHYSICAL PATH, WITHOUT `readlink -f` — which is not in the stock macOS
# userland (Copilot round 1 on openRepoTools#47), where it exits 1 and a
# fallback hands the path back UNRESOLVED. Two spellings of ONE directory then
# compare as two directories, and the shared-`projects/` case below — which on
# a launcher-configured workstation is EVERY case — would move a transcript
# that never needed moving, on the platform this suite's own macOS job runs.
# `cd -P` + `pwd -P` is the shell's own answer and is in every shell that
# parses this file. A path that is not a directory comes back as it was given,
# which is what the `readlink -f` fallback did.
real_of() { ( CDPATH=''; cd -P -- "$1" 2>/dev/null && pwd -P ) || printf '%s\n' "$1"; }
# THE HANDOFF'S DIGEST, spelled exactly as `lanes-edit.sh` spells it, because
# the two are compared: this file is what the intent recorded and what a launch
# verifies, and two implementations of one digest is one implementation too
# many. `none` where the workstation has neither tool — an ANSWER, meaning *not
# checked here*, never *unchanged*.
handoff_digest_of() {   # <file>
  [ -r "${1-}" ] || { printf 'none\n'; return 0; }
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum -- "$1" 2>/dev/null | awk '{print $1; exit}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 -- "$1" 2>/dev/null | awk '{print $1; exit}'
  else
    printf 'none\n'
  fi
}

profile_of_projects_dir() {   # <…/<profile>/projects> -> the profile's name
  popd_d="${1%/projects}"; popd_n="${popd_d##*/}"
  case "$popd_n" in .claude|claude|"") printf 'default\n' ;; *) printf '%s\n' "$popd_n" ;; esac
}

# The transcript of one id under ONE projects directory, in either spelling of
# the lane's path (a lane reached through a symlink has two).
transcript_under() {   # <projects dir> <id>
  tu_d="$1"; tu_id="$2"
  for tu_s in "$(sanitize "$DIR")" "$(sanitize "$DIR_REAL")"; do
    [ -f "$tu_d/$tu_s/$tu_id.jsonl" ] && { printf '%s\n' "$tu_d/$tu_s/$tu_id.jsonl"; return 0; }
  done
  return 1
}

# EVERY LIVE HOLDER OF AN ID, ACROSS EVERY PROFILE'S `sessions/` (Amendment
# 18(h), in force 2026-09-14T13:15:18Z: *"A transcript (one session id) is held
# by ONE live process"*). WHO IS LIVE IS `lanes-edit.sh`'s ONE ANSWER AND NOT A
# SECOND ONE HERE (opensoft/openRepoTools#56). This function used to read the
# records itself and test the pid with `kill -0` ALONE — one of the three tests
# `record_is_live` makes, not three — so a record that had ENDED, or whose pid
# had been RECYCLED onto some other process, read as a live holder and refused a
# transcript's follow with *"a LIVE process there holds it"* and the retire act,
# about a process that is not that session. `lanes-edit.sh transcript-holders`
# (opensoft/openRepoTools#52) is that read, on `record_is_live` — status not
# ended, the pid answers, and `procStart` is still the one the record wrote down
# — across every profile through `session_files`, and `dup_check` above already
# asks it; this asks it the same way and reads its exits the same way.
#
# EVERY ROW IT PRINTS IS A HOLDER HERE, WHATEVER ITS VERDICT. The verdict says
# what THIS WINDOW's relation to the holder is, which is `dup_check`'s question;
# the question at this call is narrower and older — *is any live process holding
# the id this run is about to move out of another profile* — and the move is
# wrong for a `companion` or a `here` record just as it is for a `duplicate`.
# The row's format is the contract this reads (`pid US kind US tgt US profile US
# where US verdict US file`), and the verdict stays the helper's to change.
#
# IT SETS `LIVE_HOLDERS` — `<pid><TAB><tmux target, or bg><TAB><profile>` per
# holder, one to a line — AND PRINTS NOTHING, and it is never called inside
# `$( )`: a refusal is `FOLLOW_WHY`, and a subshell would keep it to itself (the
# reason `follow_transcript` states beside its own variables). Returns 0 with
# the holders read (none is an answer), 2 where they could not be.
LIVE_HOLDERS=""
live_holders_of_id() {   # <id>
  lho_id="$1"; LIVE_HOLDERS=""; lho_rc=0; lho_rows=""
  lho_tab=$'\t'; lho_nl='
'
  : > "$LS_TMP"
  lho_rows="$("$LANES_EDIT" transcript-holders "$lho_id" 2>"$LS_TMP")" || lho_rc=$?
  case "$lho_rc" in
    0) : ;;
    8) return 0 ;;
    2) [ -s "$LS_TMP" ] && cat -- "$LS_TMP" >&2
       note "this \`lanes-edit.sh\` has no \`transcript-holders\` (exit 2), so whether a live process already holds transcript $lho_id is NOT known here. Install the one beside this script (\`openRepoTools --install\`); carrying on."
       return 0 ;;
    *) [ -s "$LS_TMP" ] && cat -- "$LS_TMP" >&2
       FOLLOW_WHY="$LANES_EDIT transcript-holders $lho_id exited $lho_rc, so whether a live process holds that transcript could NOT be read — and that is not 'none does'. A transcript is held by ONE live process (Amendment 18(h)): nothing was moved and nothing was launched."
       return 2 ;;
  esac
  while IFS=$'\037' read -r lho_pid lho_kind lho_tgt lho_prof lho_where lho_verdict lho_file; do
    [ -n "${lho_pid:-}" ] || continue
    # The raw tmux target, and `bg` where the record names none (`transcript-holders`
    # writes `none`) — what this said before it asked the helper.
    case "${lho_tgt:-none}" in none) lho_tgt=bg ;; esac
    LIVE_HOLDERS="${LIVE_HOLDERS:+$LIVE_HOLDERS$lho_nl}$lho_pid$lho_tab$lho_tgt$lho_tab${lho_prof:-}"
  done <<<"$lho_rows"
  return 0
}

# PUTTING THE MOVE BACK. The transaction below is three writes, and the two
# after the first each undo what came before them rather than leave a
# transcript split across two profiles. It reads `follow_transcript`'s own
# `ft_*` variables — one act, one set of names — and PRINTS what it could not
# undo rather than returning a code, because a rollback that itself failed is
# the one state nobody can infer from the outside and the refusal has to say it.
ft_rollback() {
  ftr_out=""
  if [ "${ft_moved_sib:-0}" = 1 ]; then
    mv -- "$ft_dest_dir/$ft_id" "$ft_sib" 2>/dev/null ||
      ftr_out="the sibling directory is at $ft_dest_dir/$ft_id and could not be put back to $ft_sib"
  fi
  mv -- "$ft_dest_dir/$ft_id.jsonl" "$ft_f" 2>/dev/null ||
    ftr_out="${ftr_out:+$ftr_out; }the transcript is at $ft_dest_dir/$ft_id.jsonl and could not be put back to $ft_f"
  printf '%s' "$ftr_out"
  return 0
}

# THE SEARCH, THE SAY AND THE MOVE. Sets `FOLLOW_FILE` (the transcript's path
# HERE, after any move) and `FOLLOW_WHY` (a refusal), and returns 0 found, 8
# nowhere, 2 refused. IT NEVER `die`s: a refusal inside `$( )` kills only the
# substitution's subshell, and the caller would carry on with an empty answer —
# which here would mean starting a second process on a transcript another live
# one holds.
FOLLOW_FILE=""; FOLLOW_WHY=""
follow_transcript() {   # <id>
  ft_id="$1"; FOLLOW_FILE=""; FOLLOW_WHY=""
  ft_here_real="$(real_of "$PROJECTS_STATE")"
  ft_shared=""
  while IFS= read -r ft_d; do
    [ -n "$ft_d" ] || continue
    [ "$ft_d" = "$PROJECTS_STATE" ] && continue
    ft_real="$(real_of "$ft_d")"
    if [ "$ft_real" = "$ft_here_real" ]; then
      # THE SHARED-DIRECTORY CASE, which on a launcher-configured workstation is
      # every case: the other profile's `projects/` IS this one, so the
      # transcript is already here and nothing is moved.
      ft_shared="${ft_shared:+$ft_shared }$(profile_of_projects_dir "$ft_d")"
      continue
    fi
    ft_f="$(transcript_under "$ft_d" "$ft_id" 2>/dev/null || :)"
    [ -n "$ft_f" ] || continue
    ft_prof="$(profile_of_projects_dir "$ft_d")"
    # A UUID WHOSE HOLDER IS LIVE THERE IS A REFUSAL, NEVER A MOVE (Amendment
    # 18(h)): moving the file out from under a running process, and then
    # resuming the same id here, is two live processes on one transcript — the
    # state measured on this lane on 2026-09-14 and the reason that clause
    # exists.
    # NOT `$( )`: `live_holders_of_id` sets `FOLLOW_WHY` when the holders cannot
    # be read, and a subshell would keep the refusal to itself.
    ft_hrc=0
    live_holders_of_id "$ft_id" || ft_hrc=$?
    [ "$ft_hrc" = 0 ] || return "$ft_hrc"
    ft_holders="$LIVE_HOLDERS"
    if [ -n "$ft_holders" ]; then
      FOLLOW_WHY="transcript $ft_id is in profile $ft_prof's projects directory ($ft_d) and a LIVE process there holds it:
$(printf '%s\n' "$ft_holders" | sed 's/^/      pid /; s/\t/ in /; s/\t/ under profile /')
    A transcript is held by ONE live process (Amendment 18(h)): moving it here and resuming the id would make a second. Nothing was moved and nothing was launched.
    End that process, or retire it: lane-end $LANE --retire <pid>"
      return 2
    fi
    # THE MOVE: the `<uuid>.jsonl` and its sibling `<uuid>/` directory, into the
    # SAME slug under this profile, with a pointer left where it was.
    ft_dest_dir="$PROJECTS_STATE/$(basename -- "$(dirname -- "$ft_f")")"
    ft_sib="${ft_f%.jsonl}"
    # `--dry-run` MOVES NOTHING (Copilot round 1 on openRepoTools#47). This
    # function runs long before the dry-run exit at the foot of the script, and
    # a command whose last line is *nothing was renamed, written or launched*
    # must not have moved a person's transcript out of another profile to get
    # there. The plan is printed with both paths instead, and the caller says
    # what it would have followed.
    if (( dry_run )); then
      plan "mv $ft_f $ft_dest_dir/$ft_id.jsonl (with its sibling $ft_id/, and a pointer left where it was)"
      FOLLOW_WHY="dry-run:transcript $ft_id is in profile $ft_prof's projects directory ($ft_d) and WOULD be moved into $ft_dest_dir"
      return 8
    fi
    mkdir -p -- "$ft_dest_dir" 2>/dev/null || {
      FOLLOW_WHY="could not create $ft_dest_dir to move transcript $ft_id into"; return 2; }
    # AN OCCUPIED DESTINATION IS REFUSED BEFORE ANYTHING MOVES (Copilot round 3
    # on openRepoTools#47). `mv <dir> <existing dir>` does not fail — it moves
    # the source INSIDE it — so a `<uuid>/` already sitting here would take the
    # other profile's sidecar as `<uuid>/<uuid>/`, mark the sibling moved, and
    # resume with the transcript's state split from the transcript. Nothing this
    # command writes is worth guessing which of two `<uuid>` directories is the
    # lane's, so it names what is there and stops. A name that is NOT a
    # directory is left to the transaction below, where `mv` really does fail
    # and the rollback puts the transcript back.
    if [ -d "$ft_dest_dir/$ft_id" ] || [ -e "$ft_dest_dir/$ft_id.jsonl" ]; then
      FOLLOW_WHY="transcript $ft_id is in profile $ft_prof's projects directory ($ft_d), and something ALREADY SITS where it would go: $ft_dest_dir/$ft_id$( [ -e "$ft_dest_dir/$ft_id.jsonl" ] && printf '.jsonl' ). Nothing was moved — a move onto an occupied name puts one transcript inside another, and which of the two is this lane's is not this command's to guess. Move that aside, or end the lane that owns it."
      return 2
    fi
    if ! mv -- "$ft_f" "$ft_dest_dir/$ft_id.jsonl" 2>/dev/null; then
      FOLLOW_WHY="could not move $ft_f into $ft_dest_dir (the transcript stays where it is, and this lane will not resume an id it cannot read)"
      return 2
    fi
    # THE THREE WRITES ARE ONE TRANSACTION (Copilot round 1 on
    # openRepoTools#47). The `.jsonl`, its sibling `<uuid>/` state directory and
    # the pointer left behind are one act, and a HALF-DONE one is worse than
    # none: a sibling orphaned in the other profile is state the resumed session
    # silently loses, and a transcript gone from where a person will look for it
    # with no pointer has had its only recovery trail deleted. So each of the
    # two below is CHECKED, and a step that cannot complete puts back what the
    # steps before it moved and refuses — naming the parts it could not put
    # back, because a rollback that itself failed is the one state nobody can
    # infer from the outside.
    ft_moved_sib=0
    if [ -d "$ft_sib" ]; then
      if mv -- "$ft_sib" "$ft_dest_dir/$ft_id" 2>/dev/null; then
        ft_moved_sib=1
      else
        ft_undone="$(ft_rollback)"
        FOLLOW_WHY="transcript $ft_id moved into $ft_dest_dir, but its sibling state directory $ft_sib could NOT follow it — half a transcript is not one, so the move was put back. Nothing was launched.${ft_undone:+
    WHAT COULD NOT BE PUT BACK: $ft_undone}"
        return 2
      fi
    fi
    # THE POINTER, WHERE THE FILE WAS: `<uuid>.jsonl.moved-to-<profile>-<UTC>`.
    # A person looking for a transcript that is not where they left it is owed
    # the sentence, in the directory they are standing in — so a pointer that
    # cannot be written (a source directory that is read-only, say) undoes the
    # move rather than completing it untraceably.
    ft_to="${CLAUDE_PROFILE_NAME:-}"
    [ -n "$ft_to" ] || ft_to="$(profile_of_projects_dir "$PROJECTS_STATE")"
    ft_ptr="$ft_f.moved-to-$ft_to-$(date -u +%Y-%m-%dT%H%M%SZ)"
    if ! printf 'moved to %s by %s at %s\n' "$ft_dest_dir" "$prog" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
         > "$ft_ptr" 2>/dev/null; then
      rm -f -- "$ft_ptr" 2>/dev/null || :
      ft_undone="$(ft_rollback)"
      FOLLOW_WHY="transcript $ft_id could not be given its pointer at $ft_ptr, which is the only trail back to where it was — so the move was put back rather than left untraceable. Nothing was launched.${ft_undone:+
    WHAT COULD NOT BE PUT BACK: $ft_undone}"
      return 2
    fi
    step "transcript $ft_id was in profile $ft_prof's projects directory ($ft_d), which is NOT this profile's — moved into $ft_dest_dir, with a pointer left where it was (a copy would leave two live transcripts of one uuid diverge)"
    FOLLOW_FILE="$ft_dest_dir/$ft_id.jsonl"
    return 0
  done <<EOF
$(profile_projects_dirs)
EOF
  [ -z "$ft_shared" ] || FOLLOW_WHY="shared:$ft_shared"
  return 8
}

# The transcript of ONE recorded session id, in this directory.
recorded_transcript() {
  local id="$1" d
  [ -n "$id" ] || return 1
  while IFS= read -r d; do
    if [ -f "$d/$id.jsonl" ]; then printf '%s\n' "$d/$id.jsonl"; return 0; fi
  done < <(transcript_dirs)
  return 1
}

# A `/rename` is a `{"type":"custom-title",…}` record inside the transcript,
# and the LAST one wins — a session renamed away from this lane must not be
# resumed by it. Several transcripts can still carry one title; that is why
# this is only the fallback.
# `<LANE> (2)` is the SAME lane: that suffix is exactly what a rename into a
# title something else still holds mints, and live_holder() already reads it
# that way. A matcher that insisted on the bare string would hide a lane from
# itself — this orchestrator's own title on 2026-09-11 was `codeXfactory-1 (4)`.
# AMENDMENT 15 — THE TITLE IS MATCHED CASE-INSENSITIVELY, because the SESSION
# NAME is one of the lookups the rule names and because this is the branch that
# decides RESUME versus MINT A NEW ONE. `openXfactory-2`'s own transcript is
# titled `openxfactory-2` — the launcher named it that on 2026-09-13, and the
# row says `openXfactory-2` since the 15(d) merge — so a byte-for-byte matcher
# would find NO transcript for that lane and start a second conversation on it,
# which is the incident this amendment exists to stop, one branch along.
# `live_holder` and `fork_map` have matched titles case-insensitively all along;
# this was the one that did not.
#
# THE LANE IS LOWER-CASED ONCE, outside the loop, and only the candidate's own
# `base` per file — which is two processes this loop already spends on `grep`
# and `sed` for every file it looks at.
titled_transcript() {
  local d f last title base tt_lane_lc
  tt_lane_lc="$(printf '%s' "$LANE" | tr 'A-Z' 'a-z')"
  while IFS= read -r d; do
    [ -d "$d" ] || continue
    for f in "$d"/*.jsonl; do
      [ -e "$f" ] || continue
      last="$(grep -e '^{"type":"custom-title"' "$f" 2>/dev/null | tail -n1 || :)"
      [ -n "$last" ] || continue
      title="$(printf '%s' "$last" | sed 's/.*"customTitle":"//; s/".*//')"
      base="${title% (*)}"
      if [ "$(printf '%s' "$base" | tr 'A-Z' 'a-z')" = "$tt_lane_lc" ]; then printf '%s\t%s\n' "$f" "$title"; return 0; fi
    done
  done < <(transcript_dirs)
  return 1
}

new_uuid() {
  if [ -r /proc/sys/kernel/random/uuid ]; then cat /proc/sys/kernel/random/uuid
  elif command -v uuidgen >/dev/null 2>&1; then uuidgen | tr 'A-F' 'a-f'
  else return 1
  fi
}

# Amendment 7's lane verb follows the LAUNCH decision, which is the honest
# reading of it: a resume is a RESUMED and a new session is a STARTED.
lane_verb=STARTED
lane_sid=""

# ================= AMENDMENT 17(c): WHICH AGENT, AND WHAT IT IS LAUNCHED WITH
#
# *"`lane-start <repo> <n>` reads the row and the last `PAUSED`. Where the agent
# asked for is the one that paused, and its transcript is here, it resumes
# exactly as today (Amendment 6's case (a)). Otherwise — a different agent, or
# no transcript here — it launches the named agent with THE HANDOFF'S TOP BLOCK
# AS ITS FIRST PROMPT … With no `--agent` the default is the agent that paused;
# with no `PAUSED` the default is `claude`."*
#
# THE DEFAULT COMES FROM THE RECORD, THROUGH THE ONE READ THAT ANSWERS FOR IT
# (`lane-agent`, this amendment's sibling of `lane-dir`). 8 is "no record of
# this amendment yet" — every lane until its own next handoff — and it is not a
# failure: `claude` is what this command has always launched.
# THE AGENT'S OWN RESUMABLE ID, where the record carries one. For `claude` that
# is the transcript uuid the session cell already records and this script
# already resumes; for another agent it is the one id a launch has in hand, and
# it is what the row's session cell is appended with in that agent's spelling
# (`Codex <id>`). `none` is an ANSWER — the agent has no resumable id — and is
# not carried into the cell as if it were one.
#
# AND ONLY WHERE THE RECORD IS THAT AGENT'S (Copilot round 2 on
# openRepoTools#47). `lane-transcript` answers for the LANE — its last `PAUSED`,
# whichever agent wrote it — so a lane paused by `claude` and resumed with
# `--agent codex` would take the CLAUDE uuid and append it to the row's session
# cell spelled `Codex <uuid>`: an id no `codex` can resume, attributing this
# lane's history to a conversation that is not it, in a cell nothing rewrites.
if [ "$AGENT" != claude ]; then
  [ "$RECORDED_AGENT_READ" = 1 ] || read_recorded_agent
  if [ -n "$RECORDED_AGENT" ] && [ "$RECORDED_AGENT" != "$AGENT" ]; then
    note "the lane's last handoff names agent $RECORDED_AGENT and this launch is $AGENT, so the recorded transcript is NOT carried into the row's session cell — that id is $RECORDED_AGENT's and $AGENT cannot resume it. This launch is recorded without an id of its own; the session's first act stamps the row with the one it gets."
  else
    at_out=""; at_rc=0
    at_out="$("$LANES_EDIT" lane-transcript "$LANE" 2>/dev/null)" || at_rc=$?
    case "$at_rc" in
      0) [ "$at_out" = none ] || AGENT_ID="$at_out" ;;
      8|2) : ;;
      # 007 (T402; Y:5727; spec:688): busy and in doubt refuse; 69 stays a
      # note. Step 4 has named the window by now, so the refusal gives the
      # name back (lane 3's ruling 6747281902, T402 item 5).
      75 | 3) ls_late_refuse "$LANES_EDIT lane-transcript $LANE" "$at_rc" "the agent's own id in lane ${LANE}'s last handoff" ;;
      *) note "$LANES_EDIT lane-transcript $LANE failed (exit $at_rc) — the row's session cell will record this launch without the agent's own id" ;;
    esac
  fi
fi
# ------------- THE FRESH SESSION, AND WHICH OF ITS THREE SOURCES IS AUTHORITY
#
# A CONTEXT CLEAR IS ONE SENTENCE — *a NEW session of this lane's agent,
# started with the top block of the handoff the row names as its first prompt* —
# and it is why `/ctx` does not simply resume the transcript it has just paused.
# What changed on 2026-09-15 is not the sentence but WHO SAYS IT.
#
# `LANE_START_FRESH=1` WAS THE SEAM AND IS NO LONGER THE AUTHORITY
# (openRepoTools#94, measured on Eagle 2026-09-15T20:59Z). `/ctx` respawned the
# lane's own pane with the variable set, and this command was reached WITHOUT
# it: `claude-profile` re-creates the child through tmux, and its own code says
# the rule — *"`tmux new-session` hands the command the SERVER's environment,
# not this client's, so a variable the operator exported in their own shell
# reaches the child only if it is written into the command string"*. It threads
# six values explicitly and this was never one of them. The gates below were
# correct and were simply never reached with `fresh` set; the lane resumed the
# uuid it had just paused, and the record said an act had happened that had not.
#
# SO THE AUTHORITY IS A FILE, and the three sources are read in this order:
#
#   1. THE LANE'S OWN RESTART INTENT — `lanes-edit.sh restart-intent <lane>`,
#      written under the lane's control root BEFORE the old process was killed
#      and read back here whatever the environment did. It is the only channel
#      that crosses a boundary another repository owns, because it is on disk
#      rather than in an environment. Only `pending` and `starting` authorise a
#      launch: a `ready` intent is HISTORY (which is what makes an ordinary
#      `lane <name>` after a successful `/ctx` an ordinary resume), and a
#      failed launch is the supervisor's to retry, moving it back to `starting`.
#      Failed preparation authorizes only guarded ordinary resume with unchanged
#      intent history; it has no supervised launch authority.
#   2. `--fresh`, for the caller that reaches this command directly and has no
#      launcher between it and here.
#   3. `LANE_START_FRESH=1`, kept exactly as it was so that nothing written
#      about it stops working, and no longer trusted to arrive.
#
# AND AN INTENT THAT DISAGREES WITH THIS RUN IS A REFUSAL, NEVER A SUBSTITUTION
# (spec: *the operation launch refuses without substituting the conflicting
# value*). An intent naming another directory is an intent for a lane in
# another checkout, and launching this one in it is Evidence 3's silent loss of
# the repository's CLAUDE.md and the lane's memory; an `--operation` that is not
# the lane's current one is a supervisor acting for an operation that has been
# superseded.
fresh=0
fresh_why=""
first_prompt=0
ri_state=""; ri_op=""; ri_gen=""; ri_mode=""; ri_dir=""; ri_hf=""; ri_dig=""; ri_rc=0; ri_expected_digest=""; ri_prompt=""; ri_active=0; ri_attempt=""; ri_prepared=""; ri_agent=""; ri_profile=""
ri_out="$(LANES_NO_FETCH=1 "$LANES_EDIT" restart-intent "$LANE" --dir "$DIR" 2>/dev/null)" || ri_rc=$?
case "$ri_rc" in
  0)
    # Read to the end, never by a reader that stops (`intent_field`, above).
    ri_state="$(intent_field "$ri_out" state)"
    ri_op="$(intent_field "$ri_out" operation)"
    ri_gen="$(intent_field "$ri_out" generation)"
    ri_mode="$(intent_field "$ri_out" mode)"
    ri_dir="$(intent_field "$ri_out" dir)"
    ri_hf="$(intent_field "$ri_out" handoff)"
    ri_dig="$(intent_field "$ri_out" digest)"
    ri_pane="$(intent_field "$ri_out" pane)"
    ri_attempt="$(intent_field "$ri_out" attempt)"
    ri_prepared="$(intent_field "$ri_out" prepared_digest)"
    ri_agent="$(intent_field "$ri_out" agent)"
    ri_profile="$(intent_field "$ri_out" profile)" ;;
  # 8 IS AN ANSWER — this lane has no restart in flight, which is every
  # ordinary launch — and 2 IS A HELPER THAT PREDATES THIS READ: an installed
  # `lanes-edit.sh` from before openRepoTools#94 answers 2 from its
  # unknown-subcommand arm, and on that workstation no `/ctx` could have
  # written an intent at all. The estate's fence is one sentence and
  # `lane-handoff` spells it out at its own register reads — *"`0` an answer,
  # `8` NO ANSWER and `2` a helper predating the read — both of those fall to
  # the next rung"*. Both fall to the next rung here too, and neither is worth
  # a note printed on every launch of every lane.
  8|2) : ;;
  # AND 1 IS NOT ONE OF THEM (Copilot round 2 on openRepoTools#121). `1` is
  # *the control root could not be derived*, which is a READ THAT COULD NOT BE
  # MADE and never *there is no restart in flight* — and the two are opposite
  # facts at this one gate. The sidecar `/ctx` wrote sits under a root resolved
  # from the lane's recorded directory or `$PROJECTS_ROOT`, and the pane this
  # launch runs in is a NEW one whose environment is not the one that wrote it;
  # a root that resolved then and does not now leaves this command reading
  # nothing and calling it nothing-in-flight. What it would then do is resolve
  # an ordinary resume source — and for a lane whose `/ctx` has just killed its
  # pane, that is the transcript the `/ctx` PAUSED. That is openRepoTools#94,
  # recreated by the very command written to prevent it.
  #
  # SO IT REFUSES, and so does any code this fence does not classify. The old
  # line said *refusing every launch on a helper that could not answer is not a
  # safety property* — which is true of a lane with no restart in flight and
  # false of the one gate whose wrong answer resumes a paused transcript. The
  # refusal names what to run to see the failure and both ways out of it,
  # because a refusal a person cannot act on is not better than the defect.
  1)
    die "lane $LANE's restart intent could not be read: it has no lifecycle control root here (\`$LANES_EDIT restart-intent $LANE\` exits 1 — its record names no directory and \$PROJECTS_ROOT is not a directory in this environment). That is NOT 'no restart is in flight': the sidecar a /ctx writes lives under that root, and launching without reading it would resolve an ordinary resume source — which for a lane whose pane a /ctx has just replaced is the transcript that /ctx PAUSED (openRepoTools#94). Nothing was renamed, written or started. Give this run a root it can resolve: set \$LANES_LANE_STATE_ROOT, or make \$PROJECTS_ROOT (default \$HOME/projects) a directory — the lane's own record names its checkout once it has been started with one, and resolves on that." 2 ;;
  *)
    die "lane $LANE's restart intent read FAILED (\`$LANES_EDIT restart-intent $LANE\` exited $ri_rc), and a read that failed is never an answer (Amendment 7(d)). Nothing was renamed, written or started: this is the one launch gate whose wrong answer resumes the transcript a /ctx just paused (openRepoTools#94), so it refuses rather than falling through to an ordinary resume source. Run that command yourself to see what it says, then launch again." 1 ;;
esac
if [ -n "$preparation_failure_identity" ]; then
  pfr_current="$(preparation_failure_snapshot "$ri_out")"
  [ "$pfr_current" = "$preparation_failure_identity" ] ||
    die "the failed preparation changed during ordinary recovery. Nothing was launched." 2
fi
if [ -n "${LANE_RESTART_OPERATION:-}" ]; then
  [ -z "$op_flag" ] || [ "$op_flag" = "$LANE_RESTART_OPERATION" ] ||
    die "the explicit restart operation disagrees with the supervisor token. Nothing was started." 2
  op_flag="${op_flag:-$LANE_RESTART_OPERATION}"
fi
# AN `--operation` NAMES THE INTENT IT BELONGS TO, AND ONLY THAT ONE.
if [ -n "$op_flag" ]; then
  [ -n "$ri_state" ] ||
    die "--operation $op_flag was given and lane $LANE has no restart intent to match it against (the read above says what answered). A supervised launch is made for ONE operation and this one cannot be found: nothing was renamed, nothing was written and no session was started. Read it with:  lanes-edit.sh restart-intent $LANE" 2
  [ "$op_flag" = "$ri_op" ] ||
    die "--operation $op_flag is not lane $LANE's current restart operation, which is ${ri_op:-none} (state ${ri_state:-none}, generation ${ri_gen:-0}). A stale supervisor must never launch against a newer operation — nothing was renamed, written or started. Read it with:  lanes-edit.sh restart-intent $LANE" 2
fi
case "$ri_state" in
  # AN INTENT THIS READER CANNOT UNDERSTAND REFUSES THE LAUNCH, AND DOES NOT
  # QUIETLY RESUME (Copilot round 1 on openRepoTools#121). `lanes-edit.sh`
  # answers `UNKNOWN-SCHEMA` where a newer tooling wrote the record, and that
  # answer used to fall through this `case` to the ordinary resume-source
  # resolution below — which is the SAFE half of the decision (it authorises no
  # fresh session) sitting on top of the UNSAFE one: the lane whose intent that
  # is has just had its pane killed by a `/ctx`, and the resume source waiting
  # there is the transcript that `/ctx` PAUSED. Falling through would resume it.
  # That is openRepoTools#94 exactly, reached down a second road.
  #
  # So it is a refusal, in the one shape Amendment 7(d) gives: a read that could
  # not be made is never an answer. It costs a person the lane until the
  # workstation's `lanes-edit.sh` is new enough to read the file — and the
  # message says both ways out, which is what makes that recoverable rather than
  # a wall.
  INCOMPLETE)
    die "lane $LANE has a restart intent that is missing facts a launch is fenced on (\`lanes-edit.sh restart-intent $LANE\` answers INCOMPLETE and names them). Its writer records every field on every transition, so a record missing one was not written by this tooling — and launching from it would skip the very checks those fields exist for: the pane comparison and the handoff digest both treat an absent value as *cannot compare*. Nothing was renamed, written or started. Read it, and remove it once you know no restart is in flight:  lanes-edit.sh restart-intent $LANE" 2 ;;
  UNKNOWN-STATE)
    die "lane $LANE has a malformed restart state. Nothing was started. Read it: lanes-edit.sh restart-intent $LANE" 2 ;;
  UNKNOWN-SCHEMA)
    die "lane $LANE has a restart intent this \`lanes-edit.sh\` cannot read: its schema is one this version does not know (\`lanes-edit.sh restart-intent $LANE\` answers UNKNOWN-SCHEMA). That is NOT 'no restart is in flight' — a read that could not be made is never an answer (Amendment 7(d)) — and starting anyway would resolve an ordinary resume source, which for a lane whose /ctx just killed its pane is the transcript that /ctx PAUSED. Nothing was renamed, written or started. Update this workstation's openRepoTools so it can read that record, or remove the intent once you know no restart is in flight:  lanes-edit.sh restart-intent $LANE" 2 ;;
  failed)
    [ -n "$preparation_failure_identity" ] ||
      die "a failed restart appeared during ordinary launch. Recheck it before recovery. Nothing was launched." 2
    preparation_failure_resume_check "$ri_out" ;;

  preparing)
    die "this restart is still preparing its preservation records. No launch is authorized. Read it: lanes-edit.sh restart-intent $LANE" 2 ;;
  pending|starting)
    ri_active=1
    [ "$AGENT" = claude ] && [ "$ri_agent" = claude ] || die "legacy supervised restart requires the recorded Claude agent. Nothing was started." 2
    if [ -n "${CLAUDE_PROFILE_NAME:-}" ] && [ "$ri_profile" != none ]; then
      [ "$CLAUDE_PROFILE_NAME" = "$ri_profile" ] || die "the launcher profile disagrees with the restart intent. Nothing was started." 2
    fi
    if [ -n "${LANE_RESTART_ATTEMPT:-}" ]; then
      [ "$LANE_RESTART_ATTEMPT" = "$ri_attempt" ] || die "this child belongs to a superseded restart attempt. Nothing was started." 2
    fi
    [ -n "$op_flag" ] || die "an active restart requires its supervisor operation token. Ordinary lane launch cannot consume it. Retry with lane-handoff --supervise --lane $LANE --operation $ri_op." 2
    LANES_NO_FETCH=1 "$LANES_EDIT" legacy-restart-check "$LANE" ||
      die "managed or unknown ownership blocks this legacy restart. Nothing was started." 2
    if [ -n "$ri_pane" ] && [ "$ri_pane" != none ] && [ -n "${TMUX_PANE:-}" ]; then
      case "$ri_pane" in *.%*) ri_pane_id="${ri_pane##*.}" ;; %*) ri_pane_id="$ri_pane" ;; *) ri_pane_id="" ;; esac
      [ -z "$ri_pane_id" ] || [ "$ri_pane_id" = "$TMUX_PANE" ] || die "the restart intent names another pane. Nothing was started." 2
    fi
    [ "$ri_mode" = fresh-from-handoff ] || die "this restart has not completed preservation; its mode is $ri_mode. Nothing was started." 2
    [ -n "$ri_dig" ] && [ "$ri_dig" != none ] || die "the supervised restart has no complete handoff checksum. Nothing was started." 2
    if [ "$ri_mode" = fresh-from-handoff ]; then
      # THE DIRECTORY IS COMPARED BEFORE ANYTHING IS TAKEN. `real_of` is this
      # file's own resolver, so a symlinked projects root does not read as a
      # disagreement it is not.
      if [ -n "$ri_dir" ] && [ "$ri_dir" != none ] && [ "$(real_of "$ri_dir")" != "$(real_of "$DIR")" ]; then
        die "lane $LANE's restart intent (operation ${ri_op:-none}, state $ri_state) names checkout $ri_dir and this launch stands in $DIR. That is a conflict and not a preference: a launch that lands in the right transcript and the wrong directory loses the repository's CLAUDE.md and the lane's memory, silently (Evidence 3). Nothing was renamed, written or started. Launch it where the intent says, or read the intent:  lanes-edit.sh restart-intent $LANE" 2
      fi
      # THE HANDOFF'S DIGEST IS VERIFIED ON EVERY LAUNCH (spec: *a changed or
      # missing handoff blocks launch and retry*), because the top block of
      # that file is literally this launch's first prompt and a file that has
      # moved under the intent is a different instruction. A `none` digest is
      # *not checked here* — a workstation with neither `sha256sum` nor
      # `shasum` — and says so rather than passing silently.
      if [ -n "$ri_hf" ] && [ "$ri_hf" != none ] && [ -n "$ri_dig" ] && [ "$ri_dig" != none ]; then
        ri_now="$(handoff_digest_of "$ri_hf")"
        if [ "$ri_now" != "$ri_dig" ] && [ "$ri_now" != "${ri_prepared:-none}" ]; then
          die "lane $LANE's handoff has changed since its restart intent was written: the intent records digest $ri_dig for $ri_hf and that file now digests $ri_now. The top block of that file is this launch's FIRST PROMPT, so launching now would hand the new session the block of a handoff the /ctx did not write. Nothing was renamed, written or started (operation ${ri_op:-none}). Take the handoff again:  lane-handoff --restart" 2
        fi
      fi
      # The digest and the actual prompt must refer to the same row-bound file:
      # THE ONE THIS LANE'S WRITES GO TO (Amendment 23, slice 2b), which
      # `handoff-path` names from the row's cell — the lane's own checkout's
      # copy under the opt-in — and which `lane-handoff` bound and 5c stamps.
      ri_row_hf=""
      ri_row_hf="$(LANES_NO_FETCH=1 "$LANES_EDIT" handoff-path "$LANE" 2>/dev/null)" && [ -f "$ri_row_hf" ] ||
        die "the restart handoff the row names is missing. Nothing was started." 2
      [ -n "$ri_hf" ] && [ "$ri_hf" != none ] && [ -s "$ri_hf" ] &&
        [ "$ri_hf" -ef "$ri_row_hf" ] ||
        die "the restart intent and register name different handoffs. Nothing was started." 2
      ri_expected_digest="$(handoff_digest_of "$ri_hf")"
      fresh=1
      fresh_why=" (restart intent ${ri_op:-none}, state $ri_state: the /ctx respawn)"
    else
      note "lane $LANE has a restart intent in state $ri_state whose mode is '${ri_mode:-none}' and not 'fresh-from-handoff', so it authorises no fresh session here; this launch resolves its own resume source."
    fi ;;
esac
if (( ! fresh )) && [ "$fresh_flag" = 1 ]; then
  fresh=1
  fresh_why=" (--fresh)"
fi
if (( ! fresh )) && [ "${LANE_START_FRESH:-0}" = 1 ]; then
  fresh=1
  fresh_why=" (LANE_START_FRESH=1: the /ctx respawn)"
fi

# AMENDMENT 11, EVIDENCE 4 — `--name "$LANE"` IS ON EVERY LAUNCH BRANCH, NOT
# ONLY THE NEW-SESSION ONE. The session NAME is the lane's messaging address
# (Amendment 2): `ListAgents`, `SendMessage`, `@<lane>` and the statusline all
# read the harness record's name, and a resume that passes no `--name` gets a
# DERIVED one. Measured on this lane 2026-09-13: the transcript carried
# `customTitle: openRepoProject-1`, set once by `/rename`, while every process
# that resumed it that day carried `openrepoproject-b9`, `-1e`, `-27`, `-45` —
# four derived names for one lane, because only the new-session branch below
# passed the flag. A resume is a launch; a launch names its window's session
# after the lane, or the lane loses its address for the life of that session,
# and there is no API to rename a running one from inside.
new_sid=""
# ACT 6 — WHERE THE TRANSCRIPT IS, SAID RATHER THAN ASSUMED, and followed where
# it is in another profile's directory. This runs BEFORE the branch below, so
# `recorded_transcript` answers for a transcript this run has just moved here.
rec_file=""
resume_sid="$row_sid"
restored_sid=""
# NOT IN THE BINDING MODE (openRepoTools#70): the id there is a session that is
# RUNNING in this window, its launch decision does not read where its transcript
# is, and a transcript a live process holds is one this act refuses to move.
if [ -n "$row_sid" ] && [ "$AGENT" = claude ] && (( ! fresh )) && [ -z "$bind_sid" ]; then
  rec_file="$(recorded_transcript "$row_sid" 2>/dev/null || :)"
  if [ -n "$rec_file" ]; then
    # WHICH DIRECTORY IT WAS FOUND IN, and whether that directory is SHARED —
    # `readlink -f` equal across profiles is what makes a profile switch need no
    # move at all, and a person swapping accounts is owed that sentence rather
    # than a silent success they cannot reason about.
    shared_with=""
    here_real="$(real_of "$PROJECTS_STATE")"
    while IFS= read -r ppd; do
      [ -n "$ppd" ] && [ "$ppd" != "$PROJECTS_STATE" ] || continue
      [ "$(real_of "$ppd")" = "$here_real" ] || continue
      shared_with="${shared_with:+$shared_with }$(profile_of_projects_dir "$ppd")"
    done <<EOF
$(profile_projects_dirs)
EOF
    step "transcript $row_sid found in this profile's projects directory ($PROJECTS_STATE)${shared_with:+, which IS the directory profile(s) $shared_with read too (one shared directory: a profile switch resumes this lane by id and moves nothing)}"
  else
    # `|| ft_rc=$?` AND NOT `; ft_rc=$?`: this script runs under `set -e`, so a
    # function returning 8 as a bare command ENDS IT — with 8, which is this
    # estate's code for "no record" and which a caller would read as a lane-start
    # that found nothing rather than one that was never asked.
    ft_rc=0
    follow_transcript "$row_sid" || ft_rc=$?
    case "$ft_rc" in
      0) rec_file="$FOLLOW_FILE" ;;
      2) die "$FOLLOW_WHY" 2 ;;
      *) case "$FOLLOW_WHY" in
           shared:*) note "no transcript for $row_sid under this directory in any profile's projects directory (profiles ${FOLLOW_WHY#shared:} share this one)" ;;
           # `--dry-run` FOUND IT AND MOVED NOTHING. The run carries on as a
           # lane whose transcript is not here — which is what it would be
           # WITHOUT the move — because a dry run must not report a launch that
           # depends on a write it did not make.
           dry-run:*) note "--dry-run: ${FOLLOW_WHY#dry-run:}. Nothing was moved; the branch below is the one a lane with no transcript here takes" ;;
         esac ;;
    esac
  fi
fi

# AMENDMENT 17(c) MAKES THE PAUSED RECORD A RESUME SOURCE, NOT MERELY A LABEL.
# The row normally wins because its last transcript is the current one. A
# harness restart can, however, append the process/session id it minted while
# continuing an older Claude transcript. That id is then a perfectly readable
# row entry but has no `<id>.jsonl`; falling through to `--resume <LANE>` opens
# Claude's title picker and can immediately exit a launcher-created pane. The
# last PAUSED record already carries the exact agent transcript for this case.
# Where it names this same agent and that transcript exists, resume the exact id
# and put it back at the end of the cell below. A live session being bound in
# this window still wins: step 3b has first-hand evidence and must never be
# replaced by an older handoff.
#
# AND "BEING BOUND" IS TWO VARIABLES, NOT ONE (Copilot round 2 on
# openRepoTools#87). `$harness_sid` is set only where step 3b TAKES a session
# the row does not name; where the window's live session IS the row's, step 3
# has already said so with `holder_here` and `$harness_sid` stays empty — so
# that test alone let this fallback fire on the one state it was written to
# stand off: the lane live in THIS window, its transcript not under this
# directory (the harness has been seen to keep one under another `cwd` key),
# and an older PAUSED record beside it. It would have `--resume`d the older
# conversation over the person's own, in the window they are sitting in. Both
# halves of the evidence are asked for now — and `--bind` is that evidence
# named outright (openRepoTools#70).
if [ -z "$rec_file" ] && [ -z "$harness_sid" ] && [ -z "$bind_sid" ] && (( ! holder_here )) \
   && [ "$AGENT" = claude ] \
   && [ "$RECORDED_AGENT" = claude ] && (( ! fresh )); then
  paused_sid=""; paused_rc=0
  paused_sid="$("$LANES_EDIT" lane-transcript "$LANE" 2>/dev/null)" || paused_rc=$?
  case "$paused_rc" in
    0)
      if [[ "$paused_sid" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] \
         && [ "$paused_sid" != "$row_sid" ]; then
        paused_file="$(recorded_transcript "$paused_sid" 2>/dev/null || :)"
        if [ -z "$paused_file" ]; then
          paused_follow_rc=0
          follow_transcript "$paused_sid" || paused_follow_rc=$?
          case "$paused_follow_rc" in
            0) paused_file="$FOLLOW_FILE" ;;
            2) die "$FOLLOW_WHY" 2 ;;
            *) case "$FOLLOW_WHY" in
                 dry-run:*) note "--dry-run: ${FOLLOW_WHY#dry-run:}. Nothing was moved; the title/new-session branch below remains the dry-run result" ;;
               esac ;;
          esac
        fi
        if [ -n "$paused_file" ]; then
          resume_sid="$paused_sid"
          rec_file="$paused_file"
          restored_sid="$paused_sid"
          step "the row's last session id $row_sid has no transcript here, but this same agent's last PAUSED record names transcript $paused_sid and it is here ($(basename -- "$rec_file")) — resuming that exact id"
        fi
      fi ;;
    8|2) : ;;
    # 007 (T402; Y:5727; spec:688): busy and in doubt refuse; 69 stays a
    # note. After step 4, so the refusal gives the name back (lane 3's ruling
    # 6747281902, T402 item 5).
    75 | 3) ls_late_refuse "$LANES_EDIT lane-transcript $LANE" "$paused_rc" "the resume id in lane ${LANE}'s last PAUSED record" ;;
    *) note "$LANES_EDIT lane-transcript $LANE failed (exit $paused_rc) — carrying on without the last PAUSED record's exact resume id" ;;
  esac
fi

# ---- THE LAUNCHER TABLE (Amendment 17(c)) -------------------------------
#
# ONE BRANCH PER AGENT, and a name this table does not carry is a REFUSAL that
# names the ones it does — never a guess at an argv nobody has tested. The
# table is deliberately short: `claude`, whose three cases are Amendment 6's
# and are unchanged below, and `codex`, which takes its first prompt
# positionally as `claude` does. A third agent is a row here and a test beside
# it, and nothing else.
if [ "$AGENT" != claude ]; then
  case "$AGENT" in
    codex)
      # THE LAUNCHER IS ON PATH, OR NOTHING IS WRITTEN (Copilot round 3 on
      # openRepoTools#47). The row, the object log and the Rule 3 stamp are all
      # written BEFORE the `exec` at the foot of this command, so a `codex` this
      # workstation does not have records the lane as RESUMED and then exits
      # 127 — a false transition in two append-only files that a person has to
      # repair by hand. The check is here, in 5a, which is before every write.
      command -v "$AGENT" >/dev/null 2>&1 ||
        die "this command's launcher table knows '$AGENT', and this workstation has no '$AGENT' on PATH. Nothing was written: the row, the object log and the handoff's Rule 3 stamp are all written before the launch, and a lane recorded as RESUMED by a launch that exits 127 is a false transition in two append-only files. Install it, or name an agent this workstation has: $prog --agent <name> …" 2
      # `codex` KEEPS NO ID THIS COMMAND CAN PASS: it prints its own resumable
      # id where it has one, so the lane's record carries whatever the last
      # handoff wrote (`transcript <id>`) and the session's own first act
      # corrects it. The top block is delivered positionally, which is the one
      # thing both agents in this table have in common.
      step "agent $AGENT — launching it with this lane's handoff top block as its first prompt (Amendment 17(c))"
      cmd=("$AGENT")
      lane_verb=RESUMED; lane_sid=unknown; first_prompt=1 ;;
    *)
      die "this command has no launcher for the agent '$AGENT'. It knows: claude (resume by id where its transcript is here, else a named new session with the handoff's top block as its first prompt) and codex (the top block as its first prompt). A lane is resumed by an agent whose launch this command has been taught and tested — never by a guessed argv (Amendment 17(c))." 2 ;;
  esac
elif [ -n "$bind_sid" ]; then
  # THE BINDING MODE STAMPS THE ID BEING BOUND (openRepoTools#70), and it is
  # decided FIRST, ahead of every branch that reads where a transcript is: the
  # session is running in this window, so which directory holds its file is not
  # a question this run has to answer, and the title and new-session branches
  # would stamp `unknown` or a minted id for a conversation that is plainly
  # here. Step 3b has already put this uuid at the end of the cell (or found it
  # there), and the 18(h) count for it was made at the window-binding call. The
  # command is the exact resume of that id — printed, never run, since --bind
  # comes only with --no-launch — which is what the next `lane-start` resumes.
  step "--bind: lane $LANE is bound to $win_sid, the session live in this window — the row's stamp, the lane's log line and the handoff's Rule 3 stamp name it"
  cmd=("$CLAUDE_BIN" --name "$LANE" --resume "$win_sid")
  lane_verb=RESUMED; lane_sid="$win_sid"
elif [ -n "$resume_sid" ] && [ -n "$rec_file" ]; then
  # AMENDMENT 18(h), AND THIS IS THE ONLY LAUNCH BRANCH WITH AN ID TO COUNT
  # (`main`, #52). The clause is *"the id it is about to resume or bind"*: this
  # branch is the one that resumes an id, and the count is asked INSIDE it
  # rather than above, because above it the row's id is merely a candidate —
  # act 6's search on the lines above is what decides whether anything resumes
  # it at all, and counting the holders of a transcript nobody is about to open
  # would refuse a lane for a fact about a conversation it is not going to
  # touch. The title-fallback branch resumes through the PICKER, whose
  # transcript is not knowable here, and the new-session branch MINTS a fresh
  # uuid; neither has an id, which is stated rather than left to be noticed.
  # AND THE HARNESS'S OWN FENCE IS ASKED ON BOTH SIDES OF THAT TEST, because it
  # is the one rule that still bites when the id IS this window's session: the
  # `bg` companion of a live session carries its id, and `claude --resume` stops
  # on a companion. `resume-here` asks that and nothing else — the duplicate
  # count for this id was already made at the window-binding call above.
  #
  # ONLY WHERE AN `exec` IS ABOUT TO HAPPEN. `--no-launch` and `--dry-run` open
  # no transcript and hand the harness nothing, so the harness's refusal is not
  # theirs to inherit — and AMENDMENT 8 RULING (g) IS EXPLICIT about the shape
  # that would otherwise break: a `bg` companion is one session seen twice and
  # NEVER refuses the lane to the window its own session is running in, which is
  # exactly what a `--no-launch` binding act in that window is. 18(h)'s count is
  # asked in both, unchanged, because an id a second process holds is one this
  # run must not WRITE DOWN either.
  ls_rules=bind
  if (( ! no_launch )) && (( ! dry_run )); then ls_rules=resume; fi
  if [ "$resume_sid" != "$win_sid" ]; then
    dup_check "$resume_sid" "resume transcript $resume_sid as lane $LANE" "$ls_rules"
  elif [ "$ls_rules" = resume ]; then
    dup_check "$resume_sid" "resume transcript $resume_sid as lane $LANE" resume-here
  fi
  if [ -n "$restored_sid" ]; then
    step "the recovered resume session is $resume_sid and its transcript is here ($(basename -- "$rec_file")) — resuming it by id"
  else
    step "the row's current session is $resume_sid and its transcript is here ($(basename -- "$rec_file")) — resuming it by id"
  fi
  (( holder_here )) && step "  (it is the session live in this window; --resume attaches to the same conversation)"
  cmd=("$CLAUDE_BIN" --name "$LANE" --resume "$resume_sid")
  lane_verb=RESUMED; lane_sid="$resume_sid"
elif (( fresh )) || (( AGENT_EXPLICIT )); then
  # `--agent claude` WITH NO TRANSCRIPT HERE, and the `/ctx` respawn: a NAMED
  # NEW SESSION, with the handoff's top block as its first prompt. It skips the
  # title fallback deliberately — a caller that named an agent, or a context
  # clear that has just written a fresh top block, is asking for a new session
  # of this lane and not for a picker filtered by a title.
  step "agent claude — a new session named for the lane, with this lane's handoff top block as its first prompt$fresh_why"
  cmd=("$CLAUDE_BIN" --name "$LANE")
  lane_verb=RESUMED; lane_sid=unknown; first_prompt=1
  if [ -n "$harness_sid" ]; then
    note "the live session in this window ($harness_sid) is not resumed by this launch: a first prompt is delivered to a session that has none. The cell still records the session that is in the window."
  elif [ "${LANE_START_SESSION_ID:-1}" != 0 ]; then
    if new_sid="$(new_uuid)"; then
      while recorded_transcript "$new_sid" >/dev/null 2>&1; do new_sid="$(new_uuid)"; done
      cmd+=(--session-id "$new_sid")
      lane_sid="$new_sid"
      step "minted session id $new_sid — the row will carry it, so the next $prog resumes it by id"
    else
      new_sid=""
      note "no uuid source (/proc/sys/kernel/random/uuid, uuidgen): the new session's own first act must stamp its id on the row"
    fi
  fi
elif titled="$(titled_transcript)"; then
  transcript="${titled%%$'\t'*}"; found_title="${titled#*$'\t'}"
  [ -n "$row_sid" ] && note "the row's last session id $row_sid has no transcript for this directory — falling back to the title"
  step "a transcript here carries the title '$found_title' ($(basename -- "$transcript")) — resume beats new"
  # THREE ANSWERS, NOT TWO (Amendment 15). A title that is not the lane's own
  # spelling is now one of two different facts, and they have different cures: a
  # dedupe suffix means ANOTHER holder was live when this one was renamed, and a
  # title differing only by CASE means this is the lane's own transcript under
  # the spelling it was launched with before the row's became canonical. Telling
  # a person to retire stale holders for the second would send them hunting a
  # collision that never happened.
  if [ "$found_title" != "$LANE" ]; then
    if [ "$(printf '%s' "$found_title" | tr 'A-Z' 'a-z')" = "$(printf '%s' "$LANE" | tr 'A-Z' 'a-z')" ]; then
      note "  that title spells this lane in another case, which is the SAME lane (Amendment 15): the window and the launch take the register row's spelling, $LANE"
    else
      note "  that title carries a dedupe suffix, so another holder of '$LANE' was live when it was renamed: retire the stale holders (lane-end --retire, or retitle them '<lane> · retired <date>') and end idle background sessions still holding the name"
    fi
  fi
  note "  '--resume $LANE' FILTERS THE PICKER, it does not resume exactly: pick the lane's own session, then put its id in the row's session cell"
  (( holder_here )) && step "  (that session is the one live in this window; --resume attaches to the same conversation)"
  cmd=("$CLAUDE_BIN" --name "$LANE" --resume "$LANE")
  # The picker decides which transcript this is, so the id is NOT KNOWABLE
  # here — and the line says so rather than naming the row's last id, which is
  # an id whose transcript this directory does not even have (that is why this
  # branch was reached). Writing it would put a session uuid on a RESUMED that
  # belongs to a different conversation, in a file nothing rewrites. `unknown`
  # is the grammar's own word for an id nobody has; the session stamps the row
  # with its real one as its first act (Amendment 6(c)).
  lane_verb=RESUMED; lane_sid=unknown
else
  step "nothing here to resume for $LANE — a new session takes the name"
  cmd=("$CLAUDE_BIN" --name "$LANE")
  # A NEW SESSION IS NEVER ATTRIBUTED TO THE OLD ONE. With minting turned off
  # (LANE_START_SESSION_ID=0), or with no uuid source at all, there is no id to
  # write — and an empty LANES_SESSION makes the helper fall back to the LAST id
  # in the row's cell, which is the session that has ENDED. The row itself is
  # left reading `pending — set by the session's first act` in that case, so the
  # log said one thing and the row another about the same act.
  lane_sid=unknown
  if [ -n "$harness_sid" ]; then
    # Nothing is minted: the row is about to name the session that is really in
    # this window, and minting a second id beside it would give the lane two
    # answers to "which session is this". The launch still takes a new session —
    # this branch was reached because the live one has no transcript in this
    # directory and cannot be resumed by id — and it is not attributed to the
    # other one, which is what `unknown` says.
    note "the live session in this window ($harness_sid) has no transcript in this directory, so it cannot be resumed by id. A new session takes the name and nothing is minted; the cell still records the session that is in the window."
  elif [ "${LANE_START_SESSION_ID:-1}" != 0 ]; then
    if new_sid="$(new_uuid)"; then
      while recorded_transcript "$new_sid" >/dev/null 2>&1; do new_sid="$(new_uuid)"; done
      cmd+=(--session-id "$new_sid")
      lane_sid="$new_sid"
      step "minted session id $new_sid — the row will carry it, so the next $prog resumes it by id"
    else
      new_sid=""
      note "no uuid source (/proc/sys/kernel/random/uuid, uuidgen): the new session's own first act must stamp its id on the row"
    fi
  fi
fi
cmd+=(${pass[@]+"${pass[@]}"})

# THE CLAUDE CODE TO START (opensoft/workBenches#119), once the agent and the
# launch are known. Resolution already ran before the binding handoff and
# first stateful act; use that selected path when building the final command.
if [ "$AGENT" = claude ]; then
  cmd[0]="$CLAUDE_BIN"
fi

# A LANE WITH NO ROW IS A `STARTED`, WHATEVER BRANCH LAUNCHED IT (Copilot round
# 1 on openRepoTools#47). Two branches above set the verb to RESUMED because
# they are resuming a lane that PAUSED — `--agent <name>` and the `/ctx` seam —
# and both are reachable for a lane the register has never carried, where
# `add-row` is about to write the first row and the object log has no line at
# all. A `RESUMED` opening that log is a line no reader can pair with a start,
# in a file nothing rewrites.
if [ "$row_count" = 0 ] && [ "$lane_verb" = RESUMED ]; then
  lane_verb=STARTED
  step "this lane has no row yet, so the record of this launch is a STARTED (there is nothing to have resumed)"
fi

# IS THERE A TRANSCRIPT UUID TO NAME AT ALL? (Amendment 8(d), R-A8-2.) Computed
# HERE, with the launch decision that produced `lane_sid`, because three later
# sections read it: the row's stamp (5), the object-log line (5b) and the
# handoff's Rule 3 stamp (5c). It used to be computed between the first two,
# which left the first reading a variable the last two shared.
# Reserve this attempt's transcript before row, log or handoff mutation.
if [ "$ri_active" = 1 ] && (( ! no_launch )) && (( ! dry_run )); then
  [ -n "$lane_sid" ] && [ "$lane_sid" != unknown ] || die "the restart has no prepared transcript. Nothing was written." 2
  LANES_NO_FETCH=1 "$LANES_EDIT" set-restart-intent "$LANE" starting \
    --expect 'pending|starting' --expect-operation "$ri_op" \
    --expect-generation "$ri_gen" --expect-attempt "$ri_attempt" \
    --expect-new-transcript none --new-transcript "$lane_sid" --reason 'transcript reserved before preservation writes' >/dev/null ||
      die "this restart attempt lost ownership before preservation writes. Nothing was launched." 2
fi

lane_sid_known=0
[[ "$lane_sid" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] && lane_sid_known=1

# WHO THE TWO STAMPS NAME (Amendment 17(c)). For `claude` it is the uuid and
# nothing else — `RESUMED by <uuid>`, the line Amendment 6(c), Amendment 8(d),
# this file's own header and the manual all quote. For another agent it is
# `<agent> <id>`, and `pending` where that agent's id is not knowable until it
# prints one: the STATE cell and the handoff are histories of acts, and an act
# that happened with an id nobody has yet is still an act that happened.
stamp_who="${lane_sid:-unknown}"
stamp_ok="$lane_sid_known"
if [ "$AGENT" != claude ]; then
  stamp_who="$AGENT ${AGENT_ID:-pending}"
  stamp_ok=1
fi

# ------------- 4a. what the last session left (opensoft/openRepoTools#91)
#
# THE RECONCILIATION IS PRINTED BEFORE ANYTHING IS WRITTEN, and it REFUSES
# NOTHING. A lane recorded `RUNNING` with no live holder stopped ungracefully —
# nothing was polled, refreshed or recorded — and one recorded `SWAPPING` with
# no live holder was interrupted MID-HANDOFF, where some of the three writes
# may have landed and some may not. Either way there may be worktrees carrying
# dirty or unpushed work, and the one thing this command must not do is start a
# session that writes over them in ignorance.
#
# IT IS HERE, ABOVE SECTION 5, because the `STARTED`/`RESUMED` line this run is
# about to write takes the lane to `RUNNING` — so a report printed after it
# would describe this launch rather than the crash it is recovering from.
#
# IT IS A REPORT AND NOT A GATE. `resume` RESETS NOTHING and `park` CREATES
# NOTHING (AGENTS.md rule 1); this prints what differs and names the act, and
# every refusal this command makes is the one it already made. A helper that
# predates the read (exit 2) and a lane with no snapshot (exit 8) are both
# silent — Amendment 7(i)'s cutover rule: nothing is backfilled.
if (( ! dry_run )); then
  lrec_out=""; lrec_rc=0
  lrec_out="$(LANES_NO_FETCH=1 "$LANES_EDIT" lane-reconcile "$LANE" 2>/dev/null)" || lrec_rc=$?
  case "$lrec_rc" in
    0)
      lrec_verdict="$(printf '%s\n' "$lrec_out" | awk -F'\037' '$1 == "VERDICT" { print $2 " — " $3; exit }')" || lrec_verdict=""
      # A RESUMABLE LANE IS QUIET ONLY WHEN ITS TREES ARE (Codex on ec9847e,
      # PR #97): `resumable` says the swap completed, not that every tree it
      # left is clean, published and where it was. So a resumable lane whose
      # TREES line counts anything dirty or unpushed, needing recovery, or
      # unmanaged or stale is reported like any other verdict.
      lrec_attn="$(printf '%s\n' "$lrec_out" | awk -F'\037' '$1 == "TREES" { split($3, a, " "); split($4, b, " "); split($5, c, " "); print a[1] + b[1] + c[1]; exit }')" || lrec_attn=""
      lrec_quiet=0
      case "$lrec_verdict" in
        running*|closed*|'') lrec_quiet=1 ;;
        resumable*)
          if [ "${lrec_attn:-0}" = 0 ]; then lrec_quiet=1
          else lrec_verdict="$lrec_verdict — and its trees below need reading before a writer is relaunched"
          fi ;;
      esac
      if [ "$lrec_quiet" = 0 ]; then
          note "LANE RECOVERY: $lrec_verdict"
          printf '%s\n' "$lrec_out" | awk -F'\037' '
            $1 == "STATE" { printf "  state    %s (%s, %s)\n", $2, $3, $4 }
            $1 == "HOLDER" { printf "  holder   %s %s\n", $2, $3 }
            $1 == "BINDING" && $2 != "here" && $2 != "free" { printf "  binding  %s %s\n", $2, $3 }
            $1 == "TREE" && $3 != "ok" { printf "  tree     %-18s %s\n", $3, $5 }
            $1 == "TREES" { printf "  trees    %s, %s, %s, %s\n", $2, $3, $4, $5 }' >&2 || :
          note "Nothing here was reset, recreated or deleted. Read it in full with: $LANES_EDIT lane-reconcile $LANE"
      fi ;;
    2 | 8) : ;;
    *) note "the lane recovery read failed (\`$LANES_EDIT lane-reconcile $LANE\` exited $lrec_rc). That is NOT 'this lane stopped cleanly' — a read that failed is never an answer (Amendment 7(d)). This launch goes on; run it by hand to see what it says." ;;
  esac
fi

# ------------------------------------------------------------- 5. the row

utc="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
started="$(date -u +%Y-%m-%dT%H:%MZ)"
today="$(date -u +%Y-%m-%d)"
# THE WORKSTATION COLUMN HAS ONE READER, AND NOW ONE SPELLING (A9 Addendum 4,
# R-A9-13). `lanes-edit.sh:438` computes this very cell as
# `${LANES_WORKSTATION:-$(hostname -s)}` and has since Amendment 6; this file
# computed it as a bare `hostname`, which honours no seam and, on any host
# whose `hostname` is a FQDN, writes `eagle.local` into a column every reader
# compares against `eagle`. Two spellings of one column are two answers. The
# seam is also what makes the moved suite runnable anywhere: its 55 seed rows
# spell the column `Eagle`, so before this it was green on a workstation
# literally named Eagle and on no other machine, GitHub's runners included.
ws_pair="$(lanes_workstation_pair)"
ws="${ws_pair%%	*}"
ws_why="$(lanes_workstation_why "${ws_pair##*	}")"
# A CONTAINER WITH NO CONFIGURED WORKSTATION WRITES NOTHING (Amendment 11,
# decision 8(d), `R-A11-14`). `$ws` goes into the row's workstation column, into
# the row's stamp and into the `session <uuid>@<ws>` of every event line this
# run writes — and `opensoft/brett-wip` `origin/main` already carries six log
# lines naming a container id, in a file nothing rewrites. The refusal is here,
# BEFORE the row and before the log, rather than at each of the three writes.
[ -z "$ws_why" ] || die "$ws_why" 2
env_name="$(basename -- "$CLAUDE_HOME")"
case "$env_name" in .claude|claude) env_name=default ;; esac
# THE AGENT'S OWN SPELLING IN THE ROW'S SESSION CELL (Amendment 17(c)): *"the
# row's session cell keeps its history as Amendment 6 has it; its entries
# already carry the agent's kind (`harness <uuid>`, `Codex <id>`)"*. The
# register has spelled Codex sessions that way since 2026-09-05, so the table
# is the register's own and not a new convention.
# --- BEGIN shared one-line cut (lane-collision-protocol Amendment 13(a)) ---
# BYTE-IDENTICAL IN `lane-start`, `lane-end` AND `lane-handoff`, the three
# commands that write a row's state cell — the same trade the four lane helpers
# already make for their workspace resolver, and for the same reason: a drifted
# copy is TWO ANSWERS to one question, and "what may this line contain, and
# where may it be cut" is one question.
#
# FOUR THINGS THE CELL'S LINE MAY NOT CARRY, and `set-row-state` REFUSES all
# four — which would cost the row its stamp or its closing write, so they are
# fixed here rather than met there:
#
#   ` · `  the phrase's own separator. A second one reads back as a fourth part
#          of `<STATE> · <UTC> · <one line>`; it is spelled `; `.
#   `|`    a cell boundary in a Markdown table row. A launch command or a
#          directory may legitimately hold one — `claude --flag 'a|b'`, a path
#          with a pipe in it — and the row is where it would forge a column
#          (Copilot round 1 on openRepoTools#82). It is spelled `¦`, the broken
#          bar, which is not a separator anywhere here; the object log's own
#          line keeps the character itself.
#   CR/LF  a row is ONE LINE of a table, so a newline in this text would split
#          it in two and every row after it would be read as a lane. Spelled
#          `; ` for the same reason the separator is (Copilot round 2).
#   >240   ratified decision O1's cap. Cut at 230 with the last partial WORD
#          dropped, which is what makes the cut safe: `${s:0:n}` counts BYTES
#          wherever the locale is not a UTF-8 one, and a byte offset can land
#          inside the very characters above. 230 and not 240, so the ` ...`
#          marker fits inside the cap however the two count.
cut_to_line() {   # <line> — the row's one line, safe to hand to set-row-state
  ctl="${1//$'\r'/ }"
  ctl="${ctl//$'\n'/; }"
  ctl="${ctl// · /; }"
  ctl="${ctl//|/¦}"
  [ "${#ctl}" -gt 230 ] || { printf '%s' "$ctl"; return 0; }
  ctl="${ctl:0:230}"
  case "$ctl" in *' '*) ctl="${ctl% *}" ;; esac
  printf '%s ...' "$ctl"
}
# --- END shared one-line cut ---

AGENT_WORD="$AGENT"
case "$AGENT" in
  claude) AGENT_WORD=harness ;;
  codex)  AGENT_WORD=Codex ;;
esac
user="$(id -un)"
handoff="handoffs/$estate/session-handoff-$today-lane-$LANE.md"

# The session cell of a NEW row names the session that is about to run,
# whenever one was minted — that is the whole point of minting it. And where a
# session is ALREADY live in this window (step 3b) the cell names THAT one: a
# lane bound to a running window mid-session is the ordinary shape of
# `--no-launch`, and a row minting a fresh uuid beside a conversation that is
# already there would name a session nobody will ever be in.
harness_cell="harness $harness_sid (transcript uuid; profile ${win_profile:-unknown})"
if [ -n "$harness_sid" ]; then
  session_cell="$harness_cell — live in this window, recorded by $prog $utc"
elif [ -n "$new_sid" ]; then
  session_cell="harness \`$new_sid\` (minted by $prog, $utc)"
else
  session_cell="pending — set by the session's first act"
fi

# AMENDMENT 23 S1 (slice 2b) — THE LANE'S OWN CHECKOUT IS MADE HERE, before the
# row, under the opt-in and the default resolution: the first write needs it,
# and every write below goes through it. A dry run plans it and makes nothing.
# A checkout that could not be made, or whose creation lock is held, is SAID.
# Under a base `<act-id>@files` this alone does not refuse the launch (Amendment 8(d)): each write
# below makes it again, or says for itself that it did not go through, and a
# resume's refused `start-record` is a note (S3; ERR-56). UNDER A SEQ BASE THE
# NOTE DOES NOT SAY THAT THE LAUNCH GOES ON (ERR-56; lane 3, #165 6867981064):
# on primary a write makes no clone (D12), so each write below refuses without
# the checkout, with nothing sent (R17, `pw_checkout`), and there any 2 of
# `start-record`'s stops the launch.
if [ "$LS_ROUTED" = 1 ]; then
  if (( dry_run )); then
    plan "$LANES_EDIT lane-checkout $LANE --create"
  else
    lsc_rc=0
    "$LANES_EDIT" lane-checkout "$LANE" --create >/dev/null || lsc_rc=$?
    if [ "$lsc_rc" != 0 ]; then
      case "$LANES_ACT" in
        *@files)
          note "lane $LANE's own register checkout could not be made (\`$LANES_EDIT lane-checkout $LANE --create\` exited $lsc_rc, above). This alone does not refuse the launch: each write below makes it again, or says for itself that it did not go through (Amendment 23 S1, 8(d))." ;;
        *)
          note "lane $LANE's own register checkout could not be made (\`$LANES_EDIT lane-checkout $LANE --create\` exited $lsc_rc, above). Under this launch's seq base a write makes no clone (D12), so each write below refuses without the checkout, with nothing sent, and says so in its own words (R17; ERR-56)." ;;
      esac
    fi
  fi
fi

# FEATURE 007, T428 - THE BIND IS ONE WRITE, `start-record` (FR-025; "The bind
# as one verb", design Y:5521-5555; spec:317-318). The row (W1), or the
# session-cell appends (W2 to W5) and the state (W6), with the STARTED or
# RESUMED line (W7), are ONE call of `lanes-edit.sh start-record`: one commit
# and push in files mode, one transaction on primary, and the partial states
# three commits left between them go away. This section collects the parts;
# 5b makes the call once the log line's payload is known. Where no transcript
# uuid is knowable (`lane_sid_known` is 0) there is no log line to write
# (Amendment 7(b)), and `start-record` takes none, so the row's writes stay the
# separate verbs they were, each with its own expectations.
#
# THE EXPECTATIONS (Y:5648-5656; FR-029): each write names, as a prefix on its
# own call, the scopes its deciding reads stand for, under the act's base. The
# one call carries their union: the lane's row, its binding lines, the names
# `canon-lane` walked (`row:` and `alias:`), its archive rows under both their
# spellings, every session uuid it writes, and the window's own row where a
# read of the window's name decided something. In files mode no write reads
# them; on primary a scope another place changed after the base refuses the
# write with 2, with nothing written.
LS_SR_ONE=0
(( ! lane_sid_known )) || LS_SR_ONE=1
LS_SR_ROW=""; LS_SR_STATE=""; LS_SR_CELLS=(); LS_SR_PLAN=(); LS_SR_SIDS=()
LS_EXPECT=""
# LS_D8, the text for a write that exited 3, is defined above W8 (T433's form).
ls_scope_add() {   # <scope>: appended to LS_EXPECT once, in lower case
  lsa_s="$(printf '%s' "$1" | tr 'A-Z' 'a-z')"
  case " $LS_EXPECT " in *" $lsa_s "*) return 0 ;; esac
  LS_EXPECT="${LS_EXPECT:+$LS_EXPECT }$lsa_s"
  return 0
}
ls_lane_shaped() {   # <name>: 0 where `check_lane_name` would take it
  case "${1-}" in "" | *[!A-Za-z0-9._-]* | .* | -*) return 1 ;; esac
  return 0
}
# THE ARCHIVE'S SECOND SPELLING (Y:5625): `RETIRED_ROWS_AWK`'s `key()`, in
# bash. The part after the last `-`, with one trailing letter dropped, must
# be digits; the key is the head, lower-cased, `-`, and that number with its
# leading zeros removed (`0` stays `0`). Nothing where there is no key.
ls_archive_key() {   # <lane>
  lak_h="${1%-*}"; lak_p="${1##*-}"
  [ "$lak_h" != "$1" ] || return 0
  case "$lak_p" in *[A-Za-z]) lak_p="${lak_p%?}" ;; esac
  case "$lak_p" in "" | *[!0-9]*) return 0 ;; esac
  while [ "${#lak_p}" -gt 1 ] && [ "${lak_p#0}" != "$lak_p" ]; do lak_p="${lak_p#0}"; done
  printf '%s-%s\n' "$(printf '%s' "$lak_h" | tr 'A-Z' 'a-z')" "$lak_p"
}
ls_expect_for() {   # <1: the archive keys> <1: the window's row> [<session uuid>…]; sets LS_EXPECT
  lef_arch="$1"; lef_win="$2"; shift 2
  LS_EXPECT=""
  ls_scope_add "row:$LANE"; ls_scope_add "bind:$LANE"; ls_scope_add "alias:$LANE"
  if [ "$lef_arch" = 1 ]; then
    ls_scope_add "archive:$LANE"
    lef_k="$(ls_archive_key "$LANE")"
    [ -z "$lef_k" ] || ls_scope_add "archive:$lef_k"
  fi
  while IFS= read -r lef_n; do
    ls_lane_shaped "$lef_n" || continue
    ls_scope_add "row:$lef_n"; ls_scope_add "alias:$lef_n"
  done <<LS_WALK_NAMES
$LS_WALK
LS_WALK_NAMES
  for lef_s in "$@"; do
    if [[ "$lef_s" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
      ls_scope_add "sid:$lef_s"
    fi
  done
  if [ "$lef_win" = 1 ] && [ "$LS_WIN_ROW_READ" = 1 ] && ls_lane_shaped "$this_window_name"; then
    ls_scope_add "row:$this_window_name"
  fi
  return 0
}

if [ "$row_count" = 0 ]; then
  # AMENDMENT 13(a) — A NEW ROW IS BORN IN THE PHRASE. The state cell opened
  # with the bare word `STARTING` for as long as the cell was a diary; it is one
  # phrase now — `<STATE> · <UTC> · <one line>` — and a row created outside that
  # shape is a row the first `set-row-state` would be the only thing to fix.
  # `LIVE` is the state, because this row is written by the act that takes the
  # lane live in this window, and the line says which act and on which
  # workstation.
  new_line="$lane_verb by $stamp_who (lane $LANE) — lane-start on $ws: row created"
  new_state="LIVE · $utc · $(cut_to_line "$new_line")"
  new_row="| \`$LANE\` | $session_cell | $ws / $env_name / $user | $started | none | $handoff | $new_state |"
  if (( LS_SR_ONE )); then
    # W1, carried by the one call at 5b (T428): `start-record --add-row`.
    LS_SR_ROW="$new_row"
    LS_SR_PLAN+=("lanes-edit.sh add-row" "  $new_row")
    LS_SR_SIDS+=("$harness_sid" "$new_sid")
  elif (( dry_run )); then
    plan "lanes-edit.sh add-row"
    plan "  $new_row"
  else
    # THE SAME RULE AS THE STAMP ONE SCREEN DOWN, and the opposite ANSWER. A
    # bare command under `set -e` dies with the helper's own code and no
    # sentence of its own; this one is read. But a lane with no ROW is not a
    # lane with an unwritten stamp — every other lane's liveness read, every
    # crossing check and the next `lane-start` all key on that row — so this is
    # a refusal that says so, before the window is anything but renamed.
    # W1's expectations, alone (T428; Y:5650): no log line rides with it here.
    ar_rc=0
    ls_expect_for 1 1 "$harness_sid" "$new_sid"
    LANES_LANE="$LANE" LANES_EXPECT="$LS_EXPECT" "$LANES_EDIT" add-row "$new_row" || ar_rc=$?
    if [ "$ar_rc" = 0 ]; then
      step "row added"
    else
      # THE TEXTS FOR 3, AND THE WRITER'S RERUN (T428; D8; Y:5698-5699).
      case "$ar_rc" in
        3) die "the register row for $LANE MAY NOT have been added: \`$LANES_EDIT add-row\` exited 3, and it ${LS_D8}. This window has been renamed and nothing has been launched: a lane whose row is in doubt is not started until that is settled." 3 ;;
        # A new row's 69 or 75 under a seq base takes `LS_Q4` below: the arm
        # dies, so "from its start" stands (lane 3's Q41, #165 6780753157).
        69 | 75) ls_q4 "$ar_rc" || die "the register row for $LANE was NOT added (\`$LANES_EDIT add-row\` exited $ar_rc; its own words are above, with the rerun it prints). This window has been renamed and NOTHING else has been written — no session cell, no object log, no launch: a lane with no row is a lane no other lane's liveness read, crossing check or \`lane-start\` can see. Run the writer's printed rerun, or this command again once the register answers." "$ar_rc" ;;
      esac
      ! ls_q4 "$ar_rc" ||
        die "the register row for $LANE was NOT added (\`$LANES_EDIT add-row\` exited $ar_rc under this launch's base; its own words are above). This window has been renamed and NOTHING else has been written — no session cell, no object log, no launch: a lane with no row is a lane no other lane's liveness read, crossing check or \`lane-start\` can see. ${LS_Q4}." "$ar_rc"
      die "the register row for $LANE was NOT added ($LANES_EDIT add-row exited $ar_rc; its own words are above). This window has been renamed and NOTHING else has been written — no session cell, no object log, no launch: a lane with no row is a lane no other lane's liveness read, crossing check or \`lane-start\` can see. Settle that refusal and re-run, or add it by hand:
    LANES_LANE=$LANE $LANES_EDIT add-row '$new_row'" "$ar_rc"
    fi
  fi
else
  # AMENDMENT 8 — THE CELL FIRST, THEN THE STAMP. The harness minted a
  # transcript uuid the published cell does not carry (step 3b), and the stamp
  # below is about to name that uuid: writing the stamp first would leave, for
  # as long as the two commits are apart, a row whose status names a session its
  # own session cell does not — and if the append then refused, for ever. So the
  # cell is extended first, with the same `replace-in-row` and the same anchor
  # discipline the minted case uses below: the anchor is the PUBLISHED last id,
  # which refuses exactly when this checkout's copy of the row is older than the
  # one that landed, and a refusal prints the act rather than corrupting a cell.
  if [ -n "$harness_sid" ]; then
    harness_hint="LANES_LANE=$LANE $LANES_EDIT append-session-id $LANE \"<the session cell's last id>\" \"→ $harness_cell\""
    # THE COMMIT SAYS WHICH ACT THIS WAS: under `--bind` nothing was minted, a
    # person moved a running session here (openRepoTools#70).
    harness_why="session cell: the harness minted $harness_sid for this window"
    [ -z "$bind_sid" ] || harness_why="session cell: bound $harness_sid on the person's choice 2 at the name guard (Amendment 12(h) rule 2)"
    if [ -z "$cell_anchor" ]; then
      note "the row's session cell records no transcript uuid to append to (some rows carry only \`session_…\` footer ids, which are not transcript ids). STAMP IT AS THIS SESSION'S FIRST ACT:"
      note "  $harness_hint"
    elif (( LS_SR_ONE )); then
      # W2, carried by the one call at 5b (T428): `--append-cell`.
      LS_SR_CELLS+=(--append-cell "$cell_anchor" "→ $harness_cell" "$harness_why")
      LS_SR_PLAN+=("lanes-edit.sh append-session-id $LANE '$cell_anchor' '→ $harness_cell'")
      LS_SR_SIDS+=("$harness_sid")
    elif (( dry_run )); then
      plan "lanes-edit.sh append-session-id $LANE '$cell_anchor' '→ $harness_cell'"
    else
      ls_w_rc=0
      ls_expect_for 0 1 "$harness_sid"   # W2's (T428; Y:5652)
      LANES_LANE="$LANE" LANES_EXPECT="$LS_EXPECT" "$LANES_EDIT" append-session-id "$LANE" "$cell_anchor" "→ $harness_cell" "$harness_why" || ls_w_rc=$?
      if [ "$ls_w_rc" = 0 ]; then
        step "session cell updated: $cell_anchor → $harness_sid (the transcript live in this window)"
      elif [ "$ls_w_rc" = 3 ]; then
        note "the session cell's extension with $harness_sid is in doubt (\`append-session-id\` exited 3): it ${LS_D8}. The launch is not refused for it."
      elif ls_q4 "$ls_w_rc"; then
        ls_q41_note "the session cell was NOT extended with $harness_sid (\`append-session-id\` exited $ls_w_rc under this launch's base; its words are above)" "The launch is not refused for it."
      else
        note "the session cell was NOT extended with $harness_sid (this checkout's copy of the row does not carry $cell_anchor exactly once IN ITS SESSION CELL — it may be older than the published one). STAMP IT AS THIS SESSION'S FIRST ACT:"
        note "  $harness_hint"
      fi
    fi
  fi

  # The row is the next launch's first source, so make the exact transcript
  # recovered from the lane's PAUSED record its final entry again. Without
  # this, every subsequent launch would rediscover the same dead row id and
  # need the fallback. This is written before the RESUMED status for the same
  # ordering guarantee as the harness-minted append immediately above.
  if [ -n "$restored_sid" ]; then
    restored_cell="harness \`$restored_sid\` (transcript uuid; restored from the lane's last PAUSED record)"
    restored_hint="LANES_LANE=$LANE $LANES_EDIT append-session-id $LANE \"<the session cell's last id>\" \"→ $restored_cell\""
    if [ -z "$row_sid" ]; then
      note "the row's session cell records no transcript uuid to append the recovered id to. STAMP IT AS THIS SESSION'S FIRST ACT:"
      note "  $restored_hint"
    elif (( LS_SR_ONE )); then
      # W3, carried by the one call at 5b (T428): `--append-cell`.
      LS_SR_CELLS+=(--append-cell "$row_sid" "→ $restored_cell" "session cell: restored $restored_sid from the lane's last PAUSED record")
      LS_SR_PLAN+=("lanes-edit.sh append-session-id $LANE '$row_sid' '→ $restored_cell'")
      LS_SR_SIDS+=("$restored_sid")
    elif (( dry_run )); then
      plan "lanes-edit.sh append-session-id $LANE '$row_sid' '→ $restored_cell'"
    else
      ls_w_rc=0
      ls_expect_for 0 0 "$restored_sid"   # W3's (T428; Y:5652)
      LANES_LANE="$LANE" LANES_EXPECT="$LS_EXPECT" "$LANES_EDIT" append-session-id "$LANE" "$row_sid" "→ $restored_cell" "session cell: restored $restored_sid from the lane's last PAUSED record" || ls_w_rc=$?
      if [ "$ls_w_rc" = 0 ]; then
        step "session cell updated: $row_sid → $restored_sid (the exact transcript from the lane's last PAUSED record)"
      elif [ "$ls_w_rc" = 3 ]; then
        note "the session cell's extension with recovered transcript $restored_sid is in doubt (\`append-session-id\` exited 3): it ${LS_D8}. The launch is not refused for it."
      elif ls_q4 "$ls_w_rc"; then
        ls_q41_note "the session cell was NOT extended with recovered transcript $restored_sid (\`append-session-id\` exited $ls_w_rc under this launch's base; its words are above)" "The launch is not refused for it."
      else
        note "the session cell was NOT extended with recovered transcript $restored_sid (this checkout's copy of the row may be older than the published one). The launch is unaffected and so is the NEXT one: this recovery reads the lane's last PAUSED record and not the cell, so it finds the same transcript again and prints this same act — the row keeps naming an id no transcript answers to until somebody runs it. STAMP IT AS THIS SESSION'S FIRST ACT:"
        note "  $restored_hint"
      fi
    fi
  fi

  # AMENDMENT 8's RULE, FOLLOWED HERE TOO: THE CELL FIRST, THEN THE STAMP
  # (Copilot round 5 on openRepoTools#82). The harness path above says it in
  # those words — the stamp names a uuid, so the cell that carries the uuid is
  # written first — and this path did the opposite: it stamped the minted id and
  # THEN tried to append it, so a refused append left the row's state naming a
  # session its own session cell does not carry. The resume target is the
  # SESSION CELL and nothing else (Amendment 6(b)), so that never resumed the
  # wrong conversation — it resumed the id the register knew — but the row said
  # two things a reader has to reconcile. Written in this order the common path
  # says one thing, and a refused append still prints the act that cures it.
  # An EXISTING row that is about to run a NEW session: append the minted id
  # after the cell's last id, so the next start resumes by id instead of by
  # title. The append is `replace-in-row`, which refuses unless its anchor
  # occurs exactly once in the row — so a failure here is a refusal, never a
  # corruption, and it never fails the launch.
  #
  # THE ANCHOR IS THE PUBLISHED ID AND THE FILE IS THIS CHECKOUT'S, which is a
  # refusal exactly when the two disagree — a stale copy of the row, the case
  # the read above exists for. That is the right way round: appending after the
  # id THIS copy ends on would write a cell that no longer matches the one that
  # landed, and `commit_push`'s rebase would then conflict on the same line. The
  # refusal prints the act instead, and the launch is unaffected.
  if [ -n "$new_sid" ]; then
    stamp_hint="LANES_LANE=$LANE $LANES_EDIT append-session-id $LANE \"<the session cell's last id>\" \"→ harness \\\`$new_sid\\\`\""
    if [ -z "$row_sid" ]; then
      note "the row's session cell records no session id this script can read (some rows carry only \`session_…\` footer ids). STAMP IT AS THIS SESSION'S FIRST ACT:"
      note "  $stamp_hint"
    elif (( LS_SR_ONE )); then
      # W4, carried by the one call at 5b (T428): `--append-cell`.
      LS_SR_CELLS+=(--append-cell "$row_sid" "→ harness \`$new_sid\`" "session cell: $prog minted $new_sid for this window")
      LS_SR_PLAN+=("lanes-edit.sh append-session-id $LANE '$row_sid' '→ harness \`$new_sid\`'")
      LS_SR_SIDS+=("$new_sid")
    elif (( dry_run )); then
      plan "lanes-edit.sh append-session-id $LANE '$row_sid' '→ harness \`$new_sid\`'"
    else
      ls_w_rc=0
      ls_expect_for 0 0 "$new_sid"   # W4's (T428; Y:5652)
      LANES_LANE="$LANE" LANES_EXPECT="$LS_EXPECT" "$LANES_EDIT" append-session-id "$LANE" "$row_sid" "→ harness \`$new_sid\`" "session cell: $prog minted $new_sid for this window" || ls_w_rc=$?
      if [ "$ls_w_rc" = 0 ]; then
        step "session cell updated: $row_sid → $new_sid"
      elif [ "$ls_w_rc" = 3 ]; then
        note "the session cell's stamp with $new_sid is in doubt (\`append-session-id\` exited 3): it ${LS_D8}. The launch is not refused for it."
      elif ls_q4 "$ls_w_rc"; then
        ls_q41_note "the session cell was NOT stamped with $new_sid (\`append-session-id\` exited $ls_w_rc under this launch's base; its words are above)" "The launch is not refused for it."
      else
        note "the session cell was NOT stamped (this checkout's copy of the row does not carry $row_sid exactly once IN ITS SESSION CELL — it may be older than the published one). STAMP IT AS THIS SESSION'S FIRST ACT:"
        note "  $stamp_hint"
      fi
    fi
  fi

  # AMENDMENT 6(c)'s STAMP, WRITTEN HERE. The row's first act after a resume is
  # `RESUMED by <transcript uuid>`, and under Amendment 6(b) that stamp is
  # load-bearing: it is what the NEXT lane-start resumes, so a missed one is not
  # bookkeeping debt, it is a lost lane. It used to be owed to the session that
  # lane-start had just exec'd — which is a stamp nobody writes when the session
  # dies at a usage reset before its first act, the shape this estate hits daily.
  # The verb follows the launch decision, exactly as the object-log line does: a
  # resume is RESUMED and a new session is STARTED, and the uuid is the one this
  # run actually resumes or mints, read from the PUBLISHED row (R33) or from the
  # record live in this window (step 3b).
  # THE TAIL STATES WHAT HAPPENED (Amendment 8(d), F-B5). The old line said
  # `launching <cmd>` unconditionally, so a `--no-launch` run stamped the row
  # with a launch that by definition did not happen — and `--no-launch` is now
  # the PRESCRIBED act twice over in clause (d) (the harness-mint append, and
  # the deferred writes of the title-fallback path), so the defect would have
  # become the common case rather than an edge. The head of the stamp — the
  # part Amendment 6(b) and clause (d) quote, up to and including `lane-start on
  # <ws>:` — is unchanged.
  # AMENDMENT 13(a) — WHAT HAPPENED FIRST, AND THE PLACE IT HAPPENED AFTER IT.
  # The tail used to read `window renamed, dir <dir>, window <ref>, launching
  # <cmd>`, and under a 240-character cap (ratified decision O1) that order puts
  # the ONE FACT THAT IS NOWHERE ELSE — the exact command this run launched —
  # behind two that are recorded twice over: clause (c) writes `dir` and
  # `window` into the lane's own log as sub-fields of this very act's
  # `STARTED`/`RESUMED` line, and Amendment 11's listing prints both as columns.
  # So the launch clause comes first and the two sub-fields follow it, and a
  # line long enough to be cut loses what a reader can look up rather than what
  # they cannot.
  if (( no_launch )); then
    did="window renamed, no launch"
  else
    did="window renamed, launching $(quoted "${cmd[@]}")"
  fi
  did="$did; dir $DIR${record_window:+; window $record_window}"
  # `$stamp_who` is computed with the launch decision above: the uuid for
  # Claude, `<agent> <id>` for any other agent (Amendment 17(c)).
  # AMENDMENT 13(a) — THE STAMP IS THE CELL NOW, not another entry appended to
  # it. The `state` column holds ONE PHRASE, `<STATE> · <UTC> · <one line>`, and
  # `set-row-state` stamps the UTC itself — so this builds the line alone, and
  # the `$utc` this run computed stays where it is still needed (the handoff's
  # Rule 3 stamp and the log line).
  #
  # THE STATE IS `LIVE` EITHER WAY. A launch takes the lane live in this window;
  # `--no-launch` is the recording act of a session that is already in it
  # (Amendment 6(c)), so the lane is live in both branches and the tail says
  # which one happened.
  #
  # AND THE LINE KEEPS `<verb> by <uuid>` WORD FOR WORD, because
  # `row_stamp_is_unknown` reads exactly that pair out of this cell — Amendment
  # 8(e)'s "first cure carries one condition", which tells a wrong lineage from
  # the title fallback. A ` · ` inside the line would read back as a fourth part
  # of the phrase, so it is spelled `; ` here rather than refused at the writer,
  # and a line over the cap is cut rather than costing the row its whole stamp:
  # what will not fit is in the object log, one line along.
  state_line="$lane_verb by $stamp_who (lane $LANE) — lane-start on $ws: $did"
  state_line="$(cut_to_line "$state_line")"
  # AND ITS STATUS IS READ, BECAUSE THIS FILE RUNS UNDER `set -e`. A bare
  # command here is a launch that DIES on the helper's refusal — exit 5, "an
  # edit moved more than one line", straight out of the shell with no sentence
  # of its own and the pane gone before anybody can read the helper's. Measured
  # in this suite: `without --confirm nothing is asked` came back 5, from a row
  # write nobody had asked to be fatal.
  #
  # AND IT IS A NOTE, NEVER A REFUSAL. The row's stamp is the RECORD of a resume
  # and not its licence — the same rule Amendment 6(c) and the handoff's Rule 3
  # stamp already take here — so a stamp that could not be written prints the
  # act that writes it and the lane still starts.
  if (( bind_rerun )); then
    # A RERUN OF `--bind` (step 3b(iii)): the binding already names this window
    # and this uuid, so the row's state is not set a second time.
    step "--bind: a rerun, so the row's state is not set again"
  elif (( LS_SR_ONE )); then
    # W6, carried by the one call at 5b (T428): `--state`.
    LS_SR_STATE="LIVE · $state_line"
    LS_SR_PLAN+=("lanes-edit.sh set-row-state $LANE \"LIVE · $state_line\"")
  elif (( dry_run )); then
    plan "lanes-edit.sh set-row-state $LANE \"LIVE · $state_line\""
  else
    srs_rc=0
    ls_expect_for 1 0   # W6's (T428; Y:5653)
    LANES_LANE="$LANE" LANES_EXPECT="$LS_EXPECT" "$LANES_EDIT" set-row-state "$LANE" "LIVE · $state_line" || srs_rc=$?
    if [ "$srs_rc" = 0 ]; then
      step "row state set: LIVE · $lane_verb by ${lane_sid:-unknown}"
    elif [ "$srs_rc" = 3 ]; then
      note "the row's state cell is in doubt (\`set-row-state\` exited 3): it ${LS_D8}. The launch is not refused for it: the stamp is the record of this act, not its licence."
    elif ls_q4 "$srs_rc"; then
      ls_q41_note "the row's state cell was NOT set (\`set-row-state\` exited $srs_rc under this launch's base; its words are above)" "The launch is not refused for it: the stamp is the record of this act, not its licence."
    else
      note "the row's state cell was NOT set (exit $srs_rc — the helper's own words are above), and the launch is not refused for it: the stamp is the record of this act, not its licence. Set it by hand:"
      note "  LANES_LANE=$LANE $LANES_EDIT set-row-state $LANE \"LIVE · $state_line\""
    fi
  fi

  # AMENDMENT 17(c) — THE CELL, IN THE AGENT'S OWN SPELLING. A launch of an
  # agent that is not Claude mints no transcript uuid and resumes none: the one
  # id it has in hand is the `transcript <id>` the lane's own last handoff
  # recorded (Amendment 17(b)), and the cell is appended with it as the register
  # has spelled such entries since 2026-09-05 — `Codex <id>`.
  #
  # AND NOTHING IS APPENDED WHERE THERE IS NO ID. `pending` in the session cell
  # would be the same defect clause (e) refuses in the session field of a log
  # line: the cell is what Amendment 6(b) resumes from, and a placeholder there
  # is a resume target nobody has. The row's STATE cell still records the act
  # (`RESUMED by codex pending`), because that cell is a history of acts.
  if [ "$AGENT" != claude ] && [ -n "$AGENT_ID" ]; then
    agent_cell="$AGENT_WORD \`$AGENT_ID\`"
    # THE ANCHOR IS THE PUBLISHED ROW'S LAST ID, which is the same anchor the
    # minted-uuid append below uses and for the same reason: `append-session-id`
    # refuses unless it occurs exactly once IN THE SESSION CELL, so a stale copy
    # of the row is a refusal that prints the act rather than a corruption.
    # `$cell_anchor` is NOT it — that variable is set only where a session is
    # live in this window whose uuid the cell lacks (step 3b), which is never
    # the case for a launch of an agent that is not Claude.
    if [ -z "$row_sid" ]; then
      note "the row's session cell records no id to append to, so this launch's $AGENT_WORD id is not in it. STAMP IT AS THIS SESSION'S FIRST ACT:"
      note "  LANES_LANE=$LANE $LANES_EDIT append-session-id $LANE \"<the session cell's last id>\" \"→ $agent_cell\""
    elif (( LS_SR_ONE )); then
      # W5, carried by the one call at 5b (T428): `--append-cell`. The verb
      # appends every cell before the state; the two are different cells.
      LS_SR_CELLS+=(--append-cell "$row_sid" "→ $agent_cell" "session cell: $prog launched $AGENT for this lane")
      LS_SR_PLAN+=("lanes-edit.sh append-session-id $LANE '$row_sid' '→ $agent_cell'")
    elif (( dry_run )); then
      plan "lanes-edit.sh append-session-id $LANE '$row_sid' '→ $agent_cell'"
    else
      ls_w_rc=0
      ls_expect_for 0 0   # W5's (T428; Y:5652): its id is the agent's own, not a uuid
      LANES_LANE="$LANE" LANES_EXPECT="$LS_EXPECT" "$LANES_EDIT" append-session-id "$LANE" "$row_sid" "→ $agent_cell" "session cell: $prog launched $AGENT for this lane" || ls_w_rc=$?
      if [ "$ls_w_rc" = 0 ]; then
        step "session cell updated: $row_sid → $agent_cell"
      elif [ "$ls_w_rc" = 3 ]; then
        note "the session cell's extension with $agent_cell is in doubt (\`append-session-id\` exited 3): it ${LS_D8}. The launch is not refused for it."
      elif ls_q4 "$ls_w_rc"; then
        ls_q41_note "the session cell was NOT extended with $agent_cell (\`append-session-id\` exited $ls_w_rc under this launch's base; its words are above)" "The launch is not refused for it."
      else
        note "the session cell was NOT extended with $agent_cell (this checkout's copy of the row may be older than the published one). STAMP IT AS THIS SESSION'S FIRST ACT:"
        note "  LANES_LANE=$LANE $LANES_EDIT append-session-id $LANE \"<the session cell's last id>\" \"→ $agent_cell\""
      fi
    fi
  fi
fi

# ------------------------------------------- 5b. the lane's own object log
#
# Amendment 7. AFTER the row, because the row is what `who` reads the lane's
# liveness and handoff path out of, and a log line that named a lane with no
# row would point at nothing. It never fails the launch: a lane that cannot
# write its log still starts, and says that it could not.
# SINCE FEATURE 007 (T428) THE LINE AND THE ROW ARE ONE WRITE, made at the
# foot of this section by `start-record`, so the row's arms are the line's:
# a new row's refusal, any 2, and the guard's bind refusing on any code stop
# the launch; a resume's refusal is still a note.

# `owner/repo` out of the lane's own origin. Every URL form the estate uses:
# `git@github.com:owner/repo.git`, `https://github.com/owner/repo`, `ssh://…`.
# It CHECKS its own answer. A remote that is a local path, a mirror or any
# non-GitHub URL does not reduce to `owner/repo`, and recording one as the
# lane's home would be inherited by every `#n` that lane ever writes — and a
# home containing a space writes an event line the log's own parser cannot
# read back. `unknown` is the honest answer and the helper already refuses to
# expand `#n` against it.

origin_url="$(git -C "$DIR" remote get-url origin 2>/dev/null || :)"
home_nwo="$(origin_nwo "$DIR" || :)"
if [ -z "$home_nwo" ]; then
  home_nwo=unknown
  if [ -z "$origin_url" ]; then
    note "$DIR has no 'origin' remote, so the lane's home repo is recorded as 'unknown' — its cross-repo checks will not run until it is known"
  else
    note "$DIR's origin ('$origin_url') does not resolve to a GitHub owner/repo, so the lane's home repo is recorded as 'unknown' rather than as something every '#n' in this lane would inherit"
  fi
else
  # THE HOME IS CANONICAL (Amendment 7, R20). A checkout keeps whatever spelling
  # its `origin` had on the day it was cloned, and this estate has moved a
  # repository between orgs while the register was live: a lane homed on
  # `opensoft/codexFactory` wrote `#5` as an object key that could never collide
  # with another lane's `codeXfactory/codexFactory#5`, so two lanes held one
  # GitHub issue and nothing detected it. `lanes/repos.tsv` is what says the two
  # spellings are one repository, and every OTHER spelling in the tooling goes
  # through it — so this one does too, BEFORE the STARTED line is written, since
  # a home is inherited by every `#n` that lane ever writes.
  home_canon=""; hr_rc=0
  home_canon="$("$LANES_EDIT" resolve-repo "$home_nwo" 2>/dev/null)" || hr_rc=$?
  case "$hr_rc" in
    0)
      if [ -n "$home_canon" ] && [ "$home_canon" != "$home_nwo" ]; then
        step "home $home_nwo resolves through lanes/repos.tsv to $home_canon — recording the canonical spelling"
        home_nwo="$home_canon"
      fi ;;
    8)
      note "lanes/repos.tsv has no row for '$home_nwo', so the lane's home is recorded exactly as its origin spells it. If this repository has ever moved org or is spelled more than one way in the register, add a row to lanes/repos.tsv so every lane keys the same object the same way." ;;
    *)
      note "$LANES_EDIT resolve-repo '$home_nwo' failed (exit $hr_rc) — recording the spelling derived from origin" ;;
  esac
fi
# AMENDMENT 11 CLAUSE (c) — THE LANE'S DIRECTORY, PROFILE AND WINDOW, WRITTEN
# HERE BECAUSE THIS IS THE MOMENT THEY ARE ALL CERTAINLY KNOWN.
#
# `dir` closes Amendment 6's oldest open item by the record rather than by a
# symlink, an environment variable or a manifest: a lane's checkout is known to
# every process that is IN it and to nothing about to start one, so the one
# process that is certainly in it writes it down. `profile` is the second, and
# it is taken from `$CLAUDE_PROFILE_NAME`, which the launcher exports into
# every session it starts (`claude-profile:658`) — today a lane's profile is
# recoverable only from the tmux session name `claude-<profile>-<ts>-<pid>`,
# which act 1's window reuse and any rename destroy and which no record
# carries, so a restart typed anywhere but in the lane's surviving window
# cannot name the profile the launcher needs. `window` is Amendment 8(b)'s,
# gaining its `<@id>` ref.
#
# A LINE WRITTEN BEFORE THIS CLAUSE CARRIES NONE OF THEM, AND A READER THAT
# FINDS NONE SAYS SO RATHER THAN ASSUMING ONE — Amendment 7(i)'s cutover rule.
# So each sub-field is appended only where its value is actually in hand: no
# `$CLAUDE_PROFILE_NAME` is a lane started outside the launcher, and inventing
# `unknown` for it would be the same defect clause (e) refuses in the session
# field.
#
# A SPACE IS THE ONE CHARACTER THAT NEEDS A RULE RATHER THAN A REFUSAL, AND THE
# RULE IS QUOTING. Amendment 7(b) makes the space the separator between several
# refs inside one sub-field — which is exactly what `window`'s two refs rely on
# — so an unquoted `dir $HOME/my projects/x` (unquoted) parses as TWO refs and `lane-dir`
# hands back a truncated path that this script then refuses as "no such
# directory". The writer quotes it; `lane-dir` and every other reader take a
# value opening with `"` as running to its closing `"`, and strip both.
quote_subfield() {
  case "$1" in
    *' '*) printf '"%s"' "$1" ;;
    *)     printf '%s' "$1" ;;
  esac
}
lane_profile="${CLAUDE_PROFILE_NAME:-}"
case "$lane_profile" in
  *', '*|*' — '*|*'; '*|*'"'*)
    note "\$CLAUDE_PROFILE_NAME is '$lane_profile', which contains ', ', ' — ', '; ' or '\"' — the lane's \`profile\` sub-field is left out rather than written unreadable"
    lane_profile="" ;;
esac
lane_payload="home $home_nwo; estate $estate; dir $(quote_subfield "$DIR")"
[ -n "$lane_profile" ] && lane_payload="$lane_payload; profile $(quote_subfield "$lane_profile")"
[ -n "$record_window" ] && lane_payload="$lane_payload; window $record_window"
# `claude <version>`: the Claude Code this launch starts, as claude-current read
# it here or as a launcher's own claude-current handed it on
# (opensoft/workBenches#119). In hand only then, so appended only then, for
# the reason given above; and a version is digits, dots and a tag, so a value
# that is not one is left out rather than written into a line nothing rewrites.
lane_claude_version_re='^[0-9]+\.[0-9]+\.[0-9]+([-+][0-9A-Za-z.+-]+)?$'
if [ "$AGENT" = claude ] && [ -n "$lane_claude_version" ]; then
  if [[ "$lane_claude_version" =~ $lane_claude_version_re ]]; then
    lane_payload="$lane_payload; claude $lane_claude_version"
  else
    note "the Claude Code version '$lane_claude_version' is not x.y.z, so the lane's log line carries no \`claude\` sub-field"
  fi
fi

# AMENDMENT 8(d), R-A8-2 — `unknown` NEVER REACHES THE OBJECT LOG, AND THE RULE
# IS THE CONDITION RATHER THAN THE PATH. Amendment 7(b): the `session` field is
# the transcript uuid and only that. `lane_sid` is the literal `unknown`
# wherever this run has no uuid to name — the title fallback, where the picker
# has not run when the stamps would be written; a session already live in this
# window whose transcript is not in this directory; a run with no uuid source at
# all; `LANE_START_SESSION_ID=0`. The log is APPEND-ONLY, so a line written
# wrong there is wrong for ever, and the grammar's own writer does not write a
# line it cannot fill in. It is not a narrowing of Amendment 7 either: A8
# narrows A7 in exactly one place, clause (b)'s `PAUSED` payload, and not here.
#
# THE ROW'S STAMP STILL CARRIES `unknown`, and that is deliberate: the state
# cell is a history of ACTS, the act happened, and a placeholder there is a
# thing a reader can see. `unknown` never enters the SESSION cell, which is what
# Amendment 6(b) resumes from, and so is never replaced in it.
#
# BOTH DEFERRED RECORDS ARE WRITTEN BY THE FIRST ACT THAT KNOWS THE UUID — the
# session's own `lane-start --no-launch`, which clause (e)'s hook prompts by
# name. That run reads the live record whose tmux target is this window, APPENDS
# that uuid to the session cell through the cell-scoped edit, and only then
# writes this line and the handoff's stamp, both carrying the real uuid.
# (`lane_sid_known` is computed with the launch decision above, which is where
# `lane_sid` is decided and where the row's own stamp first reads it.)
#
# AND THE COMMAND IT PRINTS CARRIES THE AGENT THIS RUN WAS GIVEN
# (opensoft/openRepoTools#72 item 5). `$self_args` is the lane and nothing
# else, so a lane started `--agent codex` — which never has a uuid here, so it
# ALWAYS reaches this line — was handed a first act that dropped the flag, and
# the person who ran it had `lane-agent` choose instead: the agent of the lane's
# last PAUSED, which is whichever agent paused it and not the one now running
# it. `AGENT_EXPLICIT` is 1 for an agent named on the command line and for one
# the record named that is not the default; either way the run that settles
# this one is the same agent's, so it is written down, quoted like every other
# command this file prints. It goes AFTER the lane's own arguments, so the
# `--no-launch <repo> <n>` a reader looks for is still one run of words.
# The line is `ls_defer_line`'s, above, which W2 to W6's notes print too
# where no uuid is known, so the two notes name one command (lane 3's Q65,
# #165 6808141050).
if (( ! lane_sid_known )); then
  note "no transcript uuid is knowable at this instant (the row's stamp says '${lane_sid:-unknown}'), so the lane's $lane_verb log line is NOT written: Amendment 7(b) makes that field a transcript uuid and only that, and the log is append-only. Nor is the handoff's Rule 3 stamp. BOTH are written by the first act that knows the uuid, which is this session's own:"
  note "  $(ls_defer_line)"
elif (( bind_rerun )); then
  # A RERUN OF `--bind` (step 3b(iii)): the binding this run read IS the lane's
  # last lane-kind line, naming this window and this uuid, so the log already
  # carries the act and a second line would count a resume that did not happen.
  step "--bind: a rerun, so the lane's $lane_verb log line is not written again"
else
  # FEATURE 007, T428 - THE ONE CALL: W1, or W2 to W6, with W7, as
  # `start-record`, carrying the union of their expectations (Y:5648-5656)
  # and the act's LANES_ACT. LANES_LANE and LANES_SESSION are the lane and
  # the transcript the line names, as the verb requires (lane 3's rulings 2
  # and 3 on T427, #165 6755005268).
  ls_expect_for 1 1 "$lane_sid" ${LS_SR_SIDS[@]+"${LS_SR_SIDS[@]}"}
  ls_sr=(start-record "$LANE" "$lane_verb")
  if [ -n "$LS_SR_ROW" ]; then
    ls_sr+=(--add-row "$LS_SR_ROW")
    ls_sr_what="lane ${LANE}'s new row and its $lane_verb line"
  else
    ls_sr+=(${LS_SR_CELLS[@]+"${LS_SR_CELLS[@]}"} --state "$LS_SR_STATE")
    ls_sr_what="lane ${LANE}'s state cell, the session-cell entries this run appends, and its $lane_verb line"
  fi
  ls_sr+=(--log "lane:$LANE" '→' "$lane_payload")
  ls_sr_hint="LANES_LANE=$LANE LANES_SESSION=$lane_sid $(quoted "$LANES_EDIT" "${ls_sr[@]}")"
  if (( dry_run )); then
    # TODAY'S PLAN LINES, AS THE PARTS OF THE ONE WRITE, then the call itself.
    plan "lanes-edit.sh start-record $LANE $lane_verb: ONE register write of the parts below, one commit and push in files mode, one transaction on primary (feature 007, T428)"
    for ls_p in ${LS_SR_PLAN[@]+"${LS_SR_PLAN[@]}"}; do plan "$ls_p"; done
    plan "lanes-edit.sh log $lane_verb lane:$LANE → \"$lane_payload\""
    plan "  the call: LANES_EXPECT='$LS_EXPECT' $ls_sr_hint"
  else
    ls_sr_rc=0
    LANES_LANE="$LANE" LANES_SESSION="$lane_sid" LANES_EXPECT="$LS_EXPECT" "$LANES_EDIT" "${ls_sr[@]}" || ls_sr_rc=$?
    # THE ARMS (Y:5539-5544; spec:317-318; the task's "The arms"). Under a
    # seq base any 2 stops the launch, LR010's included: on primary an
    # expectation's 2 is a second binding. A write that must exist, a new
    # row, stops with its code; so does the guard's detached bind on any
    # code, with no stamp, its record ending failed with that code. A
    # resume's write only prints a note: the stamp is written and the launch
    # goes on (2A).
    # UNDER A BASE `<act-id>@files` A RESUME'S 2 IS AMENDMENT 23's REFUSAL
    # (ERR-56; lane 3's ruling on lane 4's cause B, #165 6867981064). Off
    # primary no write reads LANES_EXPECT (Y:5596), so no 2 there is the
    # second binding Y:5542 dies for: it is S1's clone that failed, or S3's
    # refusal or the router's, each with nothing written, and S3 has this
    # script print a note with the command that writes the record later, and
    # "the launch is not refused" (Amendment 23 S3; 8(d)). So the call that
    # makes no row, a resume's, which carries `--state` and no `--add-row`
    # (`LS_SR_ROW` empty, above), takes the `*)` arm's note for a resume's
    # other codes, then the stamp and the launch. A new row's 2 dies in both
    # modes, and so does the guard's bind (`--bind`), whose record still
    # ends `bind-failed`, `rc=2`.
    # THE STRADDLE: a host switched to primary after this act took its base
    # refuses the write with 2, "LANES_ACT was taken off primary ... and this
    # write runs on primary" (`lanes-edit.sh`'s `act_parse --primary`), which
    # is no refusal of S3's. So after an `@files` 2 the base is read again
    # with `act-begin`, as this act's start reads it, and a seq base now dies
    # 2, as the `2)` arm does. A re-read that fails refuses as the act's
    # start does (lane 3's A2, #165 6774499606): 69, 75 and 3 with the code,
    # any other code, and an exit 0 with no line or a malformed one, with 1.
    # Both give this window its name back, as a read refused after step 4
    # does (lane 3's ruling 6747281902, T402 item 5).
    ls_sr_arm="$ls_sr_rc"
    if [ "$ls_sr_rc" = 2 ] && [ -z "$LS_SR_ROW" ] && [ -z "$bind_sid" ]; then
      case "$LANES_ACT" in
        *@files)
          : > "$LS_TMP"
          ls_sr_base=""; ls_sr_base_rc=0
          ls_sr_base="$("$LANES_EDIT" act-begin 2>"$LS_TMP")" || ls_sr_base_rc=$?
          if [ "$ls_sr_base_rc" != 0 ] || ! ls_act_form "$ls_sr_base"; then
            [ -s "$LS_TMP" ] && cat -- "$LS_TMP" >&2
            ls_sr_ask="whether the register is still off primary, after \`$LANES_EDIT start-record\` exited 2 under this launch's base \`$LANES_ACT\` (ERR-56)"
            case "$ls_sr_base_rc" in
              69 | 75 | 3) ls_late_refuse "$LANES_EDIT act-begin" "$ls_sr_base_rc" "$ls_sr_ask" ;;
            esac
            ls_window_name_back
            ls_sr_why="exited $ls_sr_base_rc (its words are above)"
            [ "$ls_sr_base_rc" != 0 ] ||
              ls_sr_why="exited 0 and printed no single line of base, \`<act-id>@files\` or \`<act-id>@<seq>:<generation>\` (Y:5577-5578)"
            ls_sr_hs=""
            [ -z "$ls_rh_wrote" ] ||
              ls_sr_hs=" One line of the handoff stands: ${ls_rh_wrote}, written whole to the append-only log (R-A11-11)."
            die "\`$LANES_EDIT act-begin\`, run again, ${ls_sr_why}, so ${ls_sr_ask} is NOT known, and that is not a base: under a seq base that 2 stops the launch. ${rb_undo}. This launch has written no row, no STARTED or RESUMED line and no stamp, and launched nothing.${ls_sr_hs}" 1
          fi
          case "$ls_sr_base" in
            *@files) ls_sr_arm=a23-refusal ;;
            *) die "lane ${LANE}'s bind was REFUSED: \`$LANES_EDIT start-record\` exited 2 (its words are above), and none of ${ls_sr_what} was written. This launch took its base off primary, \`$LANES_ACT\`, and \`$LANES_EDIT act-begin\`, run again, now answers a seq base, \`$ls_sr_base\`: the register was switched to primary after this launch began, where a write under a base taken off primary is refused with 2, and under a seq base a 2 stops the launch (ERR-56; Y:5542). This window has been renamed to $LANE, and nothing has been launched. No command is printed for the write: run \`$prog\` again from its start, which takes its base on primary (Y:5601)." 2 ;;
          esac ;;
      esac
    fi
    case "$ls_sr_arm" in
      0)
        if [ -n "$LS_SR_ROW" ]; then
          step "row added"
        else
          step "row state set: LIVE · $lane_verb by ${lane_sid:-unknown}"
        fi
        step "object log: $lane_verb lane:$LANE, home $home_nwo"
        step "  (one register write with the row: \`start-record\`)" ;;
      2)
        die "lane ${LANE}'s bind was REFUSED: \`$LANES_EDIT start-record\` exited 2 (its words are above), and none of ${ls_sr_what} was written. A 2 refuses the whole write: on primary a scope this launch read changed after its base, which is another place binding or changing lane $LANE, a SECOND BINDING this launch does not write over; or LR010, a key that is not a scope, or a refusal of the write's own words (spec:317; FR-029). This window has been renamed to $LANE, and nothing has been launched. No command is printed for the write: read the lane (\`$LANES_EDIT binding $LANE\`), then run \`$prog\` again from its start (Y:5601)." 2 ;;
      *)
        # THE TEXTS FOR 3, AND THE WRITER'S RERUN (T428; review M11; D8;
        # Y:5698-5699). On 69, 75 and 3 the writer prints the rerun that
        # settles the write, with its write id and generation where it has
        # one, or says nothing was sent where it has none (T415, T417); this
        # script relays it as printed and prints no command of its own. A 3
        # is in doubt, never "NOT added" or "NOT written".
        if [ -n "$LS_SR_ROW" ]; then
          case "$ls_sr_rc" in
            3) die "the register row for $LANE MAY NOT have been added, with its STARTED line: \`$LANES_EDIT start-record\` exited 3, and it ${LS_D8}. This window has been renamed and nothing has been launched: a lane whose row is in doubt is not started until that is settled." 3 ;;
            # Under a seq base a 69 or 75 takes `LS_Q4` below (Q41).
            69 | 75) ls_q4 "$ls_sr_rc" || die "the register row for $LANE was NOT added (\`$LANES_EDIT start-record\` exited $ls_sr_rc; its own words are above, with the rerun it prints). This window has been renamed and NOTHING else has been written — no session cell, no object log, no launch: a lane with no row is a lane no other lane's liveness read, crossing check or \`lane-start\` can see. Run the writer's printed rerun, or this command again once the register answers." "$ls_sr_rc" ;;
          esac
          ! ls_q4 "$ls_sr_rc" ||
            die "the register row for $LANE was NOT added (\`$LANES_EDIT start-record\` exited $ls_sr_rc under this launch's base; its own words are above). This window has been renamed and NOTHING else has been written — no session cell, no object log, no launch: a lane with no row is a lane no other lane's liveness read, crossing check or \`lane-start\` can see. ${LS_Q4}." "$ls_sr_rc"
          die "the register row for $LANE was NOT added (\`$LANES_EDIT start-record\` exited $ls_sr_rc; its own words are above). This window has been renamed and NOTHING else has been written — no session cell, no object log, no launch: a lane with no row is a lane no other lane's liveness read, crossing check or \`lane-start\` can see. Settle that refusal and re-run, or write it by hand:
    $ls_sr_hint" "$ls_sr_rc"
        fi
        if [ -n "$bind_sid" ]; then
          die "the bind of $bind_sid as lane ${LANE}'s session was NOT made: \`$LANES_EDIT start-record\` exited $ls_sr_rc (its words are above), so no stamp is written and nothing is bound; the guard's record of this bind ends failed with this code (Y:5539-5544)." "$ls_sr_rc"
        fi
        case "$ls_sr_rc" in
          3)
            note "${ls_sr_what} MAY NOT have been written: \`$LANES_EDIT start-record\` exited 3, and it ${LS_D8}. The launch is not refused for it: they are the record of this resume, not its licence (spec:318, 2A)." ;;
          69 | 75)
            # Under a seq base the writer's rerun is not pointed to: the
            # arm names the act without its launch (lane 3's Q39, Q41).
            if ls_q4 "$ls_sr_rc"; then
              ls_q41_note "${ls_sr_what} were NOT written (\`$LANES_EDIT start-record\` exited $ls_sr_rc under this launch's base; its words are above)" "The launch is not refused for it: they are the record of this resume, not its licence (spec:318, 2A)."
            else
              note "${ls_sr_what} were NOT written: \`$LANES_EDIT start-record\` exited ${ls_sr_rc}, and its words above say so, with the rerun it prints: the write id and its generation where the write has one, or that nothing was sent where it has none (spec:318). Run that rerun, not a command of this script's. The launch is not refused for it: they are the record of this resume, not its licence (2A)."
            fi ;;
          *)
            if ls_q4 "$ls_sr_rc"; then
              ls_q41_note "${ls_sr_what} were NOT written (\`$LANES_EDIT start-record\` exited $ls_sr_rc under this launch's base; its words above say what was left)" "The launch is not refused for it: they are the record of this resume, not its licence (spec:318, 2A)."
            else
              note "${ls_sr_what} were NOT written: \`$LANES_EDIT start-record\` exited $ls_sr_rc, and its words above say what was left. The launch is not refused for it: they are the record of this resume, not its licence (spec:318, 2A). Once those words say nothing was written, write them as this session's first act:"
              note "  $ls_sr_hint"
            fi ;;
        esac ;;
    esac
  fi
fi

# THE HANDOFF'S WRITABLE PATH, BESIDE THE ROW'S SPELLING (plan §2.7). The row's
# cell is a spelling a reader can follow, and under the opt-in a person who
# follows it lands in W, where no tool writes (Amendment 23 S5). `handoff-path`
# names the same file in the checkout this lane's writes go through, which is
# where 5c stamps it, where 5d reads the first prompt from, and where a hand
# edit belongs. A read; in a dry run it fetches nothing. READ AFTER 5b (T428):
# a new lane's row is made by 5b's one call, and this read finds it there.
HS_PATH=""
ls_cell="$handoff"
[ "$row_count" != 1 ] || ls_cell="$(cell 7 | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' || :)"
if [ -n "$ls_cell" ]; then
  hsp_rc=0; hsp_nf=0
  (( ! dry_run )) || hsp_nf=1
  HS_PATH="$(LANES_NO_FETCH="$hsp_nf" "$LANES_EDIT" handoff-path "$LANE" 2>/dev/null)" || hsp_rc=$?
  if [ "$hsp_rc" = 0 ] && [ -n "$HS_PATH" ]; then
    step "the lane's handoff '$ls_cell' is written through $HS_PATH"
  else
    HS_PATH=""
    [ "$hsp_rc" = 8 ] || (( dry_run )) ||
      note "where this lane's handoff is written could not be read (\`$LANES_EDIT handoff-path $LANE\` exited $hsp_rc), and a first prompt is read from that file alone, never from W's copy (5d)"
  fi
fi

# ------------------------------------------- 5c. the handoff's Rule 3 stamp
#
# AMENDMENT 8 — LANE-START WRITES THE RULE 3 STAMP. Rule 3 makes the FIRST act
# of a lane resuming from a handoff a stamp on that handoff, in place, before
# it reads any further and before any other act. It was the SESSION's to write,
# and it was missed every time: seven resumes of this lane needed it written by
# hand afterwards, and while it was owed the three records of the same day
# disagreed about how many resumes there had been — the row said six, the
# object log four, the handoff five, about ONE lane on ONE day. Amendment 6(c)
# found exactly this about the row's own stamp and cured it the same way: the
# boundary act that KNOWS the resume writes the record of it, because a stamp
# that is owed is a stamp that is missed.
#
# ON A RESUME OF AN EXISTING ROW, AND NOTHING ELSE. The verb is `$lane_verb` —
# the very one 5a decided for the row's status and 5b's object line — so the
# three can never disagree about whether this was a resume. A brand-new row is
# not a resume of anything: the file its handoff cell names does not exist yet,
# and the session that will write it has not run.
#
# THE INSERT POINT IS RULED: the line immediately after the first blank line
# that follows line 1 — line 1 being the lane header (Rule 4) and the blank the
# end of the header block. That puts THIS resume at the top of the block of
# stamps, above the ones before it.
#
# AFTER 5b, AND THROUGH THE SAME CHECKOUT (Amendment 23, slice 2b). The stamp is
# ONE `lanes-edit.sh write-handoff --stamp`. Under the lock of the checkout
# every write of this lane goes through — its own `<W>-lanes/<lane>/` under the
# opt-in, an explicit `LANES_REPO` in place, W where the opt-in is off — it
# fast-forwards that checkout (S3), reads the row's handoff cell from what it
# fetched and the file in that checkout, splices this line in and proves it
# (this script's own splice, moved there unchanged), replaces the file
# atomically under a restart's fences, commits it by pathspec with the `Lane:`
# trailer and pushes it (S4), replaying the splice on origin's new tip where a
# peer won the race. Its one stdout line is the file it wrote and that file's
# digest. It used to be this script's own: published under W's lock, then
# added, committed, pulled and pushed in W outside any lock (lane
# openRepoTools-3's finding 282, the first of three such writers), and the
# notes that said which later write would push a stranded stamp went with it:
# none does (S3).
#
# AND IT IS NEVER A REASON TO REFUSE THE LAUNCH. A handoff that is not there, a
# checkout S3 refuses, a push that is refused or never confirmed — each one
# prints what was left and the command that finishes the act, and the lane
# still starts. Rule 3's stamp is the RECORD of a resume, not the licence for
# one, and refusing the session would lose the conversation the stamp is about.
# (Rule 3 also says a lane that finds an existing stamp stops and reports. That
# is addressed to the session reading the resume prompt, not to the act that
# records the resume: the file already carries one line per resume and gains
# one more.) THE ONE EXCEPTION IS A SUPERVISED RESTART'S OWN FENCES. The file
# its intent bound is this launch's first prompt, so a write that lost the
# restart's ownership (7), or a bound file that no longer digests as the
# restart bound it, stops the launch here, as it always did.

# The handoff path is field 7 of the PUBLISHED row: the register's header is
# `| lane | session id | workstation / env / user | started (UTC) | objects
# owned | handoff path | state |`, and awk's field 1 is the empty string before
# the leading pipe. A row carrying an EXTRA cell after its state — there are
# such rows — does not move field 7; counting back from NF would.
# AND IT STAMPS ONLY WITH A REAL UUID (R-A8-2). A stamp naming `unknown` is a
# Rule 3 record that answers nothing about who resumed, in the one document this
# protocol cannot afford to rewrite; the note above names the act that writes it
# together with the deferred log line, at the first instant either can be right.
# AND THE STAMP NAMES THE AGENT WHERE ONE WAS NAMED (Amendment 17(c)): *"the
# Rule 3 resume prompt … single-use, and stamped `RESUMED by …` before anything
# else, as Rule 3 requires"*. `$stamp_ok` is `$lane_sid_known` for Claude — the
# rule R-A8-2 gives — and 1 for an agent whose id is its own kind of id, because
# refusing that stamp would leave Rule 3 unstamped for every launch this
# amendment exists to make.
hs_bound_unchanged() {   # the restart's bound file still digests as the restart bound it
  [ "${ri_expected_digest:-none}" != none ] || return 0
  [ -n "$ri_hf" ] && [ "$ri_hf" != none ] && [ "$(handoff_digest_of "$ri_hf")" = "$ri_expected_digest" ]
}
hs_none=0   # 1: 5c ran and wrote nothing, and the launch goes on (725, in 5d)
if [ "$lane_verb" = RESUMED ] && [ "$row_count" = 1 ] && (( stamp_ok )); then
  hs_cell="$(cell 7 | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' || :)"
  hs_stamp="RESUMED by $stamp_who (lane $LANE) at $utc — lane-start on $ws"
  hs_subject="handoff($LANE@$ws): RESUMED by $stamp_who"
  hs_args=(write-handoff "$LANE" --stamp "$hs_stamp" --subject "$hs_subject")
  hs_fix="LANES_LANE=$LANE $(quoted "$LANES_EDIT" "${hs_args[@]}")"
  # UNDER A SUPERVISED RESTART the write is fenced on the intent as 5a left it
  # — `starting`, with this launch's transcript reserved — and on the digest
  # the restart bound: the pre-image must be it, and the stamped file's digest
  # is reserved as the intent's prepared digest before its bytes land, in the
  # helper and under its lock (slice 2a, decision 7).
  if [ "$ri_active" = 1 ]; then
    hs_args+=(--restart "$ri_op" "$ri_gen" "$ri_attempt" starting "$lane_sid" --expected-digest "${ri_expected_digest:-none}")
  fi
  # A RERUN OF `--bind` (step 3b(iii)) STAMPS ONLY A HANDOFF THAT HAS NONE: the
  # file this lane's writes go through (`$HS_PATH`, the one `write-handoff`
  # splices into, with a kept local commit's line in it) is read for a line that
  # carries `RESUMED by <uuid> (lane <L>)`, which is the head of every stamp this
  # step writes. A file that cannot be read here is no answer, and the write
  # below is made as it always was, and says for itself what it could not do.
  hs_have=0
  if (( bind_rerun )) && [ -n "$HS_PATH" ] && [ -f "$HS_PATH" ] &&
     grep -qiF -- "RESUMED by $stamp_who (lane $LANE)" "$HS_PATH" 2>/dev/null; then
    hs_have=1
  fi
  # AND A LINE THAT IS THERE IS NOT A LINE THAT IS PUBLISHED. The file `$HS_PATH`
  # names carries the line of a kept local commit as well as a pushed one, and
  # the bind record ends `bound` "with a `note=` for each act still owed: the
  # stamp not written or not pushed" (design.md, "How it ends"), which the
  # caller builds from the one note of this command that holds both "Rule 3's
  # stamp" and "NOT". So a rerun that writes no second stamp still says the
  # first one is owed wherever it is not on origin: READ-ONLY, with no fetch (the
  # remote-tracking branch is as this run's own reads last fetched it), and a
  # copy that cannot be read is no proof of anything, so it is owed too.
  bind_stamp_published() {   # <file> <the stamp's head> — BSP_STATE published | unpublished | unreadable; BSP_WHY
    BSP_STATE=unreadable; BSP_WHY=""
    bsp_dir="$(dirname -- "$1")"; bsp_base="$(basename -- "$1")"
    bsp_br="$(git -C "$bsp_dir" symbolic-ref -q --short HEAD 2>/dev/null || :)"
    if [ -z "$bsp_br" ]; then
      BSP_WHY="that checkout's HEAD is on no branch, or the file is in no git work tree"
      return 0
    fi
    if ! bsp_copy="$(git -C "$bsp_dir" show "refs/remotes/origin/$bsp_br:./$bsp_base" 2>/dev/null)"; then
      BSP_WHY="there is no origin/$bsp_br there to read it from, or it holds no such file"
      return 0
    fi
    # A here-string, not a pipe: under pipefail a `grep -q` that stops at its
    # first match would fail the pipeline of a large handoff.
    if grep -qiF -- "$2" <<<"$bsp_copy"; then BSP_STATE=published; else BSP_STATE=unpublished; fi
    return 0
  }
  if [ -z "$hs_cell" ]; then
    step "the row names no handoff path, so there is no Rule 3 stamp to write"
  elif (( hs_have )); then
    step "--bind: a rerun, and $HS_PATH already carries a line for RESUMED by $stamp_who (lane $LANE), so no second one is stamped"
    if [ "${LANES_NO_GIT:-0}" = 1 ]; then
      note "Rule 3's stamp is in $HS_PATH (written by an earlier run: RESUMED by $stamp_who (lane $LANE)) and NOT committed by this run: LANES_NO_GIT=1 commits and pushes nothing, so whether origin has it is not known here, and no second stamp is written."
    else
      bind_stamp_published "$HS_PATH" "RESUMED by $stamp_who (lane $LANE)"
      case "$BSP_STATE" in
        published)
          step "--bind: origin's copy of $HS_PATH, as this checkout last fetched it, carries that line too, so nothing about the stamp is owed" ;;
        *)
          if [ "$BSP_STATE" = unpublished ]; then
            hs_why="origin's copy of that file, as this checkout last fetched it, has no such line"
          else
            hs_why="origin's copy of that file could not be read ($BSP_WHY), so it is not known to be there"
          fi
          note "Rule 3's stamp is in $HS_PATH (written by an earlier run: RESUMED by $stamp_who (lane $LANE)) and NOT published: $hs_why, and this run writes no second stamp. A commit kept unpushed in this lane's register checkout is published by no later write, and each write there refuses until it is (Amendment 23 S3): the publish act, which pushes it and writes nothing new, is LANES_LANE=$LANE $LANES_EDIT commit \"<what it is>\"; where origin moved it refuses (2), and S6.3's archive is the way out. A handoff in another repository (Amendment 8(d)) is committed and pushed in that repository, by hand." ;;
      esac
    fi
  elif (( dry_run )); then
    plan "LANES_LANE=$LANE $(quoted "$LANES_EDIT" "${hs_args[@]}")"
  else
    hs_out=""; hs_rc=0
    hs_out="$(LANES_LANE="$LANE" "$LANES_EDIT" "${hs_args[@]}")" || hs_rc=$?
    hs_line="$(printf '%s\n' "$hs_out" | awk -F'\t' 'NF >= 2 && $1 != "" { l = $0 } END { print l }')"
    if [ -n "$hs_line" ]; then
      hs_written="${hs_line%%	*}"
      # 5d READS THE FILE THIS CALL WROTE (rv2b's NIT 1 on #316): a peer that
      # moved the handoff and its cell on origin is followed by the write's
      # replay, and the path `handoff-path` named before it may be gone.
      if [ -f "$hs_written" ]; then HS_PATH="$hs_written"; fi
      # THE DIGEST THE RESTART NOW EXPECTS is the stamped file's, which the
      # helper reserved in the intent before the bytes: 5d reads that file.
      if [ "$ri_active" = 1 ]; then ri_expected_digest="${hs_line##*	}"; fi
      case "$hs_rc" in
        # THE WORDS SAY WHAT WAS DONE (lane openRepoTools-3's review of #316,
        # 721 and its question 4): under the harness's LANES_NO_GIT=1 the
        # helper writes the file and commits nothing, and exits 0. And since
        # slice 2a's 604 a 0 is not always a commit in this lane's checkout:
        # an Amendment 8(d) handoff is committed and pushed in its own
        # repository, and one in no work tree, or in a clone of the register
        # not beside W, is committed nowhere. The helper's note says which
        # (722; slice 3's F24 words the skill's 0 the same way).
        0) if [ "${LANES_NO_GIT:-0}" = 1 ]; then
             note "Rule 3's stamp is written in $hs_written and NOT committed: LANES_NO_GIT=1 commits and pushes nothing (\`write-handoff\` exited 0): $hs_stamp"
           else
             step "handoff stamped through \`write-handoff\`, which exited 0: $hs_written: $hs_stamp (its words above say what it committed and pushed, or that nothing was committed)"
           fi ;;
        3) note "Rule 3's stamp is written in $hs_written and its commit pushed, and origin did not confirm it (\`write-handoff\` exited 3; its words above name the commit): look before writing it again, because a stamp written twice is two resumes in the one document this protocol never rewrites." ;;
        # 6 IS NOT ONE STATE (lane openRepoTools-3's review of #311, 982):
        # `git add` or `commit` failed and nothing is committed, or the commit
        # is kept on HEAD and named; and with slice 2a's 604, an 8(d)
        # handoff's commit or push in its own repository failed. The helper's
        # words say which, so these do not guess. THE PUBLISH ACT IS NAMED
        # ONLY WHERE THOSE WORDS OFFER IT (lane openRepoTools-3's review of
        # opensoft/openRepoTools-code#20 at 4031100, NIT 2; the class of slice
        # 2a's A62): after a push that origin's move refused (A37's
        # keep-if-gone, the six-attempt bound) the act refuses ("moved past",
        # 2), the helper's own words (`cp_recovery_steps`) give S6.3's archive,
        # and once it is made there is nothing left to publish. Where origin
        # did not move they offer the act.
        6) note "Rule 3's stamp is written in $hs_written and NOT published (\`write-handoff\` exited 6; its words above say whether a commit was made, where it is kept, and the command that finishes it). A commit kept unpushed in this lane's register checkout is published by no later write, and each write there refuses until it is (Amendment 23 S3): do what those words say. Where they offer the publish act, it is LANES_LANE=$LANE $LANES_EDIT commit \"<what it is>\", the publish act; where origin moved they say it refuses (2) and give S6.3's archive instead." ;;
        *) note "Rule 3's stamp is written in $hs_written and was NOT published (\`write-handoff\` exited $hs_rc; its words above say what is left). The launch is not refused for it." ;;
      esac
    # THE BOUND FILE IS ASKED FIRST (lane openRepoTools-3's review of #316,
    # 724): since slice 2a's 603 the restart fences' 2s are 7, so a pre-image
    # a peer changed after binding comes back as 7 as well, and is not lost
    # ownership. Both exit 2; S3's 2 stays a note (below).
    elif [ "$ri_active" = 1 ] && ! hs_bound_unchanged; then
      die "the restart handoff changed before its owned resume stamp. Nothing was launched." 2
    elif [ "$ri_active" = 1 ] && [ "$hs_rc" = 7 ]; then
      die "this restart attempt lost ownership of its handoff before the resume stamp (\`write-handoff\` exited 7; its words are above). Nothing was launched." 2
    else
      hs_none=1
      note "Rule 3's stamp was NOT written (\`write-handoff\` exited $hs_rc; its words are above), and the launch is not refused for it: the stamp is the record of this resume, not its licence."
      note "  STAMP IT AS THIS SESSION'S FIRST ACT — this line under the handoff's header block:"
      note "    $hs_stamp"
      note "  with: $hs_fix"
      # THAT RE-RUN CARRIES NONE OF A RESTART'S FENCES (lane openRepoTools-3's
      # review of #316, 726): run while the intent is `starting`, the helper
      # refuses it as a write without them (7).
      [ "$ri_active" != 1 ] ||
        note "  and only once this restart is confirmed ready: while its intent is \`starting\` that write, which carries none of the restart's fences, exits 7."
    fi
  fi
fi

# ------------------------- 5d. the first prompt (Amendment 17(c) and (f))
#
# *"it launches the named agent with THE HANDOFF'S TOP BLOCK AS ITS FIRST
# PROMPT (the Rule 3 resume prompt, read from the file the row names)"*.
#
# AFTER 5c, AND THAT ORDER IS THE WHOLE OF RULE 3. The block handed to the new
# session is read AFTER this run has stamped `RESUMED by …` into the file, so
# the session reads a prompt that already carries the record of its own resume —
# and a `/ctx` respawn hands over the block `lane-handoff` wrote one step
# earlier, which is the same bytes from the same file rather than a second copy
# of them.
#
# THE TOP BLOCK IS THE HEAD OF THE FILE DOWN TO THE FIRST `---` RULE, which is
# the marker every refresh writes between the fresh block and the history below
# it, and 200 lines at the outside for a handoff that has none. A first prompt
# is a prompt, not a document: the session reads the rest of the file itself,
# and that is what "older sections below are history" means.
handoff_top_block() {   # <file>
  awk 'NR > 1 && $0 ~ /^---[ \t]*$/ { exit } { print } NR >= 200 { exit }' "$1"
}

if (( first_prompt )); then
  fp_cell=""
  if [ "$row_count" = 1 ]; then
    fp_cell="$(cell 7 | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' || :)"
  else
    fp_cell="$handoff"
  fi
  # READS FOLLOW THE WRITE, AND NEVER THROUGH W (Amendment 23 S2, slice 2b):
  # the file 5c wrote, in the checkout this lane's writes go through. Under a
  # supervised restart it is the only file there is, because its intent bound
  # it, and so it is for every other launch. Where that file is not there the
  # launch goes on with NO first prompt, and says which file is missing and
  # what makes it (below). W's copy is never read in its place: it never
  # carries this resume's stamp, and the cell it is found by is not fenced as
  # the writes' is (lane openRepoTools-3's review of #316, 727 and its
  # question 2).
  fp_file=""
  if [ -n "$fp_cell" ] && [ -n "$HS_PATH" ] && [ -f "$HS_PATH" ]; then
    fp_file="$HS_PATH"
  fi
  # A REFUSED STAMP LEAVES THE CHECKOUT WHERE IT WAS (lane openRepoTools-3's
  # review of #316, 725). S3 fetched origin before it refused, and it did not
  # fast-forward, so the file read below may be older than origin's, which
  # another workstation may have moved on. A plain launch still goes on with
  # this file, the one this lane's writes go to; where the checkout's own
  # `origin/<branch>` differs, both copies are named, and the command that
  # brings the checkout up to date. (Under a restart the bound file is the
  # prompt, by the fences below.)
  if [ "$hs_none" = 1 ] && [ "$ri_active" != 1 ] && [ -n "$fp_file" ]; then
    fp_dir="$(dirname -- "$fp_file")"; fp_base="$(basename -- "$fp_file")"
    fp_br="${LANES_BRANCH:-main}"
    fp_theirs="$(git -C "$fp_dir" rev-parse -q --verify "refs/remotes/origin/$fp_br:./$fp_base" 2>/dev/null || :)"
    fp_ours="$(git -C "$fp_dir" hash-object -- "$fp_base" 2>/dev/null || :)"
    if [ -n "$fp_theirs" ] && [ -n "$fp_ours" ] && [ "$fp_theirs" != "$fp_ours" ]; then
      fp_top="$(git -C "$fp_dir" rev-parse --show-toplevel 2>/dev/null || :)"
      [ -n "$fp_top" ] || fp_top="$fp_dir"
      fp_rel="${fp_file#"$fp_top"/}"
      note "this lane's handoff in its checkout, $fp_file, is not origin's: origin/$fp_br:$fp_rel, as the refused stamp's fetch left it in $fp_top, differs, so the first prompt below is the checkout's copy and may be older than origin's. Once the refusal above is answered, git -C $fp_top merge --ff-only origin/$fp_br brings the checkout up to date (origin's copy reads with git -C $fp_top show origin/$fp_br:$fp_rel)."
    fi
  fi
  if [ "$ri_active" = 1 ] && (( fresh )); then
    [ -n "$fp_file" ] && [ "$fp_file" -ef "$ri_hf" ] ||
      die "the delivered restart prompt is not the intent-bound handoff. Nothing was launched." 2
    [ "$ri_expected_digest" = none ] || [ "$(handoff_digest_of "$fp_file")" = "$ri_expected_digest" ] ||
      die "the restart handoff changed after preparation. Nothing was launched." 2
  fi
  if [ -n "$fp_file" ] && [ -s "$fp_file" ]; then
    fp_text="$(handoff_top_block "$fp_file")"
    if [ "$ri_active" = 1 ] && (( fresh )); then
      [ -n "$fp_text" ] || die "the supervised handoff has no first prompt. Nothing was launched." 2
      [ "$ri_expected_digest" = none ] || [ "$(handoff_digest_of "$fp_file")" = "$ri_expected_digest" ] ||
        die "the restart handoff changed while reading its prompt. Nothing was launched." 2
    fi
    if [ -n "$fp_text" ]; then
      cmd+=("$fp_text")
      step "first prompt: the top block of $fp_cell ($(printf '%s\n' "$fp_text" | grep -c .) lines), delivered to $AGENT as its opening prompt"
    else
      note "the handoff the row names is empty at its head, so $AGENT is launched with no first prompt: $fp_file"
    fi
  else
    # NEVER A REASON TO REFUSE THE LAUNCH, for the same reason a handoff that
    # cannot be stamped is not: Rule 3's block is the RECORD a session resumes
    # from, and a session with no prompt can still read the file itself. The
    # note names the file this lane's writes go to and, under the opt-in, the
    # command that makes the lane's checkout it is in.
    fp_make=""
    [ "$LS_ROUTED" != 1 ] ||
      fp_make=" Where the lane's own checkout is not there, LANES_ROUTE_WRITES=1 $LANES_EDIT lane-checkout $LANE --create makes it."
    if [ -z "$fp_cell" ]; then
      note "the row names no handoff, so $AGENT is launched with no first prompt."
    elif [ -n "$HS_PATH" ]; then
      fp_state="is not at $HS_PATH"
      [ -z "$fp_file" ] || fp_state="is empty at $HS_PATH"
      note "this lane's handoff '$fp_cell' $fp_state, the file its writes go to, so $AGENT is launched with no first prompt, and W's copy is never read in its place (Amendment 23 S2).${fp_make} Its first act is to read that file and stamp it (Rule 3)."
    else
      note "where this lane's handoff '$fp_cell' is written could not be read (above), so $AGENT is launched with no first prompt, and W's copy is never read in its place (Amendment 23 S2).${fp_make} \`$LANES_EDIT handoff-path $LANE\` names the file; its first act is to read it and stamp it (Rule 3)."
    fi
  fi
fi

# --------- 5c. the transcript this launch is about to make, INTO THE INTENT
#
# THE SUPERVISOR CANNOT CONFIRM WHAT IT WAS NEVER TOLD (openRepoTools#94). Its
# readiness predicate asks whether the EXPECTED new transcript exists and is
# bound to this lane; the only process that knows which uuid that is, is this
# one, and only after 5a minted it. So it is written back into the intent
# before the `exec` — the last act this command takes that the supervisor can
# read — and the state goes with it: `starting` is *a launch was prepared for
# this operation*, and the legacy intent stays starting
# until readiness is CONFIRMED.
#
# THE WRITE IS FENCED ON THE OPERATION AND ON NOTHING ELSE. A launch that has
# been superseded between 5a and here writes nothing, and says so: the exit 7
# is the intent telling this run that a newer operation owns the lane.
#
# A FAILED FENCE OR WRITE REFUSES THE LAUNCH. An observer declining to mark
# readiness cannot undo the effects of a stale process that was already execed.
if (( fresh )) && [ "$ri_active" = 1 ] && (( ! no_launch )) && (( ! dry_run )); then
  ri_new="$lane_sid"
  [ -n "$ri_new" ] && [ "$ri_new" != unknown ] || ri_new="${new_sid:-}"
  ri_wrc=0
  # FENCED ON THE GENERATION AS WELL AS THE OPERATION (Copilot round 2 on
  # openRepoTools#121), which is what every write the supervisor makes of this
  # same intent carries. `$ri_gen` is the generation this run READ at the top,
  # before anything was renamed or written, and the supervisor's claim keeps it
  # — so a legacy operation advanced between the two has a launch here that
  # writes nothing and says so, rather than stamping its expected transcript
  # onto a newer generation's record.
  ri_fence=()
  case "${ri_gen:-}" in '' | *[!0-9]*) : ;; *) ri_fence=(--expect-generation "$ri_gen" --expect-attempt "$ri_attempt") ;; esac
  LANES_NO_FETCH=1 "$LANES_EDIT" legacy-restart-check "$LANE" ||
    die "managed ownership blocks the prepared legacy launch. Nothing was launched." 2
  LANES_NO_FETCH=1 "$LANES_EDIT" set-restart-intent "$LANE" starting \
    --expect 'pending|starting' --expect-operation "$ri_op" \
    ${ri_fence[@]+"${ri_fence[@]}"} \
    ${ri_new:+--new-transcript "$ri_new"} \
    --expect-new-transcript "$ri_new" --digest "$ri_expected_digest" --prepared-digest none \
    --reason "lane-start prepared the launch" >/dev/null 2>&1 || ri_wrc=$?
  case "$ri_wrc" in
    0) step "restart intent $ri_op: starting${ri_new:+, expected transcript $ri_new}" ;;
    7) die "the restart intent moved under this launch: another operation owns lane $LANE now. This stale launch was refused before exec. Re-read it: lanes-edit.sh restart-intent $LANE" 2 ;;
    *) die "the prepared transcript could not be recorded (set-restart-intent exited $ri_wrc). This supervised launch was refused before exec because readiness cannot verify its identity." 1 ;;
  esac
fi

# ------------- 5e. the estate's daily report (opensoft/openRepoTools#162)
#
# ONCE A DAY PER WORKSTATION, DETACHED, AND NEVER A REASON A START WAITS OR
# FAILS. `lane-worktrees sweep --all --dry-run --report` is the net under every
# actor that never runs `lane-end`: what is FOREIGN, orphaned, unpublished,
# aging or past retention across the estate, as one table, written to the state
# directory. It changes nothing. The first start of the day takes the stamp -
# `set -C` makes taking it one atomic create, so two starts at once run one
# report - and starts it with stdin, stdout and stderr closed, in a subshell
# that exits at once, so the report is no child of the session this command is
# about to exec. Every step of this either works or is skipped in silence:
# a report that could not start is tomorrow's start's to run.
# `LANE_WORKTREES_REPORT=off` is the switch, and both suites set it.
lane_daily_report() {
  [ "${LANE_WORKTREES_REPORT:-on}" = off ] && return 0
  ldr_bin=""
  if [ -x "$SCRIPT_DIR/lane-worktrees" ]; then
    ldr_bin="$SCRIPT_DIR/lane-worktrees"
  else
    ldr_bin="$(command -v lane-worktrees 2>/dev/null || :)"
  fi
  [ -n "$ldr_bin" ] || return 0
  ldr_state="${XDG_STATE_HOME:-$HOME/.local/state}/openRepoTools"
  ldr_day="$(date -u +%Y%m%d 2>/dev/null || :)"
  [ -n "$ldr_day" ] || return 0
  # THE REPORT IS PRIVATE (#170 item 11): it names every path, branch and lane
  # of the estate. Its directories are 0700, and it is written under umask 077.
  # A directory that could not be made 0700 - one that already existed wider,
  # on a file system or under an owner that refuses the chmod - runs NO report
  # (#179, Copilot round 1): the stamp is not taken, so tomorrow's start tries
  # again, and a report never lands where every local account could read it.
  ( umask 077; mkdir -p -- "$ldr_state/reports" ) 2>/dev/null || return 0
  chmod 700 "$ldr_state" "$ldr_state/reports" 2>/dev/null || return 0
  ( set -C; : > "$ldr_state/report-$ldr_day.stamp" ) 2>/dev/null || return 0
  for ldr_old in "$ldr_state"/report-*.stamp; do
    [ "$ldr_old" = "$ldr_state/report-$ldr_day.stamp" ] || rm -f -- "$ldr_old" 2>/dev/null || :
  done
  ldr_out="$ldr_state/reports/$(date -u +%Y%m%dT%H%M%SZ).md"
  # THE ESTATE THIS START READS: `$PROJECTS_ROOT` as resolved above, named to
  # the report rather than left for it to find again.
  ldr_estate=""
  [ -d "$PROJECTS_ROOT" ] && ldr_estate="$PROJECTS_ROOT"
  # A PANE KILLED AFTER THE STAMP WAS TAKEN DOES NOT TAKE THE REPORT WITH IT
  # (#170 E8): the report ignores the hangup (`nohup`, everywhere), and where
  # there is a `setsid` (Linux; macOS has none) it is in a session of its own,
  # which no terminal's hangup reaches at all. Otherwise today's stamp would
  # name a report that never finished, and none would run until tomorrow.
  ldr_detach=""
  command -v setsid >/dev/null 2>&1 && ldr_detach="setsid"
  # FEATURE 007, T428: THE SWEEP OUTLIVES THIS ACT, so neither the act's base
  # nor a scope reaches it (Y:5596, Y:5581; lane 3's G5 and T428's question
  # 10, #165 6770733371). They are unset in this subshell only: the verb
  # calls after 5e still run under this act's LANES_ACT.
  ( umask 077
    unset LANES_ACT LANES_EXPECT
    $ldr_detach nohup "$ldr_bin" sweep --all --dry-run --report --post "$ldr_out" \
      ${ldr_estate:+--estate "$ldr_estate"} </dev/null >/dev/null 2>&1 & ) 2>/dev/null || :
  step "the estate's daily report is running, detached: $ldr_out"
  return 0
}
(( dry_run )) || lane_daily_report || :

# ------------------------- 5f. W, brought up to this launch's writes (S5)
#
# The second of the two refreshes (see `ls_refresh`): the next reader of W —
# the next `lane-start` of any lane, `lanes`, `status` — finds this launch's row,
# log line and stamp there. A refusal is a note, and the launch goes on.
ls_refresh "after this launch's writes"

# ---------------------------------------------------------------- 6. launch
#
# `cmd` was decided in 5a, before the row was written.

if (( no_launch )); then
  quoted "${cmd[@]}"; printf '\n'
  step "--no-launch: the command above was printed, not run (its cwd would be $DIR)"
  exit 0
fi

if (( dry_run )); then
  plan "cd $DIR"
  plan "exec $(quoted "${cmd[@]}")"
  step "--dry-run: nothing was renamed, written or launched"
  exit 0
fi

if [ -n "$preparation_failure_identity" ]; then
  pfr_final="$(LANES_NO_FETCH=1 "$LANES_EDIT" restart-intent "$LANE" --dir "$DIR")" ||
    die "the failed preparation could not be rechecked before ordinary launch. Nothing was launched." 2
  preparation_failure_resume_check "$pfr_final"
fi

# FEATURE 007, T428 - THE ACT ENDS AT THE LAUNCH (Y:5596): "Before a launch
# LANES_ACT is unset (exec, respawn-pane), or the session and its guard would
# inherit it." It was exported at the act base above for this run's own verb
# calls; the session this exec becomes is not one of them, and its guard's
# writes take their own base. Unset here, after the last verb call this run
# makes, and not before the --no-launch and --dry-run exits, which exec
# nothing: --no-launch prints the command for its caller to run, in the
# caller's own environment. LANES_EXPECT goes too: it "is never exported"
# (Y:5581), and AT-F6 (13) at Y:5563 has the guard's child see both unset
# (lane 3's G5 and shared ruling 5, #165 6770733371).
unset LANES_ACT LANES_EXPECT
cd -- "$DIR"
step "exec: $(quoted "${cmd[@]}")"
exec "${cmd[@]}"
