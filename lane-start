  ld_out="$("$LANES_EDIT" swapped 2>/dev/null)" || ld_rc=$?
  case "$ld_rc" in
    0)
      ld_row="$(printf '%s\n' "$ld_out" | awk -F'\t' -v l="$LANE" 'tolower($1) == tolower(l) { print; exit }')"
      if [ -n "$ld_row" ]; then
        ld_cand="$(printf '%s' "$ld_row" | cut -f4)"
        case "$ld_cand" in
          /*) DIR="$ld_cand"; DIR_SOURCE="the swap record" ;;
        esac
      fi ;;
    8|2) : ;;
    # 007 (T402; Y:5727; spec:688): busy and in doubt refuse; 69 stays a note.
    75 | 3) ls_read_refuse "$LANES_EDIT swapped" "$ld_rc" "lane ${LANE}'s directory from its swap record" ;;
    *) note "$LANES_EDIT swapped failed (exit $ld_rc) — carrying on to the lane's log for its directory" ;;
  esac
fi
if [ -z "$DIR" ]; then
  ld_out=""; ld_rc=0
  ld_out="$("$LANES_EDIT" lane-dir "$LANE" 2>/dev/null)" || ld_rc=$?
  case "$ld_rc" in
    0) case "$ld_out" in /*) DIR="$ld_out"; DIR_SOURCE="the lane's log" ;; esac ;;
    8|2) : ;;
    # 007 (T402; Y:5727; spec:688): busy and in doubt refuse; 69 stays a note.
    75 | 3) ls_read_refuse "$LANES_EDIT lane-dir $LANE" "$ld_rc" "lane ${LANE}'s directory from its log" ;;
    *) note "$LANES_EDIT lane-dir $LANE failed (exit $ld_rc) — carrying on to the default for its directory" ;;
  esac
fi
# A DIRECTORY THAT WAS RECORDED AND IS GONE IS ITS OWN FAILURE, and it keeps
# its own code. Rungs 1 to 3 are the operator's word and the lane's own record:
# where one of them answered and the path is not there, the path is NAMED and
# `--dir` is named beside it, and nothing below this line runs — searching for a
# substitute for a directory the lane itself recorded is the silent re-home
# clause (c) rules out. Evidence 7's case is the OTHER one: no rung answered at
