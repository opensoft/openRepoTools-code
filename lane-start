if [ -n "$DIR" ] && [ ! -d "$DIR" ]; then
  die "no such directory: $DIR (from $DIR_SOURCE) — pass --dir <path> if this lane's checkout is somewhere else" 1
fi
if [ -z "$DIR" ]; then
  if [ -d "$PROJECTS_ROOT/$repo" ]; then
    DIR="$PROJECTS_ROOT/$repo"; DIR_SOURCE="the default \$PROJECTS_ROOT/<repo>"
  else
    DIR_DEFAULT_TRIED="$PROJECTS_ROOT/$repo"
  fi
fi

# ------------------------------------- EVIDENCE 7: THE LANE WHOSE CHECKOUT IS
#                                       NESTED, AND WHOSE RECORD PREDATES `dir`
#
# Measured 2026-09-13T23:01Z and reported by Brett Heap
# (`brettheap/new-workstation#20`, comment 5656793094). `pclaude team03m`
# auto-selected the saved lane `opsXfactory-5` from its swap record, the
# launcher handed a bare lane name to this script, rung 4 derived
# `~/projects/opsXfactory` — which does not exist — and this script **exited 1
# before Claude started**, leaving a pane that said `[exited]`. The lane's real
# checkout is `~/projects/xFactory/xFactories/OpsxFactory`. Its own record could
# not help: its `STARTED`/`RESUMED` lines carry `home opensoft/OpsxFactory;
# estate xFactory` and its `PAUSED` swap line carries `window …; workstation
# docker-desktop`, and **no `dir`** — the field this amendment adds, which
# nothing backfills (Amendment 7(i)).
#
# TWO RUNGS BEFORE THE REFUSAL, AND NEITHER IS AN INFERENCE. Rungs 5 and 6 are
# both proved by the candidate's own `origin` against the lane's RECORDED HOME,
# so what they find is the checkout of the lane's own repository and not "a
# directory that merely has the right name". That distinction is the whole of
# why clause (c) rules the cwd's checkout out by name: this script writes the
# lane's home from the directory's `origin`, and a wrong directory silently
# re-homes the lane. A directory whose origin IS the recorded home cannot.
#
#   5. THE ESTATE'S `project.yaml` LEGS. openRepoShape's manifest is a top-level
#      `legs:` list of `repository:` / `path:`, and Amendment 7 decision 3
#      treats legs as home. Where a manifest names the lane's home as a leg, the
#      leg's `path` resolved against that manifest's directory IS the checkout,
#      declared rather than searched for.
#   6. A CHECKOUT NAMED FOR THE HOME'S REPOSITORY, one or two levels under
#      `$PROJECTS_ROOT` — the two depths the estate actually uses and the same
#      two `same_project` globs for manifests. `opsXfactory` the lane label and
#      `OpsxFactory` the repository are not the same string, which is why the
#      NAME comes from the alias table's own canonical spelling
#      (`resolve-repo`) rather than from the lane's label.
#
# BOTH ARE SKIPPED ENTIRELY WHERE THE LANE HAS NO RECORDED HOME, because there
# is then nothing to prove a candidate against and a match would be a guess.
if [ -z "$DIR" ]; then
  ls_home=""; ls_rc=0
  ls_home="$("$LANES_EDIT" resolve-home "$LANE" 2>/dev/null)" || ls_rc=$?
  # 007 (T402; Y:5728; spec:688): busy and in doubt refuse; every other code,
  # 69 among them, stays silent, as it was (Y:5728; lane 3's 6752010154, R2's
  # N8). Rungs 5 and 6 are skipped on any failure.
  case "$ls_rc" in
    75 | 3) ls_read_refuse "$LANES_EDIT resolve-home $LANE" "$ls_rc" "lane ${LANE}'s recorded home" ;;
  esac
  [ "$ls_rc" = 0 ] || ls_home=""
  case "$ls_home" in */*) : ;; *) ls_home="" ;; esac
fi
# Rung 5 — the legs.
if [ -z "$DIR" ] && [ -n "$ls_home" ]; then
  for ls_m in "$PROJECTS_ROOT"/*/project.yaml "$PROJECTS_ROOT"/*/*/project.yaml; do
    [ -f "$ls_m" ] || continue
    # ONLY `repository:` AND `path:`, and only as navigation: the manifest says
    # of itself that it CONFERS NOTHING, and `role:` is never read here. This is
    # the SECOND reader of `legs[]` in this toolset — `lanes-edit.sh`'s
    # `project_legs_file` is the first — and it exists because that one answers
    # with repositories alone and no read in clause (h)'s table carries a leg's
    # PATH. Naming the duplication is the honest half of it.
    ls_cand="$(awk -v want="$ls_home" '
      /^[A-Za-z_][A-Za-z0-9_]*:/ { inlegs = ($0 ~ /^legs:/); repo = ""; path = ""; next }
      !inlegs { next }
      /^[ \t]*-[ \t]/ { repo = ""; path = "" }
      /^[ \t]+repository:[ \t]*/ { v = $0; sub(/^[ \t]+repository:[ \t]*/, "", v)
        sub(/[ \t]+$/, "", v); gsub(/^"|"$/, "", v); gsub(/^'"'"'|'"'"'$/, "", v); repo = v }
      /^[ \t]+path:[ \t]*/ { v = $0; sub(/^[ \t]+path:[ \t]*/, "", v)
        sub(/[ \t]+$/, "", v); gsub(/^"|"$/, "", v); gsub(/^'"'"'|'"'"'$/, "", v); path = v }
      repo != "" && path != "" && tolower(repo) == tolower(want) { print path; exit }' "$ls_m" 2>/dev/null || :)"
    [ -n "$ls_cand" ] || continue
    ls_dir="$(dirname -- "$ls_m")"
    case "$ls_cand" in .) ls_try="$ls_dir" ;; /*) ls_try="$ls_cand" ;; *) ls_try="$ls_dir/$ls_cand" ;; esac
    [ -d "$ls_try" ] || continue
    lane_dir_is_home "$ls_try" "$ls_home" || continue
    DIR="$ls_try"; DIR_SOURCE="the legs of ${ls_m#$PROJECTS_ROOT/} (Evidence 7)"
    break
  done
fi
# Rung 6 — a checkout named for the repository, proved by its origin.
if [ -z "$DIR" ] && [ -n "$ls_home" ]; then
  ls_name="${ls_home#*/}"
  # Repository identity is case-blind; its directory may retain an older case.
  # Expand only this closed repository-name pattern, then prove the origin as
  # before. Do not infer the home from a matching directory name.
  ls_pattern="$(printf '%s' "$ls_name" | awk '{
    for (i = 1; i <= length($0); i++) {
      c = substr($0, i, 1)
      if (c ~ /[A-Za-z]/) printf "[%s%s]", tolower(c), toupper(c)
      else printf "%s", c
    }
  }')"
  for ls_try in "$PROJECTS_ROOT"/$ls_pattern "$PROJECTS_ROOT"/*/$ls_pattern "$PROJECTS_ROOT"/*/*/$ls_pattern; do
    [ -d "$ls_try" ] || continue
    lane_dir_is_home "$ls_try" "$ls_home" || continue
    DIR="$ls_try"; DIR_SOURCE="the checkout of $ls_home under \$PROJECTS_ROOT (Evidence 7)"
    break
  done
fi

